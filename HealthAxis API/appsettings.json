{
  "AppSettings": {
    "AppName": "HealthAxis API"
  },

  "ConnectionStrings": {
    "HealthAxisDb": ""
  },

  "Jwt": {
    "Issuer": "HealthAxis.API",
    "Audience": "HealthAxis.Clients",
    "Key": "THIS_IS_A_DEVELOPMENT_SECRET_KEY_CHANGE_LATER_123456789",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Elastic.Serilog.Sinks"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/healthaxis-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodes": [
            "http://localhost:9200"
          ],
          "dataStream": "logs-healthaxis-training",
          "bootstrapMethod": "Failure"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "HealthAxis.API"
    }
  },

  "AllowedHosts": "*"
}