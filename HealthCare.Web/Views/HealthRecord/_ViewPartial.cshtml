@model HealthCare.Shared.DTOs.HealthRecord.HealthRecordDto

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@if (Model != null)
{
    
    <div class="row g-3 mb-3">

        <div class="col-md-4">
            <label class="fw-bold">Record ID</label>
            <input class="form-control" value="@Model.RecordId" readonly />
        </div>

        <div class="col-md-4">
            <label class="fw-bold">Appointment ID</label>
            <input class="form-control" value="@Model.AppointmentId" readonly />
        </div>

        <div class="col-md-4">
            <label class="fw-bold">Visit Date</label>
            <input class="form-control"
                   value="@Model.VisitDate.ToString("dd MMM yyyy hh:mm tt")"
                   readonly />
        </div>

    </div>

    <hr />

    <
    <div class="mb-3">
        <label class="fw-bold">Diagnosis</label>
        <div class="p-3 bg-light rounded-3">
            @Model.Diagnosis
        </div>
    </div>

    <
    <div class="mb-3">
        <label class="fw-bold">Prescription</label>
        <div class="p-3 bg-light rounded-3">
            @Model.Prescription
        </div>
    </div>

 
    <div class="mb-3">
        <label class="fw-bold">Doctor Notes</label>
        <div class="p-3 bg-light rounded-3">
            @(string.IsNullOrEmpty(Model.Notes) ? "-" : Model.Notes)
        </div>
    </div>

    
    <div class="text-end mt-3">
        <button class="btn btn-warning"
                onclick="openModal('@Url.Action("EditPartial", "HealthRecord", new { id = Model.RecordId })')">
            Edit
        </button>
    </div>
}