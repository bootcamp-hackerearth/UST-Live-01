@model HealthCare.Shared.DTOs.Appointment.AppointmentDto

@{
    ViewBag.Title = "Book Appointment";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">Book Appointment</h2>
        <p class="text-muted">Schedule an appointment with a doctor.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            @using (Html.BeginForm("Book", "Appointment", FormMethod.Post, new { id = "appointmentForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <!-- Patient -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Patient</label>

                        <input type="text"
                               id="patientSearch"
                               class="form-control"
                               placeholder="Search patient by name"
                               required />

                        <!-- Hidden field to store selected ID -->
                        @Html.HiddenFor(m => m.PatientId, new { id = "patientId" })

                        <ul id="patientList" class="list-group mt-1"></ul>

                        @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger" })
                    </div>

                    <!-- Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Select Date</label>

                        @Html.TextBoxFor(m => m.ScheduledDate, new
                        {
                            type = "date",
                            @class = "form-control",
                            id = "date",
                            min = DateTime.Now.ToString("yyyy-MM-dd"),
                            required = "required"
                        })

                        @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "text-danger" })
                    </div>

                    <!-- Specialization -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Specialization</label>

                        <select id="specialization" class="form-select" required>
                            <option value="">-- Select Specialization --</option>
                            <option value="Cardiologist">Cardiology</option>
                            <option value="Dermatologist">Dermatology</option>
                            <option value="Neurologist">Neurologist</option>
                            <option value="Orthopedic">Orthopedic</option>
                            <option value="Pediatrician">Pediatrician</option>
                        </select>
                    </div>

                    <!-- ✅Doctor -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Doctor</label>

                        @Html.DropDownListFor(m => m.DoctorId,
                            new List<SelectListItem>(),
                            "-- Select Doctor --",
                            new
                            {
                                @class = "form-select",
                                id = "doctor",
                                required = "required",
                                disabled = "disabled"
                            })

                        @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
                    </div>

                    <!--Time Slot -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Time Slot</label>

                        @Html.DropDownListFor(m => m.TimeSlot,
                            new List<SelectListItem>(),
                            "-- Select Time Slot --",
                            new
                            {
                                @class = "form-select",
                                id = "timeslot",
                                required = "required",
                                disabled = "disabled"
                            })

                        @Html.ValidationMessageFor(m => m.TimeSlot, "", new { @class = "text-danger" })
                    </div>

                </div>

                <div class="mt-5 text-end">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Book Appointment
                    </button>
                </div>
            }

        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        var specializationEl = document.getElementById("specialization");
        var doctorEl = document.getElementById("doctor");
        var slotEl = document.getElementById("timeslot");
        var dateEl = document.getElementById("date");

        //When specialization changes
        specializationEl.addEventListener("change", function () {

            var specialization = this.value;

            //Clear doctors + slots
            doctorEl.innerHTML = '<option value="">-- Select Doctor --</option>';
            doctorEl.disabled = true;

            slotEl.innerHTML = '<option value="">-- Select Time Slot --</option>';
            slotEl.disabled = true;


            if (!specialization) {
                return; 
            }


            //  Load doctors
            doctorEl.innerHTML = '<option>Loading doctors...</option>';
            console.log(specialization);
            fetch('https://localhost:44384/api/doctors?specialization=' + specialization)
                .then(res => res.json())
                .then(data => {
                    console.log(data);
                     
                    if (!data.Items || data.Items.length === 0) {
                        doctorEl.innerHTML = '<option value="">No available doctors</option>';
                        doctorEl.disabled = true;
                        return;
                    }

                    doctorEl.disabled = false;
                    doctorEl.innerHTML = '<option value="">-- Select Doctor --</option>';

                    data.Items.forEach(d => {
                        doctorEl.innerHTML += `<option value="${d.DoctorId}">${d.FullName}</option>`;
                    });
                })
                .catch(() => {
                    console.log("wassup")
                    doctorEl.innerHTML = '<option>Error loading doctors</option>';
                });
        });

        // When doctor changes → clear slots first
        doctorEl.addEventListener("change", function () {

            slotEl.innerHTML = '<option value="">-- Select Time Slot --</option>';
            slotEl.disabled = true;

            loadSlots();
        });

        // When date changes → reload slots
        dateEl.addEventListener("change", loadSlots);

        function loadSlots() {

            var doctorId = doctorEl.value;
            var date = dateEl.value;

            if (!doctorId || !date) return;

            slotEl.disabled = true;
            slotEl.innerHTML = '<option>Loading time slots...</option>';

            fetch(`https://localhost:44384/api/appointments/slots?doctorId=${doctorId}&date=${date}`)
                .then(res => res.json())
                .then(data => {

                    if (!data || data.length === 0) {
                        slotEl.innerHTML = '<option value="">No available time slots</option>';
                        slotEl.disabled = true;
                        return;
                    }

                    slotEl.disabled = false;
                    slotEl.innerHTML = '<option value="">-- Select Time Slot --</option>';

                    data.forEach(s => {
                        slotEl.innerHTML += `<option value="${s}">${s}</option>`;
                    });
                })
                .catch(() => {
                    slotEl.innerHTML = '<option>Error loading time slots</option>';
                });
        }

    });
</script>

<script>
    const patientInput = document.getElementById("patientSearch");
    const patientList = document.getElementById("patientList");
    const patientIdInput = document.getElementById("patientId");

    patientInput.addEventListener("input", function () {

        let query = this.value;

        if (query.length < 2) {
            patientList.innerHTML = "";
            return;
        }

        fetch(`https://localhost:44384/api/patients?searchTerm=${query}`)
            .then(res => res.json())
            .then(data => {

                patientList.innerHTML = "";

                if (!data.Items || data.Items.length === 0) {
                    patientList.innerHTML = `<li class="list-group-item">No patients found</li>`;
                    return;
                }

                data.Items.forEach(p => {
                    const li = document.createElement("li");
                    li.className = "list-group-item list-group-item-action";
                    li.textContent = `${p.FullName} (ID: ${p.PatientId})`;

                    li.onclick = function () {
                        patientInput.value = p.FullName;
                        patientIdInput.value = p.PatientId;
                        patientList.innerHTML = "";
                    };

                    patientList.appendChild(li);
                });
            });
    });
</script>