<!-- CANCEL MODAL -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">

            @using (Html.BeginForm("Cancel", "Appointment", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <!--Header -->
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-semibold">Cancel Appointment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- Body -->
                <div class="modal-body pt-0">

                    <!-- Hidden fields -->
                    <input type="hidden" name="id" id="cancelId" />
                    <input type="hidden" name="patientId" id="cancelPatientId" />
                    <input type="hidden" name="appointmentId" value="@Request["appointmentId"]" />
                    <input type="hidden" name="patientId" value="@Request["patientId"]" />

                    <!-- Reason -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Cancellation Reason
                        </label>

                        <textarea name="reason"
                                  class="form-control"
                                  placeholder="Enter reason..."
                                  rows="3"
                                  required></textarea>
                    </div>

                </div>

                <!--Footer -->
                <div class="modal-footer border-0">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Close
                    </button>

                    <button type="submit" class="btn btn-danger">
                        Confirm Cancel
                    </button>
                </div>
            }

        </div>
    </div>
</div>