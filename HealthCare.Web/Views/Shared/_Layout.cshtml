@{
    var role = Convert.ToString(Session["Role"]);
    var email = Convert.ToString(Session["Email"]);
    var pageTitle = ViewBag.Title ?? "HealthCare Management";
}

<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <meta charset="utf-8" />
    <title>@pageTitle - HealthCare Management</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        body {
            background-color: #f5f7fb;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: #102a43;
            color: #fff;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            padding: 20px 16px;
        }

        .sidebar-brand {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 24px;
            color: #ffffff;
        }

        .sidebar-user {
            background: rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 22px;
            font-size: 13px;
        }

        .sidebar-section-title {
            color: #bcccdc;
            font-size: 12px;
            text-transform: uppercase;
            margin: 18px 0 8px;
            letter-spacing: 0.6px;
        }

        .sidebar-link {
            display: block;
            color: #d9e2ec;
            padding: 10px 12px;
            border-radius: 8px;
            text-decoration: none;
            margin-bottom: 5px;
        }

            .sidebar-link:hover,
            .sidebar-link.active {
                background: #1f4e79;
                color: #ffffff;
                text-decoration: none;
            }

        .main-content {
            margin-left: 260px;
            width: calc(100% - 260px);
            min-height: 100vh;
        }

        .topbar {
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            padding: 16px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .page-container {
            padding: 28px;
        }

        .page-card {
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
            padding: 24px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 700;
            color: #102a43;
            margin: 0;
        }

        .page-subtitle {
            color: #627d98;
            margin-top: 5px;
        }

        .form-control {
            border-radius: 8px;
        }

        .btn {
            border-radius: 8px;
        }

        .table > thead > tr > th {
            background-color: #f0f4f8;
            color: #243b53;
            border-bottom: none;
        }

        .badge-status {
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-pending {
            background: #fff7ed;
            color: #c2410c;
        }

        .badge-confirmed {
            background: #ecfdf5;
            color: #047857;
        }

        .badge-cancelled {
            background: #fef2f2;
            color: #b91c1c;
        }

        .badge-completed {
            background: #eff6ff;
            color: #1d4ed8;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .profile-item {
            background: #f8fafc;
            padding: 14px;
            border-radius: 10px;
        }

        .profile-label {
            color: #627d98;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .profile-value {
            color: #102a43;
            font-weight: 600;
        }

        @@media (max-width: 900px) {
            .sidebar {
                position: relative;
                width: 100%;
                min-height: auto;
            }

            .app-wrapper {
                flex-direction: column;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .profile-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="app-wrapper">
        @Html.Partial("_Sidebar")

        <main class="main-content">
            <div class="topbar">
                <div>
                    <strong>@pageTitle</strong>
                </div>
            </div>

            <div class="page-container">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>



    <script>
        function openConfirmModal(title, message, actionUrl) {
            $("#confirmModalTitle").text(title);
            $("#confirmModalMessage").text(message);
            $("#confirmModalForm").attr("action", actionUrl);
            $("#confirmModal").modal("show");
        }
    </script>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>