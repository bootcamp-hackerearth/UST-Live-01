@model string

@{
    var status = Model ?? "Pending";
    var cssClass = "badge-status badge-pending";

    if (status == "Confirmed")
    {
        cssClass = "badge-status badge-confirmed";
    }
    else if (status == "Cancelled")
    {
        cssClass = "badge-status badge-cancelled";
    }
    else if (status == "Completed")
    {
        cssClass = "badge-status badge-completed";
    }
}

<span class="@cssClass">@status</span>