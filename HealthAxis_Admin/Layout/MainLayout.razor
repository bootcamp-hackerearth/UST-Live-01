        border: 1px solid rgba(148, 163, 184, 0.24);
        background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.22), transparent 30%), rgba(15, 23, 42, 0.88);
        backdrop-filter: blur(16px);
        color: #ffffff;
        display: flex;
        justify-content: space-between;
