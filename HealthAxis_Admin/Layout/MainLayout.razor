        border-radius: 20px;
        background: rgba(148, 163, 184, 0.14);
        border: 1px solid rgba(148, 163, 184, 0.28);
        text-align: center;
    }

        .axis-date-time-chip span,
        .axis-date-time-chip strong {
            display: block;
            color: #e2e8f0;
            font-weight: 900;
        }

    .axis-profile-menu {
        position: relative;
    }

    .axis-profile-btn {
