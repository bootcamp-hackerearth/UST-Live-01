        .axis-admin-shell .axis-sidebar,
        .axis-admin-shell .admin-sidebar,
        .axis-admin-shell .sidebar {
            position: fixed !important;
            top: 0;
            left: 0;
            width: 300px;
            height: 100vh;
            overflow: hidden !important;
            z-index: 1000;
            scrollbar-width: none !important;
