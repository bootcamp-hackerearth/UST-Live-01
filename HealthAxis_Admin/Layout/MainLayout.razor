@inherits LayoutComponentBase
@implements IDisposable

@inject IConfiguration Configuration
@inject AuthService AuthService
@inject TokenService TokenService
@inject NavigationManager NavigationManager

<div class="axis-admin-shell" @onclick="CloseProfileMenu">

    <Sidebar />

    <main class="axis-main-area">

        <header class="axis-topbar">
            <div>
                <span class="axis-top-label">HEALTHAXIS CONTROL DESK</span>
                <h2>Admin Workspace</h2>
                <p>Manage hospital operations from one connected console.</p>
            </div>

            <div class="axis-top-actions">

                <div class="axis-date-time-chip">
                    <span>@currentDate</span>
                    <strong>@currentTime</strong>
                </div>

                <div class="axis-profile-menu" @onclick:stopPropagation="true">

                    <button type="button"
                            class="axis-profile-btn"
                            @onclick="ToggleProfileMenu">
                        @AdminInitial
                    </button>

                    @if (showProfileMenu)
                    {
                        <div class="axis-profile-dropdown">

                            <div class="axis-profile-head">
                                <div class="axis-profile-avatar">
                                    @AdminInitial
                                </div>

                                <div>
                                    <h4>@AdminDisplayName</h4>
                                    <p>System Administrator</p>
                                </div>
                            </div>

                            <button type="button"
                                    class="axis-dropdown-link"
                                    @onclick="GoToProfile">
                                View Profile
                            </button>

                            <button type="button"
                                    class="axis-dropdown-logout"
                                    @onclick="Logout">
                                Logout
                            </button>

                        </div>
                    }
                </div>

            </div>
        </header>

        <section class="axis-page-content">
            @Body
        </section>

    </main>

</div>

<style>
    html,
    body {
        overflow-x: hidden;
    }

    .axis-admin-shell {
