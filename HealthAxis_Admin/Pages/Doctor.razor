@page "/doctors"
@using Microsoft.AspNetCore.Authorization
@using HealthAxis.Shared.DTO.AdminDtos
@using HealthAxis.Shared.DTO.AuthDtos
@using HealthAxis.Shared.DTO.CommonDtos
@using HealthAxis.Shared.DTO.DoctorDtos
@using HealthAxis.Shared.Enums
@using System.Text.Json
@attribute [Authorize(Roles = "Admin")]
@inject DoctorAdminService DoctorService
@inject NavigationManager NavigationManager

<section class="doctor-list-card">

    <div class="doctor-list-header">
        <div>
            <h3>Doctors List</h3>
            <p>All registered doctors from database.</p>
        </div>

        <button type="button"
                class="primary-btn register-doctor-main-btn"
                @onclick="GoToRegisterDoctor">
            Register Doctor
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass">
            @message
        </div>
    }

    <div class="doctor-toolbar doctor-toolbar-three">

        <div class="doctor-search-box">
            <input type="text"
                   maxlength="80"
                   placeholder="Search by name, email, or specialisation..."
                   @bind="searchText"
                   @bind:event="oninput" />
        </div>

        <div class="doctor-filter-box">
            <select class="form-control" @bind="selectedSpecialisation">
                <option value="@AllSpecialisationsOption">All Specialisations</option>

                @foreach (var specialisation in Enum.GetValues<Specialisation>())
                {
                    <option value="@specialisation.ToString()">
                        @specialisation
                    </option>
                }
            </select>
        </div>

        <div class="doctor-filter-box">
            <select class="form-control" @bind="selectedStatus">
                <option value="@AllStatusOption">All Status</option>
                <option value="@ActiveStatusOption">Active</option>
                <option value="@InactiveStatusOption">Inactive</option>
            </select>
        </div>

    </div>

    @if (isLoading)
    {
        <div class="empty-box">Loading doctors from database...</div>
    }
    else if (!doctors.Any())
    {
        <div class="empty-box">No doctors found in database.</div>
    }
    else
    {
        <div class="table-wrapper doctors-table-wrapper">
            <table class="modern-table doctors-table">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Email</th>
                        <th>Specialisation</th>
                        <th>Experience</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th class="action-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var doctor in FilteredDoctors)
                    {
                        <tr>
                            <td>
                                <div class="doctor-profile-cell">
                                    <div class="doctor-avatar">
                                        @GetDoctorInitial(doctor.FullName)
                                    </div>

                                    <div>
                                        <h4>@DisplayValue(doctor.FullName)</h4>
                                        <span>ID: @doctor.DoctorId</span>
                                    </div>
                                </div>
                            </td>

                            <td>@DisplayValue(doctor.Email)</td>

                            <td>
                                <span class="specialisation-pill">
                                    @doctor.Specialisation
                                </span>
                            </td>

                            <td>@doctor.YearsOfExperience years</td>

                            <td class="fee-text">₹@doctor.ConsultationFee</td>

                            <td>
                                @if (doctor.IsActive)
                                {
                                    <span class="status-badge active-status">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge inactive-status">Inactive</span>
                                }
                            </td>

                            <td class="action-column">
                                <div class="doctor-action-row">
                                    <button type="button"
                                            class="table-action-btn view-table-action"
                                            @onclick="() => OpenViewDialog(doctor)">
                                        View
                                    </button>

                                    <button type="button"
                                            class="table-action-btn appointments-table-action"
                                            @onclick="() => OpenAppointmentsDialogAsync(doctor)">
                                        Appointments
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!FilteredDoctors.Any())
        {
            <p class="not-found">
                No doctors matched your search/filter on this page.
            </p>
        }

        @if (doctorPage.TotalPages > MinimumPaginationPages)
        {
            <div class="pagination-bar">

                <button type="button"
                        class="secondary-btn"
                        disabled="@(!doctorPage.HasPreviousPage)"
                        @onclick="GoToPreviousPage">
                    Previous
                </button>

                <span>
                    Page @doctorPage.PageNumber of @doctorPage.TotalPages
                    • Total @doctorPage.TotalRecords doctors
                </span>

                <button type="button"
                        class="secondary-btn"
                        disabled="@(!doctorPage.HasNextPage)"
                        @onclick="GoToNextPage">
                    Next
                </button>

            </div>
        }
    }

</section>

@if (showViewDialog && selectedDoctor is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog view-doctor-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Doctor Details</h3>
                    <p>View complete doctor information and manage account actions.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <div class="doctor-detail-card">

                <div class="doctor-detail-head">
                    <div class="doctor-avatar large-avatar">
                        @GetDoctorInitial(selectedDoctor.FullName)
                    </div>

                    <div>
                        <h4>@DisplayValue(selectedDoctor.FullName)</h4>
                        <p>@DisplayValue(selectedDoctor.Email)</p>
                    </div>
                </div>

                <div class="doctor-detail-grid">
                    <div>
                        <span>Doctor ID</span>
                        <strong>#@selectedDoctor.DoctorId</strong>
                    </div>

                    <div>
                        <span>Full Name</span>
                        <strong>@DisplayValue(selectedDoctor.FullName)</strong>
                    </div>

                    <div>
                        <span>Email</span>
                        <strong>@DisplayValue(selectedDoctor.Email)</strong>
                    </div>

                    <div>
                        <span>Specialisation</span>
                        <strong>@selectedDoctor.Specialisation</strong>
                    </div>

                    <div>
                        <span>Experience</span>
                        <strong>@selectedDoctor.YearsOfExperience years</strong>
                    </div>

                    <div>
                        <span>Consultation Fee</span>
                        <strong>₹@selectedDoctor.ConsultationFee</strong>
                    </div>

                    <div>
                        <span>Status</span>
                        <strong>@(selectedDoctor.IsActive ? "Active" : "Inactive")</strong>
                    </div>
                </div>

            </div>

            <div class="view-dialog-actions">
                <button type="button"
                        class="view-action-btn edit-view-action"
                        @onclick="OpenSelectedDoctorEditDialog">
                    Edit Details
                </button>

                <button type="button"
                        class="view-action-btn appointments-view-action"
                        @onclick="OpenSelectedDoctorAppointmentsDialogAsync">
                    Appointments
                </button>

                <button type="button"
                        class="view-action-btn status-view-action"
                        @onclick="OpenSelectedDoctorStatusDialog">
                    Change Status
                </button>

                <button type="button"
                        class="view-action-btn reset-view-action"
                        @onclick="OpenSelectedDoctorResetPasswordDialog">
                    Reset Password
                </button>

                <button type="button"
                        class="view-action-btn close-view-action"
                        @onclick="CloseDialogs">
                    Close
                </button>
            </div>

        </div>
    </div>
}

@if (showAppointmentsDialog && selectedDoctor is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog doctor-appointments-dialog">

            <div class="dialog-header">
                <div>
                    <h3>@selectedDoctor.FullName - Appointments</h3>
                    <p>Appointments assigned to this doctor.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <div class="appointment-filter-row">
                <label for="doctorAppointmentStatus">Status</label>

                <select id="doctorAppointmentStatus"
                        class="form-control"
                        @bind="selectedDoctorAppointmentStatus">
                    <option value="@AllAppointmentStatusOption">All Status</option>
                    <option value="@PendingStatusOption">Pending</option>
                    <option value="@ConfirmedStatusOption">Confirmed</option>
                    <option value="@CompletedStatusOption">Completed</option>
                    <option value="@CancelledStatusOption">Cancelled</option>
                </select>
            </div>

            @if (isLoadingAppointments)
            {
                <div class="empty-box">Loading appointments...</div>
            }
            else if (!FilteredDoctorAppointments.Any())
            {
                <div class="empty-box">No appointments found for this status.</div>
            }
            else
            {
                <div class="table-wrapper appointments-table-wrapper">
                    <table class="modern-table appointments-table">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var appointment in FilteredDoctorAppointments)
                            {
                                <tr>
                                    <td>@GetSafeText(appointment.PatientName, "Patient")</td>
                                    <td>@appointment.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>@GetSafeText(appointment.TimeSlot, "Not assigned")</td>
                                    <td>
                                        <span class="@GetStatusBadgeClass(appointment.Status)">
                                            @appointment.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="dialog-actions">
                <button type="button"
                        class="secondary-btn"
                        @onclick="CloseDialogs">
                    Close
                </button>
            </div>

        </div>
    </div>
}

@if (showEditDialog)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Edit Doctor</h3>
                    <p>Update doctor details and save changes.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <EditForm Model="@editForm" OnValidSubmit="SaveEditedDoctor">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid">

                    <div class="form-group">
                        <label>Doctor Name</label>
                        <InputText class="form-control"
                                   @bind-Value="editForm.FullName" />
                        <ValidationMessage For="@(() => editForm.FullName)" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <InputText class="form-control"
                                   @bind-Value="editForm.Email" />
                        <ValidationMessage For="@(() => editForm.Email)" />
                    </div>

                    <div class="form-group">
                        <label>Specialisation</label>
                        <InputSelect class="form-control"
                                     @bind-Value="editForm.Specialisation">
                            @foreach (var specialisation in Enum.GetValues<Specialisation>())
                            {
                                <option value="@specialisation">
                                    @specialisation
                                </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => editForm.Specialisation)" />
                    </div>

                    <div class="form-group">
                        <label>Years of Experience</label>
                        <InputNumber class="form-control"
                                     @bind-Value="editForm.YearsOfExperience" />
                        <ValidationMessage For="@(() => editForm.YearsOfExperience)" />
                    </div>

                    <div class="form-group">
                        <label>Consultation Fee</label>
                        <InputNumber class="form-control"
                                     @bind-Value="editForm.ConsultationFee" />
                        <ValidationMessage For="@(() => editForm.ConsultationFee)" />
                    </div>

                    <div class="form-group register-toggle-group">
                        <label>Status</label>

                        <label class="hx-toggle-control">
                            <input type="checkbox"
                                   class="hx-toggle-input"
                                   @bind="editForm.IsActive" />

                            <span class="hx-toggle-slider"></span>
                            <span class="hx-toggle-text">Active Doctor</span>
                        </label>
                    </div>

                </div>

                <div class="dialog-actions">
                    <button type="submit" class="primary-btn">
                        Save Changes
                    </button>

                    <button type="button"
                            class="secondary-btn"
                            @onclick="CloseDialogs">
                        Cancel
                    </button>
                </div>

            </EditForm>

        </div>
    </div>
}

@if (showStatusDialog && selectedDoctor is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog small-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Change Doctor Status</h3>
                    <p>Confirm status update.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <p class="dialog-message">
                Do you want to change status for
                <b>@selectedDoctor.FullName</b>?
            </p>

            <div class="dialog-actions">
                <button type="button"
                        class="primary-btn"
                        @onclick="ConfirmStatusChange">
                    Yes, Change Status
                </button>

                <button type="button"
                        class="secondary-btn"
                        @onclick="CloseDialogs">
                    Cancel
                </button>
            </div>

        </div>
    </div>
}

@if (showResetPasswordDialog && resetPasswordDoctor is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog reset-password-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Reset Doctor Password</h3>
                    <p>Set a new password for @resetPasswordDoctor.FullName.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        disabled="@isResettingPassword"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <div class="reset-user-summary">
                <div class="doctor-avatar">
                    @GetDoctorInitial(resetPasswordDoctor.FullName)
                </div>

                <div>
                    <h4>@DisplayValue(resetPasswordDoctor.FullName)</h4>
                    <p>@DisplayValue(resetPasswordDoctor.Email)</p>
                    <span>Doctor account</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(resetPasswordError))
            {
                <div class="error-box">
                    @resetPasswordError
                </div>
            }

            <EditForm Model="@resetPasswordForm" OnValidSubmit="ResetDoctorPassword">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid reset-password-grid">
                    <div class="form-group full-width">
                        <label>New Password</label>
                        <InputText type="password"
                                   class="form-control reset-password-input"
                                   @bind-Value="resetPasswordForm.NewPassword" />
                        <ValidationMessage For="@(() => resetPasswordForm.NewPassword)" />
                    </div>

                    <div class="form-group full-width">
                        <label>Confirm Password</label>
                        <InputText type="password"
                                   class="form-control reset-password-input"
                                   @bind-Value="resetPasswordForm.ConfirmPassword" />
                        <ValidationMessage For="@(() => resetPasswordForm.ConfirmPassword)" />
                    </div>
                </div>

                <p class="password-help-text">
                    Use a strong password with uppercase, lowercase, number, special character, and at least 8 characters.
                </p>

                <div class="dialog-actions">
                    <button type="submit"
                            class="primary-btn"
                            disabled="@isResettingPassword">
                        @(isResettingPassword ? "Resetting..." : "Reset Password")
                    </button>

                    <button type="button"
                            class="secondary-btn"
                            disabled="@isResettingPassword"
                            @onclick="CloseDialogs">
                        Cancel
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
}

<style>
    .doctors-table-wrapper,
    .appointments-table-wrapper {
        overflow-x: auto;
    }

    .doctors-table {
        width: 100%;
        table-layout: fixed;
    }

        .doctors-table th:nth-child(1),
        .doctors-table td:nth-child(1) {
            width: 19%;
        }

        .doctors-table th:nth-child(2),
        .doctors-table td:nth-child(2) {
            width: 22%;
        }

        .doctors-table th:nth-child(3),
        .doctors-table td:nth-child(3) {
            width: 14%;
        }

        .doctors-table th:nth-child(4),
        .doctors-table td:nth-child(4) {
            width: 11%;
        }

        .doctors-table th:nth-child(5),
        .doctors-table td:nth-child(5) {
            width: 8%;
        }

        .doctors-table th:nth-child(6),
        .doctors-table td:nth-child(6) {
            width: 10%;
        }

