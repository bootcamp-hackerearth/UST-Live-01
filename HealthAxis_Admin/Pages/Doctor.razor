        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .password-help-text {
        margin: 12px 0 0;
        color: #cbd5e1;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.5;
    }

    .reset-password-input {
        color: #ffffff;
        background: rgba(15, 23, 42, 0.65);
    }

        .reset-password-input::-ms-reveal,
        .reset-password-input::-ms-clear {
            filter: invert(1) brightness(2);
        }

    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        filter: invert(1) brightness(2);
    }

    @@media (max-width: 1100px) {
        .doctors-table {
            min-width: 1080px;
        }
    }

    @@media (max-width: 800px) {
        .doctor-detail-grid,
        .appointment-filter-row {
            grid-template-columns: 1fr;
        }

        .view-dialog-actions {
            justify-content: stretch;
        }

        .view-action-btn {
            width: 100%;
        }

        .doctor-action-row {
            flex-direction: column;
            align-items: stretch !important;
        }

        .table-action-btn {
            width: 100%;
        }
    }
</style>

@code {
    private const int FirstPageNumber = 1;
    private const int MinimumPaginationPages = 1;
    private const int MessageAutoHideMilliseconds = 3000;

    private const string AllSpecialisationsOption = "All";
    private const string AllStatusOption = "All";
    private const string ActiveStatusOption = "Active";
    private const string InactiveStatusOption = "Inactive";

    private const string AllAppointmentStatusOption = "All";
    private const string PendingStatusOption = "Pending";
    private const string ConfirmedStatusOption = "Confirmed";
    private const string CompletedStatusOption = "Completed";
    private const string CancelledStatusOption = "Cancelled";

    private List<DoctorDto> doctors = new();
    private List<AdminAppointmentDetailDto> doctorAppointments = new();

    private PagedResponseDto<DoctorDto> doctorPage = new();

    private CreateDoctorDto editForm = new();
    private AdminResetPasswordDto resetPasswordForm = new();

    private DoctorDto? selectedDoctor;
    private DoctorDto? resetPasswordDoctor;

    private string message = string.Empty;
    private string messageClass = "success-box";
    private string searchText = string.Empty;
    private string selectedSpecialisation = AllSpecialisationsOption;
    private string selectedStatus = AllStatusOption;
    private string selectedDoctorAppointmentStatus = AllAppointmentStatusOption;
    private string resetPasswordError = string.Empty;

    private bool isLoading;
    private bool isLoadingAppointments;
    private bool showViewDialog;
    private bool showAppointmentsDialog;
    private bool showEditDialog;
    private bool showStatusDialog;
    private bool showResetPasswordDialog;
    private bool isResettingPassword;

    private int currentPage = FirstPageNumber;
    private int editingDoctorId;
    private int messageVersion;

    private List<DoctorDto> FilteredDoctors
    {
        get
        {
            var filteredDoctors = doctors.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                filteredDoctors = filteredDoctors.Where(doctor =>
                    ContainsIgnoreCase(doctor.FullName, searchText) ||
                    ContainsIgnoreCase(doctor.Email, searchText) ||
                    ContainsIgnoreCase(doctor.Specialisation.ToString(), searchText));
            }

            if (!string.Equals(
                    selectedSpecialisation,
                    AllSpecialisationsOption,
                    StringComparison.OrdinalIgnoreCase) &&
                Enum.TryParse<Specialisation>(selectedSpecialisation, out var specialisation))
            {
                filteredDoctors = filteredDoctors.Where(doctor =>
                    doctor.Specialisation == specialisation);
            }

            if (string.Equals(
                    selectedStatus,
                    ActiveStatusOption,
                    StringComparison.OrdinalIgnoreCase))
            {
                filteredDoctors = filteredDoctors.Where(doctor => doctor.IsActive);
            }

            if (string.Equals(
                    selectedStatus,
                    InactiveStatusOption,
                    StringComparison.OrdinalIgnoreCase))
            {
                filteredDoctors = filteredDoctors.Where(doctor => !doctor.IsActive);
            }

            return filteredDoctors.ToList();
        }
    }

    private List<AdminAppointmentDetailDto> FilteredDoctorAppointments
    {
        get
        {
            if (string.Equals(
                    selectedDoctorAppointmentStatus,
                    AllAppointmentStatusOption,
                    StringComparison.OrdinalIgnoreCase))
            {
                return doctorAppointments;
            }

            return doctorAppointments
                .Where(appointment => string.Equals(
                    appointment.Status,
                    selectedDoctorAppointmentStatus,
                    StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }

    private async Task LoadDoctors(
        int pageNumber = FirstPageNumber,
        bool clearCurrentMessage = true)
    {
        isLoading = true;

        if (clearCurrentMessage)
        {
            message = string.Empty;
        }

        try
        {
            doctorPage = await DoctorService.GetDoctorsPageAsync(pageNumber);
            doctors = doctorPage.Items ?? new List<DoctorDto>();
            currentPage = doctorPage.PageNumber;
        }
        catch (TaskCanceledException)
        {
            doctors = new List<DoctorDto>();
            ShowMessage(
                "Doctors loading timed out. Please check if HealthAxis.API is running.",
                false);
        }
        catch (HttpRequestException)
        {
            doctors = new List<DoctorDto>();
            ShowMessage(
                "Unable to connect to API. Please run HealthAxis.API and try again.",
                false);
        }
        catch (JsonException)
        {
            doctors = new List<DoctorDto>();
            ShowMessage(
                "Doctors loading failed because response format is invalid.",
                false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToRegisterDoctor()
    {
        NavigationManager.NavigateTo("/doctors/register");
    }

    private void OpenViewDialog(DoctorDto doctor)
    {
        selectedDoctor = doctor;
        showViewDialog = true;
        message = string.Empty;
    }

    private async Task OpenAppointmentsDialogAsync(DoctorDto doctor)
    {
        selectedDoctor = doctor;
        doctorAppointments = new List<AdminAppointmentDetailDto>();
        selectedDoctorAppointmentStatus = AllAppointmentStatusOption;

        showViewDialog = false;
        showAppointmentsDialog = true;
        isLoadingAppointments = true;
        message = string.Empty;

        try
        {
            doctorAppointments = await DoctorService.GetDoctorAppointmentsAsync(
                doctor.DoctorId);
        }
        catch (TaskCanceledException)
        {
            ShowMessage(
                "Appointments loading timed out. Please check if HealthAxis.API is running.",
                false);
        }
        catch (HttpRequestException)
        {
            ShowMessage("Could not load doctor appointments.", false);
        }
        catch (JsonException)
        {
            ShowMessage("Appointment data format is invalid.", false);
        }
        finally
        {
            isLoadingAppointments = false;
        }
    }

    private void OpenSelectedDoctorEditDialog()
    {
        if (selectedDoctor is not null)
        {
            OpenEditDialog(selectedDoctor);
        }
    }

    private void OpenSelectedDoctorStatusDialog()
    {
        if (selectedDoctor is not null)
        {
            OpenStatusDialog(selectedDoctor);
        }
    }

    private void OpenSelectedDoctorResetPasswordDialog()
    {
        if (selectedDoctor is not null)
        {
            OpenResetPasswordDialog(selectedDoctor);
        }
    }

    private async Task OpenSelectedDoctorAppointmentsDialogAsync()
    {
        if (selectedDoctor is not null)
        {
            await OpenAppointmentsDialogAsync(selectedDoctor);
        }
    }

    private void OpenEditDialog(DoctorDto doctor)
    {
        selectedDoctor = doctor;
        editingDoctorId = doctor.DoctorId;

        editForm = new CreateDoctorDto
        {
            FullName = doctor.FullName,
            Email = doctor.Email,
            Specialisation = doctor.Specialisation,
            YearsOfExperience = doctor.YearsOfExperience,
            ConsultationFee = doctor.ConsultationFee,
            IsActive = doctor.IsActive
        };

        showViewDialog = false;
        showEditDialog = true;
        message = string.Empty;
    }

    private async Task SaveEditedDoctor()
    {
        var result = await DoctorService.UpdateDoctorAsync(
            editingDoctorId,
            editForm);

        if (result.Success)
        {
            CloseDialogs();
            await LoadDoctors(currentPage, clearCurrentMessage: false);
        }

        ShowMessage(result.Message, result.Success);
    }

    private void OpenStatusDialog(DoctorDto doctor)
    {
        selectedDoctor = doctor;
        showViewDialog = false;
        showStatusDialog = true;
        message = string.Empty;
    }

    private async Task ConfirmStatusChange()
    {
        if (selectedDoctor is null)
        {
            return;
        }

        var result = await DoctorService.ToggleDoctorStatusAsync(selectedDoctor);

        if (result.Success)
        {
            CloseDialogs();
            await LoadDoctors(currentPage, clearCurrentMessage: false);
        }

        ShowMessage(result.Message, result.Success);
    }

    private void OpenResetPasswordDialog(DoctorDto doctor)
    {
        resetPasswordDoctor = doctor;

        resetPasswordForm = new AdminResetPasswordDto
        {
            Email = doctor.Email
        };

        resetPasswordError = string.Empty;
        message = string.Empty;

        showViewDialog = false;
        showEditDialog = false;
        showStatusDialog = false;
        showAppointmentsDialog = false;
        showResetPasswordDialog = true;
    }

    private async Task ResetDoctorPassword()
    {
        if (resetPasswordDoctor is null)
        {
            resetPasswordError = "Please select a doctor.";
            return;
        }

        if (resetPasswordForm.NewPassword != resetPasswordForm.ConfirmPassword)
        {
            resetPasswordError =
                "New password and confirm password do not match.";
            return;
        }

        isResettingPassword = true;
        resetPasswordError = string.Empty;

        resetPasswordForm.Email = resetPasswordDoctor.Email;

        var doctorName = resetPasswordDoctor.FullName;
        var result = await DoctorService.ResetPasswordAsync(resetPasswordForm);

        isResettingPassword = false;

        if (!result.Success)
        {
            resetPasswordError = result.Message;
            return;
        }

        CloseDialogs();

        ShowMessage(
            $"Password reset successfully for {doctorName}.",
            true);
    }

    private async Task GoToPreviousPage()
    {
        if (doctorPage.HasPreviousPage)
        {
            ClearSearchAndFilter();
            await LoadDoctors(currentPage - 1);
        }
    }

    private async Task GoToNextPage()
    {
        if (doctorPage.HasNextPage)
        {
            ClearSearchAndFilter();
            await LoadDoctors(currentPage + 1);
        }
    }

    private void CloseDialogs()
    {
        if (isResettingPassword)
        {
            return;
        }

        showViewDialog = false;
        showAppointmentsDialog = false;
        showEditDialog = false;
        showStatusDialog = false;
        showResetPasswordDialog = false;

        selectedDoctor = null;
        resetPasswordDoctor = null;

        editingDoctorId = 0;

        editForm = new CreateDoctorDto();
        resetPasswordForm = new AdminResetPasswordDto();

        doctorAppointments = new List<AdminAppointmentDetailDto>();
        selectedDoctorAppointmentStatus = AllAppointmentStatusOption;

        resetPasswordError = string.Empty;
    }

    private void ClearSearchAndFilter()
    {
        searchText = string.Empty;
        selectedSpecialisation = AllSpecialisationsOption;
        selectedStatus = AllStatusOption;
    }

    private void ShowMessage(string text, bool isSuccess)
    {
        message = text;
        messageClass = isSuccess ? "success-box" : "error-box";

        messageVersion++;
        _ = ClearMessageAfterDelayAsync(messageVersion);
    }

    private async Task ClearMessageAfterDelayAsync(int version)
    {
        await Task.Delay(MessageAutoHideMilliseconds);

        if (version == messageVersion)
        {
            message = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool ContainsIgnoreCase(
        string? value,
        string searchValue)
    {
        return !string.IsNullOrWhiteSpace(value) &&
            value.Contains(searchValue, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetDoctorInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "D";
        }

        var cleanName = name
            .Replace("Dr.", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("Dr", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Trim();

        if (string.IsNullOrWhiteSpace(cleanName))
        {
            return "D";
        }

        return cleanName[..1].ToUpperInvariant();
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not available"
            : value.Trim();
    }

    private static string GetSafeText(
        string? value,
        string fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value.Trim();
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            PendingStatusOption => "status-badge pending-badge",
            ConfirmedStatusOption => "status-badge confirmed-badge",
            CompletedStatusOption => "status-badge active-status",
            CancelledStatusOption => "status-badge inactive-status",
            _ => "status-badge"
        };
    }
}