        }

            body * {
                visibility: hidden !important;
            }

        .user-print-area,
        .user-print-area * {
            visibility: visible !important;
        }

        .user-print-area {
            display: block !important;
            position: static !important;
            width: 100% !important;
            height: auto !important;
            overflow: visible !important;
            padding: 0 !important;
            margin: 0 !important;
            background: #ffffff !important;
            color: #111827 !important;
            font-family: Arial, sans-serif !important;
        }

        .print-header {
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 2px solid #111827;
        }

            .print-header h1 {
                margin: 0 0 8px;
                font-size: 22px;
                color: #111827;
            }

            .print-header p {
                margin: 3px 0;
                font-size: 12px;
                color: #374151;
            }

        .print-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 9px;
            page-break-inside: auto;
        }

            .print-table thead {
                display: table-header-group;
            }

            .print-table tbody {
                display: table-row-group;
            }

            .print-table tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }

            .print-table th,
            .print-table td {
                border: 1px solid #d1d5db;
                padding: 6px;
                text-align: left;
                vertical-align: top;
                color: #111827;
                word-break: break-word;
            }

            .print-table th {
                background: #e5e7eb !important;
                font-weight: 700;
            }

        @@page {
            size: landscape;
            margin: 10mm;
        }
    }
</style>

@code {
    private const int FirstPageNumber = 1;
    private const int MinimumPaginationPages = 1;
    private const int PageSize = 6;
    private const int MessageAutoHideMilliseconds = 3000;
    private const int PrintDelayMilliseconds = 200;

    private const string AllRolesOption = "All";
    private const string AdminRole = "Admin";
    private const string DoctorRole = "Doctor";
    private const string PatientRole = "Patient";

    private List<AdminUserDto> users = new();

    private AdminUserDto? selectedUser;

    private string searchText = string.Empty;
    private string selectedRole = AllRolesOption;
    private string message = string.Empty;
    private string messageClass = "success-box";

    private bool isLoading;
    private bool isExportingPdf;
    private bool showViewDialog;

    private int currentPage = FirstPageNumber;
    private int messageVersion;

    private List<AdminUserDto> FilteredUsers
    {
        get
        {
            var filteredUsers = users.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                filteredUsers = filteredUsers.Where(user =>
                    ContainsIgnoreCase(user.FullName, searchText) ||
                    ContainsIgnoreCase(user.Email, searchText) ||
                    ContainsIgnoreCase(user.Role, searchText) ||
                    ContainsIgnoreCase(user.PhoneNumber, searchText) ||
                    ContainsIgnoreCase(user.Specialisation, searchText) ||
                    ContainsIgnoreCase(user.UserId, searchText));
            }

            if (!string.Equals(
                    selectedRole,
                    AllRolesOption,
                    StringComparison.OrdinalIgnoreCase))
            {
                filteredUsers = filteredUsers.Where(user =>
                    string.Equals(
                        user.Role,
                        selectedRole,
                        StringComparison.OrdinalIgnoreCase));
            }

            return filteredUsers.ToList();
        }
    }

    private List<AdminUserDto> PagedUsers =>
        FilteredUsers
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        FilteredUsers.Count == 0
            ? FirstPageNumber
            : (int)Math.Ceiling((double)FilteredUsers.Count / PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            users = await UserService.GetAllUsersAsync();
            currentPage = FirstPageNumber;
        }
        catch (TaskCanceledException)
        {
            users = new List<AdminUserDto>();
            ShowMessage(
                "Users loading timed out. Please check if HealthAxis.API is running.",
                false);
        }
        catch (HttpRequestException)
        {
            users = new List<AdminUserDto>();
            ShowMessage("Could not load users.", false);
        }
        catch (InvalidOperationException)
        {
            users = new List<AdminUserDto>();
            ShowMessage("User service is not available.", false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrintUsersAsync()
    {
        if (isExportingPdf)
        {
            return;
        }

        if (users.Count == 0)
        {
            ShowMessage("No users available to export.", false);
            return;
        }

        isExportingPdf = true;

        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(PrintDelayMilliseconds);
            await JSRuntime.InvokeVoidAsync("print");
        }
        finally
        {
            isExportingPdf = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenViewDialog(AdminUserDto user)
    {
        selectedUser = user;
        showViewDialog = true;
    }

    private void CloseViewDialog()
    {
        selectedUser = null;
        showViewDialog = false;
    }

    private void GoToPreviousPage()
    {
        if (currentPage > FirstPageNumber)
        {
            currentPage--;
        }
    }

    private void GoToNextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void ShowMessage(string text, bool isSuccess)
    {
        message = text;
        messageClass = isSuccess ? "success-box" : "error-box";

        messageVersion++;
        _ = ClearMessageAfterDelayAsync(messageVersion);
    }

    private async Task ClearMessageAfterDelayAsync(int version)
    {
        await Task.Delay(MessageAutoHideMilliseconds);

        if (version == messageVersion)
        {
            message = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool ContainsIgnoreCase(
        string? value,
        string searchValue)
    {
        return !string.IsNullOrWhiteSpace(value) &&
            value.Contains(searchValue, StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDoctor(string role)
    {
        return string.Equals(
            role,
            DoctorRole,
            StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not available"
            : value.Trim();
    }

    private static string GetSpecialisationDisplay(AdminUserDto user)
    {
        return IsDoctor(user.Role)
            ? DisplayValue(user.Specialisation)
            : "Not applicable";
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "U";
        }

        return name.Trim()[..1].ToUpperInvariant();
    }

    private static string GetShortId(string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId))
        {
            return "Not available";
        }

        return userId.Length <= 8
            ? userId
            : userId[..8];
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("dd MMM yyyy")
            : "Not available";
    }

    private static string GetAvatarClass(string role)
    {
        if (string.Equals(role, AdminRole, StringComparison.OrdinalIgnoreCase))
        {
            return "user-avatar-admin";
        }

        if (string.Equals(role, DoctorRole, StringComparison.OrdinalIgnoreCase))
        {
            return "user-avatar-doctor";
        }

        if (string.Equals(role, PatientRole, StringComparison.OrdinalIgnoreCase))
        {
            return "user-avatar-patient";
        }

        return string.Empty;
    }

    private static string GetRoleBadgeClass(string role)
    {
        if (string.Equals(role, AdminRole, StringComparison.OrdinalIgnoreCase))
        {
            return "role-badge admin-role";
        }

        if (string.Equals(role, DoctorRole, StringComparison.OrdinalIgnoreCase))
        {
            return "role-badge doctor-role";
        }

        if (string.Equals(role, PatientRole, StringComparison.OrdinalIgnoreCase))
        {
            return "role-badge patient-role";
        }

        return "role-badge default-role";
    }
}