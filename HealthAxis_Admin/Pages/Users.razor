        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .user-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

        .user-detail-grid div {
            padding: 14px;
            border-radius: 16px;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid rgba(148, 163, 184, 0.16);
        }

        .user-detail-grid span {
