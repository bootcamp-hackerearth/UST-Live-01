        }

        .users-table th:nth-child(2),
        .users-table td:nth-child(2) {
            width: 21%;
        }

        .users-table th:nth-child(3),
        .users-table td:nth-child(3) {
            width: 13%;
        }

        .users-table th:nth-child(4),
        .users-table td:nth-child(4) {
            width: 15%;
        }

        .users-table th:nth-child(5),
        .users-table td:nth-child(5) {
            width: 9%;
        }

        .users-table th:nth-child(6),
        .users-table td:nth-child(6) {
            width: 9%;
        }

        .users-table th:nth-child(7),
        .users-table td:nth-child(7) {
            width: 11%;
        }

        .users-table th,
        .users-table td {
            vertical-align: middle;
        }

    .wrap-text {
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .user-profile-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .user-name-block {
        min-width: 0;
    }

        .user-name-block h4 {
            margin: 0;
            color: #ffffff;
            font-size: 15px;
            font-weight: 900;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-name-block span {
            display: block;
            margin-top: 4px;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

    .action-column {
        text-align: center !important;
    }

    .user-view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 74px;
        height: 34px;
        border: 1px solid rgba(56, 189, 248, 0.35);
        border-radius: 999px;
        background: rgba(14, 165, 233, 0.18);
        color: #7dd3fc;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
        white-space: nowrap;
    }

        .user-view-btn:hover {
            background: rgba(14, 165, 233, 0.28);
        }

    .small-refresh-btn,
    .export-pdf-btn {
