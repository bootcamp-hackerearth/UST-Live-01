@page "/users"
@attribute [Authorize(Roles = "Admin")]

@using HealthAxis.Shared.DTO.AdminDtos
@using Microsoft.JSInterop

@inject UserAdminService UserService
@inject IJSRuntime JSRuntime

<section class="doctor-list-card user-admin-card">

    <div class="doctor-list-header">
        <div>
            <h3>Users List</h3>
            <p>All system users from database.</p>
        </div>

        <div class="user-header-actions">
            <button type="button"
                    class="export-pdf-btn"
                    disabled="@(isLoading || isExportingPdf)"
                    @onclick="PrintUsersAsync">
                @(isExportingPdf ? "Preparing PDF..." : "Export PDF")
            </button>

            <button type="button"
                    class="small-refresh-btn"
                    disabled="@isLoading"
                    @onclick="LoadUsersAsync">
                @(isLoading ? "Loading..." : "Refresh")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass">
            @message
        </div>
    }

    <div class="users-toolbar">
        <div class="doctor-search-box">
            <input type="text"
                   maxlength="80"
                   placeholder="Search name, email, role, phone, or specialisation..."
                   @bind="searchText"
                   @bind:event="oninput" />
        </div>

        <div class="doctor-filter-box">
            <select class="form-control" @bind="selectedRole">
                <option value="@AllRolesOption">All Roles</option>
                <option value="@AdminRole">Admin</option>
                <option value="@DoctorRole">Doctor</option>
                <option value="@PatientRole">Patient</option>
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="empty-box">
            Loading users from database...
        </div>
    }
    else if (FilteredUsers.Count == 0)
    {
        <div class="empty-box">
            No users found.
        </div>
    }
    else
    {
        <div class="users-table-wrapper">
            <table class="modern-table users-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Specialisation</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="action-column">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in PagedUsers)
                    {
                        <tr>
                            <td>
                                <div class="user-profile-cell">
                                    <div class="doctor-avatar @GetAvatarClass(user.Role)">
                                        @GetInitial(user.FullName)
                                    </div>

                                    <div class="user-name-block">
                                        <h4>@DisplayValue(user.FullName)</h4>
                                        <span>ID: @GetShortId(user.UserId)</span>
                                    </div>
                                </div>
                            </td>

                            <td class="wrap-text">
                                @DisplayValue(user.Email)
                            </td>

                            <td class="wrap-text">
                                @DisplayValue(user.PhoneNumber)
                            </td>

                            <td>
                                @if (IsDoctor(user.Role))
                                {
                                    <span class="specialisation-pill">
                                        @DisplayValue(user.Specialisation)
                                    </span>
                                }
                                else
                                {
                                    <span class="not-applicable-text">
                                        Not applicable
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="@GetRoleBadgeClass(user.Role)">
                                    @DisplayValue(user.Role)
                                </span>
                            </td>

                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="status-badge active-status">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive-status">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td class="action-column">
                                <button type="button"
                                        class="user-view-btn"
                                        @onclick="() => OpenViewDialog(user)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > MinimumPaginationPages)
        {
            <div class="pagination-bar users-pagination">
                <button type="button"
                        class="secondary-btn"
                        disabled="@(currentPage == FirstPageNumber)"
                        @onclick="GoToPreviousPage">
                    Previous
                </button>

                <span>
                    Page @currentPage of @TotalPages
                    • Total @FilteredUsers.Count users
                </span>

                <button type="button"
                        class="secondary-btn"
                        disabled="@(currentPage == TotalPages)"
                        @onclick="GoToNextPage">
                    Next
                </button>
            </div>
        }
    }

</section>

<section class="user-print-area">
    <div class="print-header">
        <h1>HealthAxis Users Report</h1>
        <p>Generated on @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")</p>
        <p>Total Users: @users.Count</p>
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <th>User ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Specialisation</th>
                <th>Status</th>
                <th>Created Date</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in users
                .OrderBy(user => user.Role)
                .ThenBy(user => user.FullName))
            {
                <tr>
                    <td>@DisplayValue(user.UserId)</td>
                    <td>@DisplayValue(user.FullName)</td>
                    <td>@DisplayValue(user.Email)</td>
                    <td>@DisplayValue(user.PhoneNumber)</td>
                    <td>@DisplayValue(user.Role)</td>
                    <td>@GetSpecialisationDisplay(user)</td>
                    <td>@(user.IsActive ? "Active" : "Inactive")</td>
                    <td>@FormatDate(user.CreatedDate)</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@if (showViewDialog && selectedUser is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog user-detail-dialog">

            <div class="dialog-header">
                <div>
                    <h3>User Details</h3>
                    <p>Complete account information for this user.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseViewDialog">
                    ×
                </button>
            </div>

            <div class="user-detail-card">
                <div class="user-detail-grid">

                    <div>
                        <span>User ID</span>
                        <strong>@selectedUser.UserId</strong>
                    </div>

                    <div>
                        <span>Full Name</span>
                        <strong>@DisplayValue(selectedUser.FullName)</strong>
                    </div>

                    <div>
                        <span>Email</span>
                        <strong>@DisplayValue(selectedUser.Email)</strong>
                    </div>

                    <div>
                        <span>Phone</span>
                        <strong>@DisplayValue(selectedUser.PhoneNumber)</strong>
                    </div>

                    <div>
                        <span>Role</span>
                        <strong>@DisplayValue(selectedUser.Role)</strong>
                    </div>

                    <div>
                        <span>Status</span>
                        <strong>@(selectedUser.IsActive ? "Active" : "Inactive")</strong>
                    </div>

                    <div>
                        <span>Specialisation</span>
                        <strong>@GetSpecialisationDisplay(selectedUser)</strong>
                    </div>

                    <div>
                        <span>Created Date</span>
                        <strong>@FormatDate(selectedUser.CreatedDate)</strong>
                    </div>

                </div>
            </div>

            <div class="dialog-actions">
                <button type="button"
                        class="secondary-btn"
                        @onclick="CloseViewDialog">
                    Close
                </button>
            </div>

        </div>
    </div>
}

<style>
