@page "/dashboard"
@attribute [Authorize(Roles = "Admin")]
@inject AuthService AuthService
@inject DoctorAdminService DoctorService
@inject UserAdminService UserService
@inject ReportService ReportService
@inject NavigationManager NavigationManager

<h1>Admin Dashboard</h1>

<p class="page-subtitle">
    Overview of hospital operations, users, doctors and appointments.
</p>

<section class="stats-grid">

    <div class="stat-card">
        <div class="stat-icon blue">👨‍⚕️</div>
        <div>
            <p>Total Doctors</p>
            <h2>@doctors.Count</h2>
            <span>@doctors.Count(d => d.IsActive) active doctors</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon green">👥</div>
        <div>
            <p>Total Users</p>
            <h2>@users.Count</h2>
            <span>Patients, doctors and admins</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon orange">📅</div>
        <div>
            <p>Appointments</p>
            <h2>@reports.Count</h2>
            <span>Static appointment records</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon purple">✅</div>
        <div>
            <p>Completed Visits</p>
            <h2>@reports.Count(r => r.Status == "Completed")</h2>
            <span>Completed appointments</span>
        </div>
    </div>

</section>

<section class="dashboard-grid">

    <div class="panel">
        <div class="panel-heading">
            <div>
                <h3>Recent Appointments</h3>
                <p>Latest hospital bookings</p>
            </div>
        </div>

        @foreach (var appointment in reports.Take(3))
        {
            <div class="appointment-card">
                <div>
                    <h4>@appointment.PatientName</h4>
                    <p>@appointment.Specialisation • @appointment.DoctorName</p>
                </div>

                <span class="time-pill">@appointment.TimeSlot</span>
            </div>
        }
    </div>

    <div class="panel">
        <div class="panel-heading">
            <div>
                <h3>Appointment Status</h3>
                <p>Hospital flow summary</p>
            </div>
        </div>

        <div class="status-item">
            <span class="dot pending"></span>
            <p>Pending - @reports.Count(r => r.Status == "Pending")</p>
        </div>

        <div class="status-item">
            <span class="dot confirmed"></span>
            <p>Confirmed - @reports.Count(r => r.Status == "Confirmed")</p>
        </div>

        <div class="status-item">
            <span class="dot completed"></span>
            <p>Completed - @reports.Count(r => r.Status == "Completed")</p>
        </div>

        <div class="status-item">
            <span class="dot cancelled"></span>
            <p>Cancelled - @reports.Count(r => r.Status == "Cancelled")</p>
        </div>
    </div>

</section>

@code {
    private List<DoctorDto> doctors = new();
    private List<AdminUserDto> users = new();
    private List<AppointmentReportDto> reports = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        doctors = await DoctorService.GetAllDoctorsAsync();
        users = await UserService.GetAllUsersAsync();
        reports = await ReportService.GetAppointmentReportsAsync();
    }
}