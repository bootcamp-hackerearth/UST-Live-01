@page "/external-login"

@using HealthAxis_Admin.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="external-login-page">
    <div class="external-login-card">
        @if (_isLoading)
        {
            <div class="loading-spinner"></div>

            <h1>Opening HealthAxis Admin</h1>

            <p>Please wait while the admin portal is prepared.</p>
        }
        else
        {
            <h1>Admin login failed</h1>

            <p>@_errorMessage</p>

            <button type="button"
                    class="retry-button"
                    @onclick="ReturnToLogin">
                Return to login
            </button>
        }
    </div>
</div>

@code {
    private const string DefaultErrorMessage =
        "Unable to complete admin login.";

    private const string MissingTokenMessage =
        "Access token was not found.";

    private const string TimeoutMessage =
        "Admin login timed out. Please try again.";

    private const string ServerErrorMessage =
        "Unable to connect to the HealthAxis server.";

    private const string LoginErrorMessage =
        "Unable to complete the Admin login.";

    private const string InvalidLoginDataMessage =
        "The Admin login information is invalid.";

    private const string DashboardPath =
        "dashboard";

    private const string AngularLoginPath =
        "/angular/login";

    private static readonly TimeSpan LoginTimeout =
        TimeSpan.FromSeconds(15);

    private bool _hasStarted;
    private bool _isLoading = true;

    private string _errorMessage =
        DefaultErrorMessage;

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender || _hasStarted)
        {
            return;
        }

        _hasStarted = true;

        try
        {
            var parameters =
                ReadFragmentParameters(
                    NavigationManager.Uri);

            parameters.TryGetValue(
                "accessToken",
                out var accessToken);

            parameters.TryGetValue(
                "refreshToken",
                out var refreshToken);

            if (string.IsNullOrWhiteSpace(accessToken))
            {
                ShowError(MissingTokenMessage);
                return;
            }

            var loginTask =
                AuthService.CompleteExternalLoginAsync(
                    accessToken,
                    refreshToken);

            var completedTask =
                await Task.WhenAny(
                    loginTask,
                    Task.Delay(LoginTimeout));

            if (completedTask != loginTask)
            {
                ShowError(TimeoutMessage);
                return;
            }

            var result = await loginTask;

            if (!result.Success)
            {
                ShowError(result.Message);
                return;
            }

            // Use client-side navigation here.
            // Authentication state was already updated
            // by CompleteExternalLoginAsync.
            NavigationManager.NavigateTo(
                DashboardPath,
                replace: true);
        }
        catch (HttpRequestException)
        {
            ShowError(ServerErrorMessage);
        }
        catch (InvalidOperationException)
        {
            ShowError(LoginErrorMessage);
        }
        catch (UriFormatException)
        {
            ShowError(InvalidLoginDataMessage);
        }
    }

    private void ShowError(string message)
    {
        _isLoading = false;

        _errorMessage =
            string.IsNullOrWhiteSpace(message)
                ? DefaultErrorMessage
                : message;

        StateHasChanged();
    }

    private void ReturnToLogin()
    {
        NavigationManager.NavigateTo(
            AngularLoginPath,
            forceLoad: true,
            replace: true);
    }

    private static Dictionary<string, string>
        ReadFragmentParameters(string currentUrl)
    {
        var parameters =
            new Dictionary<string, string>(
                StringComparer.OrdinalIgnoreCase);

        if (!Uri.TryCreate(
                currentUrl,
                UriKind.Absolute,
                out var uri))
        {
            return parameters;
        }

        var fragment =
            uri.Fragment.TrimStart('#');

        if (string.IsNullOrWhiteSpace(fragment))
        {
            return parameters;
        }

        var items =
            fragment.Split(
                '&',
                StringSplitOptions.RemoveEmptyEntries);

        foreach (var item in items)
        {
            var parts =
                item.Split(
                    '=',
                    2,
                    StringSplitOptions.None);

            if (parts.Length != 2)
            {
                continue;
            }

            var key =
                Uri.UnescapeDataString(parts[0]);

            var value =
                Uri.UnescapeDataString(parts[1]);

            parameters[key] = value;
        }

        return parameters;
    }
}