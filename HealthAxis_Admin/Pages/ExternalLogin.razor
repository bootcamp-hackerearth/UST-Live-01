@page "/external-login"
@layout EmptyLayout

@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Signing In | HealthAxis Admin</PageTitle>

<section class="external-login-page">
    <div class="external-login-card">
        @if (string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="external-login-loader"></div>

            <h1>Signing you in</h1>

            <p>
                Please wait while we open the HealthAxis Admin dashboard.
            </p>
        }
        else
        {
            <h1>Login failed</h1>

            <p class="external-login-error">
                @errorMessage
            </p>

            <button type="button"
                    class="primary-btn"
                    @onclick="GoToLogin">
                Back to Login
            </button>
        }
    </div>
</section>

@code {
    private const string DashboardRoute = "/dashboard";
    private const string LoginRoute = "/login";

    private bool hasProcessedLogin;
    private string errorMessage = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasProcessedLogin)
        {
            return;
        }

        hasProcessedLogin = true;

        var tokenData = ReadTokenDataFromUrl();

        if (string.IsNullOrWhiteSpace(tokenData.AccessToken))
        {
            errorMessage = "Login token was not found.";
            StateHasChanged();
            return;
        }

        var result = await AuthService.CompleteExternalLoginAsync(
            tokenData.AccessToken,
            tokenData.RefreshToken);

        if (!result.Success)
        {
            errorMessage = result.Message;
            StateHasChanged();
            return;
        }

        NavigationManager.NavigateTo(
            DashboardRoute,
            replace: true);
    }

    private ExternalLoginTokenData ReadTokenDataFromUrl()
    {
        var currentUri = new Uri(NavigationManager.Uri);
        var fragment = currentUri.Fragment;

        if (string.IsNullOrWhiteSpace(fragment))
        {
            return new ExternalLoginTokenData();
        }

        var values = ParseFragment(fragment);

        return new ExternalLoginTokenData
        {
            AccessToken = GetValue(values, "accessToken"),
            RefreshToken = GetValue(values, "refreshToken")
        };
    }

    private static Dictionary<string, string> ParseFragment(
        string fragment)
    {
        var cleanFragment = fragment.TrimStart('#');

        return cleanFragment
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2)
            .ToDictionary(
                parts => DecodeUrlValue(parts[0]),
                parts => DecodeUrlValue(parts[1]),
                StringComparer.OrdinalIgnoreCase);
    }

    private static string? GetValue(
        Dictionary<string, string> values,
        string key)
    {
        return values.TryGetValue(key, out var value)
            ? value
            : null;
    }

    private static string DecodeUrlValue(
        string value)
    {
        return Uri.UnescapeDataString(
            value.Replace("+", " ", StringComparison.Ordinal));
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo(
            LoginRoute,
            forceLoad: true);
    }

    private sealed class ExternalLoginTokenData
    {
        public string? AccessToken { get; set; }

        public string? RefreshToken { get; set; }
    }
}