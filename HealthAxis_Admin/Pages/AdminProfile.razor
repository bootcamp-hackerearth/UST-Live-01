@page "/admin-profile"
@attribute [Authorize(Roles = "Admin")]

@using System.Net.Http
@using System.Text.Json
@using HealthAxis.Shared.DTO.AdminDtos

@inject AdminProfileService ProfileService
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<section class="admin-profile-page">
    <section class="page-header">
        <div>
            <p>Administrator Account</p>

            <h1>Admin Profile</h1>

            <span>
                Review your administrator account information
                and current workspace access.
            </span>
        </div>

        <button type="button"
                class="refresh-button"
                disabled="@isLoading"
                @onclick="LoadProfileAsync">
            @(isLoading ? "Refreshing..." : "Refresh Profile")
        </button>
    </section>

    @if (isLoading)
    {
        <div class="info-box" role="status">
            Loading administrator profile...
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="error-box" role="alert">
            @errorMessage
        </div>
    }

    @if (!isLoading)
    {
        <section class="profile-card">
            <div class="profile-top">
                <div class="admin-avatar"
                     aria-hidden="true">
                    @GetInitial(profile.Email)
                </div>

                <div>
                    <p>Administrator</p>

                    <h2>Admin Profile</h2>

                    <span>
                        HealthAxis system administrator account
                    </span>
                </div>
            </div>

            <div class="profile-details-grid">
                <div class="detail-box">
                    <span>Email Address</span>

                    <strong>
                        @GetSafeText(
                            profile.Email,
                            "Not available")
                    </strong>

                    <small>
                        Used for administrator authentication.
                    </small>
                </div>

                <div class="detail-box">
                    <span>Phone Number</span>

                    <strong>
                        @GetSafeText(
                            profile.PhoneNumber,
                            "Not available")
                    </strong>

                    <small>
                        Registered administrator contact number.
                    </small>
                </div>

                <div class="detail-box">
                    <span>Account Role</span>

                    <strong>
                        Administrator
                    </strong>

                    <small>
                        Full administrative workspace access.
                    </small>
                </div>

                <div class="detail-box">
                    <span>Account Status</span>

                    <strong class="active-text">
                        Active
                    </strong>

                    <small>
                        Workspace access is enabled.
                    </small>
                </div>
            </div>

            <div class="profile-note">
                Profile information is managed through the
                HealthAxis identity and administration system.
            </div>
        </section>
    }
</section>

<style>
    .admin-profile-page {
        display: grid;
        gap: 22px;
    }

    .page-header {
        padding: 30px;
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 30px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        color: #ffffff;
        background: radial-gradient( circle at top right, rgba(124, 58, 237, 0.28), transparent 30% ), linear-gradient( 135deg, #020617, #075985 );
        box-shadow: 0 20px 50px rgba(7, 89, 133, 0.2);
    }

        .page-header p {
            margin: 0;
            color: #7dd3fc;
            font-size: 13px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .page-header h1 {
            margin: 8px 0 6px;
            font-size: 40px;
        }

        .page-header span {
            color: #dbeafe;
            line-height: 1.6;
            font-weight: 700;
        }

    .refresh-button {
        min-width: 150px;
        min-height: 46px;
        padding: 0 20px;
        border: none;
        border-radius: 999px;
        color: #0f172a;
        background: #ffffff;
        font-weight: 900;
        white-space: nowrap;
        cursor: pointer;
    }

        .refresh-button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .error-box,
    .info-box {
        padding: 14px 16px;
        border-radius: 16px;
        font-weight: 900;
    }

    .error-box {
        border: 1px solid rgba(248, 113, 113, 0.35);
        color: #fecaca;
        background: rgba(239, 68, 68, 0.18);
    }

    .info-box {
        border: 1px solid rgba(56, 189, 248, 0.35);
        color: #bae6fd;
        background: rgba(14, 165, 233, 0.18);
    }

    .profile-card {
        padding: 28px;
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 30px;
        background: radial-gradient( circle at top right, rgba(56, 189, 248, 0.12), transparent 35% ), rgba(15, 23, 42, 0.72);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
    }

    .profile-top {
        margin-bottom: 26px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .admin-avatar {
        width: 76px;
        height: 76px;
        min-width: 76px;
        border-radius: 24px;
        display: grid;
        place-items: center;
        color: #ffffff;
        background: linear-gradient( 135deg, #0ea5e9, #7c3aed );
        font-size: 34px;
        font-weight: 900;
        box-shadow: 0 14px 30px rgba(14, 165, 233, 0.25);
    }

    .profile-top p {
        margin: 0;
        color: #7dd3fc;
        font-size: 13px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .profile-top h2 {
        margin: 6px 0;
        color: #ffffff;
        font-size: 30px;
        overflow-wrap: anywhere;
    }

    .profile-top span {
        color: #cbd5e1;
        font-weight: 700;
    }

    .profile-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .detail-box {
        min-width: 0;
        padding: 18px;
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 20px;
        background: rgba(30, 41, 59, 0.82);
    }

        .detail-box span {
            display: block;
            margin-bottom: 8px;
            color: #94a3b8;
            font-size: 13px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .detail-box strong {
            display: block;
            color: #ffffff;
            font-size: 18px;
            overflow-wrap: anywhere;
        }

        .detail-box small {
            display: block;
            margin-top: 8px;
            color: #cbd5e1;
            font-weight: 700;
            line-height: 1.5;
        }

    .active-text {
        color: #86efac !important;
    }

    .profile-note {
        margin-top: 20px;
        padding: 16px;
        border: 1px solid rgba(56, 189, 248, 0.24);
        border-radius: 18px;
        color: #dbeafe;
        background: rgba(14, 165, 233, 0.12);
        line-height: 1.6;
        font-weight: 800;
    }

    @@media (max-width: 900px) {
        .page-header,
        .profile-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-details-grid {
            grid-template-columns: 1fr;
        }

        .refresh-button {
            width: 100%;
        }
    }
</style>

@code {
    private AdminProfileDto profile = new();

    private bool isLoading;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (!AuthService.IsLoggedIn)
        {
            NavigationManager.NavigateTo(
                "/angular/login?adminLogout=true",
                forceLoad: true,
                replace: true);

            return;
        }

        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            profile =
                await ProfileService
                    .GetProfileAsync();
        }
        catch (HttpRequestException)
        {
            ResetProfile(
                "Could not load admin profile.");
        }
        catch (JsonException)
        {
            ResetProfile(
                "Admin profile data format is invalid.");
        }
        catch (InvalidOperationException)
        {
            ResetProfile(
                "Admin profile service is not available.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetProfile(
        string error)
    {
        profile = new AdminProfileDto();
        errorMessage = error;
    }

    private static string GetInitial(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "A";
        }

        return value
            .Trim()[..1]
            .ToUpperInvariant();
    }

    private static string GetSafeText(
        string? value,
        string fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value.Trim();
    }
}