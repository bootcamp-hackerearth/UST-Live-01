@page "/reports"
@attribute [Authorize(Roles = "Admin")]

@using HealthAxis.Shared.DTO.AdminDtos

@inject AuthService AuthService
@inject AppointmentReportAdminService ReportService
@inject NavigationManager NavigationManager

<h1>Appointment Reports</h1>

<p class="page-subtitle">
    View patient appointments, assigned doctors, appointment date, time and current status.
</p>

<section class="doctor-list-card">

    <div class="doctor-list-header">
        <div>
            <h3>Appointment Report Table</h3>
            <p>All appointments with patient and doctor information.</p>
        </div>

        <button type="button"
                class="small-refresh-btn"
                disabled="@isLoading"
                @onclick="LoadReportsAsync">
            @(isLoading ? "Loading..." : "Refresh")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass">
            @message
        </div>
    }

    <div class="user-toolbar report-toolbar">
        <div class="doctor-search-box">
            <input type="text"
                   maxlength="80"
                   placeholder="Search patient, doctor, status..."
                   @bind="searchText"
                   @bind:event="oninput" />
        </div>

        <div class="doctor-filter-box">
            <select class="form-control" @bind="selectedStatus">
                <option value="@AllStatusOption">All Status</option>
                <option value="@PendingStatus">Pending</option>
                <option value="@ConfirmedStatus">Confirmed</option>
                <option value="@CompletedStatus">Completed</option>
                <option value="@CancelledStatus">Cancelled</option>
            </select>
        </div>

        <button type="button"
                class="small-clear-btn"
                @onclick="ClearFilters">
            Clear
        </button>
    </div>

    @if (isLoading)
    {
        <div class="empty-box">
            Loading appointment reports...
        </div>
    }
    else if (FilteredReports.Count == 0)
    {
        <div class="empty-box">
            No appointment reports found.
        </div>
    }
    else
    {
        <div class="table-wrapper report-table-wrapper">
            <table class="modern-table report-table">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Specialisation</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th class="action-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var report in PagedReports)
                    {
                        <tr>
                            <td>
                                <div class="doctor-profile-cell">
                                    <div class="doctor-avatar user-avatar-patient">
                                        @GetInitial(report.PatientName)
                                    </div>

                                    <div>
                                        <h4>@GetSafeText(report.PatientName, "Patient")</h4>
                                        <span>Patient ID: @report.PatientId</span>
                                    </div>
                                </div>
                            </td>

                            <td>@GetSafeText(report.DoctorName, "Doctor")</td>

                            <td>
                                <span class="specialisation-pill">
                                    @GetSafeText(report.Specialisation, "N/A")
                                </span>
                            </td>

                            <td>@report.ScheduledDate.ToString("dd MMM yyyy")</td>

                            <td>@GetSafeText(report.TimeSlot, "Not assigned")</td>

                            <td>
                                <span class="@GetStatusBadgeClass(report.Status)">
                                    @GetSafeText(report.Status, "Pending")
                                </span>
                            </td>

                            <td class="action-column">
                                <div class="report-actions">

                                    <button type="button"
                                            class="small-view-btn"
                                            @onclick="() => OpenReportDialog(report)">
                                        View
                                    </button>

                                    @if (IsPending(report.Status))
                                    {
                                        <button type="button"
                                                class="small-confirm-btn"
                                                disabled="@IsProcessing(report.AppointmentId)"
                                                @onclick="() => ConfirmAppointmentAsync(report.AppointmentId)">
                                            @(IsProcessing(report.AppointmentId) ? "..." : "Confirm")
                                        </button>
                                    }

                                    @if (CanCancel(report.Status))
                                    {
                                        <button type="button"
                                                class="small-cancel-btn"
                                                disabled="@IsProcessing(report.AppointmentId)"
                                                @onclick="() => CancelAppointmentAsync(report.AppointmentId)">
                                            @(IsProcessing(report.AppointmentId) ? "..." : "Cancel")
                                        </button>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > MinimumPaginationPages)
        {
            <div class="pagination-bar">
                <button type="button"
                        class="secondary-btn"
                        disabled="@(currentPage == FirstPageNumber)"
                        @onclick="GoToPreviousPage">
                    Previous
                </button>

                <span>
                    Page @currentPage of @TotalPages
                    • Total @FilteredReports.Count reports
                </span>

                <button type="button"
                        class="secondary-btn"
                        disabled="@(currentPage == TotalPages)"
                        @onclick="GoToNextPage">
                    Next
                </button>
            </div>
        }
    }

</section>

@if (showReportDialog && selectedReport is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog user-detail-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Appointment Report</h3>
                    <p>Detailed appointment date and time report.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseReportDialog">
                    ×
                </button>
            </div>

            <div class="user-detail-card">
                <div class="user-detail-grid">

                    <div>
                        <span>Appointment ID</span>
                        <strong>@selectedReport.AppointmentId</strong>
                    </div>

                    <div>
                        <span>Status</span>
                        <strong>@selectedReport.Status</strong>
                    </div>

                    <div>
                        <span>Patient Name</span>
                        <strong>@selectedReport.PatientName</strong>
                    </div>

                    <div>
                        <span>Patient ID</span>
                        <strong>@selectedReport.PatientId</strong>
                    </div>

                    <div>
                        <span>Doctor Name</span>
                        <strong>@selectedReport.DoctorName</strong>
                    </div>

                    <div>
                        <span>Doctor ID</span>
                        <strong>@selectedReport.DoctorId</strong>
                    </div>

                    <div>
                        <span>Specialisation</span>
                        <strong>@selectedReport.Specialisation</strong>
                    </div>

                    <div>
                        <span>Date</span>
                        <strong>@selectedReport.ScheduledDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div>
                        <span>Time</span>
                        <strong>@selectedReport.TimeSlot</strong>
                    </div>

                </div>
            </div>

            <div class="dialog-actions">
                <button type="button"
                        class="secondary-btn"
                        @onclick="CloseReportDialog">
                    Close
                </button>
            </div>

        </div>
    </div>
}

@if (showResultDialog)
{
    <div class="modal-backdrop-custom">
        <div class="result-dialog">

            <div class="result-label @(isResultSuccess ? "success-label" : "error-label")">
                @(isResultSuccess ? "SUCCESS" : "ERROR")
            </div>

            <h3>@resultTitle</h3>

            <p>@resultMessage</p>

            <button type="button"
                    class="result-ok-btn"
                    @onclick="CloseResultDialog">
                OK
            </button>

        </div>
    </div>
}

<style>
    .report-toolbar {
        display: grid;
        grid-template-columns: minmax(300px, 1fr) 220px 90px;
        gap: 16px;
        align-items: center;
    }

    .report-table-wrapper {
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        table-layout: fixed;
    }

        .report-table th:nth-child(1),
        .report-table td:nth-child(1) {
            width: 22%;
        }

        .report-table th:nth-child(2),
        .report-table td:nth-child(2) {
            width: 16%;
        }

        .report-table th:nth-child(3),
        .report-table td:nth-child(3) {
            width: 15%;
        }

        .report-table th:nth-child(4),
        .report-table td:nth-child(4) {
            width: 12%;
        }

        .report-table th:nth-child(5),
        .report-table td:nth-child(5) {
            width: 14%;
        }

        .report-table th:nth-child(6),
        .report-table td:nth-child(6) {
            width: 10%;
        }

        .report-table th:nth-child(7),
        .report-table td:nth-child(7) {
            width: 11%;
        }

        .report-table td {
            vertical-align: middle;
        }

    .report-actions {
        display: grid;
        gap: 6px;
        justify-items: stretch;
        max-width: 96px;
        margin-left: auto;
    }

    .small-view-btn,
    .small-confirm-btn,
    .small-cancel-btn,
    .small-refresh-btn,
    .small-clear-btn {
        border: none;
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
        white-space: nowrap;
    }

    .small-view-btn {
        background: rgba(14, 165, 233, 0.18);
        color: #7dd3fc;
        border: 1px solid rgba(56, 189, 248, 0.35);
    }

    .small-confirm-btn {
        background: rgba(34, 197, 94, 0.18);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.35);
    }

    .small-cancel-btn {
        background: rgba(239, 68, 68, 0.18);
        color: #fecaca;
        border: 1px solid rgba(248, 113, 113, 0.35);
    }

    .small-refresh-btn {
        background: linear-gradient(135deg, #0ea5e9, #7c3aed);
        color: #ffffff;
    }

    .small-clear-btn {
        width: 90px !important;
        height: 46px;
        padding: 0 14px !important;
        background: rgba(148, 163, 184, 0.18);
        color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, 0.3);
        justify-self: start;
    }

    .action-column {
        text-align: right;
    }

    .empty-box {
        padding: 22px;
        border-radius: 18px;
        background: rgba(148, 163, 184, 0.12);
        color: #cbd5e1;
        font-weight: 800;
    }

    .result-dialog {
        width: min(420px, 92vw);
        background: #0f172a;
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 28px;
        padding: 28px;
        text-align: center;
        color: #ffffff;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45);
    }

    .result-label {
        width: fit-content;
        margin: 0 auto 16px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 0.06em;
    }

    .success-label {
        background: rgba(34, 197, 94, 0.18);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.35);
    }

    .error-label {
        background: rgba(239, 68, 68, 0.18);
        color: #fecaca;
        border: 1px solid rgba(239, 68, 68, 0.35);
    }

    .result-dialog h3 {
        margin: 0 0 10px;
        font-size: 26px;
    }

    .result-dialog p {
        margin: 0;
        color: #cbd5e1;
        line-height: 1.6;
        font-weight: 700;
    }

    .result-ok-btn {
        margin-top: 22px;
        border: none;
        border-radius: 16px;
        padding: 12px 28px;
        background: linear-gradient(135deg, #0ea5e9, #7c3aed);
        color: #ffffff;
        font-weight: 900;
        cursor: pointer;
    }

    @@media (max-width: 1100px) {
        .report-table {
            min-width: 980px;
        }
    }

    @@media (max-width: 900px) {
        .report-toolbar {
            grid-template-columns: 1fr;
        }

        .small-clear-btn {
            width: 100% !important;
        }

        .report-actions {
            max-width: none;
            margin-left: 0;
        }

        .small-view-btn,
        .small-confirm-btn,
        .small-cancel-btn,
        .small-refresh-btn {
            width: 100%;
        }

        .action-column {
            text-align: left;
        }
    }
</style>

@code {
    private const int FirstPageNumber = 1;
    private const int MinimumPaginationPages = 1;
    private const int PageSize = 6;
    private const int MessageAutoHideMilliseconds = 3000;

    private const string AllStatusOption = "All";
    private const string PendingStatus = "Pending";
    private const string ConfirmedStatus = "Confirmed";
    private const string CompletedStatus = "Completed";
    private const string CancelledStatus = "Cancelled";

    private List<AdminAppointmentDetailDto> reports = new();

    private AdminAppointmentDetailDto? selectedReport;

    private string searchText = string.Empty;
    private string selectedStatus = AllStatusOption;
    private string message = string.Empty;
    private string messageClass = "success-box";

    private string resultTitle = string.Empty;
    private string resultMessage = string.Empty;

    private bool isLoading;
    private bool showReportDialog;
    private bool showResultDialog;
    private bool isResultSuccess;

    private int currentPage = FirstPageNumber;
    private int messageVersion;
    private int processingAppointmentId;

    private List<AdminAppointmentDetailDto> FilteredReports
    {
        get
        {
            var filteredReports = reports.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                filteredReports = filteredReports.Where(report =>
                    ContainsIgnoreCase(report.PatientName, searchText) ||
                    ContainsIgnoreCase(report.DoctorName, searchText) ||
                    ContainsIgnoreCase(report.Status, searchText) ||
                    ContainsIgnoreCase(report.Specialisation, searchText) ||
                    report.AppointmentId.ToString().Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (!string.Equals(
                    selectedStatus,
                    AllStatusOption,
                    StringComparison.OrdinalIgnoreCase))
            {
                filteredReports = filteredReports.Where(report =>
                    string.Equals(
                        report.Status,
                        selectedStatus,
                        StringComparison.OrdinalIgnoreCase));
            }

            return filteredReports.ToList();
        }
    }

    private List<AdminAppointmentDetailDto> PagedReports =>
        FilteredReports
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        FilteredReports.Count == 0
            ? FirstPageNumber
            : (int)Math.Ceiling((double)FilteredReports.Count / PageSize);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadReportsAsync();
    }

    private async Task LoadReportsAsync()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            reports = await ReportService.GetAppointmentDetailsAsync();
            currentPage = FirstPageNumber;
        }
        catch (TaskCanceledException)
        {
            reports = new List<AdminAppointmentDetailDto>();
            ShowInlineMessage(
                "Appointment reports loading timed out. Please check if HealthAxis.API is running.",
                false);
        }
        catch (HttpRequestException)
        {
            reports = new List<AdminAppointmentDetailDto>();
            ShowInlineMessage("Could not load appointment reports.", false);
        }
        catch (InvalidOperationException)
        {
            reports = new List<AdminAppointmentDetailDto>();
            ShowInlineMessage("Appointment report service is not available.", false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmAppointmentAsync(int appointmentId)
    {
        await UpdateAppointmentAsync(
            appointmentId,
            ReportService.ConfirmAppointmentAsync,
            "Appointment Confirmed");
    }

    private async Task CancelAppointmentAsync(int appointmentId)
    {
        await UpdateAppointmentAsync(
            appointmentId,
            ReportService.CancelAppointmentAsync,
            "Appointment Cancelled");
    }

    private async Task UpdateAppointmentAsync(
        int appointmentId,
        Func<int, Task<(bool Success, string Message)>> updateAction,
        string successTitle)
    {
        if (appointmentId <= 0)
        {
            ShowResult("Invalid Appointment", "Invalid appointment selected.", false);
            return;
        }

        processingAppointmentId = appointmentId;

        var result = await updateAction(appointmentId);

        processingAppointmentId = 0;

        ShowResult(
            result.Success ? successTitle : "Action Failed",
            result.Message,
            result.Success);

        if (result.Success)
        {
            await LoadReportsAsync();
        }
    }

    private void OpenReportDialog(AdminAppointmentDetailDto report)
    {
        selectedReport = report;
        showReportDialog = true;
    }

    private void CloseReportDialog()
    {
        selectedReport = null;
        showReportDialog = false;
    }

    private void CloseResultDialog()
    {
        showResultDialog = false;
        resultTitle = string.Empty;
        resultMessage = string.Empty;
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedStatus = AllStatusOption;
        currentPage = FirstPageNumber;
    }

    private void GoToPreviousPage()
    {
        if (currentPage > FirstPageNumber)
        {
            currentPage--;
        }
    }

    private void GoToNextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void ShowInlineMessage(string text, bool isSuccess)
    {
        message = text;
        messageClass = isSuccess ? "success-box" : "error-box";

        messageVersion++;
        _ = ClearMessageAfterDelayAsync(messageVersion);
    }

    private void ShowResult(
        string title,
        string text,
        bool isSuccess)
    {
        resultTitle = title;
        resultMessage = text;
        isResultSuccess = isSuccess;
        showResultDialog = true;
    }

    private async Task ClearMessageAfterDelayAsync(int version)
    {
        await Task.Delay(MessageAutoHideMilliseconds);

        if (version == messageVersion)
        {
            message = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsProcessing(int appointmentId)
    {
        return processingAppointmentId == appointmentId;
    }

    private static bool ContainsIgnoreCase(
        string? value,
        string searchValue)
    {
        return !string.IsNullOrWhiteSpace(value) &&
            value.Contains(searchValue, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetInitial(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "A";
        }

        return name.Trim()[..1].ToUpperInvariant();
    }

    private static string GetSafeText(
        string? value,
        string fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value.Trim();
    }

    private static bool IsPending(string status)
    {
        return string.Equals(
            status,
            PendingStatus,
            StringComparison.OrdinalIgnoreCase);
    }

    private static bool CanCancel(string status)
    {
        return string.Equals(
                status,
                PendingStatus,
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(
                status,
                ConfirmedStatus,
                StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            PendingStatus => "status-badge pending-badge",
            ConfirmedStatus => "status-badge confirmed-badge",
            CompletedStatus => "status-badge active-status",
            CancelledStatus => "status-badge inactive-status",
            _ => "status-badge"
        };
    }
}