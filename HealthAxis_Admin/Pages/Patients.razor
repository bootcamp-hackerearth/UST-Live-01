</style>

@code {
    private const int FirstPageNumber = 1;
    private const int PageSize = 5;
    private const int MessageAutoHideMilliseconds = 3000;
    private const int PrintDelayMilliseconds = 200;

    private const string AllAppointmentStatusOption = "All";
    private const string PendingStatusOption = "Pending";
    private const string ConfirmedStatusOption = "Confirmed";
    private const string CompletedStatusOption = "Completed";
    private const string CancelledStatusOption = "Cancelled";

    private List<AdminPatientDto> patients = new();
    private List<AdminPatientAppointmentDto> patientAppointments = new();

    private AdminPatientDto? selectedPatient;
    private AdminPatientDto? resetPasswordPatient;

    private UpdateAdminPatientDto editForm = new();
    private AdminResetPasswordDto resetPasswordForm = new();

    private string searchText = string.Empty;
    private string message = string.Empty;
    private string messageClass = "success-box";
    private string selectedPatientAppointmentStatus = AllAppointmentStatusOption;
    private string resetPasswordError = string.Empty;

    private bool isLoading;
    private bool isSaving;
    private bool isLoadingAppointments;
    private bool isResettingPassword;
    private bool isExportingPdf;
    private bool showViewDialog;
    private bool showEditDialog;
    private bool showAppointmentsDialog;
    private bool showResetPasswordDialog;

    private int currentPage = FirstPageNumber;
    private int editingPatientId;
    private int messageVersion;

    private List<AdminPatientDto> GetFilteredPatients()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return patients;
        }

        var cleanSearchText =
            searchText.Trim();

        return patients
            .Where(patient =>
                ContainsIgnoreCase(
                    patient.FullName,
                    cleanSearchText) ||
                ContainsIgnoreCase(
                    patient.PhoneNumber,
                    cleanSearchText) ||
                ContainsIgnoreCase(
                    patient.Email,
                    cleanSearchText) ||
                ContainsIgnoreCase(
                    patient.Gender,
                    cleanSearchText) ||
                patient.PatientId
                    .ToString()
                    .Contains(
                        cleanSearchText,
                        StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private IReadOnlyList<AdminPatientAppointmentDto>
        GetFilteredPatientAppointments()
    {
        if (string.Equals(
                selectedPatientAppointmentStatus,
                AllAppointmentStatusOption,
                StringComparison.OrdinalIgnoreCase))
        {
            return patientAppointments;
        }

        return patientAppointments
            .Where(appointment =>
                string.Equals(
                    appointment.Status,
                    selectedPatientAppointmentStatus,
                    StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private static List<AdminPatientDto> GetPagedPatients(
        IReadOnlyList<AdminPatientDto> filteredPatients,
        int pageNumber)
    {
        return filteredPatients
            .Skip(
                (pageNumber - FirstPageNumber) *
                PageSize)
            .Take(PageSize)
            .ToList();
    }

    private static int GetTotalPages(
        int filteredPatientCount)
    {
        if (filteredPatientCount == 0)
        {
            return FirstPageNumber;
        }

        return (int)Math.Ceiling(
            (double)filteredPatientCount /
            PageSize);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPatientsAsync();
    }

    private async Task LoadPatientsAsync(
        bool clearCurrentMessage = true)
    {
        isLoading = true;

        if (clearCurrentMessage)
        {
            message = string.Empty;
        }

        try
        {
            patients = await PatientService.GetPatientsAsync();
            currentPage = FirstPageNumber;
        }
        catch (TaskCanceledException)
        {
            patients = new List<AdminPatientDto>();
            ShowMessage(
                "Patients loading timed out. Please check if HealthAxis.API is running.",
                false);
        }
        catch (HttpRequestException)
        {
            patients = new List<AdminPatientDto>();
            ShowMessage("Could not load patients.", false);
        }
        catch (JsonException)
        {
            patients = new List<AdminPatientDto>();
            ShowMessage("Patient data format is invalid.", false);
        }
        catch (InvalidOperationException)
        {
            patients = new List<AdminPatientDto>();
            ShowMessage("Patient service is not available.", false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrintPatientsAsync()
    {
        if (isExportingPdf)
        {
            return;
        }

        if (patients.Count == 0)
        {
            ShowMessage("No patients available to export.", false);
            return;
        }

        isExportingPdf = true;

        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(PrintDelayMilliseconds);
            await JSRuntime.InvokeVoidAsync("print");
        }
        finally
        {
            isExportingPdf = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        currentPage = FirstPageNumber;
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
        currentPage = FirstPageNumber;
    }

    private void OpenViewDialog(AdminPatientDto patient)
    {
        selectedPatient = patient;
        showViewDialog = true;
        message = string.Empty;
    }

    private async Task OpenAppointmentsDialogAsync(AdminPatientDto patient)
    {
        selectedPatient = patient;
        patientAppointments = new List<AdminPatientAppointmentDto>();
        selectedPatientAppointmentStatus = AllAppointmentStatusOption;

        showViewDialog = false;
        showAppointmentsDialog = true;
        isLoadingAppointments = true;
        message = string.Empty;

        try
        {
            patientAppointments = await PatientService.GetPatientAppointmentsAsync(
                patient.PatientId);
        }
        catch (TaskCanceledException)
        {
            ShowMessage(
                "Appointments loading timed out. Please check if HealthAxis.API is running.",
                false);
        }
        catch (HttpRequestException)
        {
            ShowMessage("Could not load patient appointments.", false);
        }
        catch (JsonException)
        {
            ShowMessage("Appointment data format is invalid.", false);
        }
        catch (InvalidOperationException)
        {
            ShowMessage("Appointment service is not available.", false);
        }
        finally
        {
            isLoadingAppointments = false;
        }
    }

    private void OpenSelectedPatientEditDialog()
    {
        if (selectedPatient is not null)
        {
            OpenEditDialog(selectedPatient);
        }
    }

    private async Task OpenSelectedPatientAppointmentsDialogAsync()
    {
        if (selectedPatient is not null)
        {
            await OpenAppointmentsDialogAsync(selectedPatient);
        }
    }

    private void OpenSelectedPatientResetPasswordDialog()
    {
        if (selectedPatient is not null)
        {
            OpenResetPasswordDialog(selectedPatient);
        }
    }

    private void OpenEditDialog(AdminPatientDto patient)
    {
        selectedPatient = patient;
        editingPatientId = patient.PatientId;

        editForm = new UpdateAdminPatientDto
        {
            FullName = patient.FullName,
            DateOfBirth = patient.DateOfBirth,
            Gender = patient.Gender,
            PhoneNumber = patient.PhoneNumber,
            Email = patient.Email
        };

        showViewDialog = false;
        showEditDialog = true;
        message = string.Empty;
    }

    private async Task SavePatientAsync()
    {
        if (editingPatientId <= 0)
        {
            ShowMessage("Invalid patient selected.", false);
            return;
        }

        isSaving = true;

        var result = await PatientService.UpdatePatientAsync(
            editingPatientId,
            editForm);

        isSaving = false;

        if (result.Success)
        {
            CloseDialogs();
            await LoadPatientsAsync(clearCurrentMessage: false);
        }

        ShowMessage(result.Message, result.Success);
    }

    private void OpenResetPasswordDialog(AdminPatientDto patient)
    {
        resetPasswordPatient = patient;

        resetPasswordForm = new AdminResetPasswordDto
        {
            Email = patient.Email
        };

        resetPasswordError = string.Empty;
        message = string.Empty;

        showViewDialog = false;
        showEditDialog = false;
        showAppointmentsDialog = false;
        showResetPasswordDialog = true;
    }

    private async Task ResetPatientPasswordAsync()
    {
        if (resetPasswordPatient is null)
        {
            resetPasswordError = "Please select a patient.";
            return;
        }

        if (resetPasswordForm.NewPassword != resetPasswordForm.ConfirmPassword)
        {
            resetPasswordError =
                "New password and confirm password do not match.";
            return;
        }

        isResettingPassword = true;
        resetPasswordError = string.Empty;

        resetPasswordForm.Email = resetPasswordPatient.Email;

        var patientName = resetPasswordPatient.FullName;
        var result = await PatientService.ResetPasswordAsync(resetPasswordForm);

        isResettingPassword = false;

        if (!result.Success)
        {
            resetPasswordError = result.Message;
            return;
        }

        CloseDialogs();

        ShowMessage(
            $"Password reset successfully for {patientName}.",
            true);
    }

    private void CloseDialogs()
    {
        if (isSaving || isResettingPassword)
        {
            return;
        }

        selectedPatient = null;
        resetPasswordPatient = null;

        showViewDialog = false;
        showEditDialog = false;
        showAppointmentsDialog = false;
        showResetPasswordDialog = false;

        editingPatientId = 0;

        patientAppointments = new List<AdminPatientAppointmentDto>();
        selectedPatientAppointmentStatus = AllAppointmentStatusOption;

        editForm = new UpdateAdminPatientDto();
        resetPasswordForm = new AdminResetPasswordDto();

        resetPasswordError = string.Empty;
    }

    private void GoToPreviousPage()
    {
        if (currentPage > FirstPageNumber)
        {
            currentPage--;
        }
    }

    private void GoToNextPage()
    {
        var filteredPatientCount =
            GetFilteredPatients().Count;

        var totalPages =
            GetTotalPages(
                filteredPatientCount);

        if (currentPage < totalPages)
        {
            currentPage++;
        }
    }

    private void ShowMessage(string text, bool isSuccess)
    {
        message = text;
        messageClass = isSuccess ? "success-box" : "error-box";

        messageVersion++;
        _ = ClearMessageAfterDelayAsync(messageVersion);
    }

    private async Task ClearMessageAfterDelayAsync(int version)
    {
        await Task.Delay(MessageAutoHideMilliseconds);

        if (version == messageVersion)
        {
            message = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool ContainsIgnoreCase(
        string? value,
        string searchValue)
    {
        return !string.IsNullOrWhiteSpace(value) &&
            value.Contains(searchValue, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not available"
            : value.Trim();
    }

    private static string GetSafeText(
        string? value,
        string fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value.Trim();
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "P";
        }

        return name.Trim()[..1].ToUpperInvariant();
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("dd MMM yyyy")
            : "Not available";
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            PendingStatusOption => "status-badge pending-badge",
            ConfirmedStatusOption => "status-badge confirmed-badge",
            CompletedStatusOption => "status-badge active-status",
            CancelledStatusOption => "status-badge inactive-status",
            _ => "status-badge"
        };
    }
}