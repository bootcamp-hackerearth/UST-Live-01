@page "/patients"
@attribute [Authorize(Roles = "Admin")]

@using System.Net.Http
@using System.Text.Json
@using HealthAxis.Shared.DTO.AdminDtos

@inject PatientAdminService PatientService

<h1>Patient Management</h1>

<p class="page-subtitle">
    View patient records, edit patient details, and check patient appointments.
</p>

<section class="doctor-list-card patient-admin-card">

    <div class="doctor-list-header">
        <div>
            <h3>Patients List</h3>
            <p>All registered patients from database.</p>
        </div>

        <button type="button"
                class="small-refresh-btn"
                disabled="@isLoading"
                @onclick="LoadPatientsAsync">
            @(isLoading ? "Loading..." : "Refresh")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass">
            @message
        </div>
    }

    <div class="patient-toolbar">
        <div class="doctor-search-box">
            <input type="text"
                   placeholder="Search patient name, phone, email, gender..."
                   value="@searchText"
                   @oninput="OnSearchInput" />
        </div>

        <button type="button"
                class="small-clear-btn"
                @onclick="ClearSearch">
            Clear
        </button>
    </div>

    @if (isLoading)
    {
        <div class="empty-box">
            Loading patients from database...
        </div>
    }
    else if (FilteredPatients.Count == 0)
    {
        <div class="empty-box">
            No patients found.
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="modern-table patients-table">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="action-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var patient in PagedPatients)
                    {
                        <tr>
                            <td>
                                <div class="doctor-profile-cell">
                                    <div class="doctor-avatar user-avatar-patient">
                                        @GetInitial(patient.FullName)
                                    </div>

                                    <div>
                                        <h4>@GetSafeText(patient.FullName, "Patient")</h4>
                                        <span>ID: @patient.PatientId</span>
                                    </div>
                                </div>
                            </td>

                            <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>

                            <td>@GetSafeText(patient.Gender, "Not available")</td>

                            <td>@DisplayValue(patient.PhoneNumber)</td>

                            <td>@DisplayValue(patient.Email)</td>

                            <td class="action-column">
                                <div class="patient-actions">
                                    <button type="button"
                                            class="small-view-btn"
                                            @onclick="() => OpenAppointmentsDialogAsync(patient)">
                                        Appointments
                                    </button>

                                    <button type="button"
                                            class="small-edit-btn"
                                            @onclick="() => OpenEditDialog(patient)">
                                        Edit
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (FilteredPatients.Count > PageSize)
        {
            <div class="pagination-bar patient-pagination">

                <button type="button"
                        class="secondary-btn page-btn"
                        disabled="@(currentPage == FirstPageNumber)"
                        @onclick="GoToPreviousPage">
                    Previous
                </button>

                <span class="page-info">
                    Page @currentPage of @TotalPages
                    • Showing @PagedPatients.Count of @FilteredPatients.Count patients
                </span>

                <button type="button"
                        class="secondary-btn page-btn"
                        disabled="@(currentPage == TotalPages)"
                        @onclick="GoToNextPage">
                    Next
                </button>

            </div>
        }
    }

</section>

@if (showEditDialog)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog patient-edit-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Edit Patient</h3>
                    <p>Update patient information.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <EditForm Model="@editForm" OnValidSubmit="SavePatientAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid patient-form-grid">

                    <div class="form-group">
                        <label>Full Name</label>
                        <InputText class="form-control" @bind-Value="editForm.FullName" />
                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>
                        <InputDate class="form-control" @bind-Value="editForm.DateOfBirth" />
                    </div>

                    <div class="form-group">
                        <label>Gender</label>
                        <InputSelect class="form-control" @bind-Value="editForm.Gender">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <InputText class="form-control" @bind-Value="editForm.PhoneNumber" />
                    </div>

                    <div class="form-group full-width">
                        <label>Email</label>
                        <InputText class="form-control" @bind-Value="editForm.Email" />
                    </div>

                </div>

                <div class="dialog-actions">
                    <button type="submit"
                            class="primary-btn"
                            disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save Changes")
                    </button>

                    <button type="button"
                            class="secondary-btn"
                            disabled="@isSaving"
                            @onclick="CloseDialogs">
                        Cancel
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
}

@if (showAppointmentsDialog && selectedPatient is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog user-detail-dialog patient-appointments-dialog">

            <div class="dialog-header">
                <div>
                    <h3>@selectedPatient.FullName - Appointments</h3>
                    <p>Appointments booked by this patient.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            @if (isLoadingAppointments)
            {
                <div class="empty-box">
                    Loading appointments...
                </div>
            }
            else if (patientAppointments.Count == 0)
            {
                <div class="empty-box">
                    No appointments found for this patient.
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Doctor</th>
                                <th>Specialisation</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var appointment in patientAppointments)
                            {
                                <tr>
                                    <td>@GetSafeText(appointment.DoctorName, "Doctor")</td>
                                    <td>@GetSafeText(appointment.Specialisation, "N/A")</td>
                                    <td>@appointment.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>@GetSafeText(appointment.TimeSlot, "Not assigned")</td>
                                    <td>
                                        <span class="@GetStatusBadgeClass(appointment.Status)">
                                            @appointment.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="dialog-actions">
                <button type="button"
                        class="secondary-btn"
                        @onclick="CloseDialogs">
                    Close
                </button>
            </div>

        </div>
    </div>
}

<style>
    .patient-admin-card {
        max-width: 100%;
    }

    .patient-toolbar {
        display: grid;
        grid-template-columns: minmax(300px, 1fr) 90px;
        gap: 14px;
        align-items: center;
        margin: 20px 0;
    }

    .small-refresh-btn,
    .small-clear-btn,
    .small-view-btn,
    .small-edit-btn {
        border: none;
        border-radius: 999px;
        padding: 8px 13px;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        white-space: nowrap;
    }

    .small-refresh-btn {
        background: linear-gradient(135deg, #0ea5e9, #7c3aed);
        color: #ffffff;
    }

    .small-clear-btn {
        height: 46px;
        width: 90px;
        background: rgba(148, 163, 184, 0.18);
        color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .small-view-btn {
        background: rgba(14, 165, 233, 0.18);
        color: #7dd3fc;
        border: 1px solid rgba(56, 189, 248, 0.35);
    }

    .small-edit-btn {
        background: rgba(34, 197, 94, 0.18);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.35);
    }

        .small-refresh-btn:disabled,
        .small-view-btn:disabled,
        .small-edit-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .patient-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-column {
        text-align: right;
    }

    .patients-table th,
    .patients-table td {
        vertical-align: middle;
    }

    .empty-box {
        padding: 22px;
        border-radius: 18px;
        background: rgba(148, 163, 184, 0.12);
        color: #cbd5e1;
        font-weight: 800;
    }

    .patient-edit-dialog {
        width: min(860px, 94vw);
    }

    .patient-appointments-dialog {
        width: min(920px, 94vw);
    }

    .patient-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .pagination-bar {
        margin-top: 20px;
    }

    @@media (max-width: 900px) {
        .patient-toolbar,
        .patient-form-grid {
            grid-template-columns: 1fr;
        }

        .small-clear-btn,
        .small-refresh-btn,
        .small-view-btn,
        .small-edit-btn {
            width: 100%;
        }

        .patient-actions {
            justify-content: flex-start;
            flex-direction: column;
            align-items: stretch;
        }

        .action-column {
            text-align: left;
        }
    }

    .patient-pagination {
        display: flex !important;
        justify-content: center;
        align-items: center;
        gap: 14px;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid rgba(148, 163, 184, 0.18);
    }

    .page-btn {
        min-width: 110px !important;
        height: 42px !important;
        padding: 8px 16px !important;
        border-radius: 14px !important;
        font-size: 13px !important;
    }

    .page-info {
        color: #cbd5e1;
        font-weight: 900;
        font-size: 14px;
    }

    @@media (max-width: 700px) {
        .patient-pagination {
            flex-direction: column;
        }

        .page-btn {
            width: 100% !important;
        }
    }
</style>

@code {
    private const int FirstPageNumber = 1;
    private const int MinimumPaginationPages = 1;
    private const int PageSize = 5;
    private const int MessageAutoHideMilliseconds = 3000;

    private List<AdminPatientDto> patients = new();
    private List<AdminPatientAppointmentDto> patientAppointments = new();

    private AdminPatientDto? selectedPatient;
    private UpdateAdminPatientDto editForm = new();

    private string searchText = string.Empty;
    private string message = string.Empty;
    private string messageClass = "success-box";

    private bool isLoading;
    private bool isSaving;
    private bool isLoadingAppointments;
    private bool showEditDialog;
    private bool showAppointmentsDialog;

    private int currentPage = FirstPageNumber;
    private int editingPatientId;
    private int messageVersion;

    private List<AdminPatientDto> FilteredPatients
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return patients;
            }

            return patients
                .Where(patient =>
                    ContainsIgnoreCase(patient.FullName, searchText) ||
                    ContainsIgnoreCase(patient.PhoneNumber, searchText) ||
                    ContainsIgnoreCase(patient.Email, searchText) ||
                    ContainsIgnoreCase(patient.Gender, searchText) ||
                    patient.PatientId.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private List<AdminPatientDto> PagedPatients =>
        FilteredPatients
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        FilteredPatients.Count == 0
            ? FirstPageNumber
            : (int)Math.Ceiling((double)FilteredPatients.Count / PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadPatientsAsync();
    }

    private async Task LoadPatientsAsync()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            patients = await PatientService.GetPatientsAsync();
            currentPage = FirstPageNumber;
        }
        catch (HttpRequestException)
        {
            patients = new List<AdminPatientDto>();
            ShowMessage("Could not load patients.", false);
        }
        catch (JsonException)
        {
            patients = new List<AdminPatientDto>();
            ShowMessage("Patient data format is invalid.", false);
        }
        catch (InvalidOperationException)
        {
            patients = new List<AdminPatientDto>();
            ShowMessage("Patient service is not available.", false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        currentPage = FirstPageNumber;
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
        currentPage = FirstPageNumber;
    }

    private void OpenEditDialog(AdminPatientDto patient)
    {
        selectedPatient = patient;
        editingPatientId = patient.PatientId;

        editForm = new UpdateAdminPatientDto
        {
            FullName = patient.FullName,
            DateOfBirth = patient.DateOfBirth,
            Gender = patient.Gender,
            PhoneNumber = patient.PhoneNumber,
            Email = patient.Email
        };

        showEditDialog = true;
    }

    private async Task SavePatientAsync()
    {
        if (editingPatientId <= 0)
        {
            ShowMessage("Invalid patient selected.", false);
            return;
        }

        isSaving = true;

        var result = await PatientService.UpdatePatientAsync(
            editingPatientId,
            editForm);

        isSaving = false;

        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            CloseDialogs();
            await LoadPatientsAsync();
        }
    }

    private async Task OpenAppointmentsDialogAsync(AdminPatientDto patient)
    {
        selectedPatient = patient;
        patientAppointments = new List<AdminPatientAppointmentDto>();
        showAppointmentsDialog = true;
        isLoadingAppointments = true;

        try
        {
            patientAppointments = await PatientService.GetPatientAppointmentsAsync(
                patient.PatientId);
        }
        catch (HttpRequestException)
        {
            ShowMessage("Could not load patient appointments.", false);
        }
        catch (JsonException)
        {
            ShowMessage("Appointment data format is invalid.", false);
        }
        catch (InvalidOperationException)
        {
            ShowMessage("Appointment service is not available.", false);
        }
        finally
        {
            isLoadingAppointments = false;
        }
    }

    private void CloseDialogs()
    {
        if (isSaving)
        {
            return;
        }

        selectedPatient = null;
        showEditDialog = false;
        showAppointmentsDialog = false;
        editingPatientId = 0;
        patientAppointments = new List<AdminPatientAppointmentDto>();
        editForm = new UpdateAdminPatientDto();
    }

    private void GoToPreviousPage()
    {
        if (currentPage > FirstPageNumber)
        {
            currentPage--;
        }
    }

    private void GoToNextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void ShowMessage(string text, bool isSuccess)
    {
        message = text;
        messageClass = isSuccess ? "success-box" : "error-box";

        messageVersion++;
        _ = ClearMessageAfterDelayAsync(messageVersion);
    }

    private async Task ClearMessageAfterDelayAsync(int version)
    {
        await Task.Delay(MessageAutoHideMilliseconds);

        if (version == messageVersion)
        {
            message = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool ContainsIgnoreCase(string? value, string searchValue)
    {
        return !string.IsNullOrWhiteSpace(value) &&
            value.Contains(searchValue, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not available"
            : value.Trim();
    }

    private static string GetSafeText(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value.Trim();
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "P";
        }

        return name.Trim()[..1].ToUpperInvariant();
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "status-badge pending-badge",
            "Confirmed" => "status-badge confirmed-badge",
            "Completed" => "status-badge active-status",
            "Cancelled" => "status-badge inactive-status",
            _ => "status-badge"
        };
    }
}