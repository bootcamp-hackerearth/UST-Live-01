@page "/patients"
@attribute [Authorize(Roles = "Admin")]

@using System.Net.Http
@using System.Text.Json
@using HealthAxis.Shared.DTO.AdminDtos
@using HealthAxis.Shared.DTO.AuthDtos
@using Microsoft.JSInterop

@inject PatientAdminService PatientService
@inject IJSRuntime JSRuntime

<h1>Patient Management</h1>

<p class="page-subtitle">
    View patient records, manage patient details, check appointments, and reset patient passwords.
</p>

<section class="doctor-list-card patient-admin-card">

    <div class="doctor-list-header">
        <div>
            <h3>Patients List</h3>
            <p>All registered patients from database.</p>
        </div>

        <div class="patient-header-actions">
            <button type="button"
                    class="export-pdf-btn"
                    disabled="@(isLoading || isExportingPdf)"
                    @onclick="PrintPatientsAsync">
                @(isExportingPdf ? "Preparing PDF..." : "Export PDF")
            </button>

            <button type="button"
                    class="small-refresh-btn"
                    disabled="@isLoading"
                    @onclick="() => LoadPatientsAsync()">
                @(isLoading ? "Loading..." : "Refresh")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass">
            @message
        </div>
    }

    <div class="patient-toolbar">
        <div class="doctor-search-box">
            <input type="text"
                   maxlength="80"
                   placeholder="Search patient name, phone, email, gender..."
                   value="@searchText"
                   @oninput="OnSearchInput" />
        </div>

        <button type="button"
                class="small-clear-btn"
                @onclick="ClearSearch">
            Clear
        </button>
    </div>

    @if (isLoading)
    {
        <div class="empty-box">Loading patients from database...</div>
    }
    else
    {
        var filteredPatients = GetFilteredPatients();
        var pagedPatients = GetPagedPatients(
            filteredPatients,
            currentPage);
        var totalPages = GetTotalPages(
            filteredPatients.Count);

        if (filteredPatients.Count == 0)
        {
            <div class="empty-box">No patients found.</div>
        }
        else
        {
        <div class="table-wrapper patients-table-wrapper">
            <table class="modern-table patients-table">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="action-column">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var patient in pagedPatients)
                    {
                        <tr>
                            <td>
                                <div class="doctor-profile-cell">
                                    <div class="doctor-avatar user-avatar-patient">
                                        @GetInitial(patient.FullName)
                                    </div>

                                    <div>
                                        <h4>@GetSafeText(patient.FullName, "Patient")</h4>
                                        <span>ID: @patient.PatientId</span>
                                    </div>
                                </div>
                            </td>

                            <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>

                            <td>@GetSafeText(patient.Gender, "Not available")</td>

                            <td>@DisplayValue(patient.PhoneNumber)</td>

                            <td>@DisplayValue(patient.Email)</td>

                            <td class="action-column">
                                <div class="patient-actions">
                                    <button type="button"
                                            class="table-action-btn view-table-action"
                                            @onclick="() => OpenViewDialog(patient)">
                                        View
                                    </button>

                                    <button type="button"
                                            class="table-action-btn appointments-table-action"
                                            @onclick="() => OpenAppointmentsDialogAsync(patient)">
                                        Appointments
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (filteredPatients.Count > PageSize)
        {
            <div class="pagination-bar patient-pagination">

                <button type="button"
                        class="secondary-btn page-btn"
                        disabled="@(currentPage == FirstPageNumber)"
                        @onclick="GoToPreviousPage">
                    Previous
                </button>

                <span class="page-info">
                    Page @currentPage of @totalPages
                    • Showing @pagedPatients.Count of @filteredPatients.Count patients
                </span>

                <button type="button"
                        class="secondary-btn page-btn"
                        disabled="@(currentPage == totalPages)"
                        @onclick="GoToNextPage">
                    Next
                </button>

            </div>
        }
        }
    }

</section>

<section class="patient-print-area">
    <div class="print-header">
        <h1>HealthAxis Patients Report</h1>
        <p>Generated on @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")</p>
        <p>Total Patients: @patients.Count</p>
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <th>Patient ID</th>
                <th>Full Name</th>
                <th>Date of Birth</th>
                <th>Gender</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Created Date</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var patient in patients
                .OrderBy(patient => patient.PatientId))
            {
                <tr>
                    <td>@patient.PatientId</td>
                    <td>@GetSafeText(patient.FullName, "Patient")</td>
                    <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>
                    <td>@GetSafeText(patient.Gender, "Not available")</td>
                    <td>@DisplayValue(patient.PhoneNumber)</td>
                    <td>@DisplayValue(patient.Email)</td>
                    <td>@FormatDate(patient.CreatedDate)</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@if (showViewDialog && selectedPatient is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog patient-view-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Patient Details</h3>
                    <p>View complete patient information and manage patient account actions.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <div class="patient-detail-card">

                <div class="patient-detail-head">
                    <div class="doctor-avatar user-avatar-patient large-avatar">
                        @GetInitial(selectedPatient.FullName)
                    </div>

                    <div>
                        <h4>@GetSafeText(selectedPatient.FullName, "Patient")</h4>
                        <p>@DisplayValue(selectedPatient.Email)</p>
                    </div>
                </div>

                <div class="patient-detail-grid">

                    <div>
                        <span>Patient ID</span>
                        <strong>#@selectedPatient.PatientId</strong>
                    </div>

                    <div>
                        <span>Full Name</span>
                        <strong>@GetSafeText(selectedPatient.FullName, "Patient")</strong>
                    </div>

                    <div>
                        <span>Date of Birth</span>
                        <strong>@selectedPatient.DateOfBirth.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div>
                        <span>Gender</span>
                        <strong>@GetSafeText(selectedPatient.Gender, "Not available")</strong>
                    </div>

                    <div>
                        <span>Phone Number</span>
                        <strong>@DisplayValue(selectedPatient.PhoneNumber)</strong>
                    </div>

                    <div>
                        <span>Email</span>
                        <strong>@DisplayValue(selectedPatient.Email)</strong>
                    </div>

                    <div>
                        <span>Created Date</span>
                        <strong>@FormatDate(selectedPatient.CreatedDate)</strong>
                    </div>

                </div>

            </div>

            <div class="view-dialog-actions">
                <button type="button"
                        class="view-action-btn edit-view-action"
                        @onclick="OpenSelectedPatientEditDialog">
                    Edit Details
                </button>

                <button type="button"
                        class="view-action-btn appointments-view-action"
                        @onclick="OpenSelectedPatientAppointmentsDialogAsync">
                    Appointments
                </button>

                <button type="button"
                        class="view-action-btn reset-view-action"
                        @onclick="OpenSelectedPatientResetPasswordDialog">
                    Reset Password
                </button>

                <button type="button"
                        class="view-action-btn close-view-action"
                        @onclick="CloseDialogs">
                    Close
                </button>
            </div>

        </div>
    </div>
}

@if (showEditDialog && selectedPatient is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog patient-edit-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Edit Patient</h3>
                    <p>Update patient information.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        disabled="@isSaving"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <EditForm Model="@editForm" OnValidSubmit="SavePatientAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid patient-form-grid">

                    <div class="form-group">
                        <label>Full Name</label>
                        <InputText class="form-control"
                                   @bind-Value="editForm.FullName" />
                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>
                        <InputDate class="form-control"
                                   @bind-Value="editForm.DateOfBirth" />
                    </div>

                    <div class="form-group">
                        <label>Gender</label>
                        <InputSelect class="form-control"
                                     @bind-Value="editForm.Gender">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <InputText class="form-control"
                                   @bind-Value="editForm.PhoneNumber" />
                    </div>

                    <div class="form-group full-width">
                        <label>Email</label>
                        <InputText class="form-control"
                                   @bind-Value="editForm.Email" />
                    </div>

                </div>

                <div class="dialog-actions">
                    <button type="submit"
                            class="primary-btn"
                            disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save Changes")
                    </button>

                    <button type="button"
                            class="secondary-btn"
                            disabled="@isSaving"
                            @onclick="CloseDialogs">
                        Cancel
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
}

@if (showAppointmentsDialog && selectedPatient is not null)
{
    var filteredPatientAppointments =
        GetFilteredPatientAppointments();

    <div class="modal-backdrop-custom">
        <div class="doctor-dialog user-detail-dialog patient-appointments-dialog">

            <div class="dialog-header">
                <div>
                    <h3>@selectedPatient.FullName - Appointments</h3>
                    <p>Appointments booked by this patient.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <div class="appointment-filter-row">
                <label for="patientAppointmentStatus">Status</label>

                <select id="patientAppointmentStatus"
                        class="form-control"
                        @bind="selectedPatientAppointmentStatus">
                    <option value="@AllAppointmentStatusOption">All Status</option>
                    <option value="@PendingStatusOption">Pending</option>
                    <option value="@ConfirmedStatusOption">Confirmed</option>
                    <option value="@CompletedStatusOption">Completed</option>
                    <option value="@CancelledStatusOption">Cancelled</option>
                </select>
            </div>

            @if (isLoadingAppointments)
            {
                <div class="empty-box">Loading appointments...</div>
            }
            else if (filteredPatientAppointments.Count == 0)
            {
                <div class="empty-box">No appointments found for this status.</div>
            }
            else
            {
                <div class="table-wrapper appointments-table-wrapper">
                    <table class="modern-table appointments-table">
                        <thead>
                            <tr>
                                <th>Doctor</th>
                                <th>Specialisation</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var appointment in filteredPatientAppointments)
                            {
                                <tr>
                                    <td>@GetSafeText(appointment.DoctorName, "Doctor")</td>
                                    <td>@GetSafeText(appointment.Specialisation, "N/A")</td>
                                    <td>@appointment.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>@GetSafeText(appointment.TimeSlot, "Not assigned")</td>
                                    <td>
                                        <span class="@GetStatusBadgeClass(appointment.Status)">
                                            @appointment.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="dialog-actions">
                <button type="button"
                        class="secondary-btn"
                        @onclick="CloseDialogs">
                    Close
                </button>
            </div>

        </div>
    </div>
}

@if (showResetPasswordDialog && resetPasswordPatient is not null)
{
    <div class="modal-backdrop-custom">
        <div class="doctor-dialog reset-password-dialog">

            <div class="dialog-header">
                <div>
                    <h3>Reset Patient Password</h3>
                    <p>Set a new password for @resetPasswordPatient.FullName.</p>
                </div>

                <button type="button"
                        class="dialog-close-btn"
                        disabled="@isResettingPassword"
                        @onclick="CloseDialogs">
                    ×
                </button>
            </div>

            <div class="reset-user-summary">
                <div class="doctor-avatar user-avatar-patient">
                    @GetInitial(resetPasswordPatient.FullName)
                </div>

                <div>
                    <h4>@GetSafeText(resetPasswordPatient.FullName, "Patient")</h4>
                    <p>@DisplayValue(resetPasswordPatient.Email)</p>
                    <span>Patient account</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(resetPasswordError))
            {
                <div class="error-box">
                    @resetPasswordError
                </div>
            }

            <EditForm Model="@resetPasswordForm" OnValidSubmit="ResetPatientPasswordAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid reset-password-grid">

                    <div class="form-group full-width">
                        <label>New Password</label>
                        <InputText type="password"
                                   class="form-control reset-password-input"
                                   @bind-Value="resetPasswordForm.NewPassword" />
                        <ValidationMessage For="@(() => resetPasswordForm.NewPassword)" />
                    </div>

                    <div class="form-group full-width">
                        <label>Confirm Password</label>
                        <InputText type="password"
                                   class="form-control reset-password-input"
                                   @bind-Value="resetPasswordForm.ConfirmPassword" />
                        <ValidationMessage For="@(() => resetPasswordForm.ConfirmPassword)" />
                    </div>

                </div>

                <p class="password-help-text">
                    Use a strong password with uppercase, lowercase, number, special character, and at least 8 characters.
                </p>

                <div class="dialog-actions">
                    <button type="submit"
                            class="primary-btn"
                            disabled="@isResettingPassword">
                        @(isResettingPassword ? "Resetting..." : "Reset Password")
                    </button>

                    <button type="button"
                            class="secondary-btn"
                            disabled="@isResettingPassword"
                            @onclick="CloseDialogs">
                        Cancel
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
}

<style>
    .patient-admin-card {
        max-width: 100%;
    }

    .patient-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .patient-toolbar {
        display: grid;
        grid-template-columns: minmax(300px, 1fr) 90px;
        gap: 14px;
        align-items: center;
        margin: 20px 0;
    }

    .patients-table-wrapper,
    .appointments-table-wrapper {
        overflow-x: auto;
    }

    .patients-table {
        width: 100%;
        table-layout: fixed;
    }

        .patients-table th:nth-child(1),
        .patients-table td:nth-child(1) {
            width: 22%;
        }

        .patients-table th:nth-child(2),
        .patients-table td:nth-child(2) {
            width: 14%;
        }

        .patients-table th:nth-child(3),
        .patients-table td:nth-child(3) {
            width: 9%;
        }

        .patients-table th:nth-child(4),
        .patients-table td:nth-child(4) {
            width: 15%;
        }

        .patients-table th:nth-child(5),
        .patients-table td:nth-child(5) {
            width: 25%;
        }

        .patients-table th:nth-child(6),
        .patients-table td:nth-child(6) {
            width: 15%;
        }

        .patients-table th,
        .patients-table td {
            vertical-align: middle;
        }

            .patients-table td:nth-child(4),
            .patients-table td:nth-child(5) {
                overflow-wrap: anywhere;
            }

    .action-column {
        text-align: center !important;
    }

    .patient-actions {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        gap: 6px !important;
        flex-wrap: nowrap !important;
    }

    .table-action-btn {
        border: none;
        border-radius: 999px;
        min-height: 30px;
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 900;
        cursor: pointer;
        white-space: nowrap;
    }

    .view-table-action {
        min-width: 54px;
        background: rgba(14, 165, 233, 0.18);
        color: #7dd3fc;
        border: 1px solid rgba(56, 189, 248, 0.35);
    }

    .appointments-table-action {
        min-width: 92px;
        background: rgba(34, 197, 94, 0.16);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.32);
    }

    .small-refresh-btn,
    .small-clear-btn,
    .export-pdf-btn {
        border: none;
        border-radius: 999px;
        padding: 8px 13px;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        white-space: nowrap;
    }

    .small-refresh-btn {
        background: linear-gradient(135deg, #0ea5e9, #7c3aed);
        color: #ffffff;
    }

    .export-pdf-btn {
        background: rgba(34, 197, 94, 0.18);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.35);
        min-height: 38px;
    }

    .small-clear-btn {
        height: 46px;
        width: 90px;
        background: rgba(148, 163, 184, 0.18);
        color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .small-refresh-btn:disabled,
    .export-pdf-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .empty-box {
        padding: 22px;
        border-radius: 18px;
        background: rgba(148, 163, 184, 0.12);
        color: #cbd5e1;
        font-weight: 800;
    }

    .patient-view-dialog {
        width: min(760px, 94vw);
    }

    .patient-edit-dialog {
        width: min(860px, 94vw);
    }

    .patient-appointments-dialog {
        width: min(920px, 94vw);
    }

    .patient-detail-card {
        padding: 18px;
        border-radius: 22px;
        background: rgba(148, 163, 184, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .patient-detail-head {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 16px;
        margin-bottom: 16px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    }

        .patient-detail-head h4 {
            margin: 0;
            color: #ffffff;
            font-size: 20px;
            font-weight: 900;
        }

        .patient-detail-head p {
            margin: 5px 0 0;
            color: #cbd5e1;
            font-weight: 800;
        }

    .large-avatar {
        width: 58px !important;
        height: 58px !important;
        min-width: 58px !important;
        font-size: 22px !important;
    }

    .patient-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

        .patient-detail-grid div {
            padding: 14px;
            border-radius: 16px;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid rgba(148, 163, 184, 0.16);
        }

        .patient-detail-grid span {
            display: block;
            margin-bottom: 7px;
            color: #93c5fd;
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .patient-detail-grid strong {
            color: #ffffff;
            font-size: 15px;
            font-weight: 900;
            overflow-wrap: anywhere;
        }

    .view-dialog-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
    }

    .view-action-btn {
        border: none;
        border-radius: 999px;
        min-height: 38px;
        padding: 9px 15px;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        white-space: nowrap;
    }

    .edit-view-action,
    .appointments-view-action {
        background: rgba(14, 165, 233, 0.16);
        color: #7dd3fc;
        border: 1px solid rgba(56, 189, 248, 0.32);
    }

    .reset-view-action {
        background: rgba(124, 58, 237, 0.18);
        color: #c4b5fd;
        border: 1px solid rgba(167, 139, 250, 0.35);
    }

    .close-view-action {
        background: rgba(148, 163, 184, 0.18);
        color: #e2e8f0;
        border: 1px solid rgba(148, 163, 184, 0.28);
    }

    .appointment-filter-row {
        display: grid;
        grid-template-columns: 120px minmax(220px, 320px);
        gap: 12px;
        align-items: center;
        margin-bottom: 16px;
    }

        .appointment-filter-row label {
            color: #cbd5e1;
            font-weight: 900;
        }

    .patient-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .reset-password-dialog {
        width: min(620px, 94vw);
    }

    .reset-user-summary {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px;
        border-radius: 18px;
        background: rgba(148, 163, 184, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.18);
        margin-bottom: 18px;
    }

        .reset-user-summary h4 {
            margin: 0;
            color: #ffffff;
            font-size: 18px;
            font-weight: 900;
        }

        .reset-user-summary p {
            margin: 4px 0;
            color: #cbd5e1;
            font-weight: 800;
        }

        .reset-user-summary span {
            color: #93c5fd;
            font-size: 13px;
            font-weight: 900;
        }

    .reset-password-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .password-help-text {
        margin: 12px 0 0;
        color: #cbd5e1;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.5;
    }

    .reset-password-input {
        color: #ffffff;
        background: rgba(15, 23, 42, 0.65);
    }

        .reset-password-input::-ms-reveal,
        .reset-password-input::-ms-clear {
            filter: invert(1) brightness(2);
        }

    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        filter: invert(1) brightness(2);
    }

    .patient-pagination {
        display: flex !important;
        justify-content: center;
        align-items: center;
        gap: 14px;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid rgba(148, 163, 184, 0.18);
    }

    .page-btn {
        min-width: 110px !important;
        height: 42px !important;
        padding: 8px 16px !important;
        border-radius: 14px !important;
        font-size: 13px !important;
    }

    .page-info {
        color: #cbd5e1;
        font-weight: 900;
        font-size: 14px;
    }

    .patient-print-area {
        display: none;
    }

