@model HealthApp.Shared.DTOs.DoctorDto

@{
    ViewBag.Title = "Add Doctor";
}

<div class="container mt-5" style="max-width:600px">

    <h3 class="mb-4">Add Doctor</h3>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Full Name -->
        <div class="mb-3">
            <label class="form-label">Full Name</label>

            @Html.TextBoxFor(
                m => m.FullName,
                new { @class = "form-control" })

            @Html.ValidationMessageFor(
                m => m.FullName,
                "",
                new { @class = "text-danger" })
        </div>

        <!-- Specialisation -->
        <div class="mb-3">
            <label class="form-label">Specialisation</label>

            @Html.DropDownListFor(
                m => m.Specialisation,
                new List<SelectListItem>
                {
                    new SelectListItem { Text = "General Physician", Value = "GeneralPhysician" },
                    new SelectListItem { Text = "Cardiologist", Value = "Cardiologist" },
                    new SelectListItem { Text = "Dermatologist", Value = "Dermatologist" },
                    new SelectListItem { Text = "Neurologist", Value = "Neurologist" },
                    new SelectListItem { Text = "Orthopedic", Value = "Orthopedic" },
                    new SelectListItem { Text = "Pediatrician", Value = "Pediatrician" },
                    new SelectListItem { Text = "Psychiatrist", Value = "Psychiatrist" },
                    new SelectListItem { Text = "ENT", Value = "ENT" },
                    new SelectListItem { Text = "Gynecologist", Value = "Gynecologist" }
                },
                "-- Select Specialisation --",
                new { @class = "form-control" })

            @Html.ValidationMessageFor(
                m => m.Specialisation,
                "",
                new { @class = "text-danger" })
        </div>

        <!-- Experience -->
        <div class="mb-3">
            <label class="form-label">Experience (Years)</label>

            @Html.TextBoxFor(
                m => m.YearsOfExperience,
                new { @class = "form-control", type = "number" })

            @Html.ValidationMessageFor(
                m => m.YearsOfExperience,
                "",
                new { @class = "text-danger" })
        </div>

        <!-- Consultation Fee -->
        <div class="mb-3">
            <label class="form-label">Consultation Fee</label>

            @Html.TextBoxFor(
                m => m.ConsultationFee,
                new { @class = "form-control", type = "number", step = "0.01" })

            @Html.ValidationMessageFor(
                m => m.ConsultationFee,
                "",
                new { @class = "text-danger" })
        </div>

        <!-- Status -->
        <div class="mb-3">
            <label class="form-label">Status</label><br />

            @Html.CheckBoxFor(m => m.IsActive) Active
        </div>

        <!-- Buttons -->
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save</button>

            <a href="@Url.Action("DoctorIndex", "Doctor")"
               class="btn btn-secondary ms-2">
                Back
            </a>
        </div>
    }

</div>