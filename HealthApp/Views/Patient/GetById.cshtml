
@{
    ViewBag.Title = "GetById";
}


@model HealthApp.Shared.DTOs.PatientDto

<div class="container mt-5" style="max-width:500px">

    <div class="card p-3 shadow">

        <h5>Patient Details</h5>

        <p><b>Name:</b> @Model.FullName</p>
        <p><b>DOB:</b> @Model.DateOfBirth.ToString("dd-MM-yyyy")</p>
        <p><b>Gender:</b> @Model.Gender</p>
        <p><b>Phone:</b> @Model.PhoneNumber</p>
        <p><b>Email:</b> @Model.Email</p>
        <p><b>Insurance:</b> @Model.InsuranceId</p>



        <div class="mt-3 d-flex">

            <a href="@Url.Action("Edit", "Patient", new { id = Model.PatientId })"
               class="btn btn-sm btn-warning me-2"
               style="width:auto;">
                Edit
            </a>

            <a href="@Url.Action("PatientIndex", "Patient")"
               class="btn btn-sm btn-secondary"
               style="width:auto;">
                Back
            </a>

        </div>


    </div>

</div>
