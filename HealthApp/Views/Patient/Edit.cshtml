@model HealthApp.Shared.DTOs.PatientDto

@{
    ViewBag.Title = "Edit Patient";
}

<div class="container mt-5" style="max-width:600px">

    <h4>Edit Patient</h4>

    @using (Html.BeginForm("Edit", "Patient", new { id = Model.PatientId }, FormMethod.Post))
    {
        @Html.HiddenFor(m => m.PatientId)

        <div class="mb-2">
            <label>Name</label>
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
        </div>

        <div class="mb-2">
            <label>DOB</label>
            @Html.TextBoxFor(m => m.DateOfBirth,
                "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
        </div>

        <div class="mb-2">
            <label>Gender</label>
            @Html.EnumDropDownListFor(m => m.Gender,
                new { @class = "form-control" })
        </div>

        <div class="mb-2">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
        </div>

        <div class="mb-2">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        </div>

        <div class="mb-2">
            <label>Insurance</label>
            @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control" })
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Update</button>

            <a href="@Url.Action("PatientIndex", "Patient")"
               class="btn btn-secondary btn-sm ms-2">
                Back
            </a>
        </div>
    }

</div>