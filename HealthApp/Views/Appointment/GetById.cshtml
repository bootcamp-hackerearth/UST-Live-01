@model HealthApp.Shared.DTOs.AppointmentDto

@{
    ViewBag.Title = "Appointment Details";
}

<div class="container mt-5" style="max-width:700px">

    <h4 class="mb-4">Appointment Details</h4>

    <div class="card p-4 shadow-sm">

        <p><strong>ID:</strong> @Model.AppointmentId</p>
        <p><strong>Patient:</strong> @Model.PatientName</p>
        <p><strong>Doctor:</strong> @Model.DoctorName</p>
        <p><strong>Date:</strong> @Model.ScheduledDate.ToString("dd-MM-yyyy")</p>
        <p><strong>Time Slot:</strong> @Model.TimeSlot</p>
        <p><strong>Status:</strong> @Model.Status</p>

    </div>

    <div class="mt-3">
        <a href="@Url.Action("AppointmentIndex","Appointment")"
           class="btn btn-secondary">
            Back
        </a>
    </div>

</div>