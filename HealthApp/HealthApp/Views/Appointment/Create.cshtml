@model HealthApp.Shared.DTOs.AppointmentDto

@{
    ViewBag.Title = "Book Appointment";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-3">
    <a href="/Appointment/AppointmentIndex" class="btn btn-outline-secondary">
        ← Back
    </a>
</div>

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow p-4">

            <h2 class="text-center mb-4 text-primary">Book Appointment</h2>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <!-- ✅ PATIENT -->
                <div class="form-group">
                    <label>Patient Id</label>
                    <input type="number" id="patientId" name="PatientId" class="form-control" />

                    <input type="text" id="patientName"
                           class="form-control mt-2"
                           placeholder="Patient Name"
                           readonly />

                    <!-- ✅ ERROR MESSAGE -->
                    <span id="patientError" class="text-danger" style="display:none;"></span>
                </div>

                <!-- ✅ SPECIALIZATION -->
                <div class="form-group mt-3">
                    <label>Specialization</label>
                    <select id="specialization" class="form-control">
                        <option value="">-- Select Specialization --</option>
                        <option>GeneralPhysician</option>
                        <option>Cardiologist</option>
                        <option>Dermatologist</option>
                        <option>Neurologist</option>
                        <option>Orthopedic</option>
                        <option>Pediatrician</option>
                        <option>Psychiatrist</option>
                        <option>ENT</option>
                        <option>Gynecologist</option>
                    </select>
                </div>

                <!-- ✅ DOCTOR -->
                <div class="form-group mt-3">
                    <label>Doctor</label>
                    <select id="doctorId" name="DoctorId" class="form-control">
                        <option value="">-- Select Doctor --</option>
                    </select>
                </div>

                <!-- ✅ DATE -->
                <div class="form-group mt-3">
                    <label>Date</label>
                    <input type="date" id="date" name="ScheduledDate"
                           class="form-control"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <!-- ✅ SLOT -->
                <div class="form-group mt-3">
                    <label>Time Slot</label>
                    <select id="slot" name="TimeSlot" class="form-control">
                        <option value="">-- Select Slot --</option>
                    </select>
                </div>

                <!-- ✅ BUTTON -->
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary w-50">
                        Book Appointment
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts{

    <script>

        // ✅ ✅ ✅ PATIENT NAME + ERROR HANDLING
        $("#patientId").on("input", function () {

            var id = $(this).val();

            if (!id) {
                $("#patientName").val("");
                $("#patientError").hide();
                $("#patientId").removeClass("is-invalid");
                return;
            }

            $.get("/Appointment/GetPatientName?id=" + id)
                .done(function (res) {

                    if (res.FullName) {
                        $("#patientName").val(res.FullName);
                        $("#patientError").hide();
                        $("#patientId").removeClass("is-invalid");
                    }
                    else if (res.error) {
                        $("#patientName").val("");
                        $("#patientError").text(res.error).show();
                        $("#patientId").addClass("is-invalid");
                    }

                })
                .fail(function () {
                    $("#patientName").val("");
                    $("#patientError").text("Patient not found").show();
                    $("#patientId").addClass("is-invalid");
                });

        });


        // ✅ ✅ ✅ DOCTORS
        $("#specialization").on("change", function () {

            var spec = $(this).val();

            if (!spec) return;

            $("#doctorId").html('<option>Loading...</option>');

            $.get("/Appointment/GetDoctors?specialization=" + spec, function (res) {

                $("#doctorId").empty()
                    .append('<option value="">-- Select Doctor --</option>');

                $.each(res, function (i, item) {

                    $("#doctorId").append(
                        '<option value="' + item.DoctorId + '">' + item.FullName + '</option>'
                    );

                });

            });

        });


        // ✅ ✅ ✅ SLOTS
        $("#doctorId, #date").on("change", function () {

            var doctorId = $("#doctorId").val();
            var date = $("#date").val();

            if (!doctorId || !date) return;

            $("#slot").html('<option>Loading...</option>');

            $.get("/Appointment/GetSlots?doctorId=" + doctorId + "&date=" + date, function (res) {

                $("#slot").empty()
                    .append('<option value="">-- Select Slot --</option>');

                $.each(res, function (i, item) {

                    $("#slot").append(
                        '<option value="' + item + '">' + item + '</option>'
                    );

                });

            });

        });

    </script>

}