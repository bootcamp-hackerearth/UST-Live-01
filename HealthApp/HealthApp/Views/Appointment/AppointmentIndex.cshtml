@model List<HealthApp.Shared.DTOs.AppointmentDto>
@using HealthApp.Shared.Constant

@{
    ViewBag.Title = "Appointment Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <a href="/Home/Index" class="btn btn-outline-secondary">
        ← Back
    </a>

    <div>
        <a href="/Appointment/Create" class="btn btn-success">
            + Book Appointment
        </a>

        <button class="btn btn-outline-primary ms-2"
                data-bs-toggle="modal"
                data-bs-target="#searchModal">
            <i class="bi bi-search"></i>
        </button>
    </div>

</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h2 class="text-primary mb-3">Appointment Details</h2>

<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Date</th>
            <th>Slot</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AppointmentId</td>
                <td>@item.PatientName</td>
                <td>@item.DoctorName</td>
                <td>@item.ScheduledDate.ToString("yyyy-MM-dd")</td>
                <td>@item.TimeSlot</td>

                <td>
                    <span class="badge
                    @(item.Status == AppointmentStatus.Confirmed ? "bg-success" :
                      item.Status == AppointmentStatus.Cancelled ? "bg-danger" :
                      item.Status == AppointmentStatus.Completed ? "bg-info" :
                      "bg-warning")">
                        @item.Status
                    </span>

                    <!-- ✅ SHOW REASON ICON ONLY IF CANCELLED -->
                    @if (item.Status == AppointmentStatus.Cancelled)
                    {
                        <button class="btn btn-link btn-sm text-danger"
                                onclick="showReason('@item.CancellationReason')">
                            <i class="bi bi-eye"></i>
                        </button>
                    }
                </td>

                <td>

                    @if (item.Status == AppointmentStatus.Pending)
                    {
                        using (Html.BeginForm("Confirm", "Appointment", FormMethod.Post,
                            new { style = "display:inline;", @class = "confirm-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.AppointmentId" />

                            <button type="button" class="btn btn-success btn-sm me-1 confirm-btn">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        }

                        using (Html.BeginForm("Cancel", "Appointment", FormMethod.Post,
                            new { style = "display:inline;", @class = "cancel-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.AppointmentId" />
                            <input type="hidden" name="reason" class="reasonInput" />

                            <button type="button" class="btn btn-danger btn-sm cancel-btn">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    }
                    else if (item.Status == AppointmentStatus.Confirmed)
                    {
                        <a href="@Url.Action("CreateFromAppointment", "HealthRecord",
                            new { appointmentId = item.AppointmentId })"
                           class="btn btn-info btn-sm me-1">
                            <i class="bi bi-plus-lg"></i>
                        </a>

                        using (Html.BeginForm("Cancel", "Appointment", FormMethod.Post,
                            new { style = "display:inline;", @class = "cancel-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.AppointmentId" />
                            <input type="hidden" name="reason" class="reasonInput" />

                            <button type="button" class="btn btn-danger btn-sm cancel-btn">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    }
                    else if (item.Status == AppointmentStatus.Cancelled)
                    {
                        <span class="text-danger fw-semibold">Cancelled</span>
                    }
                    else if (item.Status == AppointmentStatus.Completed)
                    {
                        <span class="text-success fw-semibold">Completed</span>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ✅ REASON MODAL -->
<div class="modal fade" id="reasonModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4">

            <h5>Cancellation Reason</h5>

            <p id="reasonText"></p>

            <button class="btn btn-secondary"
                    data-bs-dismiss="modal">
                Close
            </button>

        </div>
    </div>
</div>

<!-- EXISTING MODALS (unchanged) -->
<div class="modal fade" id="searchModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4">

            <h5 class="mb-3 fw-bold">Search Appointment</h5>

            <form method="get" action="/Appointment/Search">
                <input type="text"
                       name="query"
                       class="form-control mb-3"
                       placeholder="Enter Id / Patient / Doctor" />

                <button class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="confirmModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4 text-center">
            <h5>Are you sure to confirm?</h5>
            <button class="btn btn-success mt-3" id="confirmYes">Yes</button>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4">

            <h5>Cancel Appointment</h5>

            <input type="text" id="cancelReason" class="form-control mt-3"
                   placeholder="Enter cancellation reason" />

            <span id="cancelError" class="text-danger"></span>

            <button class="btn btn-danger mt-3" id="cancelSubmit">Cancel Appointment</button>

        </div>
    </div>
</div>

@section Scripts{

    <script>
        let selectedForm;

        // ✅ CONFIRM
        $(".confirm-btn").click(function () {
            selectedForm = $(this).closest("form");
            $("#confirmModal").modal("show");
        });

        $("#confirmYes").click(function () {
            selectedForm.submit();
        });

        // ✅ CANCEL
        $(".cancel-btn").click(function () {
            selectedForm = $(this).closest("form");
            $("#cancelReason").val("");
            $("#cancelError").text("");
            $("#cancelModal").modal("show");
        });

        $("#cancelSubmit").click(function () {

            let reason = $("#cancelReason").val();

            if (!reason) {
                $("#cancelError").text("Reason required");
                return;
            }

            selectedForm.find(".reasonInput").val(reason);
            selectedForm.submit();
        });

        // ✅ ✅ NEW: SHOW REASON
        function showReason(text) {
            document.getElementById("reasonText").innerText = text || "No reason provided";

            var modal = new bootstrap.Modal(document.getElementById('reasonModal'));
            modal.show();
        }
    </script>

}
