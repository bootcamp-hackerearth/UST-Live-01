﻿@model HealthApp.Shared.DTOs.PatientDto

@{
    ViewBag.Title = "Edit";
}

<h2 class="mb-4">Edit Patient</h2>

<div class="card shadow p-4">
    @using (Html.BeginForm())
    {
        @Html.HiddenFor(m => m.PatientId)

        <div class="form-group">
            <label>Name</label>
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Date of Birth</label>
            @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
        </div>

        <div class="form-group mt-2">
            <label>Gender</label>
            @Html.TextBoxFor(m => m.Gender, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        </div>

        <div class="form-group mt-2">
            <label>Insurance</label>
            @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control" })
        </div>

        <div class="mt-3">
            <input type="submit" value="Update" class="btn btn-primary" />
            <a href="/Patient/PatientIndex" class="btn btn-secondary">Back</a>
        </div>
    }
</div>