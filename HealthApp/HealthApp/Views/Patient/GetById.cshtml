﻿@model HealthApp.Shared.DTOs.PatientDto

@{
    ViewBag.Title = "Patient Details";
}

<h2 class="mb-4">Patient Details</h2>

<div class="card shadow p-4">

    @if (Model != null)
    {
        <p><strong>Id:</strong> @Model.PatientId</p>
        <p><strong>Name:</strong> @Model.FullName</p>
        <p><strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")</p>
        <p><strong>Gender:</strong> @Model.Gender</p>
        <p><strong>Phone:</strong> @Model.PhoneNumber</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Insurance:</strong> @Model.InsuranceId</p>

        <div class="mt-3">

            <a href="/Patient/Edit/@Model.PatientId"
               class="btn btn-warning mr-2">
                Edit
            </a>

            <a href="/Patient/PatientIndex"
               class="btn btn-secondary">
                Back
            </a>

        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Patient not found
        </div>

        <a href="/Patient/PatientIndex"
           class="btn btn-secondary mt-3">
            Back
        </a>
    }

</div>