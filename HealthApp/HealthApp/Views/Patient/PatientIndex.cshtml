@model List<HealthApp.Shared.DTOs.PatientDto>

@{
    ViewBag.Title = "Patient Details";
}

<!-- TOP BAR -->
<div class="d-flex justify-content-between align-items-center mb-3">

    <a href="/Home/Index" class="btn btn-outline-secondary">
        ← Back
    </a>

    <div>
        <a href="/Patient/Create" class="btn btn-success me-2">
            + Patient
        </a>

        <button class="btn btn-outline-primary"
                data-bs-toggle="modal"
                data-bs-target="#searchModal">
            <i class="bi bi-search"></i>
        </button>
    </div>

</div>

<!-- ✅ ✅ ✅ ALERTS (IMPORTANT FIX) -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h2 class="text-primary mb-3">Patient Details</h2>

<!-- TABLE -->
<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>DOB</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Insurance</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                if (item != null)
                {
                    <tr>
                        <td>@item.PatientId</td>
                        <td>@item.FullName</td>
                        <td>@item.DateOfBirth.ToString("yyyy-MM-dd")</td>
                        <td>@item.Gender</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Email</td>
                        <td>@item.InsuranceId</td>

                        <td>

                            <!-- VIEW -->
                            <button class="btn btn-info btn-sm me-1"
                                    onclick="showDetails(@item.PatientId)">
                                <i class="bi bi-eye"></i>
                            </button>

                            <!-- EDIT -->
                            <a href="/Patient/Edit/@item.PatientId"
                               class="btn btn-warning btn-sm me-1">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <!-- BOOK APPOINTMENT -->
                            <a href="/Appointment/Create?patientId=@item.PatientId"
                               class="btn btn-success btn-sm">
                                <i class="bi bi-calendar-plus"></i>
                            </a>

                        </td>
                    </tr>
                }
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-danger">
                    No patients found
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- SEARCH MODAL -->
<div class="modal fade" id="searchModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content p-3">

            <h5>Search Patient</h5>

            <form method="get" action="/Patient/Search">
                <input type="text"
                       name="query"
                       class="form-control mb-2"
                       placeholder="Enter ID or Name" />

                <button type="submit"
                        class="btn btn-primary w-100">
                    Search
                </button>
            </form>

        </div>
    </div>
</div>

<!-- VIEW MODAL -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4">

            <h4 class="text-primary mb-3">Patient Details</h4>

            <div id="patientContent"></div>

            <div class="mt-4 d-flex justify-content-end gap-2">

                <a id="historyBtn" class="btn btn-info btn-sm">
                    Health History
                </a>

                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts{

    <script>

        function showDetails(id) {

            fetch('/Patient/GetById?id=' + id)
                .then(res => res.json())
                .then(data => {

                    let dob = "";
                    if (data.DateOfBirth) {
                        let ticks = data.DateOfBirth.replace("/Date(", "").replace(")/", "");
                        let date = new Date(parseInt(ticks));
                        dob = date.toISOString().split('T')[0];
                    }

                    document.getElementById("patientContent").innerHTML = `
                    <p><b>Id:</b> ${data.PatientId}</p>
                    <p><b>Name:</b> ${data.FullName}</p>
                    <p><b>Date of Birth:</b> ${dob}</p>
                    <p><b>Gender:</b> ${data.Gender}</p>
                    <p><b>Phone:</b> ${data.PhoneNumber}</p>
                    <p><b>Email:</b> ${data.Email}</p>
                    <p><b>Insurance:</b> ${data.InsuranceId}</p>
                `;

                    document.getElementById("historyBtn").href =
                        "/HealthRecord/GetPatientRecords?patientId=" + id;

                    new bootstrap.Modal(document.getElementById('detailModal')).show();
                });
        }

    </script>

}
