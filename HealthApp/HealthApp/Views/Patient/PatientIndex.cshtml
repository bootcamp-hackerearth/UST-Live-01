@model List<HealthApp.Shared.DTOs.PatientDto>

@{
    ViewBag.Title = "Patient Details";
}

<!-- ✅ TOP BAR -->
<div class="d-flex justify-content-between align-items-center mb-3">

    <!-- ✅ BACK -->
    <a href="/Home/Index" class="btn btn-outline-secondary">
        ← Back
    </a>

    <div>
        <!-- ✅ ADD -->
        <a href="/Patient/Create" class="btn btn-success me-2">
            + Patient
        </a>

        <!-- ✅ SEARCH ICON -->
        <button class="btn btn-outline-primary"
                data-bs-toggle="modal"
                data-bs-target="#searchModal">
            <i class="bi bi-search"></i>
        </button>
    </div>

</div>

<h2 class="text-primary mb-3">Patient Details</h2>

<!-- ✅ TABLE -->
<table class="table table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>DOB</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Insurance</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.PatientId</td>
                    <td>@item.FullName</td>
                    <td>@item.DateOfBirth.ToString("yyyy-MM-dd")</td>
                    <td>@item.Gender</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Email</td>
                    <td>@item.InsuranceId</td>

                    <td>

                        <!-- VIEW -->
                        <button class="btn btn-info btn-sm me-1"
                                onclick="showDetails(@item.PatientId)">
                            <i class="bi bi-eye"></i>
                        </button>

                        <!-- EDIT -->
                        <a href="/Patient/Edit/@item.PatientId"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i>
                        </a>

                    </td>
                    
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-danger">
                    No patients found
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ✅ SEARCH MODAL -->
<div class="modal fade" id="searchModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content p-3">

            <h5>Search Patient</h5>

            <form method="get" action="/Patient/Search">
                <input type="text"
                       name="query"
                       class="form-control mb-2"
                       placeholder="Enter ID or Name" />

                <button type="submit"
                        class="btn btn-primary w-100">
                    Search
                </button>
            </form>

        </div>
    </div>
</div>

<!-- ✅ VIEW POPUP -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content p-3">

            <h5>Patient Details</h5>

            <div id="patientContent"></div>

            <button class="btn btn-secondary mt-3"
                    data-bs-dismiss="modal">
                Close
            </button>

        </div>
    </div>
</div>

<!-- ✅ SCRIPT -->
<script>
    function showDetails(id) {
        fetch('/Patient/GetById/' + id)
            .then(response => response.text())
            .then(data => {
                document.getElementById("patientContent").innerHTML = data;

                var modal = new bootstrap.Modal(document.getElementById('detailModal'));
                modal.show();
            });
    }
</script>