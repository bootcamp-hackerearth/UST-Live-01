@model List<HealthApp.Shared.DTOs.DoctorDto>

@{
    ViewBag.Title = "Doctor Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <a href="/Home/Index" class="btn btn-outline-secondary">
        ← Back
    </a>

    <div>
        <a href="/Doctor/Create" class="btn btn-success me-2">
            + Doctor
        </a>

        <button class="btn btn-outline-primary"
                data-bs-toggle="modal"
                data-bs-target="#searchModal">
            <i class="bi bi-search"></i>
        </button>
    </div>

</div>

<!-- ✅ ✅ ✅ IMPORTANT: ALERTS (FIXED) -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h2 class="text-primary mb-3">Doctor Details</h2>

<table class="table table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Specialisation</th>
            <th>Experience</th>
            <th>Fee</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.DoctorId</td>
                    <td>@item.FullName</td>
                    <td>@item.Specialisation</td>
                    <td>@item.YearsOfExperience</td>
                    <td>@item.ConsultationFee</td>

                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>

                    <td class="d-flex align-items-center gap-2">

                        <!-- ✅ VIEW -->
                        <button class="btn btn-info btn-sm"
                                onclick="showDoctor(@item.DoctorId)">
                            <i class="bi bi-eye"></i>
                        </button>

                        <!-- ✅ EDIT -->
                        <a href="/Doctor/Edit/@item.DoctorId"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <!-- ✅ TOGGLE -->
                        <label class="switch ms-2">
                            <input type="checkbox"
                                   onclick="openConfirm(@item.DoctorId, @(item.IsActive.ToString().ToLower()))"
                                   @(item.IsActive ? "checked" : "") />
                            <span class="slider"></span>
                        </label>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-danger">
                    No doctors found
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ✅ VIEW MODAL -->
<div class="modal fade" id="doctorModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4">

            <h4 class="text-primary mb-3">Doctor Details</h4>

            <div id="doctorContent"></div>

            <div class="text-end mt-3">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ✅ SEARCH MODAL -->
<div class="modal fade" id="searchModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content p-3">

            <h5>Search Doctor</h5>

            @using (Html.BeginForm("Search", "Doctor", FormMethod.Get))
            {
                <input type="text"
                       name="query"
                       class="form-control mb-2"
                       placeholder="Enter Name or ID" />

                <button class="btn btn-primary w-100">
                    Search
                </button>
            }

        </div>
    </div>
</div>

<!-- ✅ CONFIRM MODAL -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4 text-center">

            <h5 id="confirmText" class="mb-3"></h5>

            <div class="mt-3">
                <button class="btn btn-light me-2" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-success" id="confirmBtn">
                    Confirm
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>

        var selectedId = 0;

        // ✅ VIEW
        function showDoctor(id) {

            fetch('/Doctor/GetById/' + id)
                .then(res => res.json())
                .then(data => {

                    if (data.error) {
                        alert(data.error);
                        return;
                    }

                    document.getElementById("doctorContent").innerHTML = `
                    <p><b>Id:</b> ${data.DoctorId}</p>
                    <p><b>Name:</b> ${data.FullName}</p>
                    <p><b>Specialisation:</b> ${data.Specialisation}</p>
                    <p><b>Experience:</b> ${data.YearsOfExperience} years</p>
                    <p><b>Fee:</b> ${data.ConsultationFee}</p>
                    <p><b>Status:</b> ${data.IsActive ? "Active" : "Inactive"}</p>
                `;

                    new bootstrap.Modal(document.getElementById('doctorModal')).show();
                });
        }

        // ✅ TOGGLE
        function openConfirm(id, isActive) {

            selectedId = id;

            let message = isActive
                ? "Are you sure you want to deactivate?"
                : "Are you sure you want to activate?";

            document.getElementById("confirmText").innerText = message;

            new bootstrap.Modal(document.getElementById('confirmModal')).show();
        }

        document.getElementById("confirmBtn").onclick = function () {
            window.location.href = '/Doctor/ToggleStatus/' + selectedId;
        };

    </script>
}

<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 26px;
    }

        .switch input {
            opacity: 0;
        }

    .slider {
        position: absolute;
        background-color: #dc3545;
        border-radius: 34px;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 3px;
            background: white;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #198754;
    }

        input:checked + .slider:before {
            transform: translateX(24px);
        }
</style>