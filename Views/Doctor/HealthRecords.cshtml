@model List<HealthcareMvcApp.Models.HealthRecord>

@{
    ViewBag.Title = "Doctor Health Records";
    int doctorId = ViewBag.DoctorId;
}

<h2 class="text-success">My Created Health Records</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    @Html.ActionLink(
        "Back to Dashboard",
        "Dashboard",
        "Doctor",
        new { doctorId = doctorId },
        new { @class = "btn btn-secondary" }
    )
</p>

@if (Model == null || Model.Count == 0)
{
    <p>No health records found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Record ID</th>
                <th>Patient ID</th>
                <th>Appointment ID</th>
                <th>Visit Date</th>
                <th>Diagnosis</th>
                <th>Prescription</th>
                <th>Notes</th>
                <th>Edit</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td>@record.HealthRecordId</td>
                    <td>@record.PatientId</td>
                    <td>@record.AppointmentId</td>
                    <td>@record.VisitDate.ToString("yyyy-MM-dd")</td>
                    <td>@record.Diagnosis</td>
                    <td>@record.Prescription</td>
                    <td>@record.Notes</td>
                    <td>
                        @Html.ActionLink(
                            "Edit",
                            "EditHealthRecord",
                            "Doctor",
                            new { id = record.HealthRecordId, doctorId = doctorId },
                            new { @class = "btn btn-warning btn-sm" }
                        )
                    </td>
                </tr>
            }
        </tbody>
    </table>
}