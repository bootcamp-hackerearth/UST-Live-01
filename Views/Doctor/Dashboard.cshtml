@model HealthcareMvcApp.Models.Doctor

@{
    ViewBag.Title = "Doctor Dashboard";
}

<h2 class="text-success">Doctor Dashboard</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="dashboard-panel">
    <h4>Welcome, Dr. @Model.FullName</h4>

    <table class="table table-striped table-bordered">
        <tbody>
            <tr>
                <td>Doctor ID</td>
                <td>@Model.DoctorId</td>
            </tr>
            <tr>
                <td>Name</td>
                <td>@Model.FullName</td>
            </tr>
            <tr>
                <td>Specialisation</td>
                <td>@Model.Specialisation</td>
            </tr>
            <tr>
                <td>Years of Experience</td>
                <td>@Model.YearsOfExperience</td>
            </tr>
            <tr>
                <td>Consultation Fee</td>
                <td>@Model.ConsultationFee</td>
            </tr>
            <tr>
                <td>Active</td>
                <td>@Model.IsActive</td>
            </tr>
        </tbody>
    </table>

    <div class="dashboard-actions">
        @Html.ActionLink(
            "View Upcoming Appointments",
            "UpcomingAppointments",
            "Doctor",
            new { doctorId = Model.DoctorId },
            new { @class = "btn btn-primary" }
        )

        @Html.ActionLink(
            "View My Health Records",
            "HealthRecords",
            "Doctor",
            new { doctorId = Model.DoctorId },
            new { @class = "btn btn-info" }
        )

        @Html.ActionLink(
            "Manage Off Days",
            "OffDays",
            "Doctor",
            new { doctorId = Model.DoctorId },
            new { @class = "btn btn-warning" }
        )

        @if (Model.IsActive)
        {
            using (Html.BeginForm("DeactivateSelf", "Doctor", new { doctorId = Model.DoctorId }, FormMethod.Post))
            {
                <button type="submit" class="btn btn-danger">
                    Deactivate My Account
                </button>
            }
        }
        else
        {
            using (Html.BeginForm("ReactivateSelf", "Doctor", new { doctorId = Model.DoctorId }, FormMethod.Post))
            {
                <button type="submit" class="btn btn-success">
                    Reactivate My Account
                </button>
            }
        }

        @Html.ActionLink(
            "Logout",
            "Index",
            "Home",
            null,
            new { @class = "btn btn-dark" }
        )
    </div>
</div>