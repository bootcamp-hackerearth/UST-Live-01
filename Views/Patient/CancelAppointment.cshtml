@model HealthcareMvcApp.Models.Appointment

@{
    ViewBag.Title = "Cancel Appointment";
    int patientId = ViewBag.PatientId;
}

<h2 class="text-danger">Cancel Appointment</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="col-5">
    <table class="table table-striped">
        <tbody>
            <tr>
                <td>Appointment ID</td>
                <td>@Model.AppointmentId</td>
            </tr>
            <tr>
                <td>Patient ID</td>
                <td>@Model.PatientId</td>
            </tr>
            <tr>
                <td>Doctor ID</td>
                <td>@Model.DoctorId</td>
            </tr>
            <tr>
                <td>Date</td>
                <td>@Model.ScheduledDate.ToString("yyyy-MM-dd")</td>
            </tr>
            <tr>
                <td>Slot</td>
                <td>@Model.SlotNumber</td>
            </tr>
            <tr>
                <td>Status</td>
                <td>@Model.Status</td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm("CancelAppointment", "Patient", FormMethod.Post))
    {
        @Html.Hidden("appointmentId", Model.AppointmentId)
        @Html.Hidden("patientId", patientId)

        <div class="mb-2">
            <label class="fw-bold">Cancellation Reason</label>
            <textarea name="reason" class="form-control border-dark"></textarea>
        </div>

        <div class="d-flex">
            <button type="submit" class="btn btn-danger me-2">
                Confirm Cancellation
            </button>

            @Html.ActionLink(
                "Go Back",
                "UpcomingAppointments",
                "Patient",
                new { patientId = patientId },
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>