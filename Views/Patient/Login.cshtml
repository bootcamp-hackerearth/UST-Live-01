@{
    ViewBag.Title = "Patient Login";
}

<h2 class="text-success">Patient Login</h2>

<div class="col-4">
    @using (Html.BeginForm("Login", "Patient", FormMethod.Post))
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-2">
            <label class="fw-bold">Patient ID</label>
            <input type="number" name="patientId" class="form-control border-dark" />
        </div>

        <div class="d-flex">
            <button class="btn btn-primary me-2 w-50">Continue</button>
            @Html.ActionLink("Cancel", "Index", "Home", null, new { @class = "btn btn-secondary w-50" })
        </div>
    }
</div>