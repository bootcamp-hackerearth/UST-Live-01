@model HealthcareMvcApp.Models.Appointment
@using HealthcareMvcApp.Enums
@using HealthcareMvcApp.Models

@{
    ViewBag.Title = "Book Appointment";
    int patientId = Model != null ? Model.PatientId : 0;
    Specialisation? selectedSpecialisation = ViewBag.SelectedSpecialisation as Specialisation?;
    List<Doctor> doctors = ViewBag.Doctors as List<Doctor>;
}

<h2 class="text-success">Book Appointment</h2>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div class="col-6">
    <h4>Search Available Doctors</h4>

    @using (Html.BeginForm("BookAppointment", "Patient", FormMethod.Get))
    {
        @Html.Hidden("patientId", patientId)

        <div class="mb-2">
            <label class="fw-bold">Specialisation</label>
            @Html.DropDownList(
                "specialisation",
                new SelectList(Enum.GetValues(typeof(Specialisation)), selectedSpecialisation),
                "Select Specialisation",
                new { @class = "form-control border-dark" }
            )
        </div>

        <div class="mb-2">
            <label class="fw-bold">Appointment Date</label>
            <input type="date"
                   name="scheduledDate"
                   value="@Model.ScheduledDate.ToString("yyyy-MM-dd")"
                   class="form-control border-dark" />
        </div>

        <div class="mb-2">
            <label class="fw-bold">Slot Number</label>
            <input type="number"
                   name="slotNumber"
                   value="@Model.SlotNumber"
                   min="1"
                   max="10"
                   class="form-control border-dark" />
        </div>

        <button type="submit" class="btn btn-info">
            Show Available Doctors
        </button>
    }
</div>

<hr />

@if (doctors != null)
{
    <h4>Available Doctors</h4>

    if (doctors.Count == 0)
    {
        <p>No available doctors found for the selected specialisation, date, and slot.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Doctor ID</th>
                    <th>Name</th>
                    <th>Specialisation</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Book</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var doctor in doctors)
                {
                    <tr>
                        <td>@doctor.DoctorId</td>
                        <td>@doctor.FullName</td>
                        <td>@doctor.Specialisation</td>
                        <td>@doctor.YearsOfExperience</td>
                        <td>@doctor.ConsultationFee</td>
                        <td>
                            @using (Html.BeginForm("BookAppointment", "Patient", FormMethod.Post))
                            {
                                @Html.Hidden("PatientId", patientId)
                                @Html.Hidden("DoctorId", doctor.DoctorId)
                                @Html.Hidden("ScheduledDate", Model.ScheduledDate.ToString("yyyy-MM-dd"))
                                @Html.Hidden("SlotNumber", Model.SlotNumber)

                                <button type="submit" class="btn btn-primary btn-sm">
                                    Select Doctor
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<p>
    @Html.ActionLink(
        "Back to Dashboard",
        "Dashboard",
        "Patient",
        new { patientId = patientId },
        new { @class = "btn btn-secondary" }
    )
</p>