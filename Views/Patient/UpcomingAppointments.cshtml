@model List<HealthcareMvcApp.Models.Appointment>
@using HealthcareMvcApp.Enums

@{
    ViewBag.Title = "Upcoming Appointments";
    int patientId = ViewBag.PatientId;
}

<h2 class="text-success">Upcoming Appointments</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    @Html.ActionLink(
        "Back to Dashboard",
        "Dashboard",
        "Patient",
        new { patientId = patientId },
        new { @class = "btn btn-secondary" }
    )
</p>

@if (Model == null || Model.Count == 0)
{
    <p>No upcoming appointments found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Appointment ID</th>
                <th>Doctor ID</th>
                <th>Date</th>
                <th>Slot</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td>@appointment.AppointmentId</td>
                    <td>@appointment.DoctorId</td>
                    <td>@appointment.ScheduledDate.ToString("yyyy-MM-dd")</td>
                    <td>@appointment.SlotNumber</td>
                    <td>@appointment.Status</td>
                    <td>
                        @if (appointment.Status != AppointmentStatus.Cancelled &&
                             appointment.Status != AppointmentStatus.Completed)
                        {
                            @Html.ActionLink(
                                "Cancel",
                                "CancelAppointment",
                                "Patient",
                                new
                                {
                                    appointmentId = appointment.AppointmentId,
                                    patientId = patientId
                                },
                                new { @class = "btn btn-danger btn-sm" }
                            )
                        }
                        else
                        {
                            <span class="text-muted">No action</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}