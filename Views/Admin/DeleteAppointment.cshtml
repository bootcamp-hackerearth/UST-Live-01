@model HealthcareMvcApp.Models.Appointment

@{
    ViewBag.Title = "Delete Appointment";
}

<h2 class="text-danger">Do you wish to delete this appointment?</h2>

<div class="col-5">
    <table class="table table-striped">
        <tbody>
            <tr>
                <td>Appointment ID</td>
                <td>@Model.AppointmentId</td>
            </tr>
            <tr>
                <td>Patient ID</td>
                <td>@Model.PatientId</td>
            </tr>
            <tr>
                <td>Doctor ID</td>
                <td>@Model.DoctorId</td>
            </tr>
            <tr>
                <td>Date</td>
                <td>@Model.ScheduledDate.ToString("yyyy-MM-dd")</td>
            </tr>
            <tr>
                <td>Slot</td>
                <td>@Model.SlotNumber</td>
            </tr>
            <tr>
                <td>Status</td>
                <td>@Model.Status</td>
            </tr>
            <tr>
                <td>Cancellation Reason</td>
                <td>@Model.CancellationReason</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex">
        @using (Html.BeginForm("DeleteAppointment", "Admin", new { id = Model.AppointmentId }, FormMethod.Post))
        {
            <button type="submit" class="btn btn-danger me-2">Delete</button>
        }

        @Html.ActionLink("Cancel", "Appointments", "Admin", null, new { @class = "btn btn-secondary" })
    </div>
</div>