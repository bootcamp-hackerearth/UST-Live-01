@model List<HealthcareMvcApp.Models.HealthRecord>

@{
    ViewBag.Title = "Health Records";
}

<h2 class="text-success">Health Records</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    @Html.ActionLink("Create Health Record", "CreateHealthRecord", "Admin", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Back to Admin", "Index", "Admin", null, new { @class = "btn btn-secondary" })
</p>

@if (Model == null || Model.Count == 0)
{
    <p>No health records found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Record ID</th>
                <th>Patient ID</th>
                <th>Doctor ID</th>
                <th>Appointment ID</th>
                <th>Visit Date</th>
                <th>Diagnosis</th>
                <th>Prescription</th>
                <th>Notes</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td>@record.HealthRecordId</td>
                    <td>@record.PatientId</td>
                    <td>@record.DoctorId</td>
                    <td>@record.AppointmentId</td>
                    <td>@record.VisitDate.ToString("yyyy-MM-dd")</td>
                    <td>@record.Diagnosis</td>
                    <td>@record.Prescription</td>
                    <td>@record.Notes</td>
                    <td>
                        @Html.ActionLink(
                            "Edit",
                            "EditHealthRecord",
                            "Admin",
                            new { id = record.HealthRecordId },
                            new { @class = "btn btn-warning btn-sm" }
                        )
                    </td>
                    <td>
                        @Html.ActionLink(
                            "Delete",
                            "DeleteHealthRecord",
                            "Admin",
                            new { id = record.HealthRecordId },
                            new { @class = "btn btn-danger btn-sm" }
                        )
                    </td>
                </tr>
            }
        </tbody>
    </table>
}