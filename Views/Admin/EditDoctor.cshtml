@model HealthcareMvcApp.Models.Doctor
@using HealthcareMvcApp.Enums

@{
    ViewBag.Title = "Edit Doctor";
}

<h2 class="text-success">Update Doctor</h2>

<div class="col-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(m => m.DoctorId)

        <div class="mb-2">
            @Html.LabelFor(m => m.DoctorId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.DoctorId, new { @class = "form-control border-dark", @readonly = "readonly" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.FullName, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.Specialisation, new { @class = "fw-bold" })
            @Html.DropDownListFor(
                m => m.Specialisation,
                new SelectList(Enum.GetValues(typeof(Specialisation)), Model.Specialisation),
                "Select Specialisation",
                new { @class = "form-control border-dark" }
            )
            @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.PracticeStartDate, new { @class = "fw-bold" })
            @Html.TextBoxFor(
                m => m.PracticeStartDate,
                "{0:yyyy-MM-dd}",
                new { @class = "form-control border-dark", type = "date" }
            )
            @Html.ValidationMessageFor(m => m.PracticeStartDate, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.ConsultationFee, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.IsActive, new { @class = "fw-bold" })
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
            @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
        </div>

        <div class="d-flex">
            <button type="submit" class="btn btn-primary me-2 w-50">Update Doctor</button>
            @Html.ActionLink("Cancel", "Doctors", "Admin", null, new { @class = "btn btn-secondary w-50" })
        </div>
    }
</div>