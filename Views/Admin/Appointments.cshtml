@model List<HealthcareMvcApp.Models.Appointment>

@{
    ViewBag.Title = "Appointments";
}

<h2 class="text-success">Appointments</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<p>
    @Html.ActionLink("Create Appointment", "CreateAppointment", "Admin", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Back to Admin", "Index", "Admin", null, new { @class = "btn btn-secondary" })
</p>

<div class="col-6 mb-3">
    <h5 class="text-center">Filter Appointments</h5>

    <div class="d-flex mb-2">
        @using (Html.BeginForm("AppointmentsByPatient", "Admin", FormMethod.Get))
        {
            <input type="number" name="patientId" class="form-control me-2" placeholder="Patient ID" />
            <button type="submit" class="btn btn-info mt-1">Search by Patient</button>
        }
    </div>

    <div class="d-flex">
        @using (Html.BeginForm("AppointmentsByDoctor", "Admin", FormMethod.Get))
        {
            <input type="number" name="doctorId" class="form-control me-2" placeholder="Doctor ID" />
            <button type="submit" class="btn btn-info mt-1">Search by Doctor</button>
        }
    </div>
</div>

@if (Model == null || Model.Count == 0)
{
    <p>No appointments found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Appointment ID</th>
                <th>Patient ID</th>
                <th>Doctor ID</th>
                <th>Date</th>
                <th>Slot</th>
                <th>Status</th>
                <th>Cancellation Reason</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td>@appointment.AppointmentId</td>
                    <td>@appointment.PatientId</td>
                    <td>@appointment.DoctorId</td>
                    <td>@appointment.ScheduledDate.ToString("yyyy-MM-dd")</td>
                    <td>@appointment.SlotNumber</td>
                    <td>@appointment.Status</td>
                    <td>@appointment.CancellationReason</td>
                    <td>
                        @Html.ActionLink(
                            "Edit",
                            "EditAppointment",
                            "Admin",
                            new { id = appointment.AppointmentId },
                            new { @class = "btn btn-warning btn-sm" }
                        )
                    </td>
                    <td>
                        @Html.ActionLink(
                            "Delete",
                            "DeleteAppointment",
                            "Admin",
                            new { id = appointment.AppointmentId },
                            new { @class = "btn btn-danger btn-sm" }
                        )
                    </td>
                </tr>
            }
        </tbody>
    </table>
}