@model HealthcareMvcApp.Models.Appointment
@{
    ViewBag.Title = "Create Appointment";
}

<h2 class="text-success">Create Appointment</h2>

<div class="col-5">
    @using (Html.BeginForm("CreateAppointment", "Admin", FormMethod.Post))
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-2">
            <label class="fw-bold">Patient ID</label>
            <input type="number" name="patientId" class="form-control border-dark" />
        </div>

        <div class="mb-2">
            <label class="fw-bold">Doctor ID</label>
            <input type="number" name="doctorId" class="form-control border-dark" />
        </div>

        <div class="mb-2">
            <label class="fw-bold">Appointment Date</label>
            <input type="date" name="scheduledDate" class="form-control border-dark" />
        </div>

        <div class="mb-2">
            <label class="fw-bold">Slot Number</label>
            <input type="number" name="slotNumber" class="form-control border-dark" min="1" max="10" />
        </div>

        <div class="d-flex">
            <button type="submit" class="btn btn-primary me-2 w-50">Create Appointment</button>
            @Html.ActionLink("Cancel", "Appointments", "Admin", null, new { @class = "btn btn-secondary w-50" })
        </div>
    }
</div>

@if (ViewBag.Patients != null)
{
    <h4 class="mt-4">Patients</h4>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Patient ID</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var patient in ViewBag.Patients)
            {
                <tr>
                    <td>@patient.PatientId</td>
                    <td>@patient.FullName</td>
                    <td>@patient.PhoneNumber</td>
                    <td>@patient.Email</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewBag.Doctors != null)
{
    <h4 class="mt-4">Active Doctors</h4>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Doctor ID</th>
                <th>Name</th>
                <th>Specialisation</th>
                <th>Experience</th>
                <th>Fee</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var doctor in ViewBag.Doctors)
            {
                <tr>
                    <td>@doctor.DoctorId</td>
                    <td>@doctor.FullName</td>
                    <td>@doctor.Specialisation</td>
                    <td>@doctor.YearsOfExperience</td>
                    <td>@doctor.ConsultationFee</td>
                </tr>
            }
        </tbody>
    </table>
}
}