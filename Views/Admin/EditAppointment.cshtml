@model HealthcareMvcApp.Models.Appointment
@using HealthcareMvcApp.Enums

@{
    ViewBag.Title = "Edit Appointment";
}

<h2 class="text-success">Edit Appointment</h2>

<div class="col-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(m => m.AppointmentId)

        <div class="mb-2">
            @Html.LabelFor(m => m.AppointmentId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.AppointmentId, new { @class = "form-control border-dark", @readonly = "readonly" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.PatientId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.PatientId, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.DoctorId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.DoctorId, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.ScheduledDate, new { @class = "fw-bold" })
            @Html.TextBoxFor(
                m => m.ScheduledDate,
                "{0:yyyy-MM-dd}",
                new { @class = "form-control border-dark", type = "date" }
            )
            @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.SlotNumber, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.SlotNumber, new { @class = "form-control border-dark", type = "number", min = "1", max = "10" })
            @Html.ValidationMessageFor(m => m.SlotNumber, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.CancellationReason, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.CancellationReason, new { @class = "form-control border-dark", @readonly = "readonly" })
        </div>

        <div class="mb-2">
            <label class="fw-bold">Status</label>
            <input type="text" value="@Model.Status" class="form-control border-dark" readonly="readonly" />
        </div>

        <div class="d-flex">
            <button type="submit" class="btn btn-primary me-2 w-50">Update Appointment</button>
            @Html.ActionLink("Cancel", "Appointments", "Admin", null, new { @class = "btn btn-secondary w-50" })
        </div>
    }
</div>

@if (ViewBag.Patients != null)
{
    <h4 class="mt-4">Patients</h4>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Patient ID</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var patient in ViewBag.Patients)
            {
                <tr>
                    <td>@patient.PatientId</td>
                    <td>@patient.FullName</td>
                    <td>@patient.PhoneNumber</td>
                    <td>@patient.Email</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewBag.Doctors != null)
{
    <h4 class="mt-4">Active Doctors</h4>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Doctor ID</th>
                <th>Name</th>
                <th>Specialisation</th>
                <th>Experience</th>
                <th>Fee</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var doctor in ViewBag.Doctors)
            {
                <tr>
                    <td>@doctor.DoctorId</td>
                    <td>@doctor.FullName</td>
                    <td>@doctor.Specialisation</td>
                    <td>@doctor.YearsOfExperience</td>
                    <td>@doctor.ConsultationFee</td>
                </tr>
            }
        </tbody>
    </table>
}
``