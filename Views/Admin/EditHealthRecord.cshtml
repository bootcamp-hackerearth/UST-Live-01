@model HealthcareMvcApp.Models.HealthRecord

@{
    ViewBag.Title = "Edit Health Record";
}

<h2 class="text-success">Edit Health Record</h2>

<div class="col-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(m => m.HealthRecordId)
        @Html.HiddenFor(m => m.PatientId)
        @Html.HiddenFor(m => m.DoctorId)
        @Html.HiddenFor(m => m.AppointmentId)
        @Html.HiddenFor(m => m.VisitDate)

        <div class="mb-2">
            @Html.LabelFor(m => m.HealthRecordId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.HealthRecordId, new { @class = "form-control border-dark", @readonly = "readonly" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.PatientId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.PatientId, new { @class = "form-control border-dark", @readonly = "readonly" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.DoctorId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.DoctorId, new { @class = "form-control border-dark", @readonly = "readonly" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.AppointmentId, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.AppointmentId, new { @class = "form-control border-dark", @readonly = "readonly" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.VisitDate, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.VisitDate, "{0:yyyy-MM-dd}", new { @class = "form-control border-dark", @readonly = "readonly" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.Diagnosis, new { @class = "fw-bold" })
            @Html.TextAreaFor(m => m.Diagnosis, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.Diagnosis, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.Prescription, new { @class = "fw-bold" })
            @Html.TextAreaFor(m => m.Prescription, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.Prescription, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.Notes, new { @class = "fw-bold" })
            @Html.TextAreaFor(m => m.Notes, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
        </div>

        <div class="d-flex">
            <button type="submit" class="btn btn-primary me-2 w-50">Update Record</button>
            @Html.ActionLink("Cancel", "HealthRecords", "Admin", null, new { @class = "btn btn-secondary w-50" })
        </div>
    }
</div>
