@model List<HealthcareMvcApp.Models.Doctor>

@{
    ViewBag.Title = "Doctors";
}

<h2 class="text-success">Doctors</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    @Html.ActionLink("Add Doctor", "CreateDoctor", "Admin", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Back to Admin", "Index", "Admin", null, new { @class = "btn btn-secondary" })
</p>

@if (Model == null || Model.Count == 0)
{
    <p>No doctors found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Doctor ID</th>
                <th>Name</th>
                <th>Specialisation</th>
                <th>Practice Start Date</th>
                <th>Experience</th>
                <th>Fee</th>
                <th>Active</th>
                <th>Edit</th>
                <th>Status Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var doctor in Model)
            {
                <tr>
                    <td>@doctor.DoctorId</td>
                    <td>@doctor.FullName</td>
                    <td>@doctor.Specialisation</td>
                    <td>@doctor.PracticeStartDate.ToString("yyyy-MM-dd")</td>
                    <td>@doctor.YearsOfExperience</td>
                    <td>@doctor.ConsultationFee</td>
                    <td>@doctor.IsActive</td>
                    <td>
                        @Html.ActionLink(
                            "Edit",
                            "EditDoctor",
                            "Admin",
                            new { id = doctor.DoctorId },
                            new { @class = "btn btn-warning btn-sm" }
                        )
                    </td>
                    <td>
                        @if (doctor.IsActive)
                        {
                            @Html.ActionLink(
                                "Deactivate",
                                "DeactivateDoctor",
                                "Admin",
                                new { id = doctor.DoctorId },
                                new { @class = "btn btn-danger btn-sm" }
                            )
                        }
                        else
                        {
                            @Html.ActionLink(
                                "Reactivate",
                                "ReactivateDoctor",
                                "Admin",
                                new { id = doctor.DoctorId },
                                new { @class = "btn btn-success btn-sm" }
                            )
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
