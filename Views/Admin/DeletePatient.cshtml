@model HealthcareMvcApp.Models.Patient

@{
    ViewBag.Title = "Delete Patient";
}

<h2 class="text-danger">Do you wish to delete this patient?</h2>

<div class="col-5">
    <table class="table table-striped">
        <tbody>
            <tr>
                <td>Patient ID</td>
                <td>@Model.PatientId</td>
            </tr>
            <tr>
                <td>Name</td>
                <td>@Model.FullName</td>
            </tr>
            <tr>
                <td>Date of Birth</td>
                <td>@Model.DateOfBirth.ToString("yyyy-MM-dd")</td>
            </tr>
            <tr>
                <td>Age</td>
                <td>@Model.GetAge()</td>
            </tr>
            <tr>
                <td>Gender</td>
                <td>@Model.Gender</td>
            </tr>
            <tr>
                <td>Phone</td>
                <td>@Model.PhoneNumber</td>
            </tr>
            <tr>
                <td>Email</td>
                <td>@Model.Email</td>
            </tr>
            <tr>
                <td>Insurance ID</td>
                <td>@Model.InsuranceId</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex">
        @using (Html.BeginForm("DeletePatient", "Admin", new { id = Model.PatientId }, FormMethod.Post))
        {
            <button type="submit" class="btn btn-danger me-2">Delete</button>
        }

        @Html.ActionLink("Cancel", "Patients", "Admin", null, new { @class = "btn btn-secondary" })
    </div>
</div>