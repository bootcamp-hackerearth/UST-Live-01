@page "/patients"


@using HealthApp.Shared.Dto
@using Microsoft.AspNetCore.Components.Web
@inject IPatientService PatientService

<PageTitle>Patients</PageTitle>

<div class="page">

    <div class="header">
        <div>
            <h2>Patients</h2>
            <p>Manage patient information</p>
        </div>
    </div>

    <div class="toolbar">
        <div class="toolbar-left">
            <input class="input search" placeholder="Search by Name or Email..." @bind="searchText"
                   @onkeypress="HandleKeyPress" />

            <button class="btn primary" @onclick="Search">Search</button>
        </div>

        <div class="toolbar-right">
            <button class="btn light" @onclick="Reset">Reset</button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="empty">Loading patients...</div>
    }
    else if (!patients.Any())
    {
        <div class="empty">No patients found.</div>
    }
    else
    {
        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in patients)
                    {
                        <tr>
                            <td>@p.PatientId</td>
                            <td>@p.FullName</td>
                            <td>@p.Email</td>
                            <td>@p.PhoneNumber</td>
                            <td>@p.Gender</td>
                            <td>@p.DateOfBirth?.ToString("dd-MM-yyyy")</td>
                            <td>
                                <button class="mini view" @onclick="() => ViewPatient(p)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="pagination">
        <button class="btn light" disabled="@(pageNumber == 1)" @onclick="PrevPage">
            Prev
        </button>

        <span>Page @pageNumber of @TotalPages</span>

        <button class="btn light" disabled="@(pageNumber >= TotalPages)" @onclick="NextPage">
            Next
        </button>
    </div>

    @if (viewPatient is not null)
    {
        <div class="modal">
            <div class="modal-box">
                <h3>Patient Details</h3>

                <p><b>Name:</b> @viewPatient.FullName</p>
                <p><b>Email:</b> @viewPatient.Email</p>
                <p><b>Phone:</b> @viewPatient.PhoneNumber</p>
                <p><b>Gender:</b> @viewPatient.Gender</p>

                <p>
                    <b>DOB:</b>
                    @viewPatient.DateOfBirth?.ToString("dd-MM-yyyy")
                </p>

                <p>
                    <b>Age:</b>
                    @(viewPatient.DateOfBirth != null
                        ? GetAge(viewPatient.DateOfBirth.Value)
                        : 0) years
                </p>

                <button class="btn light" @onclick="CloseView">Close</button>
            </div>
        </div>
    }

</div>

@code {
    private List<PatientDto> patients = new();
    private List<PatientDto> allPatients = new();

    private bool isLoading = true;
    private string searchText = "";

    private PatientDto? viewPatient;

    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalRecords = 0;

    private int TotalPages => (int)Math.Ceiling((double)totalRecords / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        isLoading = true;

        try
        {
            List<PatientDto> tempList = new();
            int currentPage = 1;
            int totalPagesLocal = 1;

            do
            {
                var result = await PatientService
                    .GetPagedPatientsAsync(currentPage, pageSize, null);

                tempList.AddRange(result.Data);

                totalPagesLocal = (int)Math.Ceiling((double)result.TotalRecords / pageSize);

                currentPage++;

            } while (currentPage <= totalPagesLocal);

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                tempList = tempList.Where(p =>
                    (!string.IsNullOrWhiteSpace(p.FullName) &&
                     p.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                    ||
                    (!string.IsNullOrWhiteSpace(p.Email) &&
                     p.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                ).ToList();
            }

            totalRecords = tempList.Count;

            patients = tempList
                .Skip((pageNumber - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
        catch
        {
            patients = new List<PatientDto>();
            totalRecords = 0;
        }

        isLoading = false;
    }



    private async Task Search()
    {
        pageNumber = 1;
        await LoadPatients();
    }

    private async Task Reset()
    {
        searchText = "";
        pageNumber = 1;
        await LoadPatients();
    }

    private async Task NextPage()
    {
        if (pageNumber < TotalPages)
        {
            pageNumber++;
            await LoadPatients();
        }
    }

    private async Task PrevPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadPatients();
        }
    }

    private void ViewPatient(PatientDto p)
    {
        viewPatient = p;
    }

    private void CloseView()
    {
        viewPatient = null;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            pageNumber = 1;
            await LoadPatients();
        }
    }

    private int GetAge(DateTime dob)
    {
        var today = DateTime.Today;
        var age = today.Year - dob.Year;

        if (dob > today.AddYears(-age)) age--;

        return age;
    }
}

<style>
    .page {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .header h2 {
        font-size: 34px;
        margin: 0;
        font-weight: 800;
    }

    .header p {
        color: #64748b;
    }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .toolbar-left {
        display: flex;
        gap: 10px;
    }

    .toolbar-right {
        display: flex;
        gap: 10px;
    }

    .input {
        padding: 10px 14px;
        border-radius: 12px;
        border: 1px solid #d1d5db;
        font-size: 14px;
    }

    .search {
        width: 280px;
    }

    .btn {
        padding: 10px 16px;
        border-radius: 12px;
        border: none;
        font-weight: 700;
        cursor: pointer;
    }

    .primary {
        background: #2563eb;
        color: white;
    }

    .light {
        background: #f1f5f9;
    }

    .card {
        background: white;
        padding: 20px;
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

    .table th {
        background: #f8fafc;
        color: #64748b;
        text-transform: uppercase;
        font-size: 13px;
        padding: 12px;
    }

    .table td {
        padding: 14px;
        border-bottom: 1px solid #eef2f7;
    }

    .mini {
        padding: 7px 12px;
        border-radius: 10px;
        border: none;
        font-weight: 700;
    }

    /* PAGINATION */
    .pagination {
        margin-top: 28px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 18px;
    }

    .pagination button {
        border: none;
        padding: 10px 18px;
        border-radius: 999px;
        background: #e0ecff;
        color: #2563eb;
        font-size: 16px;
        font-weight: 900;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .pagination button:hover:not(:disabled) {
        background: #2563eb;
        color: #ffffff;
    }

    .pagination button:disabled {
        background: #f3f4f6;
        color: #9ca3af;
        cursor: not-allowed;
    }

    .pagination span {
        color: #64748b;
        font-size: 17px;
        font-weight: 800;
    }

    .pagination strong {
        color: #64748b;
    }

    .view {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .empty {
        padding: 30px;
        text-align: center;
        border: 1px dashed #dbe3ef;
        border-radius: 14px;
    }

    .modal {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-box {
        background: white;
        padding: 25px;
        border-radius: 16px;
        width: 420px;
    }

    @@media(max-width: 768px) {
        .toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .search {
            width: 100%;
        }
    }
</style>
