@page "/doctor-leaves"


@using HealthApp.Shared.Dto
@using HealthApp.Admin.Services.Interface
@using Microsoft.AspNetCore.Components.Forms
@inject IDoctorLeaveService DoctorLeaveService

<PageTitle>Doctor Leave</PageTitle>

<div class="page">

    <div class="header">
        <div>
            <h2>Doctor Leave</h2>
            <p>View and manage doctor unavailability records</p>
        </div>

        <div class="summary-box">
            Total Records: <strong>@totalRecords</strong>
        </div>
    </div>

    <div class="toolbar">
        <div class="toolbar-left">

            <input class="input search" placeholder="Search by Doctor Name..." @bind="searchName"
                   @bind:event="oninput" />

            <InputDate class="input date-input" @bind-Value="searchDate" />

            <button class="btn primary" @onclick="ApplyFilters">
                Search
            </button>

        </div>

        <div class="toolbar-right">
            <button class="btn light" @onclick="ResetFilters">
                Reset
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="empty">
            Loading doctor leave records...
        </div>
    }
    else if (!filteredLeaves.Any())
    {
        <div class="empty">
            No doctor leave records found.
        </div>
    }
    else
    {
        <div class="card">
            <table class="table">

    <thead>
        <tr>
            <th class="col-id">ID</th>
            <th class="col-doctor">DOCTOR</th>
            <th class="col-date">START DATE</th>
            <th class="col-date">END DATE</th>
            <th class="col-reason">REASON</th>
            <th class="col-date">CREATED DATE</th>
            <th class="col-status">STATUS</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var leave in filteredLeaves)
        {
            <tr>

                <td>@leave.DoctorLeaveId</td>

                <td>
                    <div class="person-cell">
                        <div class="person-name">
                            @leave.DoctorName
                        </div>

                        <div class="person-id">
                            ID: @leave.DoctorId
                        </div>
                    </div>
                </td>

                <td>
                    @leave.StartDate.ToString("dd-MM-yyyy")
                </td>

                <td>
                    @leave.EndDate.ToString("dd-MM-yyyy")
                </td>

                <td class="reason-text">
                    @leave.Reason
                </td>

                <td>
                    @leave.CreatedDate.ToString("dd-MM-yyyy")
                </td>

                <td>
                    <span class="@GetStatusClass(leave)">
                        @GetLeaveStatus(leave)
                    </span>
                </td>

            </tr>
        }
    </tbody>

</table>
        </div>
    }

    <div class="pagination">
        <button class="btn light" disabled="@(pageNumber == 1)" @onclick="PreviousPage">
            Prev
        </button>

        <span>Page @pageNumber of @totalPages</span>

        <button class="btn light" disabled="@(pageNumber >= totalPages)" @onclick="NextPage">
            Next
        </button>
    </div>

</div>

@code {
    private List<DoctorLeaveDto> leaves = new();
    private List<DoctorLeaveDto> filteredLeaves = new();

    private string searchName = string.Empty;
    private DateTime? searchDate;

    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalRecords = 0;
    private int totalPages = 1;

    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaves();
    }

    private async Task LoadLeaves()
    {
        isLoading = true;

        var result = await DoctorLeaveService.GetAllDoctorLeavesAsync(
            pageNumber,
            pageSize);

        leaves = result.Data ?? new List<DoctorLeaveDto>();
        totalRecords = result.TotalRecords;

        totalPages = totalRecords <= 0
            ? 1
            : (int)Math.Ceiling(totalRecords / (double)pageSize);

        ApplyFilters();

        isLoading = false;
    }

    private void ApplyFilters()
    {
        IEnumerable<DoctorLeaveDto> query = leaves;

        if (!string.IsNullOrWhiteSpace(searchName))
        {
            query = query.Where(x =>
                !string.IsNullOrWhiteSpace(x.DoctorName) &&
                x.DoctorName.Contains(
                    searchName,
                    StringComparison.OrdinalIgnoreCase));
        }

        if (searchDate.HasValue)
        {
            var selectedDate = searchDate.Value.Date;

            query = query.Where(x =>
                x.StartDate.Date <= selectedDate &&
                x.EndDate.Date >= selectedDate);
        }

        filteredLeaves = query.ToList();
    }

    private async Task ResetFilters()
    {
        searchName = string.Empty;
        searchDate = null;
        pageNumber = 1;

        await LoadLeaves();
    }

    private async Task NextPage()
    {
        if (pageNumber < totalPages)
        {
            pageNumber++;
            await LoadLeaves();
        }
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadLeaves();
        }
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "D";
        }

        return name.Trim()[0].ToString().ToUpper();
    }

    private static string GetLeaveStatus(DoctorLeaveDto leave)
    {
        var today = DateTime.Today;

        if (leave.EndDate.Date < today)
        {
            return "Completed";
        }

        if (leave.StartDate.Date <= today &&
            leave.EndDate.Date >= today)
        {
            return "Active";
        }

        return "Upcoming";
    }

    private static string GetStatusClass(DoctorLeaveDto leave)
    {
        var status = GetLeaveStatus(leave);

        return status switch
        {
            "Active" => "status active",
            "Upcoming" => "status upcoming",
            "Completed" => "status completed",
            _ => "status"
        };
    }
}




<style>
