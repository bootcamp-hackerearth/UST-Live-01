@inherits LayoutComponentBase

@inject IJSRuntime Js
@inject NavigationManager NavigationManager

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">H</div>

            <div>
                <h2>HealthAxis</h2>
                <p>Admin Console</p>
            </div>
        </div>

        <div class="sidebar-user-card">
            <div class="sidebar-user-avatar">
                @userInitial
            </div>

            <div class="sidebar-user-info">
                <strong>@displayName</strong>
                <span>@userRole</span>
            </div>
        </div>

        <NavMenu />

        <div class="sidebar-footer">
            <span>Inspired by Elevance Health</span>
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-header admin-header-minimal">
            <h1 class="top-page-title">Dashboard</h1>

            <button class="logout-btn" @onclick="LogoutAsync">
                Logout
            </button>
        </header>

        <section class="admin-content">
            @Body
        </section>
    </main>
</div>

@code {
    private string displayName = "admin";
    private string userRole = "Admin";
    private string userInitial = "A";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        string? email =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_user_email");

        string? role =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_user_role");

        if (!string.IsNullOrWhiteSpace(email))
        {
            displayName = GetNameBeforeAt(email);
            userInitial = displayName[..1].ToUpperInvariant();
        }

        if (!string.IsNullOrWhiteSpace(role))
        {
            userRole = role;
        }

        StateHasChanged();
    }

    private static string GetNameBeforeAt(string email)
    {
        string namePart = email.Split('@')[0];

        if (string.IsNullOrWhiteSpace(namePart))
        {
            return "admin";
        }

        string firstName =
            namePart
                .Split('.', '_', '-')
                .FirstOrDefault() ?? namePart;

        return firstName;
    }

    private async Task LogoutAsync()
    {
        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_access_token");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_refresh_token");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_user_role");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_user_email");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_user_id");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_reference_id");

        NavigationManager.NavigateTo(
            "/login",
            replace: true);
    }
}
