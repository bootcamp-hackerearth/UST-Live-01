@page "/patients"

@using HealthAxis.API.DTOs.Auth
@using HealthAxis.API.DTOs.CommonDtos
@using HealthAxis.API.DTOs.Patients
@using HealthAxis.API.Enums
@using HealthAxis.Shared.DTOs.Auth
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime Js
@inject NavigationManager NavigationManager

<div class="page-title">
    <h2>Patient Management</h2>
    <p>View and update registered patient details.</p>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert-error">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert-success">@successMessage</div>
}

@if (isLoading)
{
    <div class="page-card">
        <p>Loading patients...</p>
    </div>
}
else
{
    <div class="page-card">
        @if (patients.Count == 0)
        {
            <p>No patients found.</p>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Patient ID</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (PatientReadDto patient in patients)
                    {
                        <tr>
                            <td>@patient.PatientId</td>
                            <td>@patient.FullName</td>
                            <td>@patient.Age</td>
                            <td>@patient.Gender</td>
                            <td>@patient.PhoneNumber</td>
                            <td>@patient.Email</td>
                            <td>@patient.CreatedDate.ToString("dd-MMM-yyyy")</td>
                            <td>
                                <button class="link-btn" @onclick="() => EditPatient(patient)">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pagination-wrapper">
                <div class="pagination-info">
                    Showing @StartItem - @EndItem of @totalCount patients
                </div>

                <div class="pagination-controls">
                    <button class="pagination-btn"
                            disabled="@(currentPage == 1)"
                            @onclick="PreviousPageAsync">
                        Previous
                    </button>

                    @for (int page = 1; page <= totalPages; page++)
                    {
                        int pageNumber = page;

                        <button class="pagination-btn @(currentPage == pageNumber ? "active" : "")"
                                @onclick="() => GoToPageAsync(pageNumber)">
                            @pageNumber
                        </button>
                    }

                    <button class="pagination-btn"
                            disabled="@(currentPage == totalPages)"
                            @onclick="NextPageAsync">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
}

@if (showEditForm)
{
    <div class="page-card">
        <h3>Edit Patient</h3>

        <EditForm Model="@patientForm" OnValidSubmit="SavePatientAsync">
            <DataAnnotationsValidator />

            <div class="form-grid">
                <div class="form-group">
                    <label>Full Name</label>
                    <InputText class="form-control" @bind-Value="patientForm.FullName" />
                    <ValidationMessage For="@(() => patientForm.FullName)" />
                </div>

                <div class="form-group">
                    <label>Date of Birth</label>
                    <InputDate class="form-control" @bind-Value="patientForm.DateOfBirth" />
                    <ValidationMessage For="@(() => patientForm.DateOfBirth)" />
                </div>

                <div class="form-group">
                    <label>Gender</label>
                    <InputSelect class="form-control" @bind-Value="patientForm.Gender">
                        @foreach (Gender gender in Enum.GetValues<Gender>())
                        {
                            <option value="@gender">@gender</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => patientForm.Gender)" />
                </div>

                <div class="form-group">
                    <label>Phone Number</label>
                    <InputText class="form-control" @bind-Value="patientForm.PhoneNumber" />
                    <ValidationMessage For="@(() => patientForm.PhoneNumber)" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <InputText class="form-control" @bind-Value="patientForm.Email" />
                    <ValidationMessage For="@(() => patientForm.Email)" />
                </div>
            </div>

            <div class="form-actions">
                <button class="primary-btn" type="submit" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>

                <button class="secondary-btn" type="button" @onclick="CancelPatientEdit">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    private const int PageSize = 5;

    private bool isLoading;
    private bool isSaving;
    private bool showEditForm;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private int editingPatientId;

    private int currentPage = 1;
    private int totalCount;
    private int totalPages = 1;

    private List<PatientReadDto> patients = new();
    private PatientUpdateDto patientForm = new();

    private readonly JsonSerializerOptions jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private int StartItem =>
        totalCount == 0
            ? 0
            : ((currentPage - 1) * PageSize) + 1;

    private int EndItem =>
        Math.Min(currentPage * PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        await LoadPatientsAsync();
    }

    private async Task LoadPatientsAsync()
    {
        isLoading = true;
        ClearMessages();

        try
        {
            PagedResultDto<PatientReadDto> result =
                await GetFromApiWithRefreshAsync<PagedResultDto<PatientReadDto>>(
                    $"api/admin/patients?pageNumber={currentPage}&pageSize={PageSize}");

            patients = result.Items;
            totalCount = result.TotalCount;
            totalPages = result.TotalPages == 0 ? 1 : result.TotalPages;

            if (currentPage > totalPages)
            {
                currentPage = totalPages;
                await LoadPatientsAsync();
            }
        }
        catch (UnauthorizedAccessException)
        {
            await ClearLoginDataAsync();
            NavigationManager.NavigateTo("/login", replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditPatient(PatientReadDto patient)
    {
        ClearMessages();

        showEditForm = true;
        editingPatientId = patient.PatientId;

        patientForm = new PatientUpdateDto
        {
            FullName = patient.FullName,
            DateOfBirth = patient.DateOfBirth,
            Gender = patient.Gender,
            PhoneNumber = patient.PhoneNumber,
            Email = patient.Email
        };
    }

    private async Task SavePatientAsync()
    {
        isSaving = true;
        ClearMessages();

        try
        {
            await PutToApiWithRefreshAsync<PatientUpdateDto, PatientReadDto>(
                $"api/admin/patients/{editingPatientId}",
                patientForm);

            successMessage = "Patient updated successfully.";

            CancelPatientEdit();

            await LoadPatientsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            await ClearLoginDataAsync();
            NavigationManager.NavigateTo("/login", replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;
        await LoadPatientsAsync();
    }

    private async Task NextPageAsync()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;
        await LoadPatientsAsync();
    }

    private async Task GoToPageAsync(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > totalPages || pageNumber == currentPage)
        {
            return;
        }

        currentPage = pageNumber;
        await LoadPatientsAsync();
    }

    private void CancelPatientEdit()
    {
        showEditForm = false;
        editingPatientId = 0;
        patientForm = new PatientUpdateDto();
    }

    private void ClearMessages()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task<T> GetFromApiWithRefreshAsync<T>(string url)
    {
        HttpResponseMessage response =
            await SendWithRefreshAsync(() => Http.GetAsync(url));

        return await ReadSuccessResponseAsync<T>(response);
    }

    private async Task<TResponse> PutToApiWithRefreshAsync<TRequest, TResponse>(
        string url,
        TRequest request)
    {
        HttpResponseMessage response =
            await SendWithRefreshAsync(() => Http.PutAsJsonAsync(url, request));

        return await ReadSuccessResponseAsync<TResponse>(response);
    }

    private async Task<HttpResponseMessage> SendWithRefreshAsync(
        Func<Task<HttpResponseMessage>> sendRequest)
    {
        await AddBearerTokenAsync();

        HttpResponseMessage response = await sendRequest();

        if (response.StatusCode != HttpStatusCode.Unauthorized)
        {
            return response;
        }

        response.Dispose();

        bool refreshSucceeded = await RefreshAccessTokenAsync();

        if (!refreshSucceeded)
        {
            throw new UnauthorizedAccessException("Session expired. Please login again.");
        }

        await AddBearerTokenAsync();

        return await sendRequest();
    }

    private async Task<T> ReadSuccessResponseAsync<T>(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            string message = await GetErrorMessageAsync(response);
            throw new InvalidOperationException(message);
        }

        T? result = await response.Content.ReadFromJsonAsync<T>(jsonOptions);

        return result
            ?? throw new InvalidOperationException("Invalid response received from server.");
    }

    private async Task AddBearerTokenAsync()
    {
        string? accessToken =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_access_token");

        if (string.IsNullOrWhiteSpace(accessToken))
        {
            throw new UnauthorizedAccessException("Login token was not found. Please login again.");
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", accessToken);
    }

    private async Task<bool> RefreshAccessTokenAsync()
    {
        string? userId =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_user_id");

        string? refreshToken =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_refresh_token");

        if (string.IsNullOrWhiteSpace(userId) ||
            string.IsNullOrWhiteSpace(refreshToken))
        {
            await ClearLoginDataAsync();
            return false;
        }

        RefreshTokenDto request = new()
        {
            UserId = userId,
            RefreshToken = refreshToken
        };

        Http.DefaultRequestHeaders.Authorization = null;

        HttpResponseMessage response =
            await Http.PostAsJsonAsync("api/auth/refresh-token", request);

        if (!response.IsSuccessStatusCode)
        {
            await ClearLoginDataAsync();
            return false;
        }

        AuthResponseDto? authResponse =
            await response.Content.ReadFromJsonAsync<AuthResponseDto>(jsonOptions);

        if (authResponse == null ||
            string.IsNullOrWhiteSpace(authResponse.AccessToken) ||
            string.IsNullOrWhiteSpace(authResponse.RefreshToken))
        {
            await ClearLoginDataAsync();
            return false;
        }

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_access_token",
            authResponse.AccessToken);

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_refresh_token",
            authResponse.RefreshToken);

        return true;
    }

    private async Task<string> GetErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            ErrorResponseDto? error =
                await response.Content.ReadFromJsonAsync<ErrorResponseDto>(jsonOptions);

            if (!string.IsNullOrWhiteSpace(error?.Message))
            {
                return error.Message;
            }
        }
        catch
        {
            // Ignore parsing issue and return generic message below.
        }

        return $"Request failed with status code {(int)response.StatusCode}.";
    }

    private async Task ClearLoginDataAsync()
    {
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_access_token");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_refresh_token");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_role");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_email");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_id");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_reference_id");
    }
}
