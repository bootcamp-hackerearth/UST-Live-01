@page "/"
@page "/login"
@layout HealthAxis.Admin.Layout.EmptyLayout


@inject HttpClient Http
@inject IJSRuntime Js
@inject NavigationManager NavigationManager

<div class="health-login-page">
    <section class="health-login-left">
        <div class="login-brand-row">
            <div class="login-brand-symbol">H</div>

            <div>
                <h1>HealthAxis</h1>
                <p>Healthcare Management Platform</p>
            </div>
        </div>

        <div class="login-hero-content">
            <span class="login-eyebrow">Admin Console</span>

            <h2>Secure operations for smarter healthcare administration.</h2>

            <p>
                Manage doctors, patients, appointments, and operational reporting
                from one protected administration workspace.
            </p>

            <div class="login-feature-list">
                <div class="login-feature-item">
                    <span>✓</span>
                    <div>
                        <strong>Role-secured access</strong>
                        <p>Admin-only portal protected using JWT authentication.</p>
                    </div>
                </div>

                <div class="login-feature-item">
                    <span>✓</span>
                    <div>
                        <strong>Clinical operations view</strong>
                        <p>Monitor doctors, patients, and appointment reports.</p>
                    </div>
                </div>

                <div class="login-feature-item">
                    <span>✓</span>
                    <div>
                        <strong>Whole-health administration</strong>
                        <p>Designed for streamlined healthcare workflows.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="login-left-footer">
            <span>HealthAxis Admin Portal</span>
            <span>Secure access required</span>
        </div>
    </section>

    <section class="health-login-right">
        <div class="login-card-pro">
            <div class="login-card-header">
                <div class="login-card-icon">🔐</div>

                <div>
                    <h2>Welcome back</h2>
                    <p>Sign in with your administrator credentials.</p>
                </div>
            </div>

            <EditForm Model="@loginRequest" OnValidSubmit="HandleLoginAsync">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>Email address</label>

                    <div class="input-shell">
                        <span class="input-icon">✉</span>

                        <InputText class="form-control login-input"
                                   placeholder="admin@healthaxis.com"
                                   @bind-Value="loginRequest.Email" />
                    </div>

                    <ValidationMessage For="@(() => loginRequest.Email)" />
                </div>

                <div class="form-group">
                    <label>Password</label>

                    <div class="input-shell">
                        <span class="input-icon">●</span>

                        <InputText type="@passwordInputType"
                                   class="form-control login-input"
                                   placeholder="Enter your password"
                                   @bind-Value="loginRequest.Password" />

                        <button type="button"
                                class="password-toggle"
                                @onclick="TogglePasswordVisibility">
                            @(showPassword ? "Hide" : "Show")
                        </button>
                    </div>

                    <ValidationMessage For="@(() => loginRequest.Password)" />
                </div>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert-error login-alert">
                        @errorMessage
                    </div>
                }

                <button class="primary-btn login-submit-btn"
                        type="submit"
                        disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="button-spinner"></span>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign in securely</span>
                    }
                </button>
            </EditForm>

            <div class="login-security-note">
                <span>ⓘ</span>

                <p>
                    Access is restricted to authorized administrators. All actions are protected
                    by role-based security.
                </p>
            </div>
        </div>

        <p class="login-page-footer">
            © @DateTime.Now.Year HealthAxis. Healthcare administration workspace.
        </p>
    </section>
</div>

@code {
    private LoginDto loginRequest = new();

    private string errorMessage = string.Empty;

    private bool isLoading;

    private bool showPassword;

    private readonly JsonSerializerOptions jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private string passwordInputType =>
        showPassword ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLoginAsync()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            HttpResponseMessage response =
                await Http.PostAsJsonAsync(
                    "api/auth/login",
                    loginRequest);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    await GetErrorMessageAsync(response);

                return;
            }

            AuthResponseDto? authResponse =
                await response.Content.ReadFromJsonAsync<AuthResponseDto>(
                    jsonOptions);

            if (authResponse == null ||
                string.IsNullOrWhiteSpace(authResponse.AccessToken))
            {
                errorMessage = "Invalid login response received from server.";
                return;
            }

            if (!string.Equals(
                    authResponse.Role,
                    "Admin",
                    StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "Only Admin users can access this portal.";
                return;
            }

            await SaveLoginDataAsync(authResponse);

            Console.WriteLine("Admin logged in successfully.");

            NavigationManager.NavigateTo(
                "/dashboard",
                replace: true);
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Unable to connect to the API. Please make sure the backend is running.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveLoginDataAsync(
        AuthResponseDto authResponse)
    {
        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_access_token",
            authResponse.AccessToken);

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_refresh_token",
            authResponse.RefreshToken);

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_user_role",
            authResponse.Role);

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_user_email",
            authResponse.Email);

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_user_id",
            authResponse.UserId);

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_reference_id",
            authResponse.ReferenceId.ToString());
    }

    private async Task<string> GetErrorMessageAsync(
        HttpResponseMessage response)
    {
        try
        {
            ErrorResponseDto? error =
                await response.Content.ReadFromJsonAsync<ErrorResponseDto>(
                    jsonOptions);

            if (!string.IsNullOrWhiteSpace(error?.Message))
            {
                return error.Message;
            }
        }
        catch
        {
            // If backend error response is not in expected format,
            // return generic message below.
        }

        return $"Login failed with status code {(int)response.StatusCode}.";
    }
}