@page "/appointment-reports/details/{ReportDate}"

@using HealthAxis.API.DTOs.Appointments
@using HealthAxis.API.DTOs.Auth
@using HealthAxis.API.DTOs.CommonDtos
@using HealthAxis.API.Enums
@using HealthAxis.Shared.DTOs.Auth
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime Js
@inject NavigationManager NavigationManager

<div class="page-title-row">
    <div>
        <h2>Appointment Details</h2>
        <p>Appointments for @SelectedDate.ToString("dd-MMM-yyyy")</p>
    </div>

    <button class="secondary-btn" @onclick="BackToReports">
        Back to Reports
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert-error">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert-success">@successMessage</div>
}

@if (isLoading)
{
    <div class="page-card">
        <p>Loading appointment details...</p>
    </div>
}
else
{
    <div class="page-card">
        @if (appointmentDetails.Count == 0)
        {
            <div class="clean-empty-state compact-empty-state">
                <strong>No appointments found</strong>
                <span>No appointments are available for this date.</span>
            </div>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Appointment ID</th>
                        <th>Time Slot</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Status</th>
                        <th>Cancellation Reason</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (AppointmentDetailDto appointment in appointmentDetails)
                    {
                        <tr>
                            <td>@appointment.AppointmentId</td>
                            <td>@appointment.TimeSlot</td>
                            <td>@appointment.PatientName</td>
                            <td>@appointment.DoctorName</td>
                            <td>
                                <span class="status-badge @GetStatusClass(appointment.Status)">
                                    @appointment.Status
                                </span>
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(appointment.CancellationReason)
                                    ? "-"
                                    : appointment.CancellationReason)
                            </td>
                            <td>
                                @if (appointment.Status == AppointmentStatus.Scheduled)
                                {
                                    <button class="link-btn"
                                            disabled="@isActionInProgress"
                                            @onclick="() => ConfirmAppointmentAsync(appointment.AppointmentId)">
                                        Confirm
                                    </button>

                                    <button class="link-btn danger-link-btn"
                                            disabled="@isActionInProgress"
                                            @onclick="() => ShowCancelBox(appointment.AppointmentId)">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <span class="muted-action-text">No action</span>
                                }
                            </td>
                        </tr>

                        @if (cancelAppointmentId == appointment.AppointmentId)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="cancel-reason-box">
                                        <label>Cancellation Reason</label>

                                        <InputText class="form-control"
                                                   @bind-Value="cancellationReason"
                                                   placeholder="Enter reason for cancellation" />

                                        <div class="form-actions">
                                            <button class="primary-btn"
                                                    disabled="@isActionInProgress"
                                                    @onclick="() => CancelAppointmentAsync(appointment.AppointmentId)">
                                                Submit Cancellation
                                            </button>

                                            <button class="secondary-btn"
                                                    disabled="@isActionInProgress"
                                                    @onclick="HideCancelBox">
                                                Close
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [Parameter]
    public string ReportDate { get; set; } = string.Empty;

    private bool isLoading;
    private bool isActionInProgress;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private int? cancelAppointmentId;
    private string cancellationReason = string.Empty;

    private List<AppointmentDetailDto> appointmentDetails = new();

    private readonly JsonSerializerOptions jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private DateTime SelectedDate =>
        DateTime.TryParse(ReportDate, out DateTime parsedDate)
            ? parsedDate
            : DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointmentDetailsAsync();
    }

    private async Task LoadAppointmentDetailsAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            appointmentDetails =
                await GetFromApiWithRefreshAsync<List<AppointmentDetailDto>>(
                    $"api/admin/reports/appointments/details?date={SelectedDate:yyyy-MM-dd}");
        }
        catch (UnauthorizedAccessException)
        {
            await ClearLoginDataAsync();

            NavigationManager.NavigateTo(
                "login",
                replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmAppointmentAsync(int appointmentId)
    {
        isActionInProgress = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            await PutToApiWithRefreshAsync<object, AppointmentDetailDto>(
                $"api/admin/appointments/{appointmentId}/confirm",
                new { });

            successMessage = "Appointment confirmed successfully.";

            await LoadAppointmentDetailsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private void ShowCancelBox(int appointmentId)
    {
        cancelAppointmentId = appointmentId;
        cancellationReason = string.Empty;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void HideCancelBox()
    {
        cancelAppointmentId = null;
        cancellationReason = string.Empty;
    }

    private async Task CancelAppointmentAsync(int appointmentId)
    {
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            errorMessage = "Cancellation reason is required.";
            return;
        }

        isActionInProgress = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            CancelAppointmentDto request = new()
            {
                CancellationReason = cancellationReason
            };

            await PutToApiWithRefreshAsync<CancelAppointmentDto, AppointmentDetailDto>(
                $"api/admin/appointments/{appointmentId}/cancel",
                request);

            successMessage = "Appointment cancelled successfully.";

            HideCancelBox();

            await LoadAppointmentDetailsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isActionInProgress = false;
        }
    }

    private void BackToReports()
    {
        NavigationManager.NavigateTo("appointment-reports");
    }

    private static string GetStatusClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Completed => "status-active",
            AppointmentStatus.Confirmed => "status-active",
            AppointmentStatus.Cancelled => "status-inactive",
            AppointmentStatus.Scheduled => "status-scheduled",
            _ => "status-active"
        };
    }

    private async Task<T> GetFromApiWithRefreshAsync<T>(
        string url)
    {
        HttpResponseMessage response =
            await SendWithRefreshAsync(() =>
                Http.GetAsync(url));

        return await ReadSuccessResponseAsync<T>(response);
    }

    private async Task<TResponse> PutToApiWithRefreshAsync<TRequest, TResponse>(
        string url,
        TRequest request)
    {
        HttpResponseMessage response =
            await SendWithRefreshAsync(() =>
                Http.PutAsJsonAsync(url, request));

        return await ReadSuccessResponseAsync<TResponse>(response);
    }

    private async Task<HttpResponseMessage> SendWithRefreshAsync(
        Func<Task<HttpResponseMessage>> sendRequest)
    {
        await AddBearerTokenAsync();

        HttpResponseMessage response =
            await sendRequest();

        if (response.StatusCode != HttpStatusCode.Unauthorized)
        {
            return response;
        }

        response.Dispose();

        bool refreshSucceeded =
            await RefreshAccessTokenAsync();

        if (!refreshSucceeded)
        {
            throw new UnauthorizedAccessException(
                "Session expired. Please login again.");
        }

        await AddBearerTokenAsync();

        return await sendRequest();
    }

    private async Task<T> ReadSuccessResponseAsync<T>(
        HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            string message =
                await GetErrorMessageAsync(response);

            throw new InvalidOperationException(message);
        }

        T? result =
            await response.Content.ReadFromJsonAsync<T>(
                jsonOptions);

        return result
            ?? throw new InvalidOperationException(
                "Invalid response received from server.");
    }

    private async Task AddBearerTokenAsync()
    {
        string? accessToken =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_access_token");

        if (string.IsNullOrWhiteSpace(accessToken))
        {
            throw new UnauthorizedAccessException(
                "Login token was not found. Please login again.");
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue(
                "Bearer",
                accessToken);
    }

    private async Task<bool> RefreshAccessTokenAsync()
    {
        string? userId =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_user_id");

        string? refreshToken =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_refresh_token");

        if (string.IsNullOrWhiteSpace(userId) ||
            string.IsNullOrWhiteSpace(refreshToken))
        {
            await ClearLoginDataAsync();

            return false;
        }

        RefreshTokenDto request = new()
        {
            UserId = userId,
            RefreshToken = refreshToken
        };

        Http.DefaultRequestHeaders.Authorization = null;

        HttpResponseMessage response =
            await Http.PostAsJsonAsync(
                "api/auth/refresh-token",
                request);

        if (!response.IsSuccessStatusCode)
        {
            await ClearLoginDataAsync();

            return false;
        }

        AuthResponseDto? authResponse =
            await response.Content.ReadFromJsonAsync<AuthResponseDto>(
                jsonOptions);

        if (authResponse == null ||
            string.IsNullOrWhiteSpace(authResponse.AccessToken) ||
            string.IsNullOrWhiteSpace(authResponse.RefreshToken))
        {
            await ClearLoginDataAsync();

            return false;
        }

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_access_token",
            authResponse.AccessToken);

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_refresh_token",
            authResponse.RefreshToken);

        return true;
    }

    private async Task<string> GetErrorMessageAsync(
        HttpResponseMessage response)
    {
        try
        {
            ErrorResponseDto? error =
                await response.Content.ReadFromJsonAsync<ErrorResponseDto>(
                    jsonOptions);

            if (!string.IsNullOrWhiteSpace(error?.Message))
            {
                return error.Message;
            }
        }
        catch
        {
            // Ignore parsing issue and return generic message below.
        }

        return $"Request failed with status code {(int)response.StatusCode}.";
    }

    private async Task ClearLoginDataAsync()
    {
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_access_token");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_refresh_token");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_role");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_email");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_id");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_reference_id");
    }
}
