@page "/doctors"

@inject HttpClient Http
@inject IJSRuntime Js
@inject NavigationManager NavigationManager

<div class="page-title-row">
    <div>
        <h2>Doctor Management</h2>
        <p>Add, edit, activate, deactivate, search, or filter doctors.</p>
    </div>

    <button class="primary-btn" @onclick="ShowAddForm">
        Add Doctor
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert-error">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert-success">@successMessage</div>
}

<div class="page-card doctor-search-card">
    <div class="doctor-filter-wrapper">
        <div class="doctor-search-box">
            <span>⌕</span>
            <input placeholder="Search doctor by name or ID"
                   value="@searchText"
                   @oninput="OnSearchInputChanged"
                   @onkeyup="HandleSearchKeyUp" />
        </div>

        <div class="doctor-filter-select">
            <select class="form-control"
                    value="@selectedSpecialisation"
                    @onchange="OnSpecialisationChanged">
                <option value="">All specialisations</option>

                @foreach (Specialisation item in Enum.GetValues<Specialisation>())
                {
                    <option value="@((int)item)">
                        @item
                    </option>
                }
            </select>
        </div>

        <button class="primary-btn" @onclick="ApplyFiltersAsync">
            Search
        </button>

        @if (!string.IsNullOrWhiteSpace(appliedSearchText) ||
             !string.IsNullOrWhiteSpace(appliedSpecialisation))
        {
            <button class="secondary-btn" @onclick="ClearFiltersAsync">
                Clear
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(appliedSearchText) ||
         !string.IsNullOrWhiteSpace(appliedSpecialisation))
    {
        <p class="search-result-text">
            Showing results
            @if (!string.IsNullOrWhiteSpace(appliedSearchText))
            {
                <span>
                    for <strong>@appliedSearchText</strong>
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(appliedSpecialisation))
            {
                <span>
                    in <strong>@GetSpecialisationName(appliedSpecialisation)</strong>
                </span>
            }
        </p>
    }
</div>

@if (isLoading)
{
    <div class="page-card">
        <p>Loading doctors...</p>
    </div>
}
else
{
    @if (showForm)
    {
        <div class="page-card">
            <h3>@(isEditMode ? "Edit Doctor" : "Add Doctor")</h3>

            @if (isEditMode)
            {
                <EditForm Model="@editForm" OnValidSubmit="UpdateDoctorAsync">
                    <DataAnnotationsValidator />

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Full Name</label>
                            <InputText class="form-control" @bind-Value="editForm.FullName" />
                            <ValidationMessage For="@(() => editForm.FullName)" />
                        </div>

                        <div class="form-group">
                            <label>Specialisation</label>
                            <InputSelect class="form-control" @bind-Value="editForm.Specialisation">
                                @foreach (Specialisation item in Enum.GetValues<Specialisation>())
                                {
                                    <option value="@item">@item</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => editForm.Specialisation)" />
                        </div>

                        <div class="form-group">
                            <label>Years of Experience</label>
                            <InputNumber class="form-control" @bind-Value="editForm.YearsOfExperience" />
                            <ValidationMessage For="@(() => editForm.YearsOfExperience)" />
                        </div>

                        <div class="form-group">
                            <label>Consultation Fee</label>
                            <InputNumber class="form-control" @bind-Value="editForm.ConsultationFee" />
                            <ValidationMessage For="@(() => editForm.ConsultationFee)" />
                        </div>

                        <div class="form-group checkbox-group">
                            <label>
                                <InputCheckbox @bind-Value="editForm.IsActive" />
                                Active
                            </label>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button class="primary-btn" type="submit" disabled="@isSaving">
                            @(isSaving ? "Saving..." : "Save")
                        </button>

                        <button class="secondary-btn" type="button" @onclick="CancelForm">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="@createForm" OnValidSubmit="CreateDoctorAsync">
                    <DataAnnotationsValidator />

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Full Name</label>
                            <InputText class="form-control" @bind-Value="createForm.FullName" />
                            <ValidationMessage For="@(() => createForm.FullName)" />
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <InputText class="form-control" @bind-Value="createForm.Email" />
                            <ValidationMessage For="@(() => createForm.Email)" />
                        </div>

                        <div class="form-group">
                            <label>Password</label>
                            <InputText type="password" class="form-control" @bind-Value="createForm.Password" />
                            <ValidationMessage For="@(() => createForm.Password)" />
                        </div>

                        <div class="form-group">
                            <label>Confirm Password</label>
                            <InputText type="password" class="form-control" @bind-Value="createForm.ConfirmPassword" />
                            <ValidationMessage For="@(() => createForm.ConfirmPassword)" />
                        </div>

                        <div class="form-group">
                            <label>Specialisation</label>
                            <InputSelect class="form-control" @bind-Value="createForm.Specialisation">
                                @foreach (Specialisation item in Enum.GetValues<Specialisation>())
                                {
                                    <option value="@item">@item</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => createForm.Specialisation)" />
                        </div>

                        <div class="form-group">
                            <label>Years of Experience</label>
                            <InputNumber class="form-control" @bind-Value="createForm.YearsOfExperience" />
                            <ValidationMessage For="@(() => createForm.YearsOfExperience)" />
                        </div>

                        <div class="form-group">
                            <label>Consultation Fee</label>
                            <InputNumber class="form-control" @bind-Value="createForm.ConsultationFee" />
                            <ValidationMessage For="@(() => createForm.ConsultationFee)" />
                        </div>

                        <div class="form-group checkbox-group">
                            <label>
                                <InputCheckbox @bind-Value="createForm.IsActive" />
                                Active
                            </label>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button class="primary-btn" type="submit" disabled="@isSaving">
                            @(isSaving ? "Saving..." : "Save")
                        </button>

                        <button class="secondary-btn" type="button" @onclick="CancelForm">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    }

    <div class="page-card">
        @if (doctors.Count == 0)
        {
            <p>No doctors found.</p>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Doctor ID</th>
                        <th>Name</th>
                        <th>Specialisation</th>
                        <th>Experience</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (DoctorReadDto doctor in doctors)
                    {
                        <tr>
                            <td>@doctor.DoctorId</td>
                            <td>@doctor.FullName</td>
                            <td>@doctor.Specialisation</td>
                            <td>@doctor.YearsOfExperience years</td>
                            <td>@doctor.ConsultationFee.ToString("C", new CultureInfo("en-IN"))</td>
                            <td>
                                <span class="status-badge @(doctor.IsActive ? "status-active" : "status-inactive")">
                                    @(doctor.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <button class="link-btn" @onclick="() => EditDoctor(doctor)">
                                    Edit
                                </button>

                                <button class="link-btn" @onclick="() => ToggleDoctorAsync(doctor)">
                                    @(doctor.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pagination-wrapper">
                <div class="pagination-info">
                    Showing @StartItem - @EndItem of @totalCount doctors
                </div>

                <div class="pagination-controls">
                    <button class="pagination-btn"
                            disabled="@(currentPage == 1)"
                            @onclick="PreviousPageAsync">
                        Previous
                    </button>

                    @for (int page = 1; page <= totalPages; page++)
                    {
                        int pageNumber = page;

                        <button class="pagination-btn @(currentPage == pageNumber ? "active" : "")"
                                @onclick="() => GoToPageAsync(pageNumber)">
                            @pageNumber
                        </button>
                    }

                    <button class="pagination-btn"
                            disabled="@(currentPage == totalPages)"
                            @onclick="NextPageAsync">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private const int PageSize = 5;

    private bool isLoading;
    private bool isSaving;
    private bool showForm;
    private bool isEditMode;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private string searchText = string.Empty;
    private string appliedSearchText = string.Empty;
    private string selectedSpecialisation = string.Empty;
    private string appliedSpecialisation = string.Empty;

    private int editingDoctorId;

    private int currentPage = 1;
    private int totalCount;
    private int totalPages = 1;

    private List<DoctorReadDto> doctors = new();

    private AdminDoctorCreateDto createForm = new();
    private DoctorUpdateDto editForm = new();

    private readonly JsonSerializerOptions jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private int StartItem =>
        totalCount == 0
            ? 0
            : ((currentPage - 1) * PageSize) + 1;

    private int EndItem =>
        Math.Min(currentPage * PageSize, totalCount);

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
    }

    private async Task LoadDoctorsAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            string url =
                $"api/admin/doctors?pageNumber={currentPage}&pageSize={PageSize}";

            if (!string.IsNullOrWhiteSpace(appliedSearchText))
            {
                url += $"&searchTerm={Uri.EscapeDataString(appliedSearchText)}";
            }

            if (!string.IsNullOrWhiteSpace(appliedSpecialisation))
            {
                url += $"&specialisation={appliedSpecialisation}";
            }

            PagedResultDto<DoctorReadDto> result =
                await GetFromApiWithRefreshAsync<PagedResultDto<DoctorReadDto>>(url);

            doctors = result.Items;
            totalCount = result.TotalCount;
            totalPages = result.TotalPages == 0 ? 1 : result.TotalPages;

            if (currentPage > totalPages)
            {
                currentPage = totalPages;
                await LoadDoctorsAsync();
            }
        }
        catch (UnauthorizedAccessException)
        {
            await ClearLoginDataAsync();

            NavigationManager.NavigateTo(
                "/login",
                replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchInputChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
    }

    private void OnSpecialisationChanged(ChangeEventArgs e)
    {
        selectedSpecialisation = e.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFiltersAsync();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        appliedSearchText = searchText.Trim();
        appliedSpecialisation = selectedSpecialisation;
        currentPage = 1;
        showForm = false;

        await LoadDoctorsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        searchText = string.Empty;
        appliedSearchText = string.Empty;
        selectedSpecialisation = string.Empty;
        appliedSpecialisation = string.Empty;
        currentPage = 1;
        showForm = false;

        await LoadDoctorsAsync();
    }

    private static string GetSpecialisationName(string value)
    {
        if (int.TryParse(value, out int specialisationValue) &&
            Enum.IsDefined(typeof(Specialisation), specialisationValue))
        {
            return ((Specialisation)specialisationValue).ToString();
        }

        return "All specialisations";
    }

    private void ShowAddForm()
    {
        ClearMessages();

        isEditMode = false;
        showForm = true;
        editingDoctorId = 0;

        createForm = new AdminDoctorCreateDto
        {
            IsActive = true,
            Specialisation = Specialisation.Cardiology
        };

        editForm = new DoctorUpdateDto();
    }

    private void EditDoctor(DoctorReadDto doctor)
    {
        ClearMessages();

        isEditMode = true;
        showForm = true;
        editingDoctorId = doctor.DoctorId;

        editForm = new DoctorUpdateDto
        {
            FullName = doctor.FullName,
            Specialisation = doctor.Specialisation,
            YearsOfExperience = doctor.YearsOfExperience,
            ConsultationFee = doctor.ConsultationFee,
            IsActive = doctor.IsActive
        };
    }

    private async Task CreateDoctorAsync()
    {
        isSaving = true;
        ClearMessages();

        try
        {
            await PostToApiWithRefreshAsync<AdminDoctorCreateDto, DoctorReadDto>(
                "api/admin/doctors",
                createForm);

            successMessage = "Doctor created successfully.";

            CancelForm();

            currentPage = 1;

            await LoadDoctorsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            await ClearLoginDataAsync();

            NavigationManager.NavigateTo(
                "/login",
                replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateDoctorAsync()
    {
        isSaving = true;
        ClearMessages();

        try
        {
            await PutToApiWithRefreshAsync<DoctorUpdateDto, DoctorReadDto>(
                $"api/admin/doctors/{editingDoctorId}",
                editForm);

            successMessage = "Doctor updated successfully.";

            CancelForm();

            await LoadDoctorsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            await ClearLoginDataAsync();

            NavigationManager.NavigateTo(
                "/login",
                replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleDoctorAsync(DoctorReadDto doctor)
    {
        ClearMessages();

        try
        {
            DoctorUpdateDto request = new()
            {
                FullName = doctor.FullName,
                Specialisation = doctor.Specialisation,
                YearsOfExperience = doctor.YearsOfExperience,
                ConsultationFee = doctor.ConsultationFee,
                IsActive = !doctor.IsActive
            };

            await PutToApiWithRefreshAsync<DoctorUpdateDto, DoctorReadDto>(
                $"api/admin/doctors/{doctor.DoctorId}",
                request);

            successMessage = request.IsActive
                ? "Doctor activated successfully."
                : "Doctor deactivated successfully.";

            await LoadDoctorsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            await ClearLoginDataAsync();

            NavigationManager.NavigateTo(
                "/login",
                replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;

        await LoadDoctorsAsync();
    }

    private async Task NextPageAsync()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;

        await LoadDoctorsAsync();
    }

    private async Task GoToPageAsync(int pageNumber)
    {
        if (pageNumber < 1 ||
            pageNumber > totalPages ||
            pageNumber == currentPage)
        {
            return;
        }

        currentPage = pageNumber;

        await LoadDoctorsAsync();
    }

    private void CancelForm()
    {
        showForm = false;
        isEditMode = false;
        editingDoctorId = 0;

        createForm = new AdminDoctorCreateDto();
        editForm = new DoctorUpdateDto();
    }

    private void ClearMessages()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task<T> GetFromApiWithRefreshAsync<T>(
        string url)
    {
        HttpResponseMessage response =
            await SendWithRefreshAsync(() =>
                Http.GetAsync(url));

        return await ReadSuccessResponseAsync<T>(response);
    }

    private async Task<TResponse> PostToApiWithRefreshAsync<TRequest, TResponse>(
        string url,
        TRequest request)
    {
        HttpResponseMessage response =
            await SendWithRefreshAsync(() =>
                Http.PostAsJsonAsync(url, request));

        return await ReadSuccessResponseAsync<TResponse>(response);
    }

    private async Task<TResponse> PutToApiWithRefreshAsync<TRequest, TResponse>(
        string url,
        TRequest request)
    {
        HttpResponseMessage response =
            await SendWithRefreshAsync(() =>
                Http.PutAsJsonAsync(url, request));

        return await ReadSuccessResponseAsync<TResponse>(response);
    }

    private async Task<HttpResponseMessage> SendWithRefreshAsync(
        Func<Task<HttpResponseMessage>> sendRequest)
    {
        await AddBearerTokenAsync();

        HttpResponseMessage response =
            await sendRequest();

        if (response.StatusCode != HttpStatusCode.Unauthorized)
        {
            return response;
        }

        response.Dispose();

        bool refreshSucceeded =
            await RefreshAccessTokenAsync();

        if (!refreshSucceeded)
        {
            throw new UnauthorizedAccessException(
                "Session expired. Please login again.");
        }

        await AddBearerTokenAsync();

        return await sendRequest();
    }

    private async Task<T> ReadSuccessResponseAsync<T>(
        HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            string message =
                await GetErrorMessageAsync(response);

            throw new InvalidOperationException(message);
        }

        T? result =
            await response.Content.ReadFromJsonAsync<T>(
                jsonOptions);

        return result
            ?? throw new InvalidOperationException(
                "Invalid response received from server.");
    }

    private async Task AddBearerTokenAsync()
    {
        string? accessToken =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_access_token");

        if (string.IsNullOrWhiteSpace(accessToken))
        {
            throw new UnauthorizedAccessException(
                "Login token was not found. Please login again.");
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue(
                "Bearer",
                accessToken);
    }

    private async Task<bool> RefreshAccessTokenAsync()
    {
        string? userId =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_user_id");

        string? refreshToken =
            await Js.InvokeAsync<string?>(
                "localStorage.getItem",
                "healthaxis_refresh_token");

        if (string.IsNullOrWhiteSpace(userId) ||
            string.IsNullOrWhiteSpace(refreshToken))
        {
            await ClearLoginDataAsync();

            return false;
        }

        RefreshTokenDto request = new()
        {
            UserId = userId,
            RefreshToken = refreshToken
        };

        Http.DefaultRequestHeaders.Authorization = null;

        HttpResponseMessage response =
            await Http.PostAsJsonAsync(
                "api/auth/refresh-token",
                request);

        if (!response.IsSuccessStatusCode)
        {
            await ClearLoginDataAsync();

            return false;
        }

        AuthResponseDto? authResponse =
            await response.Content.ReadFromJsonAsync<AuthResponseDto>(
                jsonOptions);

        if (authResponse == null ||
            string.IsNullOrWhiteSpace(authResponse.AccessToken) ||
            string.IsNullOrWhiteSpace(authResponse.RefreshToken))
        {
            await ClearLoginDataAsync();

            return false;
        }

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_access_token",
            authResponse.AccessToken);

        await Js.InvokeVoidAsync(
            "localStorage.setItem",
            "healthaxis_refresh_token",
            authResponse.RefreshToken);

        return true;
    }

    private async Task<string> GetErrorMessageAsync(
        HttpResponseMessage response)
    {
        try
        {
            ErrorResponseDto? error =
                await response.Content.ReadFromJsonAsync<ErrorResponseDto>(
                    jsonOptions);

            if (!string.IsNullOrWhiteSpace(error?.Message))
            {
                return error.Message;
            }
        }
        catch
        {
            // Ignore parsing issue and return generic message below.
        }

        return $"Request failed with status code {(int)response.StatusCode}.";
    }

    private async Task ClearLoginDataAsync()
    {
        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_access_token");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_refresh_token");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_user_role");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_user_email");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_user_id");

        await Js.InvokeVoidAsync(
            "localStorage.removeItem",
            "healthaxis_reference_id");
    }
}
