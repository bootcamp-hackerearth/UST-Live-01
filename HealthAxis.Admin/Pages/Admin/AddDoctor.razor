@page "/admin/doctors/add"
@layout AdminLayout

@using HealthAxis.Admin.Layout
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using HealthAxis.Shared.Dtos.Doctors
@using HealthAxis.Shared.Enums
@using HealthAxis.Admin.Services.Interfaces

@inject IAuthService AuthService
@inject IDoctorAdminService DoctorService
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Add Doctor | HealthAxis Admin</PageTitle>

<div class="hc-form-shell">

    <div class="hc-page-heading">
        <div>
            <h1>Add Doctor</h1>
            <p>Register a new doctor profile for HealthAxis.</p>
        </div>

        <button class="hc-secondary-btn" @onclick="BackToDoctors">
            Back to Doctors
        </button>
    </div>

    <div class="hc-form-card">

        <div class="hc-form-card-header">
            <div>
                <h3>Doctor Registration</h3>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="hc-alert-error">
                @errorMessage
            </div>
        }

        @if (editContext is not null)
        {
            <EditForm EditContext="editContext" OnValidSubmit="SaveDoctor">
                <DataAnnotationsValidator />

                <div class="hc-form-grid">

                    <div class="hc-form-group">
                        <label class="hc-form-label">Full Name</label>

                        <InputText class="hc-form-control"
                                   placeholder="Enter doctor full name"
                                   disabled="@(isSaving || createdDoctor is not null)"
                                   @bind-Value="doctor.FullName" />

                        <ValidationMessage For="@(() => doctor.FullName)" />
                    </div>

                    <div class="hc-form-group">
                        <label class="hc-form-label">Email Address</label>

                        <InputText class="hc-form-control"
                                   placeholder="doctor@example.com"
                                   disabled="@(isSaving || createdDoctor is not null)"
                                   @bind-Value="doctor.Email" />

                        <ValidationMessage For="@(() => doctor.Email)" />
                    </div>

                    <div class="hc-form-group">
                        <label class="hc-form-label">Specialisation</label>

                        <InputSelect class="hc-form-control"
                                     disabled="@(isSaving || createdDoctor is not null)"
                                     @bind-Value="doctor.Specialisation">
                            @foreach (var specialisation in Enum.GetValues<SpecialisationType>())
                            {
                                <option value="@specialisation">
                                    @specialisation
                                </option>
                            }
                        </InputSelect>

                        <ValidationMessage For="@(() => doctor.Specialisation)" />
                    </div>

                    <div class="hc-form-group">
                        <label class="hc-form-label">Years of Experience</label>

                        <InputNumber class="hc-form-control"
                                   disabled="@(isSaving || createdDoctor is not null)"
                                   @bind-Value="doctor.YearsOfExperience" />

                        <ValidationMessage For="@(() => doctor.YearsOfExperience)" />
                    </div>

                    <div class="hc-form-group">
                        <label class="hc-form-label">Consultation Fee</label>

                        <InputNumber class="hc-form-control"
                                     disabled="@(isSaving || createdDoctor is not null)"
                                     @bind-Value="doctor.ConsultationFee" />

                        <ValidationMessage For="@(() => doctor.ConsultationFee)" />
                    </div>

                </div>

                <div class="hc-form-actions">
                    <button type="submit"
                            class="hc-page-primary-btn"
                            disabled="@(isSaving || createdDoctor is not null)">
                        @(isSaving ? "Saving Doctor..." : "Save Doctor")
                    </button>

                    <button type="button"
                            class="hc-secondary-btn"
                            disabled="@isSaving"
                            @onclick="BackToDoctors">
                        Cancel
                    </button>
                </div>

            </EditForm>
        }

    </div>
    </div>

@if (createdDoctor is not null)
{
    <div class="ha-modal-backdrop">
        <div class="ha-doctor-created-modal">
          
            <h3>
                Doctor Account Created
            </h3>

            <p>
                Please remember the temporary password now.
            </p>

            <div class="ha-created-doctor-grid">
                <div class="ha-created-doctor-card">
                    <span>Doctor Name</span>

                    <strong>@createdDoctor.DoctorName</strong>
                </div>

                <div class="ha-created-doctor-card">
                    <span>Email</span>

                    <strong>@createdDoctor.Email</strong>
                </div>
            </div>

            <div class="ha-temp-password-box">
                <div>
                    <span>Temporary Password</span>

                    <strong>@createdDoctor.TemporaryPassword</strong>
                </div>
            </div>

            <div class="hc-details-note">

                <p>
                    Provide this temporary password to the doctor through a secure channel.
                    The doctor can log in using it and change it later.
                </p>
            </div>

            <div class="ha-logout-actions">
                <button class="ha-modal-secondary-btn"
                        @onclick="CreateAnotherDoctor">
                    Add Another Doctor
                </button>

                <button class="hc-page-primary-btn"
                        @onclick="BackToDoctors">
                    Go Back
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CreateDoctorDto doctor = new()
    {
        Specialisation = SpecialisationType.GeneralPractitioner,YearsOfExperience = 1

    };

    private EditContext? editContext;

    private DoctorCreatedResponseDto? createdDoctor;

    private bool isSaving;

    private string? errorMessage;



    protected override async Task OnInitializedAsync()
    {
        

        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {

            Navigation.NavigateTo(
                        "/login?sessionExpired=true",
                        replace: true);

            return;
        }
        InitializeEditContext();
    }

    private void InitializeEditContext()
    {
        editContext = new EditContext(doctor);

    }
    private async Task SaveDoctor()
    {
        if (isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;

            errorMessage = null;

            createdDoctor = await DoctorService.CreateDoctorAsync(doctor);

            if (createdDoctor is not null)
            {
                ToastService.ShowSuccess(
                    "Doctor Created",
                    $"{createdDoctor.DoctorName} was registered successfully.");
            }
            else
            {
                errorMessage = "Doctor creation completed, but no response details were returned.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = GetFriendlyCreateDoctorErrorMessage(ex.Message);
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to add doctor. {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CopyTemporaryPassword()
    {
        if (createdDoctor is null ||
            string.IsNullOrWhiteSpace(createdDoctor.TemporaryPassword))
        {
            ToastService.ShowWarning(
                "Nothing to Copy",
                "Temporary password is not available.");

            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                createdDoctor.TemporaryPassword);

            ToastService.ShowSuccess(
                "Copied",
                "Temporary password copied to clipboard.");
        }
        catch
        {
            ToastService.ShowError(
                "Copy Failed",
                "Unable to copy temporary password. Please copy it manually.");
        }
    }

    private static string GetFriendlyCreateDoctorErrorMessage(string exceptionMessage)
    {
        if (exceptionMessage.Contains("409", StringComparison.OrdinalIgnoreCase) ||
            exceptionMessage.Contains("Conflict", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to add doctor. A doctor or login account with this email already exists.";
        }

        if (exceptionMessage.Contains("400", StringComparison.OrdinalIgnoreCase) ||
            exceptionMessage.Contains("BadRequest", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to add doctor. Please check the entered doctor details.";
        }

        if (exceptionMessage.Contains("401", StringComparison.OrdinalIgnoreCase) ||
            exceptionMessage.Contains("403", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to add doctor. Your admin session is not authorized.";
        }

        return "Unable to add doctor. Please try again.";
    }

    private void CreateAnotherDoctor()
    {
        doctor = new CreateDoctorDto
        {
            Specialisation = SpecialisationType.GeneralPractitioner,

        };

        createdDoctor = null;

        errorMessage = null;

        InitializeEditContext();

        ToastService.ShowInfo(
            "Ready",
            "You can register another doctor now.");
    }

    private void BackToDoctors()
    {
        Navigation.NavigateTo("admin/doctors");
    }
}