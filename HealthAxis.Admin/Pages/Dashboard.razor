@page "/dashboard"

@using HealthAxis.API.DTOs.Appointments
@using HealthAxis.API.DTOs.Auth
@using HealthAxis.API.DTOs.CommonDtos
@using HealthAxis.API.DTOs.Doctors
@using HealthAxis.API.DTOs.Patients
@using HealthAxis.Shared.DTOs.Auth
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime Js
@inject NavigationManager NavigationManager

<div class="dashboard-page">

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert-error">
            @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="dashboard-loading-card">
            <span class="button-spinner"></span>
            <span>Loading dashboard data...</span>
        </div>
    }
    else
    {
        <!-- METRICS  -->
        <div class="stats-grid">

            <div class="stat-card">
                <span>Total Doctors</span>
                <strong>@totalDoctors</strong>
            </div>

            <div class="stat-card">
                <span>Active Doctors</span>
                <strong>@activeDoctors</strong>
            </div>

            <div class="stat-card">
                <span>Total Patients</span>
                <strong>@totalPatients</strong>
            </div>

            <div class="stat-card">
                <span>Completed Appointments</span>
                <strong>@completedAppointments</strong>
            </div>

        </div>

        <!-- APPOINTMENT SUMMARY PANEL -->
        <div class="page-card">

            <div class="page-title-row">
                <div>
                    <h2>Appointment Summary</h2>
                    <p>Recent appointment report totals by date.</p>
                </div>

                <a href="/appointment-reports" class="panel-link">
                    View reports
                </a>
            </div>

            @if (appointmentReports.Count == 0)
            {
                <div class="empty-dashboard-state">
                    No appointment report data available
                </div>
            }
            else
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Scheduled</th>
                            <th>Confirmed</th>
                            <th>Cancelled</th>
                            <th>Completed</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var report in appointmentReports.Take(6))
                        {
                            <tr>
                                <td>@report.Date.ToString("dd-MMM-yyyy")</td>
                                <td>@report.TotalCount</td>
                                <td>@report.ScheduledCount</td>
                                <td>@report.ConfirmedCount</td>
                                <td>@report.CancelledCount</td>
                                <td>@report.CompletedCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    }

</div>

@code {
    private const int DashboardPageSize = 50;

    private bool isLoading;
    private string errorMessage = string.Empty;

    private int totalDoctors;
    private int activeDoctors;
    private int totalPatients;
    private int completedAppointments;

    private List<AppointmentReportDto> appointmentReports = new();

    private readonly JsonSerializerOptions jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var doctorResult =
                await GetFromApiWithRefreshAsync<PagedResultDto<DoctorReadDto>>(
                    $"api/admin/doctors?pageNumber=1&pageSize={DashboardPageSize}");

            var patientResult =
                await GetFromApiWithRefreshAsync<PagedResultDto<PatientReadDto>>(
                    $"api/admin/patients?pageNumber=1&pageSize={DashboardPageSize}");

            var appointmentReportResult =
                await GetFromApiWithRefreshAsync<PagedResultDto<AppointmentReportDto>>(
                    $"api/admin/reports/appointments?pageNumber=1&pageSize={DashboardPageSize}");

            totalDoctors = doctorResult.TotalCount;

            activeDoctors = doctorResult.Items.Count(d => d.IsActive);

            totalPatients = patientResult.TotalCount;

            appointmentReports = appointmentReportResult.Items
                .OrderByDescending(r => r.Date)
                .ToList();

            completedAppointments = appointmentReports.Sum(r => r.CompletedCount);
        }
        catch (UnauthorizedAccessException)
        {
            await ClearLoginDataAsync();
            NavigationManager.NavigateTo("/login", replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<T> GetFromApiWithRefreshAsync<T>(string url)
    {
        await AddBearerTokenAsync();

        var response = await Http.GetAsync(url);

        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            response.Dispose();

            var refreshed = await RefreshAccessTokenAsync();

            if (!refreshed)
                throw new UnauthorizedAccessException("Session expired. Please login again.");

            await AddBearerTokenAsync();
            response = await Http.GetAsync(url);
        }

        if (!response.IsSuccessStatusCode)
        {
            var message = await GetErrorMessageAsync(response);
            throw new InvalidOperationException(message);
        }

        var result = await response.Content.ReadFromJsonAsync<T>(jsonOptions);

        return result ?? throw new InvalidOperationException("Invalid response from server.");
    }

    private async Task AddBearerTokenAsync()
    {
        var token = await Js.InvokeAsync<string>("localStorage.getItem", "healthaxis_access_token");

        if (string.IsNullOrWhiteSpace(token))
            throw new UnauthorizedAccessException("Login token missing.");

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);
    }

    private async Task<bool> RefreshAccessTokenAsync()
    {
        var userId = await Js.InvokeAsync<string>("localStorage.getItem", "healthaxis_user_id");
        var refreshToken = await Js.InvokeAsync<string>("localStorage.getItem", "healthaxis_refresh_token");

        if (string.IsNullOrWhiteSpace(userId) || string.IsNullOrWhiteSpace(refreshToken))
        {
            await ClearLoginDataAsync();
            return false;
        }

        var request = new RefreshTokenDto
        {
            UserId = userId,
            RefreshToken = refreshToken
        };

        Http.DefaultRequestHeaders.Authorization = null;

        var response = await Http.PostAsJsonAsync("api/auth/refresh-token", request);

        if (!response.IsSuccessStatusCode)
        {
            await ClearLoginDataAsync();
            return false;
        }

        var auth = await response.Content.ReadFromJsonAsync<AuthResponseDto>(jsonOptions);

        if (auth == null || string.IsNullOrWhiteSpace(auth.AccessToken))
        {
            await ClearLoginDataAsync();
            return false;
        }

        await Js.InvokeVoidAsync("localStorage.setItem", "healthaxis_access_token", auth.AccessToken);
        await Js.InvokeVoidAsync("localStorage.setItem", "healthaxis_refresh_token", auth.RefreshToken);

        return true;
    }

    private async Task<string> GetErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponseDto>(jsonOptions);
            if (!string.IsNullOrWhiteSpace(error?.Message))
                return error.Message;
        }
        catch { }

        return $"Request failed with status {(int)response.StatusCode}.";
    }

    private async Task ClearLoginDataAsync()
    {
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_access_token");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_refresh_token");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_role");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_email");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_user_id");
        await Js.InvokeVoidAsync("localStorage.removeItem", "healthaxis_reference_id");
    }
}
