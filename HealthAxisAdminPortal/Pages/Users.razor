@page "/users"

<div class="container">

    <h3 class="mb-4">Users</h3>

    <table class="table table-bordered table-hover">

        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>

            <tr>
                <td>Aakash Jason</td>
                <td>aakash@example.com</td>
                <td>Admin</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="() => EditUser(user1)">
                        Edit
                    </button>

                    <button class="btn btn-sm btn-outline-danger ms-2"
                            @onclick="() => DeactivateUser(user1)">
                        Deactivate
                    </button>
                </td>
            </tr>

            <tr>
                <td>Dr. Vishal</td>
                <td>itsmedrvishal@example.com</td>
                <td>Doctor</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="() => EditUser(user2)">
                        Edit
                    </button>

                    <button class="btn btn-sm btn-outline-danger ms-2"
                            @onclick="() => DeactivateUser(user2)">
                        Deactivate
                    </button>
                </td>
            </tr>

            <tr>
                <td>Aatif</td>
                <td>aatifrider@example.com</td>
                <td>Patient</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="() => EditUser(user3)">
                        Edit
                    </button>

                    <button class="btn btn-sm btn-outline-danger ms-2"
                            @onclick="() => DeactivateUser(user3)">
                        Deactivate
                    </button>
                </td>
            </tr>

        </tbody>

    </table>

</div>

@code {
    string user1 = "Aakash Jason";
    string user2 = "Dr. Vishal";
    string user3 = "Aatif";

    void EditUser(string name)
    {
        Console.WriteLine($"Edit clicked for {name}");
    }

    void DeactivateUser(string name)
    {
        Console.WriteLine($"Deactivate clicked for {name}");
    }
}