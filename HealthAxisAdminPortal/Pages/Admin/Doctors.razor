@page "/admin/doctors"
@using HealthAxisAdminPortal.Pages.Shared
@inject IDoctorApiService doctorService
@inject IJSRuntime JS
@inject AuthService AuthService
@inject NavigationManager NavManager

<div class="glass-card p-4">

    <h2 class="text-center fw-bold mb-4">
        🩺 Doctor Management
    </h2>

    <button class="btn btn-secondary mb-3"
            @onclick="BackToDashboard">
        ← Back
    </button>

    <button class="btn btn-primary mb-3" @onclick="ShowForm">
        ➕ Add Doctor
    </button>

    <input class="form-control mb-3 stylish-input"
           placeholder="🔍 Search by name..."
           @oninput="SearchDoctors" />

    <select class="form-control mb-3 stylish-input"
            @onchange="FilterBySpecialisation">
        <option value="">All Specialisations</option>
        @foreach (var spec in specialisations)
        {
            <option value="@spec">@spec</option>
        }
    </select>

    @if (showEdit)
    {
        <div class="glass-card p-3 mb-4">
            <h5 class="mb-3">Edit Doctor</h5>

            <input class="form-control stylish-input mb-2"
                   @bind="editDoctor.DoctorName" />

            <input class="form-control stylish-input mb-2"
                   placeholder="Email"
                   @bind="editDoctor.Email" />

            <select class="form-control stylish-input mb-2"
                    @bind="editDoctor.Specialisation">
                @foreach (var spec in specialisations)
                {
                    <option value="@spec">@spec</option>
                }
            </select>

            <input type="number"
                   class="form-control stylish-input mb-2"
                   @bind="editDoctor.YearsOfExperience" />

            <input type="number"
                   class="form-control stylish-input mb-2"
                   @bind="editDoctor.ConsultationFee" />

            <button class="btn btn-success me-2" @onclick="UpdateDoctor">Save</button>
            <button class="btn btn-secondary" @onclick="() => showEdit = false">Cancel</button>
        </div>
    }

    @if (showForm)
    {
        <div class="glass-card p-3 mb-4">
            <h5 class="mb-3">Add Doctor</h5>

            <input class="form-control stylish-input mb-2"
                   placeholder="Name"
                   @bind="newDoctor.DoctorName" />

            <!-- ✅ EMAIL (Register DTO) -->
            <input class="form-control stylish-input mb-2"
                   placeholder="Email"
                   @bind="register.Email" />

            <!-- ✅ PASSWORD -->
            <input type="password"
                   class="form-control stylish-input mb-2"
                   placeholder="Password"
                   @bind="register.Password" />

            <!-- ✅ CONFIRM PASSWORD -->
            <input type="password"
                   class="form-control stylish-input mb-2"
                   placeholder="Confirm Password"
                   @bind="register.ConfirmPassword" />

            <select class="form-control stylish-input mb-2"
                    @bind="newDoctor.Specialisation">
                <option value="">Select Specialisation</option>
                @foreach (var spec in specialisations)
                {
                    <option value="@spec">@spec</option>
                }
            </select>

            <input type="number"
                   class="form-control stylish-input mb-2"
                   placeholder="Experience"
                   @bind="newDoctor.YearsOfExperience" />

            <input type="number"
                   class="form-control stylish-input mb-2"
                   placeholder="Fee"
                   @bind="newDoctor.ConsultationFee" />

            <button class="btn btn-success me-2" @onclick="AddDoctor">Save</button>
            <button class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
        </div>
    }

    @if (doctors == null)
    {
        <p>Loading...</p>
    }
    else if (!doctors.Any())
    {
        <p>No doctors found</p>
    }
    else
    {
        <table class="table custom-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Specialization</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var doctor in doctors)
                {
                    <tr>
                        <td>@doctor.DoctorName</td>
                        <td>@doctor.Email</td>
                        <td>@doctor.Specialisation</td>
                        <td>@doctor.YearsOfExperience</td>

                        <td>
                            <input type="number"
                                   class="form-control stylish-input d-inline w-50 me-2"
                                   @bind="doctor.ConsultationFee" />

                            <button class="btn btn-sm stylish-btn"
                                    @onclick="() => UpdateFee(doctor)">
                                Update
                            </button>
                        </td>

                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@doctor.IsActive"
                                       @onclick="() => ToggleStatus(doctor)" />
                            </div>
                        </td>

                        <td>
                            <button class="btn btn-sm btn-warning"
                                    @onclick="() => OpenEdit(doctor)">
                                ✏️ Edit
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>

<ErrorModal IsVisible="@showError"
            Message="@errorMessage"
            OnClose="CloseError" />

<ConfirmModal IsVisible="@showConfirm"
              Message="@confirmMessage"
              OnClose="HandleConfirm" />

@code {

    private List<DoctorDto>? doctors;

    private List<string> specialisations = new()
    {
        "Cardiologist","Dermatologist","Neurologist","Pediatrician",
        "Psychiatrist","OrthopedicSurgeon","Gynecologist",
        "Oncologist","Endocrinologist","GeneralPractitioner"
    };

    private bool showForm = false;
    private bool showEdit = false;
    private bool showError = false;

    private bool showConfirm = false;
    private string confirmMessage = "";
    private Func<Task>? confirmAction;

    private string errorMessage = "";
    private string selectedSpecialisation = "";

    private CreateDoctorDto newDoctor = new();

    // ✅ NEW Register DTO
    private RegisterDto register = new() { Role = "Doctor" };

    private UpdateDoctorDto editDoctor = new();
    private int editingId;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.EnsureTokenLoaded();

        doctors = await doctorService.GetAllAsync();
    }

    private void ShowForm() => showForm = true;

    private void CancelForm()
    {
        showForm = false;
        newDoctor = new CreateDoctorDto();
        register = new RegisterDto { Role = "Doctor" };
    }

    private void CloseError() => showError = false;

    // ✅ ✅ FINAL FIXED METHOD
    private async Task AddDoctor()
    {
        try
        {
            register.Name = newDoctor.DoctorName; // ✅ FIX
            newDoctor.Email = register.Email;

            var success = await doctorService.CreateAsync(register, newDoctor);

            if (success)
            {
                showForm = false;
                doctors = await doctorService.GetAllAsync();

                newDoctor = new CreateDoctorDto();
                register = new RegisterDto { Role = "Doctor" };
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            showError = true;
        }
    }

    private void OpenEdit(DoctorDto doctor)
    {
        editingId = doctor.DoctorId;

        editDoctor = new UpdateDoctorDto
        {
            DoctorName = doctor.DoctorName,
            Email = doctor.Email,
            Specialisation = doctor.Specialisation,
            YearsOfExperience = doctor.YearsOfExperience,
            ConsultationFee = doctor.ConsultationFee,
            IsActive = doctor.IsActive
        };

        showEdit = true;
    }

    private async Task UpdateDoctor()
    {
        try
        {
            var success = await doctorService.UpdateAsync(editingId, editDoctor);

            if (success)
            {
                showEdit = false;
                doctors = await doctorService.GetAllAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            showError = true;
        }
    }

    private void UpdateFee(DoctorDto doctor)
    {
        confirmMessage = "Update consultation fee?";

        confirmAction = async () =>
        {
            try
            {
                var dto = new UpdateDoctorDto
                {
                    DoctorName = doctor.DoctorName,
                    Email = doctor.Email,
                    Specialisation = doctor.Specialisation,
                    YearsOfExperience = doctor.YearsOfExperience,
                    ConsultationFee = doctor.ConsultationFee,
                    IsActive = doctor.IsActive
                };

                await doctorService.UpdateAsync(doctor.DoctorId, dto);
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
                showError = true;
            }
        };

        showConfirm = true;
    }

    private void ToggleStatus(DoctorDto doctor)
    {
        confirmMessage = doctor.IsActive
            ? "Deactivate this doctor?"
            : "Activate this doctor?";

        confirmAction = async () =>
        {
            try
            {
                var success = await doctorService.ToggleActiveAsync(doctor.DoctorId);
                if (success)
                    doctor.IsActive = !doctor.IsActive;
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
                showError = true;
            }
        };

        showConfirm = true;
    }

    private async Task HandleConfirm(bool result)
    {
        showConfirm = false;
        if (result && confirmAction != null)
        {
            await confirmAction();
        }
    }

    private async Task SearchDoctors(ChangeEventArgs e)
    {
        var name = e.Value?.ToString() ?? "";
        var result = await doctorService.SearchAsync(name);

        if (!string.IsNullOrWhiteSpace(selectedSpecialisation))
        {
            result = result.Where(d => d.Specialisation == selectedSpecialisation).ToList();
        }

        doctors = result;
    }

    private async Task FilterBySpecialisation(ChangeEventArgs e)
    {
        selectedSpecialisation = e.Value?.ToString() ?? "";

        doctors = await doctorService.GetAllAsync();

        if (!string.IsNullOrWhiteSpace(selectedSpecialisation))
        {
            doctors = doctors.Where(d => d.Specialisation == selectedSpecialisation).ToList();
        }
    }

    void BackToDashboard()
    {
        NavManager.NavigateTo("/blazor");
    }
}