@inject IJSRuntime JS

@code
{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        TokenStore.AccessToken =
            await JS.InvokeAsync<string>(
                "authHelper.getToken");

        Console.WriteLine(
            $"RESTORED TOKEN: {TokenStore.AccessToken}");
    }
}