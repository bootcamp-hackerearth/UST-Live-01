@page "/"
@inject NavigationManager NavManager


<div class="container mt-4">

    <h2 class="text-center fw-bold mb-5" style="letter-spacing:1px;">
        Admin Control Panel
    </h2>


    <div class="row g-3">

        <!-- Doctors -->
        <div class="col-md-6">
            <div class="glass-card p-4 text-center"
                 @onclick="@(() => NavigateTo("/admin/doctors"))">

                <div class="card-body text-center">
                    <i class="fa-solid fa-user-doctor fa-3x text-success mb-3"></i>

                    <h4 class="fw-semibold">Doctors</h4>
                    <p class="text-muted">Manage medical professionals</p>
                </div>

            </div>
        </div>

        <!-- Patients -->
        <div class="col-md-6">
            <div class="glass-card p-4 text-center"
                @onclick="@(() => NavigateTo("/admin/patients"))">
                

                <div class="card-body text-center">
                    <i class="fa-solid fa-hospital-user fa-3x text-primary mb-3"></i>

                    <h4 class="fw-semibold">Patients</h4>
                    <p class="text-muted">Manage patient records</p>

                </div>

            </div>
        </div>

    </div>

</div>


@code {
    void NavigateTo(string url)
    {
        NavManager.NavigateTo(url);
    }
}
