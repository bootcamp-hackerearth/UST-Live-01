@inherits LayoutComponentBase
@inject NavigationManager NavManager

@code {
    bool IsLoginPage =>
        NavManager.ToBaseRelativePath(NavManager.Uri).StartsWith("login");

    void Logout()
    {
        NavManager.NavigateTo("/login", true);
    }

}

@if (IsLoginPage)
{
    @Body
}
else
{
    <div class="d-flex">

        <!-- Sidebar -->
        <div class="bg-dark text-white p-3" style="width:200px; min-height:100vh;">
            <h4>HealthAxis</h4>

            <ul class="nav flex-column">

                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="/" Match="NavLinkMatch.All">
                        Dashboard
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="/users">
                        Users
                    </NavLink>
                </li>

                <li class="nav-item mt-3">
                    <button class="btn btn-sm btn-light w-100" @onclick="Logout">
                        Logout
                    </button>
                </li>


            </ul>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 p-4">
            @Body
        </div>

    </div>
}
