<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5277448">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\HealthAxisCore_Angular\browser\</BuildOutputFolder>

    <!-- Exclude project from SonarScanner for .NET -->
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>
    <ItemGroup>
      <SonarQubeSetting Include="sonar.coverage.exclusions">
        <Value>HealthAxisCore_Angular/**,**/HealthAxisCore_Angular/**</Value>
      </SonarQubeSetting>
    </ItemGroup>
</Project>