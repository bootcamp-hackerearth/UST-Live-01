@model IEnumerable<HealthAxis.Shared.DTOs.HealthRecordDto>

<h2 class="ha-title">Health Records</h2>

<table class="table">
    <tr>
        <th>Date</th>
        <th>Doctor</th>
        <th>Specialisation</th>
        <th>Diagnosis</th>
        <th>Prescription</th>
        <th>Notes</th>
    </tr>

    @foreach (var r in Model)
    {
        <tr>
            <td>@r.VisitDate.ToString("dd-MMM-yyyy")</td>
            <td>@r.DoctorName</td>
            <td>@r.DoctorSpecialisation</td>
            <td>@r.Diagnosis</td>
            <td>@r.Prescription</td>
            <td>@r.Notes</td>
        </tr>
    }
</table>

@Html.ActionLink("Back", "Index", "Patients", null, new { @class = "btn btn-dark-back" })