<div class="ha-page" style="display:flex; align-items:center;">
    <div class="container">

        <div class="ha-card"
             style="max-width:520px; margin:0 auto; padding:40px 36px; text-align:center;">

            
            <div class="ha-action-icon"
                 style="background:linear-gradient(135deg,#06b6d4,#67e8f9); margin-bottom:22px;">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                    <path d="M16 3v4"></path>
                    <path d="M8 3v4"></path>
                    <path d="M3 11h18"></path>
                    <path d="M12 15h.01"></path>
                </svg>
            </div>
            <h2 class="ha-title" style="margin-bottom:8px;">
                View Appointments
            </h2>
            <p class="ha-muted" style="margin-bottom:22px;">
                Enter your Patient ID to view all booked appointments.
            </p>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" style="margin-bottom:20px;">
                    @TempData["Error"]
                </div>
            }
            @using (Html.BeginForm("MyAppointments", "Appointments", FormMethod.Get))
            {
                <input type="number"
                       name="patientId"
                       class="form-control"
                       placeholder="Enter Patient ID"
                       required
                       min="1"
                       style="max-width:420px; margin:0 auto 24px auto; text-align:center; font-size:16px; padding:12px;" />

                <div class="ha-actions">
                    <button type="submit"
                            class="btn btn-info pill-btn"
                            style="width:100%;">
                        View Appointments
                    </button>

                    @Html.ActionLink(
                        "Back",
                        "Index",
                        "Patients",
                        null,
                        new { @class = "btn btn-dark-back" })
                </div>
            }

        </div>

    </div>
</div>