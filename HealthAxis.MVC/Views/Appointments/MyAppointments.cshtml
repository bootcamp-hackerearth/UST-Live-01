@model IEnumerable<HealthAxis.Shared.DTOs.AppointmentDto>

<h2 class="ha-title">My Appointments</h2>

<table class="table">
    <tr>
        <th>Doctor</th>
        <th>Specialisation</th>
        <th>Date</th>
        <th>Time</th>
        <th>Status</th>
    </tr>

    @foreach (var a in Model)
    {
        <tr>
            <td>@a.DoctorName</td>
            <td>@a.DoctorSpecialisation</td>
            <td>@a.ScheduledDate.ToString("dd-MMM-yyyy")</td>
            <td>@a.TimeSlot</td>
            <td>@a.Status</td>
        </tr>
    }
</table>

@Html.ActionLink("Back", "Index", "Patients", null, new { @class = "btn btn-dark-back" })