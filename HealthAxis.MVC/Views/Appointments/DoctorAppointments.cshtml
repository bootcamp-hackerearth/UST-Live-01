@model IEnumerable<HealthAxis.Shared.DTOs.AppointmentDto>
@using HealthAxis.Shared.Enums

@{
    ViewBag.Title = "Doctor Appointments";
}

<div class="ha-page">
    <div class="container">

        <div class="ha-card" style="padding:30px;">

            <!-- HEADER -->
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;border-bottom:1px solid #334155;padding-bottom:18px;">
                <div>
                    <h2 class="ha-title">Doctor Appointments</h2>
                    <p class="ha-muted">Manage patient appointments and update status.</p>
                </div>

                @Html.ActionLink("Back", "Index", "Doctors", null,
                    new { @class = "btn btn-dark-back" })
            </div>

          
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

       
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th style="width:300px;">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.PatientName</td>
                            <td>@a.ScheduledDate.ToString("dd-MMM-yyyy")</td>
                            <td>@a.TimeSlot</td>

                            <td>
                                @if (a.Status == AppointmentStatusEnum.Pending)
                                {
                                    <span class="badge badge-warning">Pending</span>
                                }
                                else if (a.Status == AppointmentStatusEnum.Confirmed)
                                {
                                    <span class="badge badge-primary">Confirmed</span>
                                }
                                else if (a.Status == AppointmentStatusEnum.Completed)
                                {
                                    <span class="badge badge-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Cancelled</span>
                                }
                            </td>

                            <td>
                                <div style="display:flex;gap:6px;flex-wrap:wrap;">

                                    
                                    @if (a.Status == AppointmentStatusEnum.Pending)
                                    {
                                        using (Html.BeginForm("UpdateStatus", "Appointments", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("AppointmentId", a.AppointmentId)
                                            @Html.Hidden("Status", AppointmentStatusEnum.Confirmed)
                                            @Html.Hidden("patientId", a.PatientId)
                                            @Html.Hidden("doctorId", a.DoctorId)

                                            <button type="submit" class="btn btn-success btn-sm">
                                                Approve
                                            </button>
                                        }
                                    }

                                
                                    @if (a.Status == AppointmentStatusEnum.Pending ||
                                         a.Status == AppointmentStatusEnum.Confirmed)
                                    {
                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                data-toggle="modal"
                                                data-target="#cancelModal-@a.AppointmentId">
                                            Cancel
                                        </button>
                                    }

                                    
                                    @if (a.Status == AppointmentStatusEnum.Confirmed)
                                    {
                                        <button type="button"
                                                class="btn btn-warning btn-sm"
                                                data-toggle="modal"
                                                data-target="#completeModal-@a.AppointmentId">
                                            Complete
                                        </button>
                                    }

                                    
                                    @if (a.Status == AppointmentStatusEnum.Completed)
                                    {
                                        @Html.ActionLink(
                                            "Add Record",
                                            "Create",
                                            "HealthRecords",
                                            new
                                            {
                                                patientId = a.PatientId,
                                                doctorId = a.DoctorId,
                                                appointmentId = a.AppointmentId
                                            },
                                            new { @class = "btn btn-purple btn-sm" })
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<!-- ✅ MODALS OUTSIDE TABLE -->
@foreach (var a in Model)
{
    <!-- CANCEL MODAL -->
    <div class="modal fade" id="cancelModal-@a.AppointmentId">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Cancel Appointment</h5>

                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>

                </div>

                <div class="modal-body">

                    @using (Html.BeginForm("UpdateStatus", "Appointments", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.Hidden("AppointmentId", a.AppointmentId)
                        @Html.Hidden("Status", AppointmentStatusEnum.Cancelled)
                        @Html.Hidden("patientId", a.PatientId)
                        @Html.Hidden("doctorId", a.DoctorId)

                        <div class="form-group">
                            <label>Reason</label>
                            <textarea name="CancellationReason"
                                      class="form-control"
                                      required></textarea>
                        </div>

                        <button type="submit" class="btn btn-danger">
                            Confirm Cancel
                        </button>
                    }

                </div>
            </div>
        </div>
    </div>
    <br />
    <br />
    <!-- COMPLETE MODAL -->
    <div class="modal fade" id="completeModal-@a.AppointmentId">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Confirm Completion</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>

                <div class="modal-body">
                    Are you sure you want to complete this appointment?
                </div>

                <div class="modal-footer">

                    @using (Html.BeginForm("UpdateStatus", "Appointments", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.Hidden("AppointmentId", a.AppointmentId)
                        @Html.Hidden("Status", AppointmentStatusEnum.Completed)
                        @Html.Hidden("patientId", a.PatientId)
                        @Html.Hidden("doctorId", a.DoctorId)

                        <button type="submit" class="btn btn-success">
                            Yes
                        </button>
                    }

                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        No
                    </button>

                </div>
            </div>
        </div>
    </div>
}