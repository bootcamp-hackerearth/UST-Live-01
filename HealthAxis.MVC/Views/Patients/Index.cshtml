@model IEnumerable<HealthAxis.Shared.DTOs.PatientDto>

@{
    ViewBag.Title = "Patients";
}

<div class="ha-page">
    <div class="container">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="ha-card"
             style="padding:30px;margin-bottom:30px;background:linear-gradient(135deg,#1769ff,#51b4ff)">
            <h2 style="color:white;font-weight:800">
                Patient Management
            </h2>

            <p style="color:#e0f2fe">
                Register patients, manage profiles, book appointments, and view health history.
            </p>
        </div>

        <div class="ha-grid">

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#1677ff,#00b7ff)">
                        <svg viewBox="0 0 24 24">
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M3 21c0-4 2.8-7 6-7s6 3 6 7"></path>
                            <path d="M18 8v6"></path>
                            <path d="M15 11h6"></path>
                        </svg>
                    </div>

                    <h4>Register Patient</h4>
                    <p>Add a new patient with contact, profile, and insurance details.</p>
                </div>

                @Html.ActionLink(
                    "Register",
                    "Create",
                    "Patients",
                    null,
                    new { @class = "btn btn-primary" })
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#0f766e,#2dd4bf)">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                            <path d="M16 19h4"></path>
                            <path d="M18 17v4"></path>
                        </svg>
                    </div>

                    <h4>Patient Profile</h4>
                    <p>View profile details, appointment count, and update patient information.</p>
                </div>

                <button class="btn"
                        style="background:#0f766e;color:white"
                        data-toggle="modal"
                        data-target="#profileModal">
                    View Profile
                </button>
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#16a34a,#4ade80)">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <path d="M16 3v4"></path>
                            <path d="M8 3v4"></path>
                            <path d="M3 11h18"></path>
                            <path d="M9 16l2 2 4-4"></path>
                        </svg>
                    </div>

                    <h4>Book Appointment</h4>
                    <p>Select a doctor, appointment date, and available time slot.</p>
                </div>

                @Html.ActionLink(
                    "Book Now",
                    "Book",
                    "Appointments",
                    null,
                    new { @class = "btn btn-success" })
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#06b6d4,#67e8f9)">
                        <svg viewBox="0 0 24 24">
                            <path d="M8 6h13"></path>
                            <path d="M8 12h13"></path>
                            <path d="M8 18h13"></path>
                            <path d="M3 6h.01"></path>
                            <path d="M3 12h.01"></path>
                            <path d="M3 18h.01"></path>
                        </svg>
                    </div>

                    <h4>My Appointments</h4>
                    <p>View appointments for a patient using ID, phone, or name.</p>
                </div>

                <button class="btn btn-info"
                        data-toggle="modal"
                        data-target="#appointmentModal">
                    View
                </button>
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#f59e0b,#facc15)">
                        <svg viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M21 21l-4.3-4.3"></path>
                            <path d="M11 8v6"></path>
                            <path d="M8 11h6"></path>
                        </svg>
                    </div>

                    <h4>Search Doctors</h4>
                    <p>Find active doctors by specialisation before booking.</p>
                </div>

                @Html.ActionLink(
                    "Search",
                    "SearchDoctors",
                    "Patients",
                    null,
                    new { @class = "btn btn-warning" })
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#7c3aed,#a78bfa)">
                        <svg viewBox="0 0 24 24">
                            <path d="M7 3h10l4 4v14H7z"></path>
                            <path d="M17 3v5h5"></path>
                            <path d="M10 13h7"></path>
                            <path d="M10 17h7"></path>
                            <path d="M10 9h2"></path>
                        </svg>
                    </div>

                    <h4>Health Records</h4>
                    <p>View diagnosis, prescription, and visit history.</p>
                </div>

                <button class="btn btn-purple"
                        data-toggle="modal"
                        data-target="#recordModal">
                    View Records
                </button>
            </div>

        </div>

    </div>
</div>

<div class="modal fade" id="profileModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Search Patient</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">

                @using (Html.BeginForm("Profile", "Patients", FormMethod.Get))
                {
                    <div class="patient-search-wrapper">
                        <input type="text"
                               class="form-control modal-input text-center patient-search"
                               placeholder="Enter ID / Phone / Name"
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               name="selectedPatientId"
                               class="selected-patient-id" />

                        <ul class="list-group patient-suggestions"></ul>
                    </div>

                    <button type="submit"
                            class="btn modal-btn"
                            style="background:#0f766e;color:white;">
                        View Profile
                    </button>

                }

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="appointmentModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Search Patient</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">

                @using (Html.BeginForm("MyAppointments", "Appointments", FormMethod.Get))
                {
                    <div class="patient-search-wrapper">
                        <input type="text"
                               class="form-control modal-input text-center patient-search"
                               placeholder="Enter ID / Phone / Name"
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               name="selectedPatientId"
                               class="selected-patient-id" />

                        <ul class="list-group patient-suggestions"></ul>
                    </div>

                    <button type="submit"
                            class="btn modal-btn btn-info">
                        View Appointments
                    </button>
                }

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="recordModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Search Patient</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">

                @using (Html.BeginForm("PatientHistory", "HealthRecords", FormMethod.Get))
                {
                    <div class="patient-search-wrapper">
                        <input type="text"
                               class="form-control modal-input text-center patient-search"
                               placeholder="Enter ID / Phone / Name"
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               name="selectedPatientId"
                               class="selected-patient-id" />

                        <ul class="list-group patient-suggestions"></ul>
                    </div>

                    <button type="submit"
                            class="btn modal-btn btn-purple">
                        View Records
                    </button>
                }

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".patient-search").forEach(function (input) {
                const wrapper = input.closest(".patient-search-wrapper");
                const box = wrapper.querySelector(".patient-suggestions");
                const hiddenPatientId = wrapper.querySelector(".selected-patient-id");

                input.addEventListener("input", function () {
                    hiddenPatientId.value = "";

                    const query = input.value.trim();

                    if (query.length < 2) {
                        box.innerHTML = "";
                        return;
                    }

                    fetch("/Patients/Search?searchValue=" + encodeURIComponent(query))
                        .then(function (response) {
                            return response.json();
                        })
                        .then(function (data) {
                            box.innerHTML = "";

                            if (!data || data.length === 0) {
                                const emptyItem = document.createElement("li");
                                emptyItem.className = "list-group-item patient-suggestion-empty";
                                emptyItem.innerText = "No patients found";
                                box.appendChild(emptyItem);
                                return;
                            }

                            data.forEach(function (patient) {
                                const item = document.createElement("li");
                                item.className = "list-group-item patient-suggestion-item";

                                item.innerHTML =
                                    "<strong>" + patient.FullName + "</strong>" +
                                    "<br />ID: " + patient.PatientId +
                                    " | Phone: " + patient.PhoneNumber;

                                item.addEventListener("click", function () {
                                    input.value =
                                        patient.FullName +
                                        " (ID: " +
                                        patient.PatientId +
                                        ")";

                                    hiddenPatientId.value = patient.PatientId;

                                    box.innerHTML = "";
                                });

                                box.appendChild(item);
                            });
                        })
                        .catch(function () {
                            box.innerHTML = "";

                            const errorItem = document.createElement("li");
                            errorItem.className = "list-group-item patient-suggestion-empty";
                            errorItem.innerText = "Unable to load suggestions";
                            box.appendChild(errorItem);
                        });
                });

                input.closest("form").addEventListener("submit", function (event) {
                    if (!hiddenPatientId.value) {
                        event.preventDefault();
                        alert("Please select a patient from the suggestions.");
                    }
                });

                document.addEventListener("click", function (event) {
                    if (!wrapper.contains(event.target)) {
                        box.innerHTML = "";
                    }
                });
            });
        });
    </script>
}