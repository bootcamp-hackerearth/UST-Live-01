@model HealthAxis.Shared.DTOs.PatientDto

<div class="ha-page">
    <div class="container">

        <div class="ha-card" style="max-width:600px;margin:auto;padding:40px;text-align:center">
            <div class="ha-action-icon"
                 style="width:70px;height:70px;margin:0 auto 20px;
            background:linear-gradient(135deg,#0f766e,#2dd4bf)">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                </svg>
            </div>
            <h2 class="ha-title">@Model.FullName</h2>

            <div style="margin-top:25px;text-align:left">

                <p><b>Patient ID:</b> @Model.PatientId</p>
                <p><b>Date of Birth:</b> @Model.DateOfBirth.ToString("dd-MMM-yyyy")</p>
                <p><b>Gender:</b> @Model.Gender</p>
                <p><b>Phone:</b> @Model.PhoneNumber</p>
                <p><b>Email:</b> @Model.Email</p>
                <p><b>Insurance ID:</b> @Model.InsuranceID</p>
                <p><b>Total Appointments:</b> @Model.AppointmentCount</p>

            </div>

            <div class="ha-actions">
                @Html.ActionLink("Back", "Index", "Patients", null, new { @class = "btn btn-dark-back" })
            </div>

        </div>

    </div>
</div>
`