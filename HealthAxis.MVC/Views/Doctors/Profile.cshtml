@model HealthAxis.Shared.DTOs.DoctorDto

@{
    ViewBag.Title = "Doctor Profile";
}

<div class="ha-page">
    <div class="container">

        <div class="ha-card" style="max-width:600px;margin:0 auto;padding:40px;text-align:center">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }
            else if (Model != null)
            {
                <div class="ha-action-icon"
                     style="width:70px;height:70px;margin:0 auto 20px;
                            background:linear-gradient(135deg,#0f766e,#2dd4bf)">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                    </svg>
                </div>

                <h2 class="ha-title">@Model.FullName</h2>

                <p class="ha-muted">@Model.Specialisation</p>

                <div style="margin-top:25px;text-align:left">

                    <p><b>Doctor ID:</b> @Model.DoctorId</p>

                    <p><b>Years of Experience:</b> @Model.YearsOfExperience years</p>

                    <p><b>Consultation Fee:</b> ₹@Model.ConsultationFee</p>

                    <p>
                        <b>Status:</b>
                        @if (Model.IsActive)
                        {
                            <span style="color:#22c55e;">Active</span>
                        }
                        else
                        {
                            <span style="color:#ef4444;">Inactive</span>
                        }
                    </p>

                    <p><b>Upcoming Appointments:</b> @Model.UpcomingAppointmentCount</p>

                </div>
            }

            <div class="ha-actions" style="margin-top:30px;">
                @Html.ActionLink(
                    "Back",
                    "Index",
                    "Doctors",
                    null,
                    new { @class = "btn btn-dark-back" })
            </div>

        </div>

    </div>
</div>