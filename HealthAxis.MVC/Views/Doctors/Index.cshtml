@model IEnumerable<HealthAxis.Shared.DTOs.DoctorDto>

@{
        ViewBag.Title = "Doctor Management";
}

<div class="ha-page">
    <div class="container">

        @if (TempData["Error"] != null)
                {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
                }

        <div class="ha-card"
             style="padding:30px;margin-bottom:30px;background:linear-gradient(135deg,#16a34a,#4ade80)">
            <h2 style="color:white;font-weight:800">
                Doctor Management
            </h2>

            <p style="color:#dcfce7">
                Register doctors, view schedules, update appointments, view patients, and access health records.
            </p>
        </div>

        <div class="ha-grid">

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#16a34a,#4ade80)">
                        <svg viewBox="0 0 24 24">
                            <path d="M6 3v5a4 4 0 0 0 8 0V3"></path>
                            <path d="M6 3H4"></path>
                            <path d="M14 3h2"></path>
                            <path d="M18 14v6"></path>
                            <path d="M15 17h6"></path>
                        </svg>
                    </div>

                    <h4>Register Doctor</h4>
                    <p>Add a new doctor with specialisation, experience, and consultation fee.</p>
                </div>

                @Html.ActionLink(
                    "Register",
                    "Create",
                    "Doctors",
                    null,
                    new { @class = "btn btn-success" })
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#0f766e,#2dd4bf)">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                        </svg>
                    </div>

                    <h4>Doctor Profile</h4>
                    <p>View doctor profile, full details, and upcoming appointment count.</p>
                </div>

                <button type="button"
                        class="btn"
                        style="background:#0f766e;color:white"
                        data-toggle="modal"
                        data-target="#doctorProfileModal">
                    View Profile
                </button>
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#1677ff,#38bdf8)">
                        <svg viewBox="0 0 24 24">
                            <path d="M8 6h13"></path>
                            <path d="M8 12h13"></path>
                            <path d="M8 18h13"></path>
                            <path d="M3 6h.01"></path>
                            <path d="M3 12h.01"></path>
                            <path d="M3 18h.01"></path>
                        </svg>
                    </div>

                    <h4>View / Update Appointments</h4>
                    <p>View doctor appointments and update appointment status.</p>
                </div>

                <button type="button"
                        class="btn btn-primary"
                        data-toggle="modal"
                        data-target="#doctorAppointmentModal">
                    Open
                </button>
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#06b6d4,#67e8f9)">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <path d="M16 3v4"></path>
                            <path d="M8 3v4"></path>
                            <path d="M3 11h18"></path>
                            <path d="M12 15h.01"></path>
                        </svg>
                    </div>

                    <h4>Today's Schedule</h4>
                    <p>View all appointments scheduled for today using Doctor ID.</p>
                </div>

                <button type="button"
                        class="btn btn-info"
                        data-toggle="modal"
                        data-target="#todayScheduleModal">
                    Today
                </button>
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#f59e0b,#facc15)">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <path d="M16 3v4"></path>
                            <path d="M8 3v4"></path>
                            <path d="M3 11h18"></path>
                            <path d="M7 15h2"></path>
                            <path d="M11 15h2"></path>
                            <path d="M15 15h2"></path>
                        </svg>
                    </div>

                    <h4>Weekly Schedule</h4>
                    <p>View doctor appointments for the selected week.</p>
                </div>

                <button type="button"
                        class="btn btn-warning"
                        data-toggle="modal"
                        data-target="#weeklyScheduleModal">
                    Weekly
                </button>
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#7c3aed,#a78bfa)">
                        <svg viewBox="0 0 24 24">
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M3 21c0-4 2.8-7 6-7s6 3 6 7"></path>
                            <path d="M17 11h4"></path>
                            <path d="M19 9v4"></path>
                        </svg>
                    </div>

                    <h4>Patient List</h4>
                    <p>View patient list sorted by name and filter by insurance status.</p>
                </div>

                @Html.ActionLink(
                    "View Patients",
                    "PatientList",
                    "Doctors",
                    null,
                    new { @class = "btn btn-purple" })
            </div>

            <div class="ha-action-card">
                <div class="ha-action-content">
                    <div class="ha-action-icon"
                         style="background:linear-gradient(135deg,#db2777,#f472b6)">
                        <svg viewBox="0 0 24 24">
                            <path d="M7 3h10l4 4v14H7z"></path>
                            <path d="M17 3v5h5"></path>
                            <path d="M10 13h7"></path>
                            <path d="M10 17h7"></path>
                            <path d="M10 9h2"></path>
                        </svg>
                    </div>

                    <h4>View Health Records</h4>
                    <p>View diagnosis, prescription, notes, and visit history for a patient.</p>
                </div>

                <button type="button"
                        class="btn"
                        style="background:#db2777;color:white"
                        data-toggle="modal"
                        data-target="#doctorRecordModal">
                    View Records
                </button>
            </div>

        </div>

    </div>
</div>

<div class="modal fade" id="doctorProfileModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Search Doctor</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">

                @using (Html.BeginForm("Profile", "Doctors", FormMethod.Get))
                {
                    <div class="doctor-search-wrapper">
                        <input type="text"
                               class="form-control modal-input text-center doctor-search"
                               placeholder="Enter Doctor ID / Name / Specialisation"
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               name="selectedDoctorId"
                               class="selected-doctor-id" />

                        <ul class="list-group doctor-suggestions"></ul>
                    </div>

                    <button type="submit"
                            class="btn modal-btn"
                            style="background:#0f766e;color:white;">
                        View Profile
                    </button>
                }
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="doctorAppointmentModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Search Doctor</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">

                @using (Html.BeginForm("DoctorAppointments", "Appointments", FormMethod.Get))
                {
                    <div class="doctor-search-wrapper">
                        <input type="text"
                               class="form-control modal-input text-center doctor-search"
                               placeholder="Enter Doctor ID / Name / Specialisation"
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               name="selectedDoctorId"
                               class="selected-doctor-id" />

                        <ul class="list-group doctor-suggestions"></ul>
                    </div>

                    <button type="submit"
                            class="btn modal-btn btn-primary">
                        Open Appointments
                    </button>
                }

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="todayScheduleModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Search Doctor</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">

                @using (Html.BeginForm("TodaySchedule", "Appointments", FormMethod.Get))
                {
                    <div class="doctor-search-wrapper">
                        <input type="text"
                               class="form-control modal-input text-center doctor-search"
                               placeholder="Enter Doctor ID / Name / Specialisation"
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               name="selectedDoctorId"
                               class="selected-doctor-id" />

                        <ul class="list-group doctor-suggestions"></ul>
                    </div>

                    <button type="submit"
                            class="btn modal-btn btn-info">
                        View Today
                    </button>
                }

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="weeklyScheduleModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Search Doctor</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">

                @using (Html.BeginForm("WeeklySchedule", "Appointments", FormMethod.Get))
                {
                    <div class="doctor-search-wrapper">
                        <input type="text"
                               class="form-control modal-input text-center doctor-search"
                               placeholder="Enter Doctor ID / Name / Specialisation"
                               autocomplete="off"
                               required />

                        <input type="hidden"
                               name="selectedDoctorId"
                               class="selected-doctor-id" />

                        <ul class="list-group doctor-suggestions"></ul>
                    </div>

                    <div class="weekly-date-wrapper">
                        <input type="date"
                               name="startDate"
                               class="form-control modal-input text-center" />
                    </div>

                    <button type="submit"
                            class="btn modal-btn btn-warning">
                        View Weekly
                    </button>
                }

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="doctorRecordModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Search Patient</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">

                @using (Html.BeginForm("PatientHistory", "HealthRecords", FormMethod.Get))
                                {
                <div class="patient-search-wrapper">
                    <input type="text"
                           name="searchValue"
                           class="form-control modal-input text-center patient-search"
                           placeholder="Enter Patient ID / Phone / Name"
                           autocomplete="off"
                           required />

                    <ul class="list-group patient-suggestions"></ul>
                </div>

                <button type="submit"
                        class="btn modal-btn"
                        style="background:#db2777;color:white;">
                    View Records
                </button>
                                }

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".doctor-search").forEach(function (input) {
                const wrapper = input.closest(".doctor-search-wrapper");
                const box = wrapper.querySelector(".doctor-suggestions");
                const hiddenDoctorId = wrapper.querySelector(".selected-doctor-id");

                input.addEventListener("input", function () {
                    hiddenDoctorId.value = "";

                    const query = input.value.trim();

                    if (query.length < 2) {
                        box.innerHTML = "";
                        return;
                    }

                    fetch("/Doctors/Search?searchValue=" + encodeURIComponent(query))
                        .then(function (response) {
                            return response.json();
                        })
                        .then(function (data) {
                            box.innerHTML = "";

                            if (!data || data.length === 0) {
                                const emptyItem = document.createElement("li");
                                emptyItem.className = "list-group-item doctor-suggestion-empty";
                                emptyItem.innerText = "No doctors found";
                                box.appendChild(emptyItem);
                                return;
                            }

                            data.forEach(function (doctor) {
                                const item = document.createElement("li");
                                item.className = "list-group-item doctor-suggestion-item";

                                item.innerHTML =
                                    "<strong>" + doctor.FullName + "</strong>" +
                                    "<br />ID: " + doctor.DoctorId +
                                    " | " + doctor.Specialisation;

                                item.addEventListener("click", function () {
                                    input.value =
                                        doctor.FullName +
                                        " (ID: " +
                                        doctor.DoctorId +
                                        ")";

                                    hiddenDoctorId.value = doctor.DoctorId;

                                    box.innerHTML = "";
                                });

                                box.appendChild(item);
                            });
                        })
                        .catch(function () {
                            box.innerHTML = "";

                            const errorItem = document.createElement("li");
                            errorItem.className = "list-group-item doctor-suggestion-empty";
                            errorItem.innerText = "Unable to load suggestions";
                            box.appendChild(errorItem);
                        });
                });

                input.closest("form").addEventListener("submit", function (event) {
                    if (!hiddenDoctorId.value) {
                        event.preventDefault();
                        alert("Please select a doctor from the suggestions.");
                    }
                });

                document.addEventListener("click", function (event) {
                    if (!wrapper.contains(event.target)) {
                        box.innerHTML = "";
                    }
                });
            });

        });
    </script>
}