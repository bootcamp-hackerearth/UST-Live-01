@page "/admin/appointments"
@layout AdminLayout

@using HealthCareApp.Shared.Dtos.Appointments
@using HealthCareApp.Shared.Enums
@using HealthCareApp.AdminBlazor.Services.Interfaces
@inject IAuthService AuthService
@inject IAppointmentAdminService AppointmentService
@inject NavigationManager Navigation

<PageTitle>Appointments | HealthAxis Admin</PageTitle>

@if (appointments is null)
{
    <div class="hc-page-loading">
        <div class="hc-loading-card">
            <div class="hc-loading-spinner"></div>
            <p>Loading appointment schedules...</p>
        </div>
    </div>
}
else
{
    <div class="hc-page-heading">
        <div>
            <h1>Appointments</h1>
            <p>View, update, and filter HealthAxis appointment schedules.</p>
        </div>
    </div>

    <div class="hc-doctor-stat-grid ha-management-stat-grid">
        <div class="hc-doctor-stat-card blue ha-management-stat-card">
            <div class="ha-stat-card-content">
                <span>Total Appointments</span>
                <strong>@TotalAppointments</strong>
                <small>Overall appointment records</small>
            </div>
            <div class="ha-stat-card-icon">◷</div>
        </div>

        <div class="hc-doctor-stat-card green ha-management-stat-card">
            <div class="ha-stat-card-content">
                <span>Today</span>
                <strong>@TodayAppointments</strong>
                <small>Scheduled for current day</small>
            </div>
            <div class="ha-stat-card-icon">▣</div>
        </div>

        <div class="hc-doctor-stat-card purple ha-management-stat-card">
            <div class="ha-stat-card-content">
                <span>Upcoming</span>
                <strong>@UpcomingAppointments</strong>
                <small>Future appointment activity</small>
            </div>
            <div class="ha-stat-card-icon">→</div>
        </div>

        <div class="hc-doctor-stat-card red ha-management-stat-card">
            <div class="ha-stat-card-content">
                <span>Cancelled</span>
                <strong>@CancelledAppointments</strong>
                <small>Cancelled appointment count</small>
            </div>
            <div class="ha-stat-card-icon">!</div>
        </div>
    </div>

    <section class="hc-list-panel ha-management-panel">
        <div class="ha-list-panel-header">
            <div>
                <h3>Appointment Directory</h3>
                <p>Search, filter, and review patient-doctor appointment activity.</p>
            </div>

            <span class="ha-result-count">
                Showing @FilteredAppointments.Count() of @TotalAppointments
            </span>
        </div>

        <div class="hc-list-toolbar ha-list-toolbar">
            <div class="hc-search-box">
                <span>⌕</span>
                <input placeholder="Search by patient, doctor, time slot, or cancellation reason..."
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>

            <select class="hc-filter-select" @bind="selectedStatusFilter">
                <option value="all">All Status</option>
                <option value="today">Today</option>
                <option value="upcoming">Upcoming</option>
                <option value="pending">Pending</option>
                <option value="confirmed">Confirmed</option>
                <option value="completed">Completed</option>
                <option value="cancelled">Cancelled</option>
            </select>

            <select class="hc-filter-select" @bind="selectedDoctor">
                <option value="">All Doctors</option>
                @foreach (var doctor in doctors)
                {
                    <option value="@doctor">@doctor</option>
                }
            </select>
        </div>

        @if (!FilteredAppointments.Any())
        {
            <div class="hc-empty-state ha-empty-state">
                <div class="hc-empty-icon">◷</div>
                <h3>No appointment records found</h3>
                <p>Try adjusting search text, status, date, or doctor filters.</p>
            </div>
        }
        else
        {
            <div class="hc-table-wrapper">
                <table class="hc-admin-table ha-management-table">
                    <thead>
                        <tr>
                            <th>Appointment</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Time Slot</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in FilteredAppointments)
                        {
                            var scheduledDate = ParseDate(appointment.ScheduledDate);

                            <tr>
                                <td>
                                    <div class="ha-appointment-id-card">
                                        <strong>#@appointment.AppointmentId</strong>
                                        <span>Appointment record</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="hc-doctor-cell">
                                        <div class="hc-patient-avatar ha-appointment-avatar">
                                            @GetInitials(appointment.PatientName)
                                        </div>

                                        <div>
                                            <strong>@appointment.PatientName</strong>
                                            <span>Patient ID: @appointment.PatientId</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="ha-doctor-reference">
                                        <strong>@appointment.DoctorName</strong>
                                        <span>Doctor ID: @appointment.DoctorId</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="ha-table-strong-text">
                                        @scheduledDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="ha-time-pill">
                                        @appointment.TimeSlot
                                    </span>
                                </td>

                                <td>
                                    <span class="@GetStatusBadgeClass(appointment.Status)">
                                        @appointment.Status
                                    </span>
                                </td>

                                <td>
                                    <div class="hc-table-actions">
                                        <button class="hc-action-btn view"
                                                @onclick="() => GoToAppointmentDetails(appointment.AppointmentId)">
                                            View
                                        </button>

                                        <button class="hc-action-btn edit"
                                                @onclick="() => GoToEditAppointment(appointment.AppointmentId)">
                                            Edit
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private const string AllStatusFilter = "all";
    private const string TodayFilter = "today";
    private const string UpcomingFilter = "upcoming";
    private const string PendingFilter = "pending";
    private const string ConfirmedFilter = "confirmed";
    private const string CompletedFilter = "completed";
    private const string CancelledFilter = "cancelled";

    private List<AppointmentDto>? appointments;

    private string searchTerm = string.Empty;

    private string selectedStatusFilter = AllStatusFilter;

    private string selectedDoctor = string.Empty;

    private List<string> doctors = new();

    private int TotalAppointments => appointments?.Count ?? 0;

    private int TodayAppointments =>
        appointments?.Count(a => ParseDate(a.ScheduledDate).Date == DateTime.Today) ?? 0;

    private int UpcomingAppointments =>
        appointments?.Count(a => ParseDate(a.ScheduledDate).Date > DateTime.Today) ?? 0;

    private int CancelledAppointments =>
        appointments?.Count(a => a.Status == AppointmentStatus.Cancelled) ?? 0;

    private IEnumerable<AppointmentDto> FilteredAppointments
    {
        get
        {
            if (appointments is null)
            {
                return Enumerable.Empty<AppointmentDto>();
            }

            var query = appointments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(a =>
                    (!string.IsNullOrWhiteSpace(a.PatientName) &&
                     a.PatientName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(a.DoctorName) &&
                     a.DoctorName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    a.TimeSlot.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrWhiteSpace(a.CancellationReason) &&
                     a.CancellationReason.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(selectedDoctor))
            {
                query = query.Where(a =>
                    string.Equals(a.DoctorName, selectedDoctor, StringComparison.OrdinalIgnoreCase));
            }

            query = selectedStatusFilter switch
            {
                TodayFilter => query.Where(a => ParseDate(a.ScheduledDate).Date == DateTime.Today),
                UpcomingFilter => query.Where(a => ParseDate(a.ScheduledDate).Date > DateTime.Today),
                PendingFilter => query.Where(a => a.Status == AppointmentStatus.Pending),
                ConfirmedFilter => query.Where(a => a.Status == AppointmentStatus.Confirmed),
                CompletedFilter => query.Where(a => a.Status == AppointmentStatus.Completed),
                CancelledFilter => query.Where(a => a.Status == AppointmentStatus.Cancelled),
                _ => query
            };

            return query
                .OrderByDescending(a => ParseDate(a.ScheduledDate))
                .ThenBy(a => a.TimeSlot);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        appointments = await AppointmentService.GetAllAppointmentsAsync();

        doctors = appointments
            .Where(a => !string.IsNullOrWhiteSpace(a.DoctorName))
            .Select(a => a.DoctorName!)
            .Distinct()
            .OrderBy(d => d)
            .ToList();
    }

    private void GoToEditAppointment(int appointmentId)
    {
        Navigation.NavigateTo($"/admin/appointments/edit/{appointmentId}");
    }

    private void GoToAppointmentDetails(int appointmentId)
    {
        Navigation.NavigateTo($"/admin/appointments/details/{appointmentId}");
    }

    private static DateTime ParseDate(string date)
    {
        return DateTime.TryParse(date, out var parsedDate)
            ? parsedDate
            : DateTime.MinValue;
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "PT";
        }

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpper()
                : parts[0].ToUpper();
        }

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private static string GetStatusBadgeClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending => "hc-status-badge pending ha-appointment-status",
            AppointmentStatus.Confirmed => "hc-status-badge confirmed ha-appointment-status",
            AppointmentStatus.Completed => "hc-status-badge completed ha-appointment-status",
            AppointmentStatus.Cancelled => "hc-status-badge cancelled ha-appointment-status",
            _ => "hc-status-badge ha-appointment-status"
        };
    }
}