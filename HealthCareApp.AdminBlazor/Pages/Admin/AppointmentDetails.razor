@page "/admin/appointments/details/{appointmentId:int}"
@layout AdminLayout

@using HealthCareApp.Shared.Dtos.Appointments
@using HealthCareApp.Shared.Enums
@using HealthCareApp.AdminBlazor.Services.Interfaces

@inject IAuthService AuthService
@inject IAppointmentAdminService AppointmentService
@inject NavigationManager Navigation

<PageTitle>Appointment Details | HealthAxis Admin</PageTitle>

<div class="hc-page-heading">
    <div>
        <h1>Appointment Details</h1>

        <p>Review appointment schedule, patient, doctor, status, and cancellation information.</p>
    </div>

    <button class="hc-secondary-btn" @onclick="BackToAppointments">
        Back to Appointments
    </button>
</div>

@if (isLoading)
{
    <div class="hc-page-loading">
        <div class="hc-loading-card">
            <div class="hc-loading-spinner"></div>

            <p>Loading appointment details...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="hc-alert-error">
        @errorMessage
    </div>

    <button class="hc-secondary-btn mt-3" @onclick="BackToAppointments">
        Back to Appointments
    </button>
}
else if (appointment is not null)
{
    <section class="hc-details-shell">
        <div class="hc-details-hero">
            <div class="hc-details-avatar appointment">
                ◷
            </div>

            <div>
                <h2>Appointment #@appointment.AppointmentId</h2>

                <p>@appointment.PatientName with @appointment.DoctorName</p>

                <div class="hc-details-badge-row">
                    <span class="@GetStatusBadgeClass(appointment.Status)">
                        @appointment.Status
                    </span>

                    @if (scheduledDate.Date == DateTime.Today)
                    {
                        <span class="hc-status-badge confirmed">
                            Today
                        </span>
                    }
                    else if (scheduledDate.Date > DateTime.Today)
                    {
                        <span class="hc-status-badge pending">
                            Upcoming
                        </span>
                    }
                    else
                    {
                        <span class="hc-status-badge completed">
                            Past
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="hc-details-grid">
            <div class="hc-details-card">
                <span>Appointment ID</span>

                <strong>@appointment.AppointmentId</strong>
            </div>

            <div class="hc-details-card">
                <span>Patient</span>

                <strong>@appointment.PatientName</strong>
            </div>

            <div class="hc-details-card">
                <span>Patient ID</span>

                <strong>@appointment.PatientId</strong>
            </div>

            <div class="hc-details-card">
                <span>Doctor</span>

                <strong>@appointment.DoctorName</strong>
            </div>

            <div class="hc-details-card">
                <span>Doctor ID</span>

                <strong>@appointment.DoctorId</strong>
            </div>

            <div class="hc-details-card">
                <span>Scheduled Date</span>

                <strong>@FormatDate(scheduledDate)</strong>
            </div>

            <div class="hc-details-card">
                <span>Time Slot</span>

                <strong>@appointment.TimeSlot</strong>
            </div>

            <div class="hc-details-card">
                <span>Status</span>

                <strong>@appointment.Status</strong>
            </div>
        </div>

        @if (appointment.Status == AppointmentStatus.Cancelled)
        {
            <div class="hc-details-note">
                <span>Cancellation Reason</span>

                <p>
                    @(string.IsNullOrWhiteSpace(appointment.CancellationReason)
                        ? "No cancellation reason provided."
                        : appointment.CancellationReason)
                </p>
            </div>
        }

        <div class="hc-details-actions">
            <button class="hc-secondary-btn" @onclick="BackToAppointments">
                Back
            </button>
        </div>
    </section>
}

@code {
    [Parameter]
    public int appointmentId { get; set; }

    private AppointmentDto? appointment;

    private DateTime scheduledDate;

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");

            return;
        }

        await LoadAppointment();
    }

    private async Task LoadAppointment()
    {
        try
        {
            isLoading = true;

            errorMessage = null;

            appointment = await AppointmentService.GetAppointmentByIdAsync(appointmentId);

            if (appointment is null)
            {
                errorMessage = "Appointment was not found.";

                return;
            }

            if (!DateTime.TryParse(appointment.ScheduledDate, out scheduledDate))
            {
                scheduledDate = DateTime.MinValue;
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to load appointment details. Please check whether the API is running.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BackToAppointments()
    {
        Navigation.NavigateTo("/admin/appointments");
    }

    private static string FormatDate(DateTime date)
    {
        if (date == DateTime.MinValue)
        {
            return "Not Available";
        }

        return date.ToString("dd MMM yyyy");
    }

    private static string GetStatusBadgeClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending =>
                "hc-status-badge pending",

            AppointmentStatus.Confirmed =>
                "hc-status-badge confirmed",

            AppointmentStatus.Completed =>
                "hc-status-badge completed",

            AppointmentStatus.Cancelled =>
                "hc-status-badge cancelled",

            _ =>
                "hc-status-badge"
        };
    }
}