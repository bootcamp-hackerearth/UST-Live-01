@page "/admin/doctors/edit/{doctorId:int}"
@layout AdminLayout
@implements IDisposable

@using Microsoft.AspNetCore.Components.Forms
@using HealthCareApp.Shared.Dtos.Doctors
@using HealthCareApp.Shared.Enums
@using HealthCareApp.AdminBlazor.Services.Interfaces
@using System.Globalization

@inject IAuthService AuthService
@inject IDoctorAdminService DoctorService
@inject NavigationManager Navigation
@inject IToastService ToastService

<PageTitle>Edit Doctor | HealthAxis Admin</PageTitle>

<div class="hc-page-heading">
    <div>
        <h1>Edit Doctor</h1>

        <p>Update doctor profile, specialisation, consultation fee, and status.</p>
    </div>

    <button class="hc-secondary-btn" @onclick="BackToDoctors">
        Back to Doctors
    </button>
</div>

@if (isLoading)
{
    <div class="hc-page-loading">
        <div class="hc-loading-card">
            <div class="hc-loading-spinner"></div>

            <p>Loading doctor details...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage) && editContext is null)
{
    <div class="hc-alert-error">
        @errorMessage
    </div>

    <button class="hc-secondary-btn mt-3" @onclick="BackToDoctors">
        Back to Doctors
    </button>
}
else
{
    <section class="hc-form-shell">
        <div class="hc-form-card">
            <div class="hc-form-card-header">
                <div class="hc-form-icon">✎</div>

                <div>
                    <h3>Update Doctor Profile</h3>

                    <p>Changes made here will update the selected doctor profile in the admin workspace.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(existingEmail))
            {
                <div class="hc-details-note mb-3">
                    <span>Email Address</span>

                    <p>@existingEmail</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="hc-alert-error">
                    @errorMessage
                </div>
            }

            @if (editContext is not null)
            {
                <EditForm EditContext="editContext" OnValidSubmit="UpdateDoctor">
                    <DataAnnotationsValidator />

                    <div class="hc-form-grid">
                        <div class="hc-form-group">
                            <label class="hc-form-label">Full Name</label>

                            <InputText class="hc-form-control"
                                       placeholder="Enter doctor full name"
                                       @bind-Value="doctor.FullName" />

                            <ValidationMessage For="@(() => doctor.FullName)" />
                        </div>

                        <div class="hc-form-group">
                            <label class="hc-form-label">Specialisation</label>

                            <InputSelect class="hc-form-control"
                                         @bind-Value="doctor.Specialisation">
                                @foreach (var specialisation in Enum.GetValues<SpecialisationType>())
                                {
                                    <option value="@specialisation">
                                        @specialisation
                                    </option>
                                }
                            </InputSelect>

                            <ValidationMessage For="@(() => doctor.Specialisation)" />
                        </div>

                        <div class="hc-form-group">
                            <label class="hc-form-label">Practice Start Date</label>

                            <InputDate class="hc-form-control"
                                       max="@TodayDateInputValue"
                                       @bind-Value="doctor.PracticeStartDate" />

                            <ValidationMessage For="@(() => doctor.PracticeStartDate)" />
                        </div>

                        <div class="hc-form-group">
                            <label class="hc-form-label">Consultation Fee</label>

                            <InputNumber class="hc-form-control"
                                         @bind-Value="doctor.ConsultationFee" />

                            <ValidationMessage For="@(() => doctor.ConsultationFee)" />
                        </div>

                        <div class="hc-form-group">
                            <label class="hc-form-label">Status</label>

                            <label class="hc-switch-row">
                                <InputCheckbox @bind-Value="doctor.IsActive" />

                                <span>
                                    @(doctor.IsActive ? "Active doctor" : "Inactive doctor")
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="hc-form-actions">
                        <button type="submit"
                                class="hc-page-primary-btn"
                                disabled="@isSaving">
                            @(isSaving ? "Updating Doctor..." : "Update Doctor")
                        </button>

                        <button type="button"
                                class="hc-secondary-btn"
                                disabled="@isSaving"
                                @onclick="BackToDoctors">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public int doctorId { get; set; }

    private UpdateDoctorDto doctor = new()
    {
        Specialisation = SpecialisationType.GeneralPractitioner,

        PracticeStartDate = DateTime.Today.AddYears(-1)
    };

    private EditContext? editContext;

    private ValidationMessageStore? validationMessageStore;

    private bool isLoading = true;

    private bool isSaving;

    private string? errorMessage;

    private string? existingEmail;

    private static string TodayDateInputValue
    {
        get
        {
            return DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            Navigation.NavigateTo(
                "/login?sessionExpired=true",
                replace: true);

            return;
        }

        await LoadDoctor();
    }

    private async Task LoadDoctor()
    {
        try
        {
            isLoading = true;

            errorMessage = null;

            var existingDoctor = await DoctorService.GetDoctorByIdAsync(doctorId);

            if (existingDoctor is null)
            {
                errorMessage = "Doctor profile was not found.";

                return;
            }

            existingEmail = existingDoctor.Email;

            doctor = new UpdateDoctorDto
            {
                FullName = existingDoctor.FullName,

                Specialisation = existingDoctor.Specialisation,

                PracticeStartDate = CalculatePracticeStartDate(existingDoctor.YearsOfExperience),

                ConsultationFee = existingDoctor.ConsultationFee,

                IsActive = existingDoctor.IsActive
            };

            InitializeEditContext();
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to load doctor details. Please check whether the API is running.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load doctor details. {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void InitializeEditContext()
    {
        if (editContext is not null)
        {
            editContext.OnValidationRequested -= HandleValidationRequested;

            editContext.OnFieldChanged -= HandleFieldChanged;
        }

        editContext = new EditContext(doctor);

        validationMessageStore = new ValidationMessageStore(editContext);

        editContext.OnValidationRequested += HandleValidationRequested;

        editContext.OnFieldChanged += HandleFieldChanged;
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs args)
    {
        ValidatePracticeStartDateField();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        if (args.FieldIdentifier.FieldName == nameof(doctor.PracticeStartDate))
        {
            ValidatePracticeStartDateField();
        }
    }

    private void ValidatePracticeStartDateField()
    {
        if (editContext is null || validationMessageStore is null)
        {
            return;
        }

        var fieldIdentifier = FieldIdentifier.Create(() => doctor.PracticeStartDate);

        validationMessageStore.Clear(fieldIdentifier);

        if (doctor.PracticeStartDate.Date > DateTime.Today)
        {
            validationMessageStore.Add(
                fieldIdentifier,
                "Practice start date cannot be in the future.");
        }

        editContext.NotifyValidationStateChanged();
    }

    private async Task UpdateDoctor()
    {
        if (isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;

            errorMessage = null;

            ValidatePracticeStartDateField();

            if (editContext is not null && editContext.GetValidationMessages().Any())
            {
                return;
            }

            var updatedDoctor = await DoctorService.UpdateDoctorAsync(doctorId, doctor);

            if (updatedDoctor is null)
            {
                errorMessage = "Unable to update doctor. Doctor profile was not found.";

                return;
            }

            ToastService.ShowSuccess(
                "Doctor Updated",
                $"{updatedDoctor.FullName} was updated successfully.");

            Navigation.NavigateTo("/admin/doctors");
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = GetFriendlyUpdateDoctorErrorMessage(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to update doctor. {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string GetFriendlyUpdateDoctorErrorMessage(string exceptionMessage)
    {
        if (exceptionMessage.Contains("400", StringComparison.OrdinalIgnoreCase) ||
            exceptionMessage.Contains("BadRequest", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to update doctor. Please check the entered doctor details.";
        }

        if (exceptionMessage.Contains("401", StringComparison.OrdinalIgnoreCase) ||
            exceptionMessage.Contains("403", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to update doctor. Your admin session is not authorized.";
        }

        if (exceptionMessage.Contains("404", StringComparison.OrdinalIgnoreCase) ||
            exceptionMessage.Contains("NotFound", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to update doctor. Doctor profile was not found.";
        }

        return "Unable to update doctor. Please try again.";
    }

    private void BackToDoctors()
    {
        Navigation.NavigateTo("/admin/doctors");
    }

    private static DateTime CalculatePracticeStartDate(int yearsOfExperience)
    {
        if (yearsOfExperience < 0)
        {
            yearsOfExperience = 0;
        }

        return DateTime.Today.AddYears(-yearsOfExperience);
    }

    public void Dispose()
    {
        if (editContext is not null)
        {
            editContext.OnValidationRequested -= HandleValidationRequested;

            editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }
}