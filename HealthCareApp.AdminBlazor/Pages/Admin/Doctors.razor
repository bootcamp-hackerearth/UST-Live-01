@page "/admin/doctors"
@layout AdminLayout
@implements IAsyncDisposable

@using HealthCareApp.Shared.Dtos.Doctors
@using HealthCareApp.Shared.Dtos.Pagination
@using HealthCareApp.Shared.Enums
@using HealthCareApp.AdminBlazor.Services.Interfaces
@using System.Globalization

@inject IAuthService AuthService
@inject IDoctorAdminService DoctorService
@inject NavigationManager Navigation
@inject IToastService ToastService

<PageTitle>Doctors | HealthAxis Admin</PageTitle>

@if (isLoading)
{
    <div class="hc-page-loading">
        <div class="hc-loading-card">
            <div class="hc-loading-spinner"></div>

            <p>Loading doctors from database...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="hc-alert-error">
        @errorMessage
    </div>
}
else
{
    <div class="hc-page-heading">
        <div>
            <h1>Doctors</h1>

            <p>Register, update, activate, and manage HealthAxis doctor profiles.</p>
        </div>

        <button class="hc-page-primary-btn" @onclick="GoToAddDoctor">
            + Add Doctor
        </button>
    </div>

    <div class="hc-doctor-stat-grid">
        <div class="hc-doctor-stat-card blue">
            <span>Total Matching Doctors</span>

            <strong>@totalRecords</strong>
        </div>

        <div class="hc-doctor-stat-card green">
            <span>Active On This Page</span>

            <strong>@doctors.Count(doctor => doctor.IsActive)</strong>
        </div>

        <div class="hc-doctor-stat-card red">
            <span>Inactive On This Page</span>

            <strong>@doctors.Count(doctor => !doctor.IsActive)</strong>
        </div>

        <div class="hc-doctor-stat-card purple">
            <span>Page</span>

            <strong>@currentPage / @totalPages</strong>
        </div>
    </div>

    <section class="hc-list-panel">
        <div class="ha-list-panel-header">
            <div>
                <h3>Doctor Directory</h3>

                <p>Search and filter doctor records directly from backend data.</p>
            </div>

            <span class="ha-result-count">
                Showing @StartRecord to @EndRecord of @totalRecords
            </span>
        </div>

        <div class="hc-list-toolbar">
            <div class="hc-search-box">
                <span>⌕</span>

                <input placeholder="Search doctor by name or email..."
                       value="@searchTerm"
                       @oninput="OnSearchChanged" />
            </div>

            <select class="hc-filter-select"
                    value="@selectedSpecialisation"
                    @onchange="OnSpecialisationChanged">
                <option value="">All Specialisations</option>

                @foreach (var specialisation in Enum.GetValues<SpecialisationType>())
                {
                    <option value="@specialisation">@specialisation</option>
                }
            </select>

            <select class="hc-filter-select"
                    value="@selectedStatus"
                    @onchange="OnStatusChanged">
                <option value="">All Status</option>

                <option value="active">Active</option>

                <option value="inactive">Inactive</option>
            </select>
        </div>

        <div class="hc-form-actions" style="margin-top: 0; margin-bottom: 20px;">
            <select class="hc-filter-select"
                    value="@pageSize"
                    @onchange="OnPageSizeChanged">
                <option value="5">5 per page</option>

                <option value="10">10 per page</option>

                <option value="20">20 per page</option>

                <option value="50">50 per page</option>
            </select>

            <button type="button"
                    class="hc-secondary-btn"
                    @onclick="ClearFilters">
                Clear Filters
            </button>
        </div>

        @if (!doctors.Any())
        {
            <div class="hc-empty-state">
                <div class="hc-empty-icon">✚</div>

                <h3>No doctors found</h3>

                <p>Try changing the search text, specialisation, or status filters.</p>
            </div>
        }
        else
        {
            <div class="hc-table-wrapper">
                <table class="hc-admin-table">
                    <thead>
                        <tr>
                            <th>Doctor</th>

                            <th>Specialisation</th>

                            <th>Experience</th>

                            <th>Consultation Fee</th>

                            <th>Status</th>

                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var doctor in doctors)
                        {
                            <tr>
                                <td>
                                    <div class="hc-doctor-cell">
                                        <div class="hc-doctor-avatar">
                                            @GetInitials(doctor.FullName)
                                        </div>

                                        <div>
                                            <strong>@doctor.FullName</strong>

                                            <span>@doctor.Email</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="hc-specialisation-pill">
                                        @doctor.Specialisation
                                    </span>
                                </td>

                                <td>
                                    @doctor.YearsOfExperience years
                                </td>

                                <td>
                                    ₹@doctor.ConsultationFee
                                </td>

                                <td>
                                    @if (doctor.IsActive)
                                    {
                                        <span class="hc-status-badge active">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hc-status-badge inactive">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="hc-table-actions">
                                        <button class="hc-action-btn edit"
                                                @onclick="() => GoToEditDoctor(doctor.DoctorId)">
                                            Edit
                                        </button>

                                        <button class="@GetToggleButtonClass(doctor.IsActive)"
                                                @onclick="() => ShowStatusConfirmation(doctor.DoctorId, doctor.FullName, doctor.IsActive)">
                                            @(doctor.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="hc-form-actions" style="justify-content: space-between; margin-top: 22px;">
                <button type="button"
                        class="hc-secondary-btn"
                        disabled="@(currentPage <= 1)"
                        @onclick="PreviousPage">
                    Previous
                </button>

                <div style="font-weight: 900; color: #334155;">
                    Page @currentPage of @totalPages
                </div>

                <button type="button"
                        class="hc-secondary-btn"
                        disabled="@(currentPage >= totalPages)"
                        @onclick="NextPage">
                    Next
                </button>
            </div>
        }
    </section>

    @if (showStatusConfirmation)
    {
        <div class="ha-modal-backdrop">
            <div class="ha-logout-modal">
                <div class="ha-logout-icon">
                    HA
                </div>

                <h3>
                    @(selectedDoctorCurrentStatus ? "Deactivate Doctor?" : "Activate Doctor?")
                </h3>

                <p>
                    @(selectedDoctorCurrentStatus
                        ? $"Doctor {selectedDoctorNameForStatusChange} will be marked as inactive and will not be available as an active doctor."
                        : $"Doctor {selectedDoctorNameForStatusChange} will be marked as active and available again.")
                </p>

                <div class="ha-logout-actions">
                    <button class="ha-modal-secondary-btn"
                            disabled="@isUpdatingDoctorStatus"
                            @onclick="HideStatusConfirmation">
                        Cancel
                    </button>

                    <button class="@ConfirmStatusButtonClass"
                            disabled="@isUpdatingDoctorStatus"
                            @onclick="ConfirmDoctorStatusChange">
                        @DoctorStatusConfirmationButtonText
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private CancellationTokenSource? searchCancellationTokenSource;

    private List<DoctorDto> doctors = new();

    private bool showStatusConfirmation;

    private bool isUpdatingDoctorStatus;

    private int selectedDoctorIdForStatusChange;

    private string selectedDoctorNameForStatusChange = string.Empty;

    private bool selectedDoctorCurrentStatus;

    private string searchTerm = string.Empty;

    private string selectedSpecialisation = string.Empty;

    private string selectedStatus = string.Empty;

    private int currentPage = 1;

    private int pageSize = 10;

    private int totalRecords;

    private int totalPages = 1;

    private bool isLoading = true;

    private string? errorMessage;

    private int StartRecord
    {
        get
        {
            if (totalRecords == 0)
            {
                return 0;
            }

            return ((currentPage - 1) * pageSize) + 1;
        }
    }

    private int EndRecord
    {
        get
        {
            int calculatedEnd = currentPage * pageSize;

            if (calculatedEnd > totalRecords)
            {
                return totalRecords;
            }

            return calculatedEnd;
        }
    }

    private string ConfirmStatusButtonClass
    {
        get
        {
            return selectedDoctorCurrentStatus
                ? "ha-modal-danger-btn"
                : "hc-page-primary-btn";
        }
    }

    private string DoctorStatusConfirmationButtonText
    {
        get
        {
            if (isUpdatingDoctorStatus)
            {
                return "Updating...";
            }

            if (selectedDoctorCurrentStatus)
            {
                return "Yes, Deactivate";
            }

            return "Yes, Activate";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            Navigation.NavigateTo(
                "/login?sessionExpired=true",
                replace: true);

            return;
        }

        await LoadDoctorsAsync();
    }

    private async Task LoadDoctorsAsync(bool showFullPageLoader = true)
    {
        try
        {
            if (showFullPageLoader)
            {
                isLoading = true;
            }

            errorMessage = null;

            var query = BuildDoctorQuery();

            var response = await DoctorService.GetDoctorsPagedAsync(query);

            doctors = response.Items ?? new List<DoctorDto>();

            currentPage = response.PageNumber;

            pageSize = response.PageSize;

            totalRecords = response.TotalRecords;

            totalPages = response.TotalPages <= 0 ? 1 : response.TotalPages;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;

            ToastService.ShowError(
                "Authorization Error",
                ex.Message);
        }
        catch (System.Net.Http.HttpRequestException)
        {
            errorMessage = "Unable to load doctors. Please check whether the API is running.";

            ToastService.ShowError(
                "Unable to Load Doctors",
                "Please check whether the API is running.");
        }
        finally
        {
            if (showFullPageLoader)
            {
                isLoading = false;
            }
        }
    }

    private DoctorPaginationQueryDto BuildDoctorQuery()
    {
        var query = new DoctorPaginationQueryDto
        {
            PageNumber = currentPage,

            PageSize = pageSize,

            SearchTerm = string.IsNullOrWhiteSpace(searchTerm)
                ? null
                : searchTerm.Trim()
        };

        if (Enum.TryParse<SpecialisationType>(selectedSpecialisation, out var specialisation))
        {
            query.Specialisation = specialisation;
        }

        if (selectedStatus == "active")
        {
            query.IsActive = true;
        }
        else if (selectedStatus == "inactive")
        {
            query.IsActive = false;
        }

        return query;
    }

    private async Task OnSearchChanged(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;

        currentPage = 1;

        if (searchCancellationTokenSource is not null)
        {
            await searchCancellationTokenSource.CancelAsync();
            searchCancellationTokenSource.Dispose();
        }

        searchCancellationTokenSource = new CancellationTokenSource();

        var currentSearchToken = searchCancellationTokenSource.Token;

        try
        {
            await Task.Delay(400, currentSearchToken);

            await LoadDoctorsAsync(showFullPageLoader: false);
        }
        catch (TaskCanceledException)
        {
            // Search debounce was cancelled because the user typed again.
        }
    }

    private async Task OnSpecialisationChanged(ChangeEventArgs args)
    {
        selectedSpecialisation = args.Value?.ToString() ?? string.Empty;

        currentPage = 1;

        await LoadDoctorsAsync(showFullPageLoader: false);
    }

    private async Task OnStatusChanged(ChangeEventArgs args)
    {
        selectedStatus = args.Value?.ToString() ?? string.Empty;

        currentPage = 1;

        await LoadDoctorsAsync(showFullPageLoader: false);
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(
                args.Value?.ToString(),
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out var selectedPageSize))
        {
            pageSize = selectedPageSize;

            currentPage = 1;

            await LoadDoctorsAsync(showFullPageLoader: false);
        }
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;

        selectedSpecialisation = string.Empty;

        selectedStatus = string.Empty;

        currentPage = 1;

        await LoadDoctorsAsync(showFullPageLoader: false);
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;

        await LoadDoctorsAsync(showFullPageLoader: false);
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;

        await LoadDoctorsAsync(showFullPageLoader: false);
    }

    private void GoToAddDoctor()
    {
        Navigation.NavigateTo("/admin/doctors/add");
    }

    private void GoToEditDoctor(int doctorId)
    {
        Navigation.NavigateTo($"/admin/doctors/edit/{doctorId}");
    }

    private void ShowStatusConfirmation(
        int doctorId,
        string doctorName,
        bool currentStatus)
    {
        selectedDoctorIdForStatusChange = doctorId;

        selectedDoctorNameForStatusChange = doctorName;

        selectedDoctorCurrentStatus = currentStatus;

        showStatusConfirmation = true;
    }

    private void HideStatusConfirmation()
    {
        if (isUpdatingDoctorStatus)
        {
            return;
        }

        showStatusConfirmation = false;

        selectedDoctorIdForStatusChange = 0;

        selectedDoctorNameForStatusChange = string.Empty;

        selectedDoctorCurrentStatus = false;
    }

    private async Task ConfirmDoctorStatusChange()
    {
        if (isUpdatingDoctorStatus)
        {
            return;
        }

        try
        {
            isUpdatingDoctorStatus = true;

            errorMessage = null;

            var wasActive = selectedDoctorCurrentStatus;

            var updatedDoctor = await DoctorService.ToggleDoctorStatusAsync(
                selectedDoctorIdForStatusChange);

            if (updatedDoctor is not null)
            {
                await LoadDoctorsAsync(showFullPageLoader: false);

                ToastService.ShowSuccess(
                    wasActive ? "Doctor Deactivated" : "Doctor Activated",
                    wasActive
                        ? $"{selectedDoctorNameForStatusChange} is now inactive."
                        : $"{selectedDoctorNameForStatusChange} is now active.");
            }

            showStatusConfirmation = false;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;

            ToastService.ShowError(
                "Authorization Error",
                ex.Message);
        }
        catch (System.Net.Http.HttpRequestException)
        {
            errorMessage = "Unable to update doctor status. Please try again.";

            ToastService.ShowError(
                "Status Update Failed",
                "Unable to update doctor status. Please try again.");
        }
        finally
        {
            isUpdatingDoctorStatus = false;
        }
    }

    private static string GetToggleButtonClass(bool isActive)
    {
        return isActive
            ? "hc-action-btn deactivate"
            : "hc-action-btn activate";
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "DR";
        }

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            if (parts[0].Length >= 2)
            {
                return parts[0][..2].ToUpper(CultureInfo.InvariantCulture);
            }

            return parts[0].ToUpper(CultureInfo.InvariantCulture);
        }

        return $"{parts[0][0]}{parts[1][0]}".ToUpper(CultureInfo.InvariantCulture);
    }

    public async ValueTask DisposeAsync()
    {
        if (searchCancellationTokenSource is not null)
        {
            await searchCancellationTokenSource.CancelAsync();
            searchCancellationTokenSource.Dispose();
        }
    }
}