@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout

@using HealthCareApp.Shared.Dtos.Dashboard
@using HealthCareApp.AdminBlazor.Services.Interfaces
@inject IAuthService AuthService
@inject IAdminDashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard | HealthAxis</PageTitle>

@if (isLoading)
{
    <div class="hc-page-loading">
        <div class="hc-loading-card">
            <div class="hc-loading-spinner"></div>
            <p>Loading HealthAxis dashboard...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="hc-alert-error">
        @errorMessage
    </div>
}
else if (dashboardReport is not null)
{
    <div class="hc-page-heading">
        <div>
            <h1>Dashboard</h1>
            <p>Monitor today’s HealthAxis operations and manage admin activity.</p>
        </div>

        <div class="hc-dashboard-date-card">
            <span>Today</span>
            <strong>@DateTime.Today.ToString("dd-MMM-yyyy")</strong>
        </div>
    </div>

    <div class="hc-report-grid ha-dashboard-report-grid">
        <div class="hc-report-card hc-report-blue ha-dashboard-report-card">
            <div class="hc-report-icon ha-dashboard-report-icon" aria-hidden="true">
                <!-- Doctor icon (simple person + stethoscope) -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="9" cy="8" r="3" fill="#041023" />
                    <path d="M3 20c0-3 4-5 6-5s6 2 6 5" fill="#041023" />
                    <path d="M16.5 11.5c1 0 2.5-0.2 3.5-1.2 1-1 1-2.6 0-3.6-1-1-2.6-1-3.6 0-1 1-1.2 2.5-1.2 3.5" stroke="#041023" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div>
                <p>Total Doctors</p>
                <h2>@dashboardReport.TotalDoctors</h2>
                <span class="ha-dashboard-card-meta">Registered doctor profiles</span>
            </div>
        </div>

        <div class="hc-report-card hc-report-teal ha-dashboard-report-card">
            <div class="hc-report-icon ha-dashboard-report-icon" aria-hidden="true">
                <!-- Patient icon (two-user silhouettes) -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="8" cy="8" r="3" fill="#041023" />
                    <path d="M2 20c1.5-2.5 6-3 6-3s4.5 0.5 6 3" fill="#041023" />
                    <circle cx="16.5" cy="9" r="2.2" fill="#041023" />
                    <path d="M13 19c1-1.8 4-2 4-2s2 0 3 2" fill="#041023" />
                </svg>
            </div>
            <div>
                <p>Total Patients</p>
                <h2>@dashboardReport.TotalPatients</h2>
                <span class="ha-dashboard-card-meta">Patient records managed</span>
            </div>
        </div>

        <div class="hc-report-card hc-report-purple ha-dashboard-report-card">
            <div class="hc-report-icon ha-dashboard-report-icon" aria-hidden="true">
                <!-- Appointments icon (calendar) -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="4" width="18" height="17" rx="2" stroke="#041023" stroke-width="1.4" fill="none" />
                    <path d="M16 2v4M8 2v4" stroke="#041023" stroke-width="1.4" stroke-linecap="round" />
                    <path d="M7 11h5v5H7z" fill="#041023" />
                </svg>
            </div>
            <div>
                <p>Total Appointments</p>
                <h2>@dashboardReport.TotalAppointments</h2>
                <span class="ha-dashboard-card-meta">Overall appointment activity</span>
            </div>
        </div>

        <div class="hc-report-card hc-report-orange ha-dashboard-report-card">
            <div class="hc-report-icon ha-dashboard-report-icon" aria-hidden="true">
                <!-- Today's schedule icon (clock) -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="8" stroke="#041023" stroke-width="1.4" fill="none" />
                    <path d="M12 8v5l3 2" stroke="#041023" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div>
                <p>Today’s Schedule</p>
                <h2>@dashboardReport.TodaysAppointments</h2>
                <span class="ha-dashboard-card-meta">Appointments planned today</span>
            </div>
        </div>
    </div>

    <div class="hc-section-grid">
        <section class="hc-dashboard-section ha-dashboard-panel">
            <div class="hc-section-header">
                <div>
                    <h3>Today’s Overview</h3>
                    <p>Live operational summary for the current day.</p>
                </div>
            </div>

            <div class="hc-mini-report-grid">
                <div class="hc-mini-card ha-mini-card">
                    <span class="hc-mini-label">Today’s Appointments</span>
                    <strong>@dashboardReport.TodaysAppointments</strong>
                    <p>Scheduled for today</p>
                </div>

                <div class="hc-mini-card ha-mini-card">
                    <span class="hc-mini-label">Today’s Patients</span>
                    <strong>@dashboardReport.TodaysPatients</strong>
                    <p>Patient activity today</p>
                </div>

                <div class="hc-mini-card success ha-mini-card">
                    <span class="hc-mini-label">Completed Today</span>
                    <strong>@dashboardReport.CompletedToday</strong>
                    <p>Completed appointment count</p>
                </div>

                <div class="hc-mini-card warning ha-mini-card">
                    <span class="hc-mini-label">Pending Today</span>
                    <strong>@dashboardReport.PendingToday</strong>
                    <p>Waiting for confirmation</p>
                </div>

                <div class="hc-mini-card danger ha-mini-card">
                    <span class="hc-mini-label">Cancelled Today</span>
                    <strong>@dashboardReport.CancelledToday</strong>
                    <p>Cancelled appointment count</p>
                </div>
            </div>
        </section>

        <section class="hc-dashboard-section ha-dashboard-panel">
            <div class="hc-section-header">
                <div>
                    <h3>Quick Actions</h3>
                    <p>Jump into frequent HealthAxis admin tasks.</p>
                </div>
            </div>

            <div class="hc-quick-actions">
                <button class="hc-action-card ha-action-card" @onclick="GoToDoctors">
                    <span>✚</span>
                    <div>
                        <strong>Manage Doctors</strong>
                        <p>Add, update, and activate doctor profiles.</p>
                    </div>
                </button>

                <button class="hc-action-card ha-action-card" @onclick="GoToPatients">
                    <span>◉</span>
                    <div>
                        <strong>View Patients</strong>
                        <p>Review patient profiles and demographic details.</p>
                    </div>
                </button>

                <button class="hc-action-card ha-action-card" @onclick="GoToAppointments">
                    <span>◷</span>
                    <div>
                        <strong>Manage Appointments</strong>
                        <p>Book appointments and review appointment status.</p>
                    </div>
                </button>
            </div>
        </section>
    </div>
}

@code {
    private AdminDashboardReportDto? dashboardReport;

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadDashboardReport();
    }

    private async Task LoadDashboardReport()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            dashboardReport = await DashboardService.GetDashboardReportAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to load dashboard data. Please check whether the API is running.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToDoctors()
    {
        Navigation.NavigateTo("/admin/doctors");
    }

    private void GoToPatients()
    {
        Navigation.NavigateTo("/admin/patients");
    }

    private void GoToAppointments()
    {
        Navigation.NavigateTo("/admin/appointments");
    }
}