@page "/admin/doctors/add"
@layout AdminLayout

@using HealthCareApp.AdminBlazor.Dtos.Doctors
@using HealthCareApp.AdminBlazor.Services.Interfaces
@inject IAuthService AuthService
@inject IDoctorAdminService DoctorService
@inject NavigationManager Navigation

<PageTitle>Add Doctor | HealthCareApp Admin</PageTitle>

<div class="hc-page-heading">
    <div>
        <h1>Add Doctor</h1>
        <p>Register a new doctor profile for the healthcare system.</p>
    </div>

    <button class="hc-secondary-btn" @onclick="BackToDoctors">
        Back to Doctors
    </button>
</div>

<section class="hc-form-shell">
    <div class="hc-form-card">
        <div class="hc-form-card-header">
            <div class="hc-form-icon">✚</div>
            <div>
                <h3>Doctor Registration</h3>
                <p>Enter doctor details carefully. Login credential flow will be connected with API later.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="hc-alert-error">
                @errorMessage
            </div>
        }

        <EditForm Model="doctor" OnValidSubmit="SaveDoctor">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="hc-form-grid">
                <div class="hc-form-group">
                    <label class="hc-form-label">Full Name</label>
                    <InputText class="hc-form-control"
                               placeholder="Enter doctor full name"
                               @bind-Value="doctor.FullName" />
                    <ValidationMessage For="@(() => doctor.FullName)" />
                </div>

                <div class="hc-form-group">
                    <label class="hc-form-label">Email Address</label>
                    <InputText class="hc-form-control"
                               placeholder="doctor@example.com"
                               @bind-Value="doctor.Email" />
                    <ValidationMessage For="@(() => doctor.Email)" />
                </div>

                <div class="hc-form-group">
                    <label class="hc-form-label">Specialisation</label>
                    <InputSelect class="hc-form-control"
                                 @bind-Value="doctor.Specialisation">
                        <option value="">-- Select Specialisation --</option>
                        @foreach (var specialisation in specialisations)
                        {
                            <option value="@specialisation">@specialisation</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => doctor.Specialisation)" />
                </div>

                <div class="hc-form-group">
                    <label class="hc-form-label">Years Of Experience</label>
                    <InputNumber class="hc-form-control"
                                 @bind-Value="doctor.YearsOfExperience" />
                    <ValidationMessage For="@(() => doctor.YearsOfExperience)" />
                </div>

                <div class="hc-form-group">
                    <label class="hc-form-label">Consultation Fee</label>
                    <InputNumber class="hc-form-control"
                                 @bind-Value="doctor.ConsultationFee" />
                    <ValidationMessage For="@(() => doctor.ConsultationFee)" />
                </div>

                <div class="hc-form-group">
                    <label class="hc-form-label">Status</label>

                    <label class="hc-switch-row">
                        <InputCheckbox @bind-Value="doctor.IsActive" />
                        <span>@(doctor.IsActive ? "Active doctor" : "Inactive doctor")</span>
                    </label>
                </div>
            </div>

            <div class="hc-form-actions">
                <button type="submit" class="hc-page-primary-btn">
                    Save Doctor
                </button>

                <button type="button" class="hc-secondary-btn" @onclick="BackToDoctors">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
</section>

@code {
    private CreateDoctorDto doctor = new()
    {
        IsActive = true
    };

    private string? errorMessage;

    private readonly List<string> specialisations = new()
    {
        "General Practitioner",
        "Cardiologist",
        "Dermatologist",
        "Neurologist",
        "Orthopedic",
        "Pediatrician",
        "Psychiatrist",
        "ENT Specialist"
    };

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task SaveDoctor()
    {
        try
        {
            errorMessage = null;

            await DoctorService.CreateDoctorAsync(doctor);

            Navigation.NavigateTo("/admin/doctors");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to add doctor. {ex.Message}";
        }
    }

    private void BackToDoctors()
    {
        Navigation.NavigateTo("/admin/doctors");
    }
}