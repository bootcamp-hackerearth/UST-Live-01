@page "/admin/patients/details/{patientId:int}"
@layout AdminLayout

@using HealthCareApp.Shared.Dtos.Patients
@using HealthCareApp.AdminBlazor.Services.Interfaces
@inject IAuthService AuthService
@inject IPatientAdminService PatientService
@inject NavigationManager Navigation

<PageTitle>Patient Details | HealthAxis Admin</PageTitle>

<div class="hc-details-actions">
    <button class="hc-secondary-btn" @onclick="BackToPatients">
        Back to Patients
    </button>
</div>

@if (isLoading)
{
    <div class="hc-page-loading">
        <div class="hc-loading-card">
            <div class="hc-loading-spinner"></div>
            <p>Loading patient details...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="hc-alert-error">
        @errorMessage
    </div>

    <button class="hc-secondary-btn mt-3" @onclick="BackToPatients">
        Back to Patients
    </button>
}
else if (patient is not null)
{
    <section class="hc-details-shell ha-profile-details-shell">
        <div class="hc-details-hero ha-profile-hero">
            <div class="hc-details-avatar ha-profile-avatar">
                @GetInitials(patient.FullName)
            </div>

            <div class="ha-profile-hero-content">
                <div class="ha-profile-kicker">HealthAxis Patient Profile</div>

                <h2>@patient.FullName</h2>
                <p>@patient.Email</p>

                <div class="hc-details-badge-row">
                    <span class="hc-status-badge active ha-profile-badge">
                        @patient.Gender
                    </span>

                    @if (!string.IsNullOrWhiteSpace(patient.InsuranceId))
                    {
                        <span class="hc-status-badge active ha-profile-badge">
                            Insured
                        </span>
                    }
                    else
                    {
                        <span class="hc-status-badge inactive ha-profile-badge">
                            No Insurance
                        </span>
                    }

                    <span class="ha-profile-id-pill">
                        Patient ID: @patient.PatientId
                    </span>
                </div>
            </div>
        </div>

        <div class="hc-details-grid ha-profile-details-grid">
            <div class="hc-details-card ha-profile-detail-card">
                <span>Patient ID</span>
                <strong>@patient.PatientId</strong>
                <p>Unique HealthAxis patient reference</p>
            </div>

            <div class="hc-details-card ha-profile-detail-card">
                <span>Date Of Birth</span>
                <strong>@FormatDate(dateOfBirth)</strong>
                <p>Registered demographic detail</p>
            </div>

            <div class="hc-details-card ha-profile-detail-card">
                <span>Phone Number</span>
                <strong>@patient.PhoneNumber</strong>
                <p>Primary contact number</p>
            </div>

            <div class="hc-details-card ha-profile-detail-card">
                <span>Insurance ID</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(patient.InsuranceId)
                        ? "Not Available"
                        : patient.InsuranceId)
                </strong>
                <p>Insurance reference linked to profile</p>
            </div>

            <div class="hc-details-card ha-profile-detail-card">
                <span>Created Date</span>
                <strong>@FormatDate(createdDate)</strong>
                <p>Profile creation date</p>
            </div>

            <div class="hc-details-card ha-profile-detail-card">
                <span>Profile Status</span>
                <strong>Active</strong>
                <p>Patient profile available in admin portal</p>
            </div>
        </div>

        <div class="ha-profile-summary-card">
            <div>
                <span>Profile Summary</span>
                <h3>@patient.FullName</h3>
                <p>
                    This patient profile is available for admin review and updates inside the
                    HealthAxis Admin Portal.
                </p>
            </div>

            <div class="ha-profile-summary-badge">
                @GetInitials(patient.FullName)
            </div>
        </div>

        <div class="hc-details-actions">
           

            <button class="hc-secondary-btn" @onclick="BackToPatients">
                Back
            </button>
        </div>
    </section>
}

@code {
    [Parameter]
    public int patientId { get; set; }

    private PatientDto? patient;

    private DateTime dateOfBirth;

    private DateTime createdDate;

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();

        if (!isAuthenticated)
        {

            Navigation.NavigateTo(
                        "/login?sessionExpired=true",
                        replace: true);
            return;
        }

        await LoadPatient();
    }

    private async Task LoadPatient()
    {
        isLoading = true;
        errorMessage = null;

        patient = await PatientService.GetPatientByIdAsync(patientId);

        if (patient is null)
        {
            errorMessage = "Patient profile was not found.";
            isLoading = false;
            return;
        }

        if (!DateTime.TryParse(patient.DateOfBirth, out dateOfBirth))
        {
            dateOfBirth = DateTime.MinValue;
        }

        if (!DateTime.TryParse(patient.CreatedDate, out createdDate))
        {
            createdDate = DateTime.MinValue;
        }

        isLoading = false;
    }

    

    private void BackToPatients()
    {
        Navigation.NavigateTo("/admin/patients");
    }

    private static string FormatDate(DateTime date)
    {
        return date == DateTime.MinValue
            ? "Not Available"
            : date.ToString("dd MMM yyyy");
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "PT";
        }

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpper()
                : parts[0].ToUpper();
        }

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}