@page "/"
@page "/login"

@inject NavigationManager Navigation

<PageTitle>Redirecting | HealthAxis</PageTitle>

<div style="min-height:100vh; display:grid; place-items:center; font-family:Arial;">
    <div style="text-align:center;">
        <h3>Redirecting to HealthAxis Login...</h3>
        <p>Please continue from the Angular HealthAxis login page.</p>
    </div>
</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Navigation.NavigateTo("http://localhost:4200", true);
    }
}