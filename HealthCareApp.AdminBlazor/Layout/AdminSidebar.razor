        </NavLink>

        <NavLink href="/admin/appointments" class="hc-nav-link">
            <svg class="hc-nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.4" fill="none" />
                <path d="M16 2v4M8 2v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
