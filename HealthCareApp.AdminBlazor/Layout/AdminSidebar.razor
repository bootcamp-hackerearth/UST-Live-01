        <div>
            <div class="hc-sidebar-title">HealthAxis</div>
            <div class="hc-sidebar-subtitle">Admin Portal</div>
        </div>
    </div>

    <nav class="hc-sidebar-nav">
        <NavLink href="/admin/dashboard" class="hc-nav-link" Match="NavLinkMatch.All">
            <svg class="hc-nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" fill="currentColor" />
                <rect x="14" y="3" width="7" height="7" fill="currentColor" />
