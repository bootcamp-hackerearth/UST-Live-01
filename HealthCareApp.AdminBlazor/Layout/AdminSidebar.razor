        </NavLink>

        <NavLink href="/admin/doctors" class="hc-nav-link">
            <svg class="hc-nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="9" cy="8" r="3" fill="currentColor" />
                <path d="M2 20c1.5-2.5 6-3 7-3s5.5.5 7 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M16 11l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
