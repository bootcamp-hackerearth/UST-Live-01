@if (isSidebarOpen)
{
    <div class="ha-sidebar-click-overlay"
         @onclick="CloseSidebar">
    </div>
}



<aside class="@SidebarClass">
    <div class="ha-sidebar-brand">
        <div class="ha-sidebar-logo">
            HA
        </div>

        <div class="ha-sidebar-text">
            <div class="ha-sidebar-title">
                HealthAxis
            </div>

            <div class="ha-sidebar-subtitle">
                Admin Portal
            </div>
        </div>
    </div>

    <button type="button"
            class="ha-sidebar-menu-button"
            @onclick="ToggleSidebar"
            title="Toggle sidebar">
        ☰
    </button>

    <nav class="ha-sidebar-nav">
        <NavLink href="/admin/dashboard"
                 class="ha-sidebar-link"
                 Match="NavLinkMatch.All">
            <span class="ha-sidebar-icon">▣</span>

            <span class="ha-sidebar-label">Dashboard</span>
        </NavLink>

        <NavLink href="/admin/doctors"
                 class="ha-sidebar-link">
            <span class="ha-sidebar-icon">✚</span>

            <span class="ha-sidebar-label">Doctors</span>
        </NavLink>

        <NavLink href="/admin/patients"
                 class="ha-sidebar-link">
            <span class="ha-sidebar-icon">♙</span>

            <span class="ha-sidebar-label">Patients</span>
        </NavLink>

        <NavLink href="/admin/appointments"
                 class="ha-sidebar-link">
            <span class="ha-sidebar-icon">📅</span>

            <span class="ha-sidebar-label">Appointments</span>
        </NavLink>
    </nav>

    <div class="ha-sidebar-footer">
        <div class="ha-sidebar-footer-card">
            <div class="ha-sidebar-footer-title">
                System
            </div>

            <div class="ha-sidebar-footer-text">
                Admin workspace active
            </div>
        </div>
    </div>
</aside>

@code {
    private bool isSidebarOpen;

    private string SidebarClass
    {
        get
        {
            return isSidebarOpen
                ? "ha-popout-sidebar ha-popout-sidebar-open"
                : "ha-popout-sidebar ha-popout-sidebar-closed";
        }
    }

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void CloseSidebar()
    {
        isSidebarOpen = false;
    }
}

