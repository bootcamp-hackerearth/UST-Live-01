@inject NavigationManager Navigation

<aside class="hc-sidebar">

    <button class="hc-sidebar-toggle" @onclick="OnToggleSidebar">
        ☰
    </button>

    <!-- ✅ BRAND -->
    <div class="hc-sidebar-brand">
        <div class="hc-sidebar-logo">HC</div>

        <div>
            <div class="hc-sidebar-title @(IsCollapsed ? "collapsed-text" : "")">
                HealthAxis
            </div>

            <div class="hc-sidebar-subtitle @(IsCollapsed ? "collapsed-text" : "")">
                Admin Portal
            </div>
        </div>
    </div>

    <!-- ✅ NAVIGATION -->
    <nav class="hc-sidebar-nav">

        <!-- Dashboard -->
        <NavLink href="/admin/dashboard"
                 class="hc-nav-link"
                 Match="NavLinkMatch.All"
                 data-label="Dashboard">
            <svg class="hc-nav-icon" viewBox="0 0 24 24">
                <rect x="3" y="3" width="7" height="7" fill="currentColor" />
                <rect x="14" y="3" width="7" height="7" fill="currentColor" />
                <rect x="3" y="14" width="7" height="7" fill="currentColor" />
                <rect x="14" y="14" width="7" height="7" fill="currentColor" />
            </svg>

            <span class="hc-nav-text @(IsCollapsed ? "collapsed-text" : "")">
                Dashboard
            </span>
        </NavLink>

        <!-- Doctors -->
        <NavLink href="/admin/doctors"
                 class="hc-nav-link"
                 data-label="Doctors">

            <svg class="hc-nav-icon" viewBox="0 0 24 24">
                <circle cx="9" cy="8" r="3" fill="currentColor" />
                <path d="M2 20c1.5-2.5 6-3 7-3s5.5.5 7 3"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                <path d="M16 11l4 4"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round" />
                <path d="M18 11v-2"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round" />
            </svg>

            <span class="hc-nav-text @(IsCollapsed ? "collapsed-text" : "")">
                Doctors
            </span>
        </NavLink>

        <!-- Patients -->
        <NavLink href="/admin/patients"
                 class="hc-nav-link"
                 data-label="Patients">

            <svg class="hc-nav-icon" viewBox="0 0 24 24">
                <circle cx="8" cy="8" r="3" fill="currentColor" />
                <path d="M2 20c1.5-2.5 6-3 6-3s4.5.5 6 3"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                <circle cx="17" cy="9" r="2" fill="currentColor" />
            </svg>

            <span class="hc-nav-text @(IsCollapsed ? "collapsed-text" : "")">
                Patients
            </span>
        </NavLink>

        <!-- Appointments -->
        <NavLink href="/admin/appointments"
                 class="hc-nav-link"
                 data-label="Appointments">

            <svg class="hc-nav-icon" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="16" rx="2"
                      stroke="currentColor"
                      stroke-width="1.4"
                      fill="none" />
                <path d="M16 2v4M8 2v4"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round" />
                <path d="M7 11h5v5H7z" fill="currentColor" />
            </svg>

            <span class="hc-nav-text @(IsCollapsed ? "collapsed-text" : "")">
                Appointments
            </span>
        </NavLink>

    </nav>

    <!-- ✅ FOOTER -->
    <div class="hc-sidebar-footer">
        <div class="hc-sidebar-footer-card">
            <div class="hc-footer-label @(IsCollapsed ? "collapsed-text" : "")">
                System
            </div>

            <div class="hc-footer-text @(IsCollapsed ? "collapsed-text" : "")">
                Admin workspace active
            </div>
        </div>
    </div>

</aside>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
}