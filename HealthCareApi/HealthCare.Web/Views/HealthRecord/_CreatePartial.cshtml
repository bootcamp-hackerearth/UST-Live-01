@model HealthCare.Shared.DTOs.HealthRecord.CreateHealthRecordDto

@using (Html.BeginForm("Create", "HealthRecord", FormMethod.Post,
    new { data_modal_form = "true" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2" })

    <div class="row g-3">

        <div class="col-md-4">
            @Html.LabelFor(m => m.PatientId, "Patient ID", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.PatientId, new { @class = "form-control", placeholder = "Patient ID" })
            @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-4">
            @Html.LabelFor(m => m.DoctorId, "Doctor ID", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.DoctorId, new { @class = "form-control", placeholder = "Doctor ID" })
            @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-4">
            @Html.LabelFor(m => m.AppointmentId, "Appointment ID", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.AppointmentId, new { @class = "form-control", placeholder = "Appointment ID" })
            @Html.ValidationMessageFor(m => m.AppointmentId, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.VisitDate, "Visit Date", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.VisitDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
            @Html.ValidationMessageFor(m => m.VisitDate, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Diagnosis, "Diagnosis", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Diagnosis, new { @class = "form-control", placeholder = "e.g. Hypertension" })
            @Html.ValidationMessageFor(m => m.Diagnosis, "", new { @class = "text-danger small" })
        </div>

        <div class="col-12">
            @Html.LabelFor(m => m.Prescription, "Prescription", new { @class = "form-label fw-semibold" })
            @Html.TextAreaFor(m => m.Prescription, 2, 0, new { @class = "form-control", placeholder = "Enter prescription details..." })
            @Html.ValidationMessageFor(m => m.Prescription, "", new { @class = "text-danger small" })
        </div>

        <div class="col-12">
            @Html.LabelFor(m => m.Notes, "Notes", new { @class = "form-label fw-semibold" })
            @Html.TextAreaFor(m => m.Notes, 2, 0, new { @class = "form-control", placeholder = "Additional notes (optional)" })
        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i> Save Record
        </button>
    </div>
}
