﻿@model HealthCare.Shared.DTOs.HealthRecord.CreateHealthRecordDto

@{
    ViewBag.Title = "Add Health Record";
}

<div class="page-card">

    <!-- ✅ HEADER -->
    <div class="page-header">
        <div>
            <h2 class="page-title">Add Health Record</h2>
            <div class="page-subtitle">
                Enter diagnosis, prescription and notes for completed appointment.
            </div>
        </div>
    </div>

    <!-- ✅ PATIENT / DOCTOR INFO -->
    <div class="profile-grid" style="margin-bottom:20px;">

        @*<div class="profile-item">
                <div class="profile-label">Patient</div>
                <div class="profile-value">@Model.PatientName</div>
            </div>

            <div class="profile-item">
                <div class="profile-label">Doctor</div>
                <div class="profile-value">@Model.DoctorName</div>
            </div>*@

        <div class="profile-item">
            <div class="profile-label">Visit Date</div>
            <div class="profile-value">
                @Model.VisitDate.ToString("dd-MMM-yyyy hh:mm tt")
            </div>
        </div>

    </div>

    <!-- ✅ FORM -->
    @using (Html.BeginForm("Create", "HealthRecord", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <input type="hidden" name="AppointmentId" value="@Request["appointmentId"]" />
        <input type="hidden" name="PatientId" value="@Request["PatientId"]" />
        <input type="hidden" name="DoctorId" value="@Request["DoctorId"]" />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- ✅ Diagnosis -->
        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Diagnosis, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Diagnosis, new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter diagnosis"
            })
            @Html.ValidationMessageFor(m => m.Diagnosis, "", new { @class = "text-danger" })
        </div>

        <!-- ✅ Prescription -->
        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Prescription, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Prescription, new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter prescription"
            })
            @Html.ValidationMessageFor(m => m.Prescription, "", new { @class = "text-danger" })
        </div>

        <!-- ✅ Notes -->
        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Notes, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Notes, new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Optional notes"
            })
            @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
        </div>

        <!-- ✅ ACTION BUTTONS -->
        <div class="d-flex gap-2">

            <button type="submit" class="btn btn-success">
                Save Health Record
            </button>

            <a href="@Url.Action("List", "HealthRecord")"
               class="btn btn-secondary">
                Cancel
            </a>

        </div>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}