@model HealthCare.Shared.PagedResult<HealthCare.Shared.DTOs.HealthRecord.HealthRecordDto>

@{
    ViewBag.Title = "Health Records";
    int currentPage = Model.PageNumber;
    int totalPages = Model.TotalPages;
}

<div class="container-fluid">

    <!-- Success / Error Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Health Records</h2>
            <p class="text-muted mb-0">Manage patient health records.</p>
        </div>
        <button class="btn btn-primary"
                onclick="openModal('@Url.Action("CreatePartial", "HealthRecord")', 'Add Health Record')">
            <i class="bi bi-plus-circle me-1"></i> Add Record
        </button>
    </div>

    <!-- Search -->
    <div class="mb-4 d-flex flex-wrap gap-3">

        <!-- Search by Patient ID -->
        @using (Html.BeginForm("List", "HealthRecord", FormMethod.Get))
        {
            <div class="d-flex gap-2">
                <input type="number"
                       name="patientId"
                       value="@Request["patientId"]"
                       class="form-control"
                       placeholder="Enter Patient ID"
                       style="width:180px;" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i> Search Patient
                </button>
            </div>
        }

        <!-- Search by Record ID (opens in modal) -->
        <div class="d-flex gap-2">
            <input type="number"
                   id="recordSearchId"
                   class="form-control"
                   placeholder="Enter Record ID"
                   style="width:180px;" />
            <button class="btn btn-success" onclick="searchRecord()">
                <i class="bi bi-file-earmark-medical me-1"></i> Search Record
            </button>
        </div>

    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">Record ID</th>
                            <th class="px-4 py-3">Appointment ID</th>
                            <th class="px-4 py-3">Diagnosis</th>
                            <th class="px-4 py-3">Prescription</th>
                            <th class="px-4 py-3">Notes</th>
                            <th class="px-4 py-3">Visit Date</th>
                            <th class="px-4 py-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var rec in Model.Items)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-semibold">@rec.RecordId</td>
                                    <td class="px-4 py-3">@rec.AppointmentId</td>
                                    <td class="px-4 py-3">@rec.Diagnosis</td>
                                    <td class="px-4 py-3">@rec.Prescription</td>
                                    <td class="px-4 py-3">
                                        @(string.IsNullOrEmpty(rec.Notes) ? "-" : rec.Notes)
                                    </td>
                                    <td class="px-4 py-3">
                                        @rec.VisitDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <button class="btn btn-sm btn-outline-primary"
                                                onclick="openModal('@Url.Action("ViewPartial", "HealthRecord", new { id = rec.RecordId })', 'Health Record Details')"
                                                title="View">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No health records found. Enter a Patient ID to search.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("List", new { pageNumber = currentPage - 1, patientId = Request["patientId"] })">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("List", new { pageNumber = i, patientId = Request["patientId"] })">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("List", new { pageNumber = currentPage + 1, patientId = Request["patientId"] })">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }

</div>

<!-- ═══════════════════════════════════════════
     MAIN MODAL
═══════════════════════════════════════════ -->
<div class="modal fade" id="mainModal" tabindex="-1" aria-labelledby="mainModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="mainModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="modalContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
    // ── Open partial in modal ────────────────────────────────────────────────
    function openModal(url, title) {
        document.getElementById('mainModalLabel').innerText = title || '';
        document.getElementById('modalContent').innerHTML =
            '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';

        var modal = new bootstrap.Modal(document.getElementById('mainModal'));
        modal.show();

        fetch(url)
            .then(function (res) {
                if (!res.ok) throw new Error('Failed to load content. Status: ' + res.status);
                return res.text();
            })
            .then(function (html) {
                document.getElementById('modalContent').innerHTML = html;
            })
            .catch(function (err) {
                document.getElementById('modalContent').innerHTML =
                    '<div class="alert alert-danger">' + err.message + '</div>';
            });
    }

    // ── Search record by ID ──────────────────────────────────────────────────
    function searchRecord() {
        var id = document.getElementById('recordSearchId').value;
        if (!id || id <= 0) {
            alert('Please enter a valid Record ID.');
            return;
        }
        openModal('@Url.Action("ViewPartial", "HealthRecord")?id=' + id, 'Health Record Details');
    }

    // ── Handle modal form submit (Add Record) ────────────────────────────────
    document.getElementById('mainModal').addEventListener('submit', function (e) {
        var form = e.target.closest('form[data-modal-form]');
        if (!form) return;

        e.preventDefault();

        var formData = new FormData(form);

        fetch(form.action, { method: 'POST', body: formData })
            .then(function (res) {
                var contentType = res.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    return res.json().then(function (data) {
                        if (data.success) {
                            bootstrap.Modal.getInstance(
                                document.getElementById('mainModal')).hide();
                            showBanner('success', data.message);
                            setTimeout(function () { location.reload(); }, 1200);
                        }
                    });
                }
                return res.text().then(function (html) {
                    document.getElementById('modalContent').innerHTML = html;
                });
            })
            .catch(function (err) {
                document.getElementById('modalContent').innerHTML =
                    '<div class="alert alert-danger">An error occurred: ' + err.message + '</div>';
            });
    });

    // ── Top banner ───────────────────────────────────────────────────────────
    function showBanner(type, message) {
        var div = document.createElement('div');
        div.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger') +
            ' alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3';
        div.style.zIndex = 9999;
        div.innerHTML = message +
            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
        document.body.appendChild(div);
        setTimeout(function () { div.remove(); }, 3000);
    }
    </script>
}
