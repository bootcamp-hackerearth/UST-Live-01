﻿@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Appointment Management</h2>

<div class="row">

    <!-- Book Appointment -->
    <div class="col-md-4">
        <div class="card shadow-sm text-center p-4 hover-card">
            <div class="mb-3">
                <i class="bi bi-calendar-plus" style="font-size:40px;color:green;"></i>
            </div>
            <h4>Book Appointment</h4>
            <p>Schedule a new appointment with doctors</p>
            <a href="/Appointment/Book" class="btn btn-success">Go</a>
        </div>
    </div>

    <!-- View Appointments -->
    <div class="col-md-4">
        <div class="card shadow-sm text-center p-4 hover-card">
            <div class="mb-3">
                <i class="bi bi-list-check" style="font-size:40px;color:blue;"></i>
            </div>
            <h4>View Appointments</h4>
            <p>See all booked appointments</p>
            <a href="/Appointment/View" class="btn btn-primary">Go</a>
        </div>
    </div>

    <!-- Status -->
    <div class="col-md-4">
        <div class="card shadow-sm text-center p-4 hover-card">
            <div class="mb-3">
                <i class="bi bi-clipboard-check" style="font-size:40px;color:orange;"></i>
            </div>
            <h4>Appointment Status</h4>
            <p>Check confirm, cancel or complete status</p>
            <a href="/Appointment/Status" class="btn btn-warning">Go</a>
        </div>
    </div>

</div>