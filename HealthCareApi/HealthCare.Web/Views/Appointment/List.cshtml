@model HealthCare.Shared.PagedResult<HealthCare.Shared.DTOs.Appointment.AppointmentDto>

@{
    ViewBag.Title = "Appointments";
    int currentPage = Model.PageNumber;
    int totalPages = Model.TotalPages;
    var doctors = ViewBag.Doctors as List<HealthCare.Shared.DTOs.Doctor.DoctorDto>;
    int patientId = ViewBag.PatientId;
}

<div class="container-fluid">

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Appointments</h2>
        </div>

        <button class="btn btn-primary"
                onclick="openModal('@Url.Action("BookPartial","Appointment")','Book Appointment')">
            <i class="bi bi-calendar-plus"></i> Book Appointment
        </button>
    </div>

    <!-- Table -->
    <div class="card shadow-sm rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var a in Model.Items)
                        {
                            var doctor = doctors?.FirstOrDefault(d => d.DoctorId == a.DoctorId);

                            <tr>
                                <td>@a.AppointmentId</td>
                                <td>@doctor?.FullName</td>
                                <td>@a.ScheduledDate.ToString("dd MMM yyyy")</td>
                                <td>@a.TimeSlot</td>
                                <td>
                                    <span class="badge bg-info">@a.Status</span>
                                </td>
                                <td class="text-center">

                                    <!-- Confirm -->
                                    <form method="post" action="@Url.Action("Confirm")" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.AppointmentId" />
                                        <input type="hidden" name="patientId" value="@patientId" />

                                        <button class="btn btn-success btn-sm">✔</button>
                                    </form>

                                    <!-- Cancel -->
                                    <form method="post" action="@Url.Action("Cancel")" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.AppointmentId" />
                                        <input type="hidden" name="patientId" value="@patientId" />
                                        <input type="hidden" name="reason" value="Cancelled by user" />

                                        <button class="btn btn-danger btn-sm">✖</button>
                                    </form>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No appointments found
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <ul class="pagination justify-content-center mt-3">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("List", new { pageNumber = i, patientId = patientId })">
                        @i
                    </a>
                </li>
            }
        </ul>
    }

</div>
