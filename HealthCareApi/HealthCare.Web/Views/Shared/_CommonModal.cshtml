@model dynamic

<style>
    .custom-modal {
        display: none;
        position: fixed;
        z-index: 999;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
    }

    .custom-modal-box {
        background: #fff;
        width: 400px;
        margin: 100px auto;
        padding: 20px;
        border-radius: 10px;
    }

    .modal-header {
        text-align: center;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .form-control {
        width: 100%;
        padding: 8px;
        margin-bottom: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    .text-danger {
        color: red;
        font-size: 12px;
    }

    .modal-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
    }

    .close {
        float: right;
        cursor: pointer;
    }
</style>

<div id="@Model.Id" class="custom-modal">

    <div class="custom-modal-box">

        <span class="close" onclick="closeModal('@Model.Id')">X</span>

        <div class="modal-header">@Model.Title</div>

        <form action="@Url.Action((string)Model.Action, (string)Model.Controller)" method="post">

            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <!-- ✅ FIXED PARTIAL -->
            @System.Web.Mvc.Html.PartialExtensions.Partial(
                Html,
                (string)Model.Body,
                Model.Data
            )

            <div class="modal-actions">
                <button type="button" onclick="closeModal('@Model.Id')">Cancel</button>
                <button type="submit">Save</button>
            </div>

        </form>
    </div>
</div>

<script>
    function openModal(id) {
        document.getElementById(id).style.display = "block";
    }

    function closeModal(id) {
        document.getElementById(id).style.display = "none";
    }

    /* reopen modal if validation fails */
    window.onload = function () {
        if (document.querySelector(".text-danger")) {
            var modal = document.querySelector(".custom-modal");
            if (modal) modal.style.display = "block";
        }
    }
</script>