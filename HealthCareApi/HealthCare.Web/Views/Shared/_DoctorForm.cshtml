@model HealthCare.Shared.DTOs.Doctor.DoctorDto

<div>
    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Full Name" })
    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
</div>

<div>
    @Html.TextBoxFor(m => m.Specialisation, new { @class = "form-control", placeholder = "Specialisation" })
    @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
</div>

<div>
    @Html.TextBoxFor(m => m.YearsOfExperience, new { @class = "form-control", type = "number", placeholder = "Experience" })
    @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger" })
</div>

<div>
    @Html.TextBoxFor(m => m.ConsultationFee, new
    {
        @class = "form-control",
        type = "number",
        placeholder = "Fee"
    })
    @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
</div>
