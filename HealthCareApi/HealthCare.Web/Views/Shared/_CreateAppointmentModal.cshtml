<!-- ✅ Appointment Modal -->
<div class="modal fade" id="appointmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <!-- ✅ Header -->
            <div class="modal-header">
                <h5 class="modal-title">Book Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- ✅ Body -->
            <div class="modal-body">

                @using (Html.BeginForm("Book", "Appointment", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="row g-3">

                        <!-- ✅ Hidden Patient -->
                        <input type="hidden" name="PatientId" value="@patientId" />

                        <!-- ✅ Specialization -->
                        <div class="col-md-6">
                            <label class="form-label">Specialization</label>

                            <select id="specializationDropdown" class="form-control">
                                <option value="">-- Select Specialization --</option>

                                @{
                                    var specs = ViewBag.Specialisations as List<string>;
                                }

                                @if (specs != null)
                                {
                                    foreach (var s in specs)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- ✅ Doctor -->
                        <div class="col-md-6">
                            <label class="form-label">Doctor</label>

                            <select id="doctorDropdown" name="DoctorId" class="form-control" required>
                                <option value="">-- Select Doctor --</option>
                            </select>
                        </div>

                        <!-- ✅ Date -->
                        <div class="col-md-6">
                            <label class="form-label">Date</label>
                            <input type="date" id="dateInput" name="ScheduledDate" class="form-control" required />
                        </div>

                        <!-- ✅ Time Slot -->
                        <div class="col-md-6">
                            <label class="form-label">Time Slot</label>

                            <select id="timeSlotDropdown" name="TimeSlot" class="form-control" required>
                                <option value="">-- Select Time Slot --</option>
                            </select>
                        </div>

                    </div>

                    <!-- ✅ Buttons -->
                    <div class="mt-4 text-end">

                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-primary">
                            Book Appointment
                        </button>

                    </div>
                }

            </div>

        </div>
    </div>
</div>