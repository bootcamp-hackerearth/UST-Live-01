@{
    var role = Convert.ToString(Session["Role"]);
    var email = Convert.ToString(Session["Email"]);
    var pageTitle = ViewBag.Title ?? "HealthCare Management";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@pageTitle - HealthCare Management</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- ✅ Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

<style>
            body {
                background-color: #f5f7fb;
                font-family: 'Segoe UI', Arial, sans-serif;
            }

            .app-wrapper { display: flex; min-height: 100vh; }

            .sidebar {
                width: 260px;
                background: #102a43;
                color: #fff;
                position: fixed;
                top: 0; bottom: 0; left: 0;
                padding: 20px 16px;
            }

            .main-content {
                margin-left: 260px;
                width: calc(100% - 260px);
            }

            .topbar {
                background: #fff;
                border-bottom: 1px solid #e5e7eb;
                padding: 16px 28px;
                display: flex;
                justify-content: space-between;
            }

            .page-container { padding: 28px; }

            .page-card {
                background: #fff;
                border-radius: 14px;
                box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
                padding: 24px;
            }


    @@media (max-width: 900px) {
        .sidebar {
            position: relative;
            width: 100%;
        }

        .main-content {
            margin-left: 0;
            width: 100%;
        }
     }
    }

</style>
</head>

<body>
    <div class="app-wrapper">

        <!-- ✅ Sidebar -->
        @Html.Partial("_Sidebar")

        <main class="main-content">

            <!-- ✅ Topbar -->
            <div class="topbar">
                <strong>@pageTitle</strong>

                <div>
                    <span class="text-muted">@role</span> |
                    <a href="@Url.Action("Logout", "Account")">Logout</a>
                </div>
            </div>

            <!-- ✅ Page Body -->
            <div class="page-container">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @RenderBody()
            </div>

        </main>
    </div>

    <!-- ✅ ✅ MAIN MODAL (VERY IMPORTANT FIX) -->
    <div class="modal fade" id="mainModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- ✅ THIS WAS MISSING -->
                <div id="modalContent">
                    <!-- Partial views load here -->
                </div>

            </div>
        </div>
    </div>

    <!-- ✅ Confirm Modal -->
    @Html.Partial("_ConfirmModal")

    <!-- ✅ Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        // ✅ Open Confirm Modal
        function openConfirmModal(title, message, actionUrl) {
            $("#confirmModalTitle").text(title);
            $("#confirmModalMessage").text(message);
            $("#confirmModalForm").attr("action", actionUrl);
            $("#confirmModal").modal("show");
        }

        // ✅ ✅ AJAX Form Submit (FIXED)
        $(document).on("submit", "[data-modal-form]", function (e) {
            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr("action"),
                type: form.attr("method"),
                data: form.serialize(),

                success: function (response) {

                    // ✅ Success JSON
                    if (response && response.success) {
                        alert(response.message);

                        $('#mainModal').modal('hide');
                        location.reload();
                    }
                    else {
                        // ✅ Validation errors → reload partial inside modal
                        $("#modalContent").html(response);
                        $('#mainModal').modal('show');
                    }
                },

                error: function () {
                    alert("Something went wrong");
                }
            });
        });

        // ✅ ✅ Open modal and load partial dynamically
        function openModal(url) {
            $("#modalContent").html("<p class='p-3'>Loading...</p>");

            $.get(url, function (data) {
                $("#modalContent").html(data);
                $("#mainModal").modal("show");
            });
        }
    </script>

    @RenderSection("scripts", required: false)

</body>
</html>