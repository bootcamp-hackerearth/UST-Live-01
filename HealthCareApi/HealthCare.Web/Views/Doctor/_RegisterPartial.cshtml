@model HealthCare.Shared.DTOs.Doctor.CreateDoctorDto

@using (Html.BeginForm("Register", "Doctor", FormMethod.Post,
    new { data_modal_form = "true" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2" })

    <div class="row g-3">
        <div class="col-md-6">
            @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "e.g. Dr. John Smith" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Specialisation, "Specialisation", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Specialisation, new { @class = "form-control", placeholder = "e.g. Cardiology" })
            @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Email, "Email Address", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Email, new { type = "email", @class = "form-control", placeholder = "e.g. doctor@hospital.com" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-3">
            @Html.LabelFor(m => m.YearsOfExperience, "Experience (yrs)", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.YearsOfExperience, new { type = "number", @class = "form-control", min = "0", max = "60" })
            @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-3">
            @Html.LabelFor(m => m.ConsultationFee, "Consultation Fee (₹)", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.ConsultationFee, new { type = "number", @class = "form-control", min = "0", step = "0.01" })
            @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger small" })
        </div>

        <!-- Time Slots -->
        <div class="col-12">
            <label class="form-label fw-semibold">Time Slots</label>

            <div id="timeSlotsContainer">
                <div class="d-flex gap-2 mb-2">
                    <input type="text" name="TimeSlots" class="form-control"
                           placeholder="e.g. 09:00 AM - 09:30 AM" />

                    <button type="button" class="btn btn-outline-danger btn-sm"
                            onclick="removeSlot(this)">
                        <i class="bi bi-dash-circle"></i>
                    </button>
                </div>
            </div>

            <button type="button" class="btn btn-outline-primary btn-sm mt-1" onclick="addSlot()">
                <i class="bi bi-plus-circle me-1"></i> Add Time Slot
            </button>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-person-check me-1"></i> Save Doctor
        </button>
    </div>
}

<!-- ✅ Main Script -->
<script>
    function addSlot() {
        var container = document.getElementById('timeSlotsContainer');

        var div = document.createElement('div');
        div.className = 'd-flex gap-2 mb-2';

        div.innerHTML =
            '<input type="text" name="TimeSlots" class="form-control" placeholder="e.g. 10:00 AM - 10:30 AM" />' +
            '<button type="button" class="btn btn-outline-danger btn-sm" onclick="removeSlot(this)">' +
            '<i class="bi bi-dash-circle"></i></button>';

        container.appendChild(div);
    }

    // ✅ UI removal ONLY
    function removeSlot(btn) {
        var container = document.getElementById('timeSlotsContainer');

        if (container.children.length > 1) {
            btn.closest('.d-flex').remove();
        }
    }
</script>

@section Scripts {
    <script>
        // ✅ Server-side delete (different name to avoid conflict)
        function removeSlotFromServer(id) {
            console.log("Removing slot:", id);

            fetch('/Doctor/DeleteSlot/' + id, {
                method: 'POST'
            })
                .then(response => {
                    if (response.ok) {
                        alert("Slot removed");
                        location.reload();
                    } else {
                        alert("Failed to remove slot");
                    }
                });
        }
    </script>
}