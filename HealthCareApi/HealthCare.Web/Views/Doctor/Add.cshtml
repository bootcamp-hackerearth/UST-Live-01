﻿@model HealthCare.Shared.DTOs.Doctor.CreateDoctorDto

@{
    ViewBag.Title = "Register Doctor";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("List", "Doctor")" class="text-decoration-none">
                        Doctor Management
                    </a>
                </li>
                <li class="breadcrumb-item active">Register Doctor</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">Register Doctor</h2>
                <p class="text-muted mb-0">
                    Add a new doctor to the healthcare system.
                </p>
            </div>

            <a href="@Url.Action("List", "Doctor")"
               class="btn btn-outline-secondary rounded-3">
                Back to Doctor List
            </a>
        </div>
    </div>

    <!-- Form -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            @using (Html.BeginForm("Add", "Doctor", FormMethod.Post, new { novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <!-- Full Name -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Full Name <span class="text-danger">*</span>
                        </label>

                        @Html.TextBoxFor(m => m.FullName, new
                        {
                            @class = "form-control rounded-3 " +
                                (ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "is-invalid" : "")
                        })

                        @Html.ValidationMessageFor(m => m.FullName, "",
                            new { @class = "invalid-feedback" })
                    </div>

                    <!-- Specialisation -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Specialisation <span class="text-danger">*</span>
                        </label>

                        @Html.DropDownListFor(m => m.Specialisation,
                            new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Cardiologist", Value = "Cardiologist" },
                                new SelectListItem { Text = "Dermatologist", Value = "Dermatologist" },
                                new SelectListItem { Text = "Neurologist", Value = "Neurologist" },
                                new SelectListItem { Text = "Pediatrician", Value = "Pediatrician" },
                                new SelectListItem { Text = "Orthopedic", Value = "Orthopedic" }
                            },
                            "Select Specialisation",
                            new
                            {
                                @class = "form-select rounded-3 " +
                                    (ViewData.ModelState["Specialisation"]?.Errors.Count > 0 ? "is-invalid" : "")
                            })

                        @Html.ValidationMessageFor(m => m.Specialisation, "",
                            new { @class = "invalid-feedback" })
                    </div>

                    <!-- Experience -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Experience (Years) <span class="text-danger">*</span>
                        </label>

                        @Html.TextBoxFor(m => m.YearsOfExperience, new
                        {
                            type = "number",
                            @class = "form-control rounded-3 " +
                                (ViewData.ModelState["YearsOfExperience"]?.Errors.Count > 0 ? "is-invalid" : "")
                        })

                        @Html.ValidationMessageFor(m => m.YearsOfExperience, "",
                            new { @class = "invalid-feedback" })
                    </div>

                    <!-- Fee -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Consultation Fee <span class="text-danger">*</span>
                        </label>

                        @Html.TextBoxFor(m => m.ConsultationFee, new
                        {
                            type = "number",
                            @class = "form-control rounded-3 " +
                                (ViewData.ModelState["ConsultationFee"]?.Errors.Count > 0 ? "is-invalid" : "")
                        })

                        @Html.ValidationMessageFor(m => m.ConsultationFee, "",
                            new { @class = "invalid-feedback" })
                    </div>

                    <!-- ✅ Email -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Email <span class="text-danger">*</span>
                        </label>

                        @Html.TextBoxFor(m => m.Email, new
                        {
                            type = "email",
                            @class = "form-control rounded-3 " +
                                (ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")
                        })

                        @Html.ValidationMessageFor(m => m.Email, "",
                            new { @class = "invalid-feedback" })
                    </div>

                    <!-- Email -->
                    @*<div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Email <span class="text-danger">*</span>
                        </label>*@

                    @*@Html.TextBoxFor(m => m.Email, new
                        {
                            type = "email",
                            @class = "form-control rounded-3 " +
                                (ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")
                        })

                        @Html.ValidationMessageFor(m => m.Email, "",
                            new { @class = "invalid-feedback" })*@
                    @*</div>*@

                    @*Password ?*@
                    @*<div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Password <span class="text-danger">*</span>
                        </label>*@

                    @*@Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-control rounded-3 " +
                                (ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")
                        })

                        @Html.ValidationMessageFor(m => m.Password, "",
                            new { @class = "invalid-feedback" })*@
                    @*</div>*@

                </div>


                <!-- ✅ Time Slots -->
                <div class="col-12 mt-3">
                    <label class="form-label fw-semibold">
                        Available Time Slots <span class="text-danger">*</span>
                    </label>

                    <div class="d-flex flex-wrap gap-3">

                        @{
                            var slots = new List<string>
                                                {
                "9 AM", "10 AM", "11 AM", "12 PM",
                "1 PM", "2 PM", "3 PM", "4 PM", "5 PM"
            };
                        }

                        @foreach (var slot in slots)
                        {
                            <div class="form-check">

                                <input type="checkbox"
                                       name="TimeSlots"
                                       value="@slot"
                                       id="slot_@slot.Replace(" ", "")"
                                       class="form-check-input"
                                       @(Model?.TimeSlots != null && Model.TimeSlots.Contains(slot) ? "checked" : "") />

                                <label class="form-check-label"
                                       for="slot_@slot.Replace(" ", "")">
                                    @slot
                                </label>

                            </div>
                        }

                    </div>

                    <!-- ✅ Validation -->
                    @if (ViewData.ModelState["TimeSlots"]?.Errors.Count > 0)
                    {
                        <div class="text-danger mt-2">
                            @ViewData.ModelState["TimeSlots"].Errors[0].ErrorMessage
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 mt-5">
                    <a href="@Url.Action("List", "Doctor")"
                       class="btn btn-outline-secondary rounded-3 px-4">
                        Cancel
                    </a>

                    <button type="reset"
                            class="btn btn-outline-danger rounded-3 px-4">
                        Clear
                    </button>

                    <button type="submit"
                            class="btn btn-primary rounded-3 px-4">
                        Register Doctor
                    </button>
                </div>
            }

        </div>
    </div>

</div>