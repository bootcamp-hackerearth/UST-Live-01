@model HealthCare.Shared.DTOs.Patient.CreatePatientDto

@using (Html.BeginForm("Register", "Patient", FormMethod.Post,
    new { data_modal_form = "true" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2" })

    <div class="row g-3">

        <div class="col-md-6">
            @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "e.g. John Smith" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.DateOfBirth, "Date of Birth", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Gender, "Gender", new { @class = "form-label fw-semibold" })
            @Html.DropDownListFor(m => m.Gender,
                     new SelectList(new[] { "Male", "Female", "Other" }),
                     "-- Select Gender --",
                     new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.PhoneNumber, "Phone Number", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "e.g. 9876543210" })
            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Email, "Email Address", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.Email, new { type = "email", @class = "form-control", placeholder = "e.g. john@email.com" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.InsuranceId, "Insurance ID", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control", placeholder = "Optional" })
            <small class="text-muted">Leave blank if not insured</small>
        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-person-check me-1"></i> Register Patient
        </button>
    </div>
}
