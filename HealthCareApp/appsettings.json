{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DbCon": "Server=.;Database=HealthAxisDatabase;Integrated Security=True;TrustServerCertificate=True"
  },

  "Jwt": {
    "Issuer": "HealthCareApp",
    "Audience": "HealthCareApp",
    "Key": "55ca2b787faff91608c7c15eb0ccd69933ee708152a88ad8cacf2fd11b7550b1",
    "AccessTokenExpirationMinutes": 15
  },

  "Serilog": {

    "Using": [

      "Serilog.Sinks.Console",

      "Serilog.Sinks.File"
    ],

    "MinimumLevel": {

      "Default": "Information",

      "Override": {

        "Microsoft": "Warning",

        "Microsoft.Hosting.Lifetime": "Information",

        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }

    },

    "WriteTo": [

      {

        "Name": "Console"
      },

      {

        "Name": "File",

        "Args": {

          "path": "Logs/healthaxis-api-.log",

          "rollingInterval": "Day",

          "retainedFileCountLimit": 7,

          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }

      }

    ],

    "Enrich": [

      "FromLogContext"
    ],

    "Properties": {

      "Application": "HealthAxis API"
    }

  },

  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },

  "Garnet": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "HealthCareApp"
  }

}

