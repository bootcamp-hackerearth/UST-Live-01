@model IEnumerable<HealthAxisApp.Shared.DTOs.PatientDto>

@{
    ViewBag.Title = "Patients";
}

<style>
    body {
        background: linear-gradient(135deg, #e0f2fe, #f8fafc);
        font-family: 'Segoe UI', sans-serif;
    }

    .wrap {
        max-width: 1100px;
        margin: auto;
        padding: 35px 0;
    }

    .panel {
        backdrop-filter: blur(10px);
        background: rgba(255,255,255,0.75);
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        border: 1px solid rgba(255,255,255,0.4);
    }

    .header h2 {
        margin: 0;
        color: #0f172a;
    }

    .header p {
        font-size: 13px;
        color: #475569;
        margin-top: 5px;
    }

    .search-box {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

        .search-box input,
        .search-box select {
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-size: 13px;
        }

            .search-box input:focus,
            .search-box select:focus {
                border-color: #3b82f6;
                outline: none;
            }

    .btn {
        border-radius: 22px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        border: none;
        text-decoration: none;
    }

    .btn-main {
        background: linear-gradient(90deg,#3b82f6,#6366f1);
        color: white;
    }

    .btn-clear {
        background: #e2e8f0;
        color: #1e293b;
    }

    /* RESULT CARDS */
    .result-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(260px,1fr));
        gap: 15px;
        margin-top: 15px;
    }

    .patient-card {
        background: white;
        border-radius: 12px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        transition: 0.25s;
        position: relative;
    }

        .patient-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(#6366f1,#3b82f6);
            border-radius: 10px 0 0 10px;
        }

        .patient-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.07);
        }

    .name {
        font-weight: 600;
        color: #0f172a;
    }

    .meta {
        font-size: 12px;
        color: #64748b;
    }

    .view-btn {
        margin-top: 8px;
        display: inline-block;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 18px;
        background: #3b82f6;
        color: white;
    }

    /* ACTION CARDS */
    .grid-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 18px;
        margin-top: 25px;
    }

    .action-card {
        background: white;
        border-radius: 12px;
        padding: 18px;
        border: 1px solid #e2e8f0;
        text-align: center;
        transition: 0.25s;
    }

        .action-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .action-card h4 {
            margin-bottom: 8px;
            color: #0f172a;
        }

        .action-card p {
            font-size: 13px;
            color: #64748b;
        }
</style>

<div class="wrap">

    <!-- HEADER -->
    <div class="panel header">
        <h2>Patient Control Center</h2>
        <p>Search, manage and access patient-related operations</p>
    </div>

    <!-- SEARCH -->
    <div class="panel">
        @using (Html.BeginForm("Index", "Patients", FormMethod.Get))
        {
            <div class="search-box">

                <input name="searchText"
                       value="@ViewBag.SearchText"
                       placeholder="Search patient..." />

                <select name="insuranceStatus">
                    <option value="">All</option>
                    <option value="Insured" @(ViewBag.InsuranceStatus == "Insured" ? "selected" : "")>
                        Insured
                    </option>
                    <option value="NotInsured" @(ViewBag.InsuranceStatus == "NotInsured" ? "selected" : "")>
                        Not Insured
                    </option>
                </select>

                <button type="submit" class="btn btn-main">Search</button>

                <a href="@Url.Action("Index","Patients")" class="btn btn-clear">
                    Clear
                </a>
            </div>
        }
    </div>

    <!-- RESULTS -->
    @if (!string.IsNullOrEmpty(ViewBag.SearchText) && Model != null && Model.Any())
    {
        <div class="panel">
            <div class="result-grid">
                @foreach (var p in Model)
                {
                    <div class="patient-card">

                        <div class="name">@p.FullName</div>

                        <div class="meta">@p.PhoneNumber</div>
                        <div class="meta">@p.Email</div>

                        @Html.ActionLink(
                            "View",
                            "Details",
                            "Patients",
                            new { id = p.PatientId },
                            new { @class = "view-btn" })
                    </div>
                }
            </div>
        </div>
    }

    <!-- ACTIONS -->
    <div class="grid-actions">

        <div class="action-card">
            <h4>Register Patient</h4>
            <p>Add new patient profile</p>
            @Html.ActionLink("Open", "Create", "Patients", null, new { @class = "btn btn-main" })
        </div>

        <div class="action-card">
            <h4>Book Appointment</h4>
            <p>Schedule patient visit</p>
            @Html.ActionLink("Book", "Book", "Appointments", null, new { @class = "btn btn-main" })
        </div>

        <div class="action-card">
            <h4>Appointments</h4>
            <p>View patient bookings</p>
            @Html.ActionLink("View", "MyAppointments", "Appointments", null, new { @class = "btn btn-main" })
        </div>

        <div class="action-card">
            <h4>Find Doctors</h4>
            <p>Search by specialisation</p>
            @Html.ActionLink("Search", "SearchDoctors", "Patients", null, new { @class = "btn btn-main" })
        </div>

        <div class="action-card">
            <h4>Health Records</h4>
            <p>Access patient history</p>
            @Html.ActionLink("Open", "PatientHistory", "HealthRecords", null, new { @class = "btn btn-main" })
        </div>

    </div>

</div>