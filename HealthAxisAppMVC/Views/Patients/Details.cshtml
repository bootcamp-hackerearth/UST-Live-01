@model HealthAxisApp.Shared.DTOs.PatientDto

@{
    ViewBag.Title = "Patient Profile";
}

<style>
    body {
        background: linear-gradient(135deg, #e0f2fe, #f8fafc);
        font-family: 'Segoe UI', sans-serif;
    }

    .wrap {
        max-width: 900px;
        margin: auto;
        padding: 40px 0;
    }

    .glass-card {
        backdrop-filter: blur(10px);
        background: rgba(255,255,255,0.75);
        border-radius: 14px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        border: 1px solid rgba(255,255,255,0.4);
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .header h2 {
            margin: 0;
            color: #0f172a;
        }

        .header p {
            margin-top: 5px;
            font-size: 13px;
            color: #475569;
        }

    .stat-box {
        background: linear-gradient(135deg,#3b82f6,#6366f1);
        border-radius: 12px;
        padding: 14px 18px;
        text-align: center;
        min-width: 140px;
        box-shadow: 0 6px 15px rgba(59,130,246,0.2);
    }

    .stat-number {
        font-size: 24px;
        font-weight: 700;
        color: white;
    }

    .stat-label {
        font-size: 12px;
        color: white;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .card {
        background: #ffffff;
        border-radius: 10px;
        padding: 14px;
        border: 1px solid #e2e8f0;
        position: relative;
        transition: 0.25s;
    }

        .card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(#6366f1,#3b82f6);
            border-radius: 10px 0 0 10px;
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    .label {
        font-size: 11px;
        color: #64748b;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    .value {
        font-size: 14px;
        font-weight: 600;
        color: #0f172a;
    }

    .actions {
        margin-top: 25px;
        display: flex;
        justify-content: space-between;
    }

    .btn {
        padding: 8px 18px;
        border-radius: 22px;
        border: none;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-main {
        background: linear-gradient(90deg,#3b82f6,#6366f1);
        color: white;
    }

    .btn-back {
        background: #e2e8f0;
        color: #1e293b;
    }
</style>

<div class="wrap">

    <div class="glass-card">

        @if (TempData["Success"] != null)
        {
            <div style="background:#dcfce7;color:#166534;padding:10px;border-radius:8px;margin-bottom:10px;">
                @TempData["Success"]
            </div>
        }

        <div class="header">
            <div>
                <h2>Patient Profile</h2>
                <p>Overview of patient information</p>
            </div>

            <div class="stat-box">
                <div class="stat-number">@Model.AppointmentCount</div>
                <div class="stat-label">Appointments</div>
            </div>
        </div>

        <div class="grid">

            <div class="card">
                <div class="label">Patient ID</div>
                <div class="value">@Model.PatientId</div>
            </div>

            <div class="card">
                <div class="label">Full Name</div>
                <div class="value">@Model.FullName</div>
            </div>

            <div class="card">
                <div class="label">Date of Birth</div>
                <div class="value">@Model.DateOfBirth.ToString("dd MMM yyyy")</div>
            </div>

            <div class="card">
                <div class="label">Gender</div>
                <div class="value">@Model.Gender</div>
            </div>

            <div class="card">
                <div class="label">Phone</div>
                <div class="value">@Model.PhoneNumber</div>
            </div>

            <div class="card">
                <div class="label">Email</div>
                <div class="value">@Model.Email</div>
            </div>

            <div class="card">
                <div class="label">Insurance</div>
                <div class="value">
                    @(string.IsNullOrWhiteSpace(Model.InsuranceID) ? "No Insurance" : Model.InsuranceID)
                </div>
            </div>

            <div class="card">
                <div class="label">Created Date</div>
                <div class="value">@Model.CreatedDate.ToString("dd MMM yyyy")</div>
            </div>

        </div>

        <div class="actions">

            @Html.ActionLink(
                "Edit",
                "Edit",
                "Patients",
                new { id = Model.PatientId },
                new { @class = "btn btn-main" })

            @Html.ActionLink(
                "Back",
                "Index",
                "Patients",
                null,
                new { @class = "btn btn-back" })

        </div>

    </div>

</div>