@model IEnumerable<HealthAxisApp.Shared.DTOs.PatientDto>

@{
    ViewBag.Title = "Patient List";
}

<style>
    body {
        background: linear-gradient(135deg, #e0f2fe, #f8fafc);
        font-family: 'Segoe UI', sans-serif;
    }

    .wrap {
        max-width: 1100px;
        margin: auto;
        padding: 35px 0;
    }

    .panel {
        backdrop-filter: blur(10px);
        background: rgba(255,255,255,0.75);
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        border: 1px solid rgba(255,255,255,0.4);
    }

    .header h2 {
        margin: 0;
        color: #0f172a;
    }

    .header p {
        margin-top: 5px;
        font-size: 13px;
        color: #475569;
    }

    .btn {
        border-radius: 20px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        border: none;
    }

    .btn-back {
        background: #e2e8f0;
        color: #1e293b;
    }

    .btn-main {
        background: linear-gradient(90deg,#3b82f6,#6366f1);
        color: white;
    }

    .filters {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

        .filters select {
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-size: 13px;
        }

            .filters select:focus {
                border-color: #3b82f6;
                outline: none;
            }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(260px,1fr));
        gap: 16px;
        margin-top: 15px;
    }

    .card {
        background: #ffffff;
        border-radius: 12px;
        padding: 15px;
        border: 1px solid #e2e8f0;
        transition: 0.25s;
        position: relative;
    }

        .card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(#6366f1,#3b82f6);
            border-radius: 10px 0 0 10px;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    .name {
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 5px;
    }

    .meta {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 3px;
    }

    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 14px;
        font-size: 11px;
        font-weight: 600;
        margin-top: 6px;
    }

    .insured {
        background: #dcfce7;
        color: #166534;
    }

    .no-insurance {
        background: #fee2e2;
        color: #991b1b;
    }

    .footer {
        margin-top: 10px;
    }

    .view-btn {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 18px;
        background: #06b6d4;
        color: white;
        text-decoration: none;
    }

    .empty {
        text-align: center;
        padding: 30px;
        color: #475569;
    }
</style>

<div class="wrap">

    <div class="panel header">
        <h2>Patient Directory</h2>
        <p>Browse, filter and access patient records</p>

        @Html.ActionLink(
            "Back",
            "Index",
            "Doctors",
            null,
            new { @class = "btn btn-back" })
    </div>

    <div class="panel">
        @using (Html.BeginForm("PatientList", "Doctors", FormMethod.Get))
        {
            <div class="filters">

                <select name="insuranceStatus">
                    <option value="">All Patients</option>
                    <option value="Insured" @(ViewBag.InsuranceStatus == "Insured" ? "selected" : "")>
                        Insured
                    </option>
                    <option value="NotInsured" @(ViewBag.InsuranceStatus == "NotInsured" ? "selected" : "")>
                        No Insurance
                    </option>
                </select>

                <select name="sortOrder">
                    <option value="">Name A-Z</option>
                    <option value="name_desc" @(ViewBag.SortOrder == "name_desc" ? "selected" : "")>
                        Name Z-A
                    </option>
                </select>

                <button type="submit" class="btn btn-main">
                    Apply
                </button>
            </div>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="panel empty">
            No patients found
        </div>
    }
    else
    {
        <div class="grid">

            @foreach (var p in Model)
            {
                <div class="card">

                    <div class="name">
                        @p.FullName
                    </div>

                    <div class="meta">ID: @p.PatientId</div>
                    <div class="meta">@p.Gender</div>
                    <div class="meta">@p.Email</div>
                    <div class="meta">@p.PhoneNumber</div>

                    <div>
                        @if (!string.IsNullOrWhiteSpace(p.InsuranceID))
                        {
                            <span class="badge insured">Insured</span>
                        }
                        else
                        {
                            <span class="badge no-insurance">No Insurance</span>
                        }
                    </div>

                    <div class="footer">
                        @Html.ActionLink(
                            "View Profile",
                            "Details",
                            "Patients",
                            new { id = p.PatientId },
                            new { @class = "view-btn" })
                    </div>

                </div>
            }

        </div>
    }

</div>