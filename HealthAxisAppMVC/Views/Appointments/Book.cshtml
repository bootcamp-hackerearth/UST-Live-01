@model HealthAxisApp.Shared.DTOs.AppointmentDto

@{
    ViewBag.Title = "Book Appointment";
}

<style>
    body {
        background: linear-gradient(135deg, #e0f2fe, #f8fafc);
        font-family: 'Segoe UI', sans-serif;
    }

    .wrap {
        max-width: 700px;
        margin: auto;
        padding: 40px 0;
    }

    .card-box {
        background: #ffffff;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.08);
    }

    .title {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 5px;
    }

    .subtitle {
        font-size: 14px;
        color: #64748b;
        margin-bottom: 20px;
    }

    .section {
        margin-top: 20px;
        padding-top: 12px;
        border-top: 1px dashed #e2e8f0;
    }

        .section span {
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            display: block;
            margin-bottom: 10px;
        }

    .row-flex {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .col-flex {
        flex: 1;
        min-width: 48%;
    }

    input, select {
        width: 100%;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        padding: 9px;
        font-size: 13px;
    }

        input:focus, select:focus {
            border-color: #3b82f6;
            outline: none;
        }

    .actions {
        margin-top: 25px;
        display: flex;
        justify-content: space-between;
    }

    .btn {
        border-radius: 20px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 600;
        border: none;
    }

    .btn-main {
        background: #3b82f6;
        color: white;
    }

        .btn-main:hover {
            background: #2563eb;
        }

    .btn-back {
        background: #e2e8f0;
        color: #1e293b;
    }

    .error {
        color: #dc2626;
        font-size: 12px;
    }
</style>

<div class="wrap">

    <div class="card-box">

        <div class="title">Schedule Appointment</div>
        <div class="subtitle">
            Enter required details to book an appointment quickly.
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "error" })

            <div class="section">
                <span>Basic Details</span>

                <div class="row-flex">

                    <div class="col-flex">
                        @Html.TextBoxFor(m => m.PatientId, new
                        {
                            type = "number",
                            placeholder = "Patient ID"
                        })
                        @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "error" })
                    </div>

                    <div class="col-flex">
                        @Html.TextBoxFor(m => m.DoctorId, new
                        {
                            type = "number",
                            placeholder = "Doctor ID"
                        })
                        @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "error" })
                    </div>

                </div>
            </div>

            <div class="section">
                <span>Schedule</span>

                <div class="row-flex">

                    <div class="col-flex">
                        @Html.TextBoxFor(m => m.ScheduledDate, "{0:yyyy-MM-dd}", new
                        {
                            type = "date",
                            min = DateTime.Today.ToString("yyyy-MM-dd")
                        })
                        @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "error" })
                    </div>

                    <div class="col-flex">
                        @Html.DropDownListFor(
                            m => m.TimeSlot,
                            ViewBag.TimeSlots as SelectList,
                            "Select Time Slot")
                        @Html.ValidationMessageFor(m => m.TimeSlot, "", new { @class = "error" })
                    </div>

                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-main">
                    Book Now
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Index",
                    "Patients",
                    null,
                    new { @class = "btn btn-back" })
            </div>
        }
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}