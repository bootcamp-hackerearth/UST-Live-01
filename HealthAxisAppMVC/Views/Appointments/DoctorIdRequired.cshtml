@{
    ViewBag.Title = "Enter Doctor ID";
}

<style>
    body {
        background: linear-gradient(135deg, #e0f2fe, #f8fafc);
        font-family: 'Segoe UI', sans-serif;
    }

    .wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .glass-card {
        width: 420px;
        padding: 30px;
        border-radius: 14px;
        backdrop-filter: blur(10px);
        background: rgba(255,255,255,0.65);
        border: 1px solid rgba(255,255,255,0.4);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        text-align: center;
        position: relative;
    }

        .glass-card::before {
            content: "";
            position: absolute;
            top: -40px;
            left: -40px;
            width: 120px;
            height: 120px;
            background: radial-gradient(circle, #60a5fa, transparent);
            border-radius: 50%;
            z-index: 0;
        }

    .title {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 6px;
        position: relative;
    }

    .subtitle {
        font-size: 13px;
        color: #475569;
        margin-bottom: 20px;
        position: relative;
    }

    input {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        text-align: center;
        font-size: 14px;
        transition: 0.2s;
        margin-top: 10px;
    }

        input:focus {
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 6px rgba(59,130,246,0.3);
        }

    .actions {
        margin-top: 22px;
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 22px;
        border: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-main {
        background: linear-gradient(90deg,#3b82f6,#6366f1);
        color: white;
    }

        .btn-main:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .btn-back {
        background: #e2e8f0;
        color: #1e293b;
    }

        .btn-back:hover {
            background: #cbd5e1;
        }

    ::placeholder {
        color: #94a3b8;
    }
</style>

<div class="wrap">

    <div class="glass-card">

        <div class="title">Doctor Quick Access</div>

        <div class="subtitle">
            Enter doctor ID to open schedule and manage appointments
        </div>

        @using (Html.BeginForm("DoctorAppointments", "Appointments", FormMethod.Get))
        {
            <input name="doctorId"
                   type="number"
                   placeholder="Doctor ID"
                   required
                   min="1" />

            <div class="actions">
                <button type="submit" class="btn btn-main">
                    Proceed
                </button>

                @Html.ActionLink(
                    "Back",
                    "Index",
                    "Doctors",
                    null,
                    new { @class = "btn btn-back" })
            </div>
        }

    </div>

</div>