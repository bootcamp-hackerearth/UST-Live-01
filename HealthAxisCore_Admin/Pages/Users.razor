@page "/users"
@inject UserAdminService UserService

<h1 class="page-title">User Management</h1>

<div class="form-card glass">
    <div class="form-group">
        <label class="form-label">Filter By Role</label>
        <select class="form-select" @bind="selectedRole">
            <option value="">All</option>
            <option value="Admin">Admin</option>
            <option value="Patient">Patient</option>
            <option value="Doctor">Doctor</option>
        </select>
    </div>

    <button class="primary-button" @onclick="LoadUsersAsync">
        Apply Filter
    </button>
</div>

<div class="table-card glass">
    <table class="data-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        <span class="badge @(user.IsActive ? "badge-active" : "badge-inactive")">
                            @(user.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<UserDto> users = new();

    private string? selectedRole;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await UserService.GetUsersAsync(selectedRole);
    }
}