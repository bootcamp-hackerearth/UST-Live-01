@page "/external-login"

@attribute [AllowAnonymous]

@layout PublicLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager NavigationManager
@inject AdminHandoffService AdminHandoffService
@inject TokenService TokenService

<h1 class="page-title">
    Signing you in...
</h1>

<div class="table-card glass">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p>@errorMessage</p>
    }
    else
    {
        <p>
            Please wait while HealthAxis verifies your admin session.
        </p>
    }
</div>

@code {
    private string errorMessage = string.Empty;

    private bool hasStarted;

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender || hasStarted)
        {
            return;
        }

        hasStarted = true;

        try
        {
            var currentUri =
                NavigationManager.ToAbsoluteUri(
                    NavigationManager.Uri);

            var query =
                QueryHelpers.ParseQuery(
                    currentUri.Query);

            var code =
                query.TryGetValue(
                    "code",
                    out var codeValue)
                    ? codeValue.ToString()
                    : string.Empty;

            if (string.IsNullOrWhiteSpace(code))
            {
                errorMessage =
                    "Invalid admin handoff request. " +
                    "The handoff code is missing.";

                StateHasChanged();

                return;
            }

            var exchangeResult =
                await AdminHandoffService
                    .ExchangeAndStoreAsync(code);

            if (!exchangeResult.IsSuccess)
            {
                errorMessage =
                    string.IsNullOrWhiteSpace(
                        exchangeResult.ErrorMessage)
                        ? "The admin handoff code could not be exchanged."
                        : exchangeResult.ErrorMessage;

                StateHasChanged();

                return;
            }

            var savedToken =
                await TokenService.GetAccessTokenAsync();

            if (string.IsNullOrWhiteSpace(savedToken))
            {
                errorMessage =
                    "The admin token was exchanged, but it was " +
                    "not saved in browser storage.";

                StateHasChanged();

                return;
            }

            // CHANGED:
            //
            // Do not use "/dashboard".
            //
            // A leading slash navigates to the website root:
            // /dashboard
            //
            // The Blazor application is hosted under /blazor/, so a
            // base-relative route must be used:
            // /blazor/dashboard
            NavigationManager.NavigateTo(
                "dashboard",
                replace: true);
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "HealthAxis could not connect to the admin " +
                "authentication service.";

            StateHasChanged();
        }
        catch (Exception)
        {
            errorMessage =
                "An unexpected error occurred while completing " +
                "the admin sign-in.";

            StateHasChanged();
        }
    }
}