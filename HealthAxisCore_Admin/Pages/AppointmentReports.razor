@page "/appointment-reports"
@attribute [Authorize(Roles = "Admin")]
@inject AppointmentReportService AppointmentReportService

<h1 class="page-title">Appointment Reports</h1>

<div class="table-card glass">
    @if (reports is null)
    {
        <p>Loading appointment reports...</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Confirmed</th>
                    <th>Cancelled</th>
                    <th>Completed</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var report in reports)
                {
                    <tr>
                        <td>@report.Date.ToString("yyyy-MM-dd")</td>
                        <td>@report.Confirmed</td>
                        <td>@report.Cancelled</td>
                        <td>@report.Completed</td>
                        <td>@report.Total</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<AppointmentReportDto>? reports;

    protected override async Task OnInitializedAsync()
    {
        reports = await AppointmentReportService.GetAppointmentReportsAsync();
    }
}