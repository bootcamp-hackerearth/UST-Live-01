@page "/login"

@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<h1 class="page-title">Redirecting to login...</h1>

<div class="table-card glass">
    <p>Please wait while HealthAxis redirects you to the secure login page.</p>
</div>

@code {
    protected override void OnInitialized()
    {
        var angularLoginUrl = Configuration["AngularLoginUrl"];

        if (string.IsNullOrWhiteSpace(angularLoginUrl))
        {
            angularLoginUrl = "http://localhost:56902/login";
        }

        NavigationManager.NavigateTo(angularLoginUrl, forceLoad: true);
    }
}