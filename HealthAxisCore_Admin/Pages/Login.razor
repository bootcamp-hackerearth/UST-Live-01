@page "/login"

@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<h1 class="page-title">Redirecting to login...</h1>

<div class="table-card glass">
    <p>Please wait while HealthAxis redirects you to the secure login page.</p>
</div>

@code {
    private const string AngularLoginUrlConfigurationKey = "AngularLoginUrl";

    protected override void OnInitialized()
    {
        var angularLoginUrl = Configuration[AngularLoginUrlConfigurationKey];

        if (string.IsNullOrWhiteSpace(angularLoginUrl))
        {
            throw new InvalidOperationException(
                $"Configuration value '{AngularLoginUrlConfigurationKey}' is missing.");
        }

        NavigationManager.NavigateTo(
            angularLoginUrl,
            forceLoad: true);
    }
}