@page "/reports"
@inject ReportService ReportService

<h1 class="page-title">Appointment Reports</h1>

<div class="table-card glass">
    <table class="data-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Confirmed</th>
                <th>Cancelled</th>
                <th>Completed</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var report in reports)
            {
                <tr>
                    <td>@report.Date.ToShortDateString()</td>
                    <td>@report.Confirmed</td>
                    <td>@report.Cancelled</td>
                    <td>@report.Completed</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<AppointmentReportDto> reports = new();

    protected override async Task OnInitializedAsync()
    {
        reports = await ReportService.GetAppointmentReportsAsync();
    }
}