@page "/doctors"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.JSInterop
@inject DoctorAdminService DoctorAdminService
@inject IJSRuntime JSRuntime

<h1 class="page-title">Doctor Management</h1>

<div class="form-card glass">
    <h3>Add Doctor</h3>

    <EditForm Model="@createDoctor"
              OnValidSubmit="@CreateDoctorAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">Doctor Name</label>
                <InputText class="form-input"
                           @bind-Value="createDoctor.DoctorName" />
            </div>

            <div class="form-group">
                <label class="form-label">Email</label>
                <InputText class="form-input"
                           @bind-Value="createDoctor.Email" />
            </div>

            <div class="form-group">
                <label class="form-label">Phone Number</label>
                <InputText class="form-input"
                           @bind-Value="createDoctor.PhoneNumber" />
            </div>

            <div class="form-group">
                <label class="form-label">Specialisation</label>
                <InputSelect class="form-select"
                             @bind-Value="createDoctor.Specialisation">
                    <option value="">Select specialisation</option>
                    <option value="Endocrinologist">Endocrinologist</option>
                    <option value="Oncologist">Oncologist</option>
                    <option value="Gynecologist">Gynecologist</option>
                    <option value="OrthopedicSurgeon">Orthopedic Surgeon</option>
                    <option value="Psychiatrist">Psychiatrist</option>
                    <option value="Pediatrician">Pediatrician</option>
                    <option value="Neurologist">Neurologist</option>
                    <option value="Dermatologist">Dermatologist</option>
                    <option value="Cardiologist">Cardiologist</option>
                    <option value="GeneralPractitioner">General Practitioner</option>
                </InputSelect>
            </div>

            <div class="form-group">
                <label class="form-label">Years Of Experience</label>
                <InputNumber class="form-input"
                             @bind-Value="createDoctor.YearsOfExperience" />
            </div>

            <div class="form-group">
                <label class="form-label">Consultation Fee</label>
                <InputNumber class="form-input"
                             @bind-Value="createDoctor.ConsultationFee" />
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <InputText class="form-input"
                           type="password"
                           @bind-Value="createDoctor.Password" />
            </div>
        </div>

        <button class="primary-button"
                type="submit"
                disabled="@isSaving">
            @(isSaving ? "Saving..." : "Add Doctor")
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageCssClass">
            @message
        </div>
    }
</div>

@if (isEditing)
{
    <div id="edit-doctor-section"
         class="form-card glass edit-section">
        <h3>Edit Doctor</h3>

        <EditForm Model="@editDoctor"
                  OnValidSubmit="@SaveEditedDoctorAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Doctor Id</label>
                    <InputNumber class="form-input"
                                 @bind-Value="editingDoctorId"
                                 disabled />
                </div>

                <div class="form-group">
                    <label class="form-label">Doctor Name</label>
                    <InputText class="form-input"
                               @bind-Value="editDoctor.DoctorName" />
                </div>

                <div class="form-group">
                    <label class="form-label">Specialisation</label>
                    <InputSelect class="form-select"
                                 @bind-Value="editDoctor.Specialisation">
                        <option value="">Select specialisation</option>
                        <option value="Endocrinologist">Endocrinologist</option>
                        <option value="Oncologist">Oncologist</option>
                        <option value="Gynecologist">Gynecologist</option>
                        <option value="OrthopedicSurgeon">Orthopedic Surgeon</option>
                        <option value="Psychiatrist">Psychiatrist</option>
                        <option value="Pediatrician">Pediatrician</option>
                        <option value="Neurologist">Neurologist</option>
                        <option value="Dermatologist">Dermatologist</option>
                        <option value="Cardiologist">Cardiologist</option>
                        <option value="GeneralPractitioner">General Practitioner</option>
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label class="form-label">Years Of Experience</label>
                    <InputNumber class="form-input"
                                 @bind-Value="editDoctor.YearsOfExperience" />
                </div>

                <div class="form-group">
                    <label class="form-label">Consultation Fee</label>
                    <InputNumber class="form-input"
                                 @bind-Value="editDoctor.ConsultationFee" />
                </div>

                <div class="form-group">
                    <label class="form-label">Status</label>
                    <InputSelect class="form-select"
                                 @bind-Value="editDoctor.IsActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </InputSelect>
                </div>
            </div>

            <div class="actions">
                <button class="primary-button"
                        type="submit"
                        disabled="@isSaving">
                    @(isSaving ? "Updating..." : "Save Changes")
                </button>

                <button class="secondary-button"
                        type="button"
                        @onclick="CancelEdit"
                        disabled="@isSaving">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
}

<div class="table-controls">
    <input class="form-input search-box"
           placeholder="Search current page by name or specialisation..."
           @bind="searchText"
           @bind:event="oninput" />

    <label class="checkbox-container">
        <input type="checkbox" @bind="showOnlyActive" />
        Show Active Only
    </label>
</div>

<div class="table-card glass">
    <div class="pagination-top-bar">
        <div class="pagination-left">
            <span class="pagination-title">Doctors List</span>
            <span class="pagination-count">Total: @doctorTotalCount</span>
        </div>

        <div class="pagination-page-size">
            <label>Rows per page</label>

            <select class="form-select pagination-size-select"
                    value="@doctorPageSize"
                    @onchange="OnDoctorPageSizeChanged">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="15">15</option>
                <option value="20">20</option>
            </select>
        </div>
    </div>

    @if (doctors is null)
    {
        <p>Loading doctors...</p>
    }
    else if (!FilteredDoctors.Any())
    {
        <p>No matching doctors found.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Doctor Id</th>
                    <th>Name</th>
                    <th>Specialisation</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var doctor in FilteredDoctors)
                {
                    <tr>
                        <td>@doctor.DoctorId</td>
                        <td>@doctor.DoctorName</td>
                        <td>@doctor.Specialisation</td>
                        <td>@doctor.YearsOfExperience</td>
                        <td>@doctor.ConsultationFee</td>
                        <td>
                            @if (doctor.IsActive)
                            {
                                <span class="badge badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="doctor-actions-inline">
                                <button class="secondary-button doctor-edit-button"
                                        @onclick="() => StartEditDoctor(doctor)"
                                        disabled="@isSaving">
                                    Edit
                                </button>

                                <button class="@GetToggleButtonClass(doctor)"
                                        @onclick="() => ToggleDoctorAsync(doctor)"
                                        disabled="@isSaving">
                                    @(doctor.IsActive ? "Active" : "Inactive")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <Pagination CurrentPage="@doctorCurrentPage"
                    PageSize="@doctorPageSize"
                    TotalItems="@doctorTotalCount"
                    OnPageChanged="@ChangeDoctorPageAsync" />
    }
</div>

@code {
    private List<AdminDoctorDto>? doctors;

    private CreateDoctorDto createDoctor = new();

    private UpdateDoctorDto editDoctor = new();

    private int editingDoctorId;

    private bool isEditing;

    private bool shouldScrollToEditSection;

    private string? message;

    private string messageCssClass = "success-text";

    private bool isSaving;

    private string? searchText;

    private bool showOnlyActive;

    private int doctorCurrentPage = 1;

    private int doctorPageSize = 5;

    private int doctorTotalCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!shouldScrollToEditSection)
        {
            return;
        }

        shouldScrollToEditSection = false;

        await JSRuntime.InvokeVoidAsync(
            "healthAxisScrollToElement",
            "edit-doctor-section");
    }

    private async Task LoadDoctorsAsync()
    {
        var result = await DoctorAdminService.GetDoctorsAsync(
            doctorCurrentPage,
            doctorPageSize);

        doctors = result.Items;

        doctorTotalCount = result.TotalCount;
    }

    private async Task CreateDoctorAsync()
    {
        message = null;
        isSaving = true;

        try
        {
            var success = await DoctorAdminService.CreateDoctorAsync(createDoctor);

            if (!success)
            {
                messageCssClass = "error-text";
                message = "Unable to create doctor.";
                return;
            }

            createDoctor = new CreateDoctorDto();

            messageCssClass = "success-text";
            message = "Doctor created successfully.";

            doctorCurrentPage = 1;

            await LoadDoctorsAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEditDoctor(AdminDoctorDto doctor)
    {
        message = null;

        editingDoctorId = doctor.DoctorId;

        editDoctor = new UpdateDoctorDto
        {
            DoctorName = doctor.DoctorName,
            Specialisation = doctor.Specialisation,
            YearsOfExperience = doctor.YearsOfExperience,
            ConsultationFee = doctor.ConsultationFee,
            IsActive = doctor.IsActive
        };

        isEditing = true;

        shouldScrollToEditSection = true;
    }

    private async Task SaveEditedDoctorAsync()
    {
        message = null;
        isSaving = true;

        try
        {
            var success = await DoctorAdminService.UpdateDoctorAsync(
                editingDoctorId,
                editDoctor);

            if (!success)
            {
                messageCssClass = "error-text";
                message = "Unable to update doctor.";
                return;
            }

            messageCssClass = "success-text";
            message = "Doctor updated successfully.";

            isEditing = false;

            editingDoctorId = 0;

            editDoctor = new UpdateDoctorDto();

            await LoadDoctorsAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelEdit()
    {
        isEditing = false;

        editingDoctorId = 0;

        editDoctor = new UpdateDoctorDto();

        message = null;
    }

    private async Task ToggleDoctorAsync(AdminDoctorDto doctor)
    {
        message = null;
        isSaving = true;

        try
        {
            var updateDoctor = new UpdateDoctorDto
            {
                DoctorName = doctor.DoctorName,
                Specialisation = doctor.Specialisation,
                YearsOfExperience = doctor.YearsOfExperience,
                ConsultationFee = doctor.ConsultationFee,
                IsActive = !doctor.IsActive
            };

            var success = await DoctorAdminService.UpdateDoctorAsync(
                doctor.DoctorId,
                updateDoctor);

            if (!success)
            {
                messageCssClass = "error-text";
                message = "Unable to update doctor status.";
                return;
            }

            messageCssClass = "success-text";
            message = "Doctor status updated successfully.";

            await LoadDoctorsAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ChangeDoctorPageAsync(int pageNumber)
    {
        doctorCurrentPage = pageNumber;

        await LoadDoctorsAsync();
    }

    private async Task OnDoctorPageSizeChanged(ChangeEventArgs eventArgs)
    {
        if (int.TryParse(eventArgs.Value?.ToString(), out var selectedPageSize))
        {
            doctorPageSize = selectedPageSize;
            doctorCurrentPage = 1;

            await LoadDoctorsAsync();
        }
    }

    private IEnumerable<AdminDoctorDto> FilteredDoctors =>
        (doctors ?? Enumerable.Empty<AdminDoctorDto>())
            .Where(doctor =>
                (string.IsNullOrWhiteSpace(searchText) ||
                 doctor.DoctorName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                 doctor.Specialisation.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                &&
                (!showOnlyActive || doctor.IsActive));

    private static string GetToggleButtonClass(AdminDoctorDto doctor)
    {
        return doctor.IsActive
            ? "doctor-status-toggle doctor-status-toggle-active"
            : "doctor-status-toggle doctor-status-toggle-inactive";
    }
}