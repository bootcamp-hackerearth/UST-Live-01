@using Microsoft.AspNetCore.Components.Authorization
@using HealthAxisCore_Admin.Layout

@inject NavigationManager NavigationManager

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            @{
                var currentPath = NavigationManager
                    .ToBaseRelativePath(NavigationManager.Uri)
                    .Split('?')[0]
                    .Trim('/');
            }

            @if (currentPath.StartsWith("auth/external-login", StringComparison.OrdinalIgnoreCase))
            {
                <RouteView RouteData="@routeData"
                           DefaultLayout="@typeof(PublicLayout)" />
            }
            else
            {
                <AuthorizeRouteView RouteData="@routeData"
                                    DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>

                    <Authorizing>
                        <p>Checking authorization...</p>
                    </Authorizing>
                </AuthorizeRouteView>
            }

            <FocusOnNavigate RouteData="@routeData"
                             Selector="h1" />
        </Found>

        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <h1 class="page-title">Page not found</h1>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>