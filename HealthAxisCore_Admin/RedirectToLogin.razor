@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

@code {
    private const string ExternalLoginPath = "auth/external-login";

    private const string AngularLoginUrlConfigurationKey = "AngularLoginUrl";

    protected override void OnInitialized()
    {
        var currentPath = NavigationManager
            .ToBaseRelativePath(NavigationManager.Uri)
            .Split('?')[0]
            .Trim('/');

        if (currentPath.StartsWith(
                ExternalLoginPath,
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var angularLoginUrl =
            Configuration[AngularLoginUrlConfigurationKey];

        if (string.IsNullOrWhiteSpace(angularLoginUrl))
        {
            throw new InvalidOperationException(
                $"Configuration value '{AngularLoginUrlConfigurationKey}' is missing.");
        }

        NavigationManager.NavigateTo(
            angularLoginUrl,
            forceLoad: true);
    }
}