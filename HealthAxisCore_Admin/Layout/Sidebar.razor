@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@inject HealthAxisCore_Admin.Services.AuthService AuthService
@inject HealthAxisCore_Admin.Services.ThemeService ThemeService

<aside class="sidebar glass">
    <div class="sidebar-title">
        HealthAxis Admin
    </div>

    <nav>
        <NavLink href="/dashboard"
                 class="sidebar-link"
                 activeClass="active">
            Dashboard
        </NavLink>

        <NavLink href="/doctors"
                 class="sidebar-link"
                 activeClass="active">
            Doctors
        </NavLink>

        <NavLink href="/users"
                 class="sidebar-link"
                 activeClass="active">
            Users
        </NavLink>

        <NavLink href="/appointment-reports"
                 class="sidebar-link"
                 activeClass="active">
            Reports
        </NavLink>
    </nav>

    <button class="sidebar-link theme-toggle-link"
            @onclick="ToggleThemeAsync">
        @themeButtonText
    </button>

    <button class="sidebar-link logout-link"
            @onclick="LogoutAsync">
        Logout
    </button>
</aside>

@code {

    private string currentTheme = "dark";

    private string themeButtonText =>
        currentTheme == "dark"
            ? "Switch to Light Mode"
            : "Switch to Dark Mode";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        currentTheme = await ThemeService.GetThemeAsync();

        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        currentTheme = await ThemeService.ToggleThemeAsync();
    }


    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();

        NavigationManager.NavigateTo("/login", true);
    }
}