@page "/patient/list"
@using Healthcare.Shared.DTOs.Patient
@using Healthcare.Shared.DTOs;

@inject PatientService PatientService
@inject IJSRuntime JS

<h3 class="mb-3 text-primary fw-bold">🧑‍⚕️ Patient Management</h3>

<!--  FILTER PANEL -->
<div class="card shadow mb-4 p-3 border-0"
     style="background:#0F172A; color:white;">

    <div class="row g-3 align-items-end">

        <!-- Search -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Search</label>
            <input class="form-control filter-input"
                   placeholder="Patient name"
                   @bind="searchText"
                   @bind:event="oninput"
                   @bind:after="ApplyFilters" />
        </div>

        <!-- Insurance -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Insurance</label>
            <select class="form-select filter-input"
                    @bind="insuranceFilter"
                    @bind:after="ApplyFilters">
                <option value="">All</option>
                <option value="true">Insured</option>
                <option value="false">Not Insured</option>
            </select>
        </div>

        <!-- Status -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Status</label>
            <select class="form-select filter-input"
                    @bind="statusFilter"
                    @bind:after="ApplyFilters">
                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>

    </div>
</div>


        @* <!--  Register -->
        <div class="col-md-5 text-end">
            <button class="btn btn-success mt-3">
                ➕ Register Patient
            </button>
        </div> *@

  

<!-- ✅ TABLE -->
<table class="table table-hover shadow-sm border">
    <thead style="background:#0B5ED7; color:white;">
        <tr>
            <th>Name</th>
            @* <th>Email</th> *@
            <th>Phone</th>
            <th>Gender</th>
            <th>Insurance</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (isLoading)
        {
            <tr>
                <td colspan="6" class="text-center">Loading...</td>
            </tr>
        }
        else if (result.Items == null || !result.Items.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">
                    No patients found
                </td>
            </tr>
        }
        else
        {
            @foreach (var p in result.Items)
            {
                <tr>
                    <td>@p.FullName</td>
                    @* <td>@p.Email</td> *@
                    <td>@p.PhoneNumber</td>
                    <td>@p.Gender</td>

                    <!-- ✅ Insurance Badge -->
                    <td>
                        <span class="badge @(p.HasInsurance ? "bg-success" : "bg-secondary")">
                            @(p.HasInsurance ? "Insured" : "No Insurance")
                        </span>
                    </td>
                    
                    @* Status *@
                    <td>
                        <span class="badge @(p.IsActive ? "bg-success" : "bg-danger")">
                            @(p.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>


                    <!-- ✅ ACTIONS -->
                    <td class="text-end">
                        <!-- Toggle Insurance -->
                        <button class="btn btn-sm btn-outline-primary me-1"
                                @onclick="() => ToggleInsurance(p)">
                            🔄
                        </button>

                        
                        <!-- Toggle Status -->
                        <button class="btn btn-sm @(p.IsActive ? "btn-outline-success" : "btn-outline-danger") me-1"
                                @onclick="() => ToggleStatus(p)">
                            Status
                        </button>

                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => ShowDeletePopup(p.PatientId)">
                            Delete
                        </button>

                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- ✅ PAGINATION -->
<div class="d-flex justify-content-between mt-3">
    <button class="btn btn-outline-primary"
            disabled="@(_currentPage == 1)"
            @onclick="PrevPage">
        ⬅ Prev
    </button>

    <span class="fw-bold">
        Page @_currentPage / @TotalPages
    </span>


    <button class="btn btn-outline-primary"
            disabled="@(_currentPage == TotalPages)"
            @onclick="NextPage">
        Next ➡
    </button>
</div>

@if (showDeletePopup)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal show d-block">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">

                <h5 class="text-danger mb-3">⚠️ Confirm Delete</h5>

                <p>Are you sure you want to delete this patient?</p>

                <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-danger" @onclick="ConfirmDelete">
                        Yes, Delete
                    </button>

                    <button class="btn btn-secondary" @onclick="CancelDelete">
                        Cancel
                    </button>
                </div>

            </div>
        </div>
    </div>
}


@code {

    private PagedResult<PatientListDto> result = new();

    private bool isLoading = true;
    private bool showDeletePopup = false;
    private int deletePatientId;


    private string searchText = "";
    private string insuranceFilter = "";
    private string statusFilter = "";

    private int _currentPage = 1;
    private int pageSize = 10;

    private int TotalPages => result?.TotalPages ?? 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        try
        {
            isLoading = true;

            var filter = new PatientFilter
            {
                PageNumber = _currentPage,
                PageSize = pageSize,
                FullName = searchText,
                HasInsurance = string.IsNullOrEmpty(insuranceFilter) ? null : bool.Parse(insuranceFilter),
                IsActive = string.IsNullOrEmpty(statusFilter) ? null : bool.Parse(statusFilter)
            };

            result = await PatientService.GetPatients(filter);
        }
        finally
        {
            isLoading = false;
        }
    }

    
    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadPatients();
    }

  
    private async Task NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            await LoadPatients();
        }
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadPatients();
        }
    }

    private async Task ToggleInsurance(PatientListDto patient)
    {
        await PatientService.UpdateInsuranceStatus(patient.PatientId, !patient.HasInsurance);
        await LoadPatients();
    }
    
    private async Task ToggleStatus(PatientListDto patient)
    {
        try
        {
            await PatientService.UpdateStatus(patient.PatientId, !patient.IsActive);
            await LoadPatients();
        }
        catch
        {
            await JS.InvokeVoidAsync("alert", "Failed to update status");
        }
    }

    private void ShowDeletePopup(int id)
    {
        deletePatientId = id;
        showDeletePopup = true;
    }

    private async Task ConfirmDelete()
    {
        await PatientService.DeletePatient(deletePatientId);

        showDeletePopup = false;

        await LoadPatients();
    }

    private void CancelDelete()
    {
        showDeletePopup = false;
    }



}
