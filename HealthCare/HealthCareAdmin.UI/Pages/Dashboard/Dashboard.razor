@page "/dashboard"

@inject DoctorService DoctorService
@inject PatientService PatientService
@inject AppointmentService AppointmentService


<h3 class="fw-bold mb-1">Dashboard Overview</h3>
<p class="text-muted mb-4">Welcome back, Admin — here’s what’s happening today.</p>

<!-- ✅ SECTION 1: PATIENT + DOCTOR -->
<div class="row g-3 mb-4">

    <!-- ✅ PATIENT -->
    <div class="col-12">
        <div class="card shadow-sm p-3 border-0 rounded-3">
            <div class="text-muted small">Total Patients</div>
            <h4 class="fw-bold">@totalPatients</h4>
           
        </div>
    </div>

    <!-- ✅ DOCTOR BELOW PATIENT -->
    <div class="col-12">
        <div class="card shadow-sm p-3 border-0 rounded-3">
            <div class="text-muted small">Total Doctors</div>
            <h4 class="fw-bold">@totalDoctors</h4>
           
        </div>
    </div>

</div>

<!-- ✅ SECTION 2: APPOINTMENTS + REVENUE -->
<div class="row g-3 mb-4">

    <!-- ✅ APPOINTMENTS -->
    <div class="col-md-6">
        <div class="card shadow-sm p-3 border-0 rounded-3">
            <div class="text-muted small">Appointments</div>
            <h4 class="fw-bold">@totalAppointments</h4>
 
        </div>
    </div>

    <!-- ✅ REVENUE -->
    <div class="col-md-6">
        <div class="p-3 rounded-3 text-white shadow-sm"
             style="background:#0B5ED7;">

            <div class="small">Total Revenue</div>
            <h3>₹18,42,500</h3>
            <small>+12.4% vs last month</small>
        </div>
    </div>

</div>

<!-- ✅ SECTION 3: APPOINTMENT STATUS -->
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card text-center shadow-sm p-3 border-0 rounded-3">
            <div class="text-muted">Pending</div>
            <h4 class="text-warning">@pending</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow-sm p-3 border-0 rounded-3">
            <div class="text-muted">Confirmed</div>
            <h4 class="text-primary">@confirmed</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow-sm p-3 border-0 rounded-3">
            <div class="text-muted">Completed</div>
            <h4 class="text-success">@completed</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow-sm p-3 border-0 rounded-3">
            <div class="text-muted">Cancelled</div>
            <h4 class="text-danger">@cancelled</h4>
        </div>
    </div>

</div>



@code {
    private int totalDoctors;
    private int totalPatients;
    private int totalAppointments;

    private int pending;
    private int confirmed;
    private int completed;
    private int cancelled;

    [Inject] NavigationManager Nav { get; set; }
    [Inject] IJSRuntime JS { get; set; }

   
    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        // ✅ Doctors

        var doctorResult = await DoctorService.GetDoctors();
        totalDoctors = doctorResult.TotalCount;

        // ✅ Patients
        var patientResult = await PatientService.GetPatients();
        totalPatients = patientResult.TotalCount;

        // ✅ Appointments (use your report API or list API)
        var report = await AppointmentService.GetAppointmentReport(
            DateTime.Today.AddDays(-6),
            DateTime.Today
        );


        pending = report.Sum(x => x.PendingCount);
        confirmed = report.Sum(x => x.ConfirmedCount);
        completed = report.Sum(x => x.CompletedCount);

        totalAppointments = report.Sum(x => x.PendingCount + x.ConfirmedCount + x.CompletedCount);
    }

}
