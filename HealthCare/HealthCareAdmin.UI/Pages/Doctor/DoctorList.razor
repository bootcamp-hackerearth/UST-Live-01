@page "/doctor/list"
@using Healthcare.Shared.DTOs.Doctor
@using Healthcare.Shared.DTOs;


@inject DoctorService DoctorService
@inject IJSRuntime JS

<h3 class="mb-3 text-primary fw-bold">👨‍⚕️ Doctor Management</h3>

<!-- ✅ FILTER PANEL -->
<div class="card shadow-sm mb-4 p-3 border-0"
     style="background:#0F172A; color:white;">

    <div class="row g-3 align-items-end">

        <div class="col-md-3">
            <label class="form-label fw-semibold">Search</label>
            <input class="form-control filter-input"
                   placeholder="Doctor name"
                   @bind="searchText"
                   @bind:event="oninput"
                   @bind:after="ApplyFilters" />
        </div>

        <div class="col-md-2">
            <label class="form-label fw-semibold">Specialisation</label>
            <select class="form-select filter-input"
                    @bind="selectedSpecialisation"
                    @bind:after="ApplyFilters">
                <option value="">All</option>
                @foreach (var s in specialisations)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label fw-semibold">Experience</label>
            <input type="number"
                   class="form-control filter-input"
                   @bind="minExperience"
                   @bind:event="oninput"
                   @bind:after="ApplyFilters" />
        </div>

        <div class="col-md-2">
            <label class="form-label fw-semibold">Status</label>
            <select class="form-select filter-input"
                    @bind="statusFilter"
                    @bind:after="ApplyFilters">
                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>

        <div class="col-md-3 text-end">
            <button class="btn btn-success mt-3" @onclick="ShowModal">
                + Register
            </button>
        </div>

    </div>
</div>

<!-- ✅ TABLE -->
<div class="card shadow-sm border-0">

    <table class="table table-hover align-middle mb-0">

        <thead style="background:#0B5ED7; color:white;">
            <tr>
                <th>Name</th>
                <th>Specialisation</th>
                <th>Experience</th>
                <th>Fee</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>

        @if (isLoading)
        {
            <tr>
                <td colspan="6" class="text-center">Loading...</td>
            </tr>
        }
            else if (result.Items == null || !result.Items.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">
                    No doctors found
                </td>
            </tr>
        }
        else
        {
                @foreach (var doc in result.Items)
            {
                <tr>
                    <td>@doc.FullName</td>
                    <td>@doc.Specialisation</td>
                    <td>@doc.YearsOfExperience yrs</td>
                    <td>₹@doc.ConsultationFee</td>

                    <td>
                        <span class="badge @(doc.IsActive ? "bg-success" : "bg-danger")">
                            @(doc.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>

                    <td class="text-end">

                            <button class="btn btn-sm btn-outline-warning me-1"
                                    @onclick="() => EditDoctor(doc.DoctorId)">
                                Edit
                            </button>
                        
                            <button class="btn btn-sm btn-outline-danger me-1"
                                    @onclick="() => ShowDeletePopup(doc.DoctorId)">
                                Delete
                            </button>

                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => ToggleStatus(doc)">
                                Toggle
                            </button>

                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

<!-- ✅ PAGINATION -->
<div class="d-flex justify-content-between mt-3">
    <button class="btn btn-outline-primary"
            disabled="@(_currentPage == 1)"
            @onclick="PrevPage">
        ⬅ Prev
    </button>

    <span class="fw-bold">
        Page @_currentPage / @TotalPages
    </span>

    <button class="btn btn-outline-primary"
            disabled="@(_currentPage == TotalPages)"
            @onclick="NextPage">
        Next ➡
    </button>
</div>

<!-- ✅ REGISTER MODAL -->
<RegisterDoctorModal 
    IsVisible="showModal"
    DoctorId="selectedDoctorId"
    IsVisibleChanged="@(v => showModal = v)"
    OnSaved="LoadDoctors" />

@if (showDeletePopup)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal show d-block">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">

                <h5 class="text-danger mb-3">⚠️ Confirm Delete</h5>

                <p>Are you sure you want to delete this doctor?</p>

                <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-danger" @onclick="ConfirmDelete">
                        Yes, Delete
                    </button>

                    <button class="btn btn-secondary" @onclick="CancelDelete">
                        Cancel
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {

    private PagedResult<DoctorListDto> result = new();

    private bool isLoading = true;

    private int? selectedDoctorId;
    private string searchText = "";
    private string selectedSpecialisation = "";
    private int? minExperience;
    private string statusFilter = "";
    private bool showDeletePopup = false;
    private int deleteDoctorId;
    private int _currentPage = 1;
    private int pageSize = 10;

    private int TotalPages => result.TotalPages;

    private List<string> specialisations = new();

    private bool showModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }


    private async Task LoadDoctors()
    {
        try
        {
            isLoading = true;

            
            var filter = new DoctorFilter
            {
                PageNumber = _currentPage,
                PageSize = pageSize,
                FullName = searchText, 
               Specialisation = selectedSpecialisation,
                MinExperience = minExperience,
                IsActive = string.IsNullOrEmpty(statusFilter) ? null : bool.Parse(statusFilter) 
        
            };
            result = await DoctorService.GetDoctors(filter);
            specialisations = result.Items?.Select(x => x.Specialisation)
                .Distinct()
                .ToList() ?? new List<string>();

        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            await LoadDoctors();
        }
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadDoctors();
        }
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadDoctors();
    }

    private void ShowDeletePopup(int id)
    {
        deleteDoctorId = id;
        showDeletePopup = true;
    }

    private async Task ConfirmDelete()
    {
        await DoctorService.DeleteDoctor(deleteDoctorId);

        showDeletePopup = false;

        await LoadDoctors();
    }

    private void CancelDelete()
    {
        showDeletePopup = false;
    }

    private async Task ToggleStatus(DoctorListDto doc)
    {
        await DoctorService.UpdateStatus(doc.DoctorId, !doc.IsActive);
        await LoadDoctors();
    }

  
    private void EditDoctor(int id)
    {
        selectedDoctorId = id;
        showModal = true;
    }


  
    private void ShowModal()
    {
        selectedDoctorId = null;
        showModal = true;
    }
 }