@page "/doctor/list"
@using Healthcare.Shared.DTOs.Doctor

@inject DoctorService DoctorService
@inject IJSRuntime JS

<h3 class="mb-3 text-primary fw-bold">👨‍⚕️ Doctor Management</h3>

<!-- ✅ FILTER PANEL -->
<div class="card shadow mb-4 p-3 border-0 bg-light">
    <div class="row g-2 align-items-end">

        <div class="col-md-3">
            <label class="form-label fw-bold">Search</label>

            <input class="form-control"
                   placeholder="Doctor name"
                   @bind="searchText"
                   @bind:event="oninput"
                   @bind:after="ApplyFilters" />

        </div>

        <div class="col-md-2">
            <label class="form-label fw-bold">Specialisation</label>

            <select class="form-select"
                    @bind="selectedSpecialisation"
                    @bind:after="ApplyFilters">
                <option value="">All</option>
                @foreach (var s in specialisations)
                {
                    <option value="@s">@s</option>
                }
            </select>

        </div>

        <div class="col-md-2">
            <label class="form-label fw-bold">Experience</label>
            <input type="number"
                        class="form-control"
                        @bind="minExperience"
                        @bind:event="oninput"
                        @bind:after="ApplyFilters" />
        </div>

        <div class="col-md-2">
            <label class="form-label fw-bold">Status</label>

                <select class="form-select"
                        @bind="statusFilter"
                        @bind:after="ApplyFilters">
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>

        </div>

        <div class="col-md-3 text-end">
            <button class="btn btn-success mt-3" @onclick="ShowModal">
                ➕ Register
            </button>
        </div>

    </div>
</div>

<!-- ✅ TABLE -->
<table class="table table-hover shadow-sm border">
    <thead class="table-primary">
        <tr>
            <th>Name</th>
            <th>Specialisation</th>
            <th>Experience</th>
            <th>Fee</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (isLoading)
        {
            <tr>
                <td colspan="6" class="text-center">Loading...</td>
            </tr>
        }
        else if (paginatedDoctors.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">
                    No doctors found
                </td>
            </tr>
        }
        else
        {
            @foreach (var doc in paginatedDoctors)
            {
                <tr>
                    <td>@doc.FullName</td>
                    <td>@doc.Specialisation</td>
                    <td>@doc.YearsOfExperience yrs</td>
                    <td>₹@doc.ConsultationFee</td>

                    <td>
                        <span class="badge @(doc.IsActive ? "bg-success" : "bg-danger")">
                            @(doc.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>

                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-warning me-1"
                                @onclick="() => EditDoctor(doc.DoctorId)">
                            ✏️
                        </button>

                        <button class="btn btn-sm btn-outline-danger me-1"
                                @onclick="() => DeleteDoctor(doc.DoctorId)">
                            🗑️
                        </button>

                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => ToggleStatus(doc)">
                            🔄
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- ✅ PAGINATION -->
<div class="d-flex justify-content-between mt-3">
    <button class="btn btn-outline-primary"
            disabled="@(_currentPage == 1)"
            @onclick="PrevPage">
        ⬅ Prev
    </button>

    <span class="fw-bold">
        Page @_currentPage / @TotalPages
    </span>

    <button class="btn btn-outline-primary"
            disabled="@(_currentPage == TotalPages)"
            @onclick="NextPage">
        Next ➡
    </button>
</div>

<!-- ✅ REGISTER MODAL -->
<RegisterDoctorModal 
    IsVisible="showModal"
    DoctorId="selectedDoctorId"
    IsVisibleChanged="@(v => showModal = v)"
    OnSaved="LoadDoctors" />

@code {

    private List<DoctorListDto> doctors = new();
    private List<DoctorListDto> filteredDoctors = new();
    private List<DoctorListDto> paginatedDoctors = new();

    private bool isLoading = true;

    private int? selectedDoctorId;
    private string searchText = "";
    private string selectedSpecialisation = "";
    private int? minExperience;
    private string statusFilter = "";

    private int _currentPage = 1;
    private int pageSize = 5;

    private int TotalPages =>
        (int)Math.Ceiling(filteredDoctors.Count / (double)pageSize);

    private List<string> specialisations = new();

    private bool showModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        try
        {
            isLoading = true;

            var result = await DoctorService.GetDoctors();
            doctors = result.Items;

            specialisations = doctors
                .Select(x => x.Specialisation)
                .Distinct()
                .ToList();

            ApplyFilters();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredDoctors = doctors
            .Where(d => string.IsNullOrEmpty(searchText) ||
                        d.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Where(d => string.IsNullOrEmpty(selectedSpecialisation) ||
                        d.Specialisation == selectedSpecialisation)
            .Where(d => !minExperience.HasValue ||
                        d.YearsOfExperience >= minExperience)
            .Where(d => string.IsNullOrEmpty(statusFilter) ||
                        d.IsActive.ToString().ToLower() == statusFilter)
            .ToList();

        _currentPage = 1;
        ApplyPagination();
    }

    private void ApplyPagination()
    {
        paginatedDoctors = filteredDoctors
            .Skip((_currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            ApplyPagination();
        }
    }

    private void PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            ApplyPagination();
        }
    }

    private async Task DeleteDoctor(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete doctor?"))
            return;

        await DoctorService.DeleteDoctor(id);
        await LoadDoctors();
    }

    private async Task ToggleStatus(DoctorListDto doc)
    {
        await DoctorService.UpdateStatus(doc.DoctorId, !doc.IsActive);
        await LoadDoctors();
    }

  
    private void EditDoctor(int id)
    {
        selectedDoctorId = id;
        showModal = true;
    }


  
    private void ShowModal()
    {
        selectedDoctorId = null;
        showModal = true;
    }
 }