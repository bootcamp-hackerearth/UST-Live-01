@using Healthcare.Shared.DTOs.Authentication;
@using Healthcare.Shared.DTOs.Doctor;

@inject DoctorService DoctorService
@inject IJSRuntime JS

@if (IsVisible)
{
    <!-- BACKDROP -->
    <div class="modal-backdrop fade show"></div>

    <!-- MODAL -->
    <div class="modal show d-block">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-3">

                <!-- TITLE -->
                <h4 class="text-center mb-3 text-primary">
                    @(isEditMode ? "Update Doctor" : "Doctor Registration")
                </h4>

                <!-- FORM -->
                <EditForm Model="@(isEditMode ? editDoctor : registerDoctor)" OnValidSubmit="HandleSave">
                    <DataAnnotationsValidator />
                    
                    <!-- NAME -->
                    <div class="mb-3">
                        <label class="form-label">Name</label>

                        @if (isEditMode)
                        {
                            <InputText class="form-control"
                                       @bind-Value="editDoctor.FullName" />
                        }
                        else
                        {
                            <InputText class="form-control"
                                       @bind-Value="registerDoctor.FullName" />

                            <!-- ✅ Validation -->
                            <ValidationMessage For="@(() => registerDoctor.FullName)" />
                        }
                    </div>

                    <!-- EMAIL (ONLY REGISTER) -->
                    @if (!isEditMode)
                    {
                        <div class="mb-2">
                            <label>Email</label>

                            <InputText class="form-control"
                                       @bind-Value="registerDoctor.Email"
                                       @oninput="() => emailError = null" />

                            <ValidationMessage For="@(() => registerDoctor.Email)" />

                            @if (!string.IsNullOrEmpty(emailError))
                            {
                                <div class="text-danger">@emailError</div>
                            }
                        </div>
                    }

                    <!-- SPECIALISATION -->
                    <div class="mb-3">
                        <label class="form-label">Specialisation</label>

                        @if (isEditMode)
                        {
                            <select class="form-select" @bind="editDoctor.Specialisation">
                                <option value="">Select</option>
                                @foreach (var s in specialisations)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        }
                        else
                        {
                            <select class="form-select" @bind="registerDoctor.Specialisation">
                                <option value="">Select</option>
                                @foreach (var s in specialisations)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>

                            <ValidationMessage For="@(() => registerDoctor.Specialisation)" />
                        }
                    </div>

                    <!-- EXPERIENCE -->
                    <div class="mb-3">
                        <label class="form-label">Experience</label>

                        @if (isEditMode)
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="editDoctor.YearsOfExperience" />
                        }
                        else
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="registerDoctor.YearsOfExperience" />

                            <ValidationMessage For="@(() => registerDoctor.YearsOfExperience)" />
                        }
                    </div>

                    <!-- FEE -->
                    <div class="mb-3">
                        <label class="form-label">Consultation Fee</label>

                        @if (isEditMode)
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="editDoctor.ConsultationFee" />
                        }
                        else
                        {
                            <InputNumber class="form-control"
                                         @bind-Value="registerDoctor.ConsultationFee" />

                            <ValidationMessage For="@(() => registerDoctor.ConsultationFee)" />
                        }
                    </div>

                    <!-- PASSWORD -->
                    @if (!isEditMode)
                    {
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="registerDoctor.Password" />

                            <ValidationMessage For="@(() => registerDoctor.Password)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="registerDoctor.ConfirmPassword" />

                            <ValidationMessage For="@(() => registerDoctor.ConfirmPassword)" />
                        </div>
                    }

                    <!-- TIME SLOTS -->
                    @if (!isEditMode)
                    {
                        <div class="mb-3">
                            <label class="fw-bold">Time Slots</label>

                            @foreach (var slot in availableSlots)
                            {
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           @onchange="(e) => ToggleSlot(slot, (bool)e.Value)" /> <!-- ✅ FIXED -->

                                    <label class="form-check-label">@slot</label>
                                </div>
                            }

                            @if (slotError)
                            {
                                <div class="text-danger">Select at least one slot</div>
                            }
                        </div>
                    }

                    <!-- BUTTONS -->
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-secondary" @onclick="ShowCancelConfirm">
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-success">
                            @(isEditMode ? "Update" : "Save")
                        </button>
                    </div>

                </EditForm>

            </div>
        </div>
    </div>
}


<!-- ✅ SUCCESS POPUP -->
@if (showSuccessPopup)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal show d-block">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">

                <h5 class="text-success mb-3">Success</h5>

                <p>@successMessage</p>

                <button class="btn btn-success" @onclick="CloseSuccessPopup">
                    OK
                </button>

            </div>
        </div>
    </div>
}

@code {

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public int? DoctorId { get; set; }

    private string ?emailError;
    private bool showSuccessPopup = false;
    private string successMessage = "";

    private bool isEditMode => DoctorId.HasValue;

    // ✅ REGISTER MODEL
    private DoctorRegisterDto registerDoctor = new()
    {
        TimeSlots = new List<string>()
    };

    // ✅ EDIT MODEL
    private UpdateDoctorDto editDoctor = new();

    private bool slotError = false;

    private List<string> availableSlots = new()
    {
        "09:00",
        "10:00",
        "11:00",
        "02:00",
        "04:00"
    };

    // ✅ LOAD DATA FOR EDIT
    protected override async Task OnParametersSetAsync()
    {
        if (DoctorId.HasValue)
        {
            var doc = await DoctorService.GetDoctorById(DoctorId.Value);

            editDoctor.FullName = doc.FullName;
            editDoctor.Specialisation = doc.Specialisation;
            editDoctor.YearsOfExperience = doc.YearsOfExperience;
            editDoctor.ConsultationFee = doc.ConsultationFee;
        }
    }

    // ✅ SAVE LOGIC
    private async Task HandleSave()
    {
        if (isEditMode)
        {
            await DoctorService.UpdateDoctor(DoctorId!.Value, editDoctor);
        }
        else
        {
            if (registerDoctor.TimeSlots.Count == 0)
            {
                slotError = true;
                return;
            }



            var error = await DoctorService.RegisterDoctor(registerDoctor);

            if (error != null)
            {
                if (error.Contains("Email already exists"))
                {
                    emailError = error;
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", error);
                }
                return;
            }


        }

        ShowSuccessPopup(isEditMode ? "Doctor updated successfully" : "Doctor registered successfully");
        await OnSaved.InvokeAsync();
        await CloseAndReset();
    }

    // ✅ SLOT HANDLING
    private void ToggleSlot(string slot, object value)
    {
        bool isChecked = value is bool b && b;

        if (isChecked)
        {
            if (!registerDoctor.TimeSlots.Contains(slot))
                registerDoctor.TimeSlots.Add(slot);
        }
        else
        {
            registerDoctor.TimeSlots.Remove(slot);
        }

        slotError = false;
    }

    // ✅ SUCCESS POPUP

    private void ShowSuccessPopup(string message)
    {
        successMessage = message;
        showSuccessPopup = true;
    }


    // ✅ CANCEL
    // ✅ FIXED (IMPORTANT)
    private async Task ShowCancelConfirm()
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Cancel?");
        if (confirm)
        {
            await CloseAndReset();
        }
    }

    // ✅ RESET
    private async Task CloseAndReset()
    {
        registerDoctor = new DoctorRegisterDto
        {
            TimeSlots = new List<string>()
        };

        editDoctor = new UpdateDoctorDto();

        await IsVisibleChanged.InvokeAsync(false);
    }

    //close popup
    private async Task CloseSuccessPopup()
    {
        showSuccessPopup = false;

        await OnSaved.InvokeAsync();
        await CloseAndReset();
    }


    //specialisation

    private List<string> specialisations = new()
   {
    "Dentist",
    "Cardiologist",
    "Orthopedic",
    "Neurologist",
    "Dermatologist"
    };


}