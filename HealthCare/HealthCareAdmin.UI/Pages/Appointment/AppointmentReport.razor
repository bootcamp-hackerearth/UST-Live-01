@page "/appointments/report"
@using Healthcare.Shared.DTOs.Appointments;

@inject AppointmentService AppointmentService
@inject IJSRuntime JS

<h3 class="mb-3 text-primary fw-bold">📊 Appointment Report</h3>

<!-- ✅ FILTER SECTION -->
<div class="card shadow-sm mb-4 p-3 border-0"
     style="background:#0F172A; color:white;">

    <div class="row g-3 align-items-end">

        <!-- Start Date -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Start Date</label>
            <InputDate class="form-control filter-input" @bind-Value="startDate" />
        </div>

        <!-- End Date -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">End Date</label>
            <InputDate class="form-control filter-input" @bind-Value="endDate" />
        </div>

        <!-- Search -->
        <div class="col-md-3">
            <button class="btn btn-primary mt-3" @onclick="LoadReport">
                Search
            </button>
        </div>

    </div>
</div>

<!-- ✅ TABLE -->
<table class="table table-hover shadow-sm border">
    <thead style="background:#0B5ED7; color:white;">
        <tr>
            <th>Date</th>
            <th>Pending</th>
            <th>Cancelled</th>
            <th>Confirmed</th>
            <th>Completed</th>
            <th>Total</th>
            <th>Revenue</th>
        </tr>
    </thead>

    <tbody>
        @if (isLoading)
        {
            <tr>
                <td colspan="5" class="text-center">Loading...</td>
            </tr>
        }
        else if (reports.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    No data found
                </td>
            </tr>
        }
        else
        {
            @foreach (var r in reports)
            {
                <tr>
                    <td>@r.Date</td>

                    <td class="text-warning fw-semibold">@r.PendingCount</td>
                    <td class="text-primary fw-semibold">@r.CancelledCount</td>
                    <td class="text-primary fw-semibold">@r.ConfirmedCount</td>
                    <td class="text-success fw-semibold">@r.CompletedCount</td>
                    <td class="fw-bold"> @(r.PendingCount + r.ConfirmedCount + r.CompletedCount + r.CancelledCount)</td>
                    <td class="fw-bold text-success">₹@r.DailyRevenue</td>
       
                </tr>
            }
        }
    </tbody>
</table>

<h5 class="text-success">
    Total Revenue: ₹@reports.Sum(r => r.DailyRevenue)
</h5>

@code {

    private List<AppointmentReportDto> reports = new();

    private DateTime startDate;
    private DateTime endDate;

    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        // ✅ Default last 7 days
        endDate = DateTime.Today;
        startDate = endDate.AddDays(-6);

        await LoadReport();
    }

    private async Task LoadReport()
    {
        if ((endDate - startDate).TotalDays > 6)
        {
            await JS.InvokeVoidAsync("alert", "Max 7 days allowed");
            return;
        }

        try
        {
            isLoading = true;

            reports = await AppointmentService
                .GetAppointmentReport(startDate, endDate);

            Console.WriteLine($"Records Count = {reports.Count}");

            foreach (var r in reports)
            {
                Console.WriteLine(
                    $"{r.Date} | P:{r.PendingCount} | C:{r.ConfirmedCount}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);

            await JS.InvokeVoidAsync(
                "alert",
                "Error loading report");
        }
        finally
        {
            isLoading = false;
        }
    }
}