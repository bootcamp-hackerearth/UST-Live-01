@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="sidebar">

    <div class="logo">🏥 Admin</div>

    <nav>
        <a href="/blazor/dashboard" class="nav-item">Dashboard</a>
        <a href="/blazor/doctor/list" class="nav-item">Doctors</a>
        <a href="/blazor/patient/list" class="nav-item"> Patients</a>
        <a href="/blazor/appointments/report" class="nav-item">Reports</a>
    </nav>

    <!-- ✅ LOGOUT AT BOTTOM -->
    <button class="logout-btn" @onclick="ShowLogoutPopup">
        Logout
    </button>

</div>

@if (showLogoutPopup)
{
    <div class="custom-backdrop"></div>

    <div class="custom-modal">
        <div class="custom-modal-content">

            <h5 class="text-danger mb-2">Confirm Logout</h5>

            <p class="text-muted">
                Are you sure you want to logout?
            </p>

            <div class="d-flex justify-content-center gap-2 mt-3">
                <button class="btn btn-danger" @onclick="Logout">
                    Logout
                </button>

                <button class="btn btn-outline-secondary" @onclick="CancelLogout">
                    Cancel
                </button>
            </div>

        </div>
    </div>
}


@code {

    private bool showLogoutPopup = false;

    private void ShowLogoutPopup()
    {
        showLogoutPopup = true;

        JS.InvokeVoidAsync("document.body.classList.add", "modal-open");
    }

    private void CancelLogout()
    {
        showLogoutPopup = false;

        JS.InvokeVoidAsync("document.body.classList.remove", "modal-open");
    }


   
    private async Task Logout()
    {
        showLogoutPopup = false;

        await JS.InvokeVoidAsync("document.body.classList.remove", "modal-open");

        await JS.InvokeVoidAsync("localStorage.removeItem", "token");

        await JS.InvokeVoidAsync("window.location.assign","/angular/");
    }

}