@implements IDisposable

@using HealthCare.Admin.Services
@using Microsoft.JSInterop

@inject SessionExpirationService SessionExpirationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@if (showSessionExpiredDialog)
{
    <div class="session-expired-backdrop">
        <div class="session-expired-dialog"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="session-expired-title"
             aria-describedby="session-expired-message">

            <div class="session-expired-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <h2 id="session-expired-title">
                Session Expired
            </h2>

            <p id="session-expired-message">
                Your session has expired. Please log in again to continue.
            </p>

            <button type="button"
                    class="session-expired-button"
                    disabled="@isRedirecting"
                    @onclick="ConfirmSessionExpiredAsync">

                @if (isRedirecting)
                {
                    <span class="session-expired-spinner"></span>
                    <span>Redirecting...</span>
                }
                else
                {
                    <span>OK</span>
                }
            </button>
        </div>
    </div>
}

<Router AppAssembly="@typeof(App).Assembly"
        NotFoundPage="typeof(Pages.NotFound)">

    <Found Context="routeData">
        <RouteView RouteData="@routeData"
                   DefaultLayout="@typeof(MainLayout)" />

        <FocusOnNavigate RouteData="@routeData"
                         Selector="h1" />
    </Found>
</Router>

@code {
    private bool showSessionExpiredDialog;
    private bool isRedirecting;

    protected override void OnInitialized()
    {
        Console.WriteLine(
            "App subscribed to session-expiration event.");

        SessionExpirationService.SessionExpired +=
            HandleSessionExpiredAsync;
    }

    private Task HandleSessionExpiredAsync()
    {
        Console.WriteLine(
            "App received session-expiration event.");

        return InvokeAsync(() =>
        {
            showSessionExpiredDialog = true;
            StateHasChanged();
        });
    }

    private async Task ConfirmSessionExpiredAsync()
    {
        if (isRedirecting)
        {
            return;
        }

        isRedirecting = true;

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "localStorage.removeItem",
                "accesstoken");

            await JSRuntime.InvokeVoidAsync(
                "localStorage.removeItem",
                "role");

            SessionExpirationService.Reset();

            showSessionExpiredDialog = false;

            NavigationManager.NavigateTo(
                "/angular/login",
                forceLoad: true,
                replace: true);
        }
        catch
        {
            isRedirecting = false;
            throw;
        }
    }

    public void Dispose()
    {
        SessionExpirationService.SessionExpired -=
            HandleSessionExpiredAsync;
    }
}