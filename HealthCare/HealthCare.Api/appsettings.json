{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {

    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:7125"
    ]
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest"
  },

  "Garnet": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "HealthCare"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }

    },
    "WriteTo": [
      { "Name": "Console" },

      {
        "Name": "File",
        "Args": {
          "path": "logs/healthcare-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 15
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodes": [ "http://localhost:9200" ],
          "dataStream": "logs-healthcare-api",
          "bootstrapMethod": "Failure"
        }
      }

    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "HealthCare.Api"
    }

  }
}
