{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {

    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:7125"
    ]
  },
 
  "ConnectionStrings": {
    "Dbconn": "Server=172.31.0.224,1433,Database=HealthCareDb;User Id=sa;Password=ajith@UST2003;TrustServerCertificate=True;Encrypt=True"
  },
  //"Garnet": {
  //  "ConnectionString": "localhost:6379",
  //  "InstanceName": "HealthCare"
  //},
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }

    },
    "WriteTo": [
      { "Name": "Console" },

      {
        "Name": "File",
        "Args": {
          "path": "logs/healthcare-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 15
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "HealthCare.Api"
    }

  }
}
