@inherits LayoutComponentBase
@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand-row">
            <div class="brand-logo">H</div>
            <div>
                <h2>HealthApp</h2>
                <span>Admin Console</span>
            </div>
        </div>

        <nav class="nav-list">
            <NavLink href="/dashboard" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/doctors">Doctor Management</NavLink>
            <NavLink href="/reports/appointments">Appointments Report</NavLink>
            <NavLink href="/patients">Patient Management</NavLink>
        </nav>

        <div class="sidebar-footer">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="admin-chip">
                        <span>Signed in as</span>
                        <strong>@GetEmail(context.User)</strong>
                    </div>

                    <button class="btn btn-outline-light" @onclick="Logout">
                        Logout
                    </button>
                </Authorized>

                <NotAuthorized>
                    <a class="btn btn-primary" href="/login">
                        Admin Login
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private async Task Logout()
    {
        await AuthApi.LogoutAsync();

        Navigation.NavigateTo("/login", replace: true);
    }

    private static string GetEmail(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
            ?? user.FindFirst("email")?.Value
            ?? "Admin";
    }
}