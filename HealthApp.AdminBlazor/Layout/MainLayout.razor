@inherits LayoutComponentBase
@using System.Security.Claims
@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<div class="@AppShellClass">
    <aside class="@SidebarClass">
        <div class="brand-row">
            <div class="brand-logo">H</div>

            <div class="brand-text">
                <h2>HealthApp</h2>
                <span>Admin Console</span>
            </div>

            <button class="sidebar-toggle-button"
                    title="@(isSidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                    @onclick="ToggleSidebar">
                @(isSidebarCollapsed ? "›" : "‹")
            </button>
        </div>

        <nav class="nav-list">
            <NavLink href="/blazor/dashboard" Match="NavLinkMatch.All" title="Dashboard">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 11.5L12 4l9 7.5v8.5a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1v-8.5z" />
                    </svg>
                </span>
                <span class="nav-text">Dashboard</span>
            </NavLink>

            <NavLink href="/blazor/doctors" title="Doctor Management">
                <span class="nav-icon doctor-plus-icon">✚</span>
                <span class="nav-text">Doctor Management</span>
            </NavLink>

            <NavLink href="/blazor/reports/appointments" title="Appointments Report">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 2h2v3H7V2zm8 0h2v3h-2V2z" />
                        <path d="M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 6v9h14v-9H5zm2 2h3v3H7v-3zm5 0h3v3h-3v-3z" />
                    </svg>
                </span>
                <span class="nav-text">Appointments Report</span>
            </NavLink>

            <NavLink href="/blazor/patients" title="Patient Management">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9z" />
                        <path d="M4 21a8 8 0 0 1 16 0H4z" />
                    </svg>
                </span>
                <span class="nav-text">Patient Management</span>
            </NavLink>
        </nav>
    </aside>

    @if (showSidebarClickAway)
    {
        <div class="sidebar-click-away" @onclick="CollapseSidebarFromOutside"></div>
    }

    <section class="main-area">
        <header class="topbar">
            <div class="topbar-title">
                <span>Admin Console</span>
                <strong>HealthApp Management</strong>
            </div>

            <AuthorizeView Roles="Admin" Context="authContext">
                <Authorized>
                    <div class="topbar-actions">
                        <div class="admin-profile-card">
                            <div class="admin-avatar">A</div>

                            <div class="admin-profile-text">
                                <strong>@GetEmail(authContext.User)</strong>
                                <span>Administrator</span>
                            </div>
                        </div>

                        <button class="btn topbar-logout-button" @onclick="OpenLogoutConfirmation">
                            Logout
                        </button>
                    </div>
                    </Authorized>
                </AuthorizeView>
        </header>

        <main class="main-content">
            @Body
        </main>
    </section>
</div>

@if (showLogoutConfirmModal)
{
    <div class="logout-modal-backdrop">
        <div class="logout-confirm-modal">
            <div class="logout-modal-header">
                <div>
                    <span>Logout Confirmation</span>
                    <h2>Are you sure?</h2>
                </div>

                <button class="logout-modal-x" @onclick="CloseLogoutConfirmation">×</button>
            </div>

            <p class="logout-confirm-text">
                Are you sure you want to logout from <strong>HealthApp Admin</strong>?
            </p>

            <div class="logout-modal-actions">
                <button class="logout-close-outline" type="button" @onclick="CloseLogoutConfirmation">
                    Close
                </button>

                <button class="logout-confirm-button" type="button" @onclick="ConfirmLogout">
                    Confirm Logout
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string AngularLoginUrl = "/login";

    private bool isSidebarCollapsed = true;
    private bool showSidebarClickAway;
    private bool showLogoutConfirmModal;

    private string AppShellClass => isSidebarCollapsed
        ? "app-shell sidebar-collapsed"
        : "app-shell";

    private string SidebarClass => isSidebarCollapsed
        ? "sidebar collapsed"
        : "sidebar";

    private void ToggleSidebar()
    {
        if (isSidebarCollapsed)
        {
            isSidebarCollapsed = false;
            showSidebarClickAway = true;
        }
        else
        {
            isSidebarCollapsed = true;
            showSidebarClickAway = false;
        }
    }

    private void CollapseSidebarFromOutside()
    {
        isSidebarCollapsed = true;
        showSidebarClickAway = false;
    }

    private void OpenLogoutConfirmation()
    {
        showLogoutConfirmModal = true;
    }

    private void CloseLogoutConfirmation()
    {
        showLogoutConfirmModal = false;
    }

    private async Task ConfirmLogout()
    {
        showLogoutConfirmModal = false;

        await AuthApi.LogoutAsync();

        Navigation.NavigateTo(AngularLoginUrl, forceLoad: true);
    }

    private static string GetEmail(ClaimsPrincipal user)
    {
        return user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("email")?.Value
            ?? "Admin";
    }
}