@inject NavigationManager Navigation

@code {
    private const string AngularLoginUrl = "http://localhost:4200/login";

    protected override void OnInitialized()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);

        if (relativePath.StartsWith("auth-bridge", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        Navigation.NavigateTo(AngularLoginUrl, forceLoad: true);
    }
}