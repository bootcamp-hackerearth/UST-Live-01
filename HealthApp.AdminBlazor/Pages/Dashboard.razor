@page "/dashboard"
@inject AdminAuthStateService AuthState
@inject InMemoryAdminDataService Data
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard</PageTitle>

<div class="page-header">
    <div>
        <h1>Admin Dashboard</h1>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card"><span>Total Doctors</span><strong>@Data.Doctors.Count</strong></div>
    <div class="stat-card"><span>Active Doctors</span><strong>@Data.Doctors.Count(d => d.IsActive)</strong></div>
    <div class="stat-card"><span>Users</span><strong>@Data.Users.Count</strong></div>
    <div class="stat-card"><span>Appointments</span><strong>@Data.Appointments.Count</strong></div>
</div>

<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-header">
            <h2>Recent Doctors</h2>
            <a href="/doctors">Manage</a>
        </div>
        <table class="table">
            <thead><tr><th>Name</th><th>Specialisation</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var doctor in Data.Doctors.Take(5))
                {
                    <tr>
                        <td>@doctor.FullName</td>
                        <td>@doctor.Specialisation</td>
                        <td><span class="badge @(doctor.IsActive ? "success" : "muted")">@(doctor.IsActive ? "Active" : "Inactive")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="panel">
        <div class="panel-header">
            <h2>Appointment Report Preview</h2>
            <a href="/reports/appointments">View Report</a>
        </div>
        <div class="report-preview">
            @foreach (var report in Data.GetAppointmentReports().Take(4))
            {
                <div class="report-row">
                    <strong>@report.Date.ToString("dd MMM yyyy")</strong>
                    <span>Confirmed: @report.Confirmed</span>
                    <span>Cancelled: @report.Cancelled</span>
                    <span>Completed: @report.Completed</span>
                </div>
            }
        </div>
    </section>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }
}
