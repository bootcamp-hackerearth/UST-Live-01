@page "/dashboard"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using HealthApp.Shared.DTOs
@inject AdminApiService AdminApi

<PageTitle>Admin Dashboard</PageTitle>

<div class="dashboard-page refined-dashboard">
    <section class="dashboard-hero-v2">
        <div>
            <span class="dashboard-kicker">Admin Console</span>
            <h1>Admin Dashboard</h1>
        </div>

        <div class="dashboard-date-card-v2">
            <span>Today</span>
            <strong>@DateTime.Today.ToString("dd MMM yyyy")</strong>
        </div>
    </section>

    @if (isLoading)
    {
        <section class="dashboard-loading-card">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <div class="loading-text">
                <h3>Loading dashboard</h3>
                <p>Please wait while the latest admin data is loaded.</p>
            </div>

            <div class="progress dashboard-progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width: 100%">
                </div>
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-error">
            @errorMessage
        </div>
    }
    else
    {
        <section class="metric-strip">
            <div class="metric-card metric-doctors">
                <span>Total Doctors</span>
                <strong>@doctors.Count</strong>
            </div>

            <div class="metric-card metric-active">
                <span>Active Doctors</span>
                <strong>@doctors.Count(d => d.IsActive)</strong>
            </div>

            <div class="metric-card metric-patients">
                <span>Total Patients</span>
                <strong>@patients.Count</strong>
            </div>

            <div class="metric-card metric-appointments">
                <span>Appointments</span>
                <strong>@TotalAppointments</strong>
            </div>
        </section>

        <section class="dashboard-focus-grid">
            <div class="summary-panel operations-panel">
                <div class="panel-title-block">
                    <span>Operations</span>
                    <h2>Today's Overview</h2>
                </div>

                <div class="overview-pill-grid">
                    <div class="overview-pill">
                        <span>Today's Appointments</span>
                        <strong>@TodayAppointments</strong>
                    </div>

                    <div class="overview-pill pending-pill">
                        <span>Pending</span>
                        <strong>@TotalPending</strong>
                    </div>

                    <div class="overview-pill completed-pill">
                        <span>Completed</span>
                        <strong>@TotalCompleted</strong>
                    </div>

                    <div class="overview-pill cancelled-pill">
                        <span>Cancelled</span>
                        <strong>@TotalCancelled</strong>
                    </div>
                </div>
            </div>

            <div class="summary-panel actions-panel">
                <div class="panel-title-block">
                    <span>Shortcuts</span>
                    <h2>Quick Actions</h2>
                </div>

                <div class="quick-action-list-v2">
                    <a class="quick-action-card-v2" href="/doctors">
                        <div class="quick-action-icon-v2">✚</div>

                        <div>
                            <strong>Manage Doctors</strong>
                            <span>Add, edit, activate, or deactivate doctor profiles.</span>
                        </div>
                    </a>

                    <a class="quick-action-card-v2" href="/patients">
                        <div class="quick-action-icon-v2">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9z" />
                                <path d="M4 21a8 8 0 0 1 16 0H4z" />
                            </svg>
                        </div>                       
                        <div>
                            <strong>View Patients</strong>
                            <span>Search and view registered patient details.</span>
                        </div>
                    </a>

                    <a class="quick-action-card-v2" href="/reports/appointments">
                        <div class="quick-action-icon-v2">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7 2h2v3H7V2zm8 0h2v3h-2V2z" />
                                <path d="M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 6v9h14v-9H5zm2 2h3v3H7v-3zm5 0h3v3h-3v-3z" />
                            </svg>
                        </div>       
                        <div>
                            <strong>Appointment Reports</strong>
                            <span>Review daily appointment counts by status.</span>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private List<DoctorDto> doctors = new();
    private List<PatientDto> patients = new();
    private List<AppointmentReportDto> reports = new();

    private bool isLoading = true;
    private string? errorMessage;

    private int TotalPending => reports.Sum(r => r.Pending);
    private int TotalCancelled => reports.Sum(r => r.Cancelled);
    private int TotalCompleted => reports.Sum(r => r.Completed);
    private int TotalAppointments => reports.Sum(r => r.Pending + r.Confirmed + r.Cancelled + r.Completed);
    private int TodayAppointments => reports.Where(r => r.Date.Date == DateTime.Today).Sum(r => r.Pending + r.Confirmed + r.Cancelled + r.Completed);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            doctors = await AdminApi.GetDoctorsAsync();
            patients = await AdminApi.GetPatientsAsync();
            reports = await AdminApi.GetAppointmentReportsAsync();
        }
        catch
        {
            errorMessage = "Unable to load dashboard data. Please check API connection or login again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
