@page "/login"
@layout EmptyLayout
@using HealthApp.AdminBlazor.Services
@using HealthApp.Shared.DTOs
@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<PageTitle>Admin Login</PageTitle>

<section class="health-login-page">
    <div class="health-login-card">
        <div class="login-logo mx-auto">
            H
        </div>

        <div class="login-heading">
            <h1>Admin Login</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger login-alert" role="alert">
                @errorMessage
            </div>
        }

        <EditForm Model="loginDto" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="login-field">
                <label>Email address</label>

                <InputText class="form-control login-control"
                           @bind-Value="loginDto.Email"
                           placeholder="Enter admin email"
                           disabled="@isLoading" />

                <ValidationMessage For="@(() => loginDto.Email)" />
            </div>

            <div class="login-field">
                <label>Password</label>

                <InputText class="form-control login-control"
                           type="password"
                           @bind-Value="loginDto.Password"
                           placeholder="Enter password"
                           disabled="@isLoading" />

                <ValidationMessage For="@(() => loginDto.Password)" />
            </div>

            <button class="btn login-submit-button"
                    type="submit"
                    disabled="@isLoading">
                Login
            </button>
        </EditForm>
    </div>

    @if (isLoading)
    {
        <div class="login-loading-backdrop">
            <div class="login-loading-box">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>

                <h3>Signing in</h3>
                <p>Please wait while we verify your admin access.</p>

                <div class="progress login-popup-progress">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: 100%">
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private LoginRequestDto loginDto = new();

    private string? errorMessage;

    private bool isLoading;

    private async Task HandleLogin()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var result = await AuthApi.LoginAsync(loginDto);

            if (result is null)
            {
                errorMessage = "Invalid admin credentials or this account is not authorized for admin access.";
                return;
            }

            Navigation.NavigateTo("/dashboard", replace: true);
        }
        catch
        {
            errorMessage = "Unable to connect to the server. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}