@page "/users"
@inject AdminAuthStateService AuthState
@inject InMemoryAdminDataService Data
@inject NavigationManager Navigation

<PageTitle>User Management</PageTitle>

<div class="page-header">
    <div>
        <h1>User Management</h1>
        <p>View in-memory users and filter by role.</p>
    </div>
</div>

<div class="toolbar">
    <InputText class="input" placeholder="Search users..." @bind-Value="searchText" @bind-Value:event="oninput" />
    <select class="input" @bind="roleFilter">
        <option value="All">All Roles</option>
        <option value="Admin">Admin</option>
        <option value="Doctor">Doctor</option>
        <option value="Patient">Patient</option>
    </select>
</div>

<section class="panel">
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Password State</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in FilteredUsers)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td><span class="badge info">@user.Role</span></td>
                    <td><span class="badge @(user.MustChangePassword ? "warning" : "success")">@(user.MustChangePassword ? "Change Required" : "Ready")</span></td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private string searchText = string.Empty;
    private string roleFilter = "All";

    private IEnumerable<UserDto> FilteredUsers => Data.Users
        .Where(u => roleFilter == "All" || u.Role == roleFilter)
        .Where(u => string.IsNullOrWhiteSpace(searchText)
            || u.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || u.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }
}
