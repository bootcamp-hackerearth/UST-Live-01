@page "/doctors"
@attribute [Authorize(Roles = "Admin")]
@inject AdminApiService AdminApi

<PageTitle>Doctor Management</PageTitle>

<div class="page-header">
    <div>
        <h1>Doctor Management</h1>
        <p>Register, edit, and toggle active/inactive doctors.</p>
    </div>

    <button class="btn btn-primary" @onclick="StartCreate">Add Doctor</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-error" : "alert-success")">
        @message
    </div>
}

<div class="toolbar">
    <input class="input"
           placeholder="Search doctors..."
           @bind="searchText"
           @bind:event="oninput" />

    <select class="input" @bind="statusFilter">
        <option value="All">All</option>
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
    </select>
</div>

@if (showCreateForm)
{
    <section class="panel form-panel">
        <h2>Register Doctor</h2>

        <EditForm Model="createDto" OnValidSubmit="CreateDoctor">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div>
                    <label>Full Name</label>
                    <InputText class="input" @bind-Value="createDto.FullName" />
                </div>

                <div>
                    <label>Email</label>
                    <InputText class="input" @bind-Value="createDto.Email" />
                </div>

                <div>
                    <label>Temporary Password</label>
                    <InputText class="input" type="password" @bind-Value="createDto.TemporaryPassword" />
                </div>

                <div>
                    <label>Specialisation</label>
                    <InputSelect class="input" @bind-Value="createDto.Specialisation">
                        @foreach (var specialisation in Enum.GetValues<SpecialisationType>())
                        {
                            <option value="@specialisation">@specialisation</option>
                        }
                    </InputSelect>
                </div>

                <div>
                    <label>Practice Start Date</label>
                    <InputDate class="input" @bind-Value="createDto.PracticeStartDate" />
                </div>

                <div>
                    <label>Consultation Fee</label>
                    <InputNumber class="input" @bind-Value="createDto.ConsultationFee" />
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Register Doctor")
                </button>

                <button class="btn btn-secondary" type="button" @onclick="CancelForms">
                    Cancel
                </button>
            </div>
        </EditForm>
    </section>
}

@if (editingDoctorId is not null)
{
    <section class="panel form-panel">
        <h2>Edit Doctor</h2>

        <EditForm Model="updateDto" OnValidSubmit="UpdateDoctor">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div>
                    <label>Full Name</label>
                    <InputText class="input" @bind-Value="updateDto.FullName" />
                </div>

                <div>
                    <label>Specialisation</label>
                    <InputSelect class="input" @bind-Value="updateDto.Specialisation">
                        @foreach (var specialisation in Enum.GetValues<SpecialisationType>())
                        {
                            <option value="@specialisation">@specialisation</option>
                        }
                    </InputSelect>
                </div>

                <div>
                    <label>Practice Start Date</label>
                    <InputDate class="input" @bind-Value="updateDto.PracticeStartDate" />
                </div>

                <div>
                    <label>Consultation Fee</label>
                    <InputNumber class="input" @bind-Value="updateDto.ConsultationFee" />
                </div>

                <div class="checkbox-row">
                    <InputCheckbox @bind-Value="updateDto.IsActive" />
                    <span>Active</span>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>

                <button class="btn btn-secondary" type="button" @onclick="CancelForms">
                    Cancel
                </button>
            </div>
        </EditForm>
    </section>
}

@if (isLoading)
{
    <section class="panel">
        <p>Loading doctors...</p>
    </section>
}
else
{
    <section class="panel">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Specialisation</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!FilteredDoctors.Any())
                {
                    <tr>
                        <td colspan="6">No doctors found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var doctor in FilteredDoctors)
                    {
                        <tr>
                            <td>@doctor.FullName</td>
                            <td>@doctor.Specialisation</td>
                            <td>@doctor.YearsOfExperience yrs</td>
                            <td>₹@doctor.ConsultationFee</td>
                            <td>
                                <span class="badge @(doctor.IsActive ? "success" : "muted")">
                                    @(doctor.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="action-cell">
                                <button class="btn btn-small" @onclick="() => StartEdit(doctor.DoctorId)">
                                    Edit
                                </button>

                                <button class="btn btn-small btn-secondary" @onclick="() => ToggleStatus(doctor.DoctorId)">
                                    @(doctor.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>
}

@code {
    private List<DoctorDto> doctors = new();

    private string searchText = string.Empty;
    private string statusFilter = "All";
    private string? message;

    private bool isLoading = true;
    private bool isSaving;
    private bool isError;

    private bool showCreateForm;
    private int? editingDoctorId;

    private CreateDoctorDto createDto = new();
    private UpdateDoctorDto updateDto = new();

    private IEnumerable<DoctorDto> FilteredDoctors => doctors
        .Where(d =>
            string.IsNullOrWhiteSpace(searchText) ||
            d.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            d.Specialisation.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .Where(d =>
            statusFilter == "All" ||
            (statusFilter == "Active" && d.IsActive) ||
            (statusFilter == "Inactive" && !d.IsActive));

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctorsAsync();
    }

    private async Task LoadDoctorsAsync()
    {
        try
        {
            isLoading = true;
            message = null;
            isError = false;

            doctors = await AdminApi.GetDoctorsAsync();
        }
        catch
        {
            message = "Unable to load doctors. Please check API connection or login again.";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartCreate()
    {
        editingDoctorId = null;
        showCreateForm = true;
        message = null;
        isError = false;

        createDto = new CreateDoctorDto
        {
            Specialisation = SpecialisationType.GeneralPractitioner,
            PracticeStartDate = DateTime.Today.AddYears(-5),
            ConsultationFee = 1000
        };
    }

    private async Task CreateDoctor()
    {
        try
        {
            isSaving = true;
            message = null;
            isError = false;

            var createdDoctor = await AdminApi.CreateDoctorAsync(createDto);

            if (createdDoctor is null)
            {
                message = "Doctor registration failed.";
                isError = true;
                return;
            }

            message = "Doctor registered successfully with a temporary password.";
            isError = false;
            showCreateForm = false;

            await LoadDoctorsAsync();
        }
        catch
        {
            message = "Doctor registration failed. Please check the details and try again.";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEdit(int doctorId)
    {
        var doctor = doctors.FirstOrDefault(d => d.DoctorId == doctorId);

        if (doctor is null)
        {
            return;
        }

        showCreateForm = false;
        editingDoctorId = doctorId;
        message = null;
        isError = false;

        updateDto = new UpdateDoctorDto
        {
            FullName = doctor.FullName,
            Specialisation = doctor.Specialisation,
            PracticeStartDate = DateTime.Today.AddYears(-doctor.YearsOfExperience),
            ConsultationFee = doctor.ConsultationFee,
            IsActive = doctor.IsActive
        };
    }

    private async Task UpdateDoctor()
    {
        if (editingDoctorId is null)
        {
            return;
        }

        try
        {
            isSaving = true;
            message = null;
            isError = false;

            var updatedDoctor = await AdminApi.UpdateDoctorAsync(editingDoctorId.Value, updateDto);

            if (updatedDoctor is null)
            {
                message = "Doctor update failed.";
                isError = true;
                return;
            }

            message = "Doctor updated successfully.";
            isError = false;
            editingDoctorId = null;

            await LoadDoctorsAsync();
        }
        catch
        {
            message = "Doctor update failed. Please try again.";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleStatus(int doctorId)
    {
        var doctor = doctors.FirstOrDefault(d => d.DoctorId == doctorId);

        if (doctor is null)
        {
            return;
        }

        var dto = new UpdateDoctorDto
        {
            FullName = doctor.FullName,
            Specialisation = doctor.Specialisation,
            PracticeStartDate = DateTime.Today.AddYears(-doctor.YearsOfExperience),
            ConsultationFee = doctor.ConsultationFee,
            IsActive = !doctor.IsActive
        };

        try
        {
            var updatedDoctor = await AdminApi.UpdateDoctorAsync(doctorId, dto);

            if (updatedDoctor is null)
            {
                message = "Doctor status update failed.";
                isError = true;
                return;
            }

            message = "Doctor status updated successfully.";
            isError = false;

            await LoadDoctorsAsync();
        }
        catch
        {
            message = "Doctor status update failed. Please try again.";
            isError = true;
        }
    }

    private void CancelForms()
    {
        showCreateForm = false;
        editingDoctorId = null;
        message = null;
        isError = false;
    }
}