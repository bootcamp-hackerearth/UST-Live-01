@page "/reports/appointments"
@inject AdminAuthStateService AuthState
@inject InMemoryAdminDataService Data
@inject NavigationManager Navigation

<PageTitle>Appointments Report</PageTitle>

<div class="page-header">
    <div>
        <h1>Appointments Report</h1>
        <p>Daily totals for pending, confirmed, cancelled, and completed appointments.</p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card"><span>Pending</span><strong>@Reports.Sum(r => r.Pending)</strong></div>
    <div class="stat-card"><span>Confirmed</span><strong>@Reports.Sum(r => r.Confirmed)</strong></div>
    <div class="stat-card"><span>Cancelled</span><strong>@Reports.Sum(r => r.Cancelled)</strong></div>
    <div class="stat-card"><span>Completed</span><strong>@Reports.Sum(r => r.Completed)</strong></div>
</div>

<section class="panel">
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Pending</th>
                <th>Confirmed</th>
                <th>Cancelled</th>
                <th>Completed</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Reports)
            {
                <tr>
                    <td>@report.Date.ToString("dd MMM yyyy")</td>
                    <td><span class="badge warning">@report.Pending</span></td>
                    <td><span class="badge info">@report.Confirmed</span></td>
                    <td><span class="badge danger">@report.Cancelled</span></td>
                    <td><span class="badge success">@report.Completed</span></td>
                    <td>@report.Total</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    private List<AppointmentReportDto> Reports => Data.GetAppointmentReports();

    protected override void OnInitialized()
    {
        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }
}
