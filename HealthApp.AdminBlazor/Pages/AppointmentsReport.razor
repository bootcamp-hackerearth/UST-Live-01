@page "/reports/appointments"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using HealthApp.Shared.DTOs
@using System.Net
@inject AdminApiService AdminApi
@inject NavigationManager Navigation

<PageTitle>Appointments Report</PageTitle>

<div class="appointment-report-page">
    <section class="report-hero-card">
        <div>
            <span class="report-kicker">Admin Report</span>
            <h1>Appointments Report</h1>
        </div>
    </section>

    @if (isLoading)
    {
        <section class="report-loading-card">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <div>
                <h3>Loading appointment reports</h3>
                <p>Please wait while the latest report data is loaded.</p>
            </div>

            <div class="progress report-progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width: 100%">
                </div>
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="admin-message-card error">
            <div>
                <strong>Action Failed</strong>
                <span>@errorMessage</span>
            </div>
        </div>
    }
    else
    {
        <section class="report-status-grid">
            <div class="report-status-card pending">
                <span>Pending</span>
                <strong>@TotalPending</strong>
            </div>

            <div class="report-status-card confirmed">
                <span>Confirmed</span>
                <strong>@TotalConfirmed</strong>
            </div>

            <div class="report-status-card cancelled">
                <span>Cancelled</span>
                <strong>@TotalCancelled</strong>
            </div>

            <div class="report-status-card completed">
                <span>Completed</span>
                <strong>@TotalCompleted</strong>
            </div>
        </section>

        <section class="report-table-card">
            <div class="report-table-header report-table-header-paged">
                <div>
                    <h2>Daily Appointment Summary</h2>
                    <p>@totalCount total report day(s), showing @Reports.Count on this page</p>
                </div>

                <div class="report-page-size-pill">
                    5 per page
                </div>
            </div>

            <div class="report-table-wrapper">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Pending</th>
                            <th>Confirmed</th>
                            <th>Cancelled</th>
                            <th>Completed</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Reports.Any())
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="report-empty-state">
                                        <strong>No appointment report data found.</strong>
                                        <span>Reports will appear here once appointments are available.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var report in Reports)
                            {
                                <tr>
                                    <td>
                                        <div class="report-date-cell">
                                            <strong>@report.Date.ToString("dd MMM yyyy")</strong>
                                            <span>@report.Date.ToString("dddd")</span>
                                        </div>
                                    </td>
                                    <td><span class="report-count pending">@report.Pending</span></td>
                                    <td><span class="report-count confirmed">@report.Confirmed</span></td>
                                    <td><span class="report-count cancelled">@report.Cancelled</span></td>
                                    <td><span class="report-count completed">@report.Completed</span></td>
                                    <td><strong>@GetTotal(report)</strong></td>
                                    <td>
                                        <button class="report-view-button" @onclick="() => ViewDate(report.Date)">
                                            View
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="report-pagination-bar">
                <button class="report-pagination-button"
                        disabled="@(!hasPreviousPage || isLoading)"
                        @onclick="PreviousPage">
                    Previous
                </button>

                <div class="report-pagination-info">
                    <strong>Page @pageNumber of @SafeTotalPages</strong>
                    <span>@totalCount total report days</span>
                </div>

                <button class="report-pagination-button"
                        disabled="@(!hasNextPage || isLoading)"
                        @onclick="NextPage">
                    Next
                </button>
            </div>
        </section>
    }
</div>

@code {
    private List<AppointmentReportDto> Reports = new();
    private List<AppointmentReportDto> summaryReports = new();

    private bool isLoading = true;
    private string? errorMessage;

    private int pageNumber = 1;
    private const int PageSize = 5;
    private int totalCount;
    private int totalPages;
    private bool hasPreviousPage;
    private bool hasNextPage;

    private int SafeTotalPages => totalPages < 1 ? 1 : totalPages;

    private int TotalPending => summaryReports.Sum(r => r.Pending);
    private int TotalConfirmed => summaryReports.Sum(r => r.Confirmed);
    private int TotalCancelled => summaryReports.Sum(r => r.Cancelled);
    private int TotalCompleted => summaryReports.Sum(r => r.Completed);

    protected override async Task OnInitializedAsync()
    {
        await LoadReportsAsync(loadSummary: true);
    }

    private async Task LoadReportsAsync(bool loadSummary = false)
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            if (loadSummary)
            {
                var summaryResult = await AdminApi.GetAppointmentReportsAsync(
                    pageNumber: 1,
                    pageSize: 50);

                summaryReports = summaryResult.Items;
            }

            var result = await AdminApi.GetAppointmentReportsAsync(
                pageNumber,
                PageSize);

            Reports = result.Items;
            pageNumber = result.PageNumber;
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;
            hasPreviousPage = result.HasPreviousPage;
            hasNextPage = result.HasNextPage;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            errorMessage = "Session expired. Please login again.";
        }
        catch
        {
            errorMessage = "Unable to load appointment reports. Please check API connection or login again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPage()
    {
        if (!hasPreviousPage)
        {
            return;
        }

        pageNumber--;
        await LoadReportsAsync();
    }

    private async Task NextPage()
    {
        if (!hasNextPage)
        {
            return;
        }

        pageNumber++;
        await LoadReportsAsync();
    }

    private static int GetTotal(AppointmentReportDto report)
    {
        return report.Pending + report.Confirmed + report.Cancelled + report.Completed;
    }

    private void ViewDate(DateTime date)
    {
        Navigation.NavigateTo($"/reports/appointments/details/{date:yyyy-MM-dd}");
    }
}
