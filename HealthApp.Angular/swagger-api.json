  "components": {
    "schemas": {
      "AppointmentDto": {
        "required": [
          "doctorId",
          "scheduledDate",
          "status",
          "timeSlot"
        ],
        "type": "object",
        "properties": {
          "appointmentId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "patientName": {
            "type": "string",
            "nullable": true
          },
          "doctorName": {
            "type": "string",
            "nullable": true
          },
          "scheduledDate": {
            "type": "string",
            "format": "date"
          },
          "timeSlot": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "maxLength": 50,
            "minLength": 1,
            "pattern": "Pending|Confirmed|Completed|Cancelled",
            "type": "string"
          },
          "cancellationReason": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          },
          "confirmPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DoctorDto": {
        "required": [
          "consultationFee",
          "doctorPhoneNumber",
          "email",
          "fullName",
          "practiceStartDate",
          "specialisation"
        ],
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "maxLength": 200,
            "minLength": 3,
            "type": "string"
          },
          "specialisation": {
            "minLength": 1,
            "type": "string"
          },
          "practiceStartDate": {
            "type": "string",
            "format": "date"
          },
          "consultationFee": {
            "maximum": 10000000,
            "minimum": 1,
            "type": "number",
