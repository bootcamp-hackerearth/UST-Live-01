@page "/admin/doctors"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using HealthAxis.Shared.DTOs.Doctor
@using HealthAxis.Shared.DTOs.Appointment
@using HealthAxis.Shared.Enums
@using HealthAxisAdminLayout.Layout
@using HealthAxisAdminLayout.Services.Interfaces

@layout HealthAxisAdminLayout.Layout.AdminLayout

@inject IDoctorApiService DoctorService
@inject IAppointmentApiService AppointmentService
@inject IJSRuntime JS

<div class="doctor-page">

    <div class="doctor-hero">
        <div>
            <div class="dashboard-kicker">Doctor Management</div>
            <h1>Doctors</h1>
            <p>Register, update, activate, and manage HealthAxis doctor profiles.</p>
        </div>

        <button class="doctor-add-btn" @onclick="OpenCreateForm">
            + Add Doctor
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageCssClass">
            @message
        </div>
    }

    @if (showTempPasswordBox)
    {
        <div class="doctor-temp-password-card">

            <div class="doctor-temp-password-header">
                <div>
                    <h3>Temporary Password Generated</h3>

                    <p>
                        Share these credentials with the doctor. This password is shown only after doctor creation.
                    </p>
                </div>

                <button type="button"
                        class="doctor-temp-close-btn"
                        @onclick="CloseTempPasswordBox">
                    ×
                </button>
            </div>

            <div class="doctor-temp-details">

                <div>
                    <span>Doctor</span>
                    <strong>@createdDoctorName</strong>
                </div>

                <div>
                    <span>Email</span>
                    <strong>@createdDoctorEmail</strong>
                </div>

                <div>
                    <span>Temporary Password</span>
                    <strong class="doctor-temp-password">@temporaryPassword</strong>
                </div>

            </div>

            <div class="doctor-temp-actions">
                <button type="button"
                        class="doctor-copy-btn"
                        @onclick="CopyTempPassword">
                    Copy Password
                </button>

                <button type="button"
                        class="doctor-copy-all-btn"
                        @onclick="CopyDoctorCredentials">
                    Copy Login Details
                </button>
            </div>

            <div class="doctor-temp-warning">
                Ask the doctor to login from the main HealthAxis portal and change the password on first login.
            </div>

        </div>
    }

    @if (showForm)
    {
        <div class="doctor-form-panel">

            <div class="doctor-form-header">
                <div>
                    <h3>@(isEditMode ? "Edit Doctor" : "Add Doctor")</h3>
                    <p>@(isEditMode ? "Update doctor profile information." : "Create a new doctor profile.")</p>
                </div>

                <button class="doctor-outline-btn" @onclick="CloseForm" disabled="@isLoading">
                    Close
                </button>
            </div>

            @if (validationErrors.Count > 0)
            {
                <div class="doctor-validation-box">
                    @foreach (var error in validationErrors)
                    {
                        <div>@error</div>
                    }
                </div>
            }

            <div class="doctor-form-grid">

                <div class="doctor-field">
                    <label for="doctorName">Doctor Name</label>
                    <input id="doctorName"
                           placeholder="Enter doctor name"
                           @bind="doctorForm.DoctorName" />
                </div>

                <div class="doctor-field">
                    <label for="doctorEmail">Email</label>
                    <input id="doctorEmail"
                           placeholder="Enter email"
                           @bind="doctorForm.Email" />
                </div>

                <div class="doctor-field">
                    <label for="doctorSpecialisation">Specialisation</label>
                    <select id="doctorSpecialisation" @bind="doctorForm.Specialisation">
                        @foreach (var spec in Enum.GetValues<SpecialisationType>())
                        {
                            <option value="@spec">@spec</option>
                        }
                    </select>
                </div>

                <div class="doctor-field">
                    <label for="doctorExperience">Experience</label>
                    <input id="doctorExperience"
                           type="number"
                           min="0"
                           placeholder="Years of experience"
                           @bind="doctorForm.YearsOfExperience" />
                </div>

                <div class="doctor-field">
                    <label for="doctorConsultationFee">Consultation Fee</label>
                    <input id="doctorConsultationFee"
                           type="number"
                           min="0"
                           step="0.01"
                           placeholder="Consultation fee"
                           @bind="doctorForm.ConsultationFee" />
                </div>

                <div class="doctor-field">
                    <label for="doctorStatus">Status</label>
                    <select id="doctorStatus" @bind="doctorForm.IsActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

            </div>

            <div class="doctor-form-actions">
                <button class="doctor-save-btn"
                        @onclick="SaveDoctor"
                        disabled="@isLoading">
                    @(isEditMode ? "Update Doctor" : "Create Doctor")
                </button>

                <button class="doctor-cancel-btn"
                        @onclick="CloseForm"
                        disabled="@isLoading">
                    Cancel
                </button>
            </div>

        </div>
    }

    <div class="doctor-stat-grid">

        <div class="doctor-stat-card doctor-stat-blue">
            <div>
                <span>Total Doctors</span>
                <h2>@TotalDoctors</h2>
                <p>Doctor profiles in HealthAxis</p>
            </div>
            <div class="doctor-stat-icon">+</div>
        </div>

        <div class="doctor-stat-card doctor-stat-teal">
            <div>
                <span>Active Doctors</span>
                <h2>@ActiveDoctors</h2>
                <p>Visible on current page</p>
            </div>
            <div class="doctor-stat-icon">●</div>
        </div>

        <div class="doctor-stat-card doctor-stat-red">
            <div>
                <span>Inactive Doctors</span>
                <h2>@InactiveDoctors</h2>
                <p>Visible on current page</p>
            </div>
            <div class="doctor-stat-icon">○</div>
        </div>

        <div class="doctor-stat-card doctor-stat-purple">
            <div>
                <span>Specialisations</span>
                <h2>@SpecialisationCount</h2>
                <p>Visible on current page</p>
            </div>
            <div class="doctor-stat-icon">□</div>
        </div>

    </div>

    <div class="doctor-directory">

        <div class="doctor-directory-header">
            <div>
                <h3>Doctor Directory</h3>
                <p>Search, filter, and maintain doctor account visibility.</p>
            </div>

            <span class="doctor-count-pill">
                Showing @doctors.Count of @totalCount
            </span>
        </div>

        <div class="doctor-filter-row">

            <div class="doctor-search-box">
                <span>⌕</span>

                <input placeholder="Search doctor by name, email, or specialisation..."
                       value="@searchText"
                       @oninput="OnSearchChanged" />
            </div>

            <select class="doctor-filter-select"
                    value="@selectedSpecialisation"
                    @onchange="OnSpecialisationChanged">
                <option value="All">All Specialisations</option>

                @foreach (var spec in Enum.GetValues<SpecialisationType>())
                {
                    <option value="@spec.ToString()">@spec</option>
                }
            </select>

            <select class="doctor-filter-select"
                    value="@selectedStatus"
                    @onchange="OnStatusChanged">
                <option value="All">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

        </div>

        @if (showStatusLegend)
        {
            <div class="doctor-status-legend">
                <div>
                    <span class="status-icon active">✓</span>
                    <strong>Active</strong>
                    <p>Doctor profile is enabled and available.</p>
                </div>

                <div>
                    <span class="status-icon inactive">!</span>
                    <strong>Inactive</strong>
                    <p>Doctor profile is disabled and unavailable.</p>
                </div>
            </div>
        }

        @if (isLoading && doctors.Count == 0)
        {
            <p>Loading doctors...</p>
        }
        else if (!doctors.Any())
        {
            <p>No doctors found.</p>
        }
        else
        {
            <div class="doctor-table-wrapper">

                <table class="doctor-table">

                    <colgroup>
                        <col class="doctor-col-name" />
                        <col class="doctor-col-specialisation" />
                        <col class="doctor-col-experience" />
                        <col class="doctor-col-fee" />
                        <col class="doctor-col-status" />
                        <col class="doctor-col-actions" />
                    </colgroup>

                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Specialisation</th>
                            <th>Experience</th>
                            <th>Consultation Fee</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var doctor in doctors)
                        {
                            <tr>
                                <td>
                                    <div class="doctor-profile-cell">
                                        <div class="doctor-avatar">
                                            @GetInitials(doctor.DoctorName)
                                        </div>

                                        <div class="doctor-profile-text">
                                            <strong>@doctor.DoctorName</strong>
                                            <span>@doctor.Email</span>
                                            <small>Doctor ID: @doctor.DoctorId</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="doctor-specialisation-pill">
                                        @doctor.Specialisation
                                    </span>
                                </td>

                                <td>
                                    <span class="doctor-table-text">
                                        @doctor.YearsOfExperience years
                                    </span>
                                </td>

                                <td>
                                    <span class="doctor-fee-pill">
                                        ₹@doctor.ConsultationFee
                                    </span>
                                </td>

                                <td>
                                    <button class="doctor-status-icon-btn"
                                            title="Click to view status meaning"
                                            @onclick="ToggleStatusLegend">
                                        @if (doctor.IsActive)
                                        {
                                            <span class="status-icon active">✓</span>
                                        }
                                        else
                                        {
                                            <span class="status-icon inactive">!</span>
                                        }
                                    </button>
                                </td>

                                <td>
                                    <div class="doctor-action-group">
                                        <button class="doctor-edit-btn"
                                                @onclick="@(() => StartEdit(doctor))"
                                                disabled="@isLoading">
                                            Edit
                                        </button>

                                        <button class="doctor-status-btn"
                                                @onclick="@(() => ToggleStatus(doctor))"
                                                disabled="@isLoading">
                                            @(doctor.IsActive ? "Deactivate" : "Activate")
                                        </button>

                                        <button class="doctor-appointments-btn"
                                                @onclick="@(() => OpenDoctorAppointments(doctor))"
                                                disabled="@isLoading">
                                            Appointments
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

                <div class="hx-pagination">

                    <div class="hx-pagination-info">
                        Showing @GetStartItemIndex() - @GetEndItemIndex() of @totalCount
                    </div>

                    <div class="hx-pagination-actions">

                        <select class="hx-page-size-select"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            @foreach (var size in pageSizeOptions)
                            {
                                <option value="@size">@size / page</option>
                            }
                        </select>

                        <button @onclick="PreviousPage"
                                disabled="@(currentPage <= 1)">
                            Previous
                        </button>

                        <span>
                            Page @currentPage of @(totalPages == 0 ? 1 : totalPages)
                        </span>

                        <button @onclick="NextPage"
                                disabled="@(currentPage >= totalPages)">
                            Next
                        </button>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (showAppointmentsModal)
    {
        <div class="doctor-modal-backdrop">
            <div class="doctor-appointments-modal">

                <div class="doctor-modal-header">
                    <div>
                        <h3>Doctor Appointments</h3>
                        <p>Appointments for Dr. @selectedDoctorName</p>
                    </div>

                    <button class="doctor-modal-close-btn"
                            @onclick="CloseAppointmentsModal">
                        ×
                    </button>
                </div>

                @if (isAppointmentsLoading)
                {
                    <p>Loading appointments...</p>
                }
                else if (doctorAppointments.Count == 0)
                {
                    <div class="doctor-empty-appointments">
                        <h4>No appointments found</h4>
                        <p>This doctor does not have any appointments yet.</p>
                    </div>
                }
                else
                {
                    <div class="doctor-appointments-table-wrapper">
                        <table class="doctor-appointments-table">

                            <thead>
                                <tr>
                                    <th>Appointment Id</th>
                                    <th>Patient Id</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th>Cancellation</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var appointment in doctorAppointments)
                                {
                                    <tr>
                                        <td>#@appointment.AppointmentId</td>
                                        <td>Patient @appointment.PatientId</td>
                                        <td>@appointment.ScheduledDate.ToString("dd-MMM-yyyy")</td>
                                        <td>@FormatDoctorAppointmentTime(appointment.TimeSlot)</td>
                                        <td>
                                            <span class="@GetDoctorAppointmentStatusClass(appointment.Status)">
                                                @GetAppointmentStatusText(appointment.Status)
                                            </span>
                                        </td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(appointment.CancellationReason)
                                                ? "-"
                                                : appointment.CancellationReason)
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }

            </div>
        </div>
    }

</div>

<GenericModal @ref="statusModal"
              OnConfirm="ConfirmToggleStatus" />

@code {
    private List<DoctorResponseDto> doctors = new();

    private CreateDoctorDto doctorForm = new();

    private GenericModal? statusModal;

    private DoctorResponseDto? selectedDoctor;

    private string message = string.Empty;

    private string messageCssClass = "alert alert-info";

    private string searchText = string.Empty;

    private string selectedSpecialisation = "All";

    private string selectedStatus = "All";

    private bool isLoading;

    private bool showForm;

    private bool isEditMode;

    private bool showStatusLegend;

    private int editingDoctorId;

    private readonly List<string> validationErrors = new();

    private bool showAppointmentsModal;

    private bool isAppointmentsLoading;

    private string selectedDoctorName = string.Empty;

    private List<AppointmentResponseDto> doctorAppointments = new();

    private int currentPage = 1;

    private int pageSize = 10;

    private int totalCount;

    private int totalPages;

    private readonly int[] pageSizeOptions = new[] { 5, 10, 20 };

    private string temporaryPassword = string.Empty;

    private string createdDoctorEmail = string.Empty;

    private string createdDoctorName = string.Empty;

    private bool showTempPasswordBox;

    private int TotalDoctors => totalCount;

    private int ActiveDoctors => doctors.Count(d => d.IsActive);

    private int InactiveDoctors => doctors.Count(d => !d.IsActive);

    private int SpecialisationCount => doctors.Select(d => d.Specialisation).Distinct().Count();

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        isLoading = true;

        try
        {
            var result = await DoctorService.GetDoctorsPagedAsync(
                currentPage,
                pageSize,
                searchText,
                selectedSpecialisation,
                selectedStatus
            );

            doctors = result.Items;
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;
        }
        catch
        {
            SetErrorMessage("Failed to load doctors.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadDoctors();
    }

    private async Task OnSpecialisationChanged(ChangeEventArgs e)
    {
        selectedSpecialisation = e.Value?.ToString() ?? "All";
        currentPage = 1;
        await LoadDoctors();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? "All";
        currentPage = 1;
        await LoadDoctors();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var selectedSize))
        {
            pageSize = selectedSize;
            currentPage = 1;
            await LoadDoctors();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadDoctors();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadDoctors();
        }
    }

    private int GetStartItemIndex()
    {
        if (totalCount == 0)
        {
            return 0;
        }

        return ((currentPage - 1) * pageSize) + 1;
    }

    private int GetEndItemIndex()
    {
        var end = currentPage * pageSize;

        return end > totalCount ? totalCount : end;
    }

    private void OpenCreateForm()
    {
        ResetForm();
        showForm = true;
        message = string.Empty;
        validationErrors.Clear();
    }

    private void StartEdit(DoctorResponseDto doctor)
    {
        showForm = true;
        isEditMode = true;
        editingDoctorId = doctor.DoctorId;
        validationErrors.Clear();
        message = string.Empty;

        doctorForm = new CreateDoctorDto
        {
            DoctorName = doctor.DoctorName,
            Email = doctor.Email,
            Specialisation = doctor.Specialisation,
            YearsOfExperience = doctor.YearsOfExperience,
            ConsultationFee = doctor.ConsultationFee,
            IsActive = doctor.IsActive
        };
    }

    private void CloseForm()
    {
        ResetForm();
        showForm = false;
        message = string.Empty;
    }

    private void ToggleStatusLegend()
    {
        showStatusLegend = !showStatusLegend;
    }

    private async Task SaveDoctor()
    {
        if (!ValidateDoctorForm())
        {
            return;
        }

        isLoading = true;
        message = string.Empty;

        temporaryPassword = string.Empty;
        createdDoctorEmail = string.Empty;
        createdDoctorName = string.Empty;
        showTempPasswordBox = false;

        try
        {
            if (isEditMode)
            {
                await SaveEditedDoctor();
            }
            else
            {
                await SaveNewDoctor();
            }
        }
        catch
        {
            SetErrorMessage(
                isEditMode
                    ? "Error occurred while updating doctor."
                    : "Error occurred while creating doctor."
            );
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveEditedDoctor()
    {
        var success = await DoctorService.UpdateDoctorAsync(editingDoctorId, doctorForm);

        if (success)
        {
            SetSuccessMessage("Doctor updated successfully.");

            ResetForm();
            showForm = false;
            currentPage = 1;

            await LoadDoctors();
        }
        else
        {
            SetErrorMessage("Failed to update doctor.");
        }
    }

    private async Task SaveNewDoctor()
    {
        var createdDoctor = await DoctorService.CreateDoctorAsync(doctorForm);

        if (createdDoctor == null)
        {
            SetErrorMessage("Failed to create doctor.");
            return;
        }

        temporaryPassword = createdDoctor.DisplayTemporaryPassword ?? string.Empty;
        createdDoctorEmail = createdDoctor.Email ?? doctorForm.Email;
        createdDoctorName = createdDoctor.DoctorName ?? doctorForm.DoctorName;

        showTempPasswordBox = !string.IsNullOrWhiteSpace(temporaryPassword);

        if (showTempPasswordBox)
        {
            SetSuccessMessage("Doctor created successfully. Share the temporary password with the doctor.");
        }
        else
        {
            SetSuccessMessage("Doctor created successfully, but temporary password was not returned by backend.");
        }

        ResetForm();
        showForm = false;
        currentPage = 1;

        await LoadDoctors();
    }

    private void CloseTempPasswordBox()
    {
        showTempPasswordBox = false;
        temporaryPassword = string.Empty;
        createdDoctorEmail = string.Empty;
        createdDoctorName = string.Empty;
    }

    private async Task CopyTempPassword()
    {
        if (string.IsNullOrWhiteSpace(temporaryPassword))
        {
            SetErrorMessage("Temporary password is not available.");
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", temporaryPassword);

        SetSuccessMessage("Temporary password copied.");
    }

    private async Task CopyDoctorCredentials()
    {
        if (string.IsNullOrWhiteSpace(createdDoctorEmail) ||
            string.IsNullOrWhiteSpace(temporaryPassword))
        {
            SetErrorMessage("Doctor login details are not available.");
            return;
        }

        var loginDetails =
            $"HealthAxis Doctor Login\n" +
            $"Doctor: {createdDoctorName}\n" +
            $"Email: {createdDoctorEmail}\n" +
            $"Temporary Password: {temporaryPassword}\n" +
            $"Login URL: http://localhost:4200/login\n" +
            $"Please change your password after first login.";

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", loginDetails);

        SetSuccessMessage("Doctor login details copied.");
    }

    private async Task ToggleStatus(DoctorResponseDto doctor)
    {
        if (doctor.IsActive)
        {
            selectedDoctor = doctor;

            statusModal?.Show(
                "Deactivate Doctor",
                $"Are you sure you want to deactivate Dr. {doctor.DoctorName}?",
                "Deactivate",
                "btn btn-warning");

            return;
        }

        await UpdateDoctorStatus(doctor);
    }

    private async Task ConfirmToggleStatus()
    {
        if (selectedDoctor != null)
        {
            await UpdateDoctorStatus(selectedDoctor);
            selectedDoctor = null;
        }
    }

    private async Task UpdateDoctorStatus(DoctorResponseDto doctor)
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            var success = await DoctorService.SetDoctorStatusAsync(
                doctor.DoctorId,
                !doctor.IsActive);

            if (success)
            {
                SetSuccessMessage(
                    doctor.IsActive
                        ? "Doctor deactivated successfully."
                        : "Doctor activated successfully.");

                await LoadDoctors();
            }
            else
            {
                SetErrorMessage("Failed to update doctor status.");
            }
        }
        catch
        {
            SetErrorMessage("Error updating doctor status.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenDoctorAppointments(DoctorResponseDto doctor)
    {
        showAppointmentsModal = true;
        isAppointmentsLoading = true;
        selectedDoctorName = doctor.DoctorName ?? string.Empty;
        doctorAppointments = new();

        try
        {
            doctorAppointments = await AppointmentService.GetAppointmentsByDoctorAsync(doctor.DoctorId);
        }
        catch
        {
            SetErrorMessage("Failed to load doctor appointments.");
        }
        finally
        {
            isAppointmentsLoading = false;
        }
    }

    private void CloseAppointmentsModal()
    {
        showAppointmentsModal = false;
        selectedDoctorName = string.Empty;
        doctorAppointments = new();
    }

    private bool ValidateDoctorForm()
    {
        validationErrors.Clear();

        ValidateDoctorName();
        ValidateDoctorEmail();
        ValidateDoctorExperience();
        ValidateDoctorFee();

        if (validationErrors.Count == 0)
        {
            return true;
        }

        SetErrorMessage("Please fix the validation errors.");
        return false;
    }

    private void ValidateDoctorName()
    {
        if (string.IsNullOrWhiteSpace(doctorForm.DoctorName))
        {
            validationErrors.Add("Doctor name is required.");
            return;
        }

        if (doctorForm.DoctorName.Trim().Length < 3)
        {
            validationErrors.Add("Doctor name must be at least 3 characters.");
        }
    }

    private void ValidateDoctorEmail()
    {
        if (string.IsNullOrWhiteSpace(doctorForm.Email))
        {
            validationErrors.Add("Email is required.");
            return;
        }

        if (!IsValidEmail(doctorForm.Email))
        {
            validationErrors.Add("Enter a valid email address.");
        }
    }

    private void ValidateDoctorExperience()
    {
        if (doctorForm.YearsOfExperience < 0)
        {
            validationErrors.Add("Experience cannot be negative.");
        }

        if (doctorForm.YearsOfExperience > 60)
        {
            validationErrors.Add("Experience cannot be greater than 60 years.");
        }
    }

    private void ValidateDoctorFee()
    {
        if (doctorForm.ConsultationFee <= 0)
        {
            validationErrors.Add("Consultation fee must be greater than 0.");
        }

        if (doctorForm.ConsultationFee > 100000)
        {
            validationErrors.Add("Consultation fee is too high.");
        }
    }

    private static bool IsValidEmail(string email)
    {
        try
        {
            var address = new System.Net.Mail.MailAddress(email);
            return address.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private void ResetForm()
    {
        doctorForm = new CreateDoctorDto
        {
            IsActive = true
        };

        isEditMode = false;
        editingDoctorId = 0;
        validationErrors.Clear();
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "DR";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpper()
                : parts[0].ToUpper();
        }

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private static string FormatDoctorAppointmentTime(object? timeSlot)
    {
        if (timeSlot == null)
        {
            return "-";
        }

        if (timeSlot is TimeOnly timeOnly)
        {
            return timeOnly.ToString("hh:mm tt");
        }

        if (timeSlot is TimeSpan timeSpan)
        {
            return DateTime.Today.Add(timeSpan).ToString("hh:mm tt");
        }

        if (timeSlot is DateTime dateTime)
        {
            return dateTime.ToString("hh:mm tt");
        }

        var value = timeSlot.ToString();

        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }

    private static string GetAppointmentStatusText(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending => "Pending",
            AppointmentStatus.Confirmed => "Confirmed",
            AppointmentStatus.Cancelled => "Cancelled",
            AppointmentStatus.Completed => "Completed",
            _ => "Unknown"
        };
    }

    private static string GetDoctorAppointmentStatusClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending => "doctor-appt-status pending",
            AppointmentStatus.Confirmed => "doctor-appt-status confirmed",
            AppointmentStatus.Cancelled => "doctor-appt-status cancelled",
            AppointmentStatus.Completed => "doctor-appt-status completed",
            _ => "doctor-appt-status pending"
        };
    }

    private void SetSuccessMessage(string text)
    {
        message = text;
        messageCssClass = "alert alert-info";
    }

    private void SetErrorMessage(string text)
    {
        message = text;
        messageCssClass = "alert alert-danger";
    }
}