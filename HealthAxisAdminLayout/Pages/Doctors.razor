@page "/admin/doctors"
@layout HealthAxisAdminLayout.Layout.AdminLayout 

@using HealthAxisAdminLayout.DTOs.Doctor
@using HealthAxisAdminLayout.Services.Interfaces

@inject IDoctorApiService DoctorService
@inject IAuthService AuthService

@inject NavigationManager Navigation

<h3 class="page-title">Manage Doctors</h3>
<p class="page-subtitle">Create, view, activate, deactivate, and delete doctors</p>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">
        @message
    </div>
}

<div class="form-card">
    <h5>Add Doctor</h5>

    <div class="form-grid">
        <div>
            <label>Doctor Name</label>
            <input class="form-control" @bind="newDoctor.DoctorName" />
        </div>

        <div>
            <label>Email</label>
            <input class="form-control" @bind="newDoctor.Email" />
        </div>

        <div>
            <label>Specialisation</label>
            <input type="number" class="form-control" @bind="newDoctor.Specialisation" />
        </div>

        <div>
            <label>Experience</label>
            <input type="number" class="form-control" @bind="newDoctor.YearsOfExperience" />
        </div>

        <div>
            <label>Consultation Fee</label>
            <input type="number" class="form-control" @bind="newDoctor.ConsultationFee" />
        </div>

        <div>
            <label>Status</label>
            <select class="form-control" @bind="newDoctor.IsActive">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
    </div>

    <button class="btn btn-primary mt-3" @onclick="CreateDoctorAsync">
        Create Doctor
    </button>
</div>

<div class="table-card mt-4">
    <h5>Doctors List</h5>

    @if (doctors.Count == 0)
    {
        <p>No doctors found.</p>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Specialisation</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var doctor in doctors)
                {
                    <tr>
                        <td>@doctor.DoctorId</td>
                        <td>@doctor.DoctorName</td>
                        <td>@doctor.Email</td>
                        <td>@doctor.Specialisation</td>
                        <td>@doctor.YearsOfExperience</td>
                        <td>@doctor.ConsultationFee</td>
                        <td>
                            @if (doctor.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2"
                                    @onclick="() => ToggleStatusAsync(doctor)">
                                @(doctor.IsActive ? "Deactivate" : "Activate")
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => DeleteDoctorAsync(doctor.DoctorId)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<DoctorResponseDTO> doctors = new();

    private CreateDoctorDTO newDoctor = new();

    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var isAdmin = await AuthService.IsAdminAsync();

        if (!isAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadDoctorsAsync();
    }

    private async Task LoadDoctorsAsync()
    {
        doctors = await DoctorService.GetDoctorsAsync();
    }

    private async Task CreateDoctorAsync()
    {
        message = string.Empty;

        var success = await DoctorService.CreateDoctorAsync(newDoctor);

        if (success)
        {
            message = "Doctor created successfully.";
            newDoctor = new CreateDoctorDTO();
            await LoadDoctorsAsync();
        }
        else
        {
            message = "Failed to create doctor.";
        }
    }

    private async Task ToggleStatusAsync(DoctorResponseDTO doctor)
    {
        var newStatus = !doctor.IsActive;

        var success = await DoctorService.SetDoctorStatusAsync(doctor.DoctorId, newStatus);

        if (success)
        {
            message = "Doctor status updated successfully.";
            await LoadDoctorsAsync();
        }
        else
        {
            message = "Failed to update doctor status.";
        }
    }

    private async Task DeleteDoctorAsync(int doctorId)
    {
        var success = await DoctorService.DeleteDoctorAsync(doctorId);

        if (success)
        {
            message = "Doctor deleted successfully.";
            await LoadDoctorsAsync();
        }
        else
        {
            message = "Failed to delete doctor.";
        }
    }
}

@using HealthAxisAdminLayout.DTOs.Doctor
@using HealthAxisAdminLayout.Services.Interfaces

@inject IDoctorApiService DoctorService
