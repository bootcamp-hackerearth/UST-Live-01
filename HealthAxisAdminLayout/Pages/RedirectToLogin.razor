@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Components
@using HealthAxisAdminLayout.Pages
@inject NavigationManager Navigation

@code {
    private string AngularLoginUrl =>
    Configuration["NavigationSettings:AngularLoginUrl"]
    ?? "/angular/login";

    protected override void OnInitialized()
    {
        Navigation.NavigateTo(AngularLoginUrl, true);
    }
}
