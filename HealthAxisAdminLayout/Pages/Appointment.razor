@page "/admin/appointments"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using HealthAxisAdminLayout.Services.Interfaces
@using HealthAxis.Shared.DTOs.Appointment
@using HealthAxis.Shared.Enums
@using System.Globalization

@layout HealthAxisAdminLayout.Layout.AdminLayout

@inject IAppointmentApiService AppointmentService
@inject IJSRuntime JS

<style>
    /*
     * Appointment table alignment
     */

    .appointment-table-wrapper {
        width: 100%;
        overflow-x: auto;
        padding-bottom: 8px;
        scrollbar-gutter: stable;
    }

    .appointment-table {
        width: 100%;
        min-width: 1420px;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0 14px;
    }

    .appointment-table th,
    .appointment-table td {
        box-sizing: border-box;
        vertical-align: middle;
    }

    .appointment-col-info {
        width: 210px;
    }

    .appointment-col-patient {
        width: 155px;
    }

    .appointment-col-doctor {
        width: 155px;
    }

    .appointment-col-date {
        width: 165px;
    }

    .appointment-col-status {
        width: 110px;
    }

    .appointment-col-reason {
        width: 210px;
    }

    .appointment-col-actions {
        width: 330px;
    }

    .appointment-actions-heading {
        width: 330px;
        min-width: 330px;
        text-align: center;
    }

    .appointment-actions-cell {
        width: 330px;
        min-width: 330px;
        padding: 16px 20px !important;
        overflow: visible;
    }

    /*
     * Three fixed action slots keep every row aligned.
     */
    .appointment-action-group {
        display: grid;
        grid-template-columns: repeat(3, 88px);
        align-items: center;
        justify-content: end;
        gap: 10px;
        width: 100%;
        min-width: 284px;
        white-space: nowrap;
    }

    .appointment-action-slot {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 88px;
        min-width: 88px;
        min-height: 48px;
    }

    .appointment-action-placeholder {
        display: block;
        width: 88px;
        height: 48px;
        visibility: hidden;
        pointer-events: none;
    }

    .appointment-confirm-btn,
    .appointment-cancel-btn,
    .appointment-delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 88px;
        min-width: 88px;
        height: 48px;
        margin: 0;
        padding: 0 12px;
        border: none;
        border-radius: 16px;
        font: inherit;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        cursor: pointer;
        transition:
            transform 0.15s ease,
            filter 0.15s ease,
            box-shadow 0.15s ease;
    }

    .appointment-confirm-btn {
        color: #047568;
        background: #c9f7ef;
    }

    .appointment-cancel-btn {
        color: #b45c00;
        background: #fff0bd;
    }

    .appointment-delete-btn {
        color: #c51f26;
        background: #ffdede;
    }

    .appointment-confirm-btn:hover:not(:disabled),
    .appointment-cancel-btn:hover:not(:disabled),
    .appointment-delete-btn:hover:not(:disabled) {
        filter: brightness(0.97);
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(15, 63, 57, 0.1);
    }

    .appointment-confirm-btn:focus-visible,
    .appointment-cancel-btn:focus-visible,
    .appointment-delete-btn:focus-visible {
        outline: 3px solid rgba(15, 118, 110, 0.25);
        outline-offset: 2px;
    }

    .appointment-confirm-btn:disabled,
    .appointment-cancel-btn:disabled,
    .appointment-delete-btn:disabled {
        cursor: not-allowed;
        opacity: 0.55;
        transform: none;
        box-shadow: none;
    }

    /*
     * Keep status buttons centered.
     */
    .appointment-status-cell {
        text-align: center;
    }

    /*
     * Cancellation reasons can wrap without changing
     * the width of the Actions column.
     */
    .appointment-reason-cell {
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    /*
     * Responsive adjustment. The table scrolls horizontally
     * rather than forcing buttons outside the row.
     */
    @@media (max-width: 1200px) {
        .appointment-table {
            min-width: 1340px;
        }

        .appointment-col-actions,
        .appointment-actions-heading,
        .appointment-actions-cell {
            width: 310px;
            min-width: 310px;
        }

        .appointment-action-group {
            grid-template-columns: repeat(3, 82px);
            min-width: 266px;
            gap: 8px;
        }

        .appointment-action-slot,
        .appointment-action-placeholder,
        .appointment-confirm-btn,
        .appointment-cancel-btn,
        .appointment-delete-btn {
            width: 82px;
            min-width: 82px;
        }
    }
</style>

<div class="appointment-page">

    <div class="appointment-hero">
        <div>
            <div class="dashboard-kicker">
                Appointment Management
            </div>

            <h1>Appointments</h1>

            <p>
                View, confirm, cancel, and manage HealthAxis
                appointment schedules.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageCssClass">
            @message
        </div>
    }

    <div class="appointment-stat-grid">

        <div class="appointment-stat-card appointment-stat-blue">
            <div>
                <span>Total Appointments</span>
                <h2>@TotalAppointments</h2>
                <p>All matching appointment records</p>
            </div>

            <div class="appointment-stat-icon">
                ◷
            </div>
        </div>

        <div class="appointment-stat-card appointment-stat-teal">
            <div>
                <span>Pending</span>
                <h2>@PendingAppointments</h2>
                <p>Visible on current page</p>
            </div>

            <div class="appointment-stat-icon">
                !
            </div>
        </div>

        <div class="appointment-stat-card appointment-stat-green">
            <div>
                <span>Confirmed</span>
                <h2>@ConfirmedAppointments</h2>
                <p>Visible on current page</p>
            </div>

            <div class="appointment-stat-icon">
                ✓
            </div>
        </div>

        <div class="appointment-stat-card appointment-stat-red">
            <div>
                <span>Cancelled</span>
                <h2>@CancelledAppointments</h2>
                <p>Visible on current page</p>
            </div>

            <div class="appointment-stat-icon">
                ×
            </div>
        </div>

    </div>

    <div class="appointment-directory">

        <div class="appointment-directory-header">
            <div>
                <h3>Appointment Directory</h3>

                <p>
                    Search, filter, confirm, cancel, and manage appointments.
                </p>
            </div>

            <span class="appointment-count-pill">
                Showing @appointments.Count of @totalCount
            </span>
        </div>

        <div class="appointment-filter-row">

            <div class="appointment-search-box">
                <span class="appointment-search-icon">
                    ⌕
                </span>

                <input placeholder="Search by appointment id, patient id, doctor id, or time slot..."
                       value="@searchText"
                       @oninput="OnSearchChanged" />
            </div>

            <div class="appointment-filter-control">
                <label>Status</label>

                <select class="appointment-filter-select"
                        value="@selectedStatus"
                        @onchange="OnStatusChanged">

                    <option value="All">
                        All Status
                    </option>

                    @foreach (var status in Enum.GetValues<AppointmentStatus>())
                    {
                        <option value="@status.ToString()">
                            @GetStatusText(status)
                        </option>
                    }
                </select>
            </div>

            <div class="appointment-filter-control">
                <label>Start Date</label>

                <input class="appointment-date-filter"
                       type="date"
                       value="@FormatDateInput(startDateFilter)"
                       @onchange="OnStartDateChanged" />
            </div>

            <div class="appointment-filter-control">
                <label>End Date</label>

                <input class="appointment-date-filter"
                       type="date"
                       value="@FormatDateInput(endDateFilter)"
                       @onchange="OnEndDateChanged" />
            </div>

        </div>

        @if (showStatusLegend)
        {
            <div class="appointment-status-legend">

                <div>
                    <span class="appointment-status-icon pending">
                        !
                    </span>

                    <strong>Pending</strong>
                    <p>Waiting for confirmation.</p>
                </div>

                <div>
                    <span class="appointment-status-icon confirmed">
                        ✓
                    </span>

                    <strong>Confirmed</strong>
                    <p>Confirmed appointment.</p>
                </div>

                <div>
                    <span class="appointment-status-icon cancelled">
                        ×
                    </span>

                    <strong>Cancelled</strong>
                    <p>Cancelled appointment.</p>
                </div>

                <div>
                    <span class="appointment-status-icon completed">
                        ✓
                    </span>

                    <strong>Completed</strong>
                    <p>Completed appointment.</p>
                </div>

            </div>
        }

        @if (isLoading && appointments.Count == 0)
        {
            <p>Loading appointments...</p>
        }
        else if (!appointments.Any())
        {
            <p>No appointments found.</p>
        }
        else
        {
            <div class="appointment-table-wrapper">

                <table class="appointment-table">

                    <colgroup>
                        <col class="appointment-col-info" />
                        <col class="appointment-col-patient" />
                        <col class="appointment-col-doctor" />
                        <col class="appointment-col-date" />
                        <col class="appointment-col-status" />
                        <col class="appointment-col-reason" />
                        <col class="appointment-col-actions" />
                    </colgroup>

                    <thead>
                        <tr>
                            <th>Appointment</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Date &amp; Time</th>
                            <th class="appointment-status-cell">
                                Status
                            </th>
                            <th>Cancellation</th>
                            <th class="appointment-actions-heading">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in appointments)
                        {
                            <tr>
                                <td>
                                    <div class="appointment-profile-cell">

                                        <div class="appointment-avatar">
                                            #@appointment.AppointmentId
                                        </div>

                                        <div class="appointment-profile-text">
                                            <strong>
                                                Appointment @appointment.AppointmentId
                                            </strong>

                                            <span>
                                                @FormatTimeSlot(appointment.TimeSlot)
                                            </span>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="appointment-id-pill">
                                        Patient @appointment.PatientId
                                    </span>
                                </td>

                                <td>
                                    <span class="appointment-id-pill">
                                        Doctor @appointment.DoctorId
                                    </span>
                                </td>

                                <td>
                                    <div class="appointment-date-cell">
                                        <strong>
                                            @appointment.ScheduledDate.ToString("dd-MMM-yyyy")
                                        </strong>

                                        <span>
                                            @FormatTimeSlot(appointment.TimeSlot)
                                        </span>
                                    </div>
                                </td>

                                <td class="appointment-status-cell">
                                    <button type="button"
                                            class="appointment-status-icon-btn"
                                            title="Click to view status meaning"
                                            aria-label="@($"View meaning of {GetStatusText(appointment.Status)} status")"
                                            @onclick="ToggleStatusLegend">

                                        <span class="@GetStatusIconClass(appointment.Status)">
                                            @GetStatusIcon(appointment.Status)
                                        </span>
                                    </button>
                                </td>

                                <td class="appointment-reason-cell">
                                    <span class="appointment-reason-text">
                                        @(string.IsNullOrWhiteSpace(
                                            appointment.CancellationReason)
                                            ? "-"
                                            : appointment.CancellationReason)
                                    </span>
                                </td>

                                <td class="appointment-actions-cell">

                                    <div class="appointment-action-group">

                                        <div class="appointment-action-slot">
                                            @if (CanConfirm(appointment))
                                            {
                                                <button type="button"
                                                        class="appointment-confirm-btn"
                                                        @onclick="@(() => ConfirmAppointment(appointment.AppointmentId))"
                                                        disabled="@isLoading">
                                                    Confirm
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="appointment-action-placeholder"
                                                      aria-hidden="true">
                                                </span>
                                            }
                                        </div>

                                        <div class="appointment-action-slot">
                                            @if (CanCancel(appointment))
                                            {
                                                <button type="button"
                                                        class="appointment-cancel-btn"
                                                        @onclick="@(() => CancelAppointment(appointment.AppointmentId))"
                                                        disabled="@isLoading">
                                                    Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="appointment-action-placeholder"
                                                      aria-hidden="true">
                                                </span>
                                            }
                                        </div>

                                        <div class="appointment-action-slot">
                                            <button type="button"
                                                    class="appointment-delete-btn"
                                                    @onclick="@(() => DeleteAppointment(appointment.AppointmentId))"
                                                    disabled="@isLoading">
                                                Delete
                                            </button>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

                <div class="hx-pagination">

                    <div class="hx-pagination-info">
                        Showing @GetStartItemIndex() - @GetEndItemIndex()
                        of @totalCount
                    </div>

                    <div class="hx-pagination-actions">

                        <select class="hx-page-size-select"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">

                            @foreach (var size in pageSizeOptions)
                            {
                                <option value="@size">
                                    @size / page
                                </option>
                            }

                        </select>

                        <button type="button"
                                @onclick="PreviousPage"
                                disabled="@(isLoading || currentPage <= 1)">
                            Previous
                        </button>

                        <span>
                            Page @currentPage of @DisplayTotalPages
                        </span>

                        <button type="button"
                                @onclick="NextPage"
                                disabled="@(isLoading || totalPages == 0 || currentPage >= totalPages)">
                            Next
                        </button>

                    </div>
                </div>

            </div>
        }

    </div>

</div>

@code {
    private List<AppointmentResponseDto> appointments = new();

    private string message = string.Empty;

    private string messageCssClass = "alert alert-info";

    private string searchText = string.Empty;

    private string selectedStatus = "All";

    private DateTime? startDateFilter;

    private DateTime? endDateFilter;

    private bool isLoading;

    private bool showStatusLegend;

    private int currentPage = 1;

    private int pageSize = 10;

    private int totalCount;

    private int totalPages;

    private readonly int[] pageSizeOptions =
        new[] { 5, 10, 20 };

    private int TotalAppointments =>
        totalCount;

    private int PendingAppointments =>
        appointments.Count(
            appointment =>
                appointment.Status == AppointmentStatus.Pending);

    private int ConfirmedAppointments =>
        appointments.Count(
            appointment =>
                appointment.Status == AppointmentStatus.Confirmed);

    private int CancelledAppointments =>
        appointments.Count(
            appointment =>
                appointment.Status == AppointmentStatus.Cancelled);

    private int DisplayTotalPages =>
        totalPages <= 0
            ? 1
            : totalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            var result =
                await AppointmentService.GetAppointmentsPagedAsync(
                    currentPage,
                    pageSize,
                    searchText,
                    GetSelectedStatusValue(),
                    startDateFilter,
                    endDateFilter);

            appointments =
                result.Items ??
                new List<AppointmentResponseDto>();

            totalCount =
                result.TotalCount;

            totalPages =
                result.TotalPages;

            if (totalPages > 0 && currentPage > totalPages)
            {
                currentPage = totalPages;

                result =
                    await AppointmentService.GetAppointmentsPagedAsync(
                        currentPage,
                        pageSize,
                        searchText,
                        GetSelectedStatusValue(),
                        startDateFilter,
                        endDateFilter);

                appointments =
                    result.Items ??
                    new List<AppointmentResponseDto>();

                totalCount =
                    result.TotalCount;

                totalPages =
                    result.TotalPages;
            }
        }
        catch
        {
            appointments =
                new List<AppointmentResponseDto>();

            totalCount = 0;
            totalPages = 0;

            SetErrorMessage(
                "Failed to load appointments.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private AppointmentStatus? GetSelectedStatusValue()
    {
        if (
            string.Equals(
                selectedStatus,
                "All",
                StringComparison.OrdinalIgnoreCase)
        )
        {
            return null;
        }

        return Enum.TryParse<AppointmentStatus>(
            selectedStatus,
            ignoreCase: true,
            out var parsedStatus)
                ? parsedStatus
                : null;
    }

    private async Task OnSearchChanged(
        ChangeEventArgs eventArgs)
    {
        searchText =
            eventArgs.Value?.ToString()?.Trim() ??
            string.Empty;

        currentPage = 1;

        await LoadAppointments();
    }

    private async Task OnStatusChanged(
        ChangeEventArgs eventArgs)
    {
        selectedStatus =
            eventArgs.Value?.ToString() ??
            "All";

        currentPage = 1;

        await LoadAppointments();
    }

    private async Task OnStartDateChanged(
        ChangeEventArgs eventArgs)
    {
        startDateFilter =
            ParseDateInput(
                eventArgs.Value?.ToString());

        currentPage = 1;

        await LoadAppointments();
    }

    private async Task OnEndDateChanged(
        ChangeEventArgs eventArgs)
    {
        endDateFilter =
            ParseDateInput(
                eventArgs.Value?.ToString());

        currentPage = 1;

        await LoadAppointments();
    }

    private async Task OnPageSizeChanged(
        ChangeEventArgs eventArgs)
    {
        if (
            int.TryParse(
                eventArgs.Value?.ToString(),
                out var selectedSize) &&
            pageSizeOptions.Contains(selectedSize)
        )
        {
            pageSize = selectedSize;
            currentPage = 1;

            await LoadAppointments();
        }
    }

    private async Task PreviousPage()
    {
        if (isLoading || currentPage <= 1)
        {
            return;
        }

        currentPage--;

        await LoadAppointments();
    }

    private async Task NextPage()
    {
        if (
            isLoading ||
            totalPages == 0 ||
            currentPage >= totalPages
        )
        {
            return;
        }

        currentPage++;

        await LoadAppointments();
    }

    private int GetStartItemIndex()
    {
        if (totalCount == 0)
        {
            return 0;
        }

        return ((currentPage - 1) * pageSize) + 1;
    }

    private int GetEndItemIndex()
    {
        var endItem =
            currentPage * pageSize;

        return endItem > totalCount
            ? totalCount
            : endItem;
    }

    private static string FormatDateInput(
        DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString(
                "yyyy-MM-dd",
                CultureInfo.InvariantCulture)
            : string.Empty;
    }

    private static DateTime? ParseDateInput(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return DateTime.TryParseExact(
            value,
            "yyyy-MM-dd",
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out var parsedDate)
                ? parsedDate
                : null;
    }

    private async Task ConfirmAppointment(
        int appointmentId)
    {
        if (isLoading)
        {
            return;
        }

        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                "Are you sure you want to confirm this appointment?");

        if (!confirmed)
        {
            return;
        }

        isLoading = true;
        message = string.Empty;

        try
        {
            var success =
                await AppointmentService
                    .ConfirmAppointmentAsync(
                        appointmentId);

            if (!success)
            {
                SetErrorMessage(
                    "Failed to confirm appointment.");

                return;
            }

            await LoadAppointments();

            SetSuccessMessage(
                "Appointment confirmed successfully.");
        }
        catch
        {
            SetErrorMessage(
                "Error confirming appointment.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CancelAppointment(
        int appointmentId)
    {
        if (isLoading)
        {
            return;
        }

        var reason =
            await JS.InvokeAsync<string?>(
                "prompt",
                "Enter cancellation reason:");

        reason = reason?.Trim();

        if (string.IsNullOrWhiteSpace(reason))
        {
            return;
        }

        isLoading = true;
        message = string.Empty;

        try
        {
            var success =
                await AppointmentService
                    .CancelAppointmentAsync(
                        appointmentId,
                        reason);

            if (!success)
            {
                SetErrorMessage(
                    "Failed to cancel appointment.");

                return;
            }

            await LoadAppointments();

            SetSuccessMessage(
                "Appointment cancelled successfully.");
        }
        catch
        {
            SetErrorMessage(
                "Error cancelling appointment.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteAppointment(
        int appointmentId)
    {
        if (isLoading)
        {
            return;
        }

        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                "Are you sure you want to delete this appointment?");

        if (!confirmed)
        {
            return;
        }

        isLoading = true;
        message = string.Empty;

        try
        {
            var success =
                await AppointmentService
                    .DeleteAppointmentAsync(
                        appointmentId);

            if (!success)
            {
                SetErrorMessage(
                    "Failed to delete appointment.");

                return;
            }

            if (
                appointments.Count == 1 &&
                currentPage > 1
            )
            {
                currentPage--;
            }

            await LoadAppointments();

            SetSuccessMessage(
                "Appointment deleted successfully.");
        }
        catch
        {
            SetErrorMessage(
                "Error deleting appointment.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool CanConfirm(
        AppointmentResponseDto appointment)
    {
        return appointment.Status ==
               AppointmentStatus.Pending;
    }

    private static bool CanCancel(
        AppointmentResponseDto appointment)
    {
        return
            appointment.Status ==
                AppointmentStatus.Pending ||
            appointment.Status ==
                AppointmentStatus.Confirmed;
    }

    private void ToggleStatusLegend()
    {
        showStatusLegend =
            !showStatusLegend;
    }

    private static string FormatTimeSlot(
        object? timeSlot)
    {
        if (timeSlot is null)
        {
            return "-";
        }

        if (timeSlot is TimeOnly timeOnly)
        {
            return timeOnly.ToString(
                "hh:mm tt",
                CultureInfo.InvariantCulture);
        }

        if (timeSlot is TimeSpan timeSpan)
        {
            return DateTime.Today
                .Add(timeSpan)
                .ToString(
                    "hh:mm tt",
                    CultureInfo.InvariantCulture);
        }

        if (timeSlot is DateTime dateTime)
        {
            return dateTime.ToString(
                "hh:mm tt",
                CultureInfo.InvariantCulture);
        }

        var value =
            timeSlot.ToString();

        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }

    private static string GetStatusText(
        AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending =>
                "Pending",

            AppointmentStatus.Confirmed =>
                "Confirmed",

            AppointmentStatus.Cancelled =>
                "Cancelled",

            AppointmentStatus.Completed =>
                "Completed",

            _ =>
                "Unknown"
        };
    }

    private static string GetStatusIcon(
        AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending =>
                "!",

            AppointmentStatus.Confirmed =>
                "✓",

            AppointmentStatus.Cancelled =>
                "×",

            AppointmentStatus.Completed =>
                "✓",

            _ =>
                "?"
        };
    }

    private static string GetStatusIconClass(
        AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending =>
                "appointment-status-icon pending",

            AppointmentStatus.Confirmed =>
                "appointment-status-icon confirmed",

            AppointmentStatus.Cancelled =>
                "appointment-status-icon cancelled",

            AppointmentStatus.Completed =>
                "appointment-status-icon completed",

            _ =>
                "appointment-status-icon pending"
        };
    }

    private void SetSuccessMessage(
        string text)
    {
        message = text;
        messageCssClass =
            "alert alert-info";
    }

    private void SetErrorMessage(
        string text)
    {
        message = text;
        messageCssClass =
            "alert alert-danger";
    }
}