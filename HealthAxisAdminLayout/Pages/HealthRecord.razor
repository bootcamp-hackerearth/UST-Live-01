@page "/admin/health-records"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using HealthAxis.Shared.DTOs.HealthRecord
@using HealthAxisAdminLayout.Services.Interfaces

@layout HealthAxisAdminLayout.Layout.AdminLayout

@inject IHealthRecordApiService HealthRecordService

<h3 class="page-title">Health Records</h3>
<p class="page-subtitle">View and manage patient health records</p>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">
        @message
    </div>
}

<div class="table-card">
    @if (isLoading)
    {
        <p>Loading health records...</p>
    }
    else if (records.Count == 0)
    {
        <p>No health records found.</p>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Record Id</th>
                    <th>Patient Id</th>
                    <th>Doctor Id</th>
                    <th>Appointment Id</th>
                    <th>Visit Date</th>
                    <th>Diagnosis</th>
                    <th>Prescription</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var record in records)
                {
                    <tr>
                        <td>@record.HealthRecordId</td>
                        <td>@record.PatientId</td>
                        <td>@(record.DoctorId?.ToString() ?? "-")</td>
                        <td>@record.AppointmentId</td>
                        <td>@record.VisitDate.ToString("dd-MMM-yyyy")</td>
                        <td>@record.Diagnosis</td>
                        <td>@record.Prescription</td>
                        <td>@(record.Notes ?? "-")</td>
                        <td>
                            <button class="btn btn-sm btn-danger"
                                    @onclick="@(() => DeleteHealthRecord(record.HealthRecordId))"
                                    disabled="@isLoading">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<HealthRecordResponseDTO> records = new();
    private string message = string.Empty;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadHealthRecords();
    }

    private async Task LoadHealthRecords()
    {
        isLoading = true;
        message = string.Empty;

        try
        {
            records = await HealthRecordService.GetHealthRecordsAsync();
        }
        catch
        {
            message = "Failed to load health records.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteHealthRecord(int healthRecordId)
    {
        message = string.Empty;
        isLoading = true;

        try
        {
            var success = await HealthRecordService.DeleteHealthRecordAsync(healthRecordId);

            if (success)
            {
                message = "Health record deleted successfully.";
                await LoadHealthRecords();
            }
            else
            {
                message = "Failed to delete health record.";
            }
        }
        catch
        {
            message = "Error occurred while deleting record.";
        }
        finally
        {
            isLoading = false;
        }
    }
}