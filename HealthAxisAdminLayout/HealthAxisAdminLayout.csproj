<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<StaticWebAssetBasePath>blazor</StaticWebAssetBasePath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference
		  Include="Microsoft.AspNetCore.Components.Authorization"
		  Version="10.0.9" />

		<PackageReference
		  Include="Microsoft.AspNetCore.Components.WebAssembly"
		  Version="10.0.9" />

		<PackageReference
		  Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
		  Version="10.0.9"
		  PrivateAssets="all" />

		<PackageReference
		  Include="Microsoft.Extensions.Http"
		  Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference
		  Include="..\HealthAxis_Shared\HealthAxis.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="DTOs\Doctor\" />
	</ItemGroup>

</Project>