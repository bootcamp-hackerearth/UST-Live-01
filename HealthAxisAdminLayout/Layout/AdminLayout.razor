@inherits LayoutComponentBase

@using HealthAxisAdminLayout.Services.Interfaces

@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="hx-admin-layout">

    <aside class="hx-sidebar">

        <div class="hx-sidebar-brand">
            <div class="hx-brand-logo">HC</div>

            <div>
                <h3>HealthAxis</h3>
                <p>Admin Portal</p>
            </div>
        </div>

        <nav class="hx-sidebar-nav">

            <NavLink class="hx-nav-link" href="/admin/dashboard" Match="NavLinkMatch.All">
                <span class="hx-nav-icon">▣</span>
                <span>Dashboard</span>
            </NavLink>

            <NavLink class="hx-nav-link" href="/admin/doctors">
                <span class="hx-nav-icon">+</span>
                <span>Doctors</span>
            </NavLink>

            <NavLink class="hx-nav-link" href="/admin/patients">
                <span class="hx-nav-icon">●</span>
                <span>Patients</span>
            </NavLink>

            <NavLink class="hx-nav-link" href="/admin/appointments">
                <span class="hx-nav-icon">◷</span>
                <span>Appointments</span>
            </NavLink>

            

        </nav>

    </aside>

    <main class="hx-main">

        <header class="hx-topbar">

            <div>
                <h4>HealthAxis Management</h4>
                <p>Admin Dashboard</p>
            </div>

            <div class="hx-topbar-actions">

                <div class="hx-user-pill">
                    <div class="hx-user-avatar">A</div>

                    <div>
                        <strong>@adminEmail</strong>
                        <span>Administrator</span>
                    </div>
                </div>

                <button class="hx-logout-btn" @onclick="Logout">
                    Logout
                </button>

            </div>

        </header>

        <section class="hx-page-content">
            @Body
        </section>

    </main>

</div>

@code {
    private string adminEmail = "Admin";

    protected override async Task OnInitializedAsync()
    {
        adminEmail = await AuthService.GetEmailAsync() ?? "Admin";
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}