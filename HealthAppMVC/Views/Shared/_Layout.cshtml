<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - HealthCare Application</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Your CSS -->
    @Styles.Render("~/Content/css")

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- jQuery UI CSS -->
    <link rel="stylesheet"
          href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm">
        <div class="container">

            @Html.ActionLink(
                "HealthCare Application",
                "Index",
                "Home",
                null,
                new { @class = "navbar-brand fw-bold" })

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="mainNavbar" class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        @Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Patients", "Index", "Patient", null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Doctors", "Index", "Doctor", null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Appointments", "Index", "Appointment", null, new { @class = "nav-link" })
                    </li>
                </ul>
            </div>

        </div>
    </nav>

    <!-- Toast Container -->
    <div class="toast-container-custom">
        <div id="toastSuccess" class="toast-message-custom toast-success"></div>
        <div id="toastError" class="toast-message-custom toast-error"></div>
        <div id="toastInfo" class="toast-message-custom toast-info"></div>
        <div id="toastWarning" class="toast-message-custom toast-warning"></div>
    </div>

    <!-- Page Content -->
    <div class="container py-4">
        @RenderBody()

        <hr />

        <footer class="text-center text-muted">
            <p>&copy; @DateTime.Now.Year - HealthCare Application</p>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function showToast(type, message) {
            var toastId = "";

            if (type === "success") {
                toastId = "#toastSuccess";
            }
            else if (type === "error") {
                toastId = "#toastError";
            }
            else if (type === "info") {
                toastId = "#toastInfo";
            }
            else if (type === "warning") {
                toastId = "#toastWarning";
            }

            var toast = $(toastId);

            toast.stop(true, true);
            toast.text(message);
            toast.fadeIn(250);

            setTimeout(function () {
                toast.fadeOut(400);
            }, 3000);
        }
    </script>

    @if (TempData["Success"] != null)
    {
        <script>
            $(function () {
                showToast("success", @Html.Raw(Json.Encode(TempData["Success"])));
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            $(function () {
                showToast("error", @Html.Raw(Json.Encode(TempData["Error"])));
            });
        </script>
    }

    @if (TempData["Info"] != null)
    {
        <script>
            $(function () {
                showToast("info", @Html.Raw(Json.Encode(TempData["Info"])));
            });
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        <script>
            $(function () {
                showToast("warning", @Html.Raw(Json.Encode(TempData["Warning"])));
            });
        </script>
    }

    @RenderSection("scripts", required: false)

</body>
</html>