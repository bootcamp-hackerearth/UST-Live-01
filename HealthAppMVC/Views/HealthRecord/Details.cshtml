@model HealthAppWebAPI.Models.Dtos.HealthRecordDto

@{
    ViewBag.Title = "Health Record Details";
}

<div class="page-wrapper">

    <div class="page-header-box">
        <div class="row align-items-center">

            <div class="col-md-8">
                <h2 class="page-title">Health Record Details</h2>

                <p class="page-subtitle">
                    View diagnosis, prescription, notes, patient, and doctor information.
                </p>
            </div>

            <div class="col-md-4 text-end">
                @Html.ActionLink(
                    "Back to Patient",
                    "Details",
                    "Patient",
                    new { id = Model.PatientId },
                    new { @class = "btn btn-secondary btn-rounded" })
            </div>

        </div>
    </div>

    <div class="table-card">

        <h4 class="mb-3">
            <i class="bi bi-journal-medical"></i>
            Health Record #@Model.HealthRecordId
        </h4>

        <hr />

        <div class="row">

            <div class="col-md-6">

                <p>
                    <strong>Patient:</strong>
                    @Model.PatientName
                </p>

                <p>
                    <strong>Doctor:</strong>
                    @Model.DoctorName
                </p>

                <p>
                    <strong>Visit Date:</strong>
                    @Model.VisitDate.ToString("dd-MM-yyyy")
                </p>

            </div>

            <div class="col-md-6">

                <p>
                    <strong>Appointment Id:</strong>
                    @Model.AppointmentId
                </p>

                <p>
                    <strong>Patient Id:</strong>
                    @Model.PatientId
                </p>

            </div>

        </div>

        <hr />

        <div class="mb-3">
            <h5>Diagnosis</h5>
            <p>@Model.Diagnosis</p>
        </div>

        <div class="mb-3">
            <h5>Prescription</h5>
            <p>@Model.Prescription</p>
        </div>

        <div class="mb-3">
            <h5>Notes</h5>
            <p>@Model.Notes</p>
        </div>

    </div>

</div>