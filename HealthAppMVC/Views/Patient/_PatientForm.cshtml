@model HealthAppWebAPI.Models.Dtos.CreatePatientDto
@using HealthAppMVC.Models

@{
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var minimumDob = DateTime.Today.AddYears(-110).ToString("yyyy-MM-dd");
}

<style>
    .is-invalid {
        border: 1px solid #dc3545 !important;
    }

    .custom-error {
        display: block;
        color: #dc3545;
        font-size: 14px;
        margin-top: 5px;
    }
</style>

<div class="row">

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="FullName" class="form-label">
                Full Name
            </label>

            @Html.TextBoxFor(
                m => m.FullName,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter patient full name",
                    minlength = "3",
                    maxlength = "100"
                })

            <span id="FullNameError"
                  class="custom-error">
            </span>

        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="DateOfBirth" class="form-label">
                Date of Birth
            </label>

            @Html.TextBox(
                "DateOfBirth",
                Model != null && Model.DateOfBirth != default(DateTime)
                    ? Model.DateOfBirth.ToString("yyyy-MM-dd")
                    : "",
                new
                {
                    @class = "form-control",
                    type = "date",
                    min = minimumDob,
                    max = today
                })

            <span id="DateOfBirthError"
                  class="custom-error">
            </span>

        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="Gender" class="form-label">
                Gender
            </label>

            @Html.DropDownListFor(
                m => m.Gender,
                new SelectList(
                    Enum.GetNames(typeof(GenderType)),
                    Model != null ? Model.Gender : null
                ),
                "Select Gender",
                new
                {
                    @class = "form-control"
                })

            <span id="GenderError"
                  class="custom-error">
            </span>

        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="Email" class="form-label">
                Email
            </label>

            @Html.TextBoxFor(
                m => m.Email,
                new
                {
                    @class = "form-control",
                    type = "text",
                    placeholder = "Enter email address",
                    maxlength = "150"
                })

            <span id="EmailError"
                  class="custom-error">
            </span>

        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="InsuranceId" class="form-label">
                Insurance ID
            </label>

            @Html.TextBoxFor(
                m => m.InsuranceId,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter insurance ID",
                    maxlength = "50"
                })

            <span id="InsuranceIdError"
                  class="custom-error">
            </span>

        </div>
    </div>

</div>