@model HealthAppWebAPI.Models.Dtos.CreatePatientDto

@using (Html.BeginForm(
    "Edit",
    "Patient",
    new { id = ViewBag.PatientId },
    FormMethod.Post,
    new { onsubmit = "return submitPatientForm(this);" }))
{
    @Html.AntiForgeryToken()

    <div class="modal-header patient-modal-header">
        <h5 class="modal-title" id="patientModalLabel">
            <i class="bi bi-pencil-square"></i>
            Edit Patient
        </h5>

        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal"
                aria-label="Close">
        </button>
    </div>

    <div class="modal-body">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.Partial("_PatientForm", Model)

    </div>

    <div class="modal-footer">
        <button type="submit"
                class="btn btn-success btn-rounded">
            <i class="bi bi-check-circle"></i>
            Update
        </button>

        <button type="button"
                class="btn btn-secondary btn-rounded"
                data-bs-dismiss="modal">
            Close
        </button>
    </div>
}