@model IEnumerable<HealthAppWebAPI.Models.Dtos.PatientDto>

@{
    ViewBag.Title = "Patients";
}

<div class="page-wrapper">

    <div class="page-header-box">
        <div class="row align-items-center">

            <div class="col-md-8">
                <h2 class="page-title">Patients</h2>

                <p class="page-subtitle">
                    View registered patients, open patient details, and update patient information.
                </p>
            </div>

            <div class="col-md-4 text-end">
                <button type="button"
                        class="btn btn-primary btn-rounded"
                        onclick="openPatientCreateModal()">
                    <i class="bi bi-plus-circle"></i>
                    Register Patient
                </button>
            </div>

        </div>
    </div>

    <div class="filter-card">

        @using (Html.BeginForm("Index", "Patient", FormMethod.Get))
        {
            <div class="row g-2 align-items-center">

                <div class="col-md-5">
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search patient by name" />
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-secondary btn-rounded">
                        <i class="bi bi-search"></i>
                        Search
                    </button>
                </div>

                <div class="col-md-2">
                    <a href="@Url.Action("Index", "Patient")"
                       class="btn btn-outline-secondary btn-rounded">
                        <i class="bi bi-arrow-clockwise"></i>
                        Clear
                    </a>
                </div>

            </div>
        }

    </div>

    <div class="table-card">

        <table class="table table-bordered table-striped custom-table">

            <thead>
                <tr>
                    <th>Patient Id</th>
                    <th>Name</th>
                    <th>DOB</th>
                    <th>Gender</th>
                    <th>Email</th>
                    <th>Insurance</th>
                    <th style="width: 140px;">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No patients found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.PatientId
                            </td>

                            <td>
                                <strong>@item.FullName</strong>
                            </td>

                            <td>
                                @item.DateOfBirth.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @item.Gender
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>
                                @item.InsuranceId
                            </td>

                            <td>

                                <a href="@Url.Action("Details", "Patient", new { id = item.PatientId })"
                                   class="btn btn-info btn-sm action-btn"
                                   title="View Patient"
                                   aria-label="View Patient">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-warning btn-sm action-btn"
                                        title="Edit Patient"
                                        aria-label="Edit Patient"
                                        onclick="openPatientEditModal(@item.PatientId)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>

<div class="modal fade"
     id="patientModal"
     tabindex="-1"
     aria-labelledby="patientModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content"
             id="patientModalContent">
        </div>

    </div>

</div>

@section scripts {

    <script>

        function openPatientCreateModal() {

            $.get('@Url.Action("Create", "Patient")', function (data) {

                $('#patientModalContent').html(data);

                $.validator.unobtrusive.parse('#patientModalContent');

                var modalElement = document.getElementById('patientModal');
                var modal = new bootstrap.Modal(modalElement);

                modal.show();
            });
        }

        function openPatientEditModal(id) {

            $.get('@Url.Action("Edit", "Patient")', { id: id }, function (data) {

                $('#patientModalContent').html(data);

                $.validator.unobtrusive.parse('#patientModalContent');

                var modalElement = document.getElementById('patientModal');
                var modal = new bootstrap.Modal(modalElement);

                modal.show();
            });
        }

        function submitPatientForm(form) {

            if (!validatePatientForm()) {
                return false;
            }

            $.ajax({
                url: $(form).attr('action'),
                type: 'POST',
                data: $(form).serialize(),

                success: function (response) {

                    if (response.success) {

                        var modalElement =
                            document.getElementById('patientModal');

                        var modal =
                            bootstrap.Modal.getInstance(modalElement);

                        if (modal) {
                            modal.hide();
                        }

                        showToast(
                            "success",
                            response.message
                        );

                        setTimeout(function () {
                            location.reload();
                        }, 900);
                    }
                    else {
                        $('#patientModalContent').html(response);

                        $.validator.unobtrusive.parse(
                            '#patientModalContent'
                        );

                        wirePatientValidation();
                    }
                },

                error: function (xhr) {

                    var message =
                        "Something went wrong. Please try again.";

                    if (xhr.responseText) {
                        message = xhr.responseText;
                    }

                    showToast(
                        "error",
                        message
                    );
                }
            });

            return false;
        }
        function wirePatientValidation() {

            $("#FullName").off("input blur").on("input blur", function () {
                validateFullName();
            });

            $("#DateOfBirth").off("input change blur").on("input change blur", function () {
                validateDateOfBirth();
            });

            $("#Gender").off("change blur").on("change blur", function () {
                validateGender();
            });

            $("#Email").off("input blur").on("input blur", function () {
                validateEmail();
            });

            $("#InsuranceId").off("input blur").on("input blur", function () {
                validateInsuranceId();
            });
        }

        function validatePatientForm() {

            var isFullNameValid = validateFullName();
            var isDateOfBirthValid = validateDateOfBirth();
            var isGenderValid = validateGender();
            var isEmailValid = validateEmail();
            var isInsuranceIdValid = validateInsuranceId();

            return isFullNameValid &&
                isDateOfBirthValid &&
                isGenderValid &&
                isEmailValid &&
                isInsuranceIdValid;
        }

        function validateFullName() {

            var fullName = $("#FullName").val().trim();

            if (fullName === "") {
                showFieldError(
                    "FullName",
                    "FullNameError",
                    "Patient name is required.");

                return false;
            }

            if (fullName.length < 3) {
                showFieldError(
                    "FullName",
                    "FullNameError",
                    "Patient name must be at least 3 characters.");

                return false;
            }

            if (fullName.length > 100) {
                showFieldError(
                    "FullName",
                    "FullNameError",
                    "Patient name cannot exceed 100 characters.");

                return false;
            }

            clearFieldError(
                "FullName",
                "FullNameError");

            return true;
        }

        function validateDateOfBirth() {

            var dobValue = $("#DateOfBirth").val();

            if (!dobValue) {
                showFieldError(
                    "DateOfBirth",
                    "DateOfBirthError",
                    "Date of birth is required.");

                return false;
            }

            var selectedDate = new Date(dobValue);

            if (isNaN(selectedDate.getTime())) {
                showFieldError(
                    "DateOfBirth",
                    "DateOfBirthError",
                    "Enter a valid date of birth.");

                return false;
            }

            var today = new Date();
            var minimumDate = new Date();

            minimumDate.setFullYear(
                minimumDate.getFullYear() - 110
            );

            today.setHours(0, 0, 0, 0);
            minimumDate.setHours(0, 0, 0, 0);
            selectedDate.setHours(0, 0, 0, 0);

            if (selectedDate > today) {
                showFieldError(
                    "DateOfBirth",
                    "DateOfBirthError",
                    "Future date not allowed.");

                return false;
            }

            if (selectedDate < minimumDate) {
                showFieldError(
                    "DateOfBirth",
                    "DateOfBirthError",
                    "Date of birth cannot be more than 110 years ago.");

                return false;
            }

            clearFieldError(
                "DateOfBirth",
                "DateOfBirthError");

            return true;
        }

        function validateGender() {

            var gender = $("#Gender").val();

            if (!gender) {
                showFieldError(
                    "Gender",
                    "GenderError",
                    "Gender is required.");

                return false;
            }

            clearFieldError(
                "Gender",
                "GenderError");

            return true;
        }

        function validateEmail() {

            var email = $("#Email").val();

            if (!email || email.trim() === "") {
                showFieldError(
                    "Email",
                    "EmailError",
                    "Email is required.");

                return false;
            }

            email = email.trim();

            var emailPattern =
                /^[A-Za-z0-9._%+-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;

            if (email.length > 150) {
                showFieldError(
                    "Email",
                    "EmailError",
                    "Email cannot exceed 150 characters.");

                return false;
            }

            if (/\s/.test(email)) {
                showFieldError(
                    "Email",
                    "EmailError",
                    "Email cannot contain spaces.");

                return false;
            }

            if (email.startsWith(".") || email.endsWith(".")) {
                showFieldError(
                    "Email",
                    "EmailError",
                    "Email cannot start or end with a dot.");

                return false;
            }

            if (email.indexOf("..") !== -1) {
                showFieldError(
                    "Email",
                    "EmailError",
                    "Email cannot contain consecutive dots.");

                return false;
            }

            if (!emailPattern.test(email)) {
                showFieldError(
                    "Email",
                    "EmailError",
                    "Enter a valid email address.");

                return false;
            }

            clearFieldError(
                "Email",
                "EmailError");

            return true;
        }

        function validateInsuranceId() {

            var insuranceId = $("#InsuranceId").val().trim();

            if (insuranceId.length > 50) {
                showFieldError(
                    "InsuranceId",
                    "InsuranceIdError",
                    "Insurance ID cannot exceed 50 characters.");

                return false;
            }

            clearFieldError(
                "InsuranceId",
                "InsuranceIdError");

            return true;
        }

        function showFieldError(
            fieldId,
            errorId,
            message) {

            $("#" + fieldId).addClass("is-invalid");

            $("#" + errorId).text(message);
        }

        function clearFieldError(
            fieldId,
            errorId) {

            $("#" + fieldId).removeClass("is-invalid");

            $("#" + errorId).text("");
        }

    </script>

}