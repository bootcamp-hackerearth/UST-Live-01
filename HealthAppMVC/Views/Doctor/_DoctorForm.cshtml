@model HealthAppWebAPI.Models.Dtos.CreateDoctorDto
@using HealthAppMVC.Models

<style>
    .is-invalid {
        border: 1px solid #dc3545 !important;
    }

    .custom-error {
        display: block;
        color: #dc3545;
        font-size: 14px;
        margin-top: 5px;
    }
</style>

<div class="row">

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="FullName" class="form-label">
                Full Name
            </label>

            @Html.TextBoxFor(
                m => m.FullName,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter doctor name",
                    minlength = "3",
                    maxlength = "100"
                })

            <span id="FullNameError"
                  class="custom-error">
            </span>

        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="Specialisation" class="form-label">
                Specialisation
            </label>

            @Html.DropDownListFor(
                m => m.Specialisation,
                new SelectList(
                    Enum.GetNames(typeof(SpecialisationType)),
                    Model != null ? Model.Specialisation : null
                ),
                "Select Specialisation",
                new
                {
                    @class = "form-control"
                })

            <span id="SpecialisationError"
                  class="custom-error">
            </span>

        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="DoctorEmail" class="form-label">
                Email
            </label>

            @Html.TextBoxFor(
                m => m.DoctorEmail,
                new
                {
                    @class = "form-control",
                    type = "text",
                    placeholder = "Enter email address",
                    maxlength = "150"
                })

            <span id="DoctorEmailError"
                  class="custom-error">
            </span>

        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="DoctorPhoneNo" class="form-label">
                Phone Number
            </label>

            @Html.TextBoxFor(
                m => m.DoctorPhoneNo,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter phone number",
                    maxlength = "10"
                })

            <span id="DoctorPhoneNoError"
                  class="custom-error">
            </span>

        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="YearsOfExperience" class="form-label">
                Years Of Experience
            </label>

            @Html.TextBoxFor(
                m => m.YearsOfExperience,
                new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0",
                    max = "60",
                    placeholder = "Enter years of experience"
                })

            <span id="YearsOfExperienceError"
                  class="custom-error">
            </span>

        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">

            <label for="ConsultationFee" class="form-label">
                Consultation Fee
            </label>

            @Html.TextBoxFor(
                m => m.ConsultationFee,
                new
                {
                    @class = "form-control",
                    type = "number",
                    step = "0.01",
                    min = "1",
                    max = "100000",
                    placeholder = "Enter consultation fee"
                })

            <span id="ConsultationFeeError"
                  class="custom-error">
            </span>

        </div>
    </div>

</div>