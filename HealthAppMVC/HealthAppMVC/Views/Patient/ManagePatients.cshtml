@model IEnumerable<SharedDto.PatientDtos.PatientDto>

@{
    ViewBag.Title = "Manage Patients";
}

<link rel="stylesheet"
      href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">

<style>
    .patient-card {
        border: none;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        transition: transform 0.2s ease;
    }

        .patient-card:hover {
            transform: translateY(-3px);
        }

    .patient-name {
        font-weight: bold;
    }

    .modal-header .close {
        color: #000;
        opacity: 1;
    }
</style>

<div class="container mt-5">

    <div id="successMessage"
         class="alert alert-success text-center"
         style="display:none;">
    </div>

    <div class="card shadow">

        <div class="card-header bg-info text-white">

            <h3>
                🔍 Manage Patient Details
            </h3>

            <small>
                Search, view and edit patient records
            </small>

        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-7">

                    <label class="form-label fw-bold">
                        Search Patient
                    </label>

                    <input type="text"
                           id="patientSearch"
                           class="form-control"
                           placeholder="Type patient name..." />

                </div>

                <div class="col-md-2 d-flex align-items-end">

                    <button type="button"
                            id="btnSearch"
                            class="btn btn-primary w-100">
                        Search
                    </button>

                </div>

                <div class="col-md-3 d-flex align-items-end">

                    <a href="@Url.Action("PatientServices", "Home")"
                       class="btn btn-secondary w-100">
                        Back
                    </a>

                </div>

            </div>

            <hr />

            @if (Model != null && Model.Any())
            {
                <div class="row"
                     id="patientContainer">

                    @foreach (var patient in Model)
                    {
                        <div class="col-md-6 mb-4 patient-wrapper"
                             id="patientCard_@patient.PatientId">

                            <div class="card patient-card h-100">

                                <div class="card-body">

                                    <h5 class="patient-name">
                                        👤 @patient.FullName
                                    </h5>

                                    <p>
                                        <strong>Patient ID:</strong>
                                        <span class="patient-id">
                                            @patient.PatientId
                                        </span>
                                    </p>

                                    <p>
                                        <strong>Date Of Birth:</strong>
                                        <span class="patient-dob">
                                            @patient.DateOfBirth.ToString("dd-MMM-yyyy")
                                        </span>
                                    </p>

                                    <p>
                                        <strong>Gender:</strong>
                                        <span class="patient-gender">
                                            @patient.Gender
                                        </span>
                                    </p>

                                    <p>
                                        <strong>Phone:</strong>
                                        <span class="patient-phone">
                                            @patient.PhoneNumber
                                        </span>
                                    </p>

                                    <p>
                                        <strong>Email:</strong>
                                        <span class="patient-email">
                                            @patient.Email
                                        </span>
                                    </p>

                                    <p>
                                        <strong>Insurance ID:</strong>
                                        <span class="patient-insurance">
                                            @patient.InsuranceId
                                        </span>
                                    </p>

                                    <p>
                                        <strong>Created:</strong>
                                        <span class="patient-created">
                                            @patient.CreatedDate.ToString("dd-MMM-yyyy")
                                        </span>
                                    </p>

                                    <div class="mt-3">

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                data-toggle="modal"
                                                data-target="#viewPatientModal_@patient.PatientId">
                                            View
                                        </button>

                                        <button type="button"
                                                class="btn btn-warning btn-sm"
                                                data-toggle="modal"
                                                data-target="#editPatientModal_@patient.PatientId">
                                            Edit
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- View Patient Modal -->
                        <div class="modal fade"
                             id="viewPatientModal_@patient.PatientId"
                             tabindex="-1"
                             role="dialog"
                             aria-hidden="true">

                            <div class="modal-dialog modal-lg"
                                 role="document">

                                <div class="modal-content">

                                    <div class="modal-header bg-info text-white">

                                        <h5 class="modal-title">
                                            👤 Patient Details
                                        </h5>

                                        <button type="button"
                                                class="close"
                                                data-dismiss="modal"
                                                aria-label="Close">
                                            <span aria-hidden="true">
                                                &times;
                                            </span>
                                        </button>

                                    </div>

                                    <div class="modal-body">

                                        <div class="card border-0">

                                            <div class="card-body">

                                                <p>
                                                    <strong>Patient ID:</strong>
                                                    <span class="modal-patient-id">
                                                        @patient.PatientId
                                                    </span>
                                                </p>

                                                <p>
                                                    <strong>Name:</strong>
                                                    <span class="modal-patient-name">
                                                        @patient.FullName
                                                    </span>
                                                </p>

                                                <p>
                                                    <strong>Date Of Birth:</strong>
                                                    <span class="modal-patient-dob">
                                                        @patient.DateOfBirth.ToString("dd-MMM-yyyy")
                                                    </span>
                                                </p>

                                                <p>
                                                    <strong>Gender:</strong>
                                                    <span class="modal-patient-gender">
                                                        @patient.Gender
                                                    </span>
                                                </p>

                                                <p>
                                                    <strong>Phone:</strong>
                                                    <span class="modal-patient-phone">
                                                        @patient.PhoneNumber
                                                    </span>
                                                </p>

                                                <p>
                                                    <strong>Email:</strong>
                                                    <span class="modal-patient-email">
                                                        @patient.Email
                                                    </span>
                                                </p>

                                                <p>
                                                    <strong>Insurance ID:</strong>
                                                    <span class="modal-patient-insurance">
                                                        @patient.InsuranceId
                                                    </span>
                                                </p>

                                                <p>
                                                    <strong>Created Date:</strong>
                                                    <span class="modal-patient-created">
                                                        @patient.CreatedDate.ToString("dd-MMM-yyyy")
                                                    </span>
                                                </p>

                                            </div>

                                        </div>

                                    </div>

                                    <div class="modal-footer">

                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-dismiss="modal">
                                            Back
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Edit Patient Modal -->
                        <div class="modal fade"
                             id="editPatientModal_@patient.PatientId"
                             tabindex="-1"
                             role="dialog"
                             aria-hidden="true">

                            <div class="modal-dialog modal-lg"
                                 role="document">

                                <div class="modal-content">

                                    <div class="modal-header bg-warning">

                                        <h5 class="modal-title">
                                            ✏️ Edit Patient
                                        </h5>

                                        <button type="button"
                                                class="close"
                                                data-dismiss="modal"
                                                aria-label="Close">
                                            <span aria-hidden="true">
                                                &times;
                                            </span>
                                        </button>

                                    </div>

                                    <form class="editPatientForm"
                                          method="post"
                                          action="@Url.Action("UpdatePatientFromManage", "Patient", new { id = patient.PatientId })">

                                        @Html.AntiForgeryToken()

                                        <div class="modal-body">

                                            <div class="edit-error alert alert-danger"
                                                 style="display:none;">
                                            </div>

                                            <div class="row">

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label fw-bold">
                                                        Full Name
                                                    </label>

                                                    <input type="text"
                                                           name="FullName"
                                                           class="form-control input-fullname"
                                                           value="@patient.FullName"
                                                           maxlength="100" />

                                                    <span class="text-danger field-error error-fullname"></span>

                                                </div>

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label fw-bold">
                                                        Date of Birth
                                                    </label>

                                                    <input type="date"
                                                           name="DateOfBirth"
                                                           class="form-control input-dob"
                                                           value="@patient.DateOfBirth.ToString("yyyy-MM-dd")" />

                                                    <span class="text-danger field-error error-dob"></span>

                                                </div>

                                            </div>

                                            <div class="row">

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label fw-bold">
                                                        Gender
                                                    </label>

                                                    <select name="Gender"
                                                            class="form-control input-gender">

                                                        <option value="">
                                                            -- Select Gender --
                                                        </option>

                                                        <option value="Male"
                                                                @(patient.Gender == "Male" ? "selected" : "")>
                                                            Male
                                                        </option>

                                                        <option value="Female"
                                                                @(patient.Gender == "Female" ? "selected" : "")>
                                                            Female
                                                        </option>

                                                        <option value="Other"
                                                                @(patient.Gender == "Other" ? "selected" : "")>
                                                            Other
                                                        </option>

                                                    </select>

                                                </div>
                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label fw-bold">
                                                        Phone Number
                                                    </label>

                                                    <input type="text"
                                                           name="PhoneNumber"
                                                           class="form-control input-phone"
                                                           value="@patient.PhoneNumber"
                                                           maxlength="10" />

                                                    <span class="text-danger field-error error-phone"></span>

                                                </div>

                                            </div>

                                            <div class="row">

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label fw-bold">
                                                        Email Address
                                                    </label>

                                                    <input type="email"
                                                           name="Email"
                                                           class="form-control input-email"
                                                           value="@patient.Email"
                                                           maxlength="100" />

                                                    <span class="text-danger field-error error-email"></span>

                                                </div>

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label fw-bold">
                                                        Insurance ID
                                                    </label>

                                                    <input type="text"
                                                           name="InsuranceId"
                                                           class="form-control input-insurance"
                                                           value="@patient.InsuranceId" />

                                                </div>

                                            </div>

                                        </div>

                                        <div class="modal-footer">

                                            <button type="submit"
                                                    class="btn btn-success">
                                                Save
                                            </button>

                                            <button type="button"
                                                    class="btn btn-secondary"
                                                    data-dismiss="modal">
                                                Back
                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div id="noResults"
                     class="alert alert-warning mt-3"
                     style="display:none;">

                    No patients found.

                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No patients found.
                </div>
            }

        </div>

    </div>

</div>

@section Scripts{

    @Scripts.Render("~/bundles/jqueryval")

    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script>

        $(function () {

            $("#patientSearch").autocomplete({

                source:
                    '@Url.Action("SearchPatientNames", "Patient")',

                minLength: 1

            });

            function filterPatients() {

                var searchText =
                    $("#patientSearch")
                        .val()
                        .toLowerCase();

                var visibleCount = 0;

                $(".patient-wrapper")
                    .each(function () {

                        var patientName =
                            $(this)
                                .find(".patient-name")
                                .text()
                                .toLowerCase();

                        if (patientName.indexOf(searchText) > -1) {

                            $(this).show();

                            visibleCount++;
                        }
                        else {

                            $(this).hide();
                        }

                    });

                if (visibleCount === 0) {

                    $("#noResults").show();
                }
                else {

                    $("#noResults").hide();
                }
            }

            $("#btnSearch").click(function () {

                filterPatients();

            });

            $("#patientSearch").on(
                "keyup input",
                function () {

                    filterPatients();

                });


                function validateEditPatientForm(form) {

    var isValid = true;

    form.find(".field-error")
        .text("");

    form.find(".form-control")
        .removeClass("is-invalid");

    var fullName =
        form.find(".input-fullname")
            .val()
            .trim();

    var dob =
        form.find(".input-dob")
            .val();

    var gender =
        form.find(".input-gender")
            .val();

    var phone =
        form.find(".input-phone")
            .val()
            .trim();

    var email =
        form.find(".input-email")
            .val()
            .trim();

    var insuranceId =
        form.find(".input-insurance")
            .val()
            .trim();

    var nameRegex =
        /^[A-Za-z ]+$/;

    var phoneRegex =
        /^[0-9]{10}$/;

    var emailRegex =
       /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

    if (fullName === "") {

        form.find(".error-fullname")
            .text("Full name is required.");

        form.find(".input-fullname")
            .addClass("is-invalid");

        isValid = false;
    }
    else if (!nameRegex.test(fullName)) {

        form.find(".error-fullname")
            .text("Name can contain only letters and spaces.");

        form.find(".input-fullname")
            .addClass("is-invalid");

        isValid = false;
    }
    else if (fullName.length > 100) {

        form.find(".error-fullname")
            .text("Full name cannot exceed 100 characters.");

        form.find(".input-fullname")
            .addClass("is-invalid");

        isValid = false;
    }

    if (dob === "") {

        form.find(".error-dob")
            .text("Date of birth is required.");

        form.find(".input-dob")
            .addClass("is-invalid");

        isValid = false;
    }
    else {

        var selectedDate =
            new Date(dob);

        var today =
            new Date();

        today.setHours(0, 0, 0, 0);

        if (selectedDate > today) {

            form.find(".error-dob")
                .text("Future date not allowed.");

            form.find(".input-dob")
                .addClass("is-invalid");

            isValid = false;
        }
    }

    if (gender === "") {

        form.find(".error-gender")
            .text("Gender is required.");

        form.find(".input-gender")
            .addClass("is-invalid");

        isValid = false;
    }

    if (phone === "") {

        form.find(".error-phone")
            .text("Phone number is required.");

        form.find(".input-phone")
            .addClass("is-invalid");

        isValid = false;
    }
    else if (!phoneRegex.test(phone)) {

        form.find(".error-phone")
            .text("Phone number must contain exactly 10 digits.");

        form.find(".input-phone")
            .addClass("is-invalid");

        isValid = false;
    }

    if (email === "") {

        form.find(".error-email")
            .text("Email is required.");

        form.find(".input-email")
            .addClass("is-invalid");

        isValid = false;
    }
    else if (!emailRegex.test(email)) {

        form.find(".error-email")
            .text("Invalid email format.");

        form.find(".input-email")
            .addClass("is-invalid");

        isValid = false;
    }
    else if (email.length > 100) {

        form.find(".error-email")
            .text("Email cannot exceed 100 characters.");

        form.find(".input-email")
            .addClass("is-invalid");

        isValid = false;
    }

    if (insuranceId.length > 50) {

        form.find(".error-insurance")
            .text("Insurance ID cannot exceed 50 characters.");

        form.find(".input-insurance")
            .addClass("is-invalid");

        isValid = false;
    }

    return isValid;
}

            $(".editPatientForm").submit(function (e) {

                e.preventDefault();

                var form =
                    $(this);


                if (!validateEditPatientForm(form)) {
                    return;
                }


                var submitButton =
                    form.find("button[type='submit']");

                var errorBox =
                    form.find(".edit-error");

                errorBox
                    .hide()
                    .html("");

                submitButton
                    .prop("disabled", true)
                    .text("Saving...");

                $.ajax({

                    url: form.attr("action"),

                    type: "POST",

                    data: form.serialize(),

                    success: function (response) {

                        if (response.success) {

                            var p =
                                response.patient;

                            var card =
                                $("#patientCard_" + p.patientId);

                            card.find(".patient-name")
                                .text("👤 " + p.fullName);

                            card.find(".patient-dob")
                                .text(p.dateOfBirth);

                            card.find(".patient-gender")
                                .text(p.gender);

                            card.find(".patient-phone")
                                .text(p.phoneNumber);

                            card.find(".patient-email")
                                .text(p.email);

                            card.find(".patient-insurance")
                                .text(p.insuranceId);

                            card.find(".patient-created")
                                .text(p.createdDate);

                            var viewModal =
                                $("#viewPatientModal_" + p.patientId);

                            viewModal.find(".modal-patient-name")
                                .text(p.fullName);

                            viewModal.find(".modal-patient-dob")
                                .text(p.dateOfBirth);

                            viewModal.find(".modal-patient-gender")
                                .text(p.gender);

                            viewModal.find(".modal-patient-phone")
                                .text(p.phoneNumber);

                            viewModal.find(".modal-patient-email")
                                .text(p.email);

                            viewModal.find(".modal-patient-insurance")
                                .text(p.insuranceId);

                            viewModal.find(".modal-patient-created")
                                .text(p.createdDate);

                            form.find(".input-fullname")
                                .val(p.fullName);

                            form.find(".input-dob")
                                .val(p.dateOfBirthInput);

                            form.find(".input-gender")
                                .val(p.gender);

                            form.find(".input-phone")
                                .val(p.phoneNumber);

                            form.find(".input-email")
                                .val(p.email);

                            form.find(".input-insurance")
                                .val(p.insuranceId);

                            // Close modal correctly for Bootstrap 3/4
                            var modalElement =
                                form.closest(".modal");

                            modalElement.modal("hide");

                            // Fix stuck screen/backdrop issue
                            $(".modal-backdrop").remove();

                            $("body")
                                .removeClass("modal-open")
                                .css("padding-right", "");

                            $("#successMessage")
                                .text(response.message)
                                .fadeIn();

                            setTimeout(function () {

                                $("#successMessage")
                                    .fadeOut();

                            }, 3000);
                        }
                        else {

                            var html =
                                "<ul>";

                            $.each(
                                response.errors,
                                function (i, error) {

                                    html +=
                                        "<li>" +
                                        error +
                                        "</li>";
                                });

                            html +=
                                "</ul>";

                            errorBox
                                .html(html)
                                .show();
                        }

                    },

                    error: function () {

                        errorBox
                            .html("Something went wrong while saving.")
                            .show();

                    },

                    complete: function () {

                        submitButton
                            .prop("disabled", false)
                            .text("Save");

                    }

                });

            });

            $(".editPatientForm input, .editPatientForm select")
                .on("input change", function () {

                    var form =
                        $(this).closest("form");

                    $(this)
                        .removeClass("is-invalid");

                    if ($(this).hasClass("input-fullname")) {
                        form.find(".error-fullname").text("");
                    }

                    if ($(this).hasClass("input-dob")) {
                        form.find(".error-dob").text("");
                    }

                    if ($(this).hasClass("input-gender")) {
                        form.find(".error-gender").text("");
                    }

                    if ($(this).hasClass("input-phone")) {
                        form.find(".error-phone").text("");
                    }

                    if ($(this).hasClass("input-email")) {
                        form.find(".error-email").text("");
                    }

                    if ($(this).hasClass("input-insurance")) {
                        form.find(".error-insurance").text("");
                    }
                });

        });

    </script>

}