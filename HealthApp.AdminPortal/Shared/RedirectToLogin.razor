@using HealthApp.AdminPortal.Services
@using HealthApp.AdminPortal.Services.Interface

@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject INotificationService NotificationService
@inject AuthRedirectState AuthRedirectState

@code {
    protected override void OnInitialized()
    {
        var message = AuthRedirectState.ConsumeMessage();

        if (!string.IsNullOrWhiteSpace(message))
        {
            NotificationService.Warning(message);
        }

        var angularBaseUrl = Configuration["AngularApp:BaseUrl"];

        NavigationManager.NavigateTo(
            $"{angularBaseUrl}/login",
            forceLoad: true);
    }
}