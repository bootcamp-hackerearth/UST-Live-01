@page "/"
@page "/login"
@layout EmptyLayout

@using HealthApp.Shared.Dtos

@inject NavigationManager NavigationManager
@inject IAuthService AuthService

<PageTitle>Login - HealthApp Admin</PageTitle>

<div class="login-page">
    <div class="login-card row g-0 shadow-lg overflow-hidden">

        <div class="col-md-6 d-none d-md-flex flex-column justify-content-center align-items-center text-white p-5 login-left-panel">
            <div class="text-center">
                <i class="bi bi-heart-pulse-fill login-icon"></i>

                <h1 class="fw-bold mt-4 mb-3 text-center">
                    HealthApp Admin
                </h1>

                <p class="lead mb-2 text-center">
                    Admin Portal
                </p>

                <p class="text-white-50 mb-0 text-center">
                    Manage doctors, patients, appointments and reports.
                </p>
            </div>
        </div>

        <div class="col-md-6 d-flex align-items-center">
            <div class="login-form-wrapper w-100">

                <div class="mb-4">
                    <div class="top-nav-brand-icon mb-3">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <h3 class="fw-bold mb-1">
                        Welcome Back
                    </h3>

                    <p class="text-muted mb-0">
                        Login to your admin account.
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="alert alert-danger rounded-4 border-0 fw-semibold mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @ErrorMessage
                    </div>
                }

                <EditForm Model="@LoginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Email
                        </label>

                        <InputText class="form-control form-control-lg"
                                   placeholder="Enter your email"
                                   @bind-Value="LoginModel.Email" />

                        <ValidationMessage For="@(() => LoginModel.Email)" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Password
                        </label>

                        <InputText type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your password"
                                   @bind-Value="LoginModel.Password" />

                        <ValidationMessage For="@(() => LoginModel.Password)" />
                    </div>

                    <button type="submit"
                            class="btn btn-health btn-lg w-100 rounded-pill"
                            disabled="@isLoading">

                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Logging in...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            <span>Login</span>
                        }
                    </button>
                </EditForm>

            </div>
        </div>

    </div>
</div>

@code {
    private readonly LoginDto LoginModel = new();

    private string? ErrorMessage;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        ErrorMessage = null;

        var result = await AuthService.Login(LoginModel);

        isLoading = false;

        if (result.IsSuccess)
        {
            LoginModel.Password = string.Empty;
            NavigationManager.NavigateTo("/dashboard");
        }
        else
        {
            ErrorMessage = result.Message;
        }
    }
}