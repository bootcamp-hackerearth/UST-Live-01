@page "/login"

@using Microsoft.AspNetCore.Components.Authorization
@using HealthApp.AdminPortal.Auth
@using HealthApp.AdminPortal.Services.Interface

@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITokenService TokenService

<div class="admin-login-bridge-page">
    <div class="admin-login-bridge-card">
        <div class="admin-login-bridge-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h3>@TitleText</h3>

        <p>@MessageText</p>

        @if (!string.IsNullOrWhiteSpace(ErrorText))
        {
            <div class="alert alert-danger mt-3" role="alert">
                @ErrorText
            </div>
        }
    </div>
</div>

@code {
    private bool _hasProcessedToken;

    private string TitleText { get; set; } = "Signing you in...";

    private string MessageText { get; set; } =
        "Please wait while we securely connect your admin session.";

    private string ErrorText { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasProcessedToken)
        {
            return;
        }

        _hasProcessedToken = true;

        await ProcessTokenLoginAsync();
    }

    private async Task ProcessTokenLoginAsync()
    {
        try
        {
            var token = GetTokenFromQuery();

            if (string.IsNullOrWhiteSpace(token))
            {
                RedirectToAngularLogin();
                return;
            }

            await TokenService.SetToken(token);

            if (AuthenticationStateProvider is CustomAuthStateProvider customAuthProvider)
            {
                customAuthProvider.NotifyUserAuthentication(token);
            }
            else
            {
                TitleText = "Authentication provider error";
                MessageText = "The admin portal authentication provider is not configured correctly.";
                ErrorText = "AuthenticationStateProvider could not be converted to CustomAuthStateProvider.";
                StateHasChanged();
                return;
            }

            TitleText = "Login successful";
            MessageText = "Redirecting to admin dashboard...";
            StateHasChanged();

            NavigationManager.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            TitleText = "Login failed";
            MessageText = "Unable to complete admin login. Please login again from HealthApp.";
            ErrorText = ex.Message;
            StateHasChanged();
        }
    }

    private string? GetTokenFromQuery()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = uri.Query;

        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        if (query.StartsWith("?"))
        {
            query = query[1..];
        }

        var queryParts = query.Split(
            '&',
            StringSplitOptions.RemoveEmptyEntries);

        foreach (var part in queryParts)
        {
            var keyValue = part.Split('=', 2);

            if (keyValue.Length != 2)
            {
                continue;
            }

            var key = Uri.UnescapeDataString(keyValue[0]);

            if (!string.Equals(key, "token", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return Uri.UnescapeDataString(keyValue[1]);
        }

        return null;
    }

    private void RedirectToAngularLogin()
    {
        var angularBaseUrl = Configuration["AngularApp:BaseUrl"];

        if (string.IsNullOrWhiteSpace(angularBaseUrl))
        {
            angularBaseUrl = "https://localhost:4200";
        }

        NavigationManager.NavigateTo(
            $"{angularBaseUrl}/login",
            forceLoad: true);
    }
}