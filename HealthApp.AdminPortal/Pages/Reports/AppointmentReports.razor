@page "/reports"
@inject IReportService ReportService
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Appointment Reports - HealthApp Admin</PageTitle>

<div class="page-header-box mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 w-100">
        <div>
            <h2 class="page-title mb-1">Appointment Reports</h2>
            <p class="text-muted mb-0">
                Summary of confirmed, cancelled and completed appointments.
            </p>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    @foreach (var summary in ReportSummaries)
    {
        <div class="col-lg-4 col-md-6">
            <div class="report-summary-card @summary.CardClass">
                <div class="report-summary-icon">
                    <i class="@summary.Icon"></i>
                </div>

                <div>
                    <div class="report-summary-value">
                        @summary.Count
                    </div>

                    <div class="report-summary-label">
                        @summary.Label Appointments
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="table-card">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
        <div>
            <h5 class="fw-bold mb-1">Daily Appointment Report</h5>
            <p class="text-muted small mb-0">
                Showing @Reports.Count report record(s)
            </p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-health" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <p class="mt-3 mb-0 text-muted fw-semibold">
                Loading reports...
            </p>
        </div>
    }
    else if (!Reports.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-file-earmark-bar-graph"></i>
            <h6 class="fw-bold mt-3 mb-1">No reports found</h6>
            <p class="text-muted mb-0">
                Appointment report data is not available yet.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle custom-table">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Confirmed</th>
                        <th>Cancelled</th>
                        <th>Completed</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var report in Reports)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">
                                    @report.Date.ToString("dd MMM yyyy")
                                </div>

                                <small class="text-muted fw-semibold">
                                    @report.Date.ToString("dddd")
                                </small>
                            </td>

                            <td>
                                <span class="report-count-badge report-confirmed">
                                    @report.Confirmed
                                </span>
                            </td>

                            <td>
                                <span class="report-count-badge report-cancelled">
                                    @report.Cancelled
                                </span>
                            </td>

                            <td>
                                <span class="report-count-badge report-completed">
                                    @report.Completed
                                </span>
                            </td>

                            <td>
                                <span class="report-count-badge badge-soft-info">
                                    @report.Total
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@code {
    private List<AppointmentReportDto> Reports = new();

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var result = await ReportService.GetAppointmentReports();

        if (result.IsSuccess)
        {
            Reports = result.Data ?? new List<AppointmentReportDto>();
        }
        else
        {
            Reports = new List<AppointmentReportDto>();
            NotificationService.Error(result.Message);
            if (result.Message.Contains("session has expired", StringComparison.OrdinalIgnoreCase)
                    || result.Message.Contains("login", StringComparison.OrdinalIgnoreCase))
            {
                NavigationManager.NavigateTo("/login");
            }
        }

        isLoading = false;
    }

    private List<ReportSummaryModel> ReportSummaries => new()
    {
        new ReportSummaryModel
        {
            Label = "Confirmed",
            Count = Reports.Sum(report => report.Confirmed),
            Icon = "bi bi-calendar-check",
            CardClass = "report-card-confirmed"
        },
        new ReportSummaryModel
        {
            Label = "Completed",
            Count = Reports.Sum(report => report.Completed),
            Icon = "bi bi-check-circle",
            CardClass = "report-card-completed"
        },
        new ReportSummaryModel
        {
            Label = "Cancelled",
            Count = Reports.Sum(report => report.Cancelled),
            Icon = "bi bi-x-circle",
            CardClass = "report-card-cancelled"
        }
    };

    private class ReportSummaryModel
    {
        public string Label { get; set; } = string.Empty;

        public int Count { get; set; }

        public string Icon { get; set; } = string.Empty;

        public string CardClass { get; set; } = string.Empty;
    }
}