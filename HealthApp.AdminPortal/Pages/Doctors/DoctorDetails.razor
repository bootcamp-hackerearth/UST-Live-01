@page "/doctors/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager NavigationManager
@inject IDoctorService DoctorService
@inject INotificationService NotificationService

<PageTitle>Doctor Details - HealthApp Admin</PageTitle>

<div class="page-header-box mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 w-100">
        <div>
            <h2 class="page-title mb-1">Doctor Details</h2>
            <p class="text-muted mb-0">
                View doctor profile, contact information, consultation fee and availability.
            </p>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2">
            <NavLink href="@($"/doctors/edit/{Id}")"
                     class="btn btn-health rounded-pill px-4">
                <i class="bi bi-pencil-square me-2"></i>
                Edit Doctor
            </NavLink>

            <NavLink href="/doctors"
                     class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Doctors
            </NavLink>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="table-card text-center py-5">
        <div class="spinner-border text-health" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>

        <p class="mt-3 mb-0 text-muted fw-semibold">
            Loading doctor...
        </p>
    </div>
}
else if (Doctor == null)
{
    <div class="table-card text-center py-5">
        <div class="empty-state">
            <i class="bi bi-person-x"></i>
            <h6 class="fw-bold mt-3 mb-1">Doctor not found</h6>
            <p class="text-muted mb-4">
                The requested doctor profile could not be found.
            </p>

            <NavLink href="/doctors"
                     class="btn btn-health rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Doctors
            </NavLink>
        </div>
    </div>
}
else
{
    <div class="appointment-details-card w-100" style="max-width: none;">

        <div class="appointment-details-header">
            <div class="appointment-details-icon">
                <i class="bi bi-person-badge"></i>
            </div>

            <div>
                <div class="details-info-label mb-1">Doctor Profile</div>

                <h4 class="fw-bold mb-2">
                    @Doctor.FullName
                </h4>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="doctor-status-badge @(Doctor.IsActive ? "status-active" : "status-inactive")">
                        <i class="bi @(Doctor.IsActive ? "bi-check-circle-fill" : "bi-clock-fill")"></i>
                        @(Doctor.IsActive ? "Available" : "Not Available")
                    </span>

                    <span class="badge-soft-info rounded-pill px-3 py-2 fw-bold">
                        @Doctor.Specialisation
                    </span>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-2">

            <div class="col-lg-6 col-md-6">
                <div class="details-info-box">
                    <div class="details-info-icon">
                        <i class="bi bi-person"></i>
                    </div>

                    <div>
                        <div class="details-info-label">Full Name</div>
                        <div class="details-info-value">@Doctor.FullName</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="details-info-box">
                    <div class="details-info-icon">
                        <i class="bi bi-hash"></i>
                    </div>

                    <div>
                        <div class="details-info-label">Doctor ID</div>
                        <div class="details-info-value">
                            DOC-@Doctor.DoctorId.ToString("000")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="details-info-box">
                    <div class="details-info-icon">
                        <i class="bi bi-award"></i>
                    </div>

                    <div>
                        <div class="details-info-label">Specialisation</div>
                        <div class="details-info-value">@Doctor.Specialisation</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="details-info-box">
                    <div class="details-info-icon">
                        <i class="bi bi-envelope"></i>
                    </div>

                    <div>
                        <div class="details-info-label">Email</div>
                        <div class="details-info-value">@Doctor.DoctorEmail</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="details-info-box">
                    <div class="details-info-icon">
                        <i class="bi bi-telephone"></i>
                    </div>

                    <div>
                        <div class="details-info-label">Phone Number</div>
                        <div class="details-info-value">@Doctor.DoctorPhoneNo</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="details-info-box">
                    <div class="details-info-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <div>
                        <div class="details-info-label">Years Of Experience</div>
                        <div class="details-info-value">
                            @Doctor.YearsOfExperience years
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="details-info-box">
                    <div class="details-info-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>

                    <div>
                        <div class="details-info-label">Consultation Fee</div>
                        <div class="details-info-value">
                            ₹ @Doctor.ConsultationFee.ToString("0.00")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="details-info-box">
                    <div class="details-info-icon">
                        <i class="bi bi-activity"></i>
                    </div>

                    <div>
                        <div class="details-info-label">Availability Status</div>
                        <div class="details-info-value">
                            @(Doctor.IsActive ? "Available for appointments" : "Currently not available")
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="mt-4 pt-4 border-top d-flex flex-column flex-sm-row gap-2">
            <NavLink href="@($"/doctors/edit/{Doctor.DoctorId}")"
                     class="btn btn-health rounded-pill px-4">
                <i class="bi bi-pencil-square me-2"></i>
                Edit Doctor
            </NavLink>

            <NavLink href="/doctors"
                     class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Doctors
            </NavLink>
        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private DoctorDto? Doctor;

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var result = await DoctorService.GetAll();

        if (result.IsSuccess)
        {
            Doctor = result.Data?
                .FirstOrDefault(doctor => doctor.DoctorId == Id);

            if (Doctor == null)
            {
                NotificationService.Warning("Doctor not found.");
            }
        }
        else
        {
            NotificationService.Error(result.Message);
            if (result.Message.Contains("session has expired", StringComparison.OrdinalIgnoreCase)
                    || result.Message.Contains("login", StringComparison.OrdinalIgnoreCase))
            {
                NavigationManager.NavigateTo("/login");
            }
        }

        isLoading = false;
    }
}