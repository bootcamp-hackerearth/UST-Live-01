@page "/doctors/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager NavigationManager
@inject IDoctorService DoctorService
@inject INotificationService NotificationService

<PageTitle>Edit Doctor - HealthApp Admin</PageTitle>

<div class="page-header-box mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 w-100">
        <div>
            <h2 class="page-title mb-1">Edit Doctor</h2>
            <p class="text-muted mb-0">
                Update doctor profile, specialisation, consultation fee and experience.
            </p>
        </div>

        <NavLink href="doctors" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Doctors
        </NavLink>
    </div>
</div>

@if (isLoading)
{
    <div class="table-card text-center py-5">
        <div class="spinner-border text-health" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>

        <p class="mt-3 mb-0 text-muted fw-semibold">
            Loading doctor...
        </p>
    </div>
}
else
{
    <div class="form-card doctor-form-card w-100" style="max-width: none;">

        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="doctor-avatar">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>
                <h5 class="fw-bold mb-1">Doctor Information</h5>
                <p class="text-muted small mb-0">
                    Modify the doctor details below.
                </p>
            </div>
        </div>

        <EditForm Model="@Doctor" OnValidSubmit="UpdateDoctor">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-4">

                <div class="col-lg-6 col-md-6">
                    <label class="form-label fw-semibold">Full Name</label>

                    <InputText class="form-control"
                               placeholder="Enter full name"
                               @bind-Value="Doctor.FullName" />

                    <ValidationMessage For="@(() => Doctor.FullName)" />
                </div>

                <div class="col-lg-6 col-md-6">
                    <label class="form-label fw-semibold">Specialisation</label>

                    <InputSelect class="form-select"
                                 @bind-Value="Doctor.Specialisation">
                        <option value="">Select Specialisation</option>

                        @foreach (var spec in Specialisations)
                        {
                            <option value="@spec">@spec</option>
                        }
                    </InputSelect>

                    <ValidationMessage For="@(() => Doctor.Specialisation)" />
                </div>

                <div class="col-lg-6 col-md-6">
                    <label class="form-label fw-semibold">Email</label>

                    <InputText class="form-control"
                               placeholder="doctor@example.com"
                               @bind-Value="Doctor.DoctorEmail" />

                    <ValidationMessage For="@(() => Doctor.DoctorEmail)" />
                </div>

                <div class="col-lg-6 col-md-6">
                    <label class="form-label fw-semibold">Phone Number</label>

                    <InputText class="form-control"
                               placeholder="Enter 10-digit phone number"
                               maxlength="10"
                               @bind-Value="Doctor.DoctorPhoneNo" />

                    <ValidationMessage For="@(() => Doctor.DoctorPhoneNo)" />
                </div>

                <div class="col-lg-6 col-md-6">
                    <label class="form-label fw-semibold">Years Of Experience</label>

                    <InputNumber class="form-control"
                                 placeholder="Enter years of experience"
                                 @bind-Value="Doctor.YearsOfExperience" />
                </div>

                <div class="col-lg-6 col-md-6">
                    <label class="form-label fw-semibold">Consultation Fee</label>

                    <InputNumber class="form-control"
                                 placeholder="Enter consultation fee"
                                 @bind-Value="Doctor.ConsultationFee" />
                </div>

            </div>

            <div class="mt-4 pt-4 border-top d-flex flex-column flex-sm-row gap-2">
                <button type="submit"
                        class="btn btn-health rounded-pill px-4"
                        disabled="@isSaving">

                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Updating...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle me-2"></i>
                        <span>Update Doctor</span>
                    }
                </button>

                <button type="button"
                        class="btn btn-outline-secondary rounded-pill px-4"
                        disabled="@isSaving"
                        @onclick="Cancel">
                    <i class="bi bi-x-circle me-2"></i>
                    Cancel
                </button>
            </div>

        </EditForm>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private DoctorCreateDto Doctor = new();

    private bool isLoading = true;

    private bool isSaving = false;

    private readonly List<SpecialisationType> Specialisations =
        Enum.GetValues<SpecialisationType>().ToList();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var result = await DoctorService.GetAll();

        if (result.IsSuccess)
        {
            var existingDoctor = result.Data?.Items
                .FirstOrDefault(doctor => doctor.DoctorId == Id);

            if (existingDoctor is null)
            {
                NotificationService.Error("Doctor not found.");
                NavigationManager.NavigateTo("doctors");
                return;
            }

            Doctor = new DoctorCreateDto
            {
                FullName = existingDoctor.FullName,
                DoctorEmail = existingDoctor.DoctorEmail,
                DoctorPhoneNo = existingDoctor.DoctorPhoneNo,
                YearsOfExperience = existingDoctor.YearsOfExperience,
                ConsultationFee = existingDoctor.ConsultationFee,
                Specialisation = Enum.TryParse<SpecialisationType>(
                    existingDoctor.Specialisation,
                    true,
                    out var specialisation)
                    ? specialisation
                    : null
            };
        }
        else
        {
            NotificationService.Error(result.Message);
        }

        isLoading = false;
    }

    private async Task UpdateDoctor()
    {
        isSaving = true;

        var result = await DoctorService.Update(Id, Doctor);

        isSaving = false;

        if (result.IsSuccess)
        {
            NotificationService.Success(result.Message);
            NavigationManager.NavigateTo("doctors");
        }
        else
        {
            NotificationService.Error(result.Message);
            if (result.Message.Contains("session has expired", StringComparison.OrdinalIgnoreCase)
                    || result.Message.Contains("login", StringComparison.OrdinalIgnoreCase))
            {
                NavigationManager.NavigateTo("/login");
            }
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("doctors");
    }
}
