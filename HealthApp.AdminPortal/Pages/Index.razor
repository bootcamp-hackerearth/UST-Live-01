@page "/"

@using HealthApp.AdminPortal.Services.Interface

@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject ITokenService TokenService

<div class="admin-login-bridge-page">
    <div class="admin-login-bridge-card">
        <div class="admin-login-bridge-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h3>Checking admin session...</h3>

        <p>Please wait while we redirect you to the correct portal.</p>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var token = await TokenService.GetToken();

        if (string.IsNullOrWhiteSpace(token))
        {
            NavigationManager.NavigateTo(
                GetAngularLoginUrl(),
                forceLoad: true);

            return;
        }

        NavigationManager.NavigateTo(
            "/dashboard",
            forceLoad: true);
    }

    private string GetAngularLoginUrl()
    {
        var angularBaseUrl = Configuration["AngularApp:BaseUrl"];

        return $"{angularBaseUrl}/login";
    }
}
