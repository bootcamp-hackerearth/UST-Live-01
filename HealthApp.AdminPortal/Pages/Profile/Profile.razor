@page "/profile"
@attribute [Authorize(Roles = "Admin")]

@inject ITokenService TokenService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>My Profile - HealthApp Admin</PageTitle>

<div class="page-header-box mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 w-100">
        <div>
            <h2 class="page-title mb-1">My Profile</h2>
            <p class="text-muted mb-0">
                View your admin account information.
            </p>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2">
            <NavLink href="/profile/change-password"
                     class="btn btn-health rounded-pill px-4">
                <i class="bi bi-key me-2"></i>
                Change Password
            </NavLink>

            <button type="button"
                    class="btn btn-outline-danger rounded-pill px-4"
                    @onclick="ShowLogoutConfirm">
                <i class="bi bi-door-open-fill me-2"></i>
                Logout
            </button>
        </div>
    </div>
</div>

@if (profile == null)
{
    <div class="table-card text-center py-5">
        <div class="spinner-border text-health" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>

        <p class="mt-3 mb-0 text-muted fw-semibold">
            Loading profile...
        </p>
    </div>
}
else
{
    <div class="profile-card admin-full-card">

        <div class="profile-header">
            <div class="profile-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div>
                <div class="profile-info-label mb-1">Admin Account</div>

                <h4 class="fw-bold mb-2">
                    @profile.Name
                </h4>

                <span class="badge badge-soft-info rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-shield-check me-2"></i>
                    @profile.Role
                </span>
            </div>
        </div>

        <div class="row g-4 mt-2">

            <div class="col-lg-6 col-md-6">
                <div class="profile-info-box">
                    <div class="profile-info-icon">
                        <i class="bi bi-person"></i>
                    </div>

                    <div>
                        <div class="profile-info-label">Name</div>
                        <div class="profile-info-value">@profile.Name</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="profile-info-box">
                    <div class="profile-info-icon">
                        <i class="bi bi-envelope"></i>
                    </div>

                    <div>
                        <div class="profile-info-label">Email</div>
                        <div class="profile-info-value">@profile.Email</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="profile-info-box">
                    <div class="profile-info-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>
                        <div class="profile-info-label">Role</div>
                        <div class="profile-info-value">@profile.Role</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="profile-info-box">
                    <div class="profile-info-icon">
                        <i class="bi bi-lock"></i>
                    </div>

                    <div>
                        <div class="profile-info-label">Security</div>
                        <div class="profile-info-value">Password protected</div>
                    </div>
                </div>
            </div>

        </div>

    </div>
}

@if (showLogoutConfirm)
{
    <div class="logout-modal-backdrop">
        <div class="logout-confirm-modal">

            <div class="logout-confirm-icon">
                <i class="bi bi-door-open-fill"></i>
            </div>

            <h5 class="fw-bold mb-2">
                Logout Confirmation
            </h5>

            <p class="text-muted mb-4">
                Are you sure you want to logout from HealthApp Admin?
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <button type="button"
                        class="btn btn-outline-secondary rounded-pill px-4"
                        @onclick="CancelLogout">
                    <i class="bi bi-arrow-left me-2"></i>
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger rounded-pill px-4"
                        @onclick="ConfirmLogout">
                    <i class="bi bi-door-open-fill me-2"></i>
                    Yes, Logout
                </button>
            </div>

        </div>
    </div>
}

@code {
    private ProfileModel? profile;
    private bool showLogoutConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await TokenService.GetToken();

        if (!string.IsNullOrWhiteSpace(token))
        {
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(token);

            profile = new ProfileModel
            {
                Name = jwt.Claims.FirstOrDefault(c =>
                            c.Type == "name" || c.Type == "unique_name")?.Value
                        ?? "Admin",

                Email = jwt.Claims.FirstOrDefault(c =>
                            c.Type == "email")?.Value
                        ?? "N/A",

                Role = jwt.Claims.FirstOrDefault(c =>
                            c.Type == "role")?.Value
                        ?? "Admin"
            };
        }
        else
        {
            profile = new ProfileModel
            {
                Name = "Unknown",
                Email = "Not logged in",
                Role = "-"
            };
        }
    }

    private void ShowLogoutConfirm()
    {
        showLogoutConfirm = true;
    }

    private void CancelLogout()
    {
        showLogoutConfirm = false;
    }

    private async Task ConfirmLogout()
    {
        showLogoutConfirm = false;

        await AuthService.Logout();

        NavigationManager.NavigateTo("/login", true);
    }

    private class ProfileModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
    }
}