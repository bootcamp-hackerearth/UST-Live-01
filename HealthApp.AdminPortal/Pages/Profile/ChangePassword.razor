@page "/profile/change-password"
@attribute [Authorize(Roles = "Admin")]

@inject IAuthService AuthService
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Change Password - HealthApp Admin</PageTitle>

<div class="page-header-box mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 w-100">
        <div>
            <h2 class="page-title mb-1">Change Password</h2>
            <p class="text-muted mb-0">
                Update your admin account password securely.
            </p>
        </div>

        <NavLink href="/profile"
                 class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Profile
        </NavLink>
    </div>
</div>

<div class="form-card change-password-card w-100" style="max-width: none;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="profile-avatar" style="width: 54px; height: 54px; border-radius: 18px; font-size: 1.4rem;">
            <i class="bi bi-shield-lock"></i>
        </div>

        <div>
            <h5 class="fw-bold mb-1">Password Information</h5>
            <p class="text-muted small mb-0">
                Enter your current password and choose a new password.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success rounded-4 border-0 fw-semibold mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>
            @SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger rounded-4 border-0 fw-semibold mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ErrorMessage
        </div>
    }

    <EditForm Model="@PasswordModel" OnValidSubmit="OnSubmitHandle">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-4">

            <div class="col-12">
                <label class="form-label fw-semibold">Current Password</label>

                <InputText type="password"
                           class="form-control"
                           placeholder="Enter current password"
                           @bind-Value="PasswordModel.CurrentPassword" />

                <ValidationMessage For="@(() => PasswordModel.CurrentPassword)" />
            </div>

            <div class="col-lg-6 col-md-6">
                <label class="form-label fw-semibold">New Password</label>

                <InputText type="password"
                           class="form-control"
                           placeholder="Enter new password"
                           @bind-Value="PasswordModel.NewPassword" />

                <ValidationMessage For="@(() => PasswordModel.NewPassword)" />
            </div>

            <div class="col-lg-6 col-md-6">
                <label class="form-label fw-semibold">Confirm Password</label>

                <InputText type="password"
                           class="form-control"
                           placeholder="Confirm new password"
                           @bind-Value="PasswordModel.ConfirmNewPassword" />

                <ValidationMessage For="@(() => PasswordModel.ConfirmNewPassword)" />
            </div>

        </div>

        <div class="mt-4 pt-4 border-top d-flex flex-column flex-sm-row gap-2">
            <button type="submit"
                    class="btn btn-health rounded-pill px-4"
                    disabled="@isSaving">

                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Updating...</span>
                }
                else
                {
                    <i class="bi bi-check-circle me-2"></i>
                    <span>Update Password</span>
                }
            </button>

            <NavLink href="/profile"
                     class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-x-circle me-2"></i>
                Cancel
            </NavLink>
        </div>

    </EditForm>

</div>

@code {
    private ChangePasswordDto PasswordModel = new();

    private string? SuccessMessage;
    private string? ErrorMessage;

    private bool isSaving = false;

    private async Task OnSubmitHandle()
    {
        isSaving = true;

        SuccessMessage = null;
        ErrorMessage = null;

        var result = await AuthService.ChangePassword(PasswordModel);

        isSaving = false;

        if (result.IsSuccess)
        {
            SuccessMessage = result.Message;
            NotificationService.Success(result.Message);

            PasswordModel = new();
        }
        else
        {
            ErrorMessage = result.Message;
            NotificationService.Error(result.Message);
            if (result.Message.Contains("session has expired", StringComparison.OrdinalIgnoreCase)
                    || result.Message.Contains("login", StringComparison.OrdinalIgnoreCase))
            {
                NavigationManager.NavigateTo("/login");
            }
        }
    }
}