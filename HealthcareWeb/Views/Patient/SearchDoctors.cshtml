@model List<SharedClasses.Dtos.DoctorDto>
@using SharedClasses.Enums

@{
    ViewBag.Title = "Search Doctors";
    int patientId = ViewBag.PatientId != null ? Convert.ToInt32(ViewBag.PatientId) : 0;
}

<h2 class="text-success">Search Doctors</h2>


@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div class="col-5">
    @using (Html.BeginForm("SearchDoctors", "Patient", FormMethod.Post))
    {
        <input type="hidden" name="patientId" value="@patientId" />

        <div class="mb-2">
            <label class="fw-bold">Specialisation</label>

            @Html.DropDownList(
                "specialisation",
                new SelectList(Enum.GetValues(typeof(Specialisation))),
                "Select Specialisation",
                new { @class = "form-control border-dark" }
            )
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Patient",
                new { patientId = patientId },
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>

@if (Model != null)
{
    <hr />

    <h4>Search Results</h4>

    if (Model.Count == 0)
    {
        <p>No doctors found for the selected specialisation.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Doctor ID</th>
                    <th>Full Name</th>
                    <th>Specialisation</th>
                    <th>Years of Experience</th>
                    <th>Consultation Fee</th>
                    <th>Active</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>
                        <td>@doctor.DoctorId</td>
                        <td>@doctor.FullName</td>
                        <td>@doctor.Specialisation</td>
                        <td>@doctor.YearsOfExperience</td>
                        <td>@doctor.ConsultationFee</td>
                        <td>@doctor.IsActive</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}