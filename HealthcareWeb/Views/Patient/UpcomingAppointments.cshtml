@model List<SharedClasses.Dtos.AppointmentDto>

@{
    ViewBag.Title = "Upcoming Appointments";
    int patientId = ViewBag.PatientId != null ? Convert.ToInt32(ViewBag.PatientId) : 0;
}

<h2 class="text-success">Upcoming Appointments</h2>

<div class="data-section">
    <div class="data-section-header">
        <div class="data-section-title">
            <h4>Upcoming Appointment Schedule</h4>
            <p>Review scheduled consultations and cancel appointments when required.</p>
        </div>

        <div class="data-section-actions">
            @Html.ActionLink(
                "Book Appointment",
                "BookAppointment",
                "Patient",
                new { patientId = patientId },
                new { @class = "btn btn-primary" }
            )

            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Patient",
                new { patientId = patientId },
                new { @class = "btn btn-secondary" }
            )
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state-card">
            <h4>No upcoming appointments</h4>
            <p>You do not currently have any upcoming appointments.</p>
        </div>
    }
    else
    {
        <div class="data-table-card">
            <div class="data-table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Appointment ID</th>
                            <th>Doctor</th>
                            <th>Scheduled Date</th>
                            <th>Slot</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in Model)
                        {
                            string doctorDisplay = string.IsNullOrWhiteSpace(appointment.DoctorName)
                                ? "Doctor #" + appointment.DoctorId
                                : appointment.DoctorName + " (#" + appointment.DoctorId + ")";

                            bool canPatientCancel = appointment.ScheduledDate.Date > DateTime.Today;

                            <tr>
                                <td>@appointment.AppointmentId</td>
                                <td>@doctorDisplay</td>
                                <td>@appointment.ScheduledDate.ToString("dd-MM-yyyy")</td>
                                <td>@appointment.SlotNumber</td>
                                <td>
                                    @if (appointment.Status.ToString() == "Pending")
                                    {
                                        <span class="status-badge status-badge-warning">Pending</span>
                                    }
                                    else if (appointment.Status.ToString() == "Confirmed")
                                    {
                                        <span class="status-badge status-badge-info">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-badge-muted">
                                            @appointment.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="data-table-actions">
                                        @if (canPatientCancel)
                                        {
                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#cancelAppointmentModal_@appointment.AppointmentId">
                                                Cancel
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small-note">
                                                Cancellation closed
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @foreach (var appointment in Model)
                {
                    bool canPatientCancel = appointment.ScheduledDate.Date > DateTime.Today;

                    if (canPatientCancel)
                    {
                        string doctorDisplay = string.IsNullOrWhiteSpace(appointment.DoctorName)
                            ? "Doctor #" + appointment.DoctorId
                            : appointment.DoctorName + " (#" + appointment.DoctorId + ")";

                        <div class="modal fade"
                             id="cancelAppointmentModal_@appointment.AppointmentId"
                             tabindex="-1"
                             aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">

                                    <div class="modal-header">
                                        <h5 class="modal-title">
                                            Confirm Appointment Cancellation
                                        </h5>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                                aria-label="Close">
                                        </button>
                                    </div>

                                    <div class="modal-body">
                                        <p>
                                            Are you sure you want to cancel this appointment?
                                        </p>

                                        <p><strong>Appointment ID:</strong> @appointment.AppointmentId</p>
                                        <p><strong>Doctor:</strong> @doctorDisplay</p>
                                        <p><strong>Scheduled Date:</strong> @appointment.ScheduledDate.ToString("dd-MM-yyyy")</p>
                                        <p><strong>Slot:</strong> @appointment.SlotNumber</p>
                                        <p><strong>Status:</strong> @appointment.Status</p>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">
                                            Keep Appointment
                                        </button>

                                        @Html.ActionLink(
                                            "Cancel Appointment",
                                            "CancelAppointment",
                                            "Patient",
                                            new
                                            {
                                                appointmentId = appointment.AppointmentId,
                                                patientId = patientId
                                            },
                                            new { @class = "btn btn-danger" }
                                        )
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>