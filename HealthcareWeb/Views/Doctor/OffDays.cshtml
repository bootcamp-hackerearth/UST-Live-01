@model List<System.DateTime>

@{
    ViewBag.Title = "Manage Off Days";
    int doctorId = ViewBag.DoctorId;
}

<h2 class="text-success">Manage Off Days</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>
    @Html.ActionLink("Back to Dashboard", "Dashboard", "Doctor", new { doctorId = doctorId }, new { @class = "btn btn-secondary" })
</p>

<div class="col-5">
    <h4>Add Off Day</h4>

    @using (Html.BeginForm("AddOffDay", "Doctor", FormMethod.Post))
    {
        @Html.Hidden("doctorId", doctorId)

        <div class="mb-2">
            <label class="fw-bold">Off Day</label>
            <input type="date" name="offDay" class="form-control border-dark" />
        </div>

        <button type="submit" class="btn btn-primary">Add Off Day</button>
    }
</div>

<hr />

<h4>Existing Off Days</h4>

@if (Model == null || Model.Count == 0)
{
    <p>No off days found.</p>
}
else
{
    <table class="table table-striped table-bordered col-5">
        <thead>
            <tr>
                <th>Date</th>
                <th>Remove</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var offDay in Model)
            {
                <tr>
                    <td>@offDay.ToString("yyyy-MM-dd")</td>
                    <td>
                        @using (Html.BeginForm("RemoveOffDay", "Doctor", FormMethod.Post))
                        {
                            @Html.Hidden("doctorId", doctorId)
                            @Html.Hidden("offDay", offDay.ToString("yyyy-MM-dd"))

                            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}