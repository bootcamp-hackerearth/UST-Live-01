@model List<SharedClasses.Dtos.HealthRecordDto>
@using SharedClasses.Dtos
@using System.Collections.Generic

@{
    ViewBag.Title = "Doctor Health Records";

    int doctorId = ViewBag.DoctorId != null ? Convert.ToInt32(ViewBag.DoctorId) : 0;
    List<AppointmentDto> cancelledAppointments =
        ViewBag.CancelledAppointments as List<AppointmentDto>;
}

<h2 class="text-success">Doctor Health Records</h2>



@if (ViewBag.Doctor != null)
{
    <p>
        <strong>Doctor:</strong> Dr. @ViewBag.Doctor.FullName
    </p>
}

<div class="button-group">
    @Html.ActionLink(
        "Back to Dashboard",
        "Dashboard",
        "Doctor",
        new { doctorId = doctorId },
        new { @class = "btn btn-secondary" }
    )
</div>

@if (Model == null || Model.Count == 0)
{
    <p>No health records found.</p>
}
else
{
    <h4>Health Record History</h4>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Health Record ID</th>
                <th>Patient ID</th>
                <th>Appointment ID</th>
                <th>Visit Date</th>
                <th>Diagnosis</th>
                <th>Prescription</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td>@record.HealthRecordId</td>
                    <td>@record.PatientId</td>
                    <td>@record.AppointmentId</td>
                    <td>@record.VisitDate.ToString("dd-MM-yyyy")</td>
                    <td>@record.Diagnosis</td>
                    <td>@record.Prescription</td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(record.Notes))
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @record.Notes
                        }
                    </td>
                    <td>
                        @Html.ActionLink(
                            "Edit",
                            "EditHealthRecord",
                            "Doctor",
                            new
                            {
                                id = record.HealthRecordId,
                                doctorId = doctorId
                            },
                            new { @class = "btn btn-warning btn-sm" }
                        )
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h4>Cancelled Appointment History</h4>

@if (cancelledAppointments == null || cancelledAppointments.Count == 0)
{
    <p>No cancelled appointments found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Appointment ID</th>
                <th>Patient ID</th>
                <th>Scheduled Date</th>
                <th>Slot Number</th>
                <th>Status</th>
                <th>Cancellation Reason</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var appointment in cancelledAppointments)
            {
                <tr>
                    <td>@appointment.AppointmentId</td>
                    <td>@appointment.PatientId</td>
                    <td>@appointment.ScheduledDate.ToString("dd-MM-yyyy")</td>
                    <td>@appointment.SlotNumber</td>
                    <td>@appointment.Status</td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(appointment.CancellationReason))
                        {
                            <span>-</span>
                        }
                        else
                        {
                            @appointment.CancellationReason
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}