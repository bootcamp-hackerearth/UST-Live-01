@model SharedClasses.Dtos.DoctorDto

@{
    ViewBag.Title = "Doctor Dashboard";
}

<div class="dashboard-hero">
    <div class="dashboard-hero-content">
        <div class="dashboard-kicker">Doctor Portal</div>

        <h2>Welcome, Dr. @Model.FullName</h2>

        <p>
            Manage upcoming appointments, complete consultations, maintain health records, and control your account availability.
        </p>
    </div>
</div>

<div class="profile-summary-card">
    <div class="profile-summary-header">
        <div>
            <h4>Doctor Profile</h4>
            <p>Professional details, practice information, and account status</p>
        </div>

        @if (Model.IsActive)
        {
            <span class="status-pill status-active">Active</span>
        }
        else
        {
            <span class="status-pill status-inactive">Inactive</span>
        }
    </div>

    <div class="profile-summary-grid">
        <div class="profile-field">
            <span>Doctor ID</span>
            <strong>@Model.DoctorId</strong>
        </div>

        <div class="profile-field">
            <span>Name</span>
            <strong>Dr. @Model.FullName</strong>
        </div>

        <div class="profile-field">
            <span>Specialisation</span>
            <strong>@Model.Specialisation</strong>
        </div>

        <div class="profile-field">
            <span>Practice Start Date</span>
            <strong>@Model.PracticeStartDate.ToString("dd-MM-yyyy")</strong>
        </div>

        <div class="profile-field">
            <span>Experience</span>
            <strong>@Model.YearsOfExperience years</strong>
        </div>

        <div class="profile-field">
            <span>Consultation Fee</span>
            <strong>@Model.ConsultationFee</strong>
        </div>
    </div>
</div>

<div class="dashboard-card-grid dashboard-card-grid-three">
    <div class="dashboard-card">
        <div class="dashboard-card-icon"></div>

        <h4>Appointments</h4>

        <p>
            Review upcoming appointments, confirm pending consultations, and complete appointments scheduled for today.
        </p>

        @Html.ActionLink(
            "View Upcoming",
            "UpcomingAppointments",
            "Doctor",
            new { doctorId = Model.DoctorId },
            new { @class = "btn btn-primary" }
        )
    </div>

    <div class="dashboard-card">
        <div class="dashboard-card-icon"></div>

        <h4>Health Records</h4>

        <p>
            View and maintain consultation history, diagnoses, prescriptions, and cancelled appointment history.
        </p>

        @Html.ActionLink(
            "View Records",
            "HealthRecords",
            "Doctor",
            new { doctorId = Model.DoctorId },
            new { @class = "btn btn-primary" }
        )
    </div>

    <div class="dashboard-card">
        <div class="dashboard-card-icon"></div>

        <h4>Availability</h4>

        <p>
            Control whether your account is currently available for appointment bookings.
        </p>

        @if (Model.IsActive)
        {
            <button type="button"
                    class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deactivateSelfModal">
                Deactivate Account
            </button>

            <div class="modal fade"
                 id="deactivateSelfModal"
                 tabindex="-1"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">
                                Confirm Account Deactivation
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>
                        </div>

                        <div class="modal-body">
                            <p>
                                Are you sure you want to deactivate your account?
                            </p>

                            <p>
                                Patients will not be able to book new appointments with you while your account is inactive.
                            </p>

                            <p class="text-danger">
                                This action may fail if you have confirmed appointments scheduled for today.
                            </p>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            @using (Html.BeginForm(
                                "DeactivateSelf",
                                "Doctor",
                                new { doctorId = Model.DoctorId },
                                FormMethod.Post,
                                new { @class = "m-0 d-inline-flex" }))
                            {
                                <button type="submit"
                                        class="btn btn-danger">
                                    Deactivate Account
                                </button>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
        else
        {
            <button type="button"
                    class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#reactivateSelfModal">
                Reactivate Account
            </button>

            <div class="modal fade"
                 id="reactivateSelfModal"
                 tabindex="-1"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">
                                Confirm Account Reactivation
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>
                        </div>

                        <div class="modal-body">
                            <p>
                                Are you sure you want to reactivate your account?
                            </p>

                            <p>
                                Patients will be able to book appointments with you again.
                            </p>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal">
                                    Cancel
                                </button>

                                @using (Html.BeginForm(
                                    "ReactivateSelf",
                                    "Doctor",
                                    new { doctorId = Model.DoctorId },
                                    FormMethod.Post,
                                    new { @class = "m-0 d-inline-flex" }))
                                {
                                    <button type="submit"
                                            class="btn btn-success">
                                        Reactivate Account
                                    </button>
                                }
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

    <div class="dashboard-card">
        <div class="dashboard-card-icon"></div>

        <h4>Session</h4>

        <p>
            Return to the portal home page when your work is complete.
        </p>

        @Html.ActionLink(
            "Logout",
            "Index",
            "Home",
            null,
            new { @class = "btn btn-dark" }
        )
    </div>
</div>