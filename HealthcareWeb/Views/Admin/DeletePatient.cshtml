@model SharedClasses.Dtos.PatientDto

@{
    ViewBag.Title = "Delete Patient";
}

<h2 class="text-danger">Delete Patient</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="col-5">
    <h4>Are you sure you want to delete this patient?</h4>

    <table class="table table-striped table-bordered">
        <tbody>
            <tr>
                <td>Patient ID</td>
                <td>@Model.PatientId</td>
            </tr>
            <tr>
                <td>Full Name</td>
                <td>@Model.FullName</td>
            </tr>
            <tr>
                <td>Date of Birth</td>
                <td>@Model.DateOfBirth.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <td>Gender</td>
                <td>@Model.Gender</td>
            </tr>
            <tr>
                <td>Phone Number</td>
                <td>@Model.PhoneNumber</td>
            </tr>
            <tr>
                <td>Email</td>
                <td>@Model.Email</td>
            </tr>
            <tr>
                <td>Insurance ID</td>
                <td>@Model.InsuranceId</td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm("DeletePatient", "Admin", FormMethod.Post))
    {
        <input type="hidden" name="id" value="@Model.PatientId" />

        <div class="button-group">
            <button type="submit" class="btn btn-danger">
                Delete Patient
            </button>

            @Html.ActionLink(
                "Cancel",
                "Patients",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>
