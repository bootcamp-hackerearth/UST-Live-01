@model List<SharedClasses.Dtos.AppointmentDto>
@using SharedClasses.Enums

@{
    ViewBag.Title = "Appointments";
}

<h2 class="text-success">Appointments</h2>

<div class="data-section">
    <div class="data-section-header">
        <div class="data-section-title">
            <h4>Appointment Register</h4>

            @if (ViewBag.Patient != null)
            {
                <p>Filtered by patient: @ViewBag.Patient.FullName</p>
            }
            else if (ViewBag.Doctor != null)
            {
                <p>Filtered by doctor: Dr. @ViewBag.Doctor.FullName</p>
            }
            else
            {
                <p>Review, update, and manage appointment bookings across the portal.</p>
            }
        </div>

        <div class="data-section-actions">
            @Html.ActionLink(
                "Create Appointment",
                "CreateAppointment",
                "Admin",
                null,
                new { @class = "btn btn-primary" }
            )

            @Html.ActionLink(
                "Back to Dashboard",
                "Index",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    </div>
    @using (Html.BeginForm("Appointments", "Admin", FormMethod.Get))
    {
        <div class="form-panel" style="margin-bottom: 1rem;">
            <div class="form-row-grid">
                <div class="mb-2 form-row-full">
                    <label class="fw-bold">Search Appointments</label>
                    <input type="text"
                           name="query"
                           value="@ViewBag.SearchQuery"
                           class="form-control border-dark"
                           placeholder="Search by patient name, doctor name" />
                </div>
            </div>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                @Html.ActionLink(
                    "Clear",
                    "Appointments",
                    "Admin",
                    null,
                    new { @class = "btn btn-secondary" }
                )
            </div>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state-card">
            <h4>No appointments found</h4>
            <p>There are no appointment records matching this view.</p>
        </div>
    }
    else
    {
        <div class="data-table-card">
            <div class="data-table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Appointment ID</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Scheduled Date</th>
                            <th>Slot</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in Model)
                        {
                            string patientDisplay = string.IsNullOrWhiteSpace(appointment.PatientName)
                                ? "Patient #" + appointment.PatientId
                                : appointment.PatientName + " (#" + appointment.PatientId + ")";

                            string doctorDisplay = string.IsNullOrWhiteSpace(appointment.DoctorName)
                                ? "Doctor #" + appointment.DoctorId
                                : appointment.DoctorName + " (#" + appointment.DoctorId + ")";

                            <tr>
                                <td>@appointment.AppointmentId</td>
                                <td>@patientDisplay</td>
                                <td>@doctorDisplay</td>
                                <td>@appointment.ScheduledDate.ToString("dd-MM-yyyy")</td>
                                <td>@appointment.SlotNumber</td>
                                <td>
                                    @if (appointment.Status.ToString() == "Pending")
                                    {
                                        <span class="status-badge status-badge-warning">Pending</span>
                                    }
                                    else if (appointment.Status.ToString() == "Confirmed")
                                    {
                                        <span class="status-badge status-badge-info">Confirmed</span>
                                    }
                                    else if (appointment.Status.ToString() == "Completed")
                                    {
                                        <span class="status-badge status-badge-success">Completed</span>
                                    }
                                    else if (appointment.Status.ToString() == "Cancelled")
                                    {
                                        <span class="status-badge status-badge-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-badge-muted">
                                            @appointment.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="data-table-actions">
                                        @if (appointment.Status == AppointmentStatus.Pending)
                                        {
                                            @Html.ActionLink(
                                                "Edit",
                                                "EditAppointment",
                                                "Admin",
                                                new { id = appointment.AppointmentId },
                                                new { @class = "btn btn-warning btn-sm" }
                                            )
                                        }
                                        else
                                        {
                                            <span class="text-muted small-note">
                                                Edit locked
                                            </span>
                                        }

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteAppointmentModal_@appointment.AppointmentId">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @foreach (var appointment in Model)
                {
                    string patientDisplay = string.IsNullOrWhiteSpace(appointment.PatientName)
                        ? "Patient #" + appointment.PatientId
                        : appointment.PatientName + " (#" + appointment.PatientId + ")";

                    string doctorDisplay = string.IsNullOrWhiteSpace(appointment.DoctorName)
                        ? "Doctor #" + appointment.DoctorId
                        : appointment.DoctorName + " (#" + appointment.DoctorId + ")";

                    <div class="modal fade"
                         id="deleteAppointmentModal_@appointment.AppointmentId"
                         tabindex="-1"
                         aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        Confirm Appointment Deletion
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    <p>
                                        Are you sure you want to delete this appointment?
                                    </p>

                                    <p><strong>Appointment ID:</strong> @appointment.AppointmentId</p>
                                    <p><strong>Patient:</strong> @patientDisplay</p>
                                    <p><strong>Doctor:</strong> @doctorDisplay</p>
                                    <p><strong>Scheduled Date:</strong> @appointment.ScheduledDate.ToString("dd-MM-yyyy")</p>
                                    <p><strong>Slot:</strong> @appointment.SlotNumber</p>
                                    <p><strong>Status:</strong> @appointment.Status</p>

                                    <p class="text-danger">
                                        This action may fail if the appointment has an associated health record.
                                    </p>
                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Cancel
                                    </button>

                                   @using (Html.BeginForm(
                                        "DeleteAppointment",
                                        "Admin",
                                        new { id = appointment.AppointmentId },
                                        FormMethod.Post,
                                        new { @class = "m-0 d-inline-flex" }))
                                    {
                                        <button type="submit"
                                                class="btn btn-danger">
                                            Delete Appointment
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
        </div>
    }
</div>
