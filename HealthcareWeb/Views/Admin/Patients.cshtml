@model List<SharedClasses.Dtos.PatientDto>

@{
    ViewBag.Title = "Patients";
}

<h2 class="text-success">Patients</h2>

<div class="data-section">
    <div class="data-section-header">
        <div class="data-section-title">
            <h4>Patient Directory</h4>
            <p>View, update, and manage registered patient records.</p>
        </div>

        <div class="data-section-actions">
            @Html.ActionLink(
                "Create Patient",
                "CreatePatient",
                "Admin",
                null,
                new { @class = "btn btn-primary" }
            )

            @Html.ActionLink(
                "Back to Dashboard",
                "Index",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    </div>
    @using (Html.BeginForm("Patients", "Admin", FormMethod.Get))
    {
        <div class="search-panel">
            <input type="text"
                   name="query"
                   value="@ViewBag.SearchQuery"
                   class="form-control"
                   placeholder="Search by patient name" />

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            @Html.ActionLink(
                "Clear",
                "Patients",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state-card">
            <h4>No patients found</h4>
            <p>There are no patient records available yet.</p>
        </div>
    }
    else
    {
<div class="data-table-card">
    <div class="data-table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Patient ID</th>
                    <th>Full Name</th>
                    <th>Date of Birth</th>
                    <th>Gender</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Insurance ID</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>@patient.PatientId</td>
                        <td class="text-left">@patient.FullName</td>
                        <td>@patient.DateOfBirth.ToString("dd-MM-yyyy")</td>
                        <td>
                            <span class="status-badge status-badge-info">
                                @patient.Gender
                            </span>
                        </td>
                        <td>@patient.PhoneNumber</td>
                        <td class="text-left">@patient.Email</td>
                        <td>@patient.InsuranceId</td>
                        <td>
                            <div class="data-table-actions">
                                @Html.ActionLink(
                     "Edit",
                     "EditPatient",
                     "Admin",
                     new { id = patient.PatientId },
                     new { @class = "btn btn-warning btn-sm" }
                 )

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deletePatientModal_@patient.PatientId">
                                    Delete
                                </button>

                                @Html.ActionLink(
                     "Appointments",
                     "AppointmentsByPatient",
                     "Admin",
                     new { patientId = patient.PatientId },
                     new { @class = "btn btn-info btn-sm" }
                 )
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @foreach (var patient in Model)
    {
        <div class="modal fade"
             id="deletePatientModal_@patient.PatientId"
             tabindex="-1"
             aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            Confirm Patient Deletion
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">
                        <p>
                            Are you sure you want to delete this patient?
                        </p>

                        <p>
                            <strong>Patient:</strong>
                            @patient.FullName (#@patient.PatientId)
                        </p>

                        <p class="text-danger">
                            This action may fail if the patient has related appointments or records.
                        </p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        @using (Html.BeginForm(
                            "DeletePatient",
                            "Admin",
                            new { id = patient.PatientId },
                            FormMethod.Post,
                            new { @class = "m-0 d-inline-flex" }))
                            {
                                <button type="submit"
                                        class="btn btn-danger">
                                    Delete Patient
                                </button>
                            }
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
    }
    </div>

