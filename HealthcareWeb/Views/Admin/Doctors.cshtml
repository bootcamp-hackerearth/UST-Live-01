@model List<SharedClasses.Dtos.DoctorDto>

@{
    ViewBag.Title = "Doctors";
}

<h2 class="text-success">Doctors</h2>

<div class="data-section">
    <div class="data-section-header">
        <div class="data-section-title">
            <h4>Doctor Directory</h4>
            <p>Manage doctor profiles, specialisations, consultation fees, and account availability.</p>
        </div>

        <div class="data-section-actions">
            @Html.ActionLink(
                "Create Doctor",
                "CreateDoctor",
                "Admin",
                null,
                new { @class = "btn btn-primary" }
            )

            @Html.ActionLink(
                "Back to Dashboard",
                "Index",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    </div>
    
    @using (Html.BeginForm("Doctors", "Admin", FormMethod.Get))
    {
        <div class="search-panel">
            <input type="text"
                   name="query"
                   value="@ViewBag.SearchQuery"
                   class="form-control"
                   placeholder="Search by doctor name" />

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            @Html.ActionLink(
                "Clear",
                "Doctors",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state-card">
            <h4>No doctors found</h4>
            <p>There are no doctor records available yet.</p>
        </div>
    }
    else
    {
        <div class="data-table-card">
            <div class="data-table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Doctor ID</th>
                            <th>Full Name</th>
                            <th>Specialisation</th>
                            <th>Experience</th>
                            <th>Consultation Fee</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var doctor in Model)
                        {
                            <tr>
                                <td>@doctor.DoctorId</td>
                                <td class="text-left">Dr. @doctor.FullName</td>
                                <td>
                                    <span class="status-badge status-badge-info">
                                        @doctor.Specialisation
                                    </span>
                                </td>
                                <td>@doctor.YearsOfExperience years</td>
                                <td>@doctor.ConsultationFee</td>
                                <td>
                                    @if (doctor.IsActive)
                                    {
                                        <span class="status-badge status-badge-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-badge-danger">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="data-table-actions">
                                        @Html.ActionLink(
                                            "Edit",
                                            "EditDoctor",
                                            "Admin",
                                            new { id = doctor.DoctorId },
                                            new { @class = "btn btn-warning btn-sm" }
                                        )

                                        @if (doctor.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-success btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deactivateDoctorModal_@doctor.DoctorId">
                                                Deactivate
                                            </button>

                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-success btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#reactivateDoctorModal_@doctor.DoctorId">
                                                Reactivate
                                            </button>
                                        }

                                        @Html.ActionLink(
                                            "Appointments",
                                            "AppointmentsByDoctor",
                                            "Admin",
                                            new { doctorId = doctor.DoctorId },
                                            new { @class = "btn btn-info btn-sm" }
                                        )
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @foreach (var doctor in Model)
                {
                    <div class="modal fade"
                         id="deactivateDoctorModal_@doctor.DoctorId"
                         tabindex="-1"
                         aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        Confirm Doctor Deactivation
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    <p>
                                        Are you sure you want to deactivate this doctor?
                                    </p>

                                    <p>
                                        <strong>Doctor:</strong>
                                        Dr. @doctor.FullName (#@doctor.DoctorId)
                                    </p>

                                    <p class="text-danger">
                                        This action may fail if the doctor has confirmed appointments scheduled for today.
                                    </p>
                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Cancel
                                    </button>                            
                                    @using (Html.BeginForm(
                                            "DeactivateDoctor",
                                            "Admin",
                                            new { id = doctor.DoctorId },
                                            FormMethod.Post,
                                            new { @class = "m-0 d-inline-flex" }))
                                        {
                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Deactivate Doctor
                                            </button>
                                        }
                                </div>

                            </div>
                        </div>
                    </div>
                }
                @foreach (var doctor in Model)
                {
                    <div class="modal fade"
                         id="reactivateDoctorModal_@doctor.DoctorId"
                         tabindex="-1"
                         aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        Confirm Doctor Reactivation
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    <p>
                                        Are you sure you want to reactivate this doctor?
                                    </p>

                                    <p>
                                        <strong>Doctor:</strong>
                                        Dr. @doctor.FullName (#@doctor.DoctorId)
                                    </p>

                                    <p>
                                        Patients will be able to book appointments with this doctor again.
                                    </p>
                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Cancel
                                    </button>

                                    @using (Html.BeginForm(
                                        "ReactivateDoctor",
                                        "Admin",
                                        new { id = doctor.DoctorId },
                                        FormMethod.Post,
                                        new { @class = "m-0 d-inline-flex" }))
                                    {
                                        <button type="submit"
                                                class="btn btn-success">
                                            Reactivate Doctor
                                        </button>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>