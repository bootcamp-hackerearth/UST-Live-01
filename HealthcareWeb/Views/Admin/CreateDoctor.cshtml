@model SharedClasses.Dtos.CreateDoctorDto
@using SharedClasses.Enums

@{
    ViewBag.Title = "Create Doctor";
}

<h2 class="text-success">Create Doctor</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="col-5">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-2">
            @Html.LabelFor(m => m.FullName, new { @class = "fw-bold" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control border-dark" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.Specialisation, new { @class = "fw-bold" })
            @Html.EnumDropDownListFor(
                m => m.Specialisation,
                "-- Select Specialisation --",
                new { @class = "form-control border-dark" }
            )
            @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.PracticeStartDate, new { @class = "fw-bold" })
            @Html.TextBoxFor(
                m => m.PracticeStartDate,
                "{0:yyyy-MM-dd}",
                new { @class = "form-control border-dark", type = "date" }
            )
            @Html.ValidationMessageFor(m => m.PracticeStartDate, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.ConsultationFee, new { @class = "fw-bold" })
            @Html.TextBoxFor(
                m => m.ConsultationFee,
                new { @class = "form-control border-dark", type = "number", step = "0.01", min = "0" }
            )
            @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">
                Create Doctor
            </button>

            @Html.ActionLink(
                "Back",
                "Doctors",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>
