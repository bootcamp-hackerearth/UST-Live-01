@model SharedClasses.Dtos.DoctorDto

@{
    ViewBag.Title = "Reactivate Doctor";
}

<h2 class="text-success">Reactivate Doctor</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="col-5">
    <h4>Are you sure you want to reactivate this doctor?</h4>

    <table class="table table-striped table-bordered">
        <tbody>
            <tr>
                <td>Doctor ID</td>
                <td>@Model.DoctorId</td>
            </tr>
            <tr>
                <td>Full Name</td>
                <td>@Model.FullName</td>
            </tr>
            <tr>
                <td>Specialisation</td>
                <td>@Model.Specialisation</td>
            </tr>
            <tr>
                <td>Practice Start Date</td>
                <td>@Model.PracticeStartDate.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <td>Years of Experience</td>
                <td>@Model.YearsOfExperience</td>
            </tr>
            <tr>
                <td>Consultation Fee</td>
                <td>@Model.ConsultationFee</td>
            </tr>
            <tr>
                <td>Active</td>
                <td>@Model.IsActive</td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm("ReactivateDoctor", "Admin", FormMethod.Post))
    {
        <input type="hidden" name="id" value="@Model.DoctorId" />

        <div class="button-group">
            <button type="submit" class="btn btn-success">
                Reactivate Doctor
            </button>

            @Html.ActionLink(
                "Cancel",
                "Doctors",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>