
@model SharedClasses.Dtos.CreatePatientDto
@using SharedClasses.Enums

@{
    ViewBag.Title = "Create Patient";
}

            <h2 class="text-success">Create Patient</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="col-5">
                @using (Html.BeginForm())
                {
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="mb-2">
                        @Html.LabelFor(m => m.FullName, new { @class = "fw-bold" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control border-dark" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-2">
                        @Html.LabelFor(m => m.DateOfBirth, new { @class = "fw-bold" })
                        @Html.TextBoxFor(
                            m => m.DateOfBirth,
                            "{0:yyyy-MM-dd}",
                            new { @class = "form-control border-dark", type = "date" }
                        )
                        @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-2">
                        @Html.LabelFor(m => m.Gender, new { @class = "fw-bold" })

                        <div class="gender-options">
                            <label class="form-check-inline">
                                @Html.RadioButtonFor(m => m.Gender, Gender.Male, new { @class = "form-check-input" })
                                <span class="form-check-label">Male</span>
                            </label>

                            <label class="form-check-inline">
                                @Html.RadioButtonFor(m => m.Gender, Gender.Female, new { @class = "form-check-input" })
                                <span class="form-check-label">Female</span>
                            </label>

                            <label class="form-check-inline">
                                @Html.RadioButtonFor(m => m.Gender, Gender.Other, new { @class = "form-check-input" })
                                <span class="form-check-label">Other</span>
                            </label>
                        </div>

                        @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-2">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "fw-bold" })
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control border-dark" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-2">
                        @Html.LabelFor(m => m.Email, new { @class = "fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-dark", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-2">
                        @Html.LabelFor(m => m.InsuranceId, new { @class = "fw-bold" })
                        @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control border-dark" })
                        @Html.ValidationMessageFor(m => m.InsuranceId, "", new { @class = "text-danger" })
                    </div>

                    <div class="button-group">
                        <button type="submit" class="btn btn-primary">
                            Create Patient
                        </button>

                        @Html.ActionLink(
                            "Back",
                            "Patients",
                            "Admin",
                            null,
                            new { @class = "btn btn-secondary" }
                        )
                    </div>
                }
            </div>
