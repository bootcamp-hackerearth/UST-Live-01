@model SharedClasses.Dtos.AppointmentDto

@{
    ViewBag.Title = "Delete Appointment";
}

<h2 class="text-danger">Delete Appointment</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="col-5">
    <h4>Are you sure you want to delete this appointment?</h4>

    <table class="table table-striped table-bordered">
        <tbody>
            <tr>
                <td>Appointment ID</td>
                <td>@Model.AppointmentId</td>
            </tr>
            <tr>
                <td>Patient ID</td>
                <td>@Model.PatientId</td>
            </tr>
            <tr>
                <td>Doctor ID</td>
                <td>@Model.DoctorId</td>
            </tr>
            <tr>
                <td>Scheduled Date</td>
                <td>@Model.ScheduledDate.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <td>Slot Number</td>
                <td>@Model.SlotNumber</td>
            </tr>
            <tr>
                <td>Status</td>
                <td>@Model.Status</td>
            </tr>
            <tr>
                <td>Cancellation Reason</td>
                <td>@Model.CancellationReason</td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm("DeleteAppointment", "Admin", FormMethod.Post))
    {
        <input type="hidden" name="id" value="@Model.AppointmentId" />

        <div class="button-group">
            <button type="submit" class="btn btn-danger">
                Delete Appointment
            </button>

            @Html.ActionLink(
                "Cancel",
                "Appointments",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>
