@model SharedClasses.Dtos.HealthRecordDto

@{
    ViewBag.Title = "Delete Health Record";
}

<h2 class="text-danger">Delete Health Record</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="col-5">
    <h4>Are you sure you want to delete this health record?</h4>

    <table class="table table-striped table-bordered">
        <tbody>
            <tr>
                <td>Health Record ID</td>
                <td>@Model.HealthRecordId</td>
            </tr>
            <tr>
                <td>Patient ID</td>
                <td>@Model.PatientId</td>
            </tr>
            <tr>
                <td>Doctor ID</td>
                <td>@Model.DoctorId</td>
            </tr>
            <tr>
                <td>Appointment ID</td>
                <td>@Model.AppointmentId</td>
            </tr>
            <tr>
                <td>Visit Date</td>
                <td>@Model.VisitDate.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <td>Diagnosis</td>
                <td>@Model.Diagnosis</td>
            </tr>
            <tr>
                <td>Prescription</td>
                <td>@Model.Prescription</td>
            </tr>
            <tr>
                <td>Notes</td>
                <td>@Model.Notes</td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm("DeleteHealthRecord", "Admin", FormMethod.Post))
    {
        <input type="hidden" name="id" value="@Model.HealthRecordId" />

        <div class="button-group">
            <button type="submit" class="btn btn-danger">
                Delete Health Record
            </button>

            @Html.ActionLink(
                "Cancel",
                "HealthRecords",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>
