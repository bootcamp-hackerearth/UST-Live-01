@model List<SharedClasses.Dtos.HealthRecordDto>

@{
    ViewBag.Title = "Health Records";
}

<h2 class="text-success">Health Records</h2>

<div class="data-section">
    <div class="data-section-header">
        <div class="data-section-title">
            <h4>Health Record Register</h4>
            <p>Review appointment-linked health record summaries and open individual records for full details.</p>
        </div>

        <div class="data-section-actions">
            @Html.ActionLink(
                "Create Health Record",
                "CreateHealthRecord",
                "Admin",
                null,
                new { @class = "btn btn-primary" }
            )

            @Html.ActionLink(
                "Back to Dashboard",
                "Index",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    </div>
    @using (Html.BeginForm("HealthRecords", "Admin", FormMethod.Get))
    {
        <div class="form-panel" style="margin-bottom: 1rem;">
            <div class="form-row-grid">
                <div class="mb-2 form-row-full">
                    <label class="fw-bold">Search Health Records</label>
                    <input type="text"
                           name="query"
                           value="@ViewBag.SearchQuery"
                           class="form-control border-dark"
                           placeholder="Search by patient name, doctor name"/>
                </div>
            </div>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                @Html.ActionLink(
                    "Clear",
                    "HealthRecords",
                    "Admin",
                    null,
                    new { @class = "btn btn-secondary" }
                )
            </div>
        </div>
    }
    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state-card">
            <h4>No health records found</h4>
            <p>There are no health record entries available yet.</p>
        </div>
    }
    else
    {
        <div class="data-table-card">
            <div class="data-table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Record ID</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Appointment ID</th>
                            <th>Visit Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var record in Model)
                        {
                            string patientDisplay = string.IsNullOrWhiteSpace(record.PatientName)
                                ? "Patient #" + record.PatientId
                                : record.PatientName + " (#" + record.PatientId + ")";

                            string doctorDisplay = string.IsNullOrWhiteSpace(record.DoctorName)
                                ? "Doctor #" + record.DoctorId
                                : record.DoctorName + " (#" + record.DoctorId + ")";

                            <tr>
                                <td>@record.HealthRecordId</td>
                                <td>@patientDisplay</td>
                                <td>@doctorDisplay</td>
                                <td>@record.AppointmentId</td>
                                <td>@record.VisitDate.ToString("dd-MM-yyyy")</td>
                                <td>
                                    <div class="data-table-actions">
                                        @Html.ActionLink(
                                            "View",
                                            "HealthRecordDetails",
                                            "Admin",
                                            new { id = record.HealthRecordId },
                                            new { @class = "btn btn-info btn-sm" }
                                        )

                                        @Html.ActionLink(
                                            "Edit",
                                            "EditHealthRecord",
                                            "Admin",
                                            new { id = record.HealthRecordId },
                                            new { @class = "btn btn-warning btn-sm" }
                                        )

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteHealthRecordModal_@record.HealthRecordId">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @foreach (var record in Model)
                {
                    string patientDisplay = string.IsNullOrWhiteSpace(record.PatientName)
                        ? "Patient #" + record.PatientId
                        : record.PatientName + " (#" + record.PatientId + ")";

                    string doctorDisplay = string.IsNullOrWhiteSpace(record.DoctorName)
                        ? "Doctor #" + record.DoctorId
                        : record.DoctorName + " (#" + record.DoctorId + ")";

                    <div class="modal fade"
                         id="deleteHealthRecordModal_@record.HealthRecordId"
                         tabindex="-1"
                         aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        Confirm Health Record Deletion
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    <p>
                                        Are you sure you want to delete this health record?
                                    </p>

                                    <p><strong>Health Record ID:</strong> @record.HealthRecordId</p>
                                    <p><strong>Appointment ID:</strong> @record.AppointmentId</p>
                                    <p><strong>Patient:</strong> @patientDisplay</p>
                                    <p><strong>Doctor:</strong> @doctorDisplay</p>
                                    <p><strong>Visit Date:</strong> @record.VisitDate.ToString("dd-MM-yyyy")</p>

                                    <p class="text-danger">
                                        This action cannot be undone.
                                    </p>
                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Cancel
                                    </button>
                                    @using (Html.BeginForm(
                                            "DeleteHealthRecord",
                                            "Admin",
                                            new { id = record.HealthRecordId },
                                            FormMethod.Post,
                                            new { @class = "m-0 d-inline-flex" }))
                                        {
                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Delete Health Record
                                            </button>
                                        }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
