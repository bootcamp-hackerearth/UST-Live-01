@model SharedClasses.Dtos.UpdateDoctorDto
@using SharedClasses.Enums

@{
    ViewBag.Title = "Edit Doctor";

    string today = DateTime.Today.ToString("yyyy-MM-dd");

    string practiceStartDateValue =
        Model != null && Model.PracticeStartDate.Year >= 1960
            ? Model.PracticeStartDate.ToString("yyyy-MM-dd")
            : "";
}

<h2 class="text-success">Edit Doctor</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="col-5">
    @using (Html.BeginForm())
    {
        <input type="hidden" name="id" value="@Convert.ToInt32(ViewBag.DoctorId)" />

        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="mb-2">
            <label class="fw-bold">Doctor ID</label>
            <input type="text"
                   class="form-control border-dark"
                   value="@ViewBag.DoctorId"
                   readonly="readonly" />
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.FullName, new { @class = "fw-bold" })

            @Html.TextBoxFor(m => m.FullName, new
            {
                @class = "form-control",
                required = "required",
                pattern = @"^[A-Za-z][A-Za-z\s]*$",
                title = "Name should not contain numbers or special characters. Use only letters and spaces.",
                placeholder = "Enter full name"
            })

            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.Specialisation, new { @class = "fw-bold" })

            @Html.EnumDropDownListFor(
                m => m.Specialisation,
                "-- Select Specialisation --",
                new { @class = "form-control border-dark" }
            )

            @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.PracticeStartDate, new { @class = "fw-bold" })

            <input type="date"
                   name="PracticeStartDate"
                   value="@practiceStartDateValue"
                   class="form-control border-dark"
                   required="required"
                   min="1960-01-01"
                   max="@today"
                   title="Practice start date must be between 01-01-1960 and today." />

            @Html.ValidationMessageFor(m => m.PracticeStartDate, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.ConsultationFee, new { @class = "fw-bold" })

            @Html.TextBoxFor(
                m => m.ConsultationFee,
                new
                {
                    @class = "form-control border-dark",
                    type = "number",
                    step = "0.01",
                    min = "0"
                }
            )

            @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            <label class="fw-bold">Active</label>

            <div>
                @Html.CheckBoxFor(m => m.IsActive)
            </div>

            @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">
                Update Doctor
            </button>

            @Html.ActionLink(
                "Back",
                "Doctors",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>