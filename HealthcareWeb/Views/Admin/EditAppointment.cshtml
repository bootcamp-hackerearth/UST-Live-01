@model SharedClasses.Dtos.UpdateAppointmentDto
@using SharedClasses.Dtos

@{
    ViewBag.Title = "Edit Appointment";

    var patients = ViewBag.Patients as List<PatientDto>;
    var doctors = ViewBag.Doctors as List<DoctorDto>;
}

<h2 class="text-success">Edit Appointment</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="col-5">
    @using (Html.BeginForm())
    {
        <input type="hidden" name="id" value="@Convert.ToInt32(ViewBag.AppointmentId)" />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-2">
            <label class="fw-bold">Appointment ID</label>
            <input type="text"
                   class="form-control border-dark"
                   value="@ViewBag.AppointmentId"
                   readonly="readonly" />
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.PatientId, new { @class = "fw-bold" })
            @Html.DropDownListFor(
                m => m.PatientId,
                patients != null
                    ? new SelectList(patients, "PatientId", "FullName", Model.PatientId)
                    : Enumerable.Empty<SelectListItem>(),
                "-- Select Patient --",
                new { @class = "form-control border-dark" }
            )
            @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.DoctorId, new { @class = "fw-bold" })
            @Html.DropDownListFor(
                m => m.DoctorId,
                doctors != null
                    ? new SelectList(doctors, "DoctorId", "FullName", Model.DoctorId)
                    : Enumerable.Empty<SelectListItem>(),
                "-- Select Doctor --",
                new { @class = "form-control border-dark" }
            )
            @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.ScheduledDate, new { @class = "fw-bold" })
            @Html.TextBoxFor(
                m => m.ScheduledDate,
                "{0:yyyy-MM-dd}",
                new { @class = "form-control border-dark", type = "date" }
            )
            @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.SlotNumber, new { @class = "fw-bold" })
            @Html.TextBoxFor(
                m => m.SlotNumber,
                new { @class = "form-control border-dark", type = "number", min = "1", max = "10" }
            )
            @Html.ValidationMessageFor(m => m.SlotNumber, "", new { @class = "text-danger" })
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">
                Update Appointment
            </button>

            @Html.ActionLink(
                "Back",
                "Appointments",
                "Admin",
                null,
                new { @class = "btn btn-secondary" }
            )
        </div>
    }
</div>