{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "AppUrls": {
    "AngularUrl": "http://localhost:4200"
  },

  "Jwt": {
    "Issuer": "HealthApp.Api",
    "Audience": "HealthApp.Blazor",
    "key": "",
    "AccessTokenExpirationMinutes": 30
  },

  "DoctorSettings": {
    "TemporaryPassword": ""
  },



  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },



    "WriteTo": [
      { "Name": "Console" },

      {
        "Name": "File",
        "Args": {
          "path": "Logs/healthaxis-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,

          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }

    ],

    "Enrich": [ "FromLogContext" ],

    "Properties": {
      "Application": "HealthAxis API"
    }

  },

  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "AppointmentBookedQueue": "appointment-booked-queue"

  }

}