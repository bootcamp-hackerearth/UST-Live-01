{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "HealthApp.Api",
    "Audience": "HealthApp.Client",
    "Key": "0e90cb7bc2d680adb4cbb8b39f00599db958f1303d7e3c6c4a20732540a70f18",
    "AccessTokenExpirationMinutes": 15
  },

  "Garnet": {
    "ConnectionString": "127.0.0.1:6379",
    "InstanceName": "HealthApp:"
  },

  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "TestQueue": "healthapp-test-queue",
    "AppointmentBookedQueue": "appointment-booked-queue",
    "AppointmentCancelledByDoctorLeaveQueue": "appointment-cancelled-by-doctor-leave-queue"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Elastic.Serilog.Sinks"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/healthapp-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "bootstrapMethod": "Silent",
          "nodes": [
            "http://localhost:9200"
          ],
          "useSniffing": false,
          "dataStream": "logs-healthapp-api-default",
          "includeHost": true,
          "includeProcess": true,
          "includeActivity": true,
          "debugMode": false
        }
      }
    ],

    "Enrich": [
      "FromLogContext"
    ],

    "Properties": {
      "Application": "HealthApp.Api",
      "Environment": "Development"
    }
  }
}