{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "AppUrls": {
    "AngularUrl": "http://localhost:4200"
  },

  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },



  "Jwt": {
    "Issuer": "HealthApp.Api",
    "Audience": "HealthApp.Blazor",
    "key": "0e90cb7bc2d680adb4cbb8b39f00599db958f1303d7e3c6c4a20732540a70f18",
    "AccessTokenExpirationMinutes": 30
  },

  "DoctorSettings": {
    "TemporaryPassword": "Doctor@01"
  },



  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Elastic.Serilog.Sinks"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },



    "WriteTo": [
      { "Name": "Console" },

      {
        "Name": "File",
        "Args": {
          "path": "Logs/healthaxis-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,

          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodes": [
            "http://localhost:9200"
          ]
        }
      }


    ],

    "Enrich": [ "FromLogContext" ],

    "Properties": {
      "Application": "HealthAxis API"
    }

  },

  "Garnet": {
    "ConnectionStrings": "Localhost:6379",
    "InstanceName": "HealthApp:"
  },

  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "HealthcareQueueName": "HealthcareQueue"

  }

}