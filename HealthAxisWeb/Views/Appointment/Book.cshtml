@model HealthAxis.Shared.Dtos.BookAppointmentDto
@using HealthAxis.Shared.Dtos

<style>
    body {
        background-color: #0f172a;
        color: white;
    }

    .card-dark {
        background: #1e293b;
        padding: 20px;
        border-radius: 10px;
    }

    .btn-beige {
        background: #f5f5dc;
        color: black;
    }
</style>

<h2>Book Appointment</h2>

<div class="card-dark">

    @if (ViewBag.Error != null)
    {
        <div class="text-danger">
            @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("Book", "Appointment", FormMethod.Post))
    {
        @Html.HiddenFor(x => x.PatientId)

        <div class="form-group">
            <label>Specialisation</label>
            <select id="spec" name="Specialisation" class="form-control">
                <option value="">Select Specialisation</option>
                @foreach (var spec in Enum.GetValues(typeof(Specialisation)))
                {
                    <option value="@spec">@spec</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Doctor</label>
            <select name="DoctorId" id="doctor" class="form-control">
                <option value="">Select Doctor</option>
            </select>
        </div>

        <div class="form-group">
            <label>Date</label>
            <input type="date"
                   id="date"
                   name="ScheduledDate"
                   class="form-control"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="form-group">
            <label>Time Slot</label>
            <select name="TimeSlot" id="slot" class="form-control" disabled>
                <option value="">Select Doctor & Date</option>
            </select>
        </div>

        <br />

        <button type="submit" class="btn btn-beige">Book</button>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    }
</div>

<script>

    function loadDoctors() {
        let spec = document.getElementById("spec").value;
        let dropdown = document.getElementById("doctor");

        dropdown.innerHTML = "<option value=''>Select Doctor</option>";

        if (!spec) return;

        fetch('/Doctor/GetBySpecialisation?spec=' + spec)
            .then(res => res.json())
            .then(data => {

                if (data.length === 0) {
                    dropdown.innerHTML = "<option>No doctors available</option>";
                    return;
                }

                data.forEach(d => {
                    dropdown.innerHTML += `<option value="${d.DoctorId}">
                        ${d.FullName}
                    </option>`;
                });
            });
    }

    function checkEnableSlot() {

        let doctor = document.getElementById("doctor").value;
        let date = document.getElementById("date").value;
        let slot = document.getElementById("slot");

        if (doctor && date) {
            slot.disabled = false;
            loadSlots();
        } else {
            slot.disabled = true;
            slot.innerHTML = "<option value=''>Select Doctor & Date</option>";
        }
    }

    function loadSlots() {

        let doctor = document.getElementById("doctor").value;
        let date = document.getElementById("date").value;

        if (!doctor || !date) return;

        fetch(`/Appointment/GetSlots?doctorId=${doctor}&date=${date}`)
            .then(res => res.json())
            .then(data => {

                let slotDropdown = document.getElementById("slot");
                slotDropdown.innerHTML = "<option value=''>Select Slot</option>";

                data.forEach(s => {
                    slotDropdown.innerHTML += `<option value="${s}">${s}</option>`;
                });
            });
    }

    function validateForm() {

        let spec = document.getElementById("spec").value;
        let doctor = document.getElementById("doctor").value;
        let date = document.getElementById("date").value;
        let slot = document.getElementById("slot").value;

        if (!spec) {
            alert("Select Specialisation");
            return false;
        }

        if (!doctor) {
            alert("Select Doctor");
            return false;
        }

        if (!date) {
            alert("Select Date");
            return false;
        }

        if (!slot) {
            alert("Select Time Slot");
            return false;
        }

        return true;
    }

    document.getElementById("spec").addEventListener("change", loadDoctors);
    document.getElementById("doctor").addEventListener("change", checkEnableSlot);
    document.getElementById("date").addEventListener("change", checkEnableSlot);

</script>