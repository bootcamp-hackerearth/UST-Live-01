@model List<HealthAxis.Shared.Dtos.AppointmentDto> 
@using HealthAxis.Shared.Dtos

<style>
    body {
        background: #111827;
        color: #e5e7eb;
        font-family: 'Segoe UI';
        margin: 0;
    }

    .container {
        padding: 30px;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .add-btn {
        background: #10b981;
        padding: 10px 16px;
        border-radius: 10px;
        color: white;
        text-decoration: none;
        font-weight: 500;
    }

        .add-btn:hover {
            background: #059669;
        }

    .main-card {
        background: #1f2937;
        padding: 25px;
        border-radius: 14px;
        margin-top: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    th {
        text-align: left;
        color: #9ca3af;
        font-size: 13px;
        font-weight: 500;
        padding-bottom: 10px;
    }

    td {
        padding: 14px 0;
        border-top: 1px solid #374151;
        vertical-align: middle;
    }

    tr:hover {
        background: #2a3441;
    }

    .doctor-name {
        font-weight: 600;
        font-size: 15px;
    }

    .sub-text {
        color: #9ca3af;
        font-size: 12px;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 500;
    }

    .pending {
        background: rgba(245,158,11,0.15);
        color: #f59e0b;
    }

    .confirmed {
        background: rgba(16,185,129,0.15);
        color: #10b981;
    }

    .cancelled {
        background: rgba(239,68,68,0.15);
        color: #ef4444;
    }

    .completed {
        background: rgba(59,130,246,0.15);
        color: #3b82f6;
    }

    .cancel-btn {
        background: transparent;
        border: none;
        color: #ef4444;
        cursor: pointer;
        font-size: 13px;
    }

        .cancel-btn:hover {
            text-decoration: underline;
        }

    .back-btn {
        background: #374151;
        padding: 10px 16px;
        border-radius: 10px;
        color: #e5e7eb;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

        .back-btn:hover {
            background: #4b5563;
        }
</style>

<div class="container">

    <div class="header">
        <h2 style="color:#1f2937">My Appointments</h2>

        <a href="@Url.Action("Book", "Appointment", new { patientId = ViewBag.PatientId })"
           class="add-btn">
            + Book Appointment
        </a>

    </div>

    <div class="main-card">

        <table>
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Count > 0)
                {
                    foreach (var a in Model)
                    {
                        <tr>

                            <td>@a.DoctorName</td>

                            <td>@a.ScheduledDate.ToString("dd MMM yyyy")</td>

                            <td>@a.TimeSlot</td>

                            <td>
                                @if (a.Status == AppointmentStatus.Pending)
                                {
                                    <span class="badge pending">Pending</span>
                                }
                                else if (a.Status == AppointmentStatus.Confirmed)
                                {
                                    <span class="badge confirmed">Confirmed</span>
                                }
                                else if (a.Status == AppointmentStatus.Completed)
                                {
                                    <span class="badge completed">Completed</span>
                                }
                                else if (a.Status == AppointmentStatus.Cancelled)
                                {
                                    <div>
                                        <span class="badge cancelled">
                                            @(a.CancelledBy == "Doctor"
                                            ? "Cancelled by Doctor"
                                            : "Cancelled by Patient")
                                        </span>

                                        @if (!string.IsNullOrEmpty(a.CancellationReason))
                                        {
                                            <div style="font-size:12px; color:#9ca3af; margin-top:5px;">
                                                Reason: @a.CancellationReason
                                            </div>
                                        }
                                    </div>
                                }
                            </td>

                            <td>
                                @if (a.Status == AppointmentStatus.Pending)
                                {
                                    <button class="cancel-btn"
                                            onclick="cancelAppointment(@a.AppointmentId, 'Patient')">
                                        Cancel
                                    </button>
                                }
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="sub-text">
                            No appointments found
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>

</div>

<script>
    function cancelAppointment(id, role) {

        let reason = prompt("Enter cancellation reason:");
        if (!reason) return;

        fetch('/Appointment/UpdateStatus/' + id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                Status: "Cancelled",
                CancellationReason: reason,
                CancelledBy: role
            })
        })
            .then(res => {
                if (!res.ok) {
                    alert("Error cancelling appointment");
                } else {
                    location.reload();
                }
            });
    }
</script>