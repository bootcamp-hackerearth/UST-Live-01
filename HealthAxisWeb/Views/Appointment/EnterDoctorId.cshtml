@{
    ViewBag.Title = "View Appointments";
}

<div class="container mt-5">

    <!-- Heading -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">View Doctor Appointments</h2>
        <p class="text-muted">Enter Doctor ID to view appointments</p>
    </div>

    <!-- Card -->
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 400px;">

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("ByDoctor", "Appointment"))
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">Doctor ID</label>
                <input type="number" name="id" class="form-control" placeholder="Enter Doctor ID" required />
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-between mt-3">
                <a href="@Url.Action("Index","Doctor")"
                   class="btn btn-outline-secondary rounded-pill px-4">
                    Back
                </a>

                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    View
                </button>
            </div>
        }
    </div>

</div>