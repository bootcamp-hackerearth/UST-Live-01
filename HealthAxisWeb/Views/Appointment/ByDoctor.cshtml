@model List<HealthAxis.Shared.Dtos.AppointmentDto>

<h2>Doctor Appointments</h2>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}

<table class="table">
    <tr>
        <th>ID</th>
        <th>PatientId</th>
        <th>Date</th>
        <th>Slot</th>
        <th>Status</th>
        <th>Actions</th>
        <th>Health Record</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AppointmentId</td>
            <td>@item.PatientId</td>
            <td>@item.ScheduledDate.ToShortDateString()</td>
            <td>@item.TimeSlot</td>
            <td>@item.Status</td>

            <td>
                @if (item.Status == HealthAxis.Shared.Dtos.AppointmentStatus.Pending)
                {
                    <a href="@Url.Action("Confirm", "Appointment", new { id = item.AppointmentId })">Confirm</a>
                }

                @if (item.Status == HealthAxis.Shared.Dtos.AppointmentStatus.Confirmed)
                {
                    <a href="@Url.Action("Complete", "Appointment", new { id = item.AppointmentId })">Complete</a>
                }

                @if (item.Status == HealthAxis.Shared.Dtos.AppointmentStatus.Pending ||
                     item.Status == HealthAxis.Shared.Dtos.AppointmentStatus.Confirmed)
                {
                    <a href="@Url.Action("Cancel", "Appointment", new { id = item.AppointmentId })">Cancel</a>
                }
            </td>

            <td>
                @if (item.Status == HealthAxis.Shared.Dtos.AppointmentStatus.Completed && item.CanAddHealthRecord)
                {
                    <a href="@Url.Action("Create", "HealthRecord", new { appointmentId = item.AppointmentId })">
                        Add Record
                    </a>
                }
                else
                {
                    <span style="color:gray">Not Available</span>
                }
            </td>
        </tr>
    }
</table>

<a href="@Url.Action("Index", "Doctor")">Back</a>