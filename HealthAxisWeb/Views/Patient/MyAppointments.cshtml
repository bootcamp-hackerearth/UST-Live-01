@model List<HealthAxis.Shared.Dtos.AppointmentDto>

<h2>My Appointments</h2>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Doctor</th>
        <th>Date</th>
        <th>Slot</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var a in Model)
    {
        <tr>
            <td>@a.AppointmentId</td>
            <td>@a.DoctorId</td>
            <td>@a.ScheduledDate.ToShortDateString()</td>
            <td>@a.TimeSlot</td>
            <td>@a.Status</td>

            <td>
                @if (a.Status == HealthAxis.Shared.Dtos.AppointmentStatus.Pending ||
                     a.Status == HealthAxis.Shared.Dtos.AppointmentStatus.Confirmed)
                {
                    @Html.ActionLink("Cancel", "CancelAppointment", "Patient", new { id = a.AppointmentId }, null)
                }
                else
                {
                    <span style="color:gray">Not Allowed</span>
                }
            </td>
        </tr>
    }
</table>

@Html.ActionLink("Back", "Index","Patient")