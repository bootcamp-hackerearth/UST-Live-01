@model List<HealthAxis.Shared.Dtos.HealthRecordDto> 

<h2 > Health Records </ h2 >

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}
else if (Model != null && Model.Count > 0)
{
    <table class="table">
        <tr>
            <th>Date</th>
            <th>Diagnosis</th>
            <th>Prescription</th>
            <th>Notes</th>
        </tr>

        @foreach (var r in Model)
        {
            <tr>
                <td>@r.VisitDate</td>
                <td>@r.Diagnosis</td>
                <td>@r.Prescription</td>
                <td>@r.Notes</td>
            </tr>
        }
    </table>
}
else
{
    <p style="color:red">No health records found</p>
}

<br />

@Html.ActionLink("Back", "Profile", "Patient")