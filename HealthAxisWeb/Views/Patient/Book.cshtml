@model HealthAxis.Shared.Dtos.BookAppointmentDto

    
<h2>HealthAxis</h2>

<p style="color:red">@ViewBag.Error</p>
<p style="color:green">@TempData["Success"]</p>

@using (Html.BeginForm())
{
    <div>
        Patient ID:
        @Html.TextBoxFor(m => m.PatientId, new { @readonly = "readonly" })
    </div>

    <div>
        Specialisation:
        @Html.EnumDropDownListFor(m => m.Specialisation)
    </div>

    <div>
        Doctor ID:
        @Html.TextBoxFor(m => m.DoctorId)
    </div>

    <div>
        Date:
        @Html.TextBoxFor(m => m.ScheduledDate, new { type = "date" })
    </div>

    <div>
        Slot:
        @Html.DropDownListFor(m => m.TimeSlot,
            new SelectList(new[]
            {
                "9:00 - 10:00 AM",
                "10:00 - 11:00 AM",
                "11:00 - 12:00 PM",
                "2:00 - 3:00 PM",
                "3:00 - 4:00 PM"
            }))
    </div>

    <br />

    <button type="submit">Book</button>
}

<br />

@Html.ActionLink("Back", "Profile", "Patient", new { id = Model.PatientId }, null)