@model HealthAxis.Shared.Dtos.CreatePatientDto

<style>
    .page-container {
        max-width: 600px;
        margin: 40px auto;
    }

    .card {
        background: #1f2937;
        padding: 30px;
        border-radius: 16px;
        color: #e5e7eb;
    }

    h2 {
        margin-bottom: 20px;
    }

    .form-wrapper {
        max-width: 450px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    input, select {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        border: none;
        background: #374151;
        color: white;
        font-size: 14px;
    }

        input:focus, select:focus {
            outline: none;
            background: #4b5563;
        }

    .validation {
        color: #ef4444;
        font-size: 13px;
    }

    .btn-group {
        display: flex;
        justify-content: space-between;
        margin-top: 25px;
    }

    .btn-save {
        background: #10b981;
        padding: 10px 20px;
        border-radius: 10px;
        border: none;
        color: white;
        cursor: pointer;
    }

    .btn-back {
        background: #374151;
        padding: 10px 20px;
        border-radius: 10px;
        text-decoration: none;
        color: white;
    }

        .btn-back:hover {
            background: #4b5563;
        }
</style>

<div class="page-container">

    <div class="card">

        <h2>Add Patient</h2>

        @if (ViewBag.Error != null)
        {
            <div class="validation">
                @ViewBag.Error
            </div>
        }

    <div class="form-wrapper">

        @using (Html.BeginForm("Create", "Patient", FormMethod.Post))
        {
            @Html.ValidationSummary(true, "", new { @class = "validation" })

            <div class="form-group">
                @Html.TextBoxFor(m => m.FullName, new { placeholder = "Full Name" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                @Html.TextBoxFor(m => m.DateOfBirth,
                new
                     {
                    type = "date",
                    max = DateTime.Now.ToString("yyyy-MM-dd"),
                    placeholder = "yyyy-MM-dd",
                    required = "required"
                })

            </div>

            <div class="form-group">
                @Html.DropDownListFor(m => m.Gender,
                    new SelectList(new[] { "Male", "Female", "Other" }),
                    "Select Gender")
                @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                @Html.TextBoxFor(m => m.PhoneNumber,
                    new { placeholder = "Phone Number" })
                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                @Html.TextBoxFor(m => m.Email,
                    new { type = "email", placeholder = "Email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                @Html.TextBoxFor(m => m.InsuranceId,
                    new { placeholder = "Insurance ID (Optional)" })
                @Html.ValidationMessageFor(m => m.InsuranceId, "", new { @class = "validation" })
            </div>

            <div class="btn-group">
                <a href="@Url.Action("Index", "Patient")" class="btn-back">
                    ← Back
                </a>

                <button type="submit" class="btn-save">
                    Add Patient
                </button>
            </div>
        }

    </div>

    </div>

</div>