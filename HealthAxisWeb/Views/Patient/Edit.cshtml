@model HealthAxis.Shared.Dtos.PatientDto

<h2>Edit Patient</h2>

<form method="post">
    @Html.HiddenFor(x => x.PatientId)

    <div class="form-group">
        <label>Name</label>
        @Html.TextBoxFor(x => x.FullName, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>DOB</label>
        @Html.TextBoxFor(x => x.DateOfBirth, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Gender</label>
        @Html.TextBoxFor(x => x.Gender, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Phone</label>
        @Html.TextBoxFor(x => x.PhoneNumber, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Email</label>
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary mt-3">Update</button>
</form>