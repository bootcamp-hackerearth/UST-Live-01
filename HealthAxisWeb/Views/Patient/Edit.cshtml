@model HealthAxis.Shared.Dtos.PatientDto

<h2>Edit Patient</h2>

@using (Html.BeginForm("Edit", "Patient", FormMethod.Post))
{
    @Html.HiddenFor(m => m.PatientId)

    <div>
        Patient ID:
        @Html.TextBoxFor(m => m.PatientId, new { @readonly = "readonly" })
    </div>

    <div>
        Name: @Html.TextBoxFor(m => m.FullName)
    </div>

    <div>
        DOB: @Html.TextBoxFor(m => m.DateOfBirth, new { type = "date" })
    </div>

    <div>
        Gender:
        @Html.RadioButtonFor(m => m.Gender, "Male") Male
        @Html.RadioButtonFor(m => m.Gender, "Female") Female
        @Html.RadioButtonFor(m => m.Gender, "Other") Other
    </div>

    <div>
        Phone: @Html.TextBoxFor(m => m.PhoneNumber)
    </div>

    <div>
        Email: @Html.TextBoxFor(m => m.Email)
    </div>

    <div>
        Insurance: @Html.TextBoxFor(m => m.InsuranceId)
    </div>

    <div>
        Active: @Html.CheckBoxFor(m => m.IsActive)
        <small>(Uncheck to deactivate patient)</small>
    </div>

    <br />

    <button type="submit">Update</button>
}

<br />

@Html.ActionLink("Back", "Profile", new { id = Model.PatientId })