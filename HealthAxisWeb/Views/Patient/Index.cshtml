@model List<HealthAxis.Shared.Dtos.PatientDto>

<style>
    body {
        background: #111827;
        color: #e5e7eb;
        font-family: 'Segoe UI';
        margin: 0;
    }

    .container {
        padding: 30px;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .add-btn {
        background: #1f2937;
        padding: 10px 15px;
        border-radius: 10px;
        color: white;
        text-decoration: none;
    }

    .card-box {
        display: flex;
        gap: 20px;
        margin: 20px 0;
    }

    .stat-card {
        background: #1f2937;
        padding: 20px;
        border-radius: 12px;
        flex: 1;
    }

        .stat-card h4 {
            color: #9ca3af;
        }

    .main-card {
        background: #1f2937;
        padding: 20px;
        border-radius: 12px;
    }

    table {
        width: 100%;
        margin-top: 20px;
    }

    th {
        text-align: left;
        color: #9ca3af;
    }

    td {
        padding: 12px 0;
        border-top: 1px solid #374151;
    }

    .badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .active-badge {
        background: #065f46;
        color: #10b981;
    }

    .inactive-badge {
        background: #7f1d1d;
        color: #ef4444;
    }

    .insured-badge {
        background: #1e40af;
        color: #60a5fa;
    }

    .filter-dropdown {
        height: 38px;
        padding: 8px 10px;
        border-radius: 8px;
        background: #374151;
        color: white;
        border: none;
    }
</style>

<div class="container">

    <div class="header">
        <h2 style="color:#1f2937;">Patient Management</h2>

        <a href="@Url.Action("Create", "Patient")" class="add-btn">
            + Add Patient
        </a>

    </div>

    <div class="card-box">
        <div class="stat-card">
            <h4>Total Patients</h4>
            <h2>@ViewBag.Total</h2>
        </div>

        <div class="stat-card">
            <h4>Active</h4>
            <h2>@ViewBag.Active</h2>
        </div>

        <div class="stat-card">
            <h4>Insured</h4>
            <h2>@ViewBag.Insured</h2>
        </div>
    </div>

    <div class="main-card">

        <form method="get" style="display:flex; gap:15px; margin-bottom:15px;">

            <select name="sort" onchange="this.form.submit()" class="filter-dropdown">
                <option value="">Sort by Name</option>
                <option value="asc">A-Z</option>
                <option value="desc">Z-A</option>
            </select>

            <select name="insured" onchange="this.form.submit()" class="filter-dropdown">
                <option value="">All</option>
                <option value="true">Insured</option>
                <option value="false">Not Insured</option>
            </select>

        </form>
        

        <table>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Age</th>
                    <th>Gender</th>
                    <th>Phone</th>
                    <th>Insurance</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <strong>@p.FullName</strong><br />
                            <small>ID: @p.PatientId</small>
                        </td>

                        <td>@p.Age</td>

                        <td>@p.Gender</td>
                        <td>@p.PhoneNumber</td>

                        <td>
                            @if (!string.IsNullOrEmpty(p.InsuranceId))
                            {
                                <span class="badge insured-badge">Insured</span>
                            }
                            else
                            {
                                <span>Not Insured</span>
                            }
                        </td>

                        <td>
                            <span class="badge @(p.IsActive ? "active-badge" : "inactive-badge")">
                                @(p.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <td>
                            <a href="@Url.Action("Details", "Patient", new { id = p.PatientId })">
                                👁
                            </a>
                        </td>

                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
