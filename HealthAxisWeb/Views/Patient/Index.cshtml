@model IEnumerable<HealthAxis.Shared.Dtos.PatientDto>

@{
    ViewBag.Title = "Patients";
    var sort = Request["sort"];
    var insurance = Request["insurance"];
}

<style>
    body {
        background-color: #0f172a;
        color: white;
    }

    .card-dark {
        background-color: #1e293b;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .badge-active {
        background-color: #22c55e;
    }

    .badge-inactive {
        background-color: #ef4444;
    }

    .badge-insured {
        background-color: #3b82f6;
    }

    .btn-beige {
        background-color: #f5f5dc;
        color: #000;
        border: none;
    }

        .btn-beige:hover {
            background-color: #e6e0c5;
        }
</style>

<h2>Patients</h2>

<div class="row">
    <div class="col-md-3">
        <div class="card-dark">
            <h4>@Model.Count()</h4>
            <p>Total Patients</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card-dark">
            <h4>@Model.Count(x => x.IsActive)</h4>
            <p>Active Patients</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card-dark">
            <h4>@Model.Count(x => !string.IsNullOrEmpty(x.InsuranceId))</h4>
            <p>Insured</p>
        </div>
    </div>
</div>

<a href="@Url.Action("Create")" class="btn btn-primary mb-3">+ Add Patient</a>

<form method="get" id="filterForm" class="mb-3">
    <div class="row">

        <div class="col-md-3">
            <select name="sort" class="form-control"
                    onchange="document.getElementById('filterForm').submit();">
                <option value="">Sort by Name</option>
                <option value="asc" @(sort == "asc" ? "selected" : "")>A-Z</option>
                <option value="desc" @(sort == "desc" ? "selected" : "")>Z-A</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="insurance" class="form-control"
                    onchange="document.getElementById('filterForm').submit();">
                <option value="">All</option>
                <option value="insured" @(insurance == "insured" ? "selected" : "")>Insured</option>
                <option value="not" @(insurance == "not" ? "selected" : "")>Not Insured</option>
            </select>
        </div>

    </div>
</form>

@{
    var patients = Model;

    if (sort == "asc")
    {
        patients = patients.OrderBy(p => p.FullName).ToList();
    }
    else if (sort == "desc")
    {
        patients = patients.OrderByDescending(p => p.FullName).ToList();
    }

    if (insurance == "insured")
    {
        patients = patients.Where(p => !string.IsNullOrEmpty(p.InsuranceId)).ToList();
    }
    else if (insurance == "not")
    {
        patients = patients.Where(p => string.IsNullOrEmpty(p.InsuranceId)).ToList();
    }
}

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Insurance</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in patients)
        {
            var age = DateTime.Now.Year - p.DateOfBirth.Year;

            <tr>
                <td>@p.FullName</td>
                <td>@age</td>
                <td>@p.Gender</td>
                <td>@p.PhoneNumber</td>

                <td>
                    @if (!string.IsNullOrEmpty(p.InsuranceId))
                    {
                        <span class="badge badge-insured">Yes</span>
                    }
                    else
                    {
                        <span>No</span>
                    }
                </td>

                <td>
                    @if (p.IsActive)
                    {
                        <span class="badge badge-active">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-inactive">Inactive</span>
                    }
                </td>

                <td>
                    <a href="@Url.Action("Details", "Patient", new { id = p.PatientId })"
                       class="btn btn-sm btn-beige">View</a>

                    @if (p.IsActive)
                    {
                        <a href="@Url.Action("Deactivate", "Patient", new { id = p.PatientId })"
                           class="btn btn-sm btn-beige">Deactivate</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>