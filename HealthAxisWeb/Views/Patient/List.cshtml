@model List<HealthAxis.Shared.Dtos.PatientDto>

<h2>Patients</h2>

<table class="table">
    <tr>
        <th>Name</th>
        <th>DOB</th>
        <th>Gender</th>
        <th>Phone</th>
        <th>Actions</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.FullName</td>
            <td>@p.DateOfBirth?.ToShortDateString()</td>
            <td>@p.Gender</td>
            <td>@p.PhoneNumber</td>

            <td>
                @Html.ActionLink("Edit", "Edit",
                    new { id = p.PatientId },
                    new { @class = "btn btn-sm btn-primary" })
            </td>
        </tr>
    }
</table>
