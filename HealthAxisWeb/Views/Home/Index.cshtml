@{
    ViewBag.Title = "Home";
}

<div class="full-layout">

    <div class="top-banner d-flex align-items-center justify-content-center text-white">
        <div class="text-center">
            <h1 class="fw-bold display-4">HealthAxis Dashboard</h1>
            <p class="lead">All your healthcare operations in one place</p>
        </div>
    </div>

    <div class="container mt-5">
        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="content">
                        <h3>Manage Doctors</h3>
                        <p>Manage doctors, specialisations and availability</p>
                        @Html.ActionLink("Go", "Index", "Doctor", null,
                            new { @class = "btn btn-light" })
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="content">
                        <h3>Manage Patients</h3>
                        <p>View, update and manage patient records</p>
                        @Html.ActionLink("Go", "Index", "Patient", null,
                            new { @class = "btn btn-light" })
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="content">
                        <h3>Manage Appointments</h3>
                        <p>Schedule, track and manage appointments</p>
                        @Html.ActionLink("Go", "Index", "Appointment", null,
                            new { @class = "btn btn-light" })
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="content">
                        <h3>Manage Health Records</h3>
                        <p>View, add and manage patient health records</p>
                        @Html.ActionLink("Go", "Index", "HealthRecord", null,
                            new { @class = "btn btn-light" })
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<style>

    body {
        background: #111827;
        color: #e5e7eb;
        font-family: 'Segoe UI';
        margin: 0;
    }

    .top-banner {
        height: 250px;
        background: #1f2937;
        border-radius: 0 0 30px 30px;
    }

    .feature-card {
        height: 180px;
        background: #1f2937;
        border-radius: 12px;
        color: #e5e7eb;
        display: flex;
        align-items: center;
        padding: 25px;
        transition: 0.3s;
    }

        .feature-card:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

    .content h3 {
        margin-bottom: 10px;
    }

    .content p {
        color: #9ca3af;
    }

    .btn-light {
        background: #374151;
        color: white;
        border-radius: 20px;
        padding: 6px 16px;
        border: none;
    }

        .btn-light:hover {
            background: #4b5563;
        }
</style>