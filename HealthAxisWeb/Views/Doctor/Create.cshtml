@model HealthAxis_Web.Models.Dtos.DoctorDto

<h2 class="text-success">Add Doctor</h2>

<div class="col-4">
    @using (Html.BeginForm())
    {
        <div class="mb-2">
            @Html.LabelFor(m => m.FullName)
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.FullName)
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.Specialisation)
            @Html.TextBoxFor(m => m.Specialisation, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Specialisation)
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.YearsOfExperience)
            @Html.TextBoxFor(m => m.YearsOfExperience, new { @class = "form-control" })
        </div>

        <div class="mb-2">
            @Html.LabelFor(m => m.ConsultationFee)
            @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control" })
        </div>

        <div class="mb-2">
            @Html.CheckBoxFor(m => m.IsActive)
            @Html.LabelFor(m => m.IsActive)
        </div>

        <button class="btn btn-primary">Add Doctor</button>
    }
</div>
