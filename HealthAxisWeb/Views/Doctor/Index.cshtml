@{
    ViewBag.Title = "Doctor Module";
}

<div class="container mt-5 text-center">

    <h2 class="text-primary fw-bold mb-4">Doctor Management</h2>
    <p class="text-muted mb-5">Choose an action</p>

    <div class="row justify-content-center g-4">

        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h5>View All Doctors</h5>
                @Html.ActionLink("Open", "List", "Doctor",
                    null, new { @class = "btn btn-success w-100" })
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h5>Add Doctor</h5>
                @Html.ActionLink("Open", "Create", "Doctor",
                    null, new { @class = "btn btn-primary w-100" })
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h5>Search by ID</h5>
                @Html.ActionLink("Open", "SearchById", "Doctor",
                    null, new { @class = "btn btn-info w-100 text-white" })
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h5>Search by Specialisation</h5>
                @Html.ActionLink("Open", "SearchBySpecialisation", "Doctor",
                    null, new { @class = "btn btn-warning w-100 text-white" })
            </div>
        </div>

    </div>

</div>
``