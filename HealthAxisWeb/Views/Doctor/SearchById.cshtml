@model HealthAxis.Shared.Dtos.DoctorDto

<h3>Search Doctor by ID</h3>

@using (Html.BeginForm("SearchById", "Doctor", FormMethod.Get))
{
    <input type="number"
           name="id"
           value="@Request["id"]"
           class="form-control mb-2"
           placeholder="Enter Doctor ID"
           min="1"
           required />

    <button class="btn btn-primary">Search</button>
}

<hr />

@if (Model != null)
{
    <div class="card p-3 mt-3">
        <h5>Doctor Details</h5>

        <p><b>Name:</b> @Model.FullName</p>
        <p><b>Specialisation:</b> @Model.Specialisation</p>
        <p><b>Experience:</b> @Model.YearsOfExperience years</p>
        <p><b>Fee:</b> ₹@Model.ConsultationFee</p>
        <p><b>Status:</b> @(Model.IsActive ? "Active" : "Inactive")</p>
    </div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger mt-3">
        @ViewBag.Message
    </div>
}