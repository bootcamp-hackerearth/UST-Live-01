@model HealthAxis.Shared.Dtos.DoctorDto

<h2>Edit Doctor</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.DoctorId)

    <div>
        Name:
        @Html.TextBoxFor(m => m.FullName)
    </div>

    <div>
        Specialisation:
        @Html.EnumDropDownListFor(m => m.Specialisation)
    </div>

    <div>
        Experience:
        @Html.TextBoxFor(m => m.YearsOfExperience)
    </div>

    <div>
        Fee:
        @Html.TextBoxFor(m => m.ConsultationFee)
    </div>

    <div>
        Active:
        @Html.CheckBoxFor(m => m.IsActive)
    </div>

    <br />

    <button type="submit">Update</button>
}

<br />

@Html.ActionLink("Back", "Index", "Doctor")