@model HealthAxis.Shared.Dtos.HealthRecordDto

@{
    ViewBag.Title = "Add Health Record";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Add Health Record</h2>
        <p class="text-muted">Enter patient medical details</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">
            @ViewBag.Error
        </div>
    }

<div class="card shadow-sm p-4 mx-auto" style="max-width: 500px;">

    @using (Html.BeginForm("Create", "HealthRecord", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.AppointmentId)
        @Html.HiddenFor(m => m.PatientId)
        @Html.HiddenFor(m => m.DoctorId)


        <div class="mb-3">
            <label class="form-label">Diagnosis</label>
            @Html.TextBoxFor(m => m.Diagnosis, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label class="form-label">Prescription</label>
            @Html.TextBoxFor(m => m.Prescription, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label class="form-label">Notes</label>
            @Html.TextAreaFor(m => m.Notes, new { @class = "form-control" })
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-success px-4">Save</button>
        </div>
    }
</div>
</div>