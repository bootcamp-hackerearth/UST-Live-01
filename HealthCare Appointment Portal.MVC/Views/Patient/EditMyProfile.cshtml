@model HealthCare_Appointment_Portal.DTOs.PatientDtos.UpdatePatientDto

@{
    ViewBag.Title = "Edit My Profile";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col">

            <h2>
                Edit My Profile
            </h2>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                if (ViewData.ModelState[""]?.Errors.Count > 0)
                {
                    @Html.ValidationSummary(
                        true,
                        "",
                        new
                        {
                            @class = "alert alert-danger"
                        })
                }

                <div class="mb-3">

                    @Html.LabelFor(
                        m => m.FullName,
                        "Full Name",
                        new
                        {
                            @class = "form-label"
                        })

                    @Html.TextBoxFor(
                        m => m.FullName,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.FullName,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    @Html.LabelFor(
                        m => m.DateOfBirth,
                        "Date Of Birth",
                        new
                        {
                            @class = "form-label"
                        })

                    @Html.TextBoxFor(
                        m => m.DateOfBirth,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date"
                        })

                    @Html.ValidationMessageFor(
                        m => m.DateOfBirth,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    @Html.LabelFor(
                        m => m.Gender,
                        "Gender",
                        new
                        {
                            @class = "form-label"
                        })

                    @Html.EnumDropDownListFor(
                        m => m.Gender,
                        "-- Select Gender --",
                        new
                        {
                            @class = "form-select"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Gender,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    @Html.LabelFor(
                        m => m.PhoneNumber,
                        "Phone Number",
                        new
                        {
                            @class = "form-label"
                        })

                    @Html.TextBoxFor(
                        m => m.PhoneNumber,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.PhoneNumber,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    @Html.LabelFor(
                        m => m.Email,
                        "Email",
                        new
                        {
                            @class = "form-label"
                        })

                    @Html.TextBoxFor(
                        m => m.Email,
                        new
                        {
                            @class = "form-control",
                            type = "email"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Email,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        Save Changes

                    </button>

                    <a href="@Url.Action("MyProfile", "Patient")"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}