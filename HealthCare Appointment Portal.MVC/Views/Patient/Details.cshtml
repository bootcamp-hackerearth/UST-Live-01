@model HealthCare_Appointment_Portal.DTOs.PatientDtos.PatientDto
@{
    ViewBag.Title = "Patient Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-user me-2"></i>Patient Details</h2>
        <a href="@Url.Action("Index", "Patient")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-3 text-muted">
                    <strong>Patient Id</strong>
                </div>
                <div class="col-md-9 fw-bold">
                    @Model.PatientId
                </div>
            </div>

            <hr class="text-muted" />

            <div class="row mb-3">
                <div class="col-md-3 text-muted">
                    <strong>Full Name</strong>
                </div>
                <div class="col-md-9">
                    @Model.FullName
                </div>
            </div>

            <hr class="text-muted" />

            <div class="row mb-3">
                <div class="col-md-3 text-muted">
                    <strong>Date Of Birth</strong>
                </div>
                <div class="col-md-9">
                    @Model.DateOfBirth.ToString("dd-MMM-yyyy")
                </div>
            </div>

            <hr class="text-muted" />

            <div class="row mb-3">
                <div class="col-md-3 text-muted">
                    <strong>Age</strong>
                </div>
                <div class="col-md-9">
                    @Model.Age Years
                </div>
            </div>

            <hr class="text-muted" />

            <div class="row mb-3">
                <div class="col-md-3 text-muted">
                    <strong>Gender</strong>
                </div>
                <div class="col-md-9">
                    @Model.Gender
                </div>
            </div>

            <hr class="text-muted" />

            <div class="row mb-3">
                <div class="col-md-3 text-muted">
                    <strong>Email</strong>
                </div>
                <div class="col-md-9">
                    @Model.Email
                </div>
            </div>

            <hr class="text-muted" />

            <div class="row mb-3">
                <div class="col-md-3 text-muted">
                    <strong>Phone Number</strong>
                </div>
                <div class="col-md-9">
                    @Model.PhoneNumber
                </div>
            </div>

            <hr class="text-muted" />

            <div class="row mb-3">
                <div class="col-md-3 text-muted">
                    <strong>Appointment Count</strong>
                </div>
                <div class="col-md-9">
                    <span class="badge bg-info text-dark">@Model.AppointmentCount</span>
                </div>
            </div>

        </div>
    </div>

    @if (Session["Role"]?.ToString() == "Admin")
    {
        <div class="d-flex gap-2">

            <a href="@Url.Action("Edit", "Patient", new { id = Model.PatientId })" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Edit Patient
            </a>

            @using (Html.BeginForm("Deactivate", "Patient", new { id = Model.PatientId }, FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('Are you sure you want to deactivate this patient?');" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-user-slash me-1"></i> Deactivate Patient
                </button>
            }

        </div>
    }
</div>