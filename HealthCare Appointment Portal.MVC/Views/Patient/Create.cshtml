@model HealthCare_Appointment_Portal.DTOs.PatientDtos.CreatePatientDto

@{
    ViewBag.Title = "Add Patient";
}

@Html.Partial("_Alerts")

<div class="container-fluid">

    <div class="row mb-4">
        <div class="col">
            <h2>Add New Patient</h2>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                if (ViewData.ModelState[""]?.Errors.Count > 0)
                {
                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "alert alert-danger" })
                }

                <div class="row">

                    <!-- FULL NAME -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Full Name</label>

                        @Html.TextBoxFor(
                            m => m.FullName,
                            new { @class = "form-control" })

                        @Html.ValidationMessageFor(
                            m => m.FullName,
                            "",
                            new { @class = "text-danger d-block mt-1" })
                    </div>

                    <!-- DATE OF BIRTH ✅ FIXED -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date Of Birth</label>

                       @Html.TextBoxFor(
                           m => m.DateOfBirth,
                           "{0:yyyy-MM-dd}",
                           new{@class = "form-control",type = "date"})

                        @Html.ValidationMessageFor(
                            m => m.DateOfBirth,
                            "",
                            new { @class = "text-danger d-block mt-1" })
                    </div>

                </div>

                <div class="row">

                    <!-- GENDER -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Gender</label>

                        @Html.EnumDropDownListFor(
                            m => m.Gender,
                            "-- Select Gender --",
                            new { @class = "form-select" })

                        @Html.ValidationMessageFor(
                            m => m.Gender,
                            "",
                            new { @class = "text-danger d-block mt-1" })
                    </div>

                    <!-- PHONE -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone Number</label>

                        @Html.TextBoxFor(
                            m => m.PhoneNumber,
                            new { @class = "form-control" })

                        @Html.ValidationMessageFor(
                            m => m.PhoneNumber,
                            "",
                            new { @class = "text-danger d-block mt-1" })
                    </div>

                </div>

                <!-- EMAIL -->
                <div class="mb-3">
                    <label class="form-label">Email</label>

                    @Html.TextBoxFor(
                        m => m.Email,
                        new { @class = "form-control", type = "email" })

                    @Html.ValidationMessageFor(
                        m => m.Email,
                        "",
                        new { @class = "text-danger d-block mt-1" })
                </div>

                <!-- BUTTONS -->
                <div class="mt-4">

                    <button type="submit" class="btn btn-success">
                        Save Patient
                    </button>

                    <a href="@Url.Action("Index", "Patient")"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>
            }
        </div>
    </div>
</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
