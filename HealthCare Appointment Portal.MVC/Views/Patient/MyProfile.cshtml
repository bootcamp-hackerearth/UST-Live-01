@model HealthCare_Appointment_Portal.DTOs.PatientDtos.PatientDto

@{
    ViewBag.Title = "My Profile";
}

<style>
    .profile-card {
        max-width: 1100px;
        min-height: 520px;
        margin: auto;
        border-radius: 22px;
        padding: 35px;
    }

    .profile-table th {
        width: 35%;
        background: #eef2f7;
        padding: 18px;
        font-weight: 700;
    }

    .profile-table td {
        padding: 18px;
    }

    .small-update-btn {
        width: 220px;
        padding: 10px;
        font-weight: 700;
        border-radius: 10px;
    }
</style>

<div class="container mt-5">

    <div class="card shadow profile-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>My Profile</h2>

            <a href="@Url.Action("Dashboard", "Patient")"
               class="btn btn-secondary">
                Back
            </a>
        </div>

        <table class="table table-bordered profile-table">
            <tr>
                <th>Patient Id</th>
                <td>@Model.PatientId</td>
            </tr>

            <tr>
                <th>Full Name</th>
                <td>@Model.FullName</td>
            </tr>

            <tr>
                <th>Date Of Birth</th>
                <td>@Model.DateOfBirth.ToString("dd-MMM-yyyy")</td>
            </tr>

            <tr>
                <th>Gender</th>
                <td>@Model.Gender</td>
            </tr>

            <tr>
                <th>Phone Number</th>
                <td>@Model.PhoneNumber</td>
            </tr>

            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>
        </table>

        <div class="text-center mt-4">
            <a href="@Url.Action("EditMyProfile", "Patient")"
               class="btn btn-warning small-update-btn">
                Update Profile
            </a>
        </div>

    </div>

</div>