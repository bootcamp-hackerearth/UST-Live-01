@model HealthCare_Appointment_Portal.DTOs.PatientDtos.PatientDto

@{
    ViewBag.Title = "My Profile";
}

<div class="container mt-5">

    <div class="card shadow p-4">

        <div class="d-flex justify-content-between mb-3">
            <h2>👤 My Profile</h2>

            <a href="@Url.Action("Dashboard", "Patient")"
               class="btn btn-secondary">
                Back
            </a>
        </div>

        <table class="table table-bordered">
            <tr>
                <th>Patient Id</th>
                <td>@Model.PatientId</td>
            </tr>

            <tr>
                <th>Full Name</th>
                <td>@Model.FullName</td>
            </tr>

            <tr>
                <th>Date Of Birth</th>
                <td>@Model.DateOfBirth.ToString("dd-MMM-yyyy")</td>
            </tr>

            <tr>
                <th>Gender</th>
                <td>@Model.Gender</td>
            </tr>

            <tr>
                <th>Phone Number</th>
                <td>@Model.PhoneNumber</td>
            </tr>

            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>
        </table>

        <a href="@Url.Action("EditMyProfile", "Patient")"
           class="btn btn-warning">
            Update Profile
        </a>

    </div>

</div>