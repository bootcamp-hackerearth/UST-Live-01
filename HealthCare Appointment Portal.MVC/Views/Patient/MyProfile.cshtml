@model HealthCare_Appointment_Portal.DTOs.PatientDtos.PatientDto

@{
    ViewBag.Title = "My Profile";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col">

            <h2>
                My Profile
            </h2>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>
                        Patient Id
                    </strong>
                </div>

                <div class="col-md-9">
                    @Model.PatientId
                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>
                        Full Name
                    </strong>
                </div>

                <div class="col-md-9">
                    @Model.FullName
                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>
                        Date Of Birth
                    </strong>
                </div>

                <div class="col-md-9">
                    @Model.DateOfBirth.ToString("dd-MMM-yyyy")
                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>
                        Gender
                    </strong>
                </div>

                <div class="col-md-9">
                    @Model.Gender
                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>
                        Phone Number
                    </strong>
                </div>

                <div class="col-md-9">
                    @Model.PhoneNumber
                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>
                        Email
                    </strong>
                </div>

                <div class="col-md-9">
                    @Model.Email
                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>
                        Appointment Count
                    </strong>
                </div>

                <div class="col-md-9">
                    @Model.AppointmentCount
                </div>

            </div>

            <div class="mt-4">

                <a href="@Url.Action("EditMyProfile","Patient")"
                   class="btn btn-primary">

                    Edit Profile

                </a>

                <a href="@Url.Action("Dashboard","Patient")"
                   class="btn btn-secondary">

                    Back

                </a>

            </div>

        </div>

    </div>

</div>