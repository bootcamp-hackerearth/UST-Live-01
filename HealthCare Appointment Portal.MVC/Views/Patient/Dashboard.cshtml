@model HealthCare_Appointment_Portal.DTOs.PatientDtos.PatientDto

@{
    ViewBag.Title = "Patient Dashboard";
}

<div class="container mt-5">

    <div class="card shadow p-5">

        <h2>
            Hello, @Model.FullName
        </h2>

        <p>
            Welcome to your patient portal.
        </p>

        <hr />

        <div class="row">

            <div class="col-md-6 mb-3">
                <a href="@Url.Action("Create", "Appointment")"
                   class="btn btn-primary btn-lg w-100">
                    Book Appointment
                </a>
            </div>

            <div class="col-md-6 mb-3">
                <a href="@Url.Action("MyAppointments", "Appointment")"
                   class="btn btn-success btn-lg w-100">
                    View My Appointments
                </a>
            </div>

            <div class="col-md-6 mb-3">
                <a href="@Url.Action("PatientHistory", "HealthRecord", new { patientId = Model.PatientId })"
                   class="btn btn-info btn-lg w-100 text-white">
                    View Health Record History
                </a>
            </div>

            <div class="col-md-6 mb-3">
                <a href="@Url.Action("EditMyProfile", "Patient")"
                   class="btn btn-warning btn-lg w-100">
                    Update Details
                </a>

            </div>

        </div>
        <div class="row mt-3">
            <div class="col-md-6 mx-auto">
                <a href="@Url.Action("Logout", "Home")"
                   class="btn btn-danger btn-lg w-100">
                    Logout
                </a>
            </div>
        </div>

    </div>

</div>
