@model IEnumerable<HealthCare_Appointment_Portal.DTOs.PatientDtos.PatientDto>

@{
    ViewBag.Title = "Patients";
}

@Html.Partial("_Alerts")

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Patient Management</h2>

        <a href="@Url.Action("Create", "Patient")"
           class="btn btn-success">
            <i class="fas fa-plus"></i> Add Patient
        </a>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Patient Id</th>
                        <th>Full Name</th>
                        <th>Gender</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Appointments</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var patient in Model)
                        {
                            <tr>
                                <td>@patient.PatientId</td>
                                <td>@patient.FullName</td>
                                <td>@patient.Gender</td>
                                <td>@patient.Email</td>
                                <td>@patient.PhoneNumber</td>
                                <td>@patient.AppointmentCount</td>

                                <td>

                                    <button class="btn btn-info btn-sm"
                                            onclick="loadPatientDetails(@patient.PatientId)">
                                        View
                                    </button>

                                    <a href="@Url.Action("Edit", "Patient", new { id = patient.PatientId })"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                No patients found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>

<!-- ✅ MODAL -->
<div class="modal fade" id="patientModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Patient</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="patientModalContent"></div>

        </div>
    </div>
</div>

@section Scripts{

    <script>

        function loadPatientDetails(id) {

            $.get('/Patient/Details/' + id, function (data) {

                $('#patientModalContent').html(data);

                var modal = new bootstrap.Modal(
                    document.getElementById('patientModal')
                );

                modal.show();
            });

        }

        function loadPatientEdit(id) {

            alert("Patient Id = " + id);

            $.get('/Patient/Edit/' + id)

                .done(function (data) {

                    alert("Data received from controller");

                    $('#patientModalContent').html(data);

                    var modal = new bootstrap.Modal(
                        document.getElementById('patientModal')
                    );

                    modal.show();
                })

                .fail(function (xhr) {

                    alert("ERROR: " + xhr.status);

                    console.log(xhr.responseText);
                });
        }

    </script>

}