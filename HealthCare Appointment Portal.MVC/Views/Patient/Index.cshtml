@model IEnumerable<HealthCare_Appointment_Portal.DTOs.PatientDtos.PatientDto>
@{
    ViewBag.Title = "Patient Registry";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users me-2"></i>Patient Registry</h2>
        <a href="@Url.Action("Create", "Patient")" class="btn btn-success">
            <i class="fas fa-plus"></i> Add Patient
        </a>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            @using (Html.BeginForm("Index", "Patient", FormMethod.Get, new { @class = "d-flex gap-2" }))
            {
                <div class="pull-right">
                    <input type="text"
                           name="searchQuery"
                           value="@ViewBag.CurrentSearch"
                           class="form-control"
                           placeholder="Search by name, email, or phone..." />

                    <button type="submit" class="btn btn-primary" title="Search">
                        <i class="fas fa-search"></i>
                    </button>
                </div>

                if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch as string))
                {
                    <a href="@Url.Action("Index", "Patient")" class="btn btn-outline-secondary" title="Clear Search">
                        <i class="fas fa-times"></i>
                    </a>
                }
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i> No patients found matching your search criteria.
                </div>
            }
            else
            {
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Patient Id</th>
                            <th scope="col">Full Name</th>
                            <th scope="col">Gender</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone Number</th>
                            <th scope="col">Appointments</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td>@patient.PatientId</td>
                                <td>@patient.FullName</td>
                                <td>@patient.Gender</td>
                                <td>@patient.Email</td>
                                <td>@patient.PhoneNumber</td>
                                <td>@patient.AppointmentCount</td>
                                <td class="text-center">
                                    @{
                                        var routeData = new { id = patient.PatientId };
                                    }
                                    <div class="d-flex justify-content-center gap-2">

                                        <a href="@Url.Action("Details", "Patient", routeData)"
                                           class="btn btn-sm btn-info text-white" title="View" aria-label="View Patient Details">
                                            <i class="fas fa-eye"></i> View
                                        </a>

                                        <a href="@Url.Action("Edit", "Patient", routeData)"
                                           class="btn btn-sm btn-warning" title="Edit" aria-label="Edit Patient">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>

                                        <a href="@Url.Action("Deactivate", "Patient", routeData)"
                                           class="btn btn-sm btn-danger" title="Delete" aria-label="Deactivate Patient">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>