@model IEnumerable<HealthCare_Appointment_Portal.DTOs.PatientDtos.PatientDto>
@{
    ViewBag.Title = "Patient Registry";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Patient Registry</h2>
        <a href="@Url.Action("Create", "Patient")" class="btn btn-success">
            Add Patient
        </a>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            @using (Html.BeginForm("Index", "Patient", FormMethod.Get, new { @class = "d-flex gap-2" }))
            {
                <input type="text"
                       name="searchQuery"
                       value="@ViewBag.CurrentSearch"
                       class="form-control"
                       placeholder="Search by name, email, or phone..." />

                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch as string))
                {
                    <a href="@Url.Action("Index", "Patient")" class="btn btn-outline-secondary">
                        Clear
                    </a>
                }
            }
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No patients found matching your search criteria.
                </div>
            }
            else
            {
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Patient Id</th>
                            <th>Full Name</th>
                            <th>Gender</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th>Appointments</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td>@patient.PatientId</td>
                                <td>@patient.FullName</td>
                                <td>@patient.Gender</td>
                                <td>@patient.Email</td>
                                <td>@patient.PhoneNumber</td>
                                <td>@patient.AppointmentCount</td>
                                <td>
                                    <a href="@Url.Action("Details", "Patient", new { id = patient.PatientId })"
                                       class="btn btn-sm btn-info">
                                        View
                                    </a>
                                    <a href="@Url.Action("Edit", "Patient", new { id = patient.PatientId })"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>
                                    <a href="@Url.Action("Deactivate", "Patient", new { id = patient.PatientId })"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>