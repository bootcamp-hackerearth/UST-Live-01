@model HealthCare_Appointment_Portal.DTOs.UserDtos.LoginDto

@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        HealthAxis Health
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-dark: #1E3A7A;
            --primary-blue: #2563EB;
            --primary-light: #4AA3D9;
        }

        body {
            font-family: "Segoe UI", sans-serif;
            overflow-x: hidden;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
        }

        /* LEFT SIDE */

        .left-panel {
            width: 60%;
            position: relative;
            background:
                linear-gradient(
                    rgba(255,255,255,.82),
                    rgba(255,255,255,.82)),
                url('@Url.Content("~/Content/Images/login-bg.jpg")');

            background-size: cover;
            background-position: center;
            padding: 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .main-title {
            font-size: 4rem;
            font-weight: 800;
            color: var(--primary-dark);
            line-height: 1.1;
            margin-bottom: 25px;
        }

        .main-subtitle {
            font-size: 1.3rem;
            color: #374151;
            max-width: 650px;
            margin-bottom: 50px;
        }

        .feature-box {
            display: flex;
            align-items: center;
            background: rgba(255,255,255,.9);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            width: 500px;
            box-shadow: 0 4px 12px rgba(0,0,0,.08);
        }

        .feature-icon {
            width: 65px;
            height: 65px;
            border-radius: 12px;
            background: #eef4ff;
            color: var(--primary-blue);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 26px;
            margin-right: 20px;
        }

        .feature-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .feature-text {
            color: #6b7280;
            margin-top: 4px;
        }

        .stats-bar {
            margin-top: 40px;
            display: flex;
            gap: 40px;
        }

        .stat-box h3 {
            color: var(--primary-dark);
            font-weight: 700;
        }

        .stat-box p {
            color: #6b7280;
            margin-bottom: 0;
        }

        /* RIGHT SIDE */

        .right-panel {
            width: 40%;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .login-card {
            width: 100%;
            max-width: 520px;
            background: white;
            border-radius: 25px;
            padding: 50px;
            box-shadow: 0 10px 40px rgba(0,0,0,.15);
        }

        .logo-image {
            max-height: 90px;
            margin-bottom: 20px;
        }

        .welcome-title {
            color: var(--primary-dark);
            font-size: 2rem;
            font-weight: 700;
        }

        .welcome-subtitle {
            color: gray;
            margin-bottom: 30px;
        }

        .form-label {
            font-weight: 600;
            color: #374151;
        }

        .form-control {
            border-radius: 12px;
            height: 55px;
            font-size: 1rem;
        }

        .form-control:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 .2rem rgba(37,99,235,.15);
        }

        .btn-login {
            height: 55px;
            border-radius: 12px;
            background: linear-gradient(
                90deg,
                var(--primary-dark),
                var(--primary-blue));
            border: none;
            color: white;
            font-size: 1rem;
            font-weight: 600;
        }

        .btn-login:hover {
            opacity: .95;
            color: white;
        }

        .divider {
            text-align: center;
            margin: 25px 0;
            color: gray;
            position: relative;
        }

        .divider::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            width: 45%;
            border-top: 1px solid #ddd;
        }

        .divider::after {
            content: "";
            position: absolute;
            top: 50%;
            right: 0;
            width: 45%;
            border-top: 1px solid #ddd;
        }

        .btn-register {
            border-radius: 12px;
            height: 55px;
            font-weight: 600;
        }

        .guide-box {
            margin-top: 25px;
            background: #f8fafc;
            border-radius: 12px;
            padding: 15px;
        }

        .guide-title {
            color: var(--primary-blue);
            font-weight: 600;
        }

        .guide-text {
            font-size: .95rem;
            color: #6b7280;
        }

        @@media(max-width:991px) {

            .left-panel {
                display: none;
            }

            .right-panel {
                width: 100%;
            }

            .login-card {
                padding: 35px;
            }
        }

    </style>

</head>

<body>

    <div class="login-container">

        <!-- LEFT SECTION -->

        <div class="left-panel">

            <h1 class="main-title">
                Better Healthcare
                <br />
                For A Better Tomorrow
            </h1>

            <p class="main-subtitle">
                Empowering hospitals, doctors and patients
                through smart technology and seamless care.
            </p>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fas fa-users"></i>
                </div>

                <div>
                    <div class="feature-title">
                        Patient Centered Care
                    </div>

                    <div class="feature-text">
                        Care that puts patients first.
                    </div>
                </div>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fas fa-shield-heart"></i>
                </div>

                <div>
                    <div class="feature-title">
                        Secure &amp; Private
                    </div>

                    <div class="feature-text">
                        Your medical data is protected.
                    </div>
                </div>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fas fa-heart-pulse"></i>
                </div>

                <div>
                    <div class="feature-title">
                        Smart &amp; Efficient
                    </div>

                    <div class="feature-text">
                        Technology that enhances care.
                    </div>
                </div>

            </div>

            <div class="stats-bar">

                <div class="stat-box">
                    <h3>Few</h3>
                    <p>Hospitals</p>
                </div>

                <div class="stat-box">
                    <h3>Few</h3>
                    <p>Doctors</p>
                </div>

                <div class="stat-box">
                    <h3>Few</h3>
                    <p>Patients</p>
                </div>

            </div>

        </div>

        <!-- RIGHT SECTION -->

        <div class="right-panel">

            <div class="login-card">

                <div class="text-center">

                    <img src="@Url.Content("~/Content/Images/healthaxis-logo.png")"
                         class="img-fluid logo-image"
                         alt="HealthAxis Health logo" />

                    <h2 class="welcome-title">
                        Welcome Back
                    </h2>

                    <p class="welcome-subtitle">
                        Please enter your user code to login
                    </p>

                </div>

                @using (Html.BeginForm(
                    "Login",
                    "User",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                        true,
                        "",
                        new
                        {
                            @class = "alert alert-danger"
                        })

                    <div class="mb-4">

                        @Html.LabelFor(
                            m => m.UserCode,
                            "User Code",
                            new
                            {
                                @class = "form-label"
                            })

                        @Html.TextBoxFor(
                            m => m.UserCode,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter User Code"
                            })

                        @Html.ValidationMessageFor(
                            m => m.UserCode,
                            "",
                            new
                            {
                                @class = "text-danger d-block mt-1"
                            })

                    </div>

                    <button type="submit"
                            class="btn btn-login w-100">

                        <i class="fas fa-right-to-bracket me-2"></i>

                        Login

                    </button>
                }

                <div class="divider">
                    OR
                </div>

                <a href="@Url.Action(
                            "Register",
                            "User")"
                   class="btn btn-outline-primary btn-register w-100">

                    <i class="fas fa-user-plus me-2"></i>

                    Register As Patient

                </a>

                <div class="guide-box">

                    <div class="guide-title mb-2">

                        <i class="fas fa-circle-info me-2"></i>

                        User Code Guide

                    </div>

                    <div class="guide-text">

                        Axxxx - Admin
                        &nbsp; | &nbsp;

                        Dxxxx - Doctor
                        &nbsp; | &nbsp;

                        Pxxxx - Patient

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>