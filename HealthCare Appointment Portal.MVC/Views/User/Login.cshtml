@model HealthCare_Appointment_Portal.DTOs.UserDtos.LoginDto

@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        HealthAxis Health - Login
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <style>

        :root {
            --primary-dark: #1E3A7A;
            --primary-blue: #2563EB;
            --primary-light: #4AA3D9;
        }

        body {
            background: linear-gradient( 135deg, var(--primary-dark), var(--primary-blue), var(--primary-light));
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 15px 40px rgba(0,0,0,.15);
            overflow: hidden;
            background: white;
        }

        .card-body {
            padding: 2.5rem;
        }

        .logo-image {
            max-height: 120px;
            width: auto;
        }

        .portal-title {
            color: var(--primary-dark);
            font-weight: 700;
            font-size: 2rem;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            height: 55px;
            border-radius: 12px;
        }

            .form-control:focus {
                border-color: var(--primary-blue);
                box-shadow: 0 0 0 .2rem rgba(37,99,235,.15);
            }

        .btn-login {
            background-color: var(--primary-dark);
            border-color: var(--primary-dark);
            height: 55px;
            border-radius: 12px;
            font-weight: 600;
        }

            .btn-login:hover {
                background-color: #163172;
                border-color: #163172;
            }

        .btn-register {
            border: 2px solid var(--primary-light);
            color: var(--primary-light);
            font-weight: 600;
            height: 55px;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .btn-register:hover {
                background-color: var(--primary-light);
                color: white;
            }

        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

        .alert {
            border-radius: 12px;
        }

        @@media (max-width: 768px) {

            .card-body {
                padding: 2rem;
            }

            .portal-title {
                font-size: 1.75rem;
            }
        }
    </style>

</head>

<body>

    <div class="container">

        <div class="row justify-content-center align-items-center min-vh-100 py-4">

            <div class="col-md-8 col-lg-5">

                <div class="card login-card">

                    <div class="card-body">

                        <div class="text-center mb-4">

                            <img src="@Url.Content("~/Content/Images/healthaxis-logo.png")"
                                 alt="HealthAxis Health"
                                 class="img-fluid logo-image mb-3" />

                            <h2 class="portal-title">
                                HealthAxis Health
                            </h2>

                            <p class="text-muted fs-5">
                                Login using your User Code
                            </p>

                        </div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show mb-4"
                                 role="alert">

                                <i class="fa-solid fa-circle-check me-2"></i>

                                @TempData["SuccessMessage"]

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="alert"
                                        aria-label="Close">
                                </button>

                            </div>
                        }

                        @using (Html.BeginForm(
                            "Login",
                            "User",
                            FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            if (!ViewData.ModelState.IsValid)
                            {
                                @Html.ValidationSummary(
                                    false,
                                    "",
                                    new
                                    {
                                        @class = "alert alert-danger mb-4"
                                    })
                            }

                            <div class="mb-4">

                                <label class="form-label">
                                    User Code
                                </label>

                                @Html.TextBoxFor(
                                    m => m.UserCode,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "Enter User Code",
                                        required = "required",
                                        autofocus = "autofocus"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.UserCode,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })

                                <small class="text-muted">
                                    Examples: A1001, D1001, P1001
                                </small>

                            </div>

                            <button type="submit"
                                    class="btn btn-login text-white w-100 mb-3">

                                <i class="fa-solid fa-right-to-bracket me-2"></i>

                                Login

                            </button>
                        }

                        <div class="text-center">

                            <hr />

                            <p class="text-muted mb-3">
                                New Patient?
                            </p>

                            <a href="@Url.Action(
                                "Register",
                                "User")"
                               class="btn btn-register w-100">

                                <i class="fa-solid fa-user-plus me-2"></i>

                                Register As Patient

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>