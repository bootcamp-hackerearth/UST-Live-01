@model HealthCare_Appointment_Portal_MVC.ViewModels.AdminDashboardViewModel

@{
    ViewBag.Title = "Home";
}

<div class="container py-5">

    <!-- HERO SECTION -->

    <div class="text-center mb-5">

        <h1 class="display-4 fw-bold text-primary">
            Healthcare Management System
        </h1>

        <p class="lead text-muted">
            Manage Patients, Doctors, Appointments and Health Records
        </p>

    </div>

    
    <!-- DASHBOARD STATS -->

    <div class="row text-center mb-5">

        <!-- TOTAL PATIENTS -->

        <div class="col-md-3 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <i class="fas fa-users fa-2x text-primary mb-3"></i>

                    <h2 class="fw-bold">
                        @Model.TotalPatients
                    </h2>

                    <p class="text-muted mb-0">
                        Total Patients
                    </p>

                </div>

            </div>

        </div>

        <!-- TOTAL DOCTORS -->

        <div class="col-md-3 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <i class="fas fa-user-doctor fa-2x text-success mb-3"></i>

                    <h2 class="fw-bold">
                        @Model.TotalDoctors
                    </h2>

                    <p class="text-muted mb-0">
                        Total Doctors
                    </p>

                </div>

            </div>

        </div>

        <!-- TOTAL APPOINTMENTS -->

        <div class="col-md-3 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <i class="fas fa-calendar-check fa-2x text-warning mb-3"></i>

                    <h2 class="fw-bold">
                        @Model.TotalAppointments
                    </h2>

                    <p class="text-muted mb-0">
                        Total Appointments
                    </p>

                </div>

            </div>

        </div>

        <!-- TOTAL HEALTH RECORDS -->

        <div class="col-md-3 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <i class="fas fa-file-medical fa-2x text-danger mb-3"></i>

                    <h2 class="fw-bold">
                        @Model.TotalHealthRecords
                    </h2>

                    <p class="text-muted mb-0">
                        Health Records
                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- MODULE CARDS -->

    <div class="row">

        <!-- PATIENT CARD -->

        <div class="col-md-3 mb-4">

            <div class="card p-4 text-center h-100 shadow border-0">

                <i class="fas fa-users fa-3x text-primary mb-3"></i>

                <h4>
                    Patients
                </h4>

                <p class="text-muted">
                    Manage patient details
                </p>

                <a href="@Url.Action("Index", "Patient")"
                   class="btn btn-primary">

                    Open

                </a>

            </div>

        </div>

        <!-- DOCTOR CARD -->

        <div class="col-md-3 mb-4">

            <div class="card p-4 text-center h-100 shadow border-0">

                <i class="fas fa-user-doctor fa-3x text-success mb-3"></i>

                <h4>
                    Doctors
                </h4>

                <p class="text-muted">
                    View doctor information
                </p>

                <a href="@Url.Action("Index", "Doctor")"
                   class="btn btn-success">

                    Open

                </a>

            </div>

        </div>

        <!-- APPOINTMENT CARD -->

        <div class="col-md-3 mb-4">

            <div class="card p-4 text-center h-100 shadow border-0">

                <i class="fas fa-calendar-check fa-3x text-warning mb-3"></i>

                <h4>
                    Appointments
                </h4>

                <p class="text-muted">
                    Schedule appointments
                </p>

                <a href="@Url.Action("Index", "Appointment")"
                   class="btn btn-warning text-white">

                    Open

                </a>

            </div>

        </div>

        <!-- HEALTH RECORD CARD -->

        <div class="col-md-3 mb-4">

            <div class="card p-4 text-center h-100 shadow border-0">

                <i class="fas fa-file-medical fa-3x text-danger mb-3"></i>

                <h4>
                    Health Records
                </h4>

                <p class="text-muted">
                    Access medical history
                </p>

                <a href="@Url.Action("Index", "HealthRecord")"
                   class="btn btn-danger">

                    Open

                </a>

            </div>

        </div>
