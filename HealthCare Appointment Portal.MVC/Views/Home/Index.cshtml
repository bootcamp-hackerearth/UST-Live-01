@{
    ViewBag.Title = "Healthcare Management System";
}

<style>

    html {
        scroll-behavior: smooth;
    }

    body {
        background: linear-gradient(135deg, #0d6efd, #4dabf7);
        min-height: 100vh;
    }

    /* HERO */
    .hero-section {
        text-align: center;
        color: white;
        padding: 60px 0;
    }

        .hero-section h1 {
            font-size: 55px;
            font-weight: bold;
        }

        .hero-section p {
            font-size: 20px;
        }

    /* CARDS */
    .feature-card {
        border: none;
        border-radius: 25px;
        transition: 0.3s;
        background: white;
    }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }

    .icon-circle {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        margin: auto;
        margin-top: 20px;
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 45px;
        color: white;
    }

    .patient {
        background: #0d6efd;
    }

    .doctor {
        background: #20c997;
    }

    .contact-section {
        background: white;
        border-radius: 25px;
        padding: 40px;
        margin-top: 50px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .feature-box {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        height: 100%;
    }

    footer {
        text-align: center;
        color: white;
        margin-top: 40px;
        padding: 20px;
    }
</style>

<div class="container">

    <!-- HERO -->
    <div id="home" class="hero-section">

        <h1>Healthcare Management System</h1>

        <p>
            Book appointments, manage doctors and maintain patient health records.
        </p>

    </div>

    <!-- PATIENT & DOCTOR CARDS -->
    <div class="row justify-content-center">

        <!-- Patient -->
        <div class="col-md-5 mb-4">

            <div class="card feature-card h-100">

                <div class="card-body text-center">

                    <div class="icon-circle patient">
                        👥
                    </div>

                    <h2>
                        Patients
                    </h2>

                    <p>
                        Book appointments, manage profile information and
                        view health record history.
                    </p>

                    <a href="@Url.Action("Create","Patient")"
                       class="btn btn-primary btn-lg">
                        Patient Portal
                    </a>

                </div>

            </div>

        </div>

        <!-- Doctor -->
        <div class="col-md-5 mb-4">

            <div class="card feature-card h-100">

                <div class="card-body text-center">

                    <div class="icon-circle doctor">
                        🩺
                    </div>

                    <h2>
                        Doctors
                    </h2>

                    <p>
                        Manage appointments, update appointment status and
                        maintain patient health records.
                    </p>
                    <a href="@Url.Action("Create", "Doctor")"
                       class="btn btn-success btn-lg">
                        Doctor Portal
                    </a> 

                </div>

            </div>

        </div>

    </div>

    <!-- FEATURES -->
    <h3 class="text-white mb-4 mt-4">
        ⭐ Features
    </h3>

    <div class="row">

        <div class="col-md-6 mb-3">

            <div class="feature-box">

                <h5>
                    📅Appointment Booking
                </h5>

                <p class="mb-0">
                    Patients can book appointments with doctors based on
                    available dates and time slots.
                </p>

            </div>

        </div>

        <div class="col-md-6 mb-3">

            <div class="feature-box">

                <h5>
                    🩺 Doctor Management
                </h5>

                <p class="mb-0">
                    Manage doctor profiles, specializations and consultation details.
                </p>

            </div>

        </div>

        <div class="col-md-6 mb-3">

            <div class="feature-box">

                <h5>
                    📋 Health Records
                </h5>

                <p class="mb-0">
                    Doctors can add diagnoses and prescriptions after completing appointments.
                </p>

            </div>

        </div>

        <div class="col-md-6 mb-3">

            <div class="feature-box">

                <h5>
                    🔒 24/7 Patient Support
                </h5>

                <p class="mb-0">
                    Available around the clock to assist patients with appointment bookings and inquiries.
                </p>

            </div>

        </div>

    </div>

    <!-- CONTACT -->
    <div id="contact" class="contact-section">

        <h2 class="text-primary mb-4">
            📞 Contact Us
        </h2>

        <div class="row">

            <div class="col-md-4">

                <h5>
                    📍 Address
                </h5>

                <p>
                    Trivandrum, Kerala, India
                </p>

            </div>

            <div class="col-md-4">

                <h5>
                    📧 Email
                </h5>

                <p>
                    support@healthcare.com
                </p>

            </div>

            <div class="col-md-4">

                <h5>
                    ☎ Phone
                </h5>

                <p>
                    +91 98765 43210
                </p>

            </div>

        </div>

    </div>

    <!-- FOOTER -->
    <footer>

        <hr />

        <h5>
            ❤️ Caring Beyond Treatment
        </h5>

        <p>
            © 2026 Healthcare Management System
        </p>

    </footer>

</div>