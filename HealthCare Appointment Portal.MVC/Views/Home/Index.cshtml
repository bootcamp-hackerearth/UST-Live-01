@{
    ViewBag.Title = "Home";
}

<style>
    .hero {
        background: linear-gradient(135deg, rgba(15,23,42,.94), rgba(30,64,175,.92), rgba(14,165,233,.88)), url("https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1600&q=80");
        background-size: cover;
        background-position: center;
        color: white;
        border-radius: 34px;
        padding: 85px 45px;
        box-shadow: 0 25px 60px rgba(15, 23, 42, .35);
    }

        .hero h1 {
            font-size: 3.7rem;
            font-weight: 900;
            color: white;
        }

        .hero p {
            font-size: 1.25rem;
            max-width: 850px;
            margin: auto;
            color: #e0f2fe;
        }

    .hero-icon {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 4rem;
        margin-bottom: 25px;
    }

    .portal-card {
        border-radius: 30px;
        padding: 45px;
        color: white;
        min-height: 360px;
        transition: .3s;
    }

        .portal-card:hover,
        .why-card:hover,
        .info-card:hover {
            transform: translateY(-8px);
        }

    .patient-card {
        background: linear-gradient(135deg, #1e3a8a, #2563eb, #06b6d4);
    }

    .doctor-card {
        background: linear-gradient(135deg, #064e3b, #15803d, #22c55e);
    }

    .circle-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(255,255,255,.22);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 2.8rem;
    }

    .section-title {
        font-weight: 900;
        color: #0f172a;
    }

    .why-card {
        color: white;
        border-radius: 24px;
        padding: 34px;
        min-height: 250px;
        box-shadow: 0 16px 35px rgba(15,23,42,.18);
        transition: .3s;
    }

    .why-1 {
        background: linear-gradient(135deg, #1e40af, #3b82f6);
    }

    .why-2 {
        background: linear-gradient(135deg, #047857, #10b981);
    }

    .why-3 {
        background: linear-gradient(135deg, #0e7490, #06b6d4);
    }

    .why-4 {
        background: linear-gradient(135deg, #92400e, #f59e0b);
    }

    .info-card {
        border-radius: 26px;
        padding: 35px;
        min-height: 260px;
        transition: .3s;
        background: white;
    }

    .final-section {
        background: linear-gradient(135deg, rgba(15,23,42,.95), rgba(30,58,138,.9)), url("https://images.unsplash.com/photo-1586773860418-d37222d8fce3?auto=format&fit=crop&w=1600&q=80");
        background-size: cover;
        background-position: center;
        color: white;
        border-radius: 32px 32px 0 0;
        padding: 55px 55px 35px 55px;
        box-shadow: 0 25px 55px rgba(15,23,42,.28);
    }

    .footer-line {
        border-top: 1px solid rgba(255,255,255,.25);
        margin-top: 35px;
        padding-top: 18px;
        color: #e0f2fe;
        font-weight: 600;
    }
</style>

<div class="hero text-center mb-5">

    <div class="hero-icon">
        <i class="fas fa-heart-pulse"></i>
    </div>

    <h1>
        Healthcare Management System
    </h1>

    <p class="mt-3">
        A professional digital healthcare platform built to simplify appointments,
        doctor scheduling, patient management, and secure medical record tracking.
    </p>

</div>

<div class="row g-4 mb-5">

    <div class="col-md-6">
        <div class="portal-card patient-card text-center shadow">

            <div class="circle-icon mb-4">
                <i class="fas fa-user-injured"></i>
            </div>

            <h2 class="fw-bold">
                Patient Portal
            </h2>

            <p class="mt-3">
                Patients can register, book appointments, view appointment history,
                update details, and check health record history in one place.
            </p>

            <a href="@Url.Action("Create", "Patient")"
               class="btn btn-light btn-lg mt-4 w-75">
                 Patient Portal
            </a>

        </div>
    </div>

    <div class="col-md-6">
        <div class="portal-card doctor-card text-center shadow">

            <div class="circle-icon mb-4">
                <i class="fas fa-user-doctor"></i>
            </div>

            <h2 class="fw-bold">
                Doctor Portal
            </h2>

            <p class="mt-3">
                Doctors can view appointments, confirm or cancel visits,
                complete consultations, and maintain patient health records.
            </p>

            <a href="@Url.Action("Create", "Doctor")"
               class="btn btn-light btn-lg mt-4 w-75">
                 Doctor Portal
            </a>

        </div>
    </div>

</div>

<div class="text-center mb-4">

    <h2 class="section-title">
        Why Choose Us?
    </h2>

    <p class="text-muted">
        Designed for better healthcare coordination, faster workflow, and smooth user experience.
    </p>

</div>

<div class="row g-4 mb-5">

    <div class="col-md-3">
        <div class="why-card why-1 text-center">
            <i class="fas fa-calendar-check fa-3x mb-3"></i>
            <h5 class="fw-bold">Easy Booking</h5>
            <p>
                Patients can book and manage appointments quickly without confusion.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="why-card why-2 text-center">
            <i class="fas fa-shield-heart fa-3x mb-3"></i>
            <h5 class="fw-bold">Secure Records</h5>
            <p>
                Medical history is maintained safely and linked to each patient.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="why-card why-3 text-center">
            <i class="fas fa-user-doctor fa-3x mb-3"></i>
            <h5 class="fw-bold">Doctor Dashboard</h5>
            <p>
                Doctors can manage appointments and update patient records easily.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="why-card why-4 text-center">
            <i class="fas fa-laptop-medical fa-3x mb-3"></i>
            <h5 class="fw-bold">Smart System</h5>
            <p>
                Simple dashboards make the system fast, clean, and user-friendly.
            </p>
        </div>
    </div>

</div>

<div class="row g-4 mb-5">

    <div class="col-md-4">
        <div class="card info-card text-center">
            <i class="fas fa-circle-info fa-3x text-primary mb-3"></i>
            <h4 class="fw-bold">About Us</h4>
            <p class="text-muted">
                Our system connects patients and doctors through a clean,
                organized, and professional healthcare platform.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card info-card text-center">
            <i class="fas fa-hand-holding-medical fa-3x text-success mb-3"></i>
            <h4 class="fw-bold">Services</h4>
            <p class="text-muted">
                We support patient registration, doctor registration, appointment booking,
                appointment status updates, and health record management.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card info-card text-center">
            <i class="fas fa-headset fa-3x text-info mb-3"></i>
            <h4 class="fw-bold">Support</h4>
            <p class="text-muted">
                Built with a simple interface so patients and doctors can use it easily
                without technical difficulty.
            </p>
        </div>
    </div>

</div>

<div class="final-section text-center">

    <h2 class="fw-bold mb-3">
        Caring Today for a Healthier Tomorrow
    </h2>

    <p class="mb-4">
        Manage appointments, doctors, patients, and medical records with confidence.
        Our goal is to make healthcare access faster, smarter, and more reliable.
    </p>

    <div class="row">

        <div class="col-md-4 mb-3">
            <i class="fas fa-envelope fa-2x mb-2"></i>
            <h5>Email</h5>
            <p>support@healthcare.com</p>
        </div>

        <div class="col-md-4 mb-3">
            <i class="fas fa-phone fa-2x mb-2"></i>
            <h5>Phone</h5>
            <p>+91 98765 43210</p>
        </div>

        <div class="col-md-4 mb-3">
            <i class="fas fa-location-dot fa-2x mb-2"></i>
            <h5>Location</h5>
            <p>Kerala, India</p>
        </div>

    </div>

    <div class="footer-line">
        © 2026 - Healthcare Appointment Portal. All Rights Reserved.
    </div>

</div>