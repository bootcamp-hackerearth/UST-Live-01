@{
    ViewBag.Title = "HealthAxis Health";
}

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark fixed-top custom-navbar">
    <div class="container">

        <a class="navbar-brand fw-bold"
           href="@Url.Action("Index", "Home")#home">
            HealthAxis Health
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#homeNavbar"
                aria-controls="homeNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse"
             id="homeNavbar">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "Home")#home">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "Home")#about">
                        About
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "Home")#services">
                        Services
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                       href="@Url.Action("Index", "Home")#contact">
                        Contact Us
                    </a>
                </li>

            </ul>

        </div>

    </div>
</nav>

<!-- HERO SECTION -->
<section id="home" class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-100">

            <!-- LEFT -->
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4">
                    Better Healthcare
                    <br />
                    For A Better Tomorrow
                </h1>

                <p class="lead mb-4">
                    HealthAxis Health connects patients,
                    doctors and healthcare providers
                    through one secure and modern platform.
                </p>

                <a href="@Url.Action("DashboardSelection", "Home")"
                   class="btn btn-primary btn-lg">
                    Go to Dashboard
                </a>
            </div>

            <!-- RIGHT -->
            <div class="col-lg-6 text-center">
                <img src="@Url.Content("~/Content/Images/login-bg.jpg")"
                     class="img-fluid hero-image"
                     alt="Healthcare" />
            </div>

        </div>
    </div>
</section>

<!-- ABOUT -->
<section id="about" class="py-5">
    <div class="container text-center">

        <h2 class="section-title mb-3">
            Who We Are
        </h2>

        <p class="section-subtitle mb-4">
            Transforming healthcare through innovation and technology.
        </p>

        <div class="card shadow-sm border-0 p-5">
            <p class="fs-5">
                HealthAxis Health is a digital healthcare platform designed
                to simplify healthcare delivery and improve patient experience.
            </p>

            <p class="text-muted">
                We empower patients, doctors, and administrators with tools
                for scheduling, records, and healthcare operations.
            </p>
        </div>

    </div>
</section>

<!-- SERVICES -->
<section id="services" class="py-5 bg-light">
    <div class="container text-center">

        <h2 class="section-title mb-5">
            What We Provide
        </h2>

        <div class="row">

            <div class="col-md-4 mb-4">
                <div class="card feature-card p-4">
                    <h4>
                        Patients
                    </h4>

                    <p>
                        Manage profiles and appointments.
                    </p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card feature-card p-4">
                    <h4>
                        Doctors
                    </h4>

                    <p>
                        Manage availability and schedules.
                    </p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card feature-card p-4">
                    <h4>
                        Admin
                    </h4>

                    <p>
                        Full system management access.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- CTA -->
<section class="py-5 text-center">
    <div class="container">

        <h2 class="mb-4">
            Ready To Experience Smarter Healthcare?
        </h2>

        <a href="@Url.Action("DashboardSelection", "Home")"
           class="btn btn-primary btn-lg">
            Go to Dashboard
        </a>

    </div>
</section>

<!-- CONTACT -->
<section id="contact" class="contact-section">
    <div class="container text-center">

        <h2 class="mb-4">
            Contact Us
        </h2>

        <p>
            support@healthaxishealth.com
        </p>

        <p>
            +91 98765 43210
        </p>

        <p>
            Online Service Only
        </p>

    </div>
</section>

<!-- FOOTER -->
<footer>
    <div class="container">
        © 2026 HealthAxis Health
    </div>
</footer>

<!-- STYLES -->
<style>
    html {
        scroll-behavior: smooth;
    }

    .custom-navbar {
        background: #1E3A7A;
    }

    .navbar-brand {
        color: #ffffff !important;
    }

    .navbar-nav .nav-link {
        color: rgba(255,255,255,.90) !important;
        font-weight: 500;
        margin-left: 12px;
        transition: all .2s ease;
    }

        .navbar-nav .nav-link:hover {
            color: #ffffff !important;
            transform: translateY(-1px);
        }

    .hero-section {
        background: linear-gradient(135deg,#F8FAFC,#E0F2FE);
        padding-top: 70px;
    }

    .hero-image {
        border-radius: 25px;
        box-shadow: 0 15px 40px rgba(0,0,0,.15);
    }

    .section-title {
        color: #1E3A7A;
        font-weight: 700;
    }

    .section-subtitle {
        color: gray;
    }

    .feature-card {
        border-radius: 20px;
        transition: .3s;
        height: 100%;
    }

        .feature-card:hover {
            transform: translateY(-8px);
        }

    .contact-section {
        background: #F8FAFC;
        padding: 70px 0;
    }

    footer {
        background: #0F172A;
        color: white;
        text-align: center;
        padding: 20px;
    }
</style>