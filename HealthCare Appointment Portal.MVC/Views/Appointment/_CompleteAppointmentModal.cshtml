@model HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto

@if (Model == null)
{
    <div class="alert alert-danger">

        Appointment not found.

    </div>
}
else
{
    <div class="text-center">

        <div class="mb-4">

            <i class="bi bi-check2-square
                      text-primary"
               style="font-size:70px;">
            </i>

        </div>

        <h4 class="fw-bold text-primary">

            Complete Appointment

        </h4>

        <p class="text-muted mb-4">

            Are you sure you want to mark this appointment as completed?

        </p>

    </div>

    <div class="card border-0 bg-light">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <strong>

                        Appointment Id

                    </strong>

                    <div>

                        #@Model.AppointmentId

                    </div>

                </div>

                <div class="col-md-6">

                    <strong>

                        Current Status

                    </strong>

                    <div>

                        <span class="badge bg-success">

                            @Model.Status

                        </span>

                    </div>

                </div>

                <div class="col-md-6">

                    <strong>

                        Patient

                    </strong>

                    <div>

                        @Model.PatientName

                    </div>

                </div>

                <div class="col-md-6">

                    <strong>

                        Doctor

                    </strong>

                    <div>

                        @Model.DoctorName

                    </div>

                </div>

                <div class="col-md-6">

                    <strong>

                        Scheduled Date

                    </strong>

                    <div>

                        @Model.ScheduledDate.ToString("dd MMM yyyy")

                    </div>

                </div>

                <div class="col-md-6">

                    <strong>

                        Time Slot

                    </strong>

                    <div>

                        @Model.TimeSlot

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="alert alert-info mt-3">

        After completion, you can create a health record for this appointment.

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">

            Close

        </button>

        <button type="button"
                id="completeAppointmentBtn"
                data-id="@Model.AppointmentId"
                class="btn btn-primary">

            <i class="bi bi-check2-circle me-1"></i>

            Complete Appointment

        </button>

    </div>
}