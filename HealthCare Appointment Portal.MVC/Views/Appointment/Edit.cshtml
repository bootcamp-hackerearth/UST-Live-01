@model HealthCare_Appointment_Portal.DTOs.AppointmentDtos.UpdateAppointmentDto

@using HealthCare_Appointment_Portal.DTOs.DoctorDtos

@{
    ViewBag.Title = "Update Appointment";

    var doctors =
        ViewBag.DoctorList as IEnumerable<DoctorDto>;

    var patientList =
        ViewBag.PatientList as SelectList;
}

<div class="container mt-5">

    <h2 class="mb-4">
        Update Appointment
    </h2>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            @if (ViewData.ModelState[""] != null &&
      ViewData.ModelState[""].Errors.Count > 0)
            {
                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class = "alert alert-danger"
                    })
            }

            @using (Html.BeginForm("Edit", "Appointment", new { id = ViewBag.AppointmentId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label class="form-label">
                        Patient Name
                    </label>

                    @Html.DropDownList(
                        "PatientId",
                        patientList,
                        new
                        {
                            @class = "form-select",
                            disabled = "disabled"
                        })

                    

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Select Doctor
                    </label>

                    <select name="DoctorId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select Doctor --
                        </option>

                        @if (doctors != null)
                        {
                            foreach (var doctor in doctors)
                            {
                                <option value="@doctor.DoctorId"
                                        @(Model.DoctorId == doctor.DoctorId ? "selected" : "")>
                                    @doctor.FullName - @doctor.Specialisation
                                </option>
                            }
                        }

                    </select>

                    @Html.ValidationMessageFor(
                        m => m.DoctorId,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Appointment Date
                    </label>

                    @Html.TextBoxFor(
                        m => m.ScheduledDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.ScheduledDate,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Time Slot
                    </label>

                    @Html.DropDownListFor(
                        m => m.TimeSlot,
                        new List<SelectListItem>
                        {
                            new SelectListItem { Text = "09:00 - 10:00", Value = "09:00 - 10:00" },
                            new SelectListItem { Text = "10:00 - 11:00", Value = "10:00 - 11:00" },
                            new SelectListItem { Text = "11:00 - 12:00", Value = "11:00 - 12:00" },
                            new SelectListItem { Text = "12:00 - 13:00", Value = "12:00 - 13:00" },
                            new SelectListItem { Text = "13:00 - 14:00", Value = "13:00 - 14:00" },
                            new SelectListItem { Text = "14:00 - 15:00", Value = "14:00 - 15:00" },
                            new SelectListItem { Text = "15:00 - 16:00", Value = "15:00 - 16:00" },
                            new SelectListItem { Text = "16:00 - 17:00", Value = "16:00 - 17:00" },
                            new SelectListItem { Text = "17:00 - 18:00", Value = "17:00 - 18:00" },
                            new SelectListItem { Text = "18:00 - 19:00", Value = "18:00 - 19:00" },
                            new SelectListItem { Text = "19:00 - 20:00", Value = "19:00 - 20:00" },
                            new SelectListItem { Text = "20:00 - 21:00", Value = "20:00 - 21:00" },
                            new SelectListItem { Text = "21:00 - 22:00", Value = "21:00 - 22:00" },
                            new SelectListItem { Text = "22:00 - 23:00", Value = "22:00 - 23:00" }
                        },
                        "-- Select Time Slot --",
                        new
                        {
                            @class = "form-select",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.TimeSlot,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Save Changes
                </button>

                <a href="@Url.Action("MyAppointments", "Appointment")"
                   class="btn btn-secondary">
                    Back to Dashboard
                </a>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}