@model HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto

@{
    ViewBag.Title = "Cancel Appointment";
}

<div class="container mt-5">

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            <div class="alert alert-warning">
                <strong>Warning!</strong>
                You are about to cancel this appointment.
            </div>

            @Html.ValidationSummary(
                true,
                "",
                new
                {
                    @class = "alert alert-danger"
                })

            <table class="table table-borderless">

                <tr>
                    <th style="width: 250px;">
                        Appointment Id
                    </th>

                    <td>
                        @Model.AppointmentId
                    </td>
                </tr>

                <tr>
                    <th>
                        Patient
                    </th>

                    <td>
                        @Model.PatientName
                    </td>
                </tr>

                <tr>
                    <th>
                        Doctor
                    </th>

                    <td>
                        @Model.DoctorName
                    </td>
                </tr>

                <tr>
                    <th>
                        Appointment Date
                    </th>

                    <td>
                        @Model.ScheduledDate.ToString("dd MMM yyyy") - @Model.TimeSlot
                    </td>
                </tr>

            </table>

            <hr />

            @using (Html.BeginForm("Cancel", "Appointment", new { id = Model.AppointmentId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label class="form-label">
                        Cancellation Reason
                    </label>

                    <textarea name="reason"
                              class="form-control"
                              rows="5"
                              placeholder="Enter cancellation reason..."></textarea>

                    <small class="text-muted">
                        Optional
                    </small>

                </div>

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Cancellation
                </button>

                <a href="@Url.Action("UpcomingAppointments", "Doctor")"
                   class="btn btn-secondary">
                    Back
                </a>
            }

        </div>

    </div>

</div>