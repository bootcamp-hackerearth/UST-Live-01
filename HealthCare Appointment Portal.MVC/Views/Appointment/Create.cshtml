@model HealthCare_Appointment_Portal.DTOs.AppointmentDtos.CreateAppointmentDto

@{
    ViewBag.Title = "Book Appointment";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">

                    <h3 class="mb-0">
                        Book Appointment
                    </h3>

                </div>

                <div class="card-body">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(
                            true,
                            "",
                            new
                            {
                                @class = "alert alert-danger"
                            })

                        <!-- PATIENT -->

                        <div class="mb-3">

                            <label class="form-label">
                                Patient
                            </label>

                            @Html.DropDownListFor(
                                m => m.PatientId,
                                (SelectList)ViewBag.Patients,
                                "-- Select Patient --",
                                new
                                {
                                    @class = "form-select"
                                })

                            @Html.ValidationMessageFor(
                                m => m.PatientId,
                                "",
                                new
                                {
                                    @class = "text-danger"
                                })

                        </div>

                        <!-- DOCTOR -->

                        <div class="mb-3">

                            <label class="form-label">
                                Doctor
                            </label>

                            @Html.DropDownListFor(
                                m => m.DoctorId,
                                (SelectList)ViewBag.Doctors,
                                "-- Select Doctor --",
                                new
                                {
                                    @class = "form-select"
                                })

                            @Html.ValidationMessageFor(
                                m => m.DoctorId,
                                "",
                                new
                                {
                                    @class = "text-danger"
                                })

                        </div>

                        <!-- APPOINTMENT DATE -->

                        <div class="mb-3">

                            <label class="form-label">
                                Appointment Date
                            </label>

                            @Html.TextBoxFor(
                                m => m.ScheduledDate,
                                "{0:yyyy-MM-dd}",
                                new
                                {
                                    @class = "form-control",
                                    type = "date",
                                    min = DateTime.Today.ToString("yyyy-MM-dd")
                                })

                            @Html.ValidationMessageFor(
                                m => m.ScheduledDate,
                                "",
                                new
                                {
                                    @class = "text-danger"
                                })

                        </div>

                        <!-- TIME SLOT -->

                        <div class="mb-4">

                            <label class="form-label">
                                Time Slot
                            </label>

                            @Html.DropDownListFor(
                                m => m.TimeSlot,
                                new List<SelectListItem>
                                {
                                    new SelectListItem
                                    {
                                        Text = "09:00 AM - 10:00 AM",
                                        Value = "09:00 AM - 10:00 AM"
                                    },

                                    new SelectListItem
                                    {
                                        Text = "10:00 AM - 11:00 AM",
                                        Value = "10:00 AM - 11:00 AM"
                                    },

                                    new SelectListItem
                                    {
                                        Text = "11:00 AM - 12:00 PM",
                                        Value = "11:00 AM - 12:00 PM"
                                    },

                                    new SelectListItem
                                    {
                                        Text = "02:00 PM - 03:00 PM",
                                        Value = "02:00 PM - 03:00 PM"
                                    },

                                    new SelectListItem
                                    {
                                        Text = "03:00 PM - 04:00 PM",
                                        Value = "03:00 PM - 04:00 PM"
                                    }
                                },
                                "-- Select Time Slot --",
                                new
                                {
                                    @class = "form-select"
                                })

                            @Html.ValidationMessageFor(
                                m => m.TimeSlot,
                                "",
                                new
                                {
                                    @class = "text-danger"
                                })

                        </div>

                        <!-- BUTTONS -->

                        <div class="mt-4">

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="fas fa-save"></i>

                                Book Appointment

                            </button>

                            <a href="@Url.Action("Index", "Appointment")"
                               class="btn btn-secondary">

                                Back

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}