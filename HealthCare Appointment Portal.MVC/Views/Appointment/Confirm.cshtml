@model HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto

@{
    ViewBag.Title = "Appointment Confirmed";

    var patient = ViewBag.Patient;
    var doctor = ViewBag.Doctor;
}

<div class="container mt-5">

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-5">

            <div class="text-center mb-4">

                <h1 class="text-success">
                    Appointment Confirmed
                </h1>

                <p class="lead">
                    This appointment has been confirmed successfully.
                </p>

            </div>

            <hr />

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <table class="table table-bordered table-striped">

                <tr>
                    <th>Appointment Id</th>
                    <td>@Model.AppointmentId</td>
                </tr>

                <tr>
                    <th>Patient Name</th>
                    <td>@patient.FullName</td>
                </tr>

                <tr>
                    <th>Doctor Name</th>
                    <td>Dr. @doctor.FullName</td>
                </tr>

                <tr>
                    <th>Doctor Specialisation</th>
                    <td>@doctor.Specialisation</td>
                </tr>

                <tr>
                    <th>Appointment Date</th>
                    <td>@Model.ScheduledDate.ToString("dd-MMM-yyyy")</td>
                </tr>

                <tr>
                    <th>Time Slot</th>
                    <td>@Model.TimeSlot</td>
                </tr>

                <tr>
                    <th>Status</th>
                    <td>
                        <span class="badge bg-success">
                            @Model.Status
                        </span>
                    </td>
                </tr>

            </table>

            <div class="mt-4 text-center">

                @using (Html.BeginForm("Complete", "Appointment", new { id = Model.AppointmentId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-primary">
                        Complete Appointment
                    </button>
                }

                <a href="@Url.Action("UpcomingAppointments", "Doctor")"
                   class="btn btn-secondary mt-2">
                    Back to Upcoming Appointments
                </a>

            </div>

        </div>

    </div>

</div>