@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@using HealthCare_Appointment_Portal.Enums

@{
    ViewBag.Title = "Weekly Schedule";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Weekly Schedule
        </h2>

        <a href="@Url.Action(
                    "Dashboard",
                    "Doctor")"
           class="btn btn-secondary">

            Back

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>
                            Appointment Id
                        </th>

                        <th>
                            Patient
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Time Slot
                        </th>

                        <th>
                            Status
                        </th>

                        <th width="350">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center">

                                No appointments scheduled this week.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var appointment in Model)
                        {
                            <tr>

                                <td>
                                    @appointment.AppointmentId
                                </td>

                                <td>
                                    @appointment.PatientName
                                </td>

                                <td>
                                    @appointment.ScheduledDate.ToString(
                                        "dd MMM yyyy")
                                </td>

                                <td>
                                    @appointment.TimeSlot
                                </td>

                                <td>

                                    @{
                                        string badgeClass =
                                            appointment.Status == AppointmentStatus.Pending
                                                ? "bg-warning text-dark"
                                                : appointment.Status == AppointmentStatus.Confirmed
                                                    ? "bg-success"
                                                    : appointment.Status == AppointmentStatus.Cancelled
                                                        ? "bg-danger"
                                                        : "bg-primary";
                                    }

                                    <span class="badge @badgeClass">
                                        @appointment.Status
                                    </span>

                                </td>

                                <td>

                                    <a href="@Url.Action(
                                                "Details",
                                                "Appointment",
                                                new
                                                {
                                                    id =
                                                        appointment.AppointmentId
                                                })"
                                       class="btn btn-info btn-sm">

                                        View

                                    </a>

                                    @if (appointment.Status ==
                                         AppointmentStatus.Pending)
                                    {
                                        using (Html.BeginForm(
                                            "Confirm",
                                            "Appointment",
                                            FormMethod.Post,
                                            new
                                            {
                                                style =
                                                "display:inline;"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@appointment.AppointmentId" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm">

                                                Confirm

                                            </button>
                                        }
                                    }

                                    @if (appointment.Status ==
                                         AppointmentStatus.Pending
                                         ||
                                         appointment.Status ==
                                         AppointmentStatus.Confirmed)
                                    {
                                        <a href="@Url.Action(
                                                    "Cancel",
                                                    "Appointment",
                                                    new
                                                    {
                                                        id =
                                                            appointment.AppointmentId
                                                    })"
                                           class="btn btn-danger btn-sm">

                                            Cancel

                                        </a>
                                    }

                                    @if (appointment.Status ==
                                         AppointmentStatus.Confirmed)
                                    {
                                        using (Html.BeginForm(
                                            "Complete",
                                            "Appointment",
                                            FormMethod.Post,
                                            new
                                            {
                                                style =
                                                "display:inline;"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@appointment.AppointmentId" />

                                            <button type="submit"
                                                    class="btn btn-primary btn-sm">

                                                Complete

                                            </button>
                                        }
                                    }

                                    @if (appointment.Status ==
                                         AppointmentStatus.Completed)
                                    {
                                        if (!appointment.HasHealthRecord)
                                        {
                                            <a href="@Url.Action(
                                                        "Create",
                                                        "HealthRecord",
                                                        new
                                                        {
                                                            appointmentId =
                                                                appointment.AppointmentId,

                                                            patientId =
                                                                appointment.PatientId
                                                        })"
                                               class="btn btn-dark btn-sm">

                                                Add Health Record

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">

                                                Health Record Added

                                            </span>
                                        }
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>