@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>
@using System.Web.Routing

@{
    ViewBag.Title = "Weekly Schedule";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Weekly Schedule
        </h2>

        <a href="@Url.Action("Dashboard", "Doctor")"
           class="btn btn-secondary">
            Back
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-light">

                    <tr>
                        <th>
                            Appointment Id
                        </th>

                        <th>
                            Patient
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Time Slot
                        </th>

                        <th>
                            Status
                        </th>

                        <th width="250">
                            Actions
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center">
                                No appointments scheduled this week.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var appointment in Model)
                        {
                            var appointmentId = appointment.AppointmentId;
                            var appointmentStatus = appointment.Status.ToString();

                            <tr>

                                <td>
                                    @appointmentId
                                </td>

                                <td>
                                    @appointment.PatientName
                                </td>

                                <td>
                                    @appointment.ScheduledDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @appointment.TimeSlot
                                </td>

                                <td>

                                    @if (appointmentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (appointmentStatus == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            Confirmed
                                        </span>
                                    }
                                    else if (appointmentStatus == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else if (appointmentStatus == "Completed")
                                    {
                                        <span class="badge bg-primary">
                                            Completed
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a href="@Url.Action(
                                                "Details",
                                                "Appointment",
                                                new RouteValueDictionary
                                                {
                                                    { "id", appointmentId }
                                                })"
                                       class="btn btn-info btn-sm">
                                        View
                                    </a>

                                    @if (appointmentStatus == "Pending")
                                    {
                                        using (Html.BeginForm(
                                            "Confirm",
                                            "Appointment",
                                            FormMethod.Post,
                                            new
                                            {
                                                id = $"confirm-form-{appointmentId}",
                                                style = "display:inline;"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   id="confirm-appointment-id-@appointmentId"
                                                   name="id"
                                                   value="@appointmentId" />

                                            <button type="submit"
                                                    id="confirm-button-@appointmentId"
                                                    class="btn btn-success btn-sm">
                                                Confirm
                                            </button>
                                        }

                                        <a href="@Url.Action(
                                                    "Cancel",
                                                    "Appointment",
                                                    new RouteValueDictionary
                                                    {
                                                        { "id", appointmentId }
                                                    })"
                                           class="btn btn-danger btn-sm">
                                            Cancel
                                        </a>
                                    }

                                    @if (appointmentStatus == "Confirmed")
                                    {
                                        using (Html.BeginForm(
                                            "Complete",
                                            "Appointment",
                                            FormMethod.Post,
                                            new
                                            {
                                                id = $"complete-form-{appointmentId}",
                                                style = "display:inline;"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   id="complete-appointment-id-@appointmentId"
                                                   name="id"
                                                   value="@appointmentId" />

                                            <button type="submit"
                                                    id="complete-button-@appointmentId"
                                                    class="btn btn-primary btn-sm">
                                                Complete
                                            </button>
                                        }
                                    }

                                    @if (appointmentStatus == "Completed")
                                    {
                                        <a href="@Url.Action(
                                                    "Create",
                                                    "HealthRecord",
                                                    new RouteValueDictionary
                                                    {
                                                        { "appointmentId", appointmentId },
                                                        { "patientId", appointment.PatientId }
                                                    })"
                                           class="btn btn-dark btn-sm">
                                            Add Health Record
                                        </a>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>