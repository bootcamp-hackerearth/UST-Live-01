@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "Today's Schedule";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Today's Schedule
        </h2>

        <a href="@Url.Action("Dashboard", "Doctor")"
           class="btn btn-secondary">

            Back

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>
                            Appointment Id
                        </th>

                        <th>
                            Patient
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Time Slot
                        </th>

                        <th>
                            Status
                        </th>

                        <th width="280">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center text-muted py-4">

                                No appointments scheduled today.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var appointment in Model)
                        {
                            <tr>

                                <td>
                                    @appointment.AppointmentId
                                </td>

                                <td>
                                    @appointment.PatientName
                                </td>

                                <td>
                                    @appointment.ScheduledDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @appointment.TimeSlot
                                </td>

                                <td>

                                    @switch (appointment.Status.ToString())
                                    {
                                        case "Pending":

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                            break;

                                        case "Confirmed":

                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>

                                            break;

                                        case "Cancelled":

                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>

                                            break;

                                        case "Completed":

                                            <span class="badge bg-primary">
                                                Completed
                                            </span>

                                            break;

                                        default:

                                            <span class="badge bg-secondary">
                                                @appointment.Status
                                            </span>

                                            break;
                                    }

                                </td>

                                <td>

                                    <a href="@Url.Action("Details", "Appointment", new { id = appointment.AppointmentId })"
                                       class="btn btn-info btn-sm text-white">

                                        View

                                    </a>

                                    @if (appointment.Status.ToString() == "Pending")
                                    {
                                        using (Html.BeginForm(
                                            "Confirm",
                                            "Appointment",
                                            new
                                            {
                                                id = appointment.AppointmentId
                                            },
                                            FormMethod.Post,
                                            new
                                            {
                                                style = "display:inline;"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-success btn-sm">

                                                Confirm

                                            </button>
                                        }

                                        using (Html.BeginForm(
                                            "Cancel",
                                            "Appointment",
                                            new
                                            {
                                                id = appointment.AppointmentId
                                            },
                                            FormMethod.Post,
                                            new
                                            {
                                                style = "display:inline;"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to cancel this appointment?');">

                                                Cancel

                                            </button>
                                        }
                                    }

                                    @if (appointment.Status.ToString() == "Confirmed")
                                    {
                                        using (Html.BeginForm(
                                            "Complete",
                                            "Appointment",
                                            new
                                            {
                                                id = appointment.AppointmentId
                                            },
                                            FormMethod.Post,
                                            new
                                            {
                                                style = "display:inline;"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-primary btn-sm">

                                                Complete

                                            </button>
                                        }
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>
    .badge {
        font-size: 0.85rem;
        padding: 8px 12px;
        border-radius: 10px;
    }

    .btn-sm {
        border-radius: 8px;
        margin-right: 4px;
        font-weight: 500;
    }

    .card {
        border-radius: 18px;
    }

    table th {
        font-weight: 700;
    }
</style>