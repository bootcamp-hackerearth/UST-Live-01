@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "My Appointments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Appointments</h2>

        <a href="@Url.Action("Dashboard", "Patient")" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-8">
                    <input type="text"
                           id="searchBox"
                           class="form-control"
                           placeholder="Search by Appointment Id, Doctor Name, Date, Time Slot" />
                </div>

                <div class="col-md-4">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

            </div>

            <table class="table table-bordered table-hover" id="appointmentsTable">

                <thead class="table-light">
                    <tr>
                        <th>Appointment Id</th>
                        <th>Doctor Name</th>
                        <th>Appointment Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th width="250">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusValue = item.Status.ToString();

                        <tr data-status="@statusValue">
                            <td>@item.AppointmentId</td>
                            <td>@item.DoctorName</td>
                            <td>@item.ScheduledDate.ToString("dd-MMM-yyyy")</td>
                            <td>@item.TimeSlot</td>

                            <td>
                                @if (statusValue == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (statusValue == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else if (statusValue == "Completed")
                                {
                                    <span class="badge bg-primary">Completed</span>
                                }
                                else if (statusValue == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@statusValue</span>
                                }
                            </td>

                            <td>
                                <a href="@Url.Action("Details", "Appointment", new { id = item.AppointmentId })"
                                   class="btn btn-info btn-sm text-white">
                                    <i class="fa fa-eye"></i> View
                                </a>

                                <a href="@Url.Action("Edit", "Appointment", new { id = item.AppointmentId })"
                                   class="btn btn-warning btn-sm">
                                    <i class="fa fa-edit"></i> Edit
                                </a>

                                <a href="@Url.Action("Delete", "Appointment", new { id = item.AppointmentId })"
                                   class="btn btn-danger btn-sm">
                                    <i class="fa fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchBox = document.getElementById("searchBox");
        const statusFilter = document.getElementById("statusFilter");
        const rows = document.querySelectorAll("#appointmentsTable tbody tr");

        function filterAppointments() {
            const searchValue = searchBox.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value.trim().toLowerCase();

            rows.forEach(function (row) {
                const rowText = row.innerText.toLowerCase();
                const rowStatus = row.getAttribute("data-status").trim().toLowerCase();

                const matchesSearch =
                    searchValue === "" || rowText.includes(searchValue);

                const matchesStatus =
                    selectedStatus === "" || rowStatus === selectedStatus;

                row.style.display =
                    matchesSearch && matchesStatus ? "" : "none";
            });
        }

        searchBox.addEventListener("keyup", filterAppointments);
        statusFilter.addEventListener("change", filterAppointments);
    });
</script>