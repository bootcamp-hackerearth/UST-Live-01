@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "My Appointments";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            My Appointments
        </h2>

        <a href="@Url.Action(
                    "Create",
                    "Appointment")"
           class="btn btn-primary">

            Book Appointment

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            @TempData["Success"]

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-light">

                    <tr>

                        <th>
                            Appointment Id
                        </th>

                        <th>
                            Doctor
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Time Slot
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center">

                                No appointments found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var appointment in Model)
                        {
                            <tr>

                                <td>
                                    @appointment.AppointmentId
                                </td>

                                <td>
                                    @appointment.DoctorName
                                </td>

                                <td>
                                    @appointment.ScheduledDate.ToString(
                                    "dd MMM yyyy")
                                </td>

                                <td>
                                    @appointment.TimeSlot
                                </td>

                                <td>

                                    @switch (appointment.Status.ToString())
                                    {
                                        case "Pending":

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                            break;

                                        case "Confirmed":

                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>

                                            break;

                                        case "Cancelled":

                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>

                                            break;

                                        case "Completed":

                                            <span class="badge bg-primary">
                                                Completed
                                            </span>

                                            break;

                                        default:

                                            <span class="badge bg-secondary">
                                                @appointment.Status
                                            </span>

                                            break;
                                    }

                                </td>

                                <td>

                                    <a href="@Url.Action(
                                                "Details",
                                                "Appointment",
                                                new
                                                {
                                                    id =
                                                    appointment.AppointmentId
                                                })"
                                       class="btn btn-info btn-sm">

                                        View

                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>