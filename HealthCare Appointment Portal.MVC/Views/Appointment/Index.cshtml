@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "Appointment Management";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Appointment Management
        </h2>

        <a href="@Url.Action("Create","Appointment")"
           class="btn btn-success">

            Add Appointment

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-light">

                    <tr>

                        <th>Appointment Id</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center">

                                No appointments found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var appointment in Model)
                        {
                            <tr>

                                <td>@appointment.AppointmentId</td>

                                <td>@appointment.PatientName</td>

                                <td>@appointment.DoctorName</td>

                                <td>
                                    @appointment.ScheduledDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @appointment.TimeSlot
                                </td>

                                <td>

                                    @if (appointment.Status.ToString() == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (appointment.Status.ToString() == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            Confirmed
                                        </span>
                                    }
                                    else if (appointment.Status.ToString() == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Completed
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a href="@Url.Action(
                "Details",
                "Appointment",
                new
                {
                    id = appointment.AppointmentId
                })"
                                       class="btn btn-info btn-sm">

                                        View

                                    </a>

                                    @if (appointment.Status.ToString() == "Pending")
                                    {
                                        using (Html.BeginForm(
                                                    "Confirm",
                                                    "Appointment",
                                                    FormMethod.Post,
                                                    new
                                                    {
                                                        style = "display:inline;"
                                                    }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@appointment.AppointmentId" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm">

                                                Confirm

                                            </button>
                                        }

                                        <a href="@Url.Action(
                    "Cancel",
                    "Appointment",
                    new
                    {
                        id = appointment.AppointmentId
                    })"
                                           class="btn btn-danger btn-sm">

                                            Cancel

                                        </a>
                                    }

                                    @if (appointment.Status.ToString() == "Confirmed")
                                    {
                                        using (Html.BeginForm(
                                                    "Complete",
                                                    "Appointment",
                                                    FormMethod.Post,
                                                    new
                                                    {
                                                        style = "display:inline;"
                                                    }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@appointment.AppointmentId" />

                                            <button type="submit"
                                                    class="btn btn-primary btn-sm">

                                                Complete

                                            </button>
                                        }
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>