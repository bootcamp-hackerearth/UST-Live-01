@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "Appointments";
}

<div class="container-fluid">

    <!-- ✅ HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-4 position-relative">

        <!-- LEFT: BACK -->
        <div>
            <a href="@Url.Action("Index","Home")"
               class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>

        <!-- CENTER TITLE -->
        <div class="position-absolute start-50 translate-middle-x">
            <h2 class="mb-0 fw-bold">Appointment Management</h2>
        </div>

        <!-- RIGHT: BOOK APPOINTMENT -->
        <div>
            <a href="@Url.Action("Create","Appointment")"
               class="btn btn-success">
                <i class="fas fa-plus"></i> Book Appointment
            </a>
        </div>

    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- ✅ SEARCH -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text"
                               id="searchAppointment"
                               class="form-control"
                               placeholder="Search by Patient or Doctor"
                               onkeyup="searchAppointment()" />

                        <button class="btn btn-primary"
                                onclick="searchAppointment()">
                            Search
                        </button>
                    </div>
                </div>
            </div>

            <!-- ✅ TABLE -->
            <table class="table table-bordered table-hover"
                   id="appointmentTable">

                <thead class="table-light">
                    <tr>
                        <th>Appointment Id</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                No appointments found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var appointment in Model)
                        {
                            <tr>
                                <td>@appointment.AppointmentId</td>
                                <td>@appointment.PatientName</td>
                                <td>@appointment.DoctorName</td>
                                <td>@appointment.ScheduledDate.ToString("dd MMM yyyy")</td>
                                <td>@appointment.TimeSlot</td>

                                <td>
                                    @if (appointment.Status.ToString() == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (appointment.Status.ToString() == "Confirmed")
                                    {
                                        <span class="badge bg-success">Confirmed</span>
                                    }
                                    else if (appointment.Status.ToString() == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else if (appointment.Status.ToString() == "Completed")
                                    {
                                        <span class="badge bg-primary">Completed</span>
                                    }
                                </td>

                                <td>
                                    <a href="@Url.Action("Details","Appointment",
                                                new { id = appointment.AppointmentId })"
                                       class="btn btn-info btn-sm">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>

<!-- ✅ SEARCH SCRIPT -->
<script>
    function searchAppointment() {

        let input = document.getElementById("searchAppointment").value.toLowerCase();
        let rows = document.querySelectorAll("#appointmentTable tbody tr");

        rows.forEach(row => {

            let patient = row.cells[1].innerText.toLowerCase();
            let doctor = row.cells[2].innerText.toLowerCase();

            if (patient.includes(input) || doctor.includes(input)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }

        });
    }
</script>
