@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_Alerts")

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Appointment Management</h2>

        <a href="@Url.Action("Create", "Appointment")"
           class="btn btn-success">
            <i class="fas fa-plus"></i> Book Appointment
        </a>
    </div>

    <!-- SEARCH -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            @using (Html.BeginForm("Index", "Appointment", FormMethod.Get))
            {
                <div class="input-group">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search by Appointment Id, Patient or Doctor" />

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
            }

        </div>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Appointment Id</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Time Slot</th>
                            <th>Status</th>
                            <th width="350">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var appointment in Model)
                            {
                                <tr>
                                    <td>@appointment.AppointmentId</td>
                                    <td>@appointment.PatientName</td>
                                    <td>@appointment.DoctorName</td>
                                    <td>@appointment.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>@appointment.TimeSlot</td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @appointment.Status
                                        </span>
                                    </td>

                                    <td>

                                        <!-- VIEW -->
                                        <a href="@Url.Action("Details", "Appointment", new { id = appointment.AppointmentId })"
                                           class="btn btn-info btn-sm text-white">
                                            <i class="fas fa-eye"></i> View
                                        </a>

                                        <!-- CONFIRM -->
                                        @if (appointment.Status.ToString() == "Pending")
                                        {
                                            using (Html.BeginForm("Confirm", "Appointment", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", appointment.AppointmentId)

                                                <button type="submit" class="btn btn-success btn-sm">
                                                    Confirm
                                                </button>
                                            }
                                        }

                                        <!-- COMPLETE -->
                                        @if (appointment.Status.ToString() == "Confirmed")
                                        {
                                            using (Html.BeginForm("Complete", "Appointment", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", appointment.AppointmentId)

                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    Complete
                                                </button>
                                            }
                                        }

                                        <!-- CANCEL -->
                                        @if (appointment.Status.ToString() != "Cancelled" &&
                                             appointment.Status.ToString() != "Completed")
                                        {
                                            <a href="@Url.Action("Cancel", "Appointment", new { id = appointment.AppointmentId })"
                                               class="btn btn-danger btn-sm">
                                                Cancel
                                            </a>
                                        }

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    No appointments found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>



