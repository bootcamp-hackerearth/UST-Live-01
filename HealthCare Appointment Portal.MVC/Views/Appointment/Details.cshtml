@model HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto

@{
    ViewBag.Title = "Appointment Details";
}

@Html.Partial("_Alerts")

<div class="container-fluid">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Appointment Details
        </h2>

        <a href="javascript:history.back()"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left"></i>

            Back

        </a>

    </div>

    <!-- DETAILS CARD -->

    <div class="card shadow-sm">

        <div class="card-body">

            <!-- APPOINTMENT ID -->

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>Appointment Id</strong>
                </div>

                <div class="col-md-9">
                    @Model.AppointmentId
                </div>

            </div>

            <hr />

            <!-- PATIENT -->

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>Patient</strong>
                </div>

                <div class="col-md-9">
                    @Model.PatientName
                </div>

            </div>

            <hr />

            <!-- DOCTOR -->

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>Doctor</strong>
                </div>

                <div class="col-md-9">
                    @Model.DoctorName
                </div>

            </div>

            <hr />

            <!-- DATE -->

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>Appointment Date</strong>
                </div>

                <div class="col-md-9">
                    @Model.ScheduledDate.ToString("dd MMM yyyy")
                </div>

            </div>

            <hr />

            <!-- TIME SLOT -->

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>Time Slot</strong>
                </div>

                <div class="col-md-9">
                    @Model.TimeSlot
                </div>

            </div>

            <hr />

            <!-- STATUS -->

            <div class="row mb-3">

                <div class="col-md-3">
                    <strong>Status</strong>
                </div>

                <div class="col-md-9">

                    @if (Model.Status.ToString() == "Pending")
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (Model.Status.ToString() == "Confirmed")
                    {
                        <span class="badge bg-success">
                            Confirmed
                        </span>
                    }
                    else if (Model.Status.ToString() == "Cancelled")
                    {
                        <span class="badge bg-danger">
                            Cancelled
                        </span>
                    }
                    else if (Model.Status.ToString() == "Completed")
                    {
                        <span class="badge bg-primary">
                            Completed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }

                </div>

            </div>

            <!-- CANCELLATION REASON -->

            @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
            {
                <hr />

                <div class="row mb-3">

                    <div class="col-md-3">
                        <strong>Cancellation Reason</strong>
                    </div>

                    <div class="col-md-9 text-danger">
                        @Model.CancellationReason
                    </div>

                </div>
            }

        </div>

    </div>

    <!-- ACTION BUTTONS -->

    <div class="mt-4">

        <!-- CONFIRM -->

        @if (Model.Status.ToString() == "Pending")
        {
            using (Html.BeginForm(
                "Confirm",
                "Appointment",
                new
                {
                    id = Model.AppointmentId
                },
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success me-2">

                    <i class="fas fa-check"></i>

                    Confirm Appointment

                </button>
            }
        }

        <!-- COMPLETE -->

        @if (Model.Status.ToString() == "Confirmed")
        {
            using (Html.BeginForm(
                "Complete",
                "Appointment",
                new
                {
                    id = Model.AppointmentId
                },
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary me-2">

                    <i class="fas fa-check-circle"></i>

                    Mark As Completed

                </button>
            }
        }

        <!-- CANCEL -->

        @if (Model.Status.ToString() != "Cancelled"
            && Model.Status.ToString() != "Completed")
        {
            <a href="@Url.Action(
                        "Cancel",
                        "Appointment",
                        new
                        {
                            id = Model.AppointmentId
                        })"
               class="btn btn-danger me-2">

                <i class="fas fa-times"></i>

                Cancel Appointment

            </a>
        }

    </div>

</div>