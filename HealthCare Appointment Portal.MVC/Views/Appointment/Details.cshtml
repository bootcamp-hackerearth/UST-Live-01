@model HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto

@{
    ViewBag.Title = "Appointment Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_Alerts")

<div class="container-fluid">

    <!-- HEADER -->
    <div class="mb-3">
        <h4>Appointment Details</h4>
    </div>

    <!-- DETAILS CARD -->
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-3"><strong>Appointment Id</strong></div>
                <div class="col-md-9">@Model.AppointmentId</div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Patient</strong></div>
                <div class="col-md-9">@Model.PatientName</div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Doctor</strong></div>
                <div class="col-md-9">@Model.DoctorName</div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Appointment Date</strong></div>
                <div class="col-md-9">
                    @Model.ScheduledDate.ToString("dd MMM yyyy")
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Time Slot</strong></div>
                <div class="col-md-9">@Model.TimeSlot</div>
            </div>

            <hr />

            <!-- STATUS -->
            <div class="row mb-3">
                <div class="col-md-3"><strong>Status</strong></div>
                <div class="col-md-9">

                    @if (Model.Status.ToString() == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (Model.Status.ToString() == "Confirmed")
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else if (Model.Status.ToString() == "Cancelled")
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                    else if (Model.Status.ToString() == "Completed")
                    {
                        <span class="badge bg-primary">Completed</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Model.Status</span>
                    }

                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
            {
                <hr />

                <div class="row mb-3">
                    <div class="col-md-3"><strong>Cancellation Reason</strong></div>
                    <div class="col-md-9 text-danger">
                        @Model.CancellationReason
                    </div>
                </div>
            }

        </div>
    </div>

    <!-- ✅ ACTION BUTTONS -->
    <div class="mt-3">

        <!-- CONFIRM -->
        @if (Model.Status.ToString() == "Pending")
        {
            using (Html.BeginForm("Confirm", "Appointment", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id", Model.AppointmentId)

                <button type="submit" class="btn btn-success">
                    Confirm
                </button>
            }
        }

        <!-- COMPLETE -->
        @if (Model.Status.ToString() == "Confirmed")
        {
            using (Html.BeginForm("Complete", "Appointment", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id", Model.AppointmentId)

                <button type="submit" class="btn btn-primary">
                    Complete
                </button>
            }
        }

        <!-- CANCEL -->
        @if (Model.Status.ToString() != "Cancelled" &&
     Model.Status.ToString() != "Completed")
        {
            <a href="@Url.Action("Cancel",
                         "Appointment",
                         new { id = Model.AppointmentId })"
               class="btn btn-danger">
                Cancel
            </a>
        }
        <!-- ✅ CLOSE BUTTON -->
        <a href="@Url.Action("Index","Appointment")"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>

@section Scripts
{
    <script>
    
    </script>
}
