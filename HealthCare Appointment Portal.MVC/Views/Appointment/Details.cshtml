@model HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto
@using HealthCare_Appointment_Portal.Enums

@{
    ViewBag.Title = "Appointment Details";

    string returnUrl =
        ViewBag.ReturnUrl as string;

    string backText =
        ViewBag.BackText as string;

    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl =
            Url.Action("MyAppointments", "Appointment");
    }

    if (string.IsNullOrWhiteSpace(backText))
    {
        backText =
            "Back to My Appointments";
    }
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Appointment Details
        </h2>

        <a href="@returnUrl"
           class="btn btn-secondary">
            @backText
        </a>

    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            <table class="table table-borderless">

                <tr>
                    <th style="width: 280px;">
                        Appointment Id
                    </th>
                    <td>
                        @Model.AppointmentId
                    </td>
                </tr>

                <tr>
                    <th>
                        Patient Id
                    </th>
                    <td>
                        @Model.PatientId
                    </td>
                </tr>

                <tr>
                    <th>
                        Patient
                    </th>
                    <td>
                        @Model.PatientName
                    </td>
                </tr>

                <tr>
                    <th>
                        Doctor Id
                    </th>
                    <td>
                        @Model.DoctorId
                    </td>
                </tr>

                <tr>
                    <th>
                        Doctor
                    </th>
                    <td>
                        @Model.DoctorName
                    </td>
                </tr>

                <tr>
                    <th>
                        Appointment Date
                    </th>
                    <td>
                        @Model.ScheduledDate.ToString("dd MMM yyyy")
                    </td>
                </tr>

                <tr>
                    <th>
                        Time Slot
                    </th>
                    <td>
                        @Model.TimeSlot
                    </td>
                </tr>

                <tr>
                    <th>
                        Status
                    </th>
                    <td>
                        @if (Model.Status == AppointmentStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == AppointmentStatus.Confirmed)
                        {
                            <span class="badge bg-success">
                                Confirmed
                            </span>
                        }
                        else if (Model.Status == AppointmentStatus.Cancelled)
                        {
                            <span class="badge bg-danger">
                                Cancelled
                            </span>
                        }
                        else if (Model.Status == AppointmentStatus.Completed)
                        {
                            <span class="badge bg-primary">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }
                    </td>
                </tr>

            </table>

        </div>

    </div>

</div>