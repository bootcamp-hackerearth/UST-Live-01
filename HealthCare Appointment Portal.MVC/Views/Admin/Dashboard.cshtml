@model HealthCare_Appointment_Portal_MVC.ViewModels.AdminDashboardViewModel

@{
    ViewBag.Title = "Admin Dashboard";
}

<div class="container-fluid">

    <!-- Back Button -->
    <div class="mb-4 d-flex justify-content-end">
        <a href="@Url.Action("DashboardSelection", "Home")"
           class="btn btn-outline-secondary back-btn">
            <i class="fas fa-arrow-left me-2"></i>
            Back to Dashboard Selection
        </a>
    </div>

    <!-- Welcome Banner -->
    <div class="card border-0 shadow-sm mb-4"
         style="background: linear-gradient(135deg,#1E3A7A,#2563EB,#4AA3D9);
                color:white;
                border-radius:20px;">

        <div class="card-body p-5">

            <h1 class="fw-bold">
                Admin Dashboard
            </h1>

            <p class="fs-5 mb-0">
                Welcome to HealthAxis Health Management System
            </p>

        </div>

    </div>

    <!-- Statistics -->
    <div class="row mb-4">

        <div class="col-md-3 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-users fa-3x text-primary mb-3"></i>

                    <h6 class="text-muted">
                        Total Patients
                    </h6>

                    <h2 class="fw-bold text-primary">
                        @Model.TotalPatients
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-user-doctor fa-3x text-success mb-3"></i>

                    <h6 class="text-muted">
                        Total Doctors
                    </h6>

                    <h2 class="fw-bold text-success">
                        @Model.TotalDoctors
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-calendar-check fa-3x text-warning mb-3"></i>

                    <h6 class="text-muted">
                        Appointments
                    </h6>

                    <h2 class="fw-bold text-warning">
                        @Model.TotalAppointments
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-file-medical fa-3x text-info mb-3"></i>

                    <h6 class="text-muted">
                        Health Records
                    </h6>

                    <h2 class="fw-bold text-info">
                        @Model.TotalHealthRecords
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->
    <div class="row">

        <!-- Patient Management -->
        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-users fa-4x text-primary mb-3"></i>

                    <h4 class="fw-bold">
                        Patients
                    </h4>

                    <p class="text-muted">
                        Manage patient records and information.
                    </p>

                    <a href="@Url.Action("Index", "Patient")"
                       class="btn btn-primary w-100 mb-2">

                        <i class="fas fa-list me-2"></i>
                        View Patients

                    </a>

                    <a href="@Url.Action("Create", "Patient")"
                       class="btn btn-outline-primary w-100">

                        <i class="fas fa-user-plus me-2"></i>
                        Add Patient

                    </a>

                </div>

            </div>

        </div>

        <!-- Doctor Management -->
        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-user-doctor fa-4x text-success mb-3"></i>

                    <h4 class="fw-bold">
                        Doctors
                    </h4>

                    <p class="text-muted">
                        Manage doctor profiles and availability.
                    </p>

                    <a href="@Url.Action("Index", "Doctor")"
                       class="btn btn-success w-100 mb-2">

                        <i class="fas fa-list me-2"></i>
                        View Doctors

                    </a>

                    <a href="@Url.Action("Create", "Doctor")"
                       class="btn btn-outline-success w-100">

                        <i class="fas fa-user-plus me-2"></i>
                        Add Doctor

                    </a>

                </div>

            </div>

        </div>

        <!-- Appointment Management -->
        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-calendar-check fa-4x text-warning mb-3"></i>

                    <h4 class="fw-bold">
                        Appointments
                    </h4>

                    <p class="text-muted">
                        Monitor and manage appointment schedules.
                    </p>

                    <a href="@Url.Action("Index", "Appointment")"
                       class="btn btn-warning text-white w-100">

                        <i class="fas fa-calendar-alt me-2"></i>
                        View Appointments

                    </a>

                </div>

            </div>

        </div>

        <!-- Health Records -->
        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-file-medical fa-4x text-info mb-3"></i>

                    <h4 class="fw-bold">
                        Health Records
                    </h4>

                    <p class="text-muted">
                        Access and manage patient medical records.
                    </p>

                    <a href="@Url.Action("Index", "HealthRecord")"
                       class="btn btn-info text-white w-100">

                        <i class="fas fa-notes-medical me-2"></i>
                        View Records

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .card {
        border-radius: 20px;
        transition: all .3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .btn {
        border-radius: 10px;
        font-weight: 600;
    }

    .back-btn {
        padding: 10px 18px;
        font-weight: 600;
        background-color: #ffffff;
    }

        .back-btn:hover {
            transform: translateX(-3px);
        }
</style>