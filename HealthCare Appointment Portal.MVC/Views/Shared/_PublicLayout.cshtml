<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>

        @ViewBag.Title - HealthAxis Health

    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <style>

        body {
            background-color: #F8FAFC;
            min-height: 100vh;
        }

        /* NAVBAR */

        .navbar {
            background: linear-gradient(90deg, #1E3A7A, #2563EB) !important;
            box-shadow: 0 2px 10px rgba(0,0,0,.15);
        }

        .navbar-logo {
            height: 55px;
            width: auto;
        }

        .navbar-brand {
            font-weight: 700;
            color: white !important;
        }

        .navbar-nav .nav-link {
            color: rgba(255,255,255,.90) !important;
            font-weight: 500;
            margin-left: 10px;
            transition: .3s;
        }

            .navbar-nav .nav-link:hover {
                color: white !important;
                transform: translateY(-1px);
            }

        /* MAIN CONTENT */

        main {
            min-height: calc(100vh - 140px);
        }

        /* FOOTER */

        footer {
            background: #0F172A;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
        }

        /* MOBILE */

        @@media(max-width:991px) {

            .navbar-logo {
                height: 45px;
            }

            .navbar-nav {
                margin-top: 10px;
            }

                .navbar-nav .nav-link {
                    margin-left: 0;
                }
        }
    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center"
               href="@Url.Action("Index","Home")">

                <img src="@Url.Content("~/Content/Images/healthaxis-logo.png")"
                     alt="HealthAxis Logo"
                     class="navbar-logo me-2" />

                <span>

                    HealthAxis Health

                </span>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent"
                    aria-controls="navbarContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","Home")">

                            Home

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#about">

                            About

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#services">

                            Services

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#contact">

                            Contact

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- PAGE CONTENT -->

    <main>

        @RenderBody()

    </main>

    <!-- FOOTER -->

    <footer>

        <div class="container">

            <h5 class="mb-2">

                HealthAxis Health

            </h5>

            <p class="mb-1">

                Smart Healthcare Management System

            </p>

            <small>

                © @DateTime.Now.Year HealthAxis Health.
                All Rights Reserved.

            </small>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>