<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <title>@ViewBag.Title - Healthcare Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f8fafc;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(90deg, #0f172a, #1e3a8a, #2563eb) !important;
            padding: 16px 30px;
            box-shadow: 0 6px 20px rgba(15, 23, 42, .25);
        }

        .navbar-brand {
            color: white !important;
            font-size: 1.5rem;
            font-weight: 800;
        }

        .nav-link {
            color: white !important;
            font-weight: 700;
            margin-left: 22px;
        }

            .nav-link:hover {
                color: #bfdbfe !important;
            }

        .page-container {
            padding-top: 40px;
            padding-bottom: 50px;
        }

        .card {
            border: none;
            border-radius: 22px;
            box-shadow: 0 15px 35px rgba(15, 23, 42, .12);
        }

        .card-header {
            background: linear-gradient(90deg, #0f172a, #1e40af);
            color: white;
            font-weight: 800;
            border: none;
        }

        .btn {
            border-radius: 12px;
            font-weight: 700;
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: none;
        }

        .btn-success {
            background: linear-gradient(135deg, #16a34a, #15803d);
            border: none;
        }

        .btn-info {
            background: linear-gradient(135deg, #06b6d4, #0891b2);
            border: none;
            color: white;
        }

        .btn-warning {
            background: linear-gradient(135deg, #facc15, #f59e0b);
            border: none;
        }

        .btn-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            border: none;
        }

        .btn-secondary {
            background: linear-gradient(135deg, #64748b, #475569);
            border: none;
        }

        .form-control,
        .form-select {
            border-radius: 12px;
            padding: 12px;
        }

        .table th {
            background: #f1f5f9;
        }

        .dashboard-btn {
            height: 62px;
            font-size: 1.15rem;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">

            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="fas fa-hospital-user me-2"></i>
                Healthcare Management System
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">
                            <i class="fas fa-home me-1"></i> Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Create", "Patient")">
                            <i class="fas fa-user-injured me-1"></i> Patient Login
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Create", "Doctor")">
                            <i class="fas fa-user-doctor me-1"></i> Doctor Login
                        </a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>

    <div class="container page-container">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>