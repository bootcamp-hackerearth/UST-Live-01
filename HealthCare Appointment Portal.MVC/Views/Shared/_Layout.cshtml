<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
        @ViewBag.Title - HealthAxis Health
    </title>

    <!-- ✅ CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <!-- STYLE -->
    <style>

        :root {
            --primary-dark: #1E3A7A;
            --primary-blue: #2563EB;
            --primary-light: #4AA3D9;
            --background-color: #F3F4F6;
            --card-background: #FFFFFF;
            --text-dark: #1F2937;
        }

        body {
            background-color: var(--background-color);
            color: var(--text-dark);
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(90deg, var(--primary-dark), var(--primary-blue), var(--primary-light)) !important;
            box-shadow: 0 2px 12px rgba(0,0,0,.15);
        }

        .navbar-logo {
            height: 55px;
        }

        .page-container {
            margin-top: 30px;
            margin-bottom: 30px;
        }

        .card {
            border-radius: 18px;
            box-shadow: 0 4px 16px rgba(0,0,0,.08);
        }

        .btn {
            border-radius: 10px;
        }
    </style>

</head>

<body>

    <!-- ✅ NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">

            <a class="navbar-brand"
               href="@Url.Action("Index","Home")">
                HealthAxis
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index","Home")">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index","Patient")">
                            Patients
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index","Doctor")">
                            Doctors
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index","Appointment")">
                            Appointments
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index","HealthRecord")">
                            Health Records
                        </a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>

    <!-- ✅ PAGE CONTENT -->
    <div class="container page-container">
        @RenderBody()
    </div>

    <!-- ✅ FOOTER -->
    <footer class="text-center py-3 mt-5 text-muted">
        © 2026 Healthcare Management System
    </footer>

    <!-- ✅ ✅ REQUIRED SCRIPTS (VERY IMPORTANT) -->
    <!-- JQUERY -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- BOOTSTRAP JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- PAGE SPECIFIC SCRIPTS -->
    @RenderSection("Scripts", required: false)

</body>
</html>