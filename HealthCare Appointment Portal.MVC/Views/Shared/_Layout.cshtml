@{
    var role =
        Session["Role"]?.ToString();

    var userCode =
        Session["UserCode"]?.ToString();
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewBag.Title - HealthAxis Health
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <style>

        :root {
            --primary-dark: #1E3A7A;
            --primary-blue: #2563EB;
            --primary-light: #4AA3D9;
            --background-color: #F3F4F6;
            --card-background: #FFFFFF;
            --text-dark: #1F2937;
            --text-muted: #6B7280;
            --success-color: #16A34A;
            --warning-color: #F59E0B;
            --danger-color: #DC2626;
        }

        body {
            background-color: var(--background-color);
            color: var(--text-dark);
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(90deg, var(--primary-dark), var(--primary-blue), var(--primary-light)) !important;
            box-shadow: 0 2px 12px rgba(0,0,0,.15);
        }

        .navbar-brand {
            font-weight: 600;
        }

        .navbar-logo {
            height: 55px;
            width: auto;
            object-fit: contain;
        }

        .navbar-nav .nav-link {
            color: rgba(255,255,255,.90) !important;
            font-size: 1rem;
            font-weight: 500;
            margin-right: 8px;
            transition: all .2s ease;
        }

            .navbar-nav .nav-link:hover {
                color: #ffffff !important;
                transform: translateY(-1px);
            }

        .card {
            background-color: var(--card-background);
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0,0,0,.08);
        }

        .card-header {
            background: linear-gradient(90deg, var(--primary-dark), var(--primary-blue));
            color: white;
            font-weight: 600;
            border: none;
        }

        .btn-primary {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
        }

            .btn-primary:hover {
                background-color: #1D4ED8;
                border-color: #1D4ED8;
            }

        .btn-success {
            background-color: var(--success-color);
            border-color: var(--success-color);
        }

        .btn-warning {
            background-color: var(--warning-color);
            border-color: var(--warning-color);
        }

        .btn-danger {
            background-color: var(--danger-color);
            border-color: var(--danger-color);
        }

        .profile-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: #ffffff;
            color: var(--primary-dark);
            font-size: 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0,0,0,.15);
        }

        .navbar .dropdown-toggle::after {
            display: none;
        }

        .dropdown-menu {
            min-width: 220px;
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0,0,0,.12);
        }

        .dropdown-header {
            font-weight: 600;
        }

        .page-container {
            margin-top: 30px;
            margin-bottom: 30px;
        }

        .dropdown-item:hover {
            background-color: #f3f4f6;
        }

        @@media(max-width:991px) {

            .navbar-logo {
                height: 45px;
            }

            .profile-avatar {
                margin-top: 10px;
            }
        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container-fluid">

            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center"
               href="@Url.Action("Index", "Home")">

                <img src="@Url.Content("~/Content/Images/healthaxis-logo.png")"
                     alt="HealthAxis Health"
                     class="navbar-logo" />

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav me-auto">

                    @if (role == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Dashboard", "Admin")">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Patient")">
                                Patients
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Doctor")">
                                Doctors
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Appointment")">
                                Appointments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "HealthRecord")">
                                Health Records
                            </a>
                        </li>
                    }

                    @if (role == "Doctor")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Dashboard", "Doctor")">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("TodaySchedule", "Appointment")">
                                Today's Schedule
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("WeeklySchedule", "Appointment")">
                                Weekly Schedule
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("DoctorRecords", "HealthRecord")">
                                Health Records
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Patient")">
                                Patients
                            </a>
                        </li>
                    }

                    @if (role == "Patient")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Dashboard", "Patient")">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Create", "Appointment")">
                                Book Appointment
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("MyAppointments", "Appointment")">
                                My Appointments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("PatientHistory", "HealthRecord")">
                                Health History
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index", "Doctor")">
                                Doctors
                            </a>
                        </li>
                    }

                </ul>

                @if (Session["UserId"] != null)
                {
                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item dropdown">

                            <a class="nav-link"
                               href="#"
                               id="profileDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <div class="profile-avatar">

                                    @(string.IsNullOrWhiteSpace(userCode)
                                        ? "U"
                                        : userCode.Substring(0, 1).ToUpper())

                                </div>

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>

                                    <h6 class="dropdown-header">
                                        @userCode
                                    </h6>

                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                @if (role == "Patient")
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           href="@Url.Action("MyProfile", "Patient")">

                                            <i class="fas fa-user me-2"></i>

                                            My Profile

                                        </a>
                                    </li>
                                }

                                @if (role == "Doctor")
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           href="@Url.Action("MyProfile", "Doctor")">

                                            <i class="fas fa-user me-2"></i>

                                            My Profile

                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>

                                    <a class="dropdown-item text-danger"
                                       href="@Url.Action("Logout", "User")">

                                        <i class="fas fa-sign-out-alt me-2"></i>

                                        Logout

                                    </a>

                                </li>

                            </ul>

                        </li>

                    </ul>
                }

            </div>

        </div>

    </nav>

    <div class="container page-container">

        @RenderBody()

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection(
        "Scripts",
        required: false)

</body>

</html>