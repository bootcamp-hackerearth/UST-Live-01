











<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewBag.Title - Healthcare Management System
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <style>

        :root {
            --primary-dark: #0F172A;
            --primary-blue: #334155;
            --primary-light: #64748B;
            --background-color: #F8FAFC;
            --card-background: #FFFFFF;
        }

        body {
            background-color: var(--background-color);
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient( 90deg, var(--primary-dark), var(--primary-blue), var(--primary-light) ) !important;
            box-shadow: 0 2px 12px rgba(0,0,0,.15);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
        }

        .navbar-nav .nav-link {
            color: rgba(255,255,255,.95) !important;
            font-weight: 500;
            margin-left: 10px;
            transition: .2s;
        }

            .navbar-nav .nav-link:hover {
                color: #ffffff !important;
                transform: translateY(-1px);
            }

        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0,0,0,.08);
        }

        .card-header {
            background: linear-gradient( 90deg, var(--primary-dark), var(--primary-blue) );
            color: white;
            border: none;
        }

        .page-container {
            margin-top: 30px;
            margin-bottom: 30px;
        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container-fluid">

            <a class="navbar-brand"
               href="@Url.Action("Index","Home")">

                <i class="fas fa-hospital-alt me-2"></i>

                Healthcare Management System

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","Patient")">

                            <i class="fas fa-users me-1"></i>

                            Patients

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","Doctor")">

                            <i class="fas fa-user-doctor me-1"></i>

                            Doctors

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","Appointment")">

                            <i class="fas fa-calendar-check me-1"></i>

                            Appointments

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","HealthRecord")">

                            <i class="fas fa-file-medical me-1"></i>

                            Health Records

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <div class="container page-container">

        @RenderBody()

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>