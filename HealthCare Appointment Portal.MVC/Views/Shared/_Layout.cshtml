@{
    var role = Session["Role"]?.ToString();
    var userCode = Session["UserCode"]?.ToString();
}

<!DOCTYPE html>

<html lang="en" xml:lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewBag.Title - HealthAxis Health
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <style>

        :root {
            --primary-dark: #1E3A8A;
            --primary-blue: #2563EB;
            --primary-light: #4AA3D9;
            --bg-color: #F8FAFC;
            --text-dark: #1F2937;
        }

        body {
            background: var(--bg-color);
            color: var(--text-dark);
            min-height: 100vh;
        }

        /* NAVBAR */

        .navbar {
            background: linear-gradient( 135deg, var(--primary-dark), var(--primary-blue) ) !important;
            box-shadow: 0 4px 15px rgba(0,0,0,.15);
        }

        .navbar-brand {
            font-weight: 700;
        }

        .navbar-logo {
            height: 55px;
            width: auto;
        }

        .navbar-nav .nav-link {
            color: rgba(255,255,255,.9) !important;
            font-weight: 500;
            transition: .3s;
        }

            .navbar-nav .nav-link:hover {
                color: white !important;
                transform: translateY(-1px);
            }

        /* PROFILE */

        .profile-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: white;
            color: var(--primary-dark);
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .dropdown-menu {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,.15);
            min-width: 220px;
        }

        /* PAGE */

        .page-container {
            margin-top: 30px;
            margin-bottom: 40px;
        }

        /* CARDS */

        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 4px 15px rgba(0,0,0,.08);
        }

        .card-header {
            background: linear-gradient( 135deg, var(--primary-dark), var(--primary-blue));
            color: white;
            border-radius: 18px 18px 0 0 !important;
        }

        /* BUTTONS */

        .btn-primary {
            background: var(--primary-blue);
            border-color: var(--primary-blue);
        }

            .btn-primary:hover {
                background: #1D4ED8;
                border-color: #1D4ED8;
            }

        footer {
            background: #0F172A;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 40px;
        }

        @@media(max-width:991px) {

            .navbar-logo {
                height: 45px;
            }
        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container-fluid">

            <!-- LOGO -->

            <a class="navbar-brand d-flex align-items-center"
               href="@Url.Action("Index","Home")">

                <img src="@Url.Content("~/Content/Images/healthaxis-logo.png")"
                     class="navbar-logo me-2"
                     alt="HealthAxis" />

                <span>
                    HealthAxis Health
                </span>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <!-- LEFT MENU -->

                <ul class="navbar-nav me-auto">

                    @if (role == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Dashboard","Admin")">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index","Patient")">
                                Patients
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index","Doctor")">
                                Doctors
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index","Appointment")">
                                Appointments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index","HealthRecord")">
                                Health Records
                            </a>
                        </li>
                    }

                    @if (role == "Doctor")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Dashboard","Doctor")">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("TodaySchedule","Appointment")">
                                Today's Schedule
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("WeeklySchedule","Appointment")">
                                Weekly Schedule
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("DoctorRecords","HealthRecord")">
                                Health Records
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index","Patient")">
                                Patients
                            </a>
                        </li>
                    }

                    @if (role == "Patient")
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Dashboard","Patient")">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Create","Appointment")">
                                Book Appointment
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("MyAppointments","Appointment")">
                                My Appointments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("PatientHistory","HealthRecord")">
                                Health History
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@Url.Action("Index","Doctor")">
                                Doctors
                            </a>
                        </li>
                    }

                </ul>

                <!-- PROFILE -->

                @if (Session["UserId"] != null)
                {
                    <ul class="navbar-nav">

                        <li class="nav-item dropdown">

                            <a class="nav-link"
                               href="#"
                               data-bs-toggle="dropdown">

                                <div class="profile-avatar">

                                    @(string.IsNullOrEmpty(userCode)
                                        ? "U"
                                        : userCode.Substring(0,1).ToUpper())

                                </div>

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>

                                    <h6 class="dropdown-header">

                                        @userCode

                                    </h6>

                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                @if (role == "Patient")
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           href="@Url.Action("MyProfile","Patient")">

                                            <i class="fas fa-user me-2"></i>

                                            My Profile

                                        </a>
                                    </li>
                                }

                                @if (role == "Doctor")
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           href="@Url.Action("MyProfile","Doctor")">

                                            <i class="fas fa-user me-2"></i>

                                            My Profile

                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>

                                    <a class="dropdown-item text-danger"
                                       href="@Url.Action("Logout","User")">

                                        <i class="fas fa-sign-out-alt me-2"></i>

                                        Logout

                                    </a>

                                </li>

                            </ul>

                        </li>

                    </ul>
                }

            </div>

        </div>

    </nav>

    <div class="container page-container">

        @RenderBody()

    </div>

    <footer>

        © @DateTime.Now.Year HealthAxis Health
        | Smart Healthcare Management System

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>