<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewBag.Title - HealthAxis Health
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <style>

        :root {
            --primary-dark: #1E3A7A;
            --primary-blue: #2563EB;
            --primary-light: #4AA3D9;
            --background-color: #F3F4F6;
            --card-background: #FFFFFF;
            --text-dark: #1F2937;
        }

        body {
            background-color: var(--background-color);
            color: var(--text-dark);
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient( 90deg, var(--primary-dark), var(--primary-blue), var(--primary-light) ) !important;
            box-shadow: 0 2px 12px rgba(0,0,0,.15);
        }

        .navbar-brand {
            font-weight: 600;
        }

        .navbar-logo {
            height: 55px;
            width: auto;
            object-fit: contain;
        }

        .navbar-nav .nav-link {
            color: rgba(255,255,255,.90) !important;
            font-size: 1rem;
            font-weight: 500;
            margin-right: 10px;
            transition: all .2s ease;
        }

            .navbar-nav .nav-link:hover {
                color: #ffffff !important;
                transform: translateY(-1px);
            }

        .page-container {
            margin-top: 30px;
            margin-bottom: 30px;
        }

        .card {
            background-color: var(--card-background);
            border: none;
            border-radius: 18px;
            box-shadow: 0 4px 16px rgba(0,0,0,.08);
            transition: .3s;
        }

            .card:hover {
                transform: translateY(-6px);
                box-shadow: 0 10px 25px rgba(0,0,0,.15);
            }

        .btn {
            border-radius: 10px;
        }

        .btn-primary {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
        }

            .btn-primary:hover {
                background-color: #1D4ED8;
                border-color: #1D4ED8;
            }

        footer {
            background-color: #ffffff;
            border-top: 1px solid #e5e7eb;
        }

        @@media(max-width:991px) {

            .navbar-logo {
                height: 45px;
            }
        }
    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container-fluid">

            <!-- LOGO -->

            <a class="navbar-brand d-flex align-items-center"
               href="@Url.Action("Index","Home")">

                <img src="@Url.Content("~/Content/Images/healthaxis-logo.png")"
                     alt="HealthAxis Health"
                     class="navbar-logo" />

            </a>

            <!-- TOGGLER -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- NAV LINKS -->

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","Home")">

                            <i class="fas fa-home me-1"></i>

                            Home

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","Patient")">

                            <i class="fas fa-users me-1"></i>

                            Patients

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","Doctor")">

                            <i class="fas fa-user-doctor me-1"></i>

                            Doctors

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","Appointment")">

                            <i class="fas fa-calendar-check me-1"></i>

                            Appointments

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Index","HealthRecord")">

                            <i class="fas fa-file-medical me-1"></i>

                            Health Records

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- PAGE CONTENT -->

    <div class="container page-container">

        @RenderBody()

    </div>

    <!-- FOOTER -->

    <footer class="text-center py-3 mt-5 text-muted">

           © 2026 Healthcare Management System 
      

    </footer>

    <!-- SCRIPTS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection(
        "Scripts",
        required: false)

</body>

</html>