<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title> @ViewBag.Title - Healthcare Management System </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(rgba(248,250,252,.82), rgba(248,250,252,.82)), url('/Content/Images/hospital-bg.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

            body::before {
                content: "";
                position: fixed;
                inset: 0;
                background: inherit;
                filter: blur(5px);
                transform: scale(1.04);
                z-index: -2;
            }

            body::after {
                content: "";
                position: fixed;
                inset: 0;
                background: rgba(255,255,255,.45);
                z-index: -1;
            }

        .navbar {
            background: linear-gradient(90deg, #0f172a, #1e3a8a, #2563eb) !important;
            padding: 18px 28px;
            box-shadow: 0 6px 20px rgba(0,0,0,.18);
        }

        .navbar-brand {
            color: white !important;
            font-size: 1.5rem;
            font-weight: 800;
        }

        .navbar-nav .nav-link {
            color: white !important;
            font-weight: 700;
            margin-left: 25px;
            font-size: 1.05rem;
        }

            .navbar-nav .nav-link:hover {
                color: #dbeafe !important;
            }

        .page-container {
            padding-top: 70px;
            padding-bottom: 60px;
        }

        h1, h2, h3 {
            font-weight: 800;
            color: #0f172a;
        }

        .card {
            border: none !important;
            border-radius: 18px !important;
            background: rgba(255,255,255,.92) !important;
            backdrop-filter: blur(8px);
            box-shadow: 0 14px 35px rgba(15,23,42,.16) !important;
        }

        .card-header {
            background: linear-gradient(90deg, #0f172a, #1e40af) !important;
            color: white !important;
            border-radius: 18px 18px 0 0 !important;
            padding: 16px 20px;
        }

        .form-control, .form-select {
            border-radius: 12px;
            padding: 12px 14px;
            border: 1px solid #dbe3ef;
        }

            .form-control:focus, .form-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 .2rem rgba(37,99,235,.2);
            }

        .btn {
            border-radius: 10px;
            font-weight: 700;
            padding: 9px 18px;
        }

        .table {
            background: white;
            border-radius: 12px;
            overflow: hidden;
        }

            .table th {
                background: #eef2f7 !important;
                color: #020617;
                font-weight: 800;
            }

        .modal-content {
            border-radius: 16px;
            overflow: hidden;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark"> <div class="container-fluid"> <a class="navbar-brand" href="@Url.Action("Index", "Home")"> <i class="fas fa-hospital-user me-2"></i> Healthcare Management System </a> <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"> <span class="navbar-toggler-icon"></span> </button> <div class="collapse navbar-collapse" id="navbarContent"> <ul class="navbar-nav ms-auto"> <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Home")"> <i class="fas fa-home me-1"></i> Home </a> </li> <li class="nav-item"> <a class="nav-link" href="@Url.Action("Create", "Patient")"> <i class="fas fa-user-injured me-1"></i> Patient </a> </li> <li class="nav-item"> <a class="nav-link" href="@Url.Action("Create", "Doctor")"> <i class="fas fa-user-doctor me-1"></i> Doctor </a> </li> </ul> </div> </div> </nav> <div class="container page-container"> @RenderBody() </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> @RenderSection("Scripts", required: false)
</body>
</html>