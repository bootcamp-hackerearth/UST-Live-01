@model IEnumerable<HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.HealthRecordDto>

@{
    ViewBag.Title = "Health Records";
}

@Html.Partial("_Alerts")

<div class="container-fluid">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Health Records
        </h2>

        <a href="@Url.Action("Create", "HealthRecord")"
           class="btn btn-success">

            <i class="fas fa-plus"></i>

            Add Record

        </a>

    </div>

    <!-- SEARCH -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            @using (Html.BeginForm(
                "Index",
                "HealthRecord",
                FormMethod.Get))
            {
                <div class="input-group">

                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search by Record Id, Patient, Doctor or Diagnosis" />

                    <button class="btn btn-primary">

                        <i class="fas fa-search"></i>

                        Search

                    </button>

                </div>
            }

        </div>

    </div>

    <!-- TABLE -->

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Record Id</th>

                        <th>Patient</th>

                        <th>Doctor</th>

                        <th>Specialisation</th>

                        <th>Visit Date</th>

                        <th>Diagnosis</th>

                        <th width="260">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var record in Model)
                        {
                            <tr>

                                <td>
                                    @record.RecordId
                                </td>

                                <td>
                                    @record.PatientName
                                </td>

                                <td>
                                    @record.DoctorName
                                </td>

                                <td>
                                    @record.Specialisation
                                </td>

                                <td>
                                    @record.VisitDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @record.Diagnosis
                                </td>

                                <td>

                                    <a href="@Url.Action(
                                                "Details",
                                                "HealthRecord",
                                                new { id = record.RecordId })"
                                       class="btn btn-info btn-sm text-white">

                                        <i class="fas fa-eye"></i>

                                        View

                                    </a>

                                    <a href="@Url.Action(
                                                "Edit",
                                                "HealthRecord",
                                                new { id = record.RecordId })"
                                       class="btn btn-warning btn-sm">

                                        <i class="fas fa-edit"></i>

                                        Edit

                                    </a>

                                    <a href="@Url.Action(
                                                "Delete",
                                                "HealthRecord",
                                                new { id = record.RecordId })"
                                       class="btn btn-danger btn-sm">

                                        <i class="fas fa-trash"></i>

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center text-muted py-4">

                                No health records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>