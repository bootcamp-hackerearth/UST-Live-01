@model IEnumerable<HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.HealthRecordDto>

@{
    ViewBag.Title = "Health Records";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Health Records
        </h2>

        <a href="@Url.Action(
            "SelectAppointment",
            "HealthRecord")"
           class="btn btn-success">

            Add Health Record

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-light">

                    <tr>

                        <th>
                            Record Id
                        </th>

                        <th>
                            Patient
                        </th>

                        <th>
                            Doctor
                        </th>

                        <th>
                            Specialisation
                        </th>

                        <th>
                            Visit Date
                        </th>

                        <th>
                            Diagnosis
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center">

                                No health records found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var record in Model)
                        {
                            <tr>

                                <td>
                                    @record.RecordId
                                </td>

                                <td>
                                    @record.PatientName
                                </td>

                                <td>
                                    @record.DoctorName
                                </td>

                                <td>
                                    @record.Specialisation
                                </td>

                                <td>
                                    @record.VisitDate.ToString(
                                        "dd MMM yyyy")
                                </td>

                                <td>
                                    @record.Diagnosis
                                </td>

                                <td>

                                    <button type="button"
                                            class="btn btn-info btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#recordModal_@record.RecordId">

                                        View

                                    </button>

                                </td>

                            </tr>
                            <div class="modal fade"
                                 id="recordModal_@record.RecordId"
                                 tabindex="-1">

                                <div class="modal-dialog modal-lg">

                                    <div class="modal-content">

                                        <div class="modal-header">

                                            <h5 class="modal-title">

                                                Health Record Details

                                            </h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>

                                        <div class="modal-body">

                                            <div class="row mb-2">

                                                <div class="col-md-6">

                                                    <strong>Record Id:</strong>
                                                    @record.RecordId

                                                </div>

                                                <div class="col-md-6">

                                                    <strong>Visit Date:</strong>
                                                    @record.VisitDate.ToString("dd MMM yyyy")

                                                </div>

                                            </div>

                                            <div class="row mb-2">

                                                <div class="col-md-6">

                                                    <strong>Patient:</strong>
                                                    @record.PatientName

                                                </div>

                                                <div class="col-md-6">

                                                    <strong>Doctor:</strong>
                                                    @record.DoctorName

                                                </div>

                                            </div>

                                            <div class="mb-2">

                                                <strong>Specialisation:</strong>
                                                @record.Specialisation

                                            </div>

                                            <div class="mb-2">

                                                <strong>Diagnosis:</strong>

                                                <div class="border rounded p-2">

                                                    @record.Diagnosis

                                                </div>

                                            </div>

                                            <div class="mb-2">

                                                <strong>Prescription:</strong>

                                                <div class="border rounded p-2">

                                                    @record.Prescription

                                                </div>

                                            </div>

                                            <div>

                                                <strong>Notes:</strong>

                                                <div class="border rounded p-2">

                                                    @record.Notes

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>