@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.UpdateHealthRecordDto

@{
    ViewBag.Title = "Edit Health Record";

    int recordId = ViewBag.RecordId;
    string returnUrl = ViewBag.ReturnUrl;
}

<div class="container mt-5">

    <h2 class="mb-4">
        Edit Health Record
    </h2>

    <div class="card shadow p-4">

        @using (Html.BeginForm("Edit", "HealthRecord", new { id = recordId, returnUrl = returnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                <label class="form-label">
                    Diagnosis
                </label>

                @Html.TextAreaFor(
                    m => m.Diagnosis,
                    new
                    {
                        @class = "form-control",
                        rows = "4"
                    })

                @Html.ValidationMessageFor(
                    m => m.Diagnosis,
                    "",
                    new
                    {
                        @class = "text-danger"
                    })
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Prescription
                </label>

                @Html.TextAreaFor(
                    m => m.Prescription,
                    new
                    {
                        @class = "form-control",
                        rows = "4"
                    })

                @Html.ValidationMessageFor(
                    m => m.Prescription,
                    "",
                    new
                    {
                        @class = "text-danger"
                    })
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Notes
                </label>

                @Html.TextAreaFor(
                    m => m.Notes,
                    new
                    {
                        @class = "form-control",
                        rows = "4"
                    })

                @Html.ValidationMessageFor(
                    m => m.Notes,
                    "",
                    new
                    {
                        @class = "text-danger"
                    })
            </div>

            <button type="submit"
                    class="btn btn-success">
                <i class="fas fa-save"></i>
                Save Changes
            </button>

            <a href="@returnUrl"
               class="btn btn-secondary">
                Back
            </a>
        }

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}