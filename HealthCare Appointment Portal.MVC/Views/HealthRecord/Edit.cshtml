@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.UpdateHealthRecordDto

@{
    ViewBag.Title = "Edit Health Record";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col">

            <h2>
                Edit Health Record
            </h2>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                if (ViewData.ModelState[""]?.Errors.Count > 0)
                {
                    @Html.ValidationSummary(
                        true,
                        "",
                        new
                        {
                            @class = "alert alert-danger"
                        })
                }

                <div class="mb-3">

                    <label class="form-label">
                        Diagnosis
                    </label>

                    @Html.TextAreaFor(
                        m => m.Diagnosis,
                        new
                        {
                            @class = "form-control",
                            rows = 4
                        })

                    @Html.ValidationMessageFor(
                        m => m.Diagnosis,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Prescription
                    </label>

                    @Html.TextAreaFor(
                        m => m.Prescription,
                        new
                        {
                            @class = "form-control",
                            rows = 4
                        })

                    @Html.ValidationMessageFor(
                        m => m.Prescription,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-4">

                    <label class="form-label">
                        Notes
                    </label>

                    @Html.TextAreaFor(
                        m => m.Notes,
                        new
                        {
                            @class = "form-control",
                            rows = 5
                        })

                    @Html.ValidationMessageFor(
                        m => m.Notes,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-warning">

                        Update Record

                    </button>

                    <a href="@Url.Action(
                                "Details",
                                "HealthRecord",
                                new
                                {
                                    id = ViewBag.RecordId
                                })"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}