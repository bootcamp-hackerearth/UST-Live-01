@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.UpdateHealthRecordDto

@{
    ViewBag.Title = "Edit Health Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* ⚠️ If _Alerts is breaking layout, keep it but ensure it's valid *@
@Html.Partial("_Alerts")

<div class="container-fluid">

    <div class="mb-3">
        <h4>Edit Health Record</h4>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @using (Html.BeginForm("Edit", "HealthRecord", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <!-- DIAGNOSIS -->
                <div class="mb-3">
                    <label class="form-label">Diagnosis</label>

                    @Html.TextAreaFor(m => m.Diagnosis, new
                    {
                        @class = "form-control",
                        rows = 4
                    })

                    @Html.ValidationMessageFor(m => m.Diagnosis, "", new { @class = "text-danger" })
                </div>

                <!-- PRESCRIPTION -->
                <div class="mb-3">
                    <label class="form-label">Prescription</label>

                    @Html.TextAreaFor(m => m.Prescription, new
                    {
                        @class = "form-control",
                        rows = 4
                    })

                    @Html.ValidationMessageFor(m => m.Prescription, "", new { @class = "text-danger" })
                </div>

                <!-- NOTES -->
                <div class="mb-3">
                    <label class="form-label">Notes</label>

                    @Html.TextAreaFor(m => m.Notes, new
                    {
                        @class = "form-control",
                        rows = 5
                    })

                    @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
                </div>

                <!-- BUTTONS -->
                <div class="mt-3">

                    <button type="submit" class="btn btn-warning">
                        Update Record
                    </button>

                    <a href="@Url.Action("Index", "HealthRecord")"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}