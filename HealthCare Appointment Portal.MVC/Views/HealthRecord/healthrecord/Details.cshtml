@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.HealthRecordDto

@{
    ViewBag.Title = "Health Record Details";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Health Record Details
        </h2>

        <a href="@Url.Action("DoctorRecords", "HealthRecord")"
           class="btn btn-secondary">
            Back to Health Records
        </a>

    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            <table class="table table-borderless">

                <tr>
                    <th style="width: 250px;">Record Id</th>
                    <td>@Model.RecordId</td>
                </tr>

                <tr>
                    <th>Appointment Id</th>
                    <td>@Model.AppointmentId</td>
                </tr>

                <tr>
                    <th>Patient Id</th>
                    <td>@Model.PatientId</td>
                </tr>

                <tr>
                    <th>Doctor Id</th>
                    <td>@Model.DoctorId</td>
                </tr>

                <tr>
                    <th>Visit Date</th>
                    <td>@Model.VisitDate.ToString("dd-MMM-yyyy")</td>
                </tr>

                <tr>
                    <th>Diagnosis</th>
                    <td>@Model.Diagnosis</td>
                </tr>

                <tr>
                    <th>Prescription</th>
                    <td>@Model.Prescription</td>
                </tr>

                <tr>
                    <th>Notes</th>
                    <td>@Model.Notes</td>
                </tr>

            </table>

        </div>

    </div>

</div>