@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.CreateHealthRecordDto

@{
    ViewBag.Title = "Add Health Record";

    string visitDateText =
        ViewBag.VisitDateText as string;

    if (string.IsNullOrWhiteSpace(visitDateText))
    {
        visitDateText =
            Model.VisitDate.ToString("dd-MMM-yyyy");
    }
}

<div class="container mt-5">

    <h2>
        Add Health Record
    </h2>

    <div class="card shadow border-0 rounded-4 mt-4">

        <div class="card-body p-4">

            @using (Html.BeginForm("Create", "HealthRecord", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class = "alert alert-danger"
                    })

                @Html.HiddenFor(m => m.AppointmentId)
                @Html.HiddenFor(m => m.PatientId)
                @Html.HiddenFor(m => m.DoctorId)
                @Html.HiddenFor(m => m.VisitDate)

                <div class="mb-3">

                    <label class="form-label">
                        Appointment Id
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.AppointmentId"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Patient Id
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.PatientId"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Doctor Id
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.DoctorId"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Visit Date
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@visitDateText"
                           readonly />

                    <small class="text-muted">
                        Visit date is taken from the appointment date. It cannot be edited.
                    </small>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Diagnosis <span class="text-danger">*</span>
                    </label>

                    @Html.TextAreaFor(
                        m => m.Diagnosis,
                        new
                        {
                            @class = "form-control",
                            rows = "4",
                            placeholder = "Enter diagnosis",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Diagnosis,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Prescription <span class="text-danger">*</span>
                    </label>

                    @Html.TextAreaFor(
                        m => m.Prescription,
                        new
                        {
                            @class = "form-control",
                            rows = "4",
                            placeholder = "Enter prescription",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Prescription,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Notes
                    </label>

                    @Html.TextAreaFor(
                        m => m.Notes,
                        new
                        {
                            @class = "form-control",
                            rows = "4",
                            placeholder = "Additional notes"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Notes,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Save Health Record
                </button>

                <a href="@Url.Action("UpcomingAppointments", "Doctor")"
                   class="btn btn-secondary">
                    Cancel
                </a>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}