@model IEnumerable<HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.HealthRecordDto>

@{
    ViewBag.Title = "My Health Records";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            My Health Record History
        </h2>

        <a href="@Url.Action("Dashboard", "Patient")"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center">
                    No health records found for this patient.
                </div>
            }
            else
            {
                <table class="table table-bordered table-hover">

                    <thead class="table-light">
                        <tr>
                            <th>Appointment Id</th>
                            <th>Patient Id</th>
                            <th>Doctor Id</th>
                            <th>Visit Date</th>
                            <th>Diagnosis</th>
                            <th>Prescription</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var record in Model)
                        {
                            <tr>
                                <td>@record.AppointmentId</td>
                                <td>@record.PatientId</td>
                                <td>@record.DoctorId</td>
                                <td>@record.VisitDate.ToString("dd-MMM-yyyy")</td>
                                <td>@record.Diagnosis</td>
                                <td>@record.Prescription</td>
                                <td>@record.Notes</td>
                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>