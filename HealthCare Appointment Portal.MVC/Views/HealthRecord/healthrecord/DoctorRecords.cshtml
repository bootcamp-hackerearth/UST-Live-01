@model IEnumerable<HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.HealthRecordDto>

@{
    ViewBag.Title = "Patient Health Records";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Patient Health Records
        </h2>

        <a href="@Url.Action("Dashboard", "Doctor")"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center">
                    No health records found.
                </div>
            }
            else
            {
                <div class="row mb-4">

                    <div class="col-md-6 mb-2">
                        <input type="text"
                               id="patientNameSearch"
                               class="form-control"
                               placeholder="Search by Patient Name" />
                    </div>

                    <div class="col-md-6 mb-2">
                        <input type="date"
                               id="dateSearch"
                               class="form-control" />
                    </div>

                </div>

                <table class="table table-bordered table-hover"
                       id="healthRecordsTable">

                    <thead class="table-light">
                        <tr>
                            <th>Record Id</th>
                            <th>Patient Name</th>
                            <th>Appointment Date</th>
                            <th>Visit Date</th>
                            <th>Diagnosis</th>
                            <th>Prescription</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var record in Model)
                        {
                            string dateForSearch =
                                record.VisitDate.ToString("yyyy-MM-dd");

                            <tr>
                                <td>
                                    @record.RecordId
                                </td>

                                <td class="patient-name">
                                    @record.PatientName
                                </td>

                                <td class="record-date"
                                    data-date="@dateForSearch">
                                    @record.VisitDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @record.VisitDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @record.Diagnosis
                                </td>

                                <td>
                                    @record.Prescription
                                </td>

                                <td>
                                    <a href="@Url.Action("Details", "HealthRecord", new { id = record.RecordId })"
                                       class="btn btn-info btn-sm text-white">
                                        View
                                    </a>

                                    <a href="@Url.Action("Edit", "HealthRecord", new { id = record.RecordId })"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>

<script>

    var patientNameSearch =
        document.getElementById("patientNameSearch");

    var dateSearch =
        document.getElementById("dateSearch");

    if (patientNameSearch) {
        patientNameSearch.addEventListener(
            "keyup",
            filterHealthRecords);
    }

    if (dateSearch) {
        dateSearch.addEventListener(
            "change",
            filterHealthRecords);
    }

    function filterHealthRecords() {

        var nameSearch =
            document.getElementById("patientNameSearch")
                .value
                .toLowerCase();

        var selectedDate =
            document.getElementById("dateSearch")
                .value;

        var rows =
            document.querySelectorAll(
                "#healthRecordsTable tbody tr");

        rows.forEach(function (row) {

            var patientName =
                row.querySelector(".patient-name")
                    .innerText
                    .toLowerCase();

            var recordDate =
                row.querySelector(".record-date")
                    .getAttribute("data-date");

            var nameMatch =
                patientName.includes(nameSearch);

            var dateMatch =
                selectedDate === "" ||
                recordDate === selectedDate;

            if (nameMatch && dateMatch) {
                row.style.display = "";
            }
            else {
                row.style.display = "none";
            }

        });
    }

</script>