@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.UpdateHealthRecordDto

@{
    ViewBag.Title = "Edit Health Record";
}

<div class="container mt-5">

    <h2>Edit Health Record</h2>

    <div class="card shadow border-0 rounded-4 mt-4">

        <div class="card-body p-4">

            @using (Html.BeginForm("Edit", "HealthRecord", new { id = ViewBag.RecordId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class = "alert alert-danger"
                    })

                <div class="mb-3">
                    <label class="form-label">Appointment Id</label>
                    <input type="text"
                           class="form-control"
                           value="@ViewBag.AppointmentId"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Patient Id</label>
                    <input type="text"
                           class="form-control"
                           value="@ViewBag.PatientId"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Doctor Id</label>
                    <input type="text"
                           class="form-control"
                           value="@ViewBag.DoctorId"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Visit Date</label>
                    <input type="text"
                           class="form-control"
                           value="@ViewBag.VisitDateText"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Diagnosis <span class="text-danger">*</span>
                    </label>

                    @Html.TextAreaFor(
                        m => m.Diagnosis,
                        new
                        {
                            @class = "form-control",
                            rows = "4",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Diagnosis,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Prescription <span class="text-danger">*</span>
                    </label>

                    @Html.TextAreaFor(
                        m => m.Prescription,
                        new
                        {
                            @class = "form-control",
                            rows = "4",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Prescription,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })
                </div>

                <div class="mb-3">
                    <label class="form-label">Notes</label>

                    @Html.TextAreaFor(
                        m => m.Notes,
                        new
                        {
                            @class = "form-control",
                            rows = "4"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Notes,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Save Changes
                </button>

                <a href="@Url.Action("DoctorRecords", "HealthRecord")"
                   class="btn btn-secondary">
                    Cancel
                </a>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}