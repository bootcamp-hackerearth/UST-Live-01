@model IEnumerable<HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.HealthRecordDto>

@{
    ViewBag.Title = "Doctor Health Records";
}

<style>

    .page-title {
        font-size: 3rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1rem;
    }

    .search-card {
        border: none;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(15,23,42,.08), 0 8px 16px rgba(15,23,42,.05);
    }

    .search-header {
        background: linear-gradient( 135deg, #020617, #0f172a);
        color: white;
        padding: 18px 28px;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .search-card .card-body {
        padding: 24px;
    }

    .form-control {
        height: 56px;
        border-radius: 16px;
        border: 1px solid #dbe2ea;
    }

    .table-card {
        border: none;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(15,23,42,.08), 0 8px 16px rgba(15,23,42,.05);
    }

    .record-table {
        margin-bottom: 0;
    }

        .record-table thead th {
            background: #0f172a;
            color: white;
            border: none;
            padding: 16px;
            font-weight: 600;
        }

        .record-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-color: #eef2f7;
        }

        .record-table tbody tr:hover {
            background: #f8fbff;
        }

    .patient-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient( 135deg, #2563eb, #1d4ed8);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: 12px;
    }

    .action-btn {
        border-radius: 999px;
        padding: 8px 18px;
        font-weight: 600;
    }

    .search-btn,
    .reset-btn {
        height: 56px;
        border-radius: 999px;
        font-weight: 600;
        min-width: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .search-btn {
        background: #2563eb;
        border-color: #2563eb;
    }

    .pagination {
        margin-top: 25px;
    }

    .pagination-pill {
        border-radius: 999px !important;
        min-width: 110px;
        height: 48px;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        background: white !important;
    }

    .page-number {
        border-radius: 999px !important;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pagination .page-link {
        border: none;
        color: #2563eb;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }

        .pagination .page-link:hover {
            background: #2563eb;
            color: white;
        }

    .pagination .active .page-link {
        background: #2563eb;
        color: white;
    }

    .back-btn {
        height: 56px;
        border-radius: 999px;
        min-width: 120px;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="page-title">

                Doctor Health Records

            </h1>

            <p class="page-subtitle">

                View and manage patient health records

            </p>

        </div>

        <a href="@Url.Action(
            "Dashboard",
            "Doctor")"
           class="btn btn-outline-secondary back-btn">

            <i class="bi bi-arrow-left me-2"></i>

            Back

        </a>

    </div>

    <div class="card search-card mb-4">

        <div class="search-header">

            Search Health Records

        </div>

        <div class="card-body">

            <form method="get"
                  action="@Url.Action(
                            "DoctorRecords",
                            "HealthRecord")">

                <input type="hidden"
                       name="page"
                       value="1" />

                <div class="row g-3">

                    <div class="col-lg-3">

                        <input type="text"
                               name="patient"
                               value="@ViewBag.Patient"
                               class="form-control"
                               placeholder="Patient Name" />

                    </div>

                    <div class="col-lg-3">

                        <input type="text"
                               name="diagnosis"
                               value="@ViewBag.Diagnosis"
                               class="form-control"
                               placeholder="Diagnosis" />

                    </div>

                    <div class="col-lg-2">

                        <input type="date"
                               name="visitDate"
                               value="@ViewBag.VisitDate"
                               class="form-control" />

                    </div>

                    <div class="col-lg-4 d-flex align-items-end">

                        <div class="d-flex gap-2 w-100 justify-content-end">

                            <button type="submit"
                                    class="btn btn-primary search-btn">

                                <i class="bi bi-search me-1"></i>

                                Search

                            </button>

                            <a href="@Url.Action(
                                        "DoctorRecords",
                                        "HealthRecord")"
                               class="btn btn-outline-secondary reset-btn">

                                Reset

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card table-card">

        <div class="card-body">

            <div class="mb-3 text-muted">

                Showing
                <strong>@ViewBag.TotalRecords</strong>
                records

            </div>
            <div class="table-responsive">

                <table class="table record-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                Record Id
                            </th>

                            <th>
                                Patient
                            </th>

                            <th>
                                Visit Date
                            </th>

                            <th>
                                Diagnosis
                            </th>

                            <th>
                                Prescription
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    No health records found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var record in Model)
                            {
                                <tr>

                                    <td>

                                        #@record.RecordId

                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="patient-avatar">

                                                @(string.IsNullOrWhiteSpace(
                                                    record.PatientName)
                                                    ? "?"
                                                    : record.PatientName
                                                        .Substring(0, 1)
                                                        .ToUpper())

                                            </div>

                                            @(string.IsNullOrWhiteSpace(
                                                record.PatientName)
                                                ? "Unknown Patient"
                                                : record.PatientName)

                                        </div>

                                    </td>

                                    <td>

                                        @record.VisitDate.ToString(
                                            "dd MMM yyyy")

                                    </td>

                                    <td>

                                        @record.Diagnosis

                                    </td>

                                    <td>

                                        @record.Prescription

                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm action-btn view-record-btn"
                                                    data-id="@record.RecordId">

                                                <i class="bi bi-eye me-1"></i>

                                                View

                                            </button>

                                            <a href="@Url.Action(
                                                        "Edit",
                                                        "HealthRecord",
                                                        new
                                                        {
                                                            id =
                                                            record.RecordId
                                                        })"
                                               class="btn btn-warning btn-sm action-btn">

                                                <i class="bi bi-pencil-square me-1"></i>

                                                Edit

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-4">

                    <ul class="pagination justify-content-center">

                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">

                                <a class="page-link pagination-pill"
                                   href="@Url.Action(
                            "DoctorRecords",
                            new
                            {
                                page = ViewBag.CurrentPage - 1,
                                patient = ViewBag.Patient,
                                diagnosis = ViewBag.Diagnosis,
                                visitDate = ViewBag.VisitDate
                            })">

                                    Previous

                                </a>

                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                                <a class="page-link page-number"
                                   href="@Url.Action(
                            "DoctorRecords",
                            new
                            {
                                page = i,
                                patient = ViewBag.Patient,
                                diagnosis = ViewBag.Diagnosis,
                                visitDate = ViewBag.VisitDate
                            })">

                                    @i

                                </a>

                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">

                                <a class="page-link pagination-pill"
                                   href="@Url.Action(
                            "DoctorRecords",
                            new
                            {
                                page = ViewBag.CurrentPage + 1,
                                patient = ViewBag.Patient,
                                diagnosis = ViewBag.Diagnosis,
                                visitDate = ViewBag.VisitDate
                            })">

                                    Next

                                </a>

                            </li>
                        }

                    </ul>

                </nav>
            }

        </div>

    </div>

</div>
<div class="modal fade"
     id="recordModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    Health Record Details

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body p-4"
                 id="recordContent">

                <div class="text-center py-5">

                    <div class="spinner-border text-primary">

                        <span class="visually-hidden">

                            Loading...

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        $(document).ready(function () {

            $(".alert")
                .delay(4000)
                .fadeOut("slow");

            $(document).on(
                "click",
                ".view-record-btn",
                function () {

                    var id =
                        $(this).data("id");

                    $("#recordContent")
                        .html(
                            '<div class="text-center py-5">' +
                            '<div class="spinner-border text-primary"></div>' +
                            '</div>');

                    $.ajax({

                        url:
                            '@Url.Action(
                                "GetRecordDetailsModal",
                                "HealthRecord")',

                        type:
                            "GET",

                        data:
                        {
                            id: id
                        },

                        success:
                            function (response) {

                                $("#recordContent")
                                    .html(response);

                                var modal =
                                    new bootstrap.Modal(
                                        document.getElementById(
                                            "recordModal"));

                                modal.show();
                            },

                        error:
                            function () {

                                $("#recordContent")
                                    .html(
                                        '<div class="alert alert-danger">' +
                                        'Failed to load health record details.' +
                                        '</div>');

                                var modal =
                                    new bootstrap.Modal(
                                        document.getElementById(
                                            "recordModal"));

                                modal.show();
                            }

                    });

                });

        });

    </script>
}
