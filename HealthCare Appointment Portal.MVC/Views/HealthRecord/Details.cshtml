@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.HealthRecordDto

@{
    ViewBag.Title = "Health Record Details";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Health Record Details
        </h2>

        <a href="javascript:history.back()"
           class="btn btn-secondary">

            Back

        </a>

    </div>

    <div class="card shadow-sm health-details-card">

        <div class="card-body">

            <div class="detail-row">
                <div class="detail-label">
                    Record Id
                </div>

                <div class="detail-value">
                    @Model.RecordId
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    Appointment Id
                </div>

                <div class="detail-value">
                    @Model.AppointmentId
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    Patient
                </div>

                <div class="detail-value">
                    @Model.PatientName
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    Doctor
                </div>

                <div class="detail-value">
                    @Model.DoctorName
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    Specialisation
                </div>

                <div class="detail-value">
                    @Model.Specialisation
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    Visit Date
                </div>

                <div class="detail-value">
                    @Model.VisitDate.ToString("dd MMM yyyy")
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    Diagnosis
                </div>

                <div class="detail-value">
                    @Model.Diagnosis
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    Prescription
                </div>

                <div class="detail-value">
                    @Model.Prescription
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="detail-row">
                    <div class="detail-label">
                        Notes
                    </div>

                    <div class="detail-value">
                        @Model.Notes
                    </div>
                </div>
            }

        </div>

    </div>

    @if (Session["Role"]?.ToString() == "Doctor")
    {
        <div class="mt-4">

            <a href="@Url.Action(
                        "Edit",
                        "HealthRecord",
                        new
                        {
                            id = Model.RecordId
                        })"
               class="btn btn-warning">

                Edit Record

            </a>

        </div>
    }

</div>

<style>
    .health-details-card {
        border-radius: 18px;
        border: none;
    }

    .detail-row {
        display: flex;
        align-items: flex-start;
        padding: 14px 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        width: 260px;
        min-width: 260px;
        font-weight: 700;
        color: #1f2937;
    }

    .detail-value {
        flex: 1;
        color: #374151;
        font-weight: 500;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .btn {
        border-radius: 10px;
        font-weight: 600;
    }

    .alert {
        border-radius: 12px;
        font-weight: 500;
    }

    @@media(max-width: 767px) {
        .detail-row {
            flex-direction: column;
            gap: 6px;
        }

        .detail-label {
            width: 100%;
            min-width: 100%;
        }

        .detail-value {
            width: 100%;
        }
    }
</style>