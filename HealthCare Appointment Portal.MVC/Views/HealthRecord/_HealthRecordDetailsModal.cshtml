@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.HealthRecordDto

@if (Model == null)
{
    <div class="alert alert-danger">

        Health record not found.

    </div>
}
else
{
    <style>

        .record-detail-card {
            background: #f8fafc;
            border-radius: 18px;
            padding: 18px;
            height: 100%;
            border: 1px solid #e2e8f0;
            transition: all .2s ease;
        }

            .record-detail-card:hover {
                background: #f1f5f9;
                transform: translateY(-2px);
            }

        .record-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 6px;
            letter-spacing: .5px;
        }

        .record-value {
            font-size: 15px;
            font-weight: 600;
            color: #0f172a;
            word-break: break-word;
        }

        .record-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient( 135deg, #2563eb, #1d4ed8);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .section-heading {
            font-size: 1.1rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0;
        }
    </style>

    <div class="container-fluid">

        <div class="d-flex align-items-center mb-4">

            <div class="record-icon me-3">

                <i class="bi bi-journal-medical"></i>

            </div>

            <div>

                <h5 class="section-heading">

                    Health Record Details

                </h5>

                <small class="text-muted">

                    Complete medical record information

                </small>

            </div>

        </div>

        <div class="row g-3">

            <div class="col-md-6">

                <div class="record-detail-card">

                    <div class="record-label">

                        Record Id

                    </div>

                    <div class="record-value">

                        #@Model.RecordId

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="record-detail-card">

                    <div class="record-label">

                        Visit Date

                    </div>

                    <div class="record-value">

                        @Model.VisitDate.ToString("dd MMM yyyy")

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="record-detail-card">

                    <div class="record-label">

                        Patient Name

                    </div>

                    <div class="record-value">

                        @(string.IsNullOrWhiteSpace(
                            Model.PatientName)
                            ? "N/A"
                            : Model.PatientName)

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="record-detail-card">

                    <div class="record-label">

                        Doctor Name

                    </div>

                    <div class="record-value">

                        @(string.IsNullOrWhiteSpace(
                            Model.DoctorName)
                            ? "N/A"
                            : Model.DoctorName)

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="record-detail-card">

                    <div class="record-label">

                        Specialisation

                    </div>

                    <div class="record-value">

                        @(string.IsNullOrWhiteSpace(
                            Model.Specialisation)
                            ? "N/A"
                            : Model.Specialisation)

                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="record-detail-card">

                    <div class="record-label">

                        Appointment Id

                    </div>

                    <div class="record-value">

                        #@Model.AppointmentId

                    </div>

                </div>

            </div>

            <div class="col-12">

                <div class="record-detail-card">

                    <div class="record-label">

                        Diagnosis

                    </div>

                    <div class="record-value">

                        <span class="badge bg-primary">

                            @(string.IsNullOrWhiteSpace(
                                Model.Diagnosis)
                                ? "N/A"
                                : Model.Diagnosis)

                        </span>

                    </div>

                </div>

            </div>

            <div class="col-12">

                <div class="record-detail-card">

                    <div class="record-label">

                        Prescription

                    </div>

                    <div class="record-value"
                         style="white-space: pre-wrap;">

                        @(string.IsNullOrWhiteSpace(
                            Model.Prescription)
                            ? "N/A"
                            : Model.Prescription)

                    </div>

                </div>

            </div>

            <div class="col-12">

                <div class="record-detail-card">

                    <div class="record-label">

                        Notes

                    </div>

                    <div class="record-value">

                        @if (string.IsNullOrWhiteSpace(
                            Model.Notes))
                        {
                            <span class="text-muted">

                                No Notes Available

                            </span>
                        }
                        else
                        {
                            @Model.Notes
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>
}
