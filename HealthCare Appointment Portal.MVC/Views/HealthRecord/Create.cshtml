@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.CreateHealthRecordDto

@{
    ViewBag.Title = "Add Health Record";
}

@Html.Partial("_Alerts")

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col">

            <h2 class="fw-bold">
                Add Health Record
            </h2>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class = "alert alert-danger"
                    })

                <!-- APPOINTMENT DROPDOWN -->

                <div class="mb-3">

                    <label class="form-label">
                        Appointment
                    </label>

                    @Html.DropDownListFor(
                        m => m.AppointmentId,
                        (SelectList)ViewBag.Appointments,
                        "-- Select Appointment --",
                        new
                        {
                            @class = "form-select",
                            id = "AppointmentId"
                        })

                    @Html.ValidationMessageFor(
                        m => m.AppointmentId,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <!-- VISIT DATE -->

                <div class="mb-3">

                    <label class="form-label">
                        Visit Date
                    </label>

                    <input type="text"
                           id="visitDate"
                           class="form-control"
                           readonly />

                </div>

                <!-- DIAGNOSIS -->

                <div class="mb-3">

                    <label class="form-label">
                        Diagnosis
                    </label>

                    @Html.TextAreaFor(
                        m => m.Diagnosis,
                        new
                        {
                            @class = "form-control",
                            rows = 4,
                            placeholder = "Enter diagnosis"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Diagnosis,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <!-- PRESCRIPTION -->

                <div class="mb-3">

                    <label class="form-label">
                        Prescription
                    </label>

                    @Html.TextAreaFor(
                        m => m.Prescription,
                        new
                        {
                            @class = "form-control",
                            rows = 4,
                            placeholder = "Enter prescription"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Prescription,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <!-- NOTES -->

                <div class="mb-4">

                    <label class="form-label">
                        Notes
                    </label>

                    @Html.TextAreaFor(
                        m => m.Notes,
                        new
                        {
                            @class = "form-control",
                            rows = 4,
                            placeholder = "Additional notes"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Notes,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <!-- BUTTONS -->

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-success">

                        <i class="fas fa-save"></i>

                        Save Health Record

                    </button>

                    <a href="@Url.Action("Index", "HealthRecord")"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>

        const appointmentDates = {

            @foreach (var item in (SelectList)ViewBag.Appointments)
            {
                <text>
                    "@item.Value":
                    "@ViewBag.AppointmentDates[item.Value.ToString()]",
                </text>
            }
        };

        document.addEventListener("DOMContentLoaded", function () {

            const appointmentDropdown =
                document.getElementById("AppointmentId");

            const visitDate =
                document.getElementById("visitDate");

            function updateDate() {

                const selectedId =
                    appointmentDropdown.value;

                visitDate.value =
                    appointmentDates[selectedId] || "";
            }

            appointmentDropdown.addEventListener(
                "change",
                updateDate);

            updateDate();
        });

    </script>
}