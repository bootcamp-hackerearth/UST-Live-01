@model HealthCare_Appointment_Portal.DTOs.HealthRecordDtos.CreateHealthRecordDto

@{
    ViewBag.Title = "Add Health Record";
}

<div class="container-fluid">

    <div class="row mb-4">

        <div class="col">

            <h2>
                Add Health Record
            </h2>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                if (ViewData.ModelState[""]?.Errors.Count > 0)
                {
                    @Html.ValidationSummary(
                        true,
                        "",
                        new
                        {
                            @class = "alert alert-danger"
                        })
                }

                @Html.HiddenFor(
                    m => m.AppointmentId)

                @Html.HiddenFor(
                    m => m.PatientId)

                @Html.HiddenFor(
                    m => m.DoctorId)

                @Html.HiddenFor(
                    m => m.VisitDate)

                <div class="mb-3">

                    <label class="form-label">
                        Appointment Id
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.AppointmentId"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Patient Id
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.PatientId"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Visit Date
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.VisitDate.ToString("dd MMM yyyy")"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Diagnosis
                    </label>

                    @Html.TextAreaFor(
                        m => m.Diagnosis,
                        new
                        {
                            @class = "form-control",
                            rows = 4,
                            placeholder = "Enter diagnosis"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Diagnosis,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Prescription
                    </label>

                    @Html.TextAreaFor(
                        m => m.Prescription,
                        new
                        {
                            @class = "form-control",
                            rows = 4,
                            placeholder = "Enter prescription"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Prescription,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-4">

                    <label class="form-label">
                        Notes
                    </label>

                    @Html.TextAreaFor(
                        m => m.Notes,
                        new
                        {
                            @class = "form-control",
                            rows = 4,
                            placeholder = "Additional notes"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Notes,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-success">

                        Save Health Record

                    </button>

                    <a href="javascript:history.back()"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}