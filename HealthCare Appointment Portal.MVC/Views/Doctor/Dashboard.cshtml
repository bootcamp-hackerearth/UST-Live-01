@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto

@{
    ViewBag.Title = "Doctor Dashboard";
}

<div class="container mt-5">

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-5">

            <h1>
                Hello, Dr. @Model.FullName
            </h1>

            <p class="lead">
                Welcome to your doctor dashboard.
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success mt-3">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mt-3">
                    @TempData["Error"]
                </div>
            }

            <div class="alert alert-info mt-3">
                <strong>Your Doctor ID:</strong> @Model.DoctorId
            </div>

            <hr />

            <div class="row mt-4">

                <div class="col-md-4 mb-3">
                    <a href="@Url.Action("UpcomingAppointments", "Doctor")"
                       class="btn btn-primary btn-lg w-100">
                        Upcoming Appointments
                    </a>
                </div>

                <div class="col-md-4 mb-3">
                    <a href="@Url.Action("DoctorRecords", "HealthRecord")"
                       class="btn btn-info btn-lg w-100 text-white">
                        View Patient Health Records
                    </a>
                </div>

                <div class="col-md-4 mb-3">
                    <a href="@Url.Action("EditMyProfile", "Doctor")"
                       class="btn btn-warning btn-lg w-100">
                        Update My Profile
                    </a>

                </div>

            </div>

        </div>
        <div class="row mt-3">
            <div class="col-md-6 mx-auto">
                <a href="@Url.Action("Logout", "Home")"
                   class="btn btn-danger btn-lg w-100">
                    Logout
                </a>
            </div>
        </div>
    </div>

</div>