@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto

@{
    ViewBag.Title = "Doctor Dashboard";
}

<style>
    .top-logout {
        text-align: right;
        margin-bottom: 15px;
    }

    .dash-card {
        background: linear-gradient(135deg, #0f172a, #064e3b);
        color: white;
        border-radius: 28px;
        padding: 45px;
    }

    .dash-box {
        border-radius: 20px;
        padding: 25px;
        color: white;
        text-align: center;
        font-weight: 700;
        text-decoration: none;
        min-height: 130px;
        display: block;
        transition: .3s;
    }

        .dash-box:hover {
            transform: translateY(-6px);
            color: white;
            box-shadow: 0 15px 35px rgba(0,0,0,.25);
        }

    .box-blue {
        background: linear-gradient(135deg, #2563eb, #06b6d4);
    }

    .box-cyan {
        background: linear-gradient(135deg, #0891b2, #0e7490);
    }

    .box-purple {
        background: linear-gradient(135deg, #7c3aed, #a855f7);
    }

    .box-yellow {
        background: linear-gradient(135deg, #f59e0b, #facc15);
        color: #111827 !important;
    }

    .dash-icon {
        font-size: 2.5rem;
        margin-bottom: 12px;
    }
</style>

<div class="container mt-4">

    <div class="top-logout">
        <a href="@Url.Action("Logout", "Home")"
           class="btn btn-danger btn-sm px-4">
            <i class="fas fa-right-from-bracket me-1"></i>
            Logout
        </a>
    </div>

    <div class="dash-card shadow">

        <h2 class="fw-bold">
            Hello, Dr. @Model.FullName
        </h2>

        <p>
            Welcome to your doctor dashboard.
        </p>

        <div class="alert alert-info mt-3">
            <strong>Your Doctor ID:</strong> @Model.DoctorId
        </div>

        <hr class="border-light" />

        <div class="row g-4 mt-2">

            <div class="col-md-4">
                <a href="@Url.Action("UpcomingAppointments", "Doctor")" class="dash-box box-blue">
                    <div class="dash-icon"><i class="fas fa-calendar-check"></i></div>
                    Appointments
                    <div class="small mt-2">Manage visits</div>
                </a>
            </div>

            <div class="col-md-4">
                <a href="@Url.Action("DoctorRecords", "HealthRecord")" class="dash-box box-cyan">
                    <div class="dash-icon"><i class="fas fa-file-medical"></i></div>
                    Health Records
                    <div class="small mt-2">Patient history</div>
                </a>
            </div>

            <div class="col-md-4">
                <a href="@Url.Action("MyProfile", "Doctor")" class="dash-box box-purple">
                    <div class="dash-icon"><i class="fas fa-user-doctor"></i></div>
                    My Profile
                    <div class="small mt-2">View details</div>
                </a>
            </div>

            <div class="col-md-6 mx-auto">
                <a href="@Url.Action("EditMyProfile", "Doctor")" class="dash-box box-yellow">
                    <div class="dash-icon"><i class="fas fa-user-pen"></i></div>
                    Update Profile
                    <div class="small mt-2">Edit details</div>
                </a>
            </div>

        </div>

    </div>

</div>