@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto

@{
    ViewBag.Title = "Doctor Dashboard";
}

<div class="container-fluid">

    <!-- Welcome Banner -->

    <div class="card border-0 shadow-sm mb-4"
         style="background: linear-gradient(135deg,#1E3A7A,#2563EB,#4AA3D9);
                color:white;
                border-radius:20px;">

        <div class="card-body p-5">

            <h1 class="fw-bold">
                Doctor Dashboard
            </h1>

            <p class="fs-5 mb-0">
                Welcome Dr. @Model.FullName
            </p>

        </div>

    </div>

    <!-- Statistics -->

    <div class="row mb-4">

        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-user-doctor fa-3x text-primary mb-3"></i>

                    <h6 class="text-muted">
                        Specialisation
                    </h6>

                    <h4 class="fw-bold">
                        @Model.Specialisation
                    </h4>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-briefcase-medical fa-3x text-success mb-3"></i>

                    <h6 class="text-muted">
                        Experience
                    </h6>

                    <h4 class="fw-bold">
                        @Model.YearsOfExperience Years
                    </h4>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-calendar-check fa-3x text-info mb-3"></i>

                    <h6 class="text-muted">
                        Upcoming Appointments
                    </h6>

                    <h2 class="fw-bold text-info">
                        @Model.UpcomingAppointmentCount
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="row">

        <!-- Doctor Profile -->

        <div class="col-lg-3 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-id-card fa-3x text-primary mb-3"></i>

                    <h4 class="fw-bold">
                        My Profile
                    </h4>

                    <p class="text-muted">
                        View your doctor profile details.
                    </p>

                    <a href="@Url.Action(
                                "Details",
                                "Doctor",
                                new
                                {
                                    id = Model.DoctorId
                                })"
                       class="btn btn-primary w-100">

                        View Profile

                    </a>

                </div>

            </div>

        </div>

        <!-- Today's Schedule -->

        <div class="col-lg-3 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-calendar-day fa-3x text-success mb-3"></i>

                    <h4 class="fw-bold">
                        Today's Schedule
                    </h4>

                    <p class="text-muted">
                        View today's appointments.
                    </p>

                    <a href="@Url.Action(
                                "TodaySchedule",
                                "Appointment")"
                       class="btn btn-success w-100">

                        View Schedule

                    </a>

                </div>

            </div>

        </div>

        <!-- Weekly Schedule -->

        <div class="col-lg-3 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-calendar-week fa-3x text-warning mb-3"></i>

                    <h4 class="fw-bold">
                        Weekly Schedule
                    </h4>

                    <p class="text-muted">
                        View weekly appointments.
                    </p>

                    <a href="@Url.Action(
                                "WeeklySchedule",
                                "Appointment")"
                       class="btn btn-warning w-100">

                        Weekly Schedule

                    </a>

                </div>

            </div>

        </div>

        <!-- Health Records -->

        <div class="col-lg-3 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-file-medical fa-3x text-info mb-3"></i>

                    <h4 class="fw-bold">
                        Health Records
                    </h4>

                    <p class="text-muted">
                        Manage patient health records.
                    </p>

                    <a href="@Url.Action(
                                "DoctorRecords",
                                "HealthRecord")"
                       class="btn btn-info text-white w-100">

                        View Records

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .card {
        border-radius: 20px;
        transition: all .3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .btn {
        border-radius: 10px;
        font-weight: 600;
    }
</style>