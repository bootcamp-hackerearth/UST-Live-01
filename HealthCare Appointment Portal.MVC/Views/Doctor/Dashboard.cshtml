@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto

@{
    ViewBag.Title = "Doctor Dashboard";
}

<div class="container-fluid">

    <!-- Welcome Banner -->

    <div class="card border-0 shadow-sm mb-4"
         style="background: linear-gradient(135deg,#1E3A7A,#2563EB,#4AA3D9);
                color:white;
                border-radius:20px;">

        <div class="card-body p-5">

            <h1 class="fw-bold">
                Doctor Dashboard
            </h1>

            <p class="fs-5 mb-0">
                Welcome Dr. @Model.FullName
            </p>

        </div>

    </div>

    <!-- Statistics -->

    <div class="row mb-4">

        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3">

                        <i class="fas fa-user-doctor
                                  fa-3x text-primary"></i>

                    </div>

                    <h6 class="text-muted">
                        Specialisation
                    </h6>

                    <h4 class="fw-bold">
                        @Model.Specialisation
                    </h4>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3">

                        <i class="fas fa-briefcase-medical
                                  fa-3x text-success"></i>

                    </div>

                    <h6 class="text-muted">
                        Experience
                    </h6>

                    <h4 class="fw-bold">
                        @Model.YearsOfExperience Years
                    </h4>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3">

                        <i class="fas fa-calendar-check
                                  fa-3x text-info"></i>

                    </div>

                    <h6 class="text-muted">
                        Upcoming Appointments
                    </h6>

                    <h2 class="fw-bold text-info">
                        @Model.UpcomingAppointmentCount
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="row">

        <div class="col-lg-4 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-calendar-day
                              fa-3x text-primary mb-3"></i>

                    <h4 class="fw-bold">
                        Today's Schedule
                    </h4>

                    <p class="text-muted">

                        View and manage today's appointments.

                    </p>

                    <a href="@Url.Action(
                                "TodaySchedule",
                                "Appointment")"
                       class="btn btn-primary w-100">

                        <i class="fas fa-calendar-day me-2"></i>

                        View Schedule

                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-4 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-calendar-week
                              fa-3x text-success mb-3"></i>

                    <h4 class="fw-bold">
                        Weekly Schedule
                    </h4>

                    <p class="text-muted">

                        Check upcoming appointments for the week.

                    </p>

                    <a href="@Url.Action(
                                "WeeklySchedule",
                                "Appointment")"
                       class="btn btn-success w-100">

                        <i class="fas fa-calendar-week me-2"></i>

                        Weekly Schedule

                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-4 mb-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <i class="fas fa-file-medical
                              fa-3x text-info mb-3"></i>

                    <h4 class="fw-bold">
                        Health Records
                    </h4>

                    <p class="text-muted">

                        Access and manage patient health records.

                    </p>

                    <a href="@Url.Action(
                                "DoctorRecords",
                                "HealthRecord")"
                       class="btn btn-info text-white w-100">

                        <i class="fas fa-notes-medical me-2"></i>

                        View Records

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .card {
        border-radius: 20px;
        transition: all .3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .btn {
        border-radius: 10px;
        font-weight: 600;
    }
</style>