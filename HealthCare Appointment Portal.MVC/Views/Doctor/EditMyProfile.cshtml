@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.UpdateDoctorDto

@{
    ViewBag.Title = "Edit My Profile";
}

<div class="container mt-5">

    <h2 class="mb-4">
        Edit My Profile
    </h2>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Success
                </div>
            }

            @using (Html.BeginForm("EditMyProfile", "Doctor", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                if (ViewData.ModelState[""] != null &&
                    ViewData.ModelState[""].Errors.Count > 0)
                {
                    @Html.ValidationSummary(
                        true,
                        "",
                        new
                        {
                            @class = "alert alert-danger"
                        })
                }

                <div class="mb-3">

                    <label class="form-label">
                        Full Name
                    </label>

                    @Html.TextBoxFor(
                        m => m.FullName,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.FullName,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Specialisation
                    </label>

                    @Html.EnumDropDownListFor(
                        m => m.Specialisation,
                        "-- Select Specialisation --",
                        new
                        {
                            @class = "form-select"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Specialisation,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Years Of Experience
                    </label>

                    @Html.TextBoxFor(
                        m => m.YearsOfExperience,
                        new
                        {
                            @class = "form-control",
                            type = "number",
                            min = "0"
                        })

                    @Html.ValidationMessageFor(
                        m => m.YearsOfExperience,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Consultation Fee
                    </label>

                    @Html.TextBoxFor(
                        m => m.ConsultationFee,
                        new
                        {
                            @class = "form-control",
                            type = "number",
                            step = "0.01",
                            min = "0"
                        })

                    @Html.ValidationMessageFor(
                        m => m.ConsultationFee,
                        "",
                        new
                        {
                            @class = "text-danger d-block mt-1"
                        })

                </div>

                @Html.HiddenFor(m => m.IsActive)

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a href="@Url.Action("Dashboard", "Doctor")"
                   class="btn btn-secondary">
                    Back to Dashboard
                </a>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}