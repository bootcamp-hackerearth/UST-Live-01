@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto

@{
    ViewBag.Title = "Doctor Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Doctor Details
        </h2>

        <a href="@Url.Action("Index","Doctor")"
           class="btn btn-secondary">

            Back

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-3">

                    <strong>
                        Doctor Id
                    </strong>

                </div>

                <div class="col-md-9">

                    @Model.DoctorId

                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">

                    <strong>
                        Full Name
                    </strong>

                </div>

                <div class="col-md-9">

                    @Model.FullName

                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">

                    <strong>
                        Specialisation
                    </strong>

                </div>

                <div class="col-md-9">

                    @Model.Specialisation

                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">

                    <strong>
                        Years Of Experience
                    </strong>

                </div>

                <div class="col-md-9">

                    @Model.YearsOfExperience Years

                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">

                    <strong>
                        Consultation Fee
                    </strong>

                </div>

                <div class="col-md-9">

                    Rs. @Model.ConsultationFee

                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">

                    <strong>
                        Status
                    </strong>

                </div>

                <div class="col-md-9">

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactive
                        </span>
                    }

                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-3">

                    <strong>
                        Upcoming Appointments
                    </strong>

                </div>

                <div class="col-md-9">

                    @Model.UpcomingAppointmentCount

                    @if (Session["Role"]?.ToString() == "Doctor")
                    {
                        <a href="@Url.Action(
                                    "WeeklySchedule",
                                    "Appointment")"
                           class="btn btn-link">

                            View Appointments

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

    @if (Session["Role"]?.ToString() == "Doctor")
    {
        <div class="mt-4">

            <a href="@Url.Action(
                        "TodaySchedule",
                        "Appointment")"
               class="btn btn-primary">

                Today's Schedule

            </a>

            <a href="@Url.Action(
                        "WeeklySchedule",
                        "Appointment")"
               class="btn btn-success">

                Weekly Schedule

            </a>

        </div>
    }

    @if (Session["Role"]?.ToString() == "Admin")
    {
        <div class="mt-4">

            <a href="@Url.Action(
                        "Edit",
                        "Doctor",
                        new
                        {
                            id = Model.DoctorId
                        })"
               class="btn btn-warning">

                Edit Doctor

            </a>

        </div>
    }

</div>