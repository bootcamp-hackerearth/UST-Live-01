@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto

@{
    Layout = null;
}

<div class="container-fluid">

    <div class="mb-3">
        <h4>Doctor Details</h4>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-3"><strong>Doctor Id</strong></div>
                <div class="col-md-9">@Model.DoctorId</div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Full Name</strong></div>
                <div class="col-md-9">@Model.FullName</div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Specialisation</strong></div>
                <div class="col-md-9">@Model.Specialisation</div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Years Of Experience</strong></div>
                <div class="col-md-9">@Model.YearsOfExperience Years</div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Consultation Fee</strong></div>
                <div class="col-md-9">Rs. @Model.ConsultationFee</div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Status</strong></div>
                <div class="col-md-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-3"><strong>Upcoming Appointments</strong></div>
                <div class="col-md-9">@Model.UpcomingAppointmentCount</div>
            </div>

        </div>
    </div>

    <!-- ✅ ACTION BUTTONS -->
    @if (Session["Role"]?.ToString() == "Admin")
    {
        <div class="mt-3">

            <!-- ✅ FIXED EDIT BUTTON -->
            <button class="btn btn-warning"
                    onclick="loadDoctorEdit(@Model.DoctorId)">
                Edit Doctor
            </button>

        </div>
    }

    <!-- ✅ CLOSE BUTTON -->
    <div class="mt-3">
        <button class="btn btn-secondary"
                data-bs-dismiss="modal">
            Close
        </button>
    </div>

</div>