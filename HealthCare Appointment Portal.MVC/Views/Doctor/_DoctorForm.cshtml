@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.CreateDoctorDto

<div class="mb-3">

    @Html.LabelFor(
        m => m.FullName,
        new
        {
            @class = "form-label"
        })

    @Html.TextBoxFor(
        m => m.FullName,
        new
        {
            @class = "form-control"
        })

    @Html.ValidationMessageFor(
        m => m.FullName,
        "",
        new
        {
            @class = "text-danger d-block mt-1"
        })

</div>

<div class="mb-3">

    @Html.LabelFor(
        m => m.Specialisation,
        new
        {
            @class = "form-label"
        })

    @Html.EnumDropDownListFor(
        m => m.Specialisation,
        "-- Select Specialisation --",
        new
        {
            @class = "form-select"
        })

    @Html.ValidationMessageFor(
        m => m.Specialisation,
        "",
        new
        {
            @class = "text-danger d-block mt-1"
        })

</div>

<div class="mb-3">

    @Html.LabelFor(
        m => m.YearsOfExperience,
        new
        {
            @class = "form-label"
        })

    @Html.TextBoxFor(
        m => m.YearsOfExperience,
        new
        {
            @class = "form-control",
            type = "number",
            min = "0"
        })

    @Html.ValidationMessageFor(
        m => m.YearsOfExperience,
        "",
        new
        {
            @class = "text-danger d-block mt-1"
        })

</div>

<div class="mb-4">

    @Html.LabelFor(
        m => m.ConsultationFee,
        new
        {
            @class = "form-label"
        })

    @Html.TextBoxFor(
        m => m.ConsultationFee,
        new
        {
            @class = "form-control",
            type = "number",
            step = "0.01",
            min = "1"
        })

    @Html.ValidationMessageFor(
        m => m.ConsultationFee,
        "",
        new
        {
            @class = "text-danger d-block mt-1"
        })

</div>
