@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>
@using HealthCare_Appointment_Portal.DTOs.HealthRecordDtos
@using System.Collections.Generic

@{
    ViewBag.Title = "Completed Appointments";

    TempData.Remove("Success");
    TempData.Remove("Error");
    TempData.Remove("UpcomingSuccess");
    TempData.Remove("UpcomingError");
    TempData.Remove("HealthRecordInfo");

    var healthRecords =
        ViewBag.HealthRecords as Dictionary<int, HealthRecordDto>;
}

<div class="container mt-5">

    <div class="d-flex justify-content-between mb-4">
        <h2>Completed Appointments</h2>

        <a href="@Url.Action("Dashboard", "Doctor")"
           class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>

    @if (TempData["CompletedSuccess"] != null)
    {
        <div class="modal fade" id="completedSuccessModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title">
                            <i class="fas fa-check-circle"></i>
                            Success
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">
                        @TempData["CompletedSuccess"]
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-success"
                                data-bs-dismiss="modal">
                            OK
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

    @if (TempData["CompletedError"] != null)
    {
        <div class="modal fade" id="completedErrorModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">
                            <i class="fas fa-triangle-exclamation"></i>
                            Error
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">
                        @TempData["CompletedError"]
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-danger"
                                data-bs-dismiss="modal">
                            OK
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

    <div class="card shadow p-4">

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center">
                No completed appointments found.
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-md-12">
                    <input type="text"
                           id="completedSearch"
                           class="form-control"
                           placeholder="Search by Appointment Id, Patient Name, Date, Time Slot" />
                </div>
            </div>

            <table class="table table-bordered table-hover" id="completedTable">

                <thead class="table-light">
                    <tr>
                        <th>Appointment Id</th>
                        <th>Patient Name</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var appointment in Model)
                    {
                        HealthRecordDto record = null;

                        if (healthRecords != null &&
                            healthRecords.ContainsKey(appointment.AppointmentId))
                        {
                            record = healthRecords[appointment.AppointmentId];
                        }

                        string appointmentModalId =
                            "appointmentModal" + appointment.AppointmentId;

                        string recordModalId =
                            "recordModal" + appointment.AppointmentId;

                        <tr>
                            <td class="appointment-id">
                                @appointment.AppointmentId
                            </td>

                            <td class="patient-name">
                                @appointment.PatientName
                            </td>

                            <td class="appointment-date">
                                @appointment.ScheduledDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td class="time-slot">
                                @appointment.TimeSlot
                            </td>

                            <td class="status-text">
                                <span class="badge bg-primary">
                                    Completed
                                </span>
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-info btn-sm text-white"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@appointmentModalId">
                                    <i class="fas fa-eye"></i>
                                    View
                                </button>

                                @if (record == null)
                                {
                                    <a href="@Url.Action("Create", "HealthRecord", new { appointmentId = appointment.AppointmentId })"
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-notes-medical"></i>
                                        Add Health Record
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-success btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#@recordModalId">
                                        <i class="fas fa-file-medical"></i>
                                        View Health Record
                                    </button>
                                }
                            </td>
                        </tr>
                    }

                    <tr id="completedNoDataRow" style="display:none;">
                        <td colspan="6"
                            class="text-center text-muted py-4">
                            No completed appointments found.
                        </td>
                    </tr>
                </tbody>

            </table>
        }

    </div>
</div>

@if (Model != null)
{
    foreach (var appointment in Model)
    {
        HealthRecordDto record = null;

        if (healthRecords != null &&
            healthRecords.ContainsKey(appointment.AppointmentId))
        {
            record = healthRecords[appointment.AppointmentId];
        }

        string appointmentModalId =
            "appointmentModal" + appointment.AppointmentId;

        string recordModalId =
            "recordModal" + appointment.AppointmentId;

        <div class="modal fade"
             id="@appointmentModalId"
             tabindex="-1">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header bg-info text-white">
                        <h5 class="modal-title">
                            <i class="fas fa-calendar-check"></i>
                            Appointment Details
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">

                        <table class="table table-bordered">
                            <tr>
                                <th>Appointment Id</th>
                                <td>@appointment.AppointmentId</td>
                            </tr>

                            <tr>
                                <th>Patient Name</th>
                                <td>@appointment.PatientName</td>
                            </tr>

                            <tr>
                                <th>Date</th>
                                <td>@appointment.ScheduledDate.ToString("dd-MMM-yyyy")</td>
                            </tr>

                            <tr>
                                <th>Time Slot</th>
                                <td>@appointment.TimeSlot</td>
                            </tr>

                            <tr>
                                <th>Status</th>
                                <td>Completed</td>
                            </tr>
                        </table>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>

                </div>

            </div>

        </div>

        if (record != null)
        {
            <div class="modal fade"
                 id="@recordModalId"
                 tabindex="-1">

                <div class="modal-dialog modal-dialog-centered modal-lg">

                    <div class="modal-content">

                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title">
                                <i class="fas fa-file-medical"></i>
                                Health Record Details
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal">
                            </button>
                        </div>

                        <div class="modal-body">

                            <table class="table table-bordered">
                                <tr>
                                    <th>Record Id</th>
                                    <td>@record.RecordId</td>
                                </tr>

                                <tr>
                                    <th>Appointment Id</th>
                                    <td>@record.AppointmentId</td>
                                </tr>

                                <tr>
                                    <th>Patient Id</th>
                                    <td>@record.PatientId</td>
                                </tr>

                                <tr>
                                    <th>Doctor Id</th>
                                    <td>@record.DoctorId</td>
                                </tr>

                                <tr>
                                    <th>Visit Date</th>
                                    <td>@record.VisitDate.ToString("dd-MMM-yyyy")</td>
                                </tr>

                                <tr>
                                    <th>Diagnosis</th>
                                    <td>@record.Diagnosis</td>
                                </tr>

                                <tr>
                                    <th>Prescription</th>
                                    <td>@record.Prescription</td>
                                </tr>

                                <tr>
                                    <th>Notes</th>
                                    <td>@record.Notes</td>
                                </tr>
                            </table>

                        </div>

                        <div class="modal-footer">

                            <a href="@Url.Action("Edit", "HealthRecord", new { id = record.RecordId, returnUrl = Url.Action("CompletedAppointments", "Doctor") })"
                               class="btn btn-warning">
                                <i class="fas fa-edit"></i>
                                Edit
                            </a>

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Close
                            </button>

                        </div>
                    </div>

                </div>

            </div>
        }
    }
}

<script>
    document.addEventListener("DOMContentLoaded", function () {

        var successElement =
            document.getElementById("completedSuccessModal");

        if (successElement) {
            new bootstrap.Modal(successElement).show();
        }

        var errorElement =
            document.getElementById("completedErrorModal");

        if (errorElement) {
            new bootstrap.Modal(errorElement).show();
        }

        var searchBox =
            document.getElementById("completedSearch");

        if (searchBox) {
            searchBox.addEventListener("keyup", filterCompletedAppointments);
        }
    });

    function filterCompletedAppointments() {
        var searchBox =
            document.getElementById("completedSearch");

        var searchValue =
            searchBox.value.toLowerCase().trim();

        var rows =
            document.querySelectorAll("#completedTable tbody tr:not(#completedNoDataRow)");

        var visibleCount =
            0;

        rows.forEach(function (row) {

            var appointmentId =
                row.querySelector(".appointment-id").innerText.toLowerCase();

            var patientName =
                row.querySelector(".patient-name").innerText.toLowerCase();

            var appointmentDate =
                row.querySelector(".appointment-date").innerText.toLowerCase();

            var timeSlot =
                row.querySelector(".time-slot").innerText.toLowerCase();

            var status =
                row.querySelector(".status-text").innerText.toLowerCase();

            var rowMatches =
                appointmentId.includes(searchValue) ||
                patientName.includes(searchValue) ||
                appointmentDate.includes(searchValue) ||
                timeSlot.includes(searchValue) ||
                status.includes(searchValue);

            if (searchValue === "" || rowMatches) {
                row.style.display = "";
                visibleCount++;
            }
            else {
                row.style.display = "none";
            }
        });

        var noDataRow =
            document.getElementById("completedNoDataRow");

        if (noDataRow) {
            noDataRow.style.display =
                visibleCount === 0 ? "" : "none";
        }
    }
</script>