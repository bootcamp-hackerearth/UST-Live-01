@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "Upcoming Appointments";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Upcoming Appointments</h2>

        <a href="@Url.Action("Dashboard", "Doctor")"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center">
                    No appointments found.
                </div>
            }
            else
            {
                <div class="row mb-4">

                    <div class="col-md-8 mb-2">
                        <input type="text"
                               id="commonSearch"
                               class="form-control"
                               placeholder="Search by Appointment Id, Patient Id, or Patient Name" />
                    </div>

                    <div class="col-md-4 mb-2">
                        <input type="date"
                               id="dateSearch"
                               class="form-control" />
                    </div>

                </div>

                <table class="table table-bordered table-hover"
                       id="appointmentsTable">

                    <thead class="table-light">
                        <tr>
                            <th>Appointment Id</th>
                            <th>Patient Id</th>
                            <th>Patient Name</th>
                            <th>Date</th>
                            <th>Time Slot</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var appointment in Model)
                        {
                            string status = appointment.Status.ToString();
                            string dateForSearch = appointment.ScheduledDate.ToString("yyyy-MM-dd");

                            <tr>
                                <td class="appointment-id">
                                    @appointment.AppointmentId
                                </td>

                                <td class="patient-id">
                                    @appointment.PatientId
                                </td>

                                <td class="patient-name">
                                    @appointment.PatientName
                                </td>

                                <td class="appointment-date"
                                    data-date="@dateForSearch">
                                    @appointment.ScheduledDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @appointment.TimeSlot
                                </td>

                                <td>
                                    @if (status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (status == "Confirmed")
                                    {
                                        <span class="badge bg-info text-dark">Confirmed</span>
                                    }
                                    else if (status == "Completed")
                                    {
                                        <span class="badge bg-primary">Completed</span>
                                    }
                                    else if (status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@status</span>
                                    }
                                </td>

                                <td>
                                    <a href="@Url.Action("Details", "Appointment", new { id = appointment.AppointmentId, returnUrl = Url.Action("UpcomingAppointments", "Doctor"), backText = "Back to Upcoming Appointments" })"
                                       class="btn btn-info btn-sm text-white">
                                        View
                                    </a>

                                    @if (status == "Pending")
                                    {
                                        using (Html.BeginForm("Confirm", "Appointment", new { id = appointment.AppointmentId }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-success btn-sm">
                                                Confirm
                                            </button>
                                        }

                                        <a href="@Url.Action("Cancel", "Appointment", new { id = appointment.AppointmentId })"
                                           class="btn btn-danger btn-sm">
                                            Cancel
                                        </a>
                                    }
                                    else if (status == "Confirmed")
                                    {
                                        using (Html.BeginForm("Complete", "Appointment", new { id = appointment.AppointmentId }, FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-primary btn-sm">
                                                Complete
                                            </button>
                                        }

                                        <a href="@Url.Action("Cancel", "Appointment", new { id = appointment.AppointmentId })"
                                           class="btn btn-danger btn-sm">
                                            Cancel
                                        </a>
                                    }
                                    else if (status == "Completed")
                                    {
                                        <a href="@Url.Action("Create", "HealthRecord", new { appointmentId = appointment.AppointmentId })"
                                           class="btn btn-warning btn-sm">
                                            Add Health Record
                                        </a>
                                    }
                                </td>
                            </tr>
                        }

                        <tr id="noDataRow" style="display:none;">
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                No appointments found.
                            </td>
                        </tr>

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>

<script>
    var commonSearch =
        document.getElementById("commonSearch");

    var dateSearch =
        document.getElementById("dateSearch");

    if (commonSearch) {
        commonSearch.addEventListener("keyup", filterAppointments);
    }

    if (dateSearch) {
        dateSearch.addEventListener("change", filterAppointments);
    }

    function filterAppointments() {

        var search =
            document.getElementById("commonSearch").value.toLowerCase();

        var selectedDate =
            document.getElementById("dateSearch").value;

        var rows =
            document.querySelectorAll("#appointmentsTable tbody tr:not(#noDataRow)");

        var visibleCount = 0;

        rows.forEach(function (row) {

            var appointmentId =
                row.querySelector(".appointment-id").innerText.toLowerCase();

            var patientId =
                row.querySelector(".patient-id").innerText.toLowerCase();

            var patientName =
                row.querySelector(".patient-name").innerText.toLowerCase();

            var appointmentDate =
                row.querySelector(".appointment-date").getAttribute("data-date");

            var textMatch =
                appointmentId.includes(search) ||
                patientId.includes(search) ||
                patientName.includes(search);

            var dateMatch =
                selectedDate === "" ||
                appointmentDate === selectedDate;

            if (textMatch && dateMatch) {
                row.style.display = "";
                visibleCount++;
            }
            else {
                row.style.display = "none";
            }
        });

        document.getElementById("noDataRow").style.display =
            visibleCount === 0 ? "" : "none";
    }
</script>