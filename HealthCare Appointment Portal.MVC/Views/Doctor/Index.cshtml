@model IEnumerable<HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto>
@using System.Web.Routing

@{
    ViewBag.Title = "Doctors";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Doctors
        </h2>

        @if (Session["Role"]?.ToString() == "Admin")
        {
            <a href="@Url.Action("Create", "Doctor")"
               class="btn btn-primary">

                Add Doctor

            </a>
        }

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">

                    @using (Html.BeginForm(
                        "Index",
                        "Doctor",
                        FormMethod.Get))
                    {
                        <div class="input-group">

                            <label for="specialisation"
                                   class="visually-hidden">
                                Specialisation
                            </label>

                            <select id="specialisation"
                                    name="specialisation"
                                    class="form-select">

                                <option value="">
                                    All Specialisations
                                </option>

                                @foreach (var item in Enum.GetValues(
                                    typeof(
                                        HealthCare_Appointment_Portal.Enums.Specialisation)))
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }

                            </select>

                            <button type="submit"
                                    class="btn btn-outline-primary">

                                Filter

                            </button>

                        </div>
                    }

                </div>

            </div>

            <table class="table table-bordered table-hover">

                <thead class="table-light">

                    <tr>

                        <th>
                            Doctor Id
                        </th>

                        <th>
                            Full Name
                        </th>

                        <th>
                            Specialisation
                        </th>

                        <th>
                            Experience
                        </th>

                        <th>
                            Fee
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Upcoming Appointments
                        </th>

                        <th width="250">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center">

                                No doctors found.

                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var doctor in Model)
                        {
                            var editRouteValues = new RouteValueDictionary
                                    {
                                { "id", doctor.DoctorId }
                            };

                            <tr>

                                <td>
                                    @doctor.DoctorId
                                </td>

                                <td>
                                    @doctor.FullName
                                </td>

                                <td>
                                    @doctor.Specialisation
                                </td>

                                <td>
                                    @doctor.YearsOfExperience
                                </td>

                                <td>
                                    Rs.@doctor.ConsultationFee
                                </td>

                                <td>

                                    @if (doctor.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>
                                    @doctor.UpcomingAppointmentCount
                                </td>

                                <td>

                                    <button type="button"
                                            class="btn btn-info btn-sm text-white"
                                            data-bs-toggle="modal"
                                            data-bs-target="#doctorModal_@doctor.DoctorId">

                                        View

                                    </button>

                                    @if (Session["Role"]?.ToString() == "Admin")
                                    {
                                        <a href="@Url.Action(
                                                     "Edit",
                                                     "Doctor",
                                                     editRouteValues)"
                                           class="btn btn-warning btn-sm">

                                            Edit

                                        </a>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

            @if (Model != null && Model.Any())
            {
                foreach (var doctor in Model)
                {
                    <!-- Doctor Details Modal -->
                    <div class="modal fade"
                         id="doctorModal_@doctor.DoctorId"
                         tabindex="-1"
                         aria-labelledby="doctorModalLabel_@doctor.DoctorId"
                         aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered modal-lg">

                            <div class="modal-content doctor-modal">

                                <div class="modal-header">

                                    <h5 class="modal-title fw-bold"
                                        id="doctorModalLabel_@doctor.DoctorId">

                                        Doctor Details

                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>

                                </div>

                                <div class="modal-body">

                                    <div class="doctor-detail-row">
                                        <strong>Doctor Id:</strong>
                                        <span>@doctor.DoctorId</span>
                                    </div>

                                    <div class="doctor-detail-row">
                                        <strong>Full Name:</strong>
                                        <span>@doctor.FullName</span>
                                    </div>

                                    <div class="doctor-detail-row">
                                        <strong>Specialisation:</strong>
                                        <span>@doctor.Specialisation</span>
                                    </div>

                                    <div class="doctor-detail-row">
                                        <strong>Experience:</strong>
                                        <span>@doctor.YearsOfExperience Years</span>
                                    </div>

                                    <div class="doctor-detail-row">
                                        <strong>Consultation Fee:</strong>
                                        <span>Rs.@doctor.ConsultationFee</span>
                                    </div>

                                    <div class="doctor-detail-row">
                                        <strong>Status:</strong>

                                        <span>
                                            @if (doctor.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Inactive
                                                </span>
                                            }
                                        </span>
                                    </div>

                                    <div class="doctor-detail-row">
                                        <strong>Upcoming Appointments:</strong>
                                        <span>@doctor.UpcomingAppointmentCount</span>
                                    </div>

                                </div>

                                <div class="modal-footer">

                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">

                                        Close

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>

<style>
    .card {
        border-radius: 20px;
    }

    .btn {
        border-radius: 8px;
        font-weight: 600;
    }

    .modal-backdrop.show {
        opacity: 0.55;
        backdrop-filter: blur(4px);
    }

    .doctor-modal {
        border-radius: 20px;
        border: none;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    }

    .modal-header {
        background: linear-gradient(135deg, #1E3A7A, #2563EB, #4AA3D9);
        color: white;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

        .modal-header .btn-close {
            filter: invert(1);
        }

    .doctor-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 13px 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .doctor-detail-row:last-child {
            border-bottom: none;
        }

        .doctor-detail-row strong {
            color: #1f2937;
            min-width: 180px;
        }

        .doctor-detail-row span {
            color: #374151;
            text-align: right;
        }

    @@media(max-width: 767px) {
        .doctor-detail-row {
            flex-direction: column;
            align-items: flex-start;
        }

            .doctor-detail-row span {
                text-align: left;
            }
    }
</style>