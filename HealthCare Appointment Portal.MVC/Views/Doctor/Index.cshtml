@model IEnumerable<HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto>

@{
    ViewBag.Title = "Doctor Registry";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successAlert"
             class="alert alert-success alert-dismissible fade show mb-3"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Doctor Registry</h2>

        <a href="@Url.Action("Create", "Doctor")"
           class="btn btn-success">

            <i class="fas fa-plus"></i>
            Add Doctor

        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row mb-3">

                <!-- Search by Doctor Name -->
                <div class="col-md-6">

                    <div class="d-flex justify-content-start">

                        @using (Html.BeginForm(
                            "Index",
                            "Doctor",
                            FormMethod.Get,
                            new { @class = "d-flex gap-2" }))
                        {
                            <input type="text"
                                   name="searchQuery"
                                   value="@ViewBag.CurrentSearch"
                                   class="form-control"
                                   style="width:300px;"
                                   placeholder="Search by doctor name..." />

                            <button type="submit"
                                    class="btn btn-primary"
                                    title="Search">

                                <i class="fas fa-search"></i>

                            </button>

                            if (!string.IsNullOrWhiteSpace(
                                ViewBag.CurrentSearch as string))
                            {
                                <a href="@Url.Action(
                                            "Index",
                                            "Doctor")"
                                   class="btn btn-outline-secondary"
                                   title="Clear Search">

                                    <i class="fas fa-times"></i>

                                </a>
                            }
                        }

                    </div>

                </div>

                <!-- Filter by Specialisation -->
                <div class="col-md-6">

                    @using (Html.BeginForm(
                        "Index",
                        "Doctor",
                        FormMethod.Get))
                    {
                        <div class="input-group">

                            <select name="specialisation"
                                    class="form-select">

                                <option value="">
                                    All Specialisations
                                </option>

                                @foreach (var item in Enum.GetValues(
                                    typeof(HealthCare_Appointment_Portal.Enums.Specialisation)))
                                {
                                    <option value="@item"
                                            @(ViewBag.CurrentSpecialisation != null && ViewBag.CurrentSpecialisation.ToString() == item.ToString() ? "selected" : "")>

                                        @item

                                    </option>
                                }

                            </select>

                            <button type="submit"
                                    class="btn btn-primary"
                                    title="Filter">

                                <i class="fas fa-filter"></i>
                                Filter

                            </button>

                        </div>
                    }

                </div>

            </div>

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th scope="col">
                            Doctor Id
                        </th>

                        <th scope="col">
                            Full Name
                        </th>

                        <th scope="col">
                            Specialisation
                        </th>

                        <th scope="col">
                            Experience
                        </th>

                        <th scope="col">
                            Fee
                        </th>

                        <th scope="col">
                            Status
                        </th>

                        <th scope="col">
                            Upcoming Appointments
                        </th>

                        <th scope="col"
                            class="text-center">

                            Actions

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var doctor in Model)
                    {
                        <tr>

                            <td>
                                @doctor.DoctorId
                            </td>

                            <td>
                                @doctor.FullName
                            </td>

                            <td>
                                @doctor.Specialisation
                            </td>

                            <td>
                                @doctor.YearsOfExperience
                            </td>

                            <td>
                                Rs.@doctor.ConsultationFee
                            </td>

                            <td>

                                @if (doctor.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactive

                                    </span>
                                }

                            </td>

                            <td>
                                @doctor.UpcomingAppointmentCount
                            </td>

                            <td class="text-center">

                                @{
                                    var routeData =
                                        new
                                        {
                                            id =
                                            doctor.DoctorId
                                        };
                                }

                                <div class="d-flex justify-content-center gap-2">

                                    <button type="button"
                                            class="btn btn-sm btn-info text-white view-doctor-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#doctorDetailsModal"
                                            data-id="@doctor.DoctorId"
                                            data-name="@doctor.FullName"
                                            data-specialisation="@doctor.Specialisation"
                                            data-experience="@doctor.YearsOfExperience"
                                            data-fee="@doctor.ConsultationFee"
                                            data-status="@(doctor.IsActive ? "Active" : "Inactive")"
                                            data-appointments="@doctor.UpcomingAppointmentCount">

                                        <i class="fas fa-eye"></i>
                                        View

                                    </button>

                                    <a href="@Url.Action(
                                                "Edit",
                                                "Doctor",
                                                routeData)"
                                       class="btn btn-sm btn-warning"
                                       title="Edit">

                                        <i class="fas fa-edit"></i>

                                    </a>

                                    <a href="@Url.Action(
                                            "Delete",
                                            "Doctor",
                                            routeData)"
                                       class="btn btn-sm btn-danger"
                                       title="Delete">

                                        <i class="fas fa-trash-alt"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
            <div class="modal fade"
                 id="doctorDetailsModal"
                 tabindex="-1">

                <div class="modal-dialog modal-lg">

                    <div class="modal-content">

                        <div class="modal-header">

                            <h5 class="modal-title">
                                Doctor Details
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal">
                            </button>

                        </div>

                        <div class="modal-body">

                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Doctor Id</strong>
                                </div>

                                <div class="col-md-8"
                                     id="modalDoctorId">
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Full Name</strong>
                                </div>

                                <div class="col-md-8"
                                     id="modalDoctorName">
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Specialisation</strong>
                                </div>

                                <div class="col-md-8"
                                     id="modalSpecialisation">
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Years Of Experience</strong>
                                </div>

                                <div class="col-md-8"
                                     id="modalExperience">
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Consultation Fee</strong>
                                </div>

                                <div class="col-md-8"
                                     id="modalFee">
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Status</strong>
                                </div>

                                <div class="col-md-8"
                                     id="modalStatus">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <strong>Upcoming Appointments</strong>
                                </div>

                                <div class="col-md-8"
                                     id="modalAppointments">
                                </div>
                            </div>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">

                                Close

                            </button>

                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>

</div>
@section Scripts
{
    <script>

        var doctorModal =
            document.getElementById(
                'doctorDetailsModal');

        if (doctorModal) {

            doctorModal.addEventListener(
                'show.bs.modal',
                function (event) {

                    var button =
                        event.relatedTarget;

                    document.getElementById(
                        'modalDoctorId').textContent =
                        button.getAttribute('data-id');

                    document.getElementById(
                        'modalDoctorName').textContent =
                        button.getAttribute('data-name');

                    document.getElementById(
                        'modalSpecialisation').textContent =
                        button.getAttribute('data-specialisation');

                    document.getElementById(
                        'modalExperience').textContent =
                        button.getAttribute('data-experience');

                    document.getElementById(
                        'modalFee').textContent =
                        'Rs.' +
                        button.getAttribute('data-fee');

                    document.getElementById(
                        'modalStatus').textContent =
                        button.getAttribute('data-status');

                    document.getElementById(
                        'modalAppointments').textContent =
                        button.getAttribute('data-appointments');
                });
        }

        setTimeout(function () {

            var alertElement =
                document.getElementById(
                    "successAlert");

            if (alertElement) {

                var alert =
                    bootstrap.Alert
                        .getOrCreateInstance(
                            alertElement);

                alert.close();
            }

        }, 3000);

    </script>
}