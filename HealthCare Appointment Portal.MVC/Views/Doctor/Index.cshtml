@model IEnumerable<HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto>

@{
    ViewBag.Title = "Doctors";
}

@Html.Partial("_Alerts")

<div class="container-fluid">

    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Doctor Management
        </h2>

        <a href="@Url.Action("Create", "Doctor")"
           class="btn btn-success">

            <i class="fas fa-plus"></i>

            Add Doctor

        </a>

    </div>

    <!-- SEARCH + FILTER -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row">

                <!-- SEARCH -->

                <div class="col-md-6 mb-3">

                    @using (Html.BeginForm(
                        "Index",
                        "Doctor",
                        FormMethod.Get))
                    {
                        <div class="input-group">

                            <input type="text"
                                   name="search"
                                   class="form-control"
                                   placeholder="Search Doctor By Id or Name" />

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fas fa-search"></i>

                                Search

                            </button>

                        </div>
                    }

                </div>

                <!-- FILTER -->

                <div class="col-md-6 mb-3">

                    @using (Html.BeginForm(
                        "Index",
                        "Doctor",
                        FormMethod.Get))
                    {
                        <div class="input-group">

                            <select name="specialisation"
                                    class="form-select">

                                <option value="">
                                    All Specialisations
                                </option>

                                @foreach (var item in Enum.GetValues(
                                    typeof(
                                    HealthCare_Appointment_Portal.Enums.Specialisation)))
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }

                            </select>

                            <button type="submit"
                                    class="btn btn-outline-primary">

                                Filter

                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- TABLE -->

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Doctor Id
                            </th>

                            <th>
                                Full Name
                            </th>

                            <th>
                                Specialisation
                            </th>

                            <th>
                                Experience
                            </th>

                            <th>
                                Consultation Fee
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Upcoming Appointments
                            </th>

                            <th width="350">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var doctor in Model)
                            {
                                <tr>

                                    <td>
                                        @doctor.DoctorId
                                    </td>

                                    <td>
                                        @doctor.FullName
                                    </td>

                                    <td>
                                        @doctor.Specialisation
                                    </td>

                                    <td>
                                        @doctor.YearsOfExperience Years
                                    </td>

                                    <td>
                                        &#8377; @doctor.ConsultationFee
                                    </td>

                                    <td>

                                        @if (doctor.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @doctor.UpcomingAppointmentCount
                                    </td>

                                    <td>

                                        <!-- VIEW -->

                                        <a href="@Url.Action(
                                                     "Details",
                                                     "Doctor",
                                                     new
                                                     {
                                                         id = doctor.DoctorId
                                                     })"
                                           class="btn btn-info btn-sm text-white">

                                            <i class="fas fa-eye"></i>

                                            View

                                        </a>

                                        <!-- EDIT -->

                                        <a href="@Url.Action(
                                                     "Edit",
                                                     "Doctor",
                                                     new
                                                     {
                                                         id = doctor.DoctorId
                                                     })"
                                           class="btn btn-warning btn-sm text-dark">

                                            <i class="fas fa-edit"></i>

                                            Edit

                                        </a>

                                        <!-- STATUS -->

                                        @if (doctor.IsActive)
                                        {
                                            using (Html.BeginForm(
                                                "Deactivate",
                                                "Doctor",
                                                new
                                                {
                                                    id = doctor.DoctorId
                                                },
                                                FormMethod.Post,
                                                new
                                                {
                                                    @class = "d-inline"
                                                }))
                                            {
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">

                                                    <i class="fas fa-user-slash"></i>

                                                    Deactivate

                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            using (Html.BeginForm(
                                                "Activate",
                                                "Doctor",
                                                new
                                                {
                                                    id = doctor.DoctorId
                                                },
                                                FormMethod.Post,
                                                new
                                                {
                                                    @class = "d-inline"
                                                }))
                                            {
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">

                                                    <i class="fas fa-user-check"></i>

                                                    Activate

                                                </button>
                                            }
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center text-muted py-4">

                                    No doctors found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>