@model IEnumerable<HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto>

@{
    ViewBag.Title = "Doctors";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Doctors
        </h2>

        @if (Session["Role"]?.ToString() == "Admin")
        {
            <a href="@Url.Action("Create", "Doctor")"
               class="btn btn-primary">

                Add Doctor

            </a>
        }

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">

                    @using (Html.BeginForm(
                        "Index",
                        "Doctor",
                        FormMethod.Get))
                    {
                        <div class="input-group">

                            <label for="specialisation"
                                   class="visually-hidden">
                                Specialisation
                            </label>

                            <select id="specialisation"
                                    name="specialisation"
                                    class="form-select">

                                <option value="">
                                    All Specialisations
                                </option>

                                @foreach (var item in Enum.GetValues(
                                    typeof(
                                    HealthCare_Appointment_Portal.Enums.Specialisation)))
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }

                            </select>

                            <button type="submit"
                                    class="btn btn-outline-primary">

                                Filter

                            </button>

                        </div>
                    }

                </div>

            </div>

            <table class="table table-bordered table-hover">

                <thead class="table-light">

                    <tr>

                        <th>
                            Doctor Id
                        </th>

                        <th>
                            Full Name
                        </th>

                        <th>
                            Specialisation
                        </th>

                        <th>
                            Experience
                        </th>

                        <th>
                            Fee
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Upcoming Appointments
                        </th>

                        <th style="width:250px;">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center">

                                No doctors found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var doctor in Model)
                        {
                            <tr>

                                <td>
                                    @doctor.DoctorId
                                </td>

                                <td>
                                    @doctor.FullName
                                </td>

                                <td>
                                    @doctor.Specialisation
                                </td>

                                <td>
                                    @doctor.YearsOfExperience
                                </td>

                                <td>
                                    Rs. @doctor.ConsultationFee
                                </td>

                                <td>

                                    @if (doctor.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>
                                    @doctor.UpcomingAppointmentCount
                                </td>

                                <td>

                                    <a href="@Url.Action(
                                                 "Details",
                                                 "Doctor",
                                                 new
                                                 {
                                                     id = doctor.DoctorId
                                                 })"
                                       class="btn btn-info btn-sm">

                                        View

                                    </a>

                                    @if (Session["Role"]?.ToString() == "Admin")
                                    {
                                        <a href="@Url.Action(
                                                     "Edit",
                                                     "Doctor",
                                                     new
                                                     {
                                                         id = doctor.DoctorId
                                                     })"
                                           class="btn btn-warning btn-sm">

                                            Edit

                                        </a>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>