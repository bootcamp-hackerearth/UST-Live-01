@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.DoctorDto

@{
    ViewBag.Title = "My Profile";
}

<style>
    .profile-card {
        min-height: 560px;
        border-radius: 24px;
        padding: 35px;
    }

    .profile-table th {
        width: 35%;
        background: #eef2f7;
        padding: 18px;
    }

    .profile-table td {
        padding: 18px;
    }

    .short-btn {
        width: 220px;
        padding: 10px;
        font-weight: 700;
    }
</style>

<div class="container mt-5">

    <div class="card shadow profile-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>
                My Profile
            </h2>

            <a href="@Url.Action("Dashboard", "Doctor")"
               class="btn btn-secondary">
                Back
            </a>
        </div>

        <table class="table table-bordered profile-table">
            <tr>
                <th>Doctor Id</th>
                <td>@Model.DoctorId</td>
            </tr>

            <tr>
                <th>Full Name</th>
                <td>@Model.FullName</td>
            </tr>

            <tr>
                <th>Specialisation</th>
                <td>@Model.Specialisation</td>
            </tr>

            <tr>
                <th>Years Of Experience</th>
                <td>@Model.YearsOfExperience</td>
            </tr>

            <tr>
                <th>Consultation Fee</th>
                <td>@Model.ConsultationFee</td>
            </tr>

            <tr>
                <th>Status</th>
                <td>@(Model.IsActive ? "Active" : "Inactive")</td>
            </tr>
        </table>

        <div class="text-center mt-4">
            <a href="@Url.Action("EditMyProfile", "Doctor")"
               class="btn btn-warning short-btn">
                Update Profile
            </a>
        </div>

    </div>

</div>