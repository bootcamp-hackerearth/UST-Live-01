@model IEnumerable<HealthCare_Appointment_Portal.DTOs.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "Cancelled Appointments";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between mb-4">
        <h2>Cancelled Appointments</h2>

        <a href="@Url.Action("Dashboard", "Doctor")"
           class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>

    <div class="card shadow p-4">

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info text-center">
                No cancelled appointments found.
            </div>
        }
        else
        {
            <input type="text"
                   id="cancelledSearch"
                   class="form-control mb-4"
                   placeholder="Search by Appointment Id or Patient Name" />

            <table class="table table-bordered table-hover"
                   id="cancelledTable">

                <thead class="table-light">
                    <tr>
                        <th>Appointment Id</th>
                        <th>Patient Name</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var appointment in Model)
                    {
                        string modalId =
                            "cancelledModal" + appointment.AppointmentId;

                        <tr>
                            <td class="appointment-id">
                                @appointment.AppointmentId
                            </td>

                            <td class="patient-name">
                                @appointment.PatientName
                            </td>

                            <td>
                                @appointment.ScheduledDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @appointment.TimeSlot
                            </td>

                            <td>
                                <span class="badge bg-danger">
                                    Cancelled
                                </span>
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-info btn-sm text-white"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId">
                                    <i class="fas fa-eye"></i>
                                    View
                                </button>
                            </td>
                        </tr>
                    }

                    <tr id="noDataRow"
                        style="display:none;">
                        <td colspan="6"
                            class="text-center text-muted py-4">
                            No cancelled appointments found.
                        </td>
                    </tr>

                </tbody>

            </table>
        }

    </div>

</div>

@if (Model != null)
{
    foreach (var appointment in Model)
    {
        string modalId =
            "cancelledModal" + appointment.AppointmentId;

        <div class="modal fade"
             id="@modalId"
             tabindex="-1">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">
                            <i class="fas fa-circle-xmark"></i>
                            Cancelled Appointment Details
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">

                        <table class="table table-bordered">
                            <tr>
                                <th>Appointment Id</th>
                                <td>@appointment.AppointmentId</td>
                            </tr>

                            <tr>
                                <th>Patient Name</th>
                                <td>@appointment.PatientName</td>
                            </tr>

                            <tr>
                                <th>Date</th>
                                <td>@appointment.ScheduledDate.ToString("dd-MMM-yyyy")</td>
                            </tr>

                            <tr>
                                <th>Time Slot</th>
                                <td>@appointment.TimeSlot</td>
                            </tr>

                            <tr>
                                <th>Status</th>
                                <td>
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <th>Cancellation Reason</th>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(appointment.CancellationReason))
                                    {
                                        <span class="text-muted">
                                            No reason provided
                                        </span>
                                    }
                                    else
                                    {
                                        @appointment.CancellationReason
                                    }
                                </td>
                            </tr>
                        </table>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>

                </div>

            </div>

        </div>
    }
}

<script>
    var searchBox =
        document.getElementById("cancelledSearch");

    if (searchBox) {
        searchBox.addEventListener("keyup", function () {

            var search =
                this.value.toLowerCase();

            var rows =
                document.querySelectorAll("#cancelledTable tbody tr:not(#noDataRow)");

            var visibleCount =
                0;

            rows.forEach(function (row) {

                var appointmentId =
                    row.querySelector(".appointment-id").innerText.toLowerCase();

                var patientName =
                    row.querySelector(".patient-name").innerText.toLowerCase();

                if (appointmentId.includes(search) ||
                    patientName.includes(search)) {
                    row.style.display = "";
                    visibleCount++;
                }
                else {
                    row.style.display = "none";
                }
            });

            document.getElementById("noDataRow").style.display =
                visibleCount === 0 ? "" : "none";
        });
    }
</script>