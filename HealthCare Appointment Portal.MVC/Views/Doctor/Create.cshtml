@model HealthCare_Appointment_Portal.DTOs.DoctorDtos.CreateDoctorDto
@using HealthCare_Appointment_Portal.Enums

@{
    ViewBag.Title = "Doctor Portal";
}

<div class="container mt-5">

    <h2 class="mb-4">
        Doctor Portal
    </h2>

    <div class="row">

        <!-- NEW DOCTOR REGISTER -->
        <div class="col-md-8 mb-4">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        New Doctor Registration
                    </h4>
                </div>

                <div class="card-body p-4">

                    @using (Html.BeginForm("Create", "Doctor", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(
                            true,
                            "",
                            new
                            {
                                @class = "alert alert-danger"
                            })

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Full Name
                                </label>

                                @Html.TextBoxFor(
                                    m => m.FullName,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "Enter doctor name"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.FullName,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Specialisation
                                </label>

                                @Html.EnumDropDownListFor(
                                    m => m.Specialisation,
                                    "-- Select Specialisation --",
                                    new
                                    {
                                        @class = "form-select"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.Specialisation,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Years Of Experience
                                </label>

                                @Html.TextBoxFor(
                                    m => m.YearsOfExperience,
                                    new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        min = "0",
                                        placeholder = "Enter experience"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.YearsOfExperience,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Consultation Fee
                                </label>

                                @Html.TextBoxFor(
                                    m => m.ConsultationFee,
                                    new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        min = "1",
                                        step = "0.01",
                                        placeholder = "Enter fee"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.ConsultationFee,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    })
                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-success">
                            Register Doctor
                        </button>

                        <a href="@Url.Action("Index", "Home")"
                           class="btn btn-secondary">
                            Back to Home
                        </a>
                    }

                </div>

            </div>

        </div>

        <!-- EXISTING DOCTOR LOGIN -->
        <div class="col-md-4 mb-4">

            <div class="card shadow border-0 rounded-4 h-100">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        Existing Doctor
                    </h4>
                </div>

                <div class="card-body p-4 d-flex flex-column justify-content-center">

                    <p class="text-muted">
                        Enter your Doctor Id to open your dashboard.
                    </p>

                    @if (TempData["LoginError"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["LoginError"]
                        </div>
                    }

                    @using (Html.BeginForm("ExistingDoctorLogin", "Doctor", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">
                                Doctor Id
                            </label>

                            <input type="number"
                                   name="doctorId"
                                   class="form-control"
                                   placeholder="Enter Doctor Id"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Go to Dashboard
                        </button>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}