@{
    ViewBag.Title = "Doctor Access";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card shadow border-0 doctor-card">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        <div class="icon-wrapper mb-3">

                            <i class="fas fa-user-doctor fa-4x text-success"></i>

                        </div>

                        <h2 class="fw-bold mb-2">
                            Doctor Dashboard
                        </h2>

                        <p class="text-muted mb-0">
                            Enter your Doctor ID to access your dashboard.
                        </p>

                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger text-center">

                            <i class="fas fa-exclamation-triangle me-2"></i>

                            Invalid Doctor ID. Please try again.

                        </div>
                    }

                    @using (Html.BeginForm(
                        "Doctor",
                        "DashboardSelection",
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-4">

                            <label for="doctorId"
                                   class="form-label fw-semibold">

                                Doctor ID

                            </label>

                            <input type="number"
                                   id="doctorId"
                                   name="doctorId"
                                   class="form-control form-control-lg"
                                   placeholder="Enter Doctor ID"
                                   required />

                        </div>

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-success btn-lg">

                                <i class="fas fa-arrow-right me-2"></i>

                                Continue

                            </button>

                        </div>
                    }

                    <hr class="my-4" />

                    <div class="text-center">

                        <a href="@Url.Action(
                                "Index",
                                "DashboardSelection")"
                           class="btn btn-outline-secondary">

                            <i class="fas fa-arrow-left me-2"></i>

                            Back to Dashboard Selection

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    body {
        background-color: #f8f9fa;
    }

    .doctor-card {
        border-radius: 20px;
        overflow: hidden;
    }

    .icon-wrapper {
        width: 100px;
        height: 100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f1fff6;
        border-radius: 50%;
    }

    .form-control {
        height: 55px;
        border-radius: 12px;
        border: 1px solid #ced4da;
        font-size: 1.1rem;
    }

        .form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25,135,84,.15);
        }

    .btn-success {
        border-radius: 12px;
        padding: 12px;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .btn-outline-secondary {
        border-radius: 12px;
    }

    .alert {
        border-radius: 12px;
        font-weight: 500;
    }
</style>