{
  "AppName": "HealthAxis API",

  

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "HealthAxis.API",
    "Audience": "HealthAxis.API",
    "Key": "ThisIsMySuperSecretKeyhealthcare2026",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "VirtualHost": "/",
    "AppointmentQueue": "appointment.events.queue"
  },
  "Garnet": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "HealthAxis:"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Elastic.Serilog.Sinks"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/healthaxis-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodes": [
            "http://localhost:9200"
          ],
          "dataStream": "logs-healthaxis-training",
          "bootstrapMethod": "Failure"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "Healthcare.netcore"
    }
  }



}
