@using AdminWebApp.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@implements IDisposable

@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-avatar">HA</div>

        <div>
            <h3>HealthAxis</h3>
            <span>Admin Console</span>
        </div>
    </div>

    <nav class="sidebar-menu">
        <AuthorizeView>
            <Authorized>
                <NavLink class="sidebar-link" href="dashboard" Match="NavLinkMatch.All">
                    <span>Dashboard</span>
                </NavLink>

                <NavLink class="sidebar-link" href="doctors">
                    <span>Doctors</span>
                </NavLink>

                <NavLink class="sidebar-link" href="appointments">
                    <span>Appointment Reports</span>
                </NavLink>

                <NavLink class="sidebar-link" href="patients">
                    <span>Patients</span>
                </NavLink>

                <button type="button"
                        class="sidebar-link logout-btn"
                        @onclick="HandleLogout">
                    Logout
                </button>
            </Authorized>

            <NotAuthorized>
                <NavLink class="sidebar-link" href="/angular/login">
                    <span>Login</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthStateProvider.AuthenticationStateChanged +=
            HandleAuthenticationStateChanged;
    }

    private void HandleAuthenticationStateChanged(
        Task<AuthenticationState> authenticationStateTask)
    {
        _ = authenticationStateTask;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to logout?");

        if (!confirmed)
        {
            return;
        }

        await JS.InvokeVoidAsync(
            "localStorage.removeItem",
            "token");

        await JS.InvokeVoidAsync(
            "localStorage.removeItem",
            "refreshToken");

        AuthStateProvider.NotifyUserLoggedOut();

        Nav.NavigateTo(
            "/angular/login",
            forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -=
            HandleAuthenticationStateChanged;
    }
}