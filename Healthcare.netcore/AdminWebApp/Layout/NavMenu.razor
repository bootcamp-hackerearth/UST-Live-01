@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-avatar">HA</div>

        <div>
            <h3>HealthAxis</h3>
            <span>Admin Console</span>
        </div>
    </div>

    <nav class="sidebar-menu">
        <AuthorizeView Roles="Admin">
            <Authorized>
                <NavLink class="sidebar-link" href="/dashboard" Match="NavLinkMatch.All">
                    Dashboard
                </NavLink>

                <NavLink class="sidebar-link" href="/doctors">
                    Doctors
                </NavLink>

                <NavLink class="sidebar-link" href="/appointments">
                    Appointment Reports
                </NavLink>

                <NavLink class="sidebar-link" href="/patients">
                    Patients
                </NavLink>

                <button type="button" class="sidebar-link logout-btn" @onclick="HandleLogout">
                    Logout
                </button>
            </Authorized>

            <NotAuthorized>
                <NavLink class="sidebar-link" href="/login">
                    Login
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to logout?");

        if (!confirmed)
        {
            return;
        }

        await JS.InvokeVoidAsync("localStorage.removeItem", "token");

        AuthStateProvider.NotifyUserLoggedOut();

        Nav.NavigateTo("http://localhost:4200/login", true);
    }
}