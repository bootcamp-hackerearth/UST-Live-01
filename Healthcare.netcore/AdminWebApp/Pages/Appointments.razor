@page "/appointments"
@attribute [Authorize(Roles = "Admin")]

@using AdminWebApp.Services
@using HealthAxis.Shared.DTOs.Appointment
@using HealthAxis.Shared.DTOs.Doctor
@using HealthAxis.Shared.DTOs.Patient
@using HealthAxis.Shared.Enums

@inject AppointmentService AppointmentApi
@inject DoctorService DoctorApi
@inject PatientService PatientApi
@inject IJSRuntime JS

<div class="appointment-report-page">

    <div class="appointment-report-header">
        <div>
            <span class="eyebrow">REPORTS</span>
            <h1>Appointment Reports</h1>
            <p>Daily appointment totals loaded from the HealthAxis API.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="doctor-alert success-alert">@SuccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="doctor-alert error-alert">@ErrorMessage</div>
    }

    <div class="appointment-summary-grid">
        <div class="appointment-summary-card pending-card">
            <div class="summary-icon"></div>
            <div>
                <h4>Pending</h4>
                <h2>@PendingCount</h2>
                <p>Awaiting confirmation</p>
            </div>
        </div>

        <div class="appointment-summary-card confirmed-card">
            <div class="summary-icon"></div>
            <div>
                <h4>Confirmed</h4>
                <h2>@ConfirmedCount</h2>
                <p>Scheduled visits</p>
            </div>
        </div>

        <div class="appointment-summary-card cancelled-card">
            <div class="summary-icon"></div>
            <div>
                <h4>Cancelled</h4>
                <h2>@CancelledCount</h2>
                <p>Cancelled visits</p>
            </div>
        </div>

        <div class="appointment-summary-card completed-card">
            <div class="summary-icon"></div>
            <div>
                <h4>Completed</h4>
                <h2>@CompletedCount</h2>
                <p>Records created</p>
            </div>
        </div>
    </div>

    <div class="appointment-table-card">
        @if (IsLoading)
        {
            <div class="empty-state">Loading appointment reports...</div>
        }
        else if (!PagedReportRows.Any())
        {
            <div class="empty-state">No appointment reports found.</div>
        }
        else
        {
            <table class="appointment-report-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Pending</th>
                        <th>Confirmed</th>
                        <th>Cancelled</th>
                        <th>Completed</th>
                        <th>Total</th>
                        <th>Details</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in PagedReportRows)
                    {
                        <tr>
                            <td>@row.Date.ToString("dd MMM yyyy")</td>
                            <td><span class="count-pill pending">@row.Pending</span></td>
                            <td><span class="count-pill confirmed">@row.Confirmed</span></td>
                            <td><span class="count-pill cancelled">@row.Cancelled</span></td>
                            <td><span class="count-pill completed">@row.Completed</span></td>
                            <td><strong>@row.Total</strong></td>
                            <td>
                                <button type="button"
                                        class="view-more-btn"
                                        @onclick="() => ShowDetails(row.Date)">
                                    View More
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="report-pagination">
        <button type="button"
                class="secondary-btn"
                disabled="@(ReportPageNumber == 1)"
                @onclick="PreviousReportPage">
            Previous
        </button>

        <span>Report page @ReportPageNumber of @TotalReportPages</span>

        <button type="button"
                class="secondary-btn"
                disabled="@(ReportPageNumber == TotalReportPages)"
                @onclick="NextReportPage">
            Next
        </button>
    </div>

    @if (SelectedReportDate.HasValue)
    {
        <div class="appointment-detail-card">
            <div class="appointment-detail-header">
                <div>
                    <h2>Appointments for @SelectedReportDate.Value.ToString("dd MMM yyyy")</h2>
                    <p>Filter appointments by status and update appointment status when allowed. Health records are shown only as indicators.</p>
                </div>

                <button type="button" class="secondary-btn" @onclick="CloseDetails">
                    Close
                </button>
            </div>

            <div class="detail-filter">
                <label>Filter by status</label>
                <select class="form-control" @bind="SelectedDetailStatus">
                    <option value="">All</option>

                    @foreach (var status in Enum.GetValues<AppointmentStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>

            @if (!SelectedDateAppointments.Any())
            {
                <div class="empty-state">No appointments found for selected filters.</div>
            }
            else
            {
                <table class="appointment-detail-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Status</th>
                            <th>Health Record</th>
                            <th>Cancellation Reason</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var appointment in SelectedDateAppointments)
                        {
                            <tr>
                                <td>@appointment.TimeSlot</td>

                                <td>@GetPatientName(appointment.PatientId)</td>

                                <td>@GetDoctorName(appointment.DoctorId)</td>

                                <td>
                                    <span class="appointment-status @appointment.Status.ToString().ToLower()">
                                        @appointment.Status
                                    </span>
                                </td>

                                <td>
                                    <span class="doctor-id">—</span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(appointment.CancellationReason))
                                    {
                                        @appointment.CancellationReason
                                    }
                                    else
                                    {
                                        <span class="doctor-id">—</span>
                                    }
                                </td>

                                <td>
                                    <div class="appointment-actions">
                                        @if (appointment.Status == AppointmentStatus.Pending)
                                        {
                                            <button type="button"
                                                    class="mini-action-btn confirm"
                                                    @onclick="() => UpdateStatus(appointment.AppointmentId, AppointmentStatus.Confirmed)">
                                                Confirm
                                            </button>

                                            <button type="button"
                                                    class="mini-action-btn cancel"
                                                    @onclick="() => CancelAppointment(appointment.AppointmentId)">
                                                Cancel
                                            </button>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Confirmed)
                                        {
                                            <button type="button"
                                                    class="mini-action-btn complete"
                                                    @onclick="() => UpdateStatus(appointment.AppointmentId, AppointmentStatus.Completed)">
                                                Complete
                                            </button>

                                            <button type="button"
                                                    class="mini-action-btn cancel"
                                                    @onclick="() => CancelAppointment(appointment.AppointmentId)">
                                                Cancel
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="doctor-id">No actions</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

</div>

@code {
    private List<AppointmentDto> AppointmentList = new();
    private List<DoctorDto> DoctorList = new();
    private List<PatientDto> PatientList = new();

    private bool IsLoading;

    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;

    private int ReportPageNumber = 1;
    private int ReportPageSize = 6;

    private DateTime? SelectedReportDate;
    private string SelectedDetailStatus = string.Empty;

    private int PendingCount =>
        AppointmentList.Count(a => a.Status == AppointmentStatus.Pending);

    private int ConfirmedCount =>
        AppointmentList.Count(a => a.Status == AppointmentStatus.Confirmed);

    private int CancelledCount =>
        AppointmentList.Count(a => a.Status == AppointmentStatus.Cancelled);

    private int CompletedCount =>
        AppointmentList.Count(a => a.Status == AppointmentStatus.Completed);

    private List<AppointmentReportRow> ReportRows =>
        AppointmentList
            .GroupBy(a => a.ScheduledDate.Date)
            .OrderByDescending(g => g.Key)
            .Select(g => new AppointmentReportRow
            {
                Date = g.Key,
                Pending = g.Count(a => a.Status == AppointmentStatus.Pending),
                Confirmed = g.Count(a => a.Status == AppointmentStatus.Confirmed),
                Cancelled = g.Count(a => a.Status == AppointmentStatus.Cancelled),
                Completed = g.Count(a => a.Status == AppointmentStatus.Completed),
                Total = g.Count()
            })
            .ToList();

    private int TotalReportPages =>
        Math.Max(1, (int)Math.Ceiling(ReportRows.Count / (double)ReportPageSize));

    private IEnumerable<AppointmentReportRow> PagedReportRows =>
        ReportRows
            .Skip((ReportPageNumber - 1) * ReportPageSize)
            .Take(ReportPageSize);

    private IEnumerable<AppointmentDto> SelectedDateAppointments
    {
        get
        {
            if (!SelectedReportDate.HasValue)
            {
                return Enumerable.Empty<AppointmentDto>();
            }

            IEnumerable<AppointmentDto> query = AppointmentList
                .Where(a => a.ScheduledDate.Date == SelectedReportDate.Value.Date)
                .OrderBy(a => a.TimeSlot);

            if (!string.IsNullOrWhiteSpace(SelectedDetailStatus) &&
                Enum.TryParse<AppointmentStatus>(SelectedDetailStatus, out var status))
            {
                query = query.Where(a => a.Status == status);
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        try
        {
            var appointments = await AppointmentApi.GetAppointmentsAsync();
            var doctors = await DoctorApi.GetDoctorsAsync(1, 100);
            var patients = await PatientApi.GetPatientsAsync(1, 100);

            AppointmentList = appointments ?? new List<AppointmentDto>();
            DoctorList = doctors?.Items ?? new List<DoctorDto>();
            PatientList = patients?.Items ?? new List<PatientDto>();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Unable to load appointment reports. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ShowDetails(DateTime date)
    {
        SelectedReportDate = date;
        SelectedDetailStatus = string.Empty;
    }

    private void CloseDetails()
    {
        SelectedReportDate = null;
        SelectedDetailStatus = string.Empty;
    }

    private void PreviousReportPage()
    {
        if (ReportPageNumber > 1)
        {
            ReportPageNumber--;
        }
    }

    private void NextReportPage()
    {
        if (ReportPageNumber < TotalReportPages)
        {
            ReportPageNumber++;
        }
    }

    private async Task UpdateStatus(int appointmentId, AppointmentStatus status)
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        var dto = new UpdateAppointmentStatusDto
        {
            Status = status
        };

        try
        {
            var response = await AppointmentApi.UpdateAppointmentStatusAsync(appointmentId, dto);

            if (!response.IsSuccessStatusCode)
            {
                var apiMessage = await response.Content.ReadAsStringAsync();
                ErrorMessage = "Unable to update appointment. Status: " +
                               ((int)response.StatusCode) +
                               ". " +
                               apiMessage;
                return;
            }

            SuccessMessage = "Appointment status updated successfully.";
            await LoadAllData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Unable to update appointment. " + ex.Message;
        }
    }

    private async Task CancelAppointment(int appointmentId)
    {
        var reason = await JS.InvokeAsync<string?>(
            "prompt",
            "Enter cancellation reason:");

        if (string.IsNullOrWhiteSpace(reason))
        {
            ErrorMessage = "Cancellation reason is required.";
            return;
        }

        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        var dto = new UpdateAppointmentStatusDto
        {
            Status = AppointmentStatus.Cancelled,
            CancellationReason = reason
        };

        try
        {
            var response = await AppointmentApi.UpdateAppointmentStatusAsync(appointmentId, dto);

            if (!response.IsSuccessStatusCode)
            {
                var apiMessage = await response.Content.ReadAsStringAsync();
                ErrorMessage = "Unable to cancel appointment. Status: " +
                               ((int)response.StatusCode) +
                               ". " +
                               apiMessage;
                return;
            }

            SuccessMessage = "Appointment cancelled successfully.";
            await LoadAllData();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Unable to cancel appointment. " + ex.Message;
        }
    }

    private string GetDoctorName(int doctorId)
    {
        var doctor = DoctorList.FirstOrDefault(d => d.DoctorId == doctorId);
        return doctor?.FullName ?? $"Doctor #{doctorId}";
    }

    private string GetPatientName(int patientId)
    {
        var patient = PatientList.FirstOrDefault(p => p.PatientId == patientId);
        return patient?.FullName ?? $"Patient #{patientId}";
    }

    private class AppointmentReportRow
    {
        public DateTime Date { get; set; }

        public int Pending { get; set; }

        public int Confirmed { get; set; }

        public int Cancelled { get; set; }

        public int Completed { get; set; }

        public int Total { get; set; }
    }
}