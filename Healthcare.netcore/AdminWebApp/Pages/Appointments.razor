@page "/appointments"

<div class="page-title">
    <h1>Appointments Management</h1>
    <p>Admin view for scheduling and monitoring appointments.</p>
</div>

<div class="card">
    <div class="card-header">
        <h3>Book Appointment</h3>
        <button class="btn-primary">Book Now</button>
    </div>

    <div class="form-grid">
        <div class="form-group">
            <label>Patient Name</label>
            <input class="form-control" placeholder="Enter patient name" />
        </div>

        <div class="form-group">
            <label>Select Doctor</label>
            <select class="form-control">
                <option>Dr. Rahul Menon</option>
                <option>Dr. Meera Iyer</option>
                <option>Dr. Arjun Kumar</option>
            </select>
        </div>

        <div class="form-group">
            <label>Appointment Date</label>
            <input type="date" class="form-control" />
        </div>

        <div class="form-group">
            <label>Appointment Time</label>
            <input type="time" class="form-control" />
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Upcoming Appointments</h3>
        <button class="btn-secondary">Filter</button>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Appointment ID</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>A001</td>
                <td>Ananya Sharma</td>
                <td>Dr. Rahul Menon</td>
                <td>22 Jun 2026</td>
                <td>10:00 AM</td>
                <td><span class="badge badge-success">Confirmed</span></td>
            </tr>
            <tr>
                <td>A002</td>
                <td>Vivek Nair</td>
                <td>Dr. Meera Iyer</td>
                <td>22 Jun 2026</td>
                <td>11:30 AM</td>
                <td><span class="badge badge-warning">Waiting</span></td>
            </tr>
            <tr>
                <td>A003</td>
                <td>Priya Das</td>
                <td>Dr. Arjun Kumar</td>
                <td>23 Jun 2026</td>
                <td>02:15 PM</td>
                <td><span class="badge badge-info">Checked In</span></td>
            </tr>
        </tbody>
    </table>
</div>