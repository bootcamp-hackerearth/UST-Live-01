@page "/doctors"
@attribute [Authorize(Roles = "Admin")]

@using AdminWebApp.Services
@using HealthAxis.Shared.DTOs.Doctor
@using HealthAxis.Shared.Enums

@inject DoctorService DoctorApi

<div class="doctor-page">

    <!-- HEADER -->
    <div class="doctor-page-header">
        <div>
            <span class="eyebrow">DOCTOR MANAGEMENT</span>
            <h1>Doctors</h1>
            <p>View doctors, apply filters, and register new doctor accounts.</p>
        </div>

        <button class="primary-btn" @onclick="OpenAddModal">
            + Add Doctor
        </button>
    </div>

    <!-- FILTERS -->
    <div class="doctor-filter-card">
        <div class="doctor-filter-grid">
            <div class="form-group">
                <label>Search Doctor</label>
                <input class="form-control"
                       placeholder="Search by doctor name"
                       @bind="SearchText"
                       @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label>Specialisation</label>
                <select class="form-control" @bind="SelectedSpecialisation">
                    <option value="">All</option>

                    @foreach (var s in Enum.GetValues<Specialisation>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Status</label>
                <select class="form-control" @bind="SelectedStatus">
                    <option value="">All</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
        </div>
    </div>

    <!-- ALERTS -->
    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="doctor-alert success-alert">@SuccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="doctor-alert error-alert">@ErrorMessage</div>
    }

    <!-- TABLE -->
    <div class="doctor-table-card">
        @if (IsLoading)
        {
            <div class="empty-state">Loading doctors...</div>
        }
        else if (!FilteredDoctors.Any())
        {
            <div class="empty-state">No doctors found.</div>
        }
        else
        {
            <table class="doctor-table">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Specialisation</th>
                        <th>Experience</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th>Appointments</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var d in FilteredDoctors)
                    {
                        <tr>
                            <td>
                                <div class="doctor-name">@d.FullName</div>
                                <div class="doctor-id">ID: @d.DoctorId</div>
                            </td>

                            <td>@d.Specialisation</td>
                            <td>@d.YearsOfExperience years</td>
                            <td>@d.ConsultationFee</td>

                            <td>
                                <span class="status-badge @(d.IsActive ? "active" : "inactive")">
                                    @(d.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>

                            <td>@d.UpcomingAppointmentCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>

<!-- ✅ MODAL -->
@if (ShowAddModal)
{
    <div class="modal-backdrop">
        <div class="doctor-modal">

            <div class="doctor-modal-header">
                <div>
                    <h2>Add Doctor</h2>
                    <p>Create a doctor profile.</p>
                </div>

                <button class="modal-close-btn" @onclick="CloseAddModal">×</button>
            </div>

            <EditForm Model="NewDoctor" OnValidSubmit="SaveDoctor">
                <DataAnnotationsValidator />

                <div class="modal-form-grid">

                    <InputText class="form-control" placeholder="Full Name"
                               @bind-Value="NewDoctor.FullName" />

                    <InputText class="form-control" placeholder="Email"
                               @bind-Value="NewDoctor.Email" />

                    <InputText type="password" class="form-control"
                               placeholder="Password"
                               @bind-Value="NewDoctor.TemporaryPassword" />

                    <InputSelect class="form-control"
                                 @bind-Value="NewDoctor.Specialisation">
                        @foreach (var s in Enum.GetValues<Specialisation>())
                        {
                            <option value="@s">@s</option>
                        }
                    </InputSelect>

                    <InputNumber class="form-control"
                                 @bind-Value="NewDoctor.YearsOfExperience" />

                    <InputNumber class="form-control"
                                 @bind-Value="NewDoctor.ConsultationFee" />

                </div>

                @if (!string.IsNullOrWhiteSpace(ModalErrorMessage))
                {
                    <div class="doctor-alert error-alert">@ModalErrorMessage</div>
                }

                <div class="modal-actions">
                    <button type="button"
                            class="secondary-btn"
                            @onclick="CloseAddModal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="primary-btn">
                        Save
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
}

@code {
    private List<DoctorDto> Doctor = new();

    private CreateDoctorDto NewDoctor = new();

    private bool IsLoading;
    private bool ShowAddModal;
    private bool IsSaving;

    private string SearchText = "";
    private string SelectedSpecialisation = "";
    private string SelectedStatus = "";

    private string ErrorMessage = "";
    private string SuccessMessage = "";
    private string ModalErrorMessage = "";

    private IEnumerable<DoctorDto> FilteredDoctors =>
        Doctor.Where(d =>
            (string.IsNullOrWhiteSpace(SearchText) ||
             d.FullName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(SelectedSpecialisation) ||
             d.Specialisation.ToString() == SelectedSpecialisation) &&
            (SelectedStatus == "" ||
             (SelectedStatus == "active" && d.IsActive) ||
             (SelectedStatus == "inactive" && !d.IsActive))
        );

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        IsLoading = true;

        try
        {
            var response = await DoctorApi.GetDoctorsAsync(1, 100);
            Doctor = response?.Items ?? new List<DoctorDto>();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenAddModal()
    {
        ShowAddModal = true;
    }

    private void CloseAddModal()
    {
        ShowAddModal = false;
        ModalErrorMessage = "";
    }

    private async Task SaveDoctor()
    {
        var response = await DoctorApi.AddDoctorAsync(NewDoctor);

        if (response.IsSuccessStatusCode)
        {
            ShowAddModal = false;
            SuccessMessage = "Doctor added successfully.";
            await LoadDoctors();
        }
        else
        {
            ModalErrorMessage = "Failed to save doctor.";
        }
    }
}