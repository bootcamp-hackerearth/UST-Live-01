@page "/"
@page "/login"
@layout AuthLayout

@using System.Net.Http.Json
@using HealthAxis.Shared.DTOs.Auth
@using AdminWebApp.Auth

@inject HttpClient Http
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="admin-login-page">
    <div class="admin-login-card">
        <div class="login-brand">
            <div class="login-logo">HA</div>
            <h1>HealthAxis Admin</h1>
            <p>Login to access the admin dashboard.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="login-alert login-info">
                @StatusMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="login-alert login-error">
                @ErrorMessage
            </div>
        }

        <EditForm Model="LoginRequest" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="login-field">
                <label>Email</label>
                <InputText class="login-input"
                           placeholder="admin@healthaxis.com"
                           @bind-Value="LoginRequest.Email" />
                <ValidationMessage For="() => LoginRequest.Email" />
            </div>

            <div class="login-field">
                <label>Password</label>
                <InputText type="password"
                           class="login-input"
                           placeholder="Enter password"
                           @bind-Value="LoginRequest.Password" />
                <ValidationMessage For="() => LoginRequest.Password" />
            </div>

            <button type="submit" class="login-button" disabled="@IsLoading">
                @(IsLoading ? "Signing in..." : "Sign In")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginDto LoginRequest = new();
    private string ErrorMessage = string.Empty;
    private string StatusMessage = string.Empty;
    private bool IsLoading = false;

    private async Task HandleLogin()
    {
        ErrorMessage = string.Empty;
        StatusMessage = "Calling API...";
        IsLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", LoginRequest);

            StatusMessage = $"API Status: {(int)response.StatusCode}";

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "Invalid email or password.";
                return;
            }

            var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();

            if (authResponse == null)
            {
                ErrorMessage = "Login failed. Empty response received.";
                return;
            }

            if (!authResponse.Success)
            {
                ErrorMessage = authResponse.Message;
                return;
            }

            if (string.IsNullOrWhiteSpace(authResponse.AccessToken))
            {
                ErrorMessage = "Login failed. Token not received.";
                return;
            }

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "token",
                authResponse.AccessToken);

            AuthStateProvider.NotifyUserLoggedIn(authResponse.AccessToken);

            Nav.NavigateTo("/dashboard", true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to connect to API. {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}