@page "/patients"
@attribute [Authorize(Roles = "Admin")]

@using AdminWebApp.Services
@using HealthAxis.Shared.DTOs.Patient
@using HealthAxis.Shared.Enums

@inject PatientService PatientApi

<div class="doctor-page">

    <!-- HEADER -->
    <div class="doctor-page-header">
        <div>
            <span class="eyebrow">PATIENT MANAGEMENT</span>
            <h1>Patients</h1>
            <p>View patients, apply filters, and register new patient profiles.</p>
        </div>

        <button type="button" class="primary-btn" @onclick="OpenAddModal">
            + Add Patient
        </button>
    </div>

    <!-- FILTERS -->
    <div class="doctor-filter-card">
        <div class="doctor-filter-grid">
            <div class="form-group">
                <label>Search Patient</label>
                <input class="form-control"
                       placeholder="Search by name, email, or phone"
                       @bind="SearchText"
                       @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label>Gender</label>
                <select class="form-control" @bind="SelectedGender">
                    <option value="">All Genders</option>

                    @foreach (var gender in Enum.GetValues<Gender>())
                    {
                        <option value="@gender">@gender</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Insurance</label>
                <select class="form-control" @bind="SelectedInsuranceStatus">
                    <option value="">All</option>
                    <option value="insured">With Insurance</option>
                    <option value="not-insured">Without Insurance</option>
                </select>
            </div>
        </div>
    </div>

    <!-- ALERTS -->
    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="doctor-alert success-alert">
            @SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="doctor-alert error-alert">
            @ErrorMessage
        </div>
    }

    <!-- TABLE -->
    <div class="doctor-table-card">
        @if (IsLoading)
        {
            <div class="empty-state">
                Loading patients...
            </div>
        }
        else if (!FilteredPatients.Any())
        {
            <div class="empty-state">
                No patients found.
            </div>
        }
        else
        {
            <table class="doctor-table">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Date of Birth</th>
                        <th>Contact</th>
                        <th>Insurance</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var patient in FilteredPatients)
                    {
                        <tr>
                            <td>
                                <div class="doctor-name">@patient.FullName</div>
                                <div class="doctor-id">ID: @patient.PatientId</div>
                            </td>

                            <td>@patient.Gender</td>

                            <td>@patient.Age years</td>

                            <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>

                            <td>
                                <div>@patient.PhoneNumber</div>
                                <div class="doctor-id">@patient.Email</div>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(patient.InsuranceId))
                                {
                                    <span class="status-badge active">
                                        @patient.InsuranceId
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        Not Provided
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>

<!-- ADD PATIENT MODAL -->
@if (ShowAddModal)
{
    <div class="modal-backdrop">
        <div class="doctor-modal">

            <div class="doctor-modal-header">
                <div>
                    <h2>Add Patient</h2>
                    <p>Create a new patient profile.</p>
                </div>

                <button type="button" class="modal-close-btn" @onclick="CloseAddModal">
                    ×
                </button>
            </div>

            <EditForm Model="NewPatient" OnValidSubmit="SavePatient">
                <DataAnnotationsValidator />

                <div class="modal-form-grid">

                    <div class="form-group full-width">
                        <label>Full Name</label>
                        <InputText class="form-control"
                                   placeholder="Enter patient full name"
                                   @bind-Value="NewPatient.FullName" />
                        <ValidationMessage For="() => NewPatient.FullName" />
                    </div>

                    <div class="form-group">
                        <label>Date of Birth</label>
                        <InputDate class="form-control"
                                   @bind-Value="NewPatient.DateOfBirth" />
                        <ValidationMessage For="() => NewPatient.DateOfBirth" />
                    </div>

                    <div class="form-group">
                        <label>Gender</label>
                        <InputSelect class="form-control"
                                     @bind-Value="NewPatient.Gender">
                            @foreach (var gender in Enum.GetValues<Gender>())
                            {
                                <option value="@gender">@gender</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => NewPatient.Gender" />
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <InputText class="form-control"
                                   placeholder="Enter phone number"
                                   @bind-Value="NewPatient.PhoneNumber" />
                        <ValidationMessage For="() => NewPatient.PhoneNumber" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <InputText class="form-control"
                                   placeholder="patient@email.com"
                                   @bind-Value="NewPatient.Email" />
                        <ValidationMessage For="() => NewPatient.Email" />
                    </div>

                    <div class="form-group full-width">
                        <label>Insurance ID</label>
                        <InputText class="form-control"
                                   placeholder="Optional insurance ID"
                                   @bind-Value="NewPatient.InsuranceId" />
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(ModalErrorMessage))
                {
                    <div class="doctor-alert error-alert">
                        @ModalErrorMessage
                    </div>
                }

                <div class="modal-actions">
                    <button type="button"
                            class="secondary-btn"
                            @onclick="CloseAddModal"
                            disabled="@IsSaving">
                        Cancel
                    </button>

                    <button type="submit"
                            class="primary-btn"
                            disabled="@IsSaving">
                        @(IsSaving ? "Saving..." : "Save Patient")
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
}

@code {
    private List<PatientDto> PatientList = new();

    private CreatePatientDto NewPatient = new();

    private bool IsLoading;
    private bool IsSaving;
    private bool ShowAddModal;

    private string SearchText = string.Empty;
    private string SelectedGender = string.Empty;
    private string SelectedInsuranceStatus = string.Empty;

    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string ModalErrorMessage = string.Empty;

    private IEnumerable<PatientDto> FilteredPatients
    {
        get
        {
            IEnumerable<PatientDto> query = PatientList;

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                query = query.Where(patient =>
                    patient.FullName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    patient.Email.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    patient.PhoneNumber.Contains(SearchText, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedGender) &&
                Enum.TryParse<Gender>(SelectedGender, out var gender))
            {
                query = query.Where(patient => patient.Gender == gender);
            }

            if (SelectedInsuranceStatus == "insured")
            {
                query = query.Where(patient => !string.IsNullOrWhiteSpace(patient.InsuranceId));
            }

            if (SelectedInsuranceStatus == "not-insured")
            {
                query = query.Where(patient => string.IsNullOrWhiteSpace(patient.InsuranceId));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        try
        {
            var response = await PatientApi.GetPatientsAsync(1, 100);

            PatientList = response?.Items ?? new List<PatientDto>();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Unable to load patients. " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenAddModal()
    {
        NewPatient = new CreatePatientDto
        {
            DateOfBirth = DateTime.Today.AddYears(-18),
            Gender = Gender.Male,
            FullName = string.Empty,
            PhoneNumber = string.Empty,
            Email = string.Empty,
            InsuranceId = string.Empty
        };

        ModalErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
        ShowAddModal = true;
    }

    private void CloseAddModal()
    {
        ShowAddModal = false;
        ModalErrorMessage = string.Empty;
    }

    private async Task SavePatient()
    {
        IsSaving = true;
        ModalErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        try
        {
            var response = await PatientApi.AddPatientAsync(NewPatient);

            if (!response.IsSuccessStatusCode)
            {
                var apiMessage = await response.Content.ReadAsStringAsync();

                ModalErrorMessage =
                    "Unable to save patient. Status: " +
                    ((int)response.StatusCode) +
                    ". " +
                    apiMessage;

                return;
            }

            ShowAddModal = false;
            SuccessMessage = "Patient added successfully.";

            await LoadPatients();
        }
        catch (Exception ex)
        {
            ModalErrorMessage = "Unable to save patient. " + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
}