@page "/patients"

<div class="page-title">
    <h1>Patients Management</h1>
    <p>Admin view for managing patient records.</p>
</div>

<div class="card">
    <div class="card-header">
        <h3>Register Patient</h3>
        <button class="btn-primary">Save Patient</button>
    </div>

    <div class="form-grid">
        <div class="form-group">
            <label>Patient Name</label>
            <input class="form-control" placeholder="Enter patient name" />
        </div>

        <div class="form-group">
            <label>Age</label>
            <input class="form-control" placeholder="Enter age" />
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            <input class="form-control" placeholder="Enter phone number" />
        </div>

        <div class="form-group">
            <label>Department</label>
            <select class="form-control">
                <option>General Medicine</option>
                <option>Cardiology</option>
                <option>Dermatology</option>
                <option>Orthopedics</option>
            </select>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Patient List</h3>
        <button class="btn-secondary">Export</button>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Patient ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Phone</th>
                <th>Department</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>P001</td>
                <td>Ananya Sharma</td>
                <td>28</td>
                <td>9876543210</td>
                <td>Cardiology</td>
                <td><span class="badge badge-success">Active</span></td>
            </tr>
            <tr>
                <td>P002</td>
                <td>Vivek Nair</td>
                <td>42</td>
                <td>Dermatology</td>
                <td>Dermatology</td>
                <td><span class="badge badge-warning">Pending</span></td>
            </tr>
            <tr>
                <td>P003</td>
                <td>Priya Das</td>
                <td>35</td>
                <td>9988776655</td>
                <td>Orthopedics</td>
                <td><span class="badge badge-success">Active</span></td>
            </tr>
        </tbody>
    </table>
</div>