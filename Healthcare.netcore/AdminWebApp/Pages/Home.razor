@page "/dashboard"

<div class="page-title">
    <span class="eyebrow">OVERVIEW</span>
    <h1>Admin Dashboard</h1>
    <p>Monitor doctors, appointments, reports, and operational activity from one place.</p>
</div>

<div class="stats-grid">
    <div class="metric-card">
        <div class="metric-icon blue"></div>
        <div>
            <span>Active Doctors</span>
            <h2>18</h2>
            <p>Available for appointments</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon green"></div>
        <div>
            <span>Today's Appointments</span>
            <h2>42</h2>
            <p>Across all departments</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon yellow"></div>
        <div>
            <span>Pending Confirmations</span>
            <h2>9</h2>
            <p>Needs action</p>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon purple"></div>
        <div>
            <span>Completed Visits</span>
            <h2>27</h2>
            <p>Health records created</p>
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="panel-card">
        <h3>Operational Shortcuts</h3>
        <p>Common admin actions for HealthAxis.</p>

        <div class="shortcut-list">
            <button>Manage doctor profiles</button>
            <button>View appointment reports</button>
            <button>Review pending confirmations</button>
            <button>Open user management</button>
        </div>
    </div>

    <div class="panel-card">
        <h3>Today's Status</h3>
        <p>Mock UI data for frontend layout practice.</p>

        <div class="status-list">
            <div>
                <span>Confirmed appointments</span>
                <strong class="success-pill">22</strong>
            </div>

            <div>
                <span>Pending appointments</span>
                <strong class="warning-pill">9</strong>
            </div>

            <div>
                <span>Cancelled appointments</span>
                <strong class="danger-pill">3</strong>
            </div>

            <div>
                <span>Doctors on leave</span>
                <strong class="info-pill">2</strong>
            </div>
        </div>
    </div>
</div>