@page "/appointments"
@using S3_HealthAxis.Shared.DTOs.Appointment
@using S3_HealthAxis.Shared.DTOs.Doctor
@using S3_HealthAxis.Shared.DTOs.Patient
@using S3_HealthAxis.Shared.Enums
@using S3_HealthAxis.Blazor.Services
@using System.ComponentModel.DataAnnotations

@inject IAppointmentService AppointmentService
@inject IDoctorService DoctorService
@inject IPatientService PatientService

<style>
    .stat-card {
        border-radius: 16px;
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .progress-stacked {
        height: 12px;
        border-radius: 10px;
        background-color: #f1f5f9;
        overflow: hidden;
        display: flex;
    }

    .segment {
        transition: width 0.5s ease-in-out;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Appointment Dashboard</h3>
        <p class="text-muted mb-0">Monitor schedule health and manage bookings.</p>
    </div>
    <button class="btn btn-primary shadow-sm" @onclick="OpenAddModal">
        <i class="bi bi-calendar-plus me-1"></i> Book Appointment
    </button>
</div>

@if (!string.IsNullOrEmpty(_pageError))
{
    <div class="alert alert-danger shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Error:</strong> @_pageError
    </div>
}

<!-- ANALYTICS DASHBOARD -->
@if (_appointments != null)
{
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">Schedule Overview</h5>
                <div class="btn-group shadow-sm" role="group">
                    <input type="radio" class="btn-check" name="btnradio" id="btnToday" autocomplete="off" checked="@(!_showWeekView)" @onchange="() => ToggleChart(false)">
                    <label class="btn btn-outline-primary btn-sm px-3" for="btnToday">Today</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnWeek" autocomplete="off" checked="@_showWeekView" @onchange="() => ToggleChart(true)">
                    <label class="btn btn-outline-primary btn-sm px-3" for="btnWeek">This Week</label>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Pending -->
                <div class="col-md-3">
                    <div class="stat-card bg-warning bg-opacity-10 p-3 border border-warning border-opacity-25">
                        <div class="text-warning small fw-bold text-uppercase mb-1">Pending</div>
                        <h3 class="fw-bold text-dark mb-0">@Analytics.Pending</h3>
                    </div>
                </div>
                <!-- Confirmed -->
                <div class="col-md-3">
                    <div class="stat-card bg-primary bg-opacity-10 p-3 border border-primary border-opacity-25">
                        <div class="text-primary small fw-bold text-uppercase mb-1">Confirmed</div>
                        <h3 class="fw-bold text-dark mb-0">@Analytics.Confirmed</h3>
                    </div>
                </div>
                <!-- Completed -->
                <div class="col-md-3">
                    <div class="stat-card bg-success bg-opacity-10 p-3 border border-success border-opacity-25">
                        <div class="text-success small fw-bold text-uppercase mb-1">Completed</div>
                        <h3 class="fw-bold text-dark mb-0">@Analytics.Completed</h3>
                    </div>
                </div>
                <!-- Cancelled -->
                <div class="col-md-3">
                    <div class="stat-card bg-danger bg-opacity-10 p-3 border border-danger border-opacity-25">
                        <div class="text-danger small fw-bold text-uppercase mb-1">Cancelled</div>
                        <h3 class="fw-bold text-dark mb-0">@Analytics.Cancelled</h3>
                    </div>
                </div>
            </div>

            <!-- Visual Distribution Bar -->
            @if (Analytics.Total > 0)
            {
                <div class="progress-stacked w-100">
                    <div class="segment bg-warning" style="width: @(Analytics.PendingPct)%"></div>
                    <div class="segment bg-primary" style="width: @(Analytics.ConfirmedPct)%"></div>
                    <div class="segment bg-success" style="width: @(Analytics.CompletedPct)%"></div>
                    <div class="segment bg-danger" style="width: @(Analytics.CancelledPct)%"></div>
                </div>
                <div class="text-center text-muted small mt-2">
                    Distribution of @Analytics.Total appointments @(_showWeekView ? "this week" : "today")
                </div>
            }
        </div>
    </div>
}

<!-- DATA GRID & FILTERS -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">All Appointments</h6>
        <div class="input-group input-group-sm w-auto shadow-sm">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Search ID or Patient..." @bind="SearchQuery" @bind:event="oninput" style="min-width: 250px;" />
        </div>
    </div>

    <div class="card-body p-0">
        @if (_loading)
        {
            <div class="text-center p-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (!PagedAppointments.Any())
        {
            <div class="text-center p-5 text-muted">
                <i class="bi bi-calendar-x fs-1"></i><p class="mt-2">No appointments found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Date</th>
                            <th>Time Slot</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Quick Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in PagedAppointments)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@appt.AppointmentId</td>
                                <td class="fw-medium">@appt.ScheduledDate.ToString("MMM dd, yyyy")</td>
                                <!-- Translated the Enum to Human Readable String -->
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock me-1"></i> @GetEnumDisplayName((AppointmentTimeSlot)appt.TimeSlot)
                                    </span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(appt.PatientName) ? "—" : appt.PatientName)</td>
                                <td>@(string.IsNullOrWhiteSpace(appt.DoctorName) ? "—" : $"Dr. {appt.DoctorName}")</td>
                                <td>@GetStatusBadge(appt.Status)</td>
                                <td class="text-end pe-4">

                                    @if (appt.Status == 0) // Pending
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1" title="Confirm" @onclick="() => ConfirmAppointment(appt.AppointmentId)"><i class="bi bi-check-lg"></i></button>
                                    }
                                    @if (appt.Status == 1) // Confirmed
                                    {
                                        <button class="btn btn-sm btn-outline-success me-1" title="Mark Completed" @onclick="() => CompleteAppointment(appt.AppointmentId)"><i class="bi bi-flag-fill"></i></button>
                                    }

                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Reschedule" @onclick="() => OpenEditModal(appt)"><i class="bi bi-pencil"></i></button>

                                    @if (appt.Status == 0 || appt.Status == 1) // Pending or Confirmed
                                    {
                                        <button class="btn btn-sm btn-outline-danger" title="Cancel" @onclick="() => OpenCancelModal(appt.AppointmentId)"><i class="bi bi-x-lg"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (TotalPages > 1)
            {
                <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted small">Showing @(((_currentPage - 1) * _pageSize) + 1) to @Math.Min(_currentPage * _pageSize, FilteredAppointments.Count()) of @FilteredAppointments.Count() entries</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(_currentPage == 1 ? "disabled" : "")"><button class="page-link" @onclick="() => _currentPage--">Prev</button></li>
                            <li class="page-item disabled"><span class="page-link text-dark">@_currentPage / @TotalPages</span></li>
                            <li class="page-item @(_currentPage == TotalPages ? "disabled" : "")"><button class="page-link" @onclick="() => _currentPage++">Next</button></li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- Add/Reschedule Modal -->
@if (_showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold">@(_isEditing ? "Reschedule Appointment" : "Book Appointment")</h5>
                    <button type="button" class="btn-close" @onclick="() => _showAddModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <EditForm Model="@_formData" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-medium">Select Patient</label>
                            <InputSelect class="form-select" @bind-Value="_formData.PatientId" disabled="@_isEditing">
                                <option value="0" disabled>-- Choose Patient --</option>
                                @foreach (var p in _activePatients)
                                {
                                    <option value="@p.PatientId">@p.FullName (ID: @p.PatientId)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _formData.PatientId)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Select Doctor</label>
                            <InputSelect class="form-select" @bind-Value="_formData.DoctorId">
                                <option value="0" disabled>-- Choose Doctor --</option>
                                @foreach (var d in _activeDoctors)
                                {
                                    <option value="@d.DoctorId">Dr. @d.FullName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _formData.DoctorId)" class="text-danger small mt-1" />
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-medium">Date</label>
                                <!-- Added the min attribute to block past dates -->
                                <InputDate class="form-control" @bind-Value="_formData.ScheduledDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <ValidationMessage For="@(() => _formData.ScheduledDate)" class="text-danger small mt-1" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-medium">Time Slot</label>
                                <!-- Converted to Dropdown reading the Enum tags -->
                                <InputSelect TValue="int" class="form-select" @bind-Value="_formData.TimeSlot">
                                    <option value="0" disabled>-- Choose Slot --</option>
                                    @foreach (AppointmentTimeSlot slot in Enum.GetValues(typeof(AppointmentTimeSlot)))
                                    {
                                        <option value="@((int)slot)">@GetEnumDisplayName(slot)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _formData.TimeSlot)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-2">
                            <button type="button" class="btn btn-light" @onclick="() => _showAddModal = false">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">@(_isEditing ? "Reschedule" : "Book")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Cancel Reason Modal -->
@if (_showCancelModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> Cancel Appointment</h5>
                </div>
                <div class="modal-body p-4">
                    <p>Are you sure you want to cancel Appointment <strong>#@_cancelId</strong>?</p>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Cancellation Reason</label>
                        <textarea class="form-control" @bind="_cancelReason" rows="3" placeholder="Patient requested cancellation..."></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light" @onclick="() => _showCancelModal = false">Nevermind</button>
                        <button type="button" class="btn btn-danger" disabled="@(string.IsNullOrWhiteSpace(_cancelReason) || _isSaving)" @onclick="SubmitCancel">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Confirm Cancellation
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AppointmentDetailsDto>? _appointments = new();
    private List<PatientDto> _activePatients = new();
    private List<DoctorDto> _activeDoctors = new();

    private bool _loading = true;
    private string? _pageError = null;

    // --- Search & Pagination ---
    private string _searchQuery = "";
    private int _currentPage = 1;
    private readonly int _pageSize = 20;

    private string SearchQuery
    {
        get => _searchQuery;
        set { _searchQuery = value; _currentPage = 1; }
    }

    private IEnumerable<AppointmentDetailsDto> FilteredAppointments =>
        (_appointments ?? new List<AppointmentDetailsDto>())
            .Where(a => string.IsNullOrWhiteSpace(SearchQuery)
                     || (!string.IsNullOrEmpty(a.PatientName) && a.PatientName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
                     || a.AppointmentId.ToString() == SearchQuery)
            .OrderByDescending(a => a.ScheduledDate);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAppointments.Count() / (double)_pageSize));
    private IEnumerable<AppointmentDetailsDto> PagedAppointments => FilteredAppointments.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    // --- Analytics Logic ---
    private bool _showWeekView = false;
    private ChartData Analytics = new();

    private class ChartData
    {
        public int Pending { get; set; }
        public int Confirmed { get; set; }
        public int Completed { get; set; }
        public int Cancelled { get; set; }
        public int Total => Pending + Confirmed + Completed + Cancelled;

        public double PendingPct => Total == 0 ? 0 : (Pending / (double)Total) * 100;
        public double ConfirmedPct => Total == 0 ? 0 : (Confirmed / (double)Total) * 100;
        public double CompletedPct => Total == 0 ? 0 : (Completed / (double)Total) * 100;
        public double CancelledPct => Total == 0 ? 0 : (Cancelled / (double)Total) * 100;
    }

    private void ToggleChart(bool showWeek)
    {
        _showWeekView = showWeek;
        CalculateAnalytics();
    }

    private void CalculateAnalytics()
    {
        if (_appointments == null) return;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var targetSet = _appointments.Where(a => _showWeekView
            ? (a.ScheduledDate >= today && a.ScheduledDate <= today.AddDays(7))
            : a.ScheduledDate == today).ToList();

        // FIXED ENUM MAPPING: 2 is Cancelled, 3 is Completed
        Analytics = new ChartData
        {
            Pending = targetSet.Count(a => a.Status == 0),
            Confirmed = targetSet.Count(a => a.Status == 1),
            Cancelled = targetSet.Count(a => a.Status == 2),
            Completed = targetSet.Count(a => a.Status == 3)
        };
    }

    // --- Modal State & Models ---
    private bool _showAddModal = false;
    private bool _showCancelModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private int _cancelId = 0;
    private string _cancelReason = "";

    private AppointmentFormModel _formData = new();

    public class AppointmentFormModel
    {
        public int AppointmentId { get; set; }
        [Range(1, int.MaxValue, ErrorMessage = "Please select a patient")]
        public int PatientId { get; set; }
        [Range(1, int.MaxValue, ErrorMessage = "Please select a doctor")]
        public int DoctorId { get; set; }
        [Required]
        public DateOnly ScheduledDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        [Range(1, 48, ErrorMessage = "Valid time slot required")]
        public int TimeSlot { get; set; } = 0;
    }

    // --- Lifecycle ---
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            _pageError = null;

            _appointments = await AppointmentService.GetAllAsync() ?? new();
            var allPatients = await PatientService.GetAllAsync() ?? new();
            var allDoctors = await DoctorService.GetAllAsync() ?? new();

            _activePatients = allPatients.Where(p => p.IsActive).ToList();
            _activeDoctors = allDoctors.Where(d => d.IsActive).ToList();

            CalculateAnalytics();
        }
        catch (Exception ex)
        {
            _pageError = $"Failed to load dashboard data: {ex.Message}";
        }
        finally { _loading = false; }
    }

    // --- Quick Actions ---
    private async Task ConfirmAppointment(int id) { await ExecuteAction(async () => await AppointmentService.ConfirmAsync(id)); }
    private async Task CompleteAppointment(int id) { await ExecuteAction(async () => await AppointmentService.CompleteAsync(id)); }

    private async Task ExecuteAction(Func<Task> action)
    {
        try
        {
            _pageError = null;
            await action();
            await LoadData();
        }
        catch (Exception ex) { _pageError = ex.Message; }
    }

    // --- Cancel Modal Logic ---
    private void OpenCancelModal(int id)
    {
        _cancelId = id;
        _cancelReason = "";
        _showCancelModal = true;
    }

    private async Task SubmitCancel()
    {
        _isSaving = true;
        try
        {
            await AppointmentService.CancelAsync(_cancelId, new CancelAppointmentDto { CancellationReason = _cancelReason });
            _showCancelModal = false;
            await LoadData();
        }
        catch (Exception ex) { _pageError = ex.Message; }
        finally { _isSaving = false; }
    }

    // --- Add/Edit Modal Logic ---
    private void OpenAddModal()
    {
        _isEditing = false;
        _formData = new AppointmentFormModel();
        _showAddModal = true;
    }

    private void OpenEditModal(AppointmentDetailsDto appt)
    {
        _isEditing = true;
        _formData = new AppointmentFormModel
        {
            AppointmentId = appt.AppointmentId,
            PatientId = appt.PatientId,
            DoctorId = appt.DoctorId,
            ScheduledDate = appt.ScheduledDate,
            TimeSlot = appt.TimeSlot
        };
        _showAddModal = true;
    }

    private async Task HandleSubmit()
    {
        _isSaving = true;
        try
        {
            if (_isEditing)
            {
                await AppointmentService.UpdateAsync(_formData.AppointmentId, new UpdateAppointmentDto
                { DoctorId = _formData.DoctorId, ScheduledDate = _formData.ScheduledDate, TimeSlot = _formData.TimeSlot });
            }
            else
            {
                await AppointmentService.CreateAsync(new CreateAppointmentDto
                { PatientId = _formData.PatientId, DoctorId = _formData.DoctorId, ScheduledDate = _formData.ScheduledDate, TimeSlot = _formData.TimeSlot });
            }
            _showAddModal = false;
            await LoadData();
        }
        catch (Exception ex) { _pageError = ex.Message; }
        finally { _isSaving = false; }
    }

    // --- Helpers ---

    // Safely reads the [Display(Name="...")] attribute from Enums
    private string GetEnumDisplayName(Enum enumValue)
    {
        var type = enumValue.GetType();
        var memberInfo = type.GetMember(enumValue.ToString());

        if (memberInfo.Length > 0)
        {
            var attrs = memberInfo[0].GetCustomAttributes(typeof(DisplayAttribute), false);
            if (attrs.Length > 0)
            {
                return ((DisplayAttribute)attrs[0]).Name ?? enumValue.ToString();
            }
        }
        return enumValue.ToString();
    }

    private RenderFragment GetStatusBadge(int status) => builder =>
    {
        // FIXED ENUM MAPPING: 2 is Cancelled, 3 is Completed
        switch (status)
        {
            case 0: builder.AddMarkupContent(0, "<span class='badge bg-warning text-dark'><i class='bi bi-hourglass-split me-1'></i> Pending</span>"); break;
            case 1: builder.AddMarkupContent(0, "<span class='badge bg-primary'><i class='bi bi-check-circle me-1'></i> Confirmed</span>"); break;
            case 2: builder.AddMarkupContent(0, "<span class='badge bg-danger'><i class='bi bi-x-circle me-1'></i> Cancelled</span>"); break;
            case 3: builder.AddMarkupContent(0, "<span class='badge bg-success'><i class='bi bi-flag-fill me-1'></i> Completed</span>"); break;
            default: builder.AddMarkupContent(0, $"<span class='badge bg-secondary'>Unknown ({status})</span>"); break;
        }
    };
}