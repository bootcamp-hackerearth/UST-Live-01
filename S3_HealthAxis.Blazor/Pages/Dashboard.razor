@page "/dashboard"

@using S3_HealthAxis.Blazor.Models
@using S3_HealthAxis.Blazor.Services

@inject IAdminService AdminService

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">Dashboard Overview</h3>
        <p class="text-muted mb-0">Welcome back to the Care Management Portal.</p>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_dashboard == null)
{
    <div class="alert alert-danger shadow-sm border-0">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Failed to load dashboard data. Please try refreshing the page.
    </div>
}
else
{
    <!-- CLICKABLE STAT CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <a href="/doctors" class="dash-card-link">
                <div class="dash-card card-doctors">
                    <div class="card-header-ui">
                        <h5 class="card-title">Total Doctors</h5>
                        <i class="bi bi-person-badge card-icon"></i>
                    </div>
                    <h2 class="card-value">@_dashboard.TotalDoctors</h2>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="/patients" class="dash-card-link">
                <div class="dash-card card-patients">
                    <div class="card-header-ui">
                        <h5 class="card-title">Total Patients</h5>
                        <i class="bi bi-people card-icon"></i>
                    </div>
                    <h2 class="card-value">@_dashboard.TotalPatients</h2>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="/appointments" class="dash-card-link">
                <div class="dash-card card-appointments">
                    <div class="card-header-ui">
                        <h5 class="card-title">All Appointments</h5>
                        <i class="bi bi-calendar-check card-icon"></i>
                    </div>
                    <h2 class="card-value">@_dashboard.TotalAppointments</h2>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="/appointments?filter=today" class="dash-card-link">
                <div class="dash-card card-today">
                    <div class="card-header-ui">
                        <h5 class="card-title">Today's Schedule</h5>
                        <i class="bi bi-clock-history card-icon"></i>
                    </div>
                    <h2 class="card-value">@_dashboard.TodayAppointments</h2>
                </div>
            </a>
        </div>

    </div>

    <!-- GRAPHS ROW -->
    <div class="row g-4">

        <!-- Graph 1: Doctor Availability (Donut Chart) -->
        <div class="col-lg-4">
            <div class="chart-card">
                <h5 class="chart-title">Active Doctors</h5>
                <div class="css-donut-container">
                    <!-- Dynamic inline style sets the percentage color fill -->
                    <div class="donut-chart" style="--percentage: @_activeDoctorPercentage; --chart-color: #38b2ac;">
                        <div class="donut-inner">
                            <span class="donut-percentage">@_activeDoctorPercentage%</span>
                            <span class="donut-label">Available</span>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-3 text-muted small">
                    <i class="bi bi-circle-fill" style="color: #38b2ac; font-size: 8px; margin-right: 4px;"></i> Active
                    <i class="bi bi-circle-fill ms-3" style="color: #e2e8f0; font-size: 8px; margin-right: 4px;"></i> Off-Duty
                </div>
            </div>
        </div>

        <!-- Graph 2: Appointment Status (Bar Chart) -->
        <div class="col-lg-8">
            <div class="chart-card">
                <h5 class="chart-title">Today's Appointment Status</h5>

                <div class="css-bar-chart">

                    <div class="bar-col">
                        <div class="bar-value">@_pendingAppointments</div>
                        <div class="bar" style="height: @(_pendingAppointments * 10)%; background-color: #cbd5e0;"></div>
                        <div class="bar-label">Pending</div>
                    </div>

                    <div class="bar-col">
                        <div class="bar-value">@_confirmedAppointments</div>
                        <div class="bar" style="height: @(_confirmedAppointments * 10)%; background-color: #2b6cb0;"></div>
                        <div class="bar-label">Confirmed</div>
                    </div>

                    <div class="bar-col">
                        <div class="bar-value">@_completedAppointments</div>
                        <div class="bar" style="height: @(_completedAppointments * 10)%; background-color: #38b2ac;"></div>
                        <div class="bar-label">Completed</div>
                    </div>

                    <div class="bar-col">
                        <div class="bar-value">@_cancelledAppointments</div>
                        <div class="bar" style="height: @(_cancelledAppointments * 10)%; background-color: #fc8181;"></div>
                        <div class="bar-label">Cancelled</div>
                    </div>

                </div>
            </div>
        </div>

    </div>
}

@code {
    private DashboardDto? _dashboard;
    private bool _loading = true;

    // --- Graph Mock Data Variables ---
    // (Since these statuses aren't in your DTO yet, we derive them visually for the chart)
    private int _activeDoctorPercentage = 0;

    private int _pendingAppointments = 0;
    private int _confirmedAppointments = 0;
    private int _completedAppointments = 0;
    private int _cancelledAppointments = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await AdminService.GetDashboardAsync();

            if (_dashboard != null)
            {
                // Logic to generate realistic-looking graph data based on actual numbers
                // If you update your DTO to include exact status counts later, replace this logic.
                _activeDoctorPercentage = _dashboard.TotalDoctors > 0 ? 82 : 0; // Assuming 82% are active

                int totalToday = _dashboard.TodayAppointments;
                if (totalToday > 0)
                {
                    _completedAppointments = (int)(totalToday * 0.4);
                    _confirmedAppointments = (int)(totalToday * 0.3);
                    _cancelledAppointments = (int)(totalToday * 0.1);
                    _pendingAppointments = totalToday - (_completedAppointments + _confirmedAppointments + _cancelledAppointments);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}