@page "/"

<div class="ha-home-page">
    <div class="ha-home-hero">
        <div class="ha-home-badge">
            <i class="bi bi-shield-check"></i>
            <span>Healthcare Administration Platform</span>
        </div>

        <h1>Welcome to HealthAxis</h1>

        <p>
            HealthAxis is a centralized care management portal designed to simplify
            patient records, doctor administration, and appointment operations
            through a clean and secure healthcare workspace.
        </p>

        <div class="ha-home-actions">
            <a href="/login" class="btn btn-primary ha-home-login-btn">
                <i class="bi bi-box-arrow-in-right me-2"></i> Login
            </a>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="ha-home-card">
                <div class="ha-home-card-icon">
                    <i class="bi bi-people"></i>
                </div>
                <h5>Patient Management</h5>
                <p>
                    Maintain patient profiles, update information, and keep records
                    structured in one place for easy administration.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="ha-home-card">
                <div class="ha-home-card-icon">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h5>Doctor Administration</h5>
                <p>
                    Manage doctor availability, staff information, and medical
                    operations through a streamlined admin experience.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="ha-home-card">
                <div class="ha-home-card-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h5>Appointment Scheduling</h5>
                <p>
                    Coordinate appointments efficiently, track daily schedules,
                    and support smoother healthcare operations.
                </p>
            </div>
        </div>
    </div>
</div>