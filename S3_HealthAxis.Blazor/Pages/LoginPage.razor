@page "/login"
@layout EmptyLayout

@using S3_HealthAxis.Blazor.Services
@using S3_HealthAxis.Shared.DTOs.Auth

@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="ha-login-page">

    <!-- LEFT PANEL -->
    <section class="ha-login-visual">
        <div class="login-left">

            <!-- Background Visual Layer -->
            <div class="login-left-visual">
                <img src="images/login-healthcare-hero.png"
                     alt="Healthcare admin illustration"
                     class="login-hero-image" />
                <div class="login-left-overlay"></div>
            </div>

            <!-- Text Content -->
            <div class="left-content">
                <div class="left-text">
                    <h3>HealthAxis Login Portal</h3>
                    <p>Secure access for healthcare administrators</p>
                </div>
            </div>

        </div>
    </section>

    <!-- RIGHT PANEL -->
    <section class="ha-login-form-panel">
        <div class="ha-login-form-shell">
            <div class="ha-login-form-card">

                <div class="ha-login-heading-block">
                    <h2>Admin Sign In</h2>
                    <p>Enter your credentials to continue.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="ha-login-alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@_error</span>
                    </div>
                }

                <EditForm Model="_login" OnValidSubmit="Login">
                    <DataAnnotationsValidator />

                    <div class="ha-login-field">
                        <label>Email Address</label>
                        <InputText class="form-control ha-login-input"
                                   placeholder="admin@hospital.com"
                                   @bind-Value="_login.Email" />
                    </div>

                    <div class="ha-login-field ha-login-password-field">
                        <label>Password</label>

                        <InputText type="@(_showPassword ? "text" : "password")"
                                   class="form-control ha-login-input ha-login-input-password"
                                   placeholder="Enter your password"
                                   @bind-Value="_login.Password" />

                        <button type="button"
                                class="ha-login-password-toggle"
                                @onclick="TogglePassword"
                                tabindex="-1">
                            <i class="bi @( _showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                            <span>@(_showPassword ? "Hide" : "Show")</span>
                        </button>
                    </div>

                    <button type="submit"
                            class="ha-login-submit"
                            disabled="@_isLoading">

                        @if (_isLoading)
                        {
                            <span class="ha-login-spinner"></span>
                        }

                        <span>@(_isLoading ? "Signing in..." : "Log In")</span>
                    </button>
                </EditForm>

                <div class="ha-login-footer-note">
                    Authorized admin access only.
                </div>
            </div>
        </div>
    </section>

</div>

@code {
    private LoginDto _login = new();
    private string? _error;
    private bool _isLoading = false;
    private bool _showPassword = false;

    private async Task Login()
    {
        _isLoading = true;
        _error = null;

        var success = await AuthService.LoginAsync(_login);

        _isLoading = false;

        if (success)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            _error = "Invalid email or password. Please try again.";
        }
    }

    private void TogglePassword()
    {
        _showPassword = !_showPassword;
    }
}