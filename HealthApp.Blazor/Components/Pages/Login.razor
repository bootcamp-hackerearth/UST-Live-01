@page "/login"
@rendermode InteractiveServer

@using HealthApp.Shared.Dto
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Admin Login</PageTitle>

<div class="login-wrapper">

    <!-- ✅ LEFT SIDE -->
    <div class="left-panel">
        <div class="left-content">

            <h1>Administrator Portal</h1>

            <p>

                Access the HealthApp admin system to monitor,
                control, and manage healthcare operations securely.

            </p>

        </div>
    </div>

    <!-- ✅ RIGHT SIDE -->
    <div class="right-panel">

        <div class="login-card">

            <!-- LOGO -->
            <div class="logo-box">H</div>

            <h2>Hello! Welcome back</h2>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="error">@errorMessage</div>
            }

            <!-- EMAIL -->
            <input type="email"
                   class="input"
                   placeholder="Enter your email"
                   @bind="loginModel.Email" />

            <!-- PASSWORD -->
            <input type="password"
                   class="input"
                   placeholder="Enter your password"
                   @bind="loginModel.Password" />

            <!-- LOGIN -->
            <button class="login-btn" @onclick="HandleLogin">
                Login
            </button>

            <div class="note">
                Authorized access only
            </div>

        </div>

    </div>

</div>

@code {
    private LoginDto loginModel = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;

        var result = await AuthService.LoginAsync(loginModel);

        if (result != null && result.Success && result.Role == "Admin")
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            errorMessage = result?.Message ?? "Login failed.";
        }
    }
}

<style>

    /* ✅ RESET */
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
    }

    /* ✅ MAIN WRAPPER */
    .login-wrapper {
        display: flex;
        height: 100vh;
    }

    /* ✅ LEFT PANEL (GRADIENT) */
    .left-panel {
        flex: 1;
        background: linear-gradient(135deg, #5b7cfa, #6c63ff);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .left-content {
        max-width: 400px;
        padding: 20px;
    }

        .left-content h1 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .left-content p {
            opacity: 0.9;
            line-height: 1.6;
        }

    /* ✅ RIGHT PANEL */
    .right-panel {
        flex: 1;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ✅ LOGIN CARD */
    .login-card {
        background: white;
        padding: 35px;
        width: 100%;
        max-width: 360px;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        text-align: center;
    }

    /* ✅ LOGO */
    .logo-box {
        width: 55px;
        height: 55px;
        background: linear-gradient(135deg, #5b7cfa, #6c63ff);
        border-radius: 14px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: bold;
        margin: 0 auto 15px;
    }

    /* ✅ TITLE */
    .login-card h2 {
        margin-bottom: 20px;
    }

    /* ✅ INPUT */
    .input {
        width: 100%;
        padding: 12px;
        margin-bottom: 12px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        outline: none;
    }

    /* ✅ BUTTON */
    .login-btn {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        border: none;
        background: #5b7cfa;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }

        .login-btn:hover {
            background: #4f46e5;
        }

    /* ✅ ERROR */
    .error {
        background: #fee2e2;
        color: #b91c1c;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
    }

    /* ✅ NOTE */
    .note {
        margin-top: 10px;
        font-size: 13px;
        color: #6b7280;
    }

    /* ✅ RESPONSIVE */
    @@media (max-width: 900px) {
        .login-wrapper {
            flex-direction: column;
        }

        .left-panel {
            height: 35%;
        }
    }

</style>