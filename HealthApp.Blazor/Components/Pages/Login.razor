@page "/login"
@rendermode InteractiveServer

@using HealthApp.Shared.Dto
@using HealthApp.Blazor.Components.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Admin Login</PageTitle>

<style>
    html, body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        box-sizing: border-box;
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at top left, rgba(255,255,255,0.16), transparent 28%), radial-gradient(circle at bottom right, rgba(255,255,255,0.10), transparent 26%), linear-gradient(135deg, #1565f7 0%, #4f46e5 100%);
    }

    .login-card {
        width: 100%;
        max-width: 460px;
        padding: 34px 30px 28px 30px;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.97);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.18);
        box-sizing: border-box;
    }

        .login-card h1 {
            margin: 0 0 10px 0;
            font-size: 34px;
            color: #0f172a;
            font-weight: 800;
        }

        .login-card p {
            margin: 0 0 20px 0;
            color: #64748b;
            line-height: 1.7;
        }

    .form-group {
        margin-bottom: 16px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 700;
            color: #334155;
        }

    .form-control {
        width: 100%;
        padding: 13px 14px;
        font-size: 15px;
        border: 1px solid #d5dbe6;
        border-radius: 12px;
        outline: none;
        box-sizing: border-box;
        background: #ffffff;
    }

        .form-control:focus {
            border-color: #1565f7;
            box-shadow: 0 0 0 4px rgba(21, 101, 247, 0.12);
        }

    .login-btn {
        width: 100%;
        margin-top: 6px;
        padding: 13px 16px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #1565f7, #1d4ed8);
        color: white;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
    }

        .login-btn:hover {
            opacity: 0.96;
        }

    .login-alert {
        margin-bottom: 18px;
        padding: 12px 14px;
        border-radius: 12px;
        font-size: 14px;
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #b91c1c;
    }

    .login-note {
        margin-top: 18px;
        text-align: center;
        font-size: 13px;
        color: #64748b;
        line-height: 1.6;
    }

    @@media (max-width: 520px) {
        .login-card {
            padding: 26px 20px 22px 20px;
            border-radius: 18px;
        }
    }
</style>

<div class="login-page">
    <div class="login-card">
        <h1>HealthApp Admin Login</h1>
        <p>Only administrator accounts can access this portal.</p>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="login-alert">@errorMessage</div>
        }

        <div class="form-group">
            <label for="login-email">Email Address</label>
            <input id="login-email"
                   class="form-control"
                   type="email"
                   placeholder="Enter your email"
                   @bind="loginModel.Email" />
        </div>

        <div class="form-group">
            <label for="login-password">Password</label>
            <input id="login-password"
                   class="form-control"
                   type="password"
                   placeholder="Enter your password"
                   @bind="loginModel.Password" />
        </div>

        <button type="button" class="login-btn" @onclick="HandleLogin">
            Login
        </button>

        <div class="login-note">
            Authorized access only. Contact the system administrator if you need account assistance.
        </div>
    </div>
</div>

@code {
    private LoginDto loginModel = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;

        var result = await AuthService.LoginAsync(loginModel);


        if (result is not null && result.Success && result.Role == "Admin")
        {
            Navigation.NavigateTo("/");
        }

        else
        {
            errorMessage = result?.Message ?? "Login failed.";
        }
    }
}
