@page "/doctors"
@rendermode InteractiveServer

@using HealthApp.Shared.Dto
@using HealthApp.Blazor.Components.service.Interface

@inject IDoctorService DoctorService

<PageTitle>Doctors</PageTitle>

<div class="page-block">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h2>Doctors</h2>
            <p>Manage doctor information</p>
        </div>

        <button class="page-btn primary" @onclick="ShowAddForm">
            + Add Doctor
        </button>
    </div>

    <!-- SEARCH -->
    <div class="toolbar">
        <input class="search-input" placeholder="Search by name..." @bind="searchText" />
        <button class="page-btn secondary" @onclick="Search">Search</button>
        <button class="page-btn light" @onclick="Reset">Reset</button>
    </div>

    <!-- FORM -->
    @if (showForm)
    {
        <div class="form-card">
            <h3>@(editMode ? "Edit Doctor" : "Add Doctor")</h3>

            <div class="form-grid">
                <input class="field-input" placeholder="Full Name" @bind="formDoctor.FullName" />
                <input class="field-input" placeholder="Specialisation" @bind="formDoctor.Specialisation" />
                <input class="field-input" placeholder="Email" @bind="formDoctor.Email" />
                <input class="field-input" placeholder="Phone" @bind="formDoctor.DoctorPhoneNumber" />
                <input class="field-input" type="number" placeholder="Fee" @bind="formDoctor.ConsultationFee" />
                <input class="field-input" type="date" @bind="formDoctor.PracticeStartDate" />
            </div>

            <div class="action-row">
                <button class="page-btn success" @onclick="SaveDoctor">Save</button>
                <button class="page-btn light" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
    }

    <!-- LIST -->
    @if (isLoading)
    {
        <div class="empty-state">Loading doctors...</div>
    }
    else if (!doctors.Any())
    {
        <div class="empty-state">No doctors found.</div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Specialisation</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Fee</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var doctor in doctors)
                    {
                        <tr>
                            <td>@doctor.DoctorId</td>
                            <td>@doctor.FullName</td>
                            <td>@doctor.Specialisation</td>
                            <td>@doctor.Email</td>
                            <td>@doctor.DoctorPhoneNumber</td>
                            <td>₹@doctor.ConsultationFee</td>

                            <td>
                                <button class="mini-btn info" @onclick="() => ViewDoctor(doctor)">View</button>
                                <button class="mini-btn warn" @onclick="() => EditDoctor(doctor)">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- MODAL -->
    @if (viewDoctor != null)
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <h3>Doctor Details</h3>

                <p><strong>Name:</strong> @viewDoctor.FullName</p>
                <p><strong>Email:</strong> @viewDoctor.Email</p>
                <p><strong>Specialisation:</strong> @viewDoctor.Specialisation</p>
                <p><strong>Phone:</strong> @viewDoctor.DoctorPhoneNumber</p>
                <p><strong>Fee:</strong> ₹@viewDoctor.ConsultationFee</p>
                <p><strong>Start Date:</strong> @viewDoctor.PracticeStartDate?.ToString("dd-MM-yyyy")</p>

                <button class="page-btn light" @onclick="CloseView">Close</button>
            </div>
        </div>
    }

</div>

@code {

    private List<DoctorDto> doctors = new();
    private List<DoctorDto> allDoctors = new();

    private bool isLoading = true;
    private string searchText = "";

    private bool showForm = false;
    private bool editMode = false;

    private DoctorDto formDoctor = new();
    private DoctorDto? viewDoctor;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);   // ✅ FORCE UI UPDATE

        allDoctors = await DoctorService.GetAllDoctorsAsync();
        doctors = allDoctors.ToList();

        Console.WriteLine($"Loaded doctors: {doctors.Count}");

        isLoading = false;
        await InvokeAsync(StateHasChanged);   // ✅ FORCE UI UPDATE
    }

    private void Search()
    {
        doctors = allDoctors
            .Where(d => d.FullName != null &&
                        d.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void Reset()
    {
        searchText = "";
        doctors = allDoctors.ToList();
    }

    private void ShowAddForm()
    {
        formDoctor = new DoctorDto();
        editMode = false;
        showForm = true;
    }

    private void EditDoctor(DoctorDto d)
    {
        formDoctor = new DoctorDto
        {
            DoctorId = d.DoctorId,
            FullName = d.FullName,
            Specialisation = d.Specialisation,
            Email = d.Email,
            DoctorPhoneNumber = d.DoctorPhoneNumber,
            ConsultationFee = d.ConsultationFee,
            PracticeStartDate = d.PracticeStartDate
        };

        editMode = true;
        showForm = true;
    }

    private async Task SaveDoctor()
    {
        bool success;

        if (editMode)
            success = await DoctorService.UpdateDoctorAsync(formDoctor.DoctorId, formDoctor);
        else
            success = await DoctorService.CreateDoctorAsync(formDoctor);

        if (success)
            await LoadDoctors();
        else
            Console.WriteLine("Save failed");

        showForm = false;
    }

    private void CancelForm() => showForm = false;

    private void ViewDoctor(DoctorDto d) => viewDoctor = d;

    private void CloseView() => viewDoctor = null;
}






<style>
    .page-block {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 36px;
            color: #111827;
            font-weight: 800;
        }

        .page-header p {
            margin: 6px 0 0 0;
            color: #6b7280;
            font-size: 16px;
        }

    .toolbar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    .search-input,
    .field-input {
        border: 1px solid #d8e0ec;
        background: white;
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 15px;
        outline: none;
        box-sizing: border-box;
    }

    .search-input {
        min-width: 320px;
    }

    .page-btn {
        border: none;
        border-radius: 12px;
        padding: 12px 18px;
        font-weight: 700;
        cursor: pointer;
    }

        .page-btn.primary {
            background: #1d4ed8;
            color: white;
        }

        .page-btn.secondary {
            background: #e8f0ff;
            color: #1d4ed8;
        }

        .page-btn.light {
            background: #f3f4f6;
            color: #374151;
        }

        .page-btn.success {
            background: #16a34a;
            color: white;
        }

    .form-card,
    .table-card {
        background: white;
        border: 1px solid #e7edf6;
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 10px 22px rgba(0,0,0,0.05);
    }

        .form-card h3 {
            margin-top: 0;
            margin-bottom: 18px;
            font-size: 22px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .action-row {
        display: flex;
        gap: 12px;
        margin-top: 18px;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th,
        .data-table td {
            padding: 14px 12px;
            text-align: left;
            border-bottom: 1px solid #edf2f7;
            font-size: 15px;
        }

        .data-table th {
            color: #475569;
            background: #f8fafc;
            font-weight: 800;
        }

    .status-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

        .status-badge.active {
            background: #e8f8ef;
            color: #15803d;
        }

        .status-badge.inactive {
            background: #f1f5f9;
            color: #475569;
        }

    .table-actions {
        display: flex;
        gap: 8px;
    }

    .mini-btn {
        border: none;
        border-radius: 10px;
        padding: 8px 12px;
        font-weight: 700;
        cursor: pointer;
    }

        .mini-btn.info {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .mini-btn.warn {
            background: #fef3c7;
            color: #b45309;
        }

    .empty-state {
        background: white;
        border: 1px dashed #d8e0ec;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        color: #6b7280;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .modal-card {
        width: 100%;
        max-width: 520px;
        background: white;
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 18px 40px rgba(0,0,0,0.2);
    }

        .modal-card h3 {
            margin-top: 0;
        }

    @@media (max-width: 992px) {
        .form-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 640px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .search-input {
            min-width: 100%;
            width: 100%;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .table-card {
            overflow-x: auto;
        }
    }
</style>
