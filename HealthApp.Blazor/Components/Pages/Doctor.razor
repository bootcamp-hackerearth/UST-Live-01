@page "/doctors"
@rendermode InteractiveServer

@using HealthApp.Shared.Dto
@using Microsoft.AspNetCore.Components.Web

@inject IDoctorService DoctorService
@inject IAuthService AuthService

<PageTitle>Doctors</PageTitle>

<div class="page">

    <!-- HEADER -->
    <div class="header">
        <div>
            <h2>Doctors</h2>
            <p>Manage doctor information</p>
        </div>

        <button class="btn primary" @onclick="ShowAddForm">+ Add Doctor</button>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">

        <!-- SEARCH -->
        <div class="toolbar-left">
            <input class="input search"
                   placeholder="Search by Name or ID..."
                   @bind="searchText"
                   @onkeypress="HandleKeyPress" />

            <button class="btn primary" @onclick="ApplyFilters">
                Search
            </button>
        </div>

        <!-- FILTER -->
        <div class="toolbar-right">

            <select class="input filter" @bind="specialisationSearch">
                <option value="">All Specialisations</option>
                <option>Endocrinologist</option>
                <option>Oncologist</option>
                <option>Gynecologist</option>
                <option>OrthopedicSurgeon</option>
                <option>Psychiatrist</option>
                <option>Pediatrician</option>
                <option>Neurologist</option>
                <option>Dermatologist</option>
                <option>Cardiologist</option>
                <option>GeneralPractitioner</option>
                <option>ENT</option>
            </select>

            <button class="btn info" @onclick="ApplyFilters">
                Filter
            </button>

            <button class="btn light" @onclick="Reset">Reset</button>
        </div>

    </div>

    <!-- FORM -->
    @if (showForm)
    {
        <div class="card">
            <h3>@(editMode ? "Edit Doctor" : "Add Doctor")</h3>

            <div class="grid">
                <input class="input" placeholder="Name" @bind="formDoctor.FullName" />

                <!-- ✅ DROPDOWN -->
                <select class="input" @bind="formDoctor.Specialisation">
                    <option value="">Select Specialisation</option>
                    <option>Endocrinologist</option>
                    <option>Oncologist</option>
                    <option>Gynecologist</option>
                    <option>OrthopedicSurgeon</option>
                    <option>Psychiatrist</option>
                    <option>Pediatrician</option>
                    <option>Neurologist</option>
                    <option>Dermatologist</option>
                    <option>Cardiologist</option>
                    <option>GeneralPractitioner</option>
                    <option>ENT</option>
                </select>

                <input class="input" placeholder="Email" @bind="formDoctor.Email" />
                <input class="input" placeholder="Phone" @bind="formDoctor.DoctorPhoneNumber" />
                <input class="input" type="number" placeholder="Fee" @bind="formDoctor.ConsultationFee" />
                <input class="input" type="date" @bind="formDoctor.PracticeStartDate" />
            </div>

            <div class="actions">
                <button class="btn success" @onclick="SaveDoctor">Save</button>
                <button class="btn light" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
    }

    <!-- TABLE -->
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Specialisation</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var d in doctors)
                {
                    <tr>
                        <td>@d.DoctorId</td>
                        <td>@d.FullName</td>
                        <td>@d.Specialisation</td>
                        <td>@d.Email</td>
                        <td>@d.DoctorPhoneNumber</td>
                        <td>₹@d.ConsultationFee</td>

                        <td>
                            <button class="toggle-btn @(d.IsActive == true ? "active" : "inactive")"
                                    @onclick="() => ToggleStatus(d)">
                                @(d.IsActive == true ? "Active" : "Inactive")
                            </button>
                        </td>


                        <td>
                            <button class="mini view" @onclick="() => ViewDoctorById(d.DoctorId)">View</button>
                            <button class="mini edit" @onclick="() => EditDoctor(d)">Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- VIEW MODAL -->
    @if (viewDoctor != null)
    {
        <div class="modal">
            <div class="modal-box">
                <h3>Doctor Details</h3>

                <p><b>Name:</b> @viewDoctor.FullName</p>
                <p><b>Email:</b> @viewDoctor.Email</p>
                <p><b>Specialisation:</b> @viewDoctor.Specialisation</p>
                <p><b>Phone:</b> @viewDoctor.DoctorPhoneNumber</p>
                <p><b>Fee:</b> ₹@viewDoctor.ConsultationFee</p>
                <p><b>Status:</b> @(viewDoctor?.IsActive == true ? "Active" : "Inactive")</p>

                <button class="btn light" @onclick="CloseView">Close</button>
            </div>
        </div>
    }

</div>

@code {

    private List<DoctorDto> doctors = new();
    private List<DoctorDto> allDoctors = new();

    private string searchText = "";
    private string specialisationSearch = "";

    private bool showForm = false;
    private bool editMode = false;

    private DoctorDto formDoctor = new();
    private DoctorDto? viewDoctor;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        allDoctors = await DoctorService.GetAllDoctorsAsync();
        doctors = allDoctors.ToList();
    }

    // ✅ COMBINED FILTER LOGIC
    private void ApplyFilters()
    {
        doctors = allDoctors.Where(d =>

            // Search by Name OR ID
            (string.IsNullOrWhiteSpace(searchText) ||
                (!string.IsNullOrEmpty(d.FullName) &&
                 d.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (int.TryParse(searchText, out var id) && d.DoctorId == id)
            )

            &&

            // Filter by Specialisation
            (string.IsNullOrWhiteSpace(specialisationSearch) ||
                (!string.IsNullOrEmpty(d.Specialisation) &&
                 d.Specialisation.Contains(specialisationSearch, StringComparison.OrdinalIgnoreCase))
            )

        ).ToList();
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplyFilters();
        }
    }

    private void Reset()
    {
        searchText = "";
        specialisationSearch = "";
        doctors = allDoctors.ToList();
    }

    private void ShowAddForm()
    {
        formDoctor = new DoctorDto { IsActive = true };
        editMode = false;
        showForm = true;
    }

    private void EditDoctor(DoctorDto d)
    {
        formDoctor = new DoctorDto
        {
            DoctorId = d.DoctorId,
            FullName = d.FullName,
            Specialisation = d.Specialisation,
            Email = d.Email,
            DoctorPhoneNumber = d.DoctorPhoneNumber,
            ConsultationFee = d.ConsultationFee,
            PracticeStartDate = d.PracticeStartDate,
            IsActive = d.IsActive
        };

        editMode = true;
        showForm = true;
    }

    private async Task SaveDoctor()
    {
        if (editMode)
            await DoctorService.UpdateDoctorAsync(formDoctor.DoctorId, formDoctor);
        else
            await DoctorService.CreateDoctorAsync(formDoctor);

        await LoadDoctors();
        showForm = false;
    }
    private async Task ToggleStatus(DoctorDto doctor)
    {
        // Flip status
        doctor.IsActive = !(doctor.IsActive ?? false);

        // Save to DB
        var success = await DoctorService.UpdateDoctorAsync(doctor.DoctorId, doctor);

        if (success)
        {
            Console.WriteLine("Status updated");

            // refresh data
            StateHasChanged();
           // await LoadDoctors();
        }
        else
        {
            Console.WriteLine("Status update failed");
        }
    }

    private void CancelForm() => showForm = false;

    private async Task ViewDoctorById(int id)
    {
        viewDoctor = await DoctorService.GetDoctorByIdAsync(id);
    }

    private void CloseView() => viewDoctor = null;
}





<style>

    .page {
        padding: 20px;
    }

    /* HEADER */
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .header h2 {
            font-size: 32px;
            margin: 0;
        }

    /* TOOLBAR */
    .toolbar {
        margin-top: 15px;
        display: flex;
        gap: 10px;
    }

    /* INPUT */
    .input {
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #d1d5db;
    }

    /* BUTTONS */
    .btn {
        border: none;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
    }

    .primary {
        background: #2563eb;
        color: white;
    }

    .secondary {
        background: #e0ecff;
        color: #2563eb;
    }

    .info {
        background: #dbf4ff;
        color: #0369a1;
    }

    .success {
        background: #16a34a;
        color: white;
    }

    .light {
        background: #f3f4f6;
    }

    /* CARD */
    .card {
        margin-top: 20px;
        background: white;
        padding: 20px;
        border-radius: 18px;
    }

    /* GRID */
    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    /* TABLE */
    .table {
        width: 100%;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 12px;
            border-bottom: 1px solid #eee;
        }

    /* BADGE */
    .badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }

    .active {
        background: #dcfce7;
        color: #15803d;
    }

    .inactive {
        background: #fee2e2;
        color: #b91c1c;
    }

    /* SMALL BUTTONS */
    .mini {
        padding: 6px 10px;
        border-radius: 8px;
        border: none;
        margin-right: 5px;
    }

    .view {
        background: #dbeafe;
    }

    .edit {
        background: #fef3c7;
    }

    /* MODAL */
    .modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .modal-box {
        background: white;
        padding: 25px;
        border-radius: 16px;
        width: 400px;
    }

    @@media(max-width: 768px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }

</style>