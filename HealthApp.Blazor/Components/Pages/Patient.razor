@page "/patients"
@rendermode InteractiveServer

@using HealthApp.Shared.Dto
@using Microsoft.AspNetCore.Components.Web
@inject IPatientService PatientService

<PageTitle>Patients</PageTitle>

<div class="page">

    <!-- HEADER -->
    <div class="header">
        <div>
            <h2>Patients</h2>
            <p>Manage patient information</p>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="toolbar-left">
            <input class="input search"
                   placeholder="Search by ID or Name..."
                   @bind="searchText"
                   @onkeypress="HandleKeyPress" />

            <button class="btn primary" @onclick="Search">Search</button>
        </div>

        <div class="toolbar-right">
            <button class="btn light" @onclick="Reset">Reset</button>
        </div>
    </div>

    <!-- TABLE -->
    @if (isLoading)
    {
        <div class="empty">Loading patients...</div>
    }
    else if (!patients.Any())
    {
        <div class="empty">No patients found.</div>
    }
    else
    {
        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Insurance</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in patients)
                    {
                        <tr>
                            <td>@p.PatientId</td>
                            <td>@p.FullName</td>
                            <td>@p.Email</td>
                            <td>@p.PhoneNumber</td>
                            <td>@p.Gender</td>
                            <td>@p.DateOfBirth?.ToString("dd-MM-yyyy")</td>
                            <td>@p.InsuranceId</td>

                            <td>
                                <button class="mini view" @onclick="() => ViewPatient(p)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- MODAL -->
    @if (viewPatient is not null)
    {
        <div class="modal">
            <div class="modal-box">
                <h3>Patient Details</h3>

                <p><b>Name:</b> @viewPatient.FullName</p>
                <p><b>Email:</b> @viewPatient.Email</p>
                <p><b>Phone:</b> @viewPatient.PhoneNumber</p>
                <p><b>Gender:</b> @viewPatient.Gender</p>

                <p>
                    <b>DOB:</b>
                    @viewPatient.DateOfBirth?.ToString("dd-MM-yyyy")
                </p>

                <p>
                    <b>Age:</b>
                    @(viewPatient.DateOfBirth != null
                        ? GetAge(viewPatient.DateOfBirth.Value)
                        : 0) years
                </p>

                <button class="btn light" @onclick="CloseView">Close</button>
            </div>
        </div>
    }

</div>

@code {
    private List<PatientDto> patients = new();
    private List<PatientDto> allPatients = new();

    private bool isLoading = true;
    private string searchText = "";

    private PatientDto? viewPatient;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        allPatients = await PatientService.GetAllPatientsAsync();
        patients = allPatients.ToList();

        isLoading = false;
    }

    private void Search()
    {
        patients = allPatients.Where(p =>
            (!string.IsNullOrWhiteSpace(p.FullName) &&
             p.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            ||
            p.PatientId.ToString().Contains(searchText)
        ).ToList();
    }

    private void Reset()
    {
        searchText = "";
        patients = allPatients.ToList();
    }

    private void ViewPatient(PatientDto p)
    {
        viewPatient = p;
    }

    private void CloseView()
    {
        viewPatient = null;
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Search();
        }
    }

    private int GetAge(DateTime dob)
    {
        var today = DateTime.Today;
        var age = today.Year - dob.Year;

        if (dob > today.AddYears(-age)) age--;

        return age;
    }
}


<style>

    /* PAGE */
    .page {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    /* HEADER */
    .header h2 {
        font-size: 34px;
        margin: 0;
        font-weight: 800;
    }

    .header p {
        color: #64748b;
    }

    /* TOOLBAR */
    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .toolbar-left {
        display: flex;
        gap: 10px;
    }

    .toolbar-right {
        display: flex;
        gap: 10px;
    }

    /* INPUT */
    .input {
        padding: 10px 14px;
        border-radius: 12px;
        border: 1px solid #d1d5db;
        font-size: 14px;
    }

    .search {
        width: 280px;
    }

    /* BUTTONS */
    .btn {
        padding: 10px 16px;
        border-radius: 12px;
        border: none;
        font-weight: 700;
        cursor: pointer;
    }

    .primary {
        background: #2563eb;
        color: white;
    }

    .light {
        background: #f1f5f9;
    }

    /* CARD */
    .card {
        background: white;
        padding: 20px;
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.04);
    }

    /* TABLE */
    .table {
        width: 100%;
        border-collapse: collapse;
    }

        .table th {
            background: #f8fafc;
            color: #64748b;
            text-transform: uppercase;
            font-size: 13px;
            padding: 12px;
        }

        .table td {
            padding: 14px;
            border-bottom: 1px solid #eef2f7;
        }

    /* BUTTON */
    .mini {
        padding: 7px 12px;
        border-radius: 10px;
        border: none;
        font-weight: 700;
    }

    .view {
        background: #dbeafe;
        color: #1d4ed8;
    }

    /* EMPTY */
    .empty {
        padding: 30px;
        text-align: center;
        border: 1px dashed #dbe3ef;
        border-radius: 14px;
    }

    /* MODAL */
    .modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-box {
        background: white;
        padding: 25px;
        border-radius: 16px;
        width: 420px;
    }

    /* RESPONSIVE */
    @@media(max-width: 768px) {
        .toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .search {
            width: 100%;
        }
    }

</style>
