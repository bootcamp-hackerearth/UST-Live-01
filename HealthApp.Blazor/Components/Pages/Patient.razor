@page "/patients"
@rendermode InteractiveServer

@using HealthApp.Shared.Dto
@using HealthApp.Blazor.Components.service.Interface

@inject IPatientService PatientService

<PageTitle>Patients</PageTitle>

<div class="page-block">
    <div class="page-header">
        <div>
            <h2>Patients</h2>
            <p>Manage patient information</p>
        </div>
    </div>

    <div class="toolbar">
        <input class="search-input"
               placeholder="Search by ID or Name..."
               @bind="searchText" />

        <button class="page-btn secondary" @onclick="Search">Search</button>
        <button class="page-btn light" @onclick="Reset">Reset</button>
    </div>

    @if (isLoading)
    {
        <div class="empty-state">Loading patients...</div>
    }
    else if (!patients.Any())
    {
        <div class="empty-state">No patients found.</div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Insurance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in patients)
                    {
                        <tr>
                            <td>@patient.PatientId</td>
                            <td>@patient.FullName</td>
                            <td>@patient.Email</td>
                            <td>@patient.PhoneNumber</td>
                            <td>@patient.Gender</td>
                            <td>@patient.DateOfBirth?.ToString("dd-MM-yyyy")</td>
                            <td>@patient.InsuranceId</td>
                            <td>
                                <button class="mini-btn" @onclick="() => ViewPatient(patient)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (viewPatient is not null)
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <h3>Patient Details</h3>

                <p><strong>Name:</strong> @viewPatient!.FullName</p>
                <p><strong>Email:</strong> @viewPatient!.Email</p>
                <p><strong>Phone:</strong> @viewPatient!.PhoneNumber</p>
                <p><strong>Gender:</strong> @viewPatient!.Gender</p>

                <p>
                    <strong>DOB:</strong>
                    @viewPatient!.DateOfBirth?.ToString("dd-MM-yyyy")
                </p>

                <p>
                    <strong>Age:</strong>
                    @(viewPatient!.DateOfBirth is not null
                        ? GetAge(viewPatient.DateOfBirth.Value)
                        : 0) years
                </p>

                <button class="page-btn light" @onclick="CloseView">Close</button>
            </div>
        </div>
    }
</div>

@code {
    private List<PatientDto> patients = new();
    private List<PatientDto> allPatients = new();
    private bool isLoading = true;
    private string searchText = "";
    private PatientDto? viewPatient;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        allPatients = await PatientService.GetAllPatientsAsync();
        patients = allPatients.ToList();

        isLoading = false;
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return;

        patients = allPatients.Where(p =>
            (!string.IsNullOrWhiteSpace(p.FullName) &&
             p.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            || p.PatientId.ToString().Contains(searchText)
        ).ToList();
    }

    private void Reset()
    {
        searchText = "";
        patients = allPatients.ToList();
    }

    private void ViewPatient(PatientDto p)
    {
        viewPatient = p;
    }

    private void CloseView()
    {
        viewPatient = null;
    }

    private int GetAge(DateTime dob)
    {
        var today = DateTime.Today;
        int age = today.Year - dob.Year;

        if (dob > today.AddYears(-age))
            age--;

        return age;
    }
}

<style>
.page-block {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.page-header h2 {
    margin: 0;
    font-size: 34px;
    font-weight: 800;
    color: #0f172a;
}

.page-header p {
    margin-top: 6px;
    color: #64748b;
}

.toolbar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.search-input {
    min-width: 300px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid #dbe3ef;
    font-size: 14px;
}

.page-btn {
    padding: 11px 16px;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    border: none;
}

.page-btn.secondary {
    background: #e8f0ff;
    color: #1d4ed8;
}

.page-btn.light {
    background: #f1f5f9;
    color: #0f172a;
}

.table-card {
    background: white;
    border-radius: 20px;
    padding: 20px;
    border: 1px solid #e5eaf2;
    box-shadow: 0 10px 25px rgba(0,0,0,0.04);
}

.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table th {
    background: #f8fafc;
    font-size: 13px;
    text-transform: uppercase;
    color: #64748b;
    padding: 12px;
    text-align: left;
}

.data-table td {
    padding: 14px 12px;
    border-bottom: 1px solid #eef2f7;
    font-size: 14px;
}

.mini-btn {
    padding: 7px 12px;
    border-radius: 10px;
    border: none;
    background: #dbeafe;
    color: #1d4ed8;
    font-weight: 700;
    cursor: pointer;
}

.empty-state {
    padding: 40px;
    text-align: center;
    border-radius: 18px;
    border: 1px dashed #dbe3ef;
    color: #64748b;
}

.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    display: flex;
    justify-content: center;
    align-items: center;
}

.modal-card {
    background: white;
    border-radius: 18px;
    padding: 24px;
    width: 100%;
    max-width: 480px;
}

/* ✅ IMPORTANT FIX */
@@media (max-width: 768px) {
    .search-input {
        width: 100%;
        min-width: unset;
    }
}
</style>
