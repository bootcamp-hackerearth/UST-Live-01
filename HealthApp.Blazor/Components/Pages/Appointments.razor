@page "/appointments"
@rendermode InteractiveServer

@using HealthApp.Blazor.Components.Models
@using HealthApp.Blazor.Components.Services
@* @inject AppointmentService AppointmentService *@

<PageTitle>Appointments</PageTitle>

<div class="page-block">
    <div class="page-header">
        <div>
            <h2>Appointments</h2>
            <p>Manage appointment schedules and consultation details</p>
        </div>
    </div>

    <!-- Search -->
    <div class="toolbar">
        <input class="search-input"
               placeholder="Search by doctor, patient or status..."
               @bind="searchText" />

        <button class="page-btn secondary" @onclick="Search">Search</button>
        <button class="page-btn light" @onclick="Reset">Reset</button>
    </div>

    @if (isLoading)
    {
        <div class="empty-state">Loading appointments...</div>
    }
    else if (!appointments.Any())
    {
        <div class="empty-state">No appointments found.</div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Appointment ID</th>
                        <th>Doctor</th>
                        <th>Patient</th>
                        <th>Scheduled Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Cancellation Reason</th>
                        <th style="width:120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in appointments)
                    {
                        <tr>
                            <td>@appointment.AppointmentId</td>
                            <td>@appointment.Doctor?.FullName</td>
                            <td>@appointment.Patient?.FullName</td>
                            <td>@appointment.ScheduledDate.ToString("dd-MM-yyyy")</td>
                            <td>@appointment.TimeSlot</td>
                            <td>
                                @if (appointment.Status == "Confirmed")
                                {
                                    <span class="status-badge confirmed">Confirmed</span>
                                }
                                else if (appointment.Status == "Pending")
                                {
                                    <span class="status-badge pending">Pending</span>
                                }
                                else if (appointment.Status == "Completed")
                                {
                                    <span class="status-badge completed">Completed</span>
                                }
                                else if (appointment.Status == "Cancelled")
                                {
                                    <span class="status-badge cancelled">Cancelled</span>
                                }
                                else
                                {
                                    <span class="status-badge default">@appointment.Status</span>
                                }
                            </td>
                            <td>@appointment.CancellationReason</td>
                            <td>
                                <button class="mini-btn info"
                                        @onclick="() => ViewAppointment(appointment)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- View Modal -->
    @if (viewAppointment != null)
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <h3>Appointment Details</h3>

                <p><strong>Appointment ID:</strong> @viewAppointment.AppointmentId</p>
                <p><strong>Doctor:</strong> @viewAppointment.Doctor?.FullName</p>
                <p><strong>Patient:</strong> @viewAppointment.Patient?.FullName</p>
                <p><strong>Scheduled Date:</strong> @viewAppointment.ScheduledDate.ToString("dd-MM-yyyy")</p>
                <p><strong>Time Slot:</strong> @viewAppointment.TimeSlot</p>
                <p><strong>Status:</strong> @viewAppointment.Status</p>
                <p><strong>Cancellation Reason:</strong> @viewAppointment.CancellationReason</p>

                <div class="action-row">
                    <button class="page-btn light" @onclick="CloseView">Close</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Appointment> appointments = new();
    private List<Appointment> allAppointments = new();

    private bool isLoading = true;
    private string searchText = "";

    private Appointment? viewAppointment;

    protected override async Task OnInitializedAsync()
    {
        // allAppointments = await AppointmentService.GetAllAppointmentsAsync();
        appointments = allAppointments.ToList();
        isLoading = false;
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return;

        appointments = allAppointments
            .Where(a =>
                (!string.IsNullOrWhiteSpace(a.Doctor?.FullName) &&
                 a.Doctor.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(a.Patient?.FullName) &&
                 a.Patient.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(a.Status) &&
                 a.Status.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                ||
                a.AppointmentId.ToString().Contains(searchText)
            )
            .ToList();
    }

    private void Reset()
    {
        searchText = "";
        appointments = allAppointments.ToList();
    }

    private void ViewAppointment(Appointment appointment)
    {
        viewAppointment = appointment;
    }

    private void CloseView()
    {
        viewAppointment = null;
    }
}

<style>
    .page-block {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .page-header h2 {
        margin: 0;
        font-size: 36px;
        color: #111827;
        font-weight: 800;
    }

    .page-header p {
        margin: 6px 0 0 0;
        color: #6b7280;
        font-size: 16px;
    }

    .toolbar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    .search-input {
        border: 1px solid #d8e0ec;
        background: white;
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 15px;
        outline: none;
        min-width: 320px;
        box-sizing: border-box;
    }

    .page-btn {
        border: none;
        border-radius: 12px;
        padding: 12px 18px;
        font-weight: 700;
        cursor: pointer;
    }

        .page-btn.secondary {
            background: #e8f0ff;
            color: #1d4ed8;
        }

        .page-btn.light {
            background: #f3f4f6;
            color: #374151;
        }

    .table-card {
        background: white;
        border: 1px solid #e7edf6;
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 10px 22px rgba(0,0,0,0.05);
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 980px;
    }

        .data-table th,
        .data-table td {
            padding: 14px 12px;
            text-align: left;
            border-bottom: 1px solid #edf2f7;
            font-size: 15px;
            vertical-align: top;
        }

        .data-table th {
            color: #475569;
            background: #f8fafc;
            font-weight: 800;
        }

    .status-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

        .status-badge.confirmed {
            background: #e8f8ef;
            color: #15803d;
        }

        .status-badge.pending {
            background: #fef3c7;
            color: #b45309;
        }

        .status-badge.completed {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .status-badge.cancelled {
            background: #fee2e2;
            color: #b91c1c;
        }

        .status-badge.default {
            background: #f1f5f9;
            color: #475569;
        }

    .mini-btn {
        border: none;
        border-radius: 10px;
        padding: 8px 12px;
        font-weight: 700;
        cursor: pointer;
    }

        .mini-btn.info {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .empty-state {
        background: white;
        border: 1px dashed #d8e0ec;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        color: #6b7280;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .modal-card {
        width: 100%;
        max-width: 520px;
        background: white;
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 18px 40px rgba(0,0,0,0.2);
    }

        .modal-card h3 {
            margin-top: 0;
        }

    .action-row {
        display: flex;
        gap: 12px;
        margin-top: 18px;
    }

    @@media (max-width: 640px) {
        .search-input {
            min-width: 100%;
            width: 100%;
        }
    }
</style>