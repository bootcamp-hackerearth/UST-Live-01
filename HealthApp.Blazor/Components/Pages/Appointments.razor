@page "/appointments"
@rendermode InteractiveServer

@using HealthApp.Shared.Dto
@using HealthApp.Blazor.Components.service.Interface

@inject IAppointmentService AppointmentService

<PageTitle>Appointments</PageTitle>

<div class="page-block">

    <div class="page-header">
        <div>
            <h2>Appointments</h2>
            <p>Manage appointment schedules and consultation details</p>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="toolbar">
        <input class="search-input"
               placeholder="Search doctor, patient or status..."
               @bind="searchText" />

        <button class="page-btn secondary" @onclick="Search">Search</button>
        <button class="page-btn light" @onclick="Reset">Reset</button>
    </div>

    <!-- TABLE -->
    @if (isLoading)
    {
        <div class="empty-state">Loading appointments...</div>
    }
    else if (!appointments.Any())
    {
        <div class="empty-state">No appointments found.</div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Doctor</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Reason</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var a in appointments)
                    {
                        <tr>
                            <td>@a.AppointmentId</td>

                            <td>Doctor ID: @a.DoctorId</td>
                            <td>Patient ID: @a.PatientId</td>
                            <td>@a.ScheduledDate.ToString("dd-MM-yyyy")</td>
                            <td>@a.TimeSlot</td>
                            <td>
                                <span class="status-badge @(a.Status?.ToLower())">
                                    @a.Status
                                </span>
                            </td>
                            <td>@a.CancellationReason</td>
                            <td>
                                <button class="mini-btn info"
                                        @onclick="() => ViewAppointment(a)">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- MODAL -->
    @if (viewAppointment != null)
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <h3>Appointment Details</h3>

                <p><strong>ID:</strong> @viewAppointment.AppointmentId</p>
                <p><strong>Doctor:</strong> @viewAppointment.DoctorId</p>
                <p><strong>Patient:</strong> @viewAppointment.PatientId</p>
                <p><strong>Date:</strong> @viewAppointment.ScheduledDate.ToString("dd-MM-yyyy")</p>
                <p><strong>Time:</strong> @viewAppointment.TimeSlot</p>
                <p><strong>Status:</strong> @viewAppointment.Status</p>
                <p><strong>Reason:</strong> @viewAppointment.CancellationReason</p>

                <button class="page-btn light" @onclick="CloseView">Close</button>
            </div>
        </div>
    }

</div>

@code {

    private List<AppointmentDto> appointments = new();
    private List<AppointmentDto> allAppointments = new();

    private bool isLoading = true;
    private string searchText = "";

    private AppointmentDto? viewAppointment;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        allAppointments = await AppointmentService.GetAllAppointmentsAsync();
        appointments = allAppointments.ToList();

        Console.WriteLine($"Loaded appointments: {appointments.Count}");

        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            appointments = allAppointments.ToList();
            return;
        }

        appointments = allAppointments.Where(a =>
            a.AppointmentId.ToString().Contains(searchText)
            || a.DoctorId.ToString().Contains(searchText)
            || (a.PatientId?.ToString().Contains(searchText) ?? false)
            || (a.Status?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        ).ToList();
    }


    private void Reset()
    {
        searchText = "";
        appointments = allAppointments.ToList();
    }

    private async Task ViewAppointment(AppointmentDto a)
    {
        var full = await AppointmentService.GetAppointmentByIdAsync(a.AppointmentId);
        viewAppointment = full ?? a;
    }

    private void CloseView()
    {
        viewAppointment = null;
    }
}



















<style>

    .page-block {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .page-header h2 {
        font-size: 32px;
        font-weight: 800;
    }

    .toolbar {
        display: flex;
        gap: 12px;
    }

    .search-input {
        border: 1px solid #ccc;
        padding: 10px;
        border-radius: 10px;
        width: 300px;
    }

    .page-btn {
        padding: 10px 16px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
    }

        .page-btn.secondary {
            background: #2563eb;
            color: white;
        }

        .page-btn.light {
            background: #e5e7eb;
        }

    .table-card {
        background: white;
        padding: 20px;
        border-radius: 16px;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th,
        .data-table td {
            padding: 12px;
            border-bottom: 1px solid #eee;
        }

    .status-badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
    }

        .status-badge.confirmed {
            background: #dcfce7;
            color: green;
        }

        .status-badge.pending {
            background: #fef9c3;
        }

        .status-badge.cancelled {
            background: #fee2e2;
            color: red;
        }

        .status-badge.completed {
            background: #dbeafe;
        }

    .mini-btn {
        padding: 6px 10px;
        border-radius: 8px;
    }

        .mini-btn.info {
            background: #dbeafe;
        }

    .empty-state {
        padding: 20px;
        text-align: center;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
    }

</style>
